---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import StructuredData from '../components/StructuredData.astro';

interface Props {
  title: string;
  description: string;
  locale?: string;
  image?: string;
  noindex?: boolean;
  schemaType?: 'WebPage' | 'Service';
}

const { title, description, locale = 'uk', image, noindex = false, schemaType } = Astro.props;

import { localeFromPath, normalizeLocale } from '../i18n/helpers';

const resolvedLocale = normalizeLocale(locale ?? Astro.url.searchParams.get('lang') ?? localeFromPath(Astro.url.pathname));
---
<!doctype html>
<html lang={resolvedLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#ffffff" />
    <SEOHead {title} {description} {image} locale={resolvedLocale} {noindex} />
    <StructuredData {title} {description} {image} locale={resolvedLocale} {schemaType} />
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти до змісту</a>
    <slot />
      <script src="/js/i18n-client.js" defer></script>
  </body>
</html>
