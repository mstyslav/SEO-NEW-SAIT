---
import '../styles/global.css';
import '../styles/page-h1-desktop.css';
import '../styles/header-cta-desktop.css';
import SiteEnhancements from '../components/SiteEnhancements.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import HeaderFixes from '../components/HeaderFixes.astro';

interface Props {
  title: string;
  description: string;
  locale?: import('../i18n/helpers').Locale;
  image?: string;
  alternateLocales?: import('../i18n/helpers').Locale[];
  schemaType?: 'Organization' | 'WebSite' | 'WebPage' | 'CollectionPage' | 'AboutPage' | 'ContactPage' | 'Service' | 'Article' | 'CreativeWork';
  structuredData?: import('../seo/schema').JsonLdObject | import('../seo/schema').JsonLdObject[];
  heroPreloadSrc?: string;
  heroPreloadSrcset?: string;
  heroPreloadSizes?: string;
  heroPreloadMobileSrc?: string;
  heroPreloadMobileSrcset?: string;
  robots?: string;
}

const { title, description, locale, image = '/images/v5/hero.webp', schemaType = 'WebPage', structuredData = [], alternateLocales, heroPreloadSrc, heroPreloadSrcset, heroPreloadSizes, heroPreloadMobileSrc, heroPreloadMobileSrcset, robots } = Astro.props;

import { localeFromPath, normalizeLocale, stripLocale, localizedPath, supportedLocales } from '../i18n/helpers';
import { organizationSchema, websiteSchema, webPageSchema, jsonLdGraph } from '../seo/schema';

const resolvedLocale = normalizeLocale(locale ?? Astro.url.searchParams.get('lang') ?? localeFromPath(Astro.url.pathname));
const basePath = stripLocale(Astro.url.pathname);
const origin = Astro.site ?? Astro.url.origin;
const canonical = new URL(localizedPath(basePath, resolvedLocale), origin);
const socialImage = new URL(image, origin);
const localeNames = { uk: 'uk_UA', ru: 'ru_UA' } as const;
const skipLinks = { uk: 'Перейти до змісту', ru: 'Перейти к содержанию' } as const;
const menuLabels = { uk: 'Відкрити меню', ru: 'Открыть меню' } as const;
const pageSchema = webPageSchema({
  canonical: canonical.href,
  title,
  description,
  image: socialImage.href,
  language: resolvedLocale,
  type: schemaType
});
const extraStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
const schema = jsonLdGraph([
  organizationSchema(origin),
  websiteSchema(origin, resolvedLocale),
  pageSchema,
  ...extraStructuredData
]);
const showHomeReviews = basePath === '/' && resolvedLocale === 'uk';
const availableAlternateLocales = alternateLocales ?? supportedLocales;
---
<!doctype html>
<html lang={resolvedLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {heroPreloadSrc && heroPreloadMobileSrcset && (
      <>
        <link rel="preload" as="image" media="(max-width: 900px)" href={heroPreloadMobileSrc} imagesrcset={heroPreloadMobileSrcset} imagesizes="100vw" fetchpriority="high" />
        <link rel="preload" as="image" media="(min-width: 901px)" href={heroPreloadSrc} imagesrcset={heroPreloadSrcset} imagesizes={heroPreloadSizes} fetchpriority="high" />
      </>
    )}
    {heroPreloadSrc && !heroPreloadMobileSrcset && <link rel="preload" as="image" href={heroPreloadSrc} imagesrcset={heroPreloadSrcset} imagesizes={heroPreloadSizes} fetchpriority="high" />}
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon-precomposed" sizes="180x180" href="/apple-touch-icon-precomposed.png" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {availableAlternateLocales.map((item) => <link rel="alternate" hreflang={item} href={new URL(localizedPath(basePath, item), Astro.site ?? Astro.url.origin)} />)}
    {availableAlternateLocales.includes('uk') && <link rel="alternate" hreflang="x-default" href={new URL(localizedPath(basePath, 'uk'), Astro.site ?? Astro.url.origin)} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Space Glass" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:locale" content={localeNames[resolvedLocale]} />
    {supportedLocales.filter((item) => item !== resolvedLocale).map((item) => <meta property="og:locale:alternate" content={localeNames[item]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLinks[resolvedLocale]}</a>
    <slot />
    {showHomeReviews && <GoogleReviews />}
    <SiteEnhancements />
    <HeaderFixes />
    <script is:inline define:vars={{ menuLabel: menuLabels[resolvedLocale], moveReviews: showHomeReviews }}>
      const mobileMenuButton = document.querySelector('[data-mobile-menu-button]');
      if (mobileMenuButton) {
        mobileMenuButton.setAttribute('aria-label', menuLabel);
        mobileMenuButton.setAttribute('title', menuLabel);
      }
      const heroImage = document.querySelector('.sg-hero__image img');
      if (heroImage) {
        heroImage.setAttribute('alt', 'Панорамні скляні перегородки та алюмінієві конструкції Space Glass у сучасному інтер’єрі');
        heroImage.setAttribute('decoding', 'async');
      }
      if (moveReviews) {
        const reviews = document.querySelector('[data-google-reviews]');
        const footer = document.querySelector('footer');
        if (reviews && footer) footer.before(reviews);
      }
    </script>
    <script src="/js/i18n-client.js" defer></script>
    <script src="/js/forms.js" defer></script>
  </body>
</html>
