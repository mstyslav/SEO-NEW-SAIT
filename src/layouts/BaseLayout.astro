---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale?: import('../i18n/helpers').Locale;
  image?: string;
  schemaType?: 'Organization' | 'WebSite' | 'WebPage' | 'CollectionPage' | 'AboutPage' | 'ContactPage' | 'Service' | 'Article' | 'CreativeWork';
  structuredData?: import('../seo/schema').JsonLdObject | import('../seo/schema').JsonLdObject[];
  alternateLocales?: import('../i18n/helpers').Locale[];
}


const { title, description, locale, image = '/images/v5/hero.webp', schemaType = 'WebPage', structuredData = [], alternateLocales = supportedLocales } = Astro.props;

import { localeFromPath, normalizeLocale, stripLocale, localizedPath, supportedLocales } from '../i18n/helpers';
import { organizationSchema, websiteSchema, webPageSchema, jsonLdGraph } from '../seo/schema';

const resolvedLocale = normalizeLocale(locale ?? Astro.url.searchParams.get('lang') ?? localeFromPath(Astro.url.pathname));
const basePath = stripLocale(Astro.url.pathname);
const origin = Astro.site ?? Astro.url.origin;
const canonical = new URL(localizedPath(basePath, resolvedLocale), origin);
const socialImage = new URL(image, origin);
const localeNames = { uk: 'uk_UA', ru: 'ru_UA', en: 'en_US', de: 'de_DE' } as const;
const skipLinks = { uk: 'Перейти до змісту', ru: 'Перейти к содержанию', en: 'Skip to content', de: 'Zum Inhalt springen' } as const;
const pageSchema = webPageSchema({
  canonical: canonical.href,
  title,
  description,
  image: socialImage.href,
  language: resolvedLocale,
  type: schemaType
});
const extraStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
const schema = jsonLdGraph([
  organizationSchema(origin),
  websiteSchema(origin, resolvedLocale),
  pageSchema,
  ...extraStructuredData
]);
---
<!doctype html>
<html lang={resolvedLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {alternateLocales.map((item) => <link rel="alternate" hreflang={item} href={new URL(localizedPath(basePath, item), Astro.site ?? Astro.url.origin)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPath(basePath, 'uk'), Astro.site ?? Astro.url.origin)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Space Glass" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:locale" content={localeNames[resolvedLocale]} />
    {alternateLocales.filter((item) => item !== resolvedLocale).map((item) => <meta property="og:locale:alternate" content={localeNames[item]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLinks[resolvedLocale]}</a>
    <slot />
      <script src="/js/i18n-client.js" defer></script>
  </body>
</html>
