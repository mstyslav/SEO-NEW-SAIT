---
import '../styles/global.css';
import '../styles/page-h1-desktop.css';
import '../styles/header-cta-desktop.css';
import SiteEnhancements from '../components/SiteEnhancements.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import HeaderFixes from '../components/HeaderFixes.astro';
import CookieConsent from '../components/CookieConsent.astro';

/** GA4 property of space-glass.com.ua — the only analytics tag on the site (no GTM / Zaraz). */
const GA_ID = 'G-6XC74F42CW';

interface Props {
  title: string;
  description: string;
  locale?: import('../i18n/helpers').Locale;
  image?: string;
  alternateLocales?: import('../i18n/helpers').Locale[];
  schemaType?: 'Organization' | 'WebSite' | 'WebPage' | 'CollectionPage' | 'AboutPage' | 'ContactPage' | 'Service' | 'Article' | 'CreativeWork';
  structuredData?: import('../seo/schema').JsonLdObject | import('../seo/schema').JsonLdObject[];
  heroPreloadSrc?: string;
  heroPreloadSrcset?: string;
  heroPreloadSizes?: string;
  heroPreloadMobileSrc?: string;
  heroPreloadMobileSrcset?: string;
  /** Must match the page's <source media="(max-width: …)"> breakpoint. */
  heroPreloadMobileMaxWidth?: number;
  robots?: string;
  /** @id of the page's main entity, linked from the #webpage node as mainEntity. */
  mainEntityId?: string;
  /** 404 pages are served as the body of any unknown URL: no canonical, hreflang, og:url or WebPage node. */
  errorPage?: boolean;
  /** Person nodes added as `founder` of the #organization node on this page only. */
  organizationFounders?: import('../seo/schema').JsonLdObject[];
}

const { title: rawTitle, description: rawDescription, locale, image = '/images/v5/hero.webp', schemaType = 'WebPage', structuredData = [], alternateLocales, heroPreloadSrc, heroPreloadSrcset, heroPreloadSizes, heroPreloadMobileSrc, heroPreloadMobileSrcset, heroPreloadMobileMaxWidth = 900, robots, mainEntityId, errorPage = false, organizationFounders = [] } = Astro.props;

import { localeFromPath, normalizeLocale, stripLocale, localizedPath, supportedLocales, hasLocalizedRoute, isIntlLocale } from '../i18n/helpers';
import { intlDeOnlyFallback, intlLocales } from '../i18n/intl-routes';
import { organizationSchema, websiteSchema, webPageSchema, jsonLdGraph } from '../seo/schema';

/**
 * Keep search snippets inside the agreed SEO limits without touching H1/body copy.
 * Prefer a complete sentence for descriptions; otherwise cut at a word boundary.
 * For overlong titles the brand suffix is removed first so the page topic is preserved.
 */
const fitSeoText = (value: string, max: number, kind: 'title' | 'description') => {
  let text = String(value ?? '').replace(/\s+/g, ' ').trim();
  if (text.length <= max) return text;

  if (kind === 'title') {
    text = text.replace(/\s*(?:\||—|–|-)?\s*Space Glass\s*$/i, '').trim();
    if (text.length <= max) return text;
  }

  if (kind === 'description') {
    const sentence = text.slice(0, max + 1).match(/^(.{80,155}?[.!?])(?:\s|$)/);
    if (sentence && sentence[1].length <= max) return sentence[1].trim();
  }

  const suffix = kind === 'description' ? '…' : '';
  const room = max - suffix.length;
  let cut = text.slice(0, room + 1);
  const boundary = cut.lastIndexOf(' ');
  if (boundary >= Math.floor(room * 0.72)) cut = cut.slice(0, boundary);
  else cut = cut.slice(0, room);
  return cut.replace(/[\s,;:–—-]+$/g, '').trim() + suffix;
};

const title = fitSeoText(rawTitle, 60, 'title');
const description = fitSeoText(rawDescription, 155, 'description');

const resolvedLocale = normalizeLocale(locale ?? Astro.url.searchParams.get('lang') ?? localeFromPath(Astro.url.pathname));
const basePath = stripLocale(Astro.url.pathname);
const origin = Astro.site ?? Astro.url.origin;
const canonical = new URL(localizedPath(basePath, resolvedLocale), origin);
const socialImage = new URL(image, origin);
const localeNames = { uk: 'uk_UA', ru: 'ru_UA', en: 'en_GB', de: 'de_AT', es: 'es_ES' } as const;
const skipLinks = { uk: 'Перейти до змісту', ru: 'Перейти к содержанию', en: 'Skip to content', de: 'Zum Inhalt springen', es: 'Ir al contenido' } as const;
const menuLabels = { uk: 'Відкрити меню', ru: 'Открыть меню', en: 'Open menu', de: 'Menü öffnen', es: 'Abrir el menú' } as const;
// Alt text the inline script below gives the homepage hero image (uk/ru keep the original text).
const heroAlts = {
  uk: 'Панорамні скляні перегородки та алюмінієві конструкції Space Glass у сучасному інтер’єрі',
  ru: 'Панорамні скляні перегородки та алюмінієві конструкції Space Glass у сучасному інтер’єрі',
  en: 'Floor-to-ceiling glass partitions and aluminium structures by Space Glass in a modern interior',
  de: 'Raumhohe Glastrennwände und Aluminiumkonstruktionen von Space Glass in einem modernen Interieur',
  es: 'Tabiques de vidrio de suelo a techo y estructuras de aluminio de Space Glass en un interior moderno'
} as const;
const pageSchema = webPageSchema({
  canonical: canonical.href,
  title,
  description,
  image: socialImage.href,
  language: resolvedLocale,
  type: schemaType,
  mainEntityId
});
const extraStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
const schema = jsonLdGraph([
  organizationSchema(origin, organizationFounders),
  websiteSchema(origin, resolvedLocale),
  ...(errorPage ? [] : [pageSchema]),
  ...extraStructuredData
]);
const showHomeReviews = basePath === '/' && resolvedLocale === 'uk';
// hreflang only for language versions that really exist: a UA-only page must not declare
// hreflang="ru" pointing at its own UA URL (localizedPath falls back to the UA path).
// EN/DE/ES alternates always come from the route map (src/i18n/intl-routes.ts), also on pages that
// restrict `alternateLocales` to uk/ru, so every UA/RU ↔ EN/DE/ES pair is reciprocal.
const declaredAlternates = alternateLocales ?? supportedLocales;
// A German-only page (no UA/RU original) declares only itself: no fake twins, no x-default to a UA page.
const isDeOnlyPage = Boolean(intlDeOnlyFallback(basePath));
const availableAlternateLocales = isDeOnlyPage
  ? [resolvedLocale]
  : [...new Set([...declaredAlternates, ...intlLocales])].filter((item) => item === 'uk' || item === resolvedLocale || hasLocalizedRoute(basePath, item));
import ScrollProgress from '../components/ScrollProgress.astro';
// The page language comes only from the URL (/ru/… = RU, everything else = UA). translate="no" +
// notranslate stop browsers (Chrome/Yandex/Safari with a Russian UI) from auto-translating a UA page
// into Russian on the same URL; the RU version is a separate /ru/ page.
---
<!doctype html>
<html lang={resolvedLocale} translate="no">
  <head>
    <meta charset="UTF-8" />
    <meta name="google" content="notranslate" />
    <script is:inline define:vars={{ gaId: GA_ID }}>
      // GA4 with Consent Mode: analytics_storage is denied (no cookies) until the visitor
      // accepts in the cookie banner (components/CookieConsent.astro); the choice is remembered.
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      let consent = null;
      try { consent = localStorage.getItem('sg-cookie-consent'); } catch {}
      window.gtag('consent', 'default', { analytics_storage: consent === 'all' ? 'granted' : 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
      window.gtag('js', new Date());
      window.gtag('config', gaId);
    </script>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <meta name="viewport" content="width=device-width" />
    {heroPreloadSrc && (heroPreloadMobileSrc || heroPreloadMobileSrcset) && (
      <>
        <link rel="preload" as="image" media={`(max-width: ${heroPreloadMobileMaxWidth}px)`} href={heroPreloadMobileSrc} imagesrcset={heroPreloadMobileSrcset} imagesizes={heroPreloadMobileSrcset ? '100vw' : undefined} fetchpriority="high" />
        <link rel="preload" as="image" media={`(min-width: ${heroPreloadMobileMaxWidth + 1}px)`} href={heroPreloadSrc} imagesrcset={heroPreloadSrcset} imagesizes={heroPreloadSizes} fetchpriority="high" />
      </>
    )}
    {heroPreloadSrc && !heroPreloadMobileSrc && !heroPreloadMobileSrcset && <link rel="preload" as="image" href={heroPreloadSrc} imagesrcset={heroPreloadSrcset} imagesizes={heroPreloadSizes} fetchpriority="high" />}
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon-precomposed" sizes="180x180" href="/apple-touch-icon-precomposed.png" />
    <title>{title}</title>
    {!errorPage && <link rel="canonical" href={canonical} />}
    {!errorPage && availableAlternateLocales.map((item) => <link rel="alternate" hreflang={item} href={new URL(localizedPath(basePath, item), Astro.site ?? Astro.url.origin)} />)}
    {!errorPage && availableAlternateLocales.includes('uk') && <link rel="alternate" hreflang="x-default" href={new URL(localizedPath(basePath, 'uk'), Astro.site ?? Astro.url.origin)} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Space Glass" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!errorPage && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:locale" content={localeNames[resolvedLocale]} />
    {availableAlternateLocales.filter((item) => item !== resolvedLocale).map((item) => <meta property="og:locale:alternate" content={localeNames[item]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLinks[resolvedLocale]}</a>
    <slot />
    {showHomeReviews && <GoogleReviews />}
    <SiteEnhancements />
    <HeaderFixes />
    <script is:inline define:vars={{ menuLabel: menuLabels[resolvedLocale], moveReviews: showHomeReviews, heroAlt: heroAlts[resolvedLocale] }}>
      const mobileMenuButton = document.querySelector('[data-mobile-menu-button]');
      if (mobileMenuButton) {
        mobileMenuButton.setAttribute('aria-label', menuLabel);
        mobileMenuButton.setAttribute('title', menuLabel);
      }
      const heroImage = document.querySelector('.sg-hero__image img');
      if (heroImage) {
        heroImage.setAttribute('alt', heroAlt);
        heroImage.setAttribute('decoding', 'async');
      }
      if (moveReviews) {
        const reviews = document.querySelector('[data-google-reviews]');
        const footer = document.querySelector('footer');
        if (reviews && footer) footer.before(reviews);
      }
    </script>
    <CookieConsent locale={resolvedLocale} />
    <script src="/js/i18n-client.js?v=langs-20261016" defer></script>
    <script src="/js/forms.js?v=langs-20261016" defer></script>
      <ScrollProgress />
  </body>
</html>
