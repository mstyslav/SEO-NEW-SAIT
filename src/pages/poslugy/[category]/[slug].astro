---
import SeoServicePage from '../../../components/SeoServicePage.astro';
import { ukSeoServices } from '../../../data/seo-services';
export function getStaticPaths() {
  return ukSeoServices.map((service) => ({ params: { category: service.categorySlug, slug: service.slug }, props: { service } }));
}
const { service } = Astro.props;
---
<SeoServicePage service={service} />
