---
import SeoServicePage from '../../../components/SeoServicePage.astro';
import { ukSeoServices } from '../../../data/seo-services';
export function getStaticPaths() {
  return ukSeoServices
    .filter((service) => service.categorySlug !== 'dushovi-konstruktsii' && service.categorySlug !== 'bezramne-sklinnya' && service.categorySlug !== 'sklyani-fasady' && service.categorySlug !== 'sklyani-dveri' && service.categorySlug !== 'sklyani-ohorozhi')
    .map((service) => ({ params: { category: service.categorySlug, slug: service.slug }, props: { service } }));
}
const { service } = Astro.props;
---
<SeoServicePage service={service} />
