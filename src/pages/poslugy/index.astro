---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/services-full-cycle.css';

const services = [
  ['01', 'Замір та консультація', 'Точні розміри, оцінка об’єкта та підбір оптимального технічного рішення.', '/images/projects/osocor-residence-glazing-kyiv/osocor-residence-glazing-kyiv-detail-01.webp', 'Замір для безрамного скління на об’єкті Space Glass', 960, 1280],
  ['02', 'Проєктування', 'Креслення, вузли, підбір скла, профілів, фурнітури та способів кріплення.', '/images/projects/office-partitions-morskyi-odesa/office-partitions-morskyi-odesa-detail-03.webp', 'Профіль і вузол скляної перегородки Space Glass', 960, 1280],
  ['03', 'Виготовлення', 'Виробництво конструкцій за індивідуальними розмірами та затвердженим проєктом.', '/images/projects/restaurant-glazing-artshat-odesa/restaurant-glazing-artshat-odesa-detail-03.webp', 'Алюмінієвий профіль фасадного скління', 960, 1280],
  ['04', 'Доставка', 'Професійне пакування та безпечна доставка конструкцій безпосередньо на об’єкт.', '/images/projects/glass-stair-railing-private-house-odesa/glass-stair-railing-private-house-odesa-detail-03.webp', 'Кріплення скляної огорожі до основи', 720, 1280],
  ['05', 'Монтаж', 'Професійний монтаж, регулювання, герметизація та підготовка конструкції до експлуатації.', '/images/projects/coffee-ocean-facade-odesa/coffee-ocean-glass-entrance-odesa.webp', 'Скляна вхідна група після монтажу', 960, 1280],
  ['06', 'Сервіс та гарантія', 'Гарантійна підтримка, регулювання, заміна комплектуючих та обслуговування.', '/images/projects/osocor-residence-glazing-kyiv/osocor-residence-glazing-kyiv-detail-05.webp', 'Безрамне скління тераси після монтажу', 960, 1280]
] as const;
const process = [['01','Заявка','Розповідаєте про задачу'],['02','Замір','Фіксуємо точні розміри'],['03','Проєкт','Розробляємо технічне рішення'],['04','Виробництво','Виготовляємо конструкцію'],['05','Монтаж','Встановлюємо на об’єкті'],['06','Результат','Передаємо готову конструкцію']] as const;
const projects = [
  ['Скляні офісні перегородки','Одеса · БЦ Морський','Готове рішення для зонування офісного простору.','/projects/office-partitions-morskyi-odesa/','/images/projects/office-partitions-morskyi-odesa/office-partitions-morskyi-odesa-hero.webp','Офісні перегородки у БЦ Морський — реалізований проєкт Space Glass',960,1280],
  ['Скляна огорожа сходів','Одеса · приватний будинок','Огорожа, спроєктована за геометрією сходів і другого світла.','/projects/glass-stair-railing-private-house-odesa/','/images/projects/glass-stair-railing-private-house-odesa/glass-stair-railing-private-house-odesa-hero.webp','Огорожа сходів у приватному будинку — реалізований проєкт Space Glass',720,1280],
  ['Фасадне скління кав’ярні','Одеса · Coffee Ocean','Фасад, вікно видачі та вхідна група для комерційного об’єкта.','/projects/coffee-ocean-facade-odesa/','/images/projects/coffee-ocean-facade-odesa/coffee-ocean-facade-odesa-hero.webp','Фасадне скління Coffee Ocean — реалізований проєкт Space Glass',960,1280]
] as const;
const directions = [
  ['Душові кабіни','/dushovi-kabiny/'],['Скляні перегородки','/sklyani-perehorodky/'],['Скляні двері','/sklyani-dveri/'],['Скляні огорожі','/sklyani-ohorozhi/'],['Дзеркала','/dzerkala/'],['Безрамне скління','/poslugy/bezramne-sklinnya/'],['Скляні фасади','/arkhitekturni-systemy/'],['Алюмінієві конструкції','/alyuminiievi-konstruktsii/'],['Металопластикові конструкції','/metaloplastykovi-konstruktsii/'],['Архітектурні системи','/arkhitekturni-systemy/']
] as const;
const faq = [
  ['Скільки коштує виготовлення конструкції?','Вартість залежить від типу конструкції, розмірів, скла, профільної системи, фурнітури та умов монтажу. Для попереднього розрахунку надішліть фото, орієнтовні розміри або креслення.'],
  ['Чи можна отримати попередній розрахунок без виїзду замірника?','Так. Для стартової оцінки достатньо фото, приблизних розмірів, міста та короткого опису задачі. Точне рішення і кошторис погоджуємо після заміру та уточнення комплектації.'],
  ['Які терміни виготовлення?','Терміни залежать від типу конструкції, комплектації, обсягу проєкту та графіка монтажу. Після уточнення технічного рішення називаємо реалістичний план робіт.'],
  ['Чи працюєте ви за кресленнями архітектора або дизайнера?','Так. Аналізуємо надані креслення, уточнюємо вузли та адаптуємо рішення до фактичних умов об’єкта, скла, профілів і способів кріплення.'],
  ['Чи виконуєте монтаж в інших містах України?','Так, реалізуємо проєкти по Україні. Формат заміру, логістики та монтажу погоджуємо окремо з урахуванням міста й особливостей об’єкта.'],
  ['Яка гарантія на конструкції та монтаж?','Умови гарантії залежать від конкретної системи, фурнітури та складу робіт. Їх фіксуємо у пропозиції після погодження технічного рішення.']
] as const;
---
<BaseLayout title="Послуги Space Glass — замір, проєктування, виготовлення та монтаж" description="Послуги Space Glass: повний цикл реалізації скляних та алюмінієвих конструкцій в Україні — замір, проєктування, виготовлення, доставка, монтаж і сервіс." schemaType="Service" locale="uk" image="/images/projects/osocor-residence-glazing-kyiv/osocor-residence-glazing-kyiv-hero.webp">
  <div class="sg-page-shell"><Header />
    <main id="main" class="services-cycle">
      <section class="services-cycle__hero" aria-labelledby="services-title">
        <div class="services-cycle__hero-copy"><p class="services-cycle__eyebrow">ПОСЛУГИ SPACE GLASS</p><h1 id="services-title">Від задуму до готової конструкції</h1><p>Повний цикл реалізації скляних та алюмінієвих конструкцій — від першого заміру та проєктування до виготовлення, монтажу й сервісу.</p><a class="button button--mint" href="/quote/">Обговорити проєкт</a></div>
        <div class="services-cycle__hero-image"><img src="/images/projects/osocor-residence-glazing-kyiv/osocor-residence-glazing-kyiv-hero.webp" alt="Комплексне скління OSOCOR RESIDENCE — реалізований проєкт Space Glass" width="960" height="1280" loading="eager" fetchpriority="high" decoding="async" /></div>
      </section>
      <section class="services-cycle__section" aria-labelledby="full-cycle-title">
        <div class="services-cycle__section-head"><p class="services-cycle__eyebrow">ПОВНИЙ ЦИКЛ</p><h2 id="full-cycle-title">Усе необхідне для реалізації проєкту — в одній команді</h2><p>Координуємо весь шлях конструкції, щоб технічне рішення, виробництво й монтаж працювали як єдиний процес.</p></div>
        <div class="services-cycle__service-grid">{services.map(([number,title,text,image,alt,width,height],index) => <article class:list={['services-cycle__service',index % 2 === 1 && 'services-cycle__service--reverse']}><div class="services-cycle__service-image"><img src={image} alt={alt} width={width} height={height} loading="lazy" decoding="async" /></div><div class="services-cycle__service-copy"><span>{number}</span><h3>{title}</h3><p>{text}</p></div></article>)}</div>
      </section>
      <section class="services-cycle__image-break" aria-label="Підхід Space Glass до реалізації проєктів"><img src="/images/projects/restaurant-glazing-artshat-odesa/restaurant-glazing-artshat-odesa-detail-04.webp" alt="Фасадне скління з боку тераси після монтажу" width="960" height="1280" loading="lazy" decoding="async" /><p>Від креслення — до монтажу на об’єкті</p></section>
      <section class="services-cycle__section services-cycle__process" aria-labelledby="process-title"><div class="services-cycle__section-head services-cycle__section-head--split"><div><p class="services-cycle__eyebrow">ПРОЦЕС</p><h2 id="process-title">Як ми працюємо</h2></div><p>Прозорий маршрут від першого запиту до передання готової конструкції.</p></div><ol class="services-cycle__timeline">{process.map(([number,title,text]) => <li><span>{number}</span><h3>{title}</h3><p>{text}</p></li>)}</ol></section>
      <section class="services-cycle__numbers" aria-labelledby="numbers-title"><div class="services-cycle__numbers-head"><p class="services-cycle__eyebrow">ДОСВІД У ЦИФРАХ</p><h2 id="numbers-title">Точність, яку видно в масштабі робіт</h2></div><div class="services-cycle__numbers-grid"><article><strong>5 000+</strong><p>реалізованих проєктів<br />для дому та бізнесу<br />в Україні та Європі</p></article><article><strong>50 000+</strong><p>м² виконаного засклення<br />житлових та комерційних<br />об’єктів різної складності</p></article><article><strong>10+</strong><p>років реального досвіду<br />в реалізації скляних та<br />алюмінієвих конструкцій</p></article><article><strong>3</strong><p>Київ · Одеса · Львів<br />реалізація проєктів<br />по всій Україні</p></article></div></section>
      <section class="services-cycle__section" aria-labelledby="projects-title"><div class="services-cycle__section-head services-cycle__section-head--split"><div><p class="services-cycle__eyebrow">РЕАЛІЗОВАНІ ПРОЄКТИ</p><h2 id="projects-title">Від проєкту до реалізації</h2></div><a class="services-cycle__text-link" href="/projects/">Усі проєкти <span aria-hidden="true">→</span></a></div><div class="services-cycle__projects-grid">{projects.map(([title,location,text,href,image,alt,width,height]) => <a class="services-cycle__project" href={href}><div><img src={image} alt={alt} width={width} height={height} loading="lazy" decoding="async" /></div><span>{location}</span><h3>{title}</h3><p>{text}</p><i aria-hidden="true">→</i></a>)}</div></section>
      <section class="services-cycle__section services-cycle__directions" aria-labelledby="directions-title"><div class="services-cycle__section-head"><p class="services-cycle__eyebrow">НАПРЯМКИ</p><h2 id="directions-title">Працюємо з різними типами конструкцій</h2><p>Підбираємо матеріали, системи та спосіб монтажу відповідно до задачі об’єкта.</p></div><nav aria-label="Напрямки Space Glass"><ul>{directions.map(([title,href]) => <li><a href={href}><span>{title}</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" /></svg></a></li>)}</ul></nav></section>
      <section class="services-cycle__geography" aria-labelledby="geography-title"><div><p class="services-cycle__eyebrow">ГЕОГРАФІЯ</p><h2 id="geography-title">Реалізуємо проєкти по всій Україні</h2></div><p>Працюємо у Києві, Одесі та Львові, а також організовуємо реалізацію проєктів в інших містах України — з урахуванням логістики та умов об’єкта.</p><ul><li>Київ</li><li>Одеса</li><li>Львів</li></ul></section>
      <section class="services-cycle__section services-cycle__faq" aria-labelledby="faq-title"><div class="services-cycle__section-head"><p class="services-cycle__eyebrow">FAQ</p><h2 id="faq-title">Відповіді перед початком роботи</h2></div><div class="services-cycle__faq-grid">{faq.map(([question,answer]) => <details><summary><span>{question}</span><i aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></section>
      <section class="services-cycle__cta" aria-labelledby="cta-title"><div><p class="services-cycle__eyebrow">ВАШ ПРОЄКТ</p><h2 id="cta-title">Маєте ідею або готове креслення?</h2><p>Надішліть фото, розміри або креслення — підготуємо технічне рішення та попередній розрахунок вартості.</p><small>Фото · PDF · DWG</small></div><a class="button button--mint" href="/quote/">Отримати розрахунок</a></section>
    </main><Footer />
  </div>
</BaseLayout>
