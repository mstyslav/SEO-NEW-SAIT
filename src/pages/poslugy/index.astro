---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { seoCategories } from '../../data/seo-services';
import { showerServiceNavigation } from '../../data/service-navigation';

const featuredCategories = [
  {
    slug: 'alyuminiievi-konstruktsii',
    name: 'Алюмінієві конструкції',
    href: '/alyuminiievi-konstruktsii/',
    services: [
      { shortName: 'Алюмінієві вікна', path: '/alyuminiievi-konstruktsii/' },
      { shortName: 'Алюмінієві двері', path: '/alyuminiievi-konstruktsii/' },
      { shortName: 'Розсувні системи', path: '/alyuminiievi-konstruktsii/' },
      { shortName: 'Алюмінієві фасади', path: '/alyuminiievi-konstruktsii/' },
      { shortName: 'Зимові сади', path: '/alyuminiievi-konstruktsii/' },
      { shortName: 'Перголи', path: '/alyuminiievi-konstruktsii/' }
    ]
  },
  {
    slug: 'metaloplastykovi-konstruktsii',
    name: 'Металопластикові конструкції',
    href: '/metaloplastykovi-konstruktsii/',
    services: [
      { shortName: 'Металопластикові вікна', path: '/metaloplastykovi-konstruktsii/' },
      { shortName: 'Металопластикові двері', path: '/metaloplastykovi-konstruktsii/' },
      { shortName: 'Балконні блоки', path: '/metaloplastykovi-konstruktsii/' },
      { shortName: 'Розсувні ПВХ-системи', path: '/metaloplastykovi-konstruktsii/' }
    ]
  }
];

const glassForBusiness = seoCategories.find(
  (category) => category.slug === 'sklo-dlia-biznesu'
);

const regularCategories = seoCategories.filter(
  (category) => category.slug !== 'sklo-dlia-biznesu'
);

const categoryOrder = [
  'dushovi-konstruktsii',
  'dzerkala',
  'sklyani-perehorodky',
  'sklyani-dveri',
  'sklyani-ohorozhi',
  'bezramne-sklinnya',
  'alyuminiievi-konstruktsii',
  'sklyani-fasady',
  'metaloplastykovi-konstruktsii',
  'sklo-dlia-biznesu'
];

const allDisplayCategories = [
  ...seoCategories.map((category) => category.slug === 'dushovi-konstruktsii'
    ? {
        ...category,
        href: '/dushovi-kabiny/',
        services: showerServiceNavigation.map(({ label, href }) => ({ shortName: label, path: href }))
      }
    : {
        ...category,
        href: `/poslugy/${category.slug}/`
      }),
  ...featuredCategories
];

const displayCategories = categoryOrder
  .map((slug) => allDisplayCategories.find((category) => category.slug === slug))
  .filter(Boolean);

const categoryDescriptions: Record<string, string> = {
  'dushovi-konstruktsii': 'Піддони, кутові кабіни, двері й перегородки для душу та скляні шторки для ванни.',
  'dzerkala': 'Дзеркала за розміром, із підсвіткою, для ванної, дому та комерційних просторів.',
  'sklyani-perehorodky': 'Loft, офісні, міжкімнатні, розсувні, мобільні та безрамні системи.',
  'sklyani-dveri': 'Розпашні, розсувні, маятникові двері та рішення в алюмінієвому профілі.',
  'sklyani-ohorozhi': 'Огорожі сходів, балконів і терас — безрамні, на стійках або в профілі.',
  'bezramne-sklinnya': 'Скління терас, балконів, альтанок і панорамні розсувні системи.',
  'alyuminiievi-konstruktsii': 'Вікна, двері, фасади, розсувні системи, зимові сади та перголи.',
  'sklyani-fasady': 'Вітринне, структурне та стійково-ригельне скління фасадів і вхідних груп.',
  'metaloplastykovi-konstruktsii': 'Вікна, двері, балконні блоки та енергоефективні розсувні ПВХ-системи.',
  'sklo-dlia-biznesu': 'Вітрини, козирки, стільниці, полиці та спеціальні рішення для бізнесу.'
};
---
<BaseLayout title="Послуги зі скла на замовлення в Україні | Space Glass" description="50+ рішень зі скла для дому й бізнесу: душові, перегородки, двері, огорожі, дзеркала, фасади та безрамне скління з монтажем." availableLocales={['uk']}>
  <div class="sg-page-shell">
    <Header />
    <main id="main" class="services-index">
      <div class="services-index__wrap">
        <section class="services-categories" aria-labelledby="services-categories-title">
          <header class="services-categories__head">
            <p class="eyebrow">Основні напрямки</p>
            <h1 id="services-categories-title">Категорії конструкцій</h1>
          </header>
          <div class="services-categories__grid">
            {displayCategories.map((category, index) => (
              <article class="service-category-card" data-href={category.href} tabindex="0" role="link">
                <div class="service-category-card__meta">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <span>{category.services.length} рішень</span>
                </div>
                <h2><a href={category.href}>{category.name}</a></h2>
                <p>{categoryDescriptions[category.slug] ?? category.services.slice(0,4).map((service) => service.shortName).join(', ')}</p>
                <div class="service-category-card__links" aria-label={`Популярні рішення: ${category.name}`}>
                  {category.services.map((service) => <a href={service.path}>{service.shortName}</a>)}
                </div>
                <a class="service-category-card__more" href={category.href}>Переглянути категорію <span aria-hidden="true">→</span></a>
              </article>
            ))}
          </div>
        </section>

      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('.service-category-card[data-href]').forEach((card) => {
    const openCard = (event: Event) => {
      if ((event.target as HTMLElement).closest('a,button')) return;
      const href = card.dataset.href;
      if (href) window.location.href = href;
    };
    card.addEventListener('click', openCard);
    card.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      const href = card.dataset.href;
      if (href) window.location.href = href;
    });
  });
</script>

<style>
  .services-index { --services-ink:#15201c; --services-muted:#5f6c67; --services-line:#d7e6df; --services-deep:#07543d; background:#f5f7f6; color:var(--services-ink); }
  .services-index__wrap { width:min(100%,1600px); margin:0 auto; padding:0 28px; }
  .services-categories { margin:28px 0 76px; padding:34px 30px 38px; border:1px solid var(--services-line); border-radius:22px; background:#fff; }
  .services-categories__head { margin-bottom:22px; }
  .services-categories__head .eyebrow { margin:0 0 7px; font-size:10px; }
  .services-categories__head h1 { margin:0; font-size:clamp(26px,2.6vw,38px)!important; line-height:1.05!important; letter-spacing:-.035em!important; }
  .services-categories__grid { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:12px; }
  .service-category-card { position:relative; display:flex; min-width:0; min-height:320px; flex-direction:column; padding:22px 20px 21px; overflow:hidden; border:1px solid var(--services-line); border-radius:16px; background:linear-gradient(145deg,#fff 76%,#f2faf6); cursor:pointer; transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease; }
  .service-category-card:focus-visible { outline:2px solid var(--services-deep); outline-offset:3px; }
  .service-category-card::before { content:""; position:absolute; top:-54px; right:-54px; width:126px; height:126px; border:1px solid rgba(127,215,189,.35); transform:rotate(45deg); }
  .service-category-card:hover { border-color:#96cdb9; box-shadow:0 16px 38px rgba(10,70,50,.08); transform:translateY(-2px); }
  .service-category-card__meta { position:relative; display:flex; justify-content:space-between; gap:10px; color:var(--services-deep); font-size:10px; font-weight:850; letter-spacing:.09em; text-transform:uppercase; }
  .service-category-card h2 { position:relative; margin:29px 0 9px; font-size:clamp(17px,1.22vw,21px)!important; line-height:1.1!important; letter-spacing:-.03em!important; }
  .service-category-card h2 a { color:inherit; text-decoration:none; }
  .service-category-card>p { position:relative; min-height:78px; margin:0; color:var(--services-muted); font-size:13px; line-height:1.48; }
  .service-category-card__links { position:relative; display:flex; align-items:flex-start; flex-direction:column; gap:5px; margin:15px 0 17px; }
  .service-category-card__links a { width:max-content; max-width:100%; padding:5px 7px; border:1px solid #dce9e3; border-radius:999px; background:rgba(255,255,255,.82); color:#52615b; font-size:10px; line-height:1.2; text-decoration:none; }
  .service-category-card__links a:hover { border-color:#8fc8b3; color:var(--services-deep); }
  .service-category-card__more { position:relative; display:flex; align-items:center; justify-content:space-between; gap:10px; margin-top:auto; padding-top:15px; border-top:1px solid var(--services-line); color:var(--services-deep); font-size:12px; font-weight:850; text-decoration:none; }
  .service-category-card__more span { font-size:20px; transition:transform .2s ease; }
  .service-category-card:hover .service-category-card__more span { transform:translateX(4px); }
  @media(max-width:1250px){ .services-categories__grid{grid-template-columns:repeat(3,minmax(0,1fr))} }
  @media(max-width:900px){
    .services-categories__grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  }
  @media(max-width:760px){
    .services-index__wrap{padding:0 18px}
    .services-categories{margin-top:14px;padding:26px 18px 28px;border-radius:18px}
    .services-categories__head{margin-bottom:20px}
    .services-categories__head h1{font-size:clamp(25px,8vw,34px)!important}
    .services-categories__grid{grid-template-columns:1fr}
    .service-category-card{min-height:310px;padding:24px 22px}
    .service-category-card h2{margin-top:28px}
  }
</style>
