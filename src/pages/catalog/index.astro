---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import catalog from '../../data/catalog.json';
import productData from '../../data/products.json';
import { breadcrumbSchema } from '../../seo/schema';

const products = productData.products;
const origin = Astro.site ?? Astro.url.origin;
const structuredData = [
  breadcrumbSchema([
    { label: 'Головна', href: new URL('/', origin) },
    { label: 'Каталог', href: new URL('/catalog/', origin) }
  ]),
  {
    '@type': 'ItemList',
    name: 'Каталог Space Glass',
    itemListElement: catalog.categories.map((category, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: category.title,
      url: new URL(`/${category.slug}/`, origin).href
    }))
  }
];
---
<BaseLayout schemaType="CollectionPage" structuredData={structuredData} title="Каталог Space Glass" description="Каталог душових, перегородок, дверей, огорож, дзеркал та алюмінієвих конструкцій Space Glass.">
<div class="sg-page-shell">
  <Header />
  <main id="main">
    <section class="catalog-v14-hero">
      <div><p class="eyebrow">Каталог</p><h1>Скляні та алюмінієві рішення</h1><p class="lead">Готові товари, індивідуальні конструкції, доставка по Україні та монтаж у ключових містах.</p></div>
      <div class="catalog-v14-search"><input type="search" placeholder="Пошук по каталогу" /><button class="button button--mint">Знайти</button></div>
    </section>

    <section class="catalog-v14-categories">
      {catalog.categories.map((category,i)=><a href={`/${category.slug}/`}><span>{String(i+1).padStart(2,'0')}</span><h2>{category.title}</h2><p>{category.subtitle}</p><ul>{category.items.slice(0,4).map(item=><li>{item}</li>)}</ul><b>Перейти →</b></a>)}
    </section>

    <section class="catalog-v14-products">
      <div class="category-heading"><div><p class="eyebrow">Популярні товари</p><h2>Рішення, які обирають найчастіше</h2></div><select><option>Популярні спочатку</option><option>Ціна за зростанням</option></select></div>
      <div class="catalog-product-grid">
        {products.map((product,i)=><a class="catalog-product" href="/catalog/piddon/">
          <div class="catalog-product__media">
            <span>{String(i+1).padStart(2,'0')}</span>
            <div class="catalog-product__badges">
              {product.badges.includes('top') && <em>ТОП</em>}
              {product.badges.includes('hit') && <em>ХІТ</em>}
            </div>
          </div>
          <div class="catalog-product__body">
            <small>{product.category}</small>
            <span class="catalog-product__availability">● {product.availabilityLabel}</span>
            <h3>{product.name}</h3>
            <strong>від {product.priceFrom}</strong>
            <b>Детальніше →</b>
          </div>
        </a>)}
      </div>
    </section>
  </main>
  <Footer />
</div>
</BaseLayout>
