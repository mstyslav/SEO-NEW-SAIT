---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import catalog from '../../data/catalog.json';

const categoryImages: Record<string, string> = {
  'dushovi-kabiny': '/images/s24-menu/showers.webp',
  'sklyani-perehorodky': '/images/s24-menu/partitions.webp',
  'sklyani-dveri': '/images/s24-menu/doors.webp',
  'sklyani-ohorozhi': '/images/s24-menu/railings.webp',
  dzerkala: '/images/s24-menu/mirrors.webp',
  'alyuminiievi-konstruktsii': '/images/s24-menu/aluminium.webp',
  'arkhitekturni-systemy': '/images/s24-menu/facades.webp'
};
---
<BaseLayout title="Каталог Space Glass" description="Каталог душових, перегородок, дверей, огорож, дзеркал та алюмінієвих конструкцій Space Glass.">
<div class="sg-page-shell">
  <Header />
  <main id="main">
    <section class="inner-hero">
      <div class="inner-hero__copy">
        <p class="eyebrow">Каталог</p>
        <h1>Скляні та алюмінієві рішення</h1>
        <p class="lead">Готові товари, індивідуальні конструкції, доставка по Україні та монтаж у ключових містах.</p>
        <div class="catalog-v14-search"><input type="search" placeholder="Пошук по каталогу" /><button class="button button--mint">Знайти</button></div>
      </div>
      <div class="inner-hero__visual"><span>SPACE GLASS</span></div>
    </section>

    <section class="projects-v14-grid" aria-label="Категорії товарів">
      {catalog.categories.map((category)=><a href={`/${category.slug}/`}>
        <div><img src={categoryImages[category.slug]} alt={category.title} width="640" height="416" loading="lazy" /></div>
        <small>Категорія</small>
        <h2>{category.title}</h2>
        <p>{category.subtitle}</p>
        <b>Перейти →</b>
      </a>)}
    </section>
  </main>
  <Footer />
</div>
</BaseLayout>
