---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import catalog from '../../data/catalog.json';
---
<BaseLayout title="Каталог Space Glass" description="Каталог душових, перегородок, дверей, огорож, дзеркал та алюмінієвих конструкцій Space Glass.">
<div class="sg-page-shell">
  <Header />
  <main id="main">
    <section class="inner-hero">
      <div class="inner-hero__copy">
        <p class="eyebrow">Каталог</p>
        <h1>Скляні та алюмінієві рішення</h1>
        <p class="lead">Готові товари, індивідуальні конструкції, доставка по Україні та монтаж у ключових містах.</p>
        <div class="catalog-v14-search"><input type="search" placeholder="Пошук по каталогу" /><button class="button button--mint">Знайти</button></div>
      </div>
      <div class="inner-hero__visual"><span>SPACE GLASS</span></div>
    </section>

    <section class="inner-section" aria-labelledby="catalog-categories-title">
      <div class="inner-section__heading">
        <p class="eyebrow">Категорії</p>
        <h2 id="catalog-categories-title">Оберіть потрібне рішення</h2>
      </div>
      <div class="inner-card-grid">
        {catalog.categories.map((category, i)=><article class="inner-card">
          <span>{String(i + 1).padStart(2, '0')}</span>
          <h2 class="inner-card__title">{category.title}</h2>
          <p>{category.subtitle}</p>
          <a href={`/${category.slug}/`}>Перейти →</a>
        </article>)}
      </div>
    </section>
  </main>
  <Footer />
</div>
</BaseLayout>
