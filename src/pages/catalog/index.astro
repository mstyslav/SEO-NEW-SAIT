---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import catalog from '../../data/catalog.json';
---
<BaseLayout title="Каталог Space Glass" description="Каталог скляних конструкцій Space Glass: душові, перегородки, двері, огорожі, дзеркала та алюмінієві системи.">
<div class="sg-page-shell">
  <Header />
  <main id="main" class="catalog-page">
    <section class="catalog-head">
      <div>
        <p class="eyebrow">Каталог</p>
        <h1>Скляні конструкції</h1>
        <p>Товари та індивідуальні рішення Space Glass. Доставка по Україні та Європі.</p>
      </div>
      <div class="catalog-search" role="search">
        <input type="search" placeholder="Пошук за назвою або артикулом" aria-label="Пошук за назвою або артикулом" />
        <button type="button">Знайти</button>
      </div>
    </section>

    <div class="catalog-toolbar">
      <button class="filter-mobile" type="button">Фільтри</button>
      <span>1 товар</span>
      <select aria-label="Сортування"><option>Рекомендовані</option><option>Новинки</option><option>Ціна: від нижчої</option><option>Ціна: від вищої</option></select>
    </div>

    <section class="catalog-layout">
      <aside class="filters" aria-label="Фільтр товарів">
        <div class="filter-title"><h2>Фільтри</h2><button type="button">Очистити</button></div>
        <details open><summary>Категорія</summary><label><input type="checkbox" /> Душові кабіни <span>1</span></label><label><input type="checkbox" /> Перегородки <span>0</span></label><label><input type="checkbox" /> Двері <span>0</span></label><label><input type="checkbox" /> Огорожі <span>0</span></label></details>
        <details open><summary>Тип конструкції</summary><label><input type="checkbox" /> Walk-In <span>1</span></label><label><input type="checkbox" /> Розпашна <span>0</span></label><label><input type="checkbox" /> Розсувна <span>0</span></label></details>
        <details><summary>Скло</summary><label><input type="checkbox" /> Прозоре <span>1</span></label><label><input type="checkbox" /> Satin <span>0</span></label><label><input type="checkbox" /> Тоноване <span>0</span></label></details>
        <details><summary>Товщина скла</summary><label><input type="checkbox" /> 8 мм <span>1</span></label><label><input type="checkbox" /> 10 мм <span>1</span></label></details>
        <details><summary>Фурнітура</summary><label><input type="checkbox" /> Чорна матова <span>1</span></label><label><input type="checkbox" /> Хром <span>1</span></label></details>
        <details><summary>Монтаж</summary><label><input type="checkbox" /> З монтажем <span>1</span></label><label><input type="checkbox" /> Без монтажу <span>1</span></label></details>
        <p class="filter-note">Під час інтеграції з WooCommerce ці параметри стануть Global Attributes. Фільтри не створюватимуть індексовані SEO-дублі.</p>
      </aside>

      <div class="results">
        <article class="product-card">
          <a class="product-media" href="/catalog/dushova-perehorodka-walk-in-black/">
            <img src="/images/v5/product-1.webp" alt="Душова перегородка Walk-In Black із загартованого скла" width="760" height="540" loading="eager" />
            <span class="badge">На замовлення</span>
            <button class="wishlist" type="button" aria-label="Додати в обране" title="Додати в обране">♡</button>
          </a>
          <div class="product-info">
            <div class="meta">Душові кабіни · SKU SG-WI-BL-001</div>
            <h2><a href="/catalog/dushova-perehorodka-walk-in-black/">Душова перегородка Walk-In Black</a></h2>
            <p>ESG 8–10 мм · чорна або хромована фурнітура · індивідуальні розміри</p>
            <div class="price"><strong>від 12 900 ₴</strong><small>Орієнтовна ціна</small></div>
            <a class="cta" href="/catalog/dushova-perehorodka-walk-in-black/">Переглянути та розрахувати →</a>
          </div>
        </article>
      </div>
    </section>

    <section class="category-links" aria-label="Категорії каталогу">
      <h2>Категорії</h2>
      <div>{catalog.categories.map((category)=><a href={`/${category.slug}/`}>{category.title}</a>)}</div>
    </section>
  </main>
  <Footer />
</div>
</BaseLayout>

<style>
.catalog-page{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;color:#18211e}.catalog-head{max-width:1320px;margin:auto;padding:56px 24px 30px;display:flex;justify-content:space-between;gap:32px;align-items:end;border-bottom:1px solid #e5ece9}.catalog-head h1{font-size:clamp(40px,5vw,64px);line-height:.98;letter-spacing:-.045em;margin:8px 0 14px}.catalog-head p{max-width:650px;color:#59645f;font-size:17px}.catalog-search{display:flex;min-width:min(460px,100%);border:1px solid #cfdad6;border-radius:14px;overflow:hidden;background:#fff}.catalog-search input{flex:1;border:0;padding:14px 16px;font-size:15px;outline:0}.catalog-search button{border:0;background:#79cfb4;padding:0 20px;font-weight:700}.catalog-toolbar{max-width:1320px;margin:auto;padding:18px 24px;display:flex;align-items:center;gap:16px;border-bottom:1px solid #edf1ef}.catalog-toolbar span{margin-right:auto;color:#66716d;font-size:14px}.catalog-toolbar select{padding:10px 12px;border:1px solid #d8e0dd;border-radius:10px;background:#fff}.filter-mobile{display:none}.catalog-layout{max-width:1320px;margin:auto;padding:28px 24px 70px;display:grid;grid-template-columns:260px minmax(0,1fr);gap:34px}.filters{align-self:start;position:sticky;top:90px}.filter-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}.filter-title h2{font-size:24px;margin:0}.filter-title button{border:0;background:none;color:#18836a;font-size:13px}.filters details{border-bottom:1px solid #e1e8e5;padding:14px 0}.filters summary{font-weight:700;font-size:15px;cursor:pointer}.filters label{display:flex;gap:9px;align-items:center;padding:8px 0;font-size:14px;color:#394440}.filters label span{margin-left:auto;color:#8c9692;font-size:12px}.filter-note{font-size:12px;line-height:1.5;color:#7b8682;margin-top:18px}.results{min-width:0}.product-card{border:1px solid #dfe6e3;border-radius:16px;overflow:hidden;background:#fff;max-width:430px}.product-media{display:block;position:relative;aspect-ratio:1.42/1;background:#f1f4f3;overflow:hidden}.product-media img{width:100%;height:100%;object-fit:cover;display:block}.badge{position:absolute;left:12px;top:12px;background:#12322d;color:white;border-radius:999px;padding:6px 9px;font-size:11px;text-transform:uppercase}.wishlist{position:absolute;right:12px;top:12px;width:38px;height:38px;border-radius:50%;border:1px solid #d5dedb;background:#fff;font-size:22px;cursor:pointer}.product-info{padding:16px}.meta{font-size:12px;color:#77827e}.product-info h2{font-size:21px;line-height:1.15;margin:8px 0}.product-info h2 a{color:inherit;text-decoration:none}.product-info p{font-size:14px;line-height:1.5;color:#59645f;margin:0 0 14px}.price{display:flex;align-items:baseline;gap:10px}.price strong{font-size:23px}.price small{font-size:12px;color:#88918e}.cta{display:inline-block;margin-top:12px;color:#147e66;font-weight:700;text-decoration:none;font-size:14px}.category-links{max-width:1320px;margin:auto;padding:0 24px 80px}.category-links h2{font-size:30px}.category-links>div{display:flex;gap:8px;flex-wrap:wrap}.category-links a{border:1px solid #dce5e2;border-radius:999px;padding:9px 13px;color:#27413b;text-decoration:none;background:#fff;font-size:14px}@media(max-width:900px){.catalog-head{display:block}.catalog-search{margin-top:24px;min-width:0}.catalog-layout{grid-template-columns:1fr}.filters{position:static;display:none}.filter-mobile{display:inline-block}.product-card{max-width:none}}@media(max-width:620px){.catalog-head,.catalog-layout,.catalog-toolbar,.category-links{padding-left:16px;padding-right:16px}.catalog-head h1{font-size:42px}}
</style>