---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import catalog from '../../data/catalog.json';
---
<BaseLayout title="Каталог Space Glass" description="Каталог душових, перегородок, дверей, огорож, дзеркал та алюмінієвих конструкцій Space Glass.">
<div class="sg-page-shell">
  <Header />
  <main id="main">
    <section class="projects-v14-hero catalog-hub-hero">
      <p class="eyebrow">Готові рішення</p>
      <h1>Скляні та алюмінієві рішення</h1>
      <p class="lead">Готові товари, індивідуальні конструкції, доставка по Україні та монтаж у ключових містах.</p>
    </section>

    <section class="projects-v14-grid catalog-hub-grid" aria-label="Категорії каталогу">
      {catalog.categories.map((category,i)=><a href={`/${category.slug}/`}>
        <div aria-hidden="true"><span>{String(i+1).padStart(2,'0')}</span></div>
        <h2>{category.title}</h2>
        <p>{category.subtitle}</p>
        <b>Перейти →</b>
      </a>)}
    </section>
  </main>
  <Footer />
</div>
</BaseLayout>
