---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { catalogNavigation } from '../../data/catalog-navigation';
import '../../styles/catalog-hub.css';

const imageBySlug = {
  'dushovi-konstruktsii': { image: '/images/s24-menu/showers.webp', imageAlt: 'Скляна душова конструкція Space Glass', imageWidth: 1800, imageHeight: 2100 },
  dzerkala: { image: '/images/s24-menu/mirrors.webp', imageAlt: 'Дзеркало для сучасного інтер’єру', imageWidth: 1800, imageHeight: 2100 },
  'sklyani-perehorodky': { image: '/images/s24-menu/partitions.webp', imageAlt: 'Скляна перегородка для простору', imageWidth: 1800, imageHeight: 2100 },
  'sklyani-dveri': { image: '/images/s24-menu/doors.webp', imageAlt: 'Скляні двері Space Glass', imageWidth: 1800, imageHeight: 2100 },
  'sklyani-ohorozhi': { image: '/images/s24-menu/railings.webp', imageAlt: 'Скляна огорожа для сходів', imageWidth: 1800, imageHeight: 2100 },
  'bezramne-sklinnya': { image: '/images/s24-menu/frameless.webp', imageAlt: 'Безрамне скління тераси', imageWidth: 1800, imageHeight: 2100 },
  'alyuminiievi-konstruktsii': { image: '/images/s24-menu/aluminium.webp', imageAlt: 'Алюмінієва конструкція зі склінням', imageWidth: 1800, imageHeight: 2100 },
  'sklyani-fasady': { image: '/images/s24-menu/facades.webp', imageAlt: 'Скляний фасад комерційного об’єкта', imageWidth: 1800, imageHeight: 2100 },
  'metaloplastykovi-konstruktsii': { image: '/images/s24-menu/aluminium.webp', imageAlt: 'Віконна конструкція для житлового об’єкта', imageWidth: 1800, imageHeight: 2100 },
  'sklo-dlia-biznesu': { image: '/images/projects/coffee-ocean-facade-odesa/coffee-ocean-glass-entrance-odesa.webp', imageAlt: 'Скляний вхід для комерційного простору', imageWidth: 960, imageHeight: 1280 }
};
const descriptions: Record<string, string> = {
  'dushovi-konstruktsii': 'Піддони, кутові кабіни, двері й перегородки для душу та скляні шторки для ванни.', dzerkala: 'Дзеркала за розміром, із підсвіткою, для ванної, дому та комерційних просторів.', 'sklyani-perehorodky': 'Loft, офісні, міжкімнатні, розсувні, мобільні та безрамні системи.', 'sklyani-dveri': 'Розпашні, розсувні, маятникові двері та рішення в алюмінієвому профілі.', 'sklyani-ohorozhi': 'Огорожі сходів, балконів і терас — безрамні, на стійках або в профілі.', 'bezramne-sklinnya': 'Скління терас, балконів, альтанок і панорамні розсувні системи.', 'alyuminiievi-konstruktsii': 'Вікна, двері, фасади, розсувні системи, зимові сади та перголи.', 'sklyani-fasady': 'Вітринне, структурне та стійково-ригельне скління фасадів і вхідних груп.', 'metaloplastykovi-konstruktsii': 'Вікна, двері, балконні блоки та енергоефективні розсувні ПВХ-системи.', 'sklo-dlia-biznesu': 'Вітрини, козирки, стільниці, полиці та спеціальні рішення для бізнесу.'
};
const categories = catalogNavigation.map((category) => {
  const { slug } = category;
  const image = imageBySlug[slug];
  if (!image) throw new Error(`Catalog image is missing category: ${slug}`);
  return { ...category, description: descriptions[slug], ...image };
});
---
<BaseLayout title="Каталог скляних та алюмінієвих конструкцій | Space Glass" description="Каталог скляних, алюмінієвих і металопластикових конструкцій Space Glass для дому, бізнесу та архітектурних об’єктів." schemaType="CollectionPage" locale="uk">
  <div class="sg-page-shell"><Header />
    <main id="main" class="catalog-hub">
      <section class="catalog-hub__hero"><div class="catalog-hub__intro"><p class="catalog-hub__eyebrow">Каталог Space Glass</p><h1>Скляні та алюмінієві конструкції</h1><p>Оберіть напрямок, щоб побачити конструкції для дому, бізнесу та архітектурних об’єктів. Усі рішення проєктуємо під конкретний простір і завдання.</p></div><a class="catalog-hub__quote" href="/quote/">Потрібне індивідуальне рішення <span aria-hidden="true">→</span></a></section>
      <section class="catalog-hub__categories" aria-labelledby="catalog-categories-title"><div class="catalog-hub__section-head"><p class="catalog-hub__eyebrow">Напрямки</p><h2 id="catalog-categories-title">Категорії конструкцій</h2></div><div class="catalog-hub__grid">
        {categories.map((category, index) => <article class="catalog-hub__card"><div class="catalog-hub__image-wrap"><img src={category.image} alt={category.imageAlt} width={category.imageWidth} height={category.imageHeight} loading="lazy" decoding="async" /><span class="catalog-hub__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span></div><div class="catalog-hub__content"><h2><a href={category.href}>{category.name}<span aria-hidden="true">→</span></a></h2><p>{category.description}</p><ul aria-label={`Підкатегорії: ${category.name}`}>{category.services.map(service => <li><a href={service.path}>{service.shortName}</a></li>)}</ul><a class="catalog-hub__all-link" href={category.href}>Усі рішення <span aria-hidden="true">→</span></a></div></article>)}
      </div></section>
    </main><Footer />
  </div>
</BaseLayout>
