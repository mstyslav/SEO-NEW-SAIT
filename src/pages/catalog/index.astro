---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import Header from '../../components/Header.astro';
import TrustBar from '../../components/TrustBar.astro';
import Footer from '../../components/Footer.astro';
import FAQBlock from '../../components/FAQBlock.astro';
import { getCatalogNavigation } from '../../data/catalog-navigation';
import { SOLUTIONS } from '../../data/solutions';
import { absoluteUrl, faqSchema, type JsonLdObject } from '../../seo/schema';
import { localeFromPath, normalizeLocale, localizedPath } from '../../i18n/helpers';
import { catalogContent } from '../../content/i18n/pages/catalog';
import '../../styles/catalog-hub.css';

const locale = normalizeLocale(Astro.url.searchParams.get('lang') ?? localeFromPath(Astro.url.pathname));
const isRu = locale === 'ru';
const lp = (path: string) => localizedPath(path, locale);
const t = catalogContent[locale];

const origin = Astro.site ?? Astro.url.origin;
const imageBySlug = {
  'dushovi-konstruktsii': ['/images/s24-menu/showers.webp', 1800, 2100],
  dzerkala: ['/images/s24-menu/mirrors.webp', 1800, 2100],
  'sklyani-perehorodky': ['/images/s24-menu/partitions.webp', 1800, 2100],
  'sklyani-dveri': ['/images/s24-menu/doors.webp', 1800, 2100],
  'sklyani-ohorozhi': ['/images/s24-menu/railings.webp', 1800, 2100],
  'bezramne-sklinnya': ['/images/s24-menu/frameless.webp', 1800, 2100],
  'alyuminiievi-konstruktsii': ['/images/s24-menu/aluminium.webp', 1800, 2100],
  'sklyani-fasady': ['/images/s24-menu/facades.webp', 1800, 2100],
  'metaloplastykovi-konstruktsii': ['/images/s24-menu/aluminium.webp', 1800, 2100],
  'sklo-dlia-biznesu': ['/images/projects/coffee-ocean-facade-odesa/coffee-ocean-glass-entrance-odesa.webp', 960, 1280]
} as const;
const catalogNavigation = getCatalogNavigation(locale);
const categories = catalogNavigation.map((category) => {
  const [image, imageWidth, imageHeight] = imageBySlug[category.slug as keyof typeof imageBySlug];
  const childLinks = category.services.filter((service, index, services) => service.path !== category.href && services.findIndex(({ path }) => path === service.path) === index).slice(0, 4);
  return {
    ...category,
    description: t.categoryDescriptions[category.slug],
    childLinks,
    variants: childLinks.length ? [] : category.services.map(({ shortName }) => shortName).slice(0, 6),
    image,
    imageAlt: t.categoryImageAlt[category.slug],
    imageWidth,
    imageHeight
  };
});
const projectCategoryOrder = ['showers', 'mirrors', 'glass-partitions', 'glass-doors', 'railings', 'frameless-glazing', 'aluminium', 'glass-facades', 'business-glass'];
const catalogProjects = (await getCollection('projects', ({ data }) => data.status === 'published' && data.locale === 'uk'))
  .map(({ data }) => data)
  .sort((a, b) => {
    const categoryDifference = projectCategoryOrder.indexOf(a.category) - projectCategoryOrder.indexOf(b.category);
    return categoryDifference || a.sortOrder - b.sortOrder;
  });
const catalogUrl = absoluteUrl('/catalog/', origin);
const itemList: JsonLdObject = { '@type': 'ItemList', '@id': `${catalogUrl}#categories`, name: t.categoriesSection.title, numberOfItems: 10, mainEntityOfPage: { '@id': `${catalogUrl}#webpage` }, itemListElement: categories.map((category, index) => ({ '@type': 'ListItem', position: index + 1, name: category.name, url: absoluteUrl(category.href, origin) })) };
const faqStructuredData = faqSchema(t.faqSection.items.map(([question, answer]) => ({ question, answer })));
const structuredData: JsonLdObject[] = [itemList, ...(faqStructuredData ? [faqStructuredData] : [])];
---
<BaseLayout title={t.meta.title} description={t.meta.description} schemaType="CollectionPage" structuredData={structuredData} heroPreloadSrc="/images/catalog/catalog-hero-desktop.webp" heroPreloadSrcset="/images/catalog/catalog-hero-desktop-480.webp 480w, /images/catalog/catalog-hero-desktop-800.webp 800w, /images/catalog/catalog-hero-desktop-960.webp 960w, /images/catalog/catalog-hero-desktop-1200.webp 1200w, /images/catalog/catalog-hero-desktop.webp 1536w" heroPreloadSizes="(max-width: 900px) 100vw, (max-width: 1535px) 55vw, 825px" heroPreloadMobileSrc="/images/catalog/catalog-hero-mobile.webp" heroPreloadMobileSrcset="/images/catalog/catalog-hero-mobile.webp 800w">
  <div class="sg-page-shell"><Header />
    <main id="main" class="catalog-hub">
      <header class="catalog-hub__hero catalog-hub__wrap"><div class="catalog-hub__hero-copy"><p class="catalog-hub__eyebrow">{t.hero.eyebrow}</p><h1>{t.hero.h1[0]}<br>{t.hero.h1[1]}</h1><p class="catalog-hub__lead">{t.hero.lead}</p><div class="catalog-hub__actions"><a class="button button--mint" href={`${lp("/contacts/")}#contact-form`}>{t.hero.ctaPrimary}</a><a class="button button--outline" href="#catalog-categories">{t.hero.ctaSecondary}</a></div></div><div class="catalog-hub__hero-media"><picture><source media="(max-width: 900px)" srcset="/images/catalog/catalog-hero-mobile.webp" /><img src="/images/catalog/catalog-hero-desktop.webp" srcset="/images/catalog/catalog-hero-desktop-480.webp 480w, /images/catalog/catalog-hero-desktop-800.webp 800w, /images/catalog/catalog-hero-desktop-960.webp 960w, /images/catalog/catalog-hero-desktop-1200.webp 1200w, /images/catalog/catalog-hero-desktop.webp 1536w" sizes="(max-width: 900px) 100vw, (max-width: 1535px) 55vw, 825px" width="1536" height="1024" alt={t.hero.heroAlt} loading="eager" fetchpriority="high" decoding="async" /></picture></div></header>
      <TrustBar locale={locale} />

      <section class="catalog-hub__section catalog-hub__wrap" id="catalog-categories" aria-labelledby="catalog-categories-title"><div class="catalog-hub__section-head"><p class="catalog-hub__eyebrow">{t.categoriesSection.eyebrow}</p><h2 id="catalog-categories-title">{t.categoriesSection.title}</h2><p>{t.categoriesSection.intro}</p></div><div class="catalog-hub__grid">
        {categories.map((category, index) => <article class="catalog-card"><a class="catalog-card__media" href={category.href} aria-label={`${t.categoriesSection.viewCategoryAriaPrefix} ${category.name}`}><img src={category.image} alt={category.imageAlt} width={category.imageWidth} height={category.imageHeight} loading="lazy" decoding="async" /><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span></a><div class="catalog-card__body"><h3><a href={category.href}>{category.name}<span aria-hidden="true">→</span></a></h3><p>{category.description}</p>{category.childLinks.length ? <ul aria-label={`${t.categoriesSection.subcategoriesAriaPrefix} ${category.name}`}>{category.childLinks.map((service) => <li><a href={service.path}>{service.shortName}</a></li>)}</ul> : <p class="catalog-card__variants">{category.variants.join(' · ')}</p>}<a class="catalog-card__all" href={category.href}>{t.categoriesSection.viewCategoryLinkText} <span aria-hidden="true">→</span></a></div></article>)}
      </div></section>

      <section class="catalog-hub__band"><div class="catalog-hub__wrap catalog-hub__section" aria-labelledby="popular-title"><div class="catalog-hub__section-head"><p class="catalog-hub__eyebrow">{t.popularSection.eyebrow}</p><h2 id="popular-title">{t.popularSection.title}</h2><p>{t.popularSection.intro}</p></div><div class="catalog-link-grid">{t.popularDirections.map(([label, href]) => <a href={href}>{label}<span aria-hidden="true" class="catalog-link-arrow"><svg viewBox="0 0 16 16" width="16" height="16" fill="none"><path d="M4 12L12 4M6 4h6v6" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a>)}</div></div></section>

      <section class="catalog-hub__section catalog-hub__wrap" aria-labelledby="objects-title"><div class="catalog-hub__section-head"><p class="catalog-hub__eyebrow">{t.objectsSection.eyebrow}</p><h2 id="objects-title">{t.objectsSection.title}</h2><p>{t.objectsSection.intro}</p></div><div class="catalog-object-grid">{SOLUTIONS.map((solution) => <a href={solution.path}><span>{isRu && solution.navLabelRu ? solution.navLabelRu : solution.navLabel}</span><p>{isRu && solution.hubCardTextRu ? solution.hubCardTextRu : solution.hubCardText}</p><b>{t.objectsSection.linkText}</b></a>)}</div></section>

      <section class="catalog-hub__section catalog-hub__wrap" aria-labelledby="projects-title"><div class="catalog-project-head"><div class="catalog-hub__section-head"><p class="catalog-hub__eyebrow">{t.projectsSection.eyebrow}</p><h2 id="projects-title">{t.projectsSection.title}</h2><p>{t.projectsSection.intro}</p></div><div class="catalog-project-controls" aria-label={t.projectsSection.controlsAria}><button type="button" aria-label={t.projectsSection.prevAria} data-catalog-project-direction="-1">←</button><button type="button" aria-label={t.projectsSection.nextAria} data-catalog-project-direction="1">→</button></div></div><div class="catalog-project-viewport" data-catalog-projects-carousel tabindex="0" aria-label={t.projectsSection.carouselAria}><div class="catalog-project-grid">{catalogProjects.map((project) => { const cardTitle = isRu && project.cardTitleRu ? project.cardTitleRu : project.cardTitle; const city = isRu && project.cityRu ? project.cityRu : project.city; const constructionType = isRu && project.constructionTypeRu ? project.constructionTypeRu : project.constructionType; return <a href={lp(`/projects/${project.slug}/`)}><div><img src={project.cover.src.replace('.webp', '-480.webp')} width={project.cover.width} height={project.cover.height} alt={project.cover.alt} loading="lazy" decoding="async" /></div><p>{city} · {constructionType}</p><h3>{cardTitle}</h3><b>{t.projectsSection.viewProjectLabel}</b></a>; })}</div></div><a class="catalog-hub__text-link" href={lp("/projects/")}>{t.projectsSection.viewAllLink}</a></section>

      <section class="catalog-hub__band"><div class="catalog-hub__section catalog-hub__wrap catalog-choose" aria-labelledby="choose-title"><div class="catalog-hub__section-head"><p class="catalog-hub__eyebrow">{t.chooseSection.eyebrow}</p><h2 id="choose-title">{t.chooseSection.title}</h2><p>{t.chooseSection.intro}</p></div><div class="catalog-choose__grid">{t.chooseSection.points.map(([heading, text]) => <article><h3>{heading}</h3><p>{text}</p></article>)}</div><a class="catalog-hub__text-link" href={lp("/knowledge/")}>{t.chooseSection.linkText}</a></div></section>

      <section class="catalog-hub__section catalog-hub__wrap catalog-experience" aria-labelledby="experience-title"><div class="catalog-experience__copy"><p class="catalog-hub__eyebrow">{t.experienceSection.eyebrow}</p><h2 id="experience-title">{t.experienceSection.title}</h2><p>{t.experienceSection.intro}</p><a class="catalog-hub__text-link" href={lp("/about/")}>{t.experienceSection.linkText}</a></div><dl>{t.experienceSection.stats.map(([value, label]) => <div><dt>{value}</dt><dd>{label}</dd></div>)}</dl></section>

      <section class="catalog-hub__section catalog-hub__wrap catalog-hub__process" aria-labelledby="process-title"><div class="catalog-hub__section-head"><p class="catalog-hub__eyebrow">{t.processSection.eyebrow}</p><h2 id="process-title">{t.processSection.title}</h2><p>{t.processSection.intro}</p></div><ol class="catalog-process">{t.processSection.steps.map(([heading, text], index) => <li><span>{String(index + 1).padStart(2, '0')}</span><h3>{heading}</h3><p>{text}</p></li>)}</ol></section>

      <section class="catalog-hub__geo catalog-hub__wrap" aria-labelledby="geo-title"><div><p class="catalog-hub__eyebrow">{t.geoSection.eyebrow}</p><h2 id="geo-title">{t.geoSection.title}</h2><p>{t.geoSection.intro}</p></div><nav aria-label={t.geoSection.citiesAria}>{t.geoSection.cities.map(([label, href]) => <a href={href}>{label}</a>)}</nav></section>

      <div class="catalog-hub__section catalog-hub__wrap catalog-faq" id="catalog-faq"><FAQBlock eyebrow="FAQ" title={t.faqSection.title} intro={t.faqSection.intro} items={t.faqSection.items} visibleCount={6} variant="compact" locale={locale} /></div>

      <section class="catalog-cta catalog-hub__wrap" aria-labelledby="catalog-cta-title"><div><p class="catalog-hub__eyebrow">{t.ctaSection.eyebrow}</p><h2 id="catalog-cta-title">{t.ctaSection.title}</h2><p>{t.ctaSection.intro}</p></div><div class="catalog-hub__actions"><a class="button button--mint" href={`${lp("/contacts/")}#contact-form`}>{t.ctaSection.ctaPrimary}</a><a class="button button--light" href={lp("/contacts/")}>{t.ctaSection.ctaSecondary}</a></div></section>
    </main><Footer />
  </div>
</BaseLayout>
<style is:inline>
  .catalog-card a,.catalog-card a:hover,.catalog-card a:focus,.catalog-card a:focus-visible,.catalog-card a:active{text-decoration:none!important}
  .catalog-card h3 a:hover,.catalog-card h3 a:focus,.catalog-card h3 a:focus-visible,.catalog-card h3 a:active,.catalog-card li a:hover,.catalog-card li a:focus,.catalog-card li a:focus-visible,.catalog-card li a:active{color:var(--catalog-mint)}
  .catalog-project-head{display:flex;align-items:end;justify-content:space-between;gap:30px}
  .catalog-project-controls{display:flex;flex:0 0 auto;gap:8px;margin-bottom:clamp(30px,4vw,48px)}
  .catalog-project-controls button{display:grid;width:48px;height:48px;padding:0;border:1px solid var(--catalog-line);border-radius:50%;background:#fff;place-items:center;color:var(--catalog-ink);font-size:20px;cursor:pointer}
  .catalog-project-controls button:hover,.catalog-project-controls button:focus-visible{border-color:var(--catalog-mint);color:var(--catalog-mint)}
  .catalog-project-viewport{overflow-x:auto;padding-bottom:14px;scroll-snap-type:x mandatory;scrollbar-width:thin;scrollbar-color:var(--catalog-mint) #eaf1ee;overscroll-behavior-inline:contain}
  .catalog-project-grid{display:flex;width:max-content;gap:18px;margin:0;padding:0;overflow:visible}
  .catalog-project-grid>a{width:clamp(250px,23vw,320px);min-width:0;flex:none;scroll-snap-align:start}
  @media(max-width:1050px){.catalog-project-grid{gap:16px}.catalog-project-grid>a{width:min(44vw,430px)}}
  @media(max-width:640px){.catalog-project-head{display:block}.catalog-project-controls{margin-top:-12px;margin-bottom:24px}.catalog-project-viewport{margin-inline:-20px;padding-inline:20px}.catalog-project-grid{gap:14px}.catalog-project-grid>a{width:82vw}}
</style>
<script is:inline>
  const catalogProjectsCarousel = document.querySelector('[data-catalog-projects-carousel]');
  const scrollCatalogProjects = (direction) => {
    if (!catalogProjectsCarousel) return;
    const card = catalogProjectsCarousel.querySelector('.catalog-project-grid > a');
    const distance = card ? card.getBoundingClientRect().width + 18 : catalogProjectsCarousel.clientWidth;
    catalogProjectsCarousel.scrollBy({ left: direction * distance, behavior: 'smooth' });
  };
  document.querySelectorAll('[data-catalog-project-direction]').forEach((button) => button.addEventListener('click', () => scrollCatalogProjects(Number(button.dataset.catalogProjectDirection))));
  catalogProjectsCarousel?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
      event.preventDefault();
      scrollCatalogProjects(event.key === 'ArrowRight' ? 1 : -1);
    }
  });
</script>
