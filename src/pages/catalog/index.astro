---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQBlock from '../../components/FAQBlock.astro';
import { catalogNavigation } from '../../data/catalog-navigation';
import { SOLUTIONS } from '../../data/solutions';
import { absoluteUrl, faqSchema, type JsonLdObject } from '../../seo/schema';
import '../../styles/catalog-hub.css';

const title = 'Каталог скляних та алюмінієвих конструкцій | Space Glass';
const description = 'Каталог скляних та алюмінієвих конструкцій Space Glass: душові, перегородки, двері, огорожі, дзеркала, системи скління, вікна й фасади. Проєктування, виготовлення та монтаж у Києві, Одесі, Львові та по Україні.';
const origin = Astro.site ?? Astro.url.origin;
const imageBySlug = {
  'dushovi-konstruktsii': ['/images/s24-menu/showers.webp', 'Скляна душова конструкція Space Glass', 1800, 2100],
  dzerkala: ['/images/s24-menu/mirrors.webp', 'Дзеркало для сучасного інтер’єру', 1800, 2100],
  'sklyani-perehorodky': ['/images/s24-menu/partitions.webp', 'Скляна перегородка для зонування простору', 1800, 2100],
  'sklyani-dveri': ['/images/s24-menu/doors.webp', 'Скляні двері Space Glass', 1800, 2100],
  'sklyani-ohorozhi': ['/images/s24-menu/railings.webp', 'Скляна огорожа для сходів', 1800, 2100],
  'bezramne-sklinnya': ['/images/s24-menu/frameless.webp', 'Безрамне скління тераси', 1800, 2100],
  'alyuminiievi-konstruktsii': ['/images/s24-menu/aluminium.webp', 'Алюмінієва конструкція зі склінням', 1800, 2100],
  'sklyani-fasady': ['/images/s24-menu/facades.webp', 'Скляний фасад комерційного об’єкта', 1800, 2100],
  'metaloplastykovi-konstruktsii': ['/images/s24-menu/aluminium.webp', 'Віконна конструкція для житлового об’єкта', 1800, 2100],
  'sklo-dlia-biznesu': ['/images/projects/coffee-ocean-facade-odesa/coffee-ocean-glass-entrance-odesa.webp', 'Скляний вхід для комерційного простору', 960, 1280]
} as const;
const descriptions: Record<string, string> = {
  'dushovi-konstruktsii': 'Кабіни, двері, перегородки та шторки для ванни за індивідуальними розмірами.', dzerkala: 'Дзеркала за розміром, із підсвіткою, для ванної, дому та комерційних просторів.', 'sklyani-perehorodky': 'Loft, офісні, міжкімнатні, розсувні, мобільні та безрамні системи.', 'sklyani-dveri': 'Розпашні, розсувні, маятникові двері та рішення в алюмінієвому профілі.', 'sklyani-ohorozhi': 'Огорожі сходів, балконів і терас — безрамні, на стійках або в профілі.', 'bezramne-sklinnya': 'Скління терас, балконів, альтанок і панорамні розсувні системи.', 'alyuminiievi-konstruktsii': 'Вікна, двері, фасади, розсувні системи, зимові сади, перголи та ZIP-системи сонцезахисту.', 'sklyani-fasady': 'Вітринне, структурне та стійково-ригельне скління фасадів і вхідних груп.', 'metaloplastykovi-konstruktsii': 'Вікна, двері, балконні блоки та енергоефективні розсувні ПВХ-системи.', 'sklo-dlia-biznesu': 'Вітрини, козирки, стільниці, полиці та спеціальні рішення для бізнесу.'
};
const categories = catalogNavigation.map((category) => {
  const [image, imageAlt, imageWidth, imageHeight] = imageBySlug[category.slug as keyof typeof imageBySlug];
  const childLinks = category.services.filter((service, index, services) => service.path !== category.href && services.findIndex(({ path }) => path === service.path) === index).slice(0, 4);
  return { ...category, description: descriptions[category.slug], childLinks, variants: childLinks.length ? [] : category.services.map(({ shortName }) => shortName).slice(0, 6), image, imageAlt, imageWidth, imageHeight };
});
const popularDirections = [
  ['Душова Walk-in', '/poslugy/dushovi-konstruktsii/dushova-kabina-walk-in/'], ['Перегородки Loft', '/poslugy/sklyani-perehorodky/sklyani-perehorodky-loft/'], ['Офісні перегородки', '/poslugy/sklyani-perehorodky/ofisni-sklyani-perehorodky/'], ['Розсувні скляні двері', '/poslugy/sklyani-dveri/rozsuvni-sklyani-dveri/'], ['Безрамні огорожі', '/poslugy/sklyani-ohorozhi/bezramni-sklyani-ohorozhi/'], ['Панорамне скління', '/poslugy/bezramne-sklinnya/panoramne-sklinnya/']
  , ['Дзеркала з підсвіткою', '/poslugy/dzerkala/dzerkalo-z-pidsvitkoyu/'], ['Вітринне скління', '/poslugy/sklyani-fasady/vitrinne-sklinnya/'], ['Скляні козирки', '/poslugy/sklo-dlia-biznesu/sklyani-kozyrky/'], ['Скління тераси', '/poslugy/bezramne-sklinnya/bezramne-sklinnya-terasy/']
];
const projectCategoryOrder = ['showers', 'mirrors', 'glass-partitions', 'glass-doors', 'railings', 'frameless-glazing', 'aluminium', 'glass-facades', 'business-glass'];
const catalogProjects = (await getCollection('projects', ({ data }) => data.status === 'published' && data.locale === 'uk'))
  .map(({ data }) => data)
  .sort((a, b) => {
    const categoryDifference = projectCategoryOrder.indexOf(a.category) - projectCategoryOrder.indexOf(b.category);
    return categoryDifference || a.sortOrder - b.sortOrder;
  });
const choosePoints = [['Призначення і простір', 'Враховуємо функцію конструкції, геометрію отвору, вологість, потік людей і доступне місце для відкривання.'], ['Тип і безпека скла', 'Загартоване скло або триплекс, його товщину та обробку підбираємо відповідно до конструкції й навантажень.'], ['Профіль і фурнітура', 'Узгоджуємо колір, спосіб кріплення, петлі, напрямні та ручки як єдину технічну систему.'], ['Відкривання і замір', 'Розпашна, розсувна чи стаціонарна система потребує точного заміру та перевірки монтажних основ.']];
const stats = [['5 000+', 'реалізованих проєктів'], ['50 000+', 'м² виконаного засклення'], ['10+ років', 'досвіду Space Glass'], ['Україна', 'Київ · Одеса · Львів']];
const processSteps = [['Запит', 'Отримуємо фото, приблизні розміри, креслення або дизайн-проєкт.'], ['Підбір рішення', 'Узгоджуємо тип конструкції, скло, профіль, фурнітуру та бюджет.'], ['Точний замір', 'Перевіряємо фактичну геометрію і монтажні основи на об’єкті.'], ['Проєктування й виготовлення', 'Готуємо креслення та виготовляємо конструкцію за погодженими параметрами.'], ['Доставка й монтаж', 'Доставляємо, встановлюємо та перевіряємо роботу готової системи.']];
const faqItems: [string, string][] = [
  ['Як обрати потрібний тип скляної конструкції?', 'Визначаємо функцію, розміри, умови експлуатації, спосіб відкривання та вимоги до приватності. Після цього підбираємо скло, профіль і фурнітуру.'],
  ['Чи виготовляєте конструкції за індивідуальними розмірами?', 'Так. Конфігурацію та розміри уточнюємо після заміру й перевірки геометрії конкретного об’єкта.'],
  ['Яке скло використовують для безпечних конструкцій?', 'Залежно від задачі застосовують загартоване скло або триплекс. Тип і товщину визначають за розмірами, кріпленнями та навантаженнями.'],
  ['Чи можна працювати за дизайн-проєктом або кресленням?', 'Так. Використовуємо проєкт як основу, а технічні вузли та остаточні розміри перевіряємо за фактичною геометрією об’єкта.'],
  ['Від чого залежить вартість конструкції?', 'Від розмірів, типу й обробки скла, профілю, фурнітури, способу відкривання, складності доставки та монтажу.'],
  ['Чи виконує Space Glass замір і монтаж?', 'Так. Виконуємо точний замір, проєктування, виготовлення, доставку й монтаж погодженої конструкції.'],
  ['У яких містах ви працюєте?', 'Основні регіони роботи — Київ, Одеса та Львів. Також реалізуємо проєкти в інших містах України.'],
  ['Що потрібно надіслати для попереднього розрахунку?', 'Надішліть фото місця встановлення, приблизні розміри й короткий опис задачі. Якщо є креслення або дизайн-проєкт, додайте їх до запиту.']
  , ['Яке скло обрати: прозоре, матове чи тоноване?', 'Прозоре скло зберігає максимум світла, матове додає приватності, а тоноване змінює візуальне сприйняття простору. Вибір залежить від призначення конструкції та інтер’єру.']
  , ['Чим загартоване скло відрізняється від триплексу?', 'Загартоване скло має підвищену міцність і при руйнуванні розпадається на дрібні фрагменти. У триплексі кілька шарів з’єднані плівкою, яка утримує пошкоджене скло.']
  , ['Як визначається потрібна товщина скла?', 'Її розраховують за розмірами полотна, типом кріплення, навантаженнями та умовами експлуатації. Єдиної товщини для всіх конструкцій немає.']
  , ['Який спосіб відкривання краще обрати?', 'Розпашні системи зручні за наявності вільного місця, розсувні економлять площу, а стаціонарні підходять для постійного зонування або захисту.']
  , ['Як підібрати профіль і фурнітуру?', 'Враховуємо вагу й формат скла, тип відкривання, частоту використання, умови монтажу та бажане оздоблення. Усі компоненти мають працювати як одна система.']
  , ['Чи можна поєднати кілька конструкцій в одному проєкті?', 'Так. Можемо узгодити перегородки, двері, огорожі, дзеркала або системи скління за профілем, фурнітурою, кольором і загальною геометрією.']
  , ['Коли потрібно виконувати точний замір?', 'Після готовності поверхонь і прорізів, які впливають на конструкцію. Це дає змогу коректно підготувати креслення, розміри скла та вузли примикання.']
  , ['Чи монтуєте конструкції у готовому інтер’єрі?', 'Так, якщо місце встановлення та монтажні основи підготовлені. Перед роботою перевіряємо доступ, геометрію і спосіб безпечного занесення конструкції.']
  , ['Чи підходять скляні конструкції для комерційних просторів?', 'Так. Для офісів, магазинів, ресторанів і готелів підбираємо системи з урахуванням потоку людей, режиму експлуатації, безпеки та архітектури об’єкта.']
  , ['Чи можна замовити конструкцію нестандартної форми?', 'Можливість залежить від геометрії, обробки скла, кріплень і монтажних умов. Нестандартні вирізи та кути погоджуємо після заміру й технічної перевірки.']
  , ['Як підготувати об’єкт до монтажу?', 'Потрібні завершені монтажні основи, доступ до місця встановлення та погоджені точки кріплення. Конкретні вимоги повідомляємо після вибору системи.']
  , ['Чи доставляєте конструкції в інші міста України?', 'Так. Можливість доставки й монтажу визначаємо за габаритами конструкції, локацією, доступом на об’єкт і необхідним форматом робіт.']
];
const catalogUrl = absoluteUrl('/catalog/', origin);
const itemList: JsonLdObject = { '@type': 'ItemList', '@id': `${catalogUrl}#categories`, name: 'Каталог скляних та алюмінієвих конструкцій', numberOfItems: 10, mainEntityOfPage: { '@id': `${catalogUrl}#webpage` }, itemListElement: categories.map((category, index) => ({ '@type': 'ListItem', position: index + 1, name: category.name, url: absoluteUrl(category.href, origin) })) };
const faqStructuredData = faqSchema(faqItems.map(([question, answer]) => ({ question, answer })));
const structuredData: JsonLdObject[] = [itemList, ...(faqStructuredData ? [faqStructuredData] : [])];
---
<BaseLayout title={title} description={description} schemaType="CollectionPage" structuredData={structuredData} locale="uk" heroPreloadSrc="/images/v5/hero-desktop.webp" heroPreloadSrcset="/images/v5/hero-desktop-480.webp 480w, /images/v5/hero-desktop-800.webp 800w, /images/v5/hero-desktop-960.webp 960w, /images/v5/hero-desktop-1200.webp 1200w, /images/v5/hero-desktop.webp 1536w" heroPreloadSizes="(max-width: 900px) 100vw, (max-width: 1535px) 55vw, 825px" heroPreloadMobileSrc="/images/v5/hero-mobile-800.webp" heroPreloadMobileSrcset="/images/v5/hero-mobile-480.webp 480w, /images/v5/hero-mobile-800.webp 800w">
  <div class="sg-page-shell"><Header />
    <main id="main" class="catalog-hub">
      <header class="catalog-hub__hero catalog-hub__wrap"><div class="catalog-hub__hero-copy"><p class="catalog-hub__eyebrow">Каталог Space Glass</p><h1>Каталог скляних та<br>алюмінієвих конструкцій</h1><p class="catalog-hub__lead">Оберіть скляні та алюмінієві конструкції для квартири, будинку чи бізнесу — від душових, перегородок, дверей, огорож і дзеркал до безрамного, панорамного й фасадного скління, алюмінієвих вікон та розсувних систем. Проєктуємо за індивідуальними розмірами, виготовляємо й монтуємо у Києві, Одесі, Львові та по Україні.</p><div class="catalog-hub__actions"><a class="button button--mint" href="/quote/">Отримати розрахунок</a><a class="button button--outline" href="#catalog-categories">Переглянути категорії</a></div></div><div class="catalog-hub__hero-media"><picture><source media="(max-width: 900px)" srcset="/images/v5/hero-mobile-480.webp 480w, /images/v5/hero-mobile-800.webp 800w" sizes="100vw" /><img src="/images/v5/hero-desktop.webp" srcset="/images/v5/hero-desktop-480.webp 480w, /images/v5/hero-desktop-800.webp 800w, /images/v5/hero-desktop-960.webp 960w, /images/v5/hero-desktop-1200.webp 1200w, /images/v5/hero-desktop.webp 1536w" sizes="(max-width: 900px) 100vw, (max-width: 1535px) 55vw, 825px" width="1536" height="1024" alt="Скляні конструкції Space Glass для дому та бізнесу" loading="eager" fetchpriority="high" decoding="async" /></picture></div></header>

      <section class="catalog-hub__section catalog-hub__wrap" id="catalog-categories" aria-labelledby="catalog-categories-title"><div class="catalog-hub__section-head"><p class="catalog-hub__eyebrow">Напрямки</p><h2 id="catalog-categories-title">Оберіть тип конструкції</h2><p>Оберіть потрібний тип скляної чи алюмінієвої конструкції, перейдіть до доступних варіантів виконання та порівняйте рішення для квартири, приватного будинку або комерційного об’єкта. У кожному напрямку зібрані системи, які виготовляємо за індивідуальними розмірами.</p></div><div class="catalog-hub__grid">
        {categories.map((category, index) => <article class="catalog-card"><a class="catalog-card__media" href={category.href} aria-label={`Переглянути категорію: ${category.name}`}><img src={category.image} alt={category.imageAlt} width={category.imageWidth} height={category.imageHeight} loading="lazy" decoding="async" /><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span></a><div class="catalog-card__body"><h3><a href={category.href}>{category.name}<span aria-hidden="true">→</span></a></h3><p>{category.description}</p>{category.childLinks.length ? <ul aria-label={`Підкатегорії: ${category.name}`}>{category.childLinks.map((service) => <li><a href={service.path}>{service.shortName}</a></li>)}</ul> : <p class="catalog-card__variants">{category.variants.join(' · ')}</p>}<a class="catalog-card__all" href={category.href}>Переглянути категорію <span aria-hidden="true">→</span></a></div></article>)}
      </div></section>

      <section class="catalog-hub__band"><div class="catalog-hub__wrap catalog-hub__section" aria-labelledby="popular-title"><div class="catalog-hub__section-head"><p class="catalog-hub__eyebrow">Швидкий вибір</p><h2 id="popular-title">Популярні напрямки</h2><p>Перейдіть одразу до потрібної конфігурації, якщо тип конструкції вже відомий.</p></div><div class="catalog-link-grid">{popularDirections.map(([label, href]) => <a href={href}>{label}<span aria-hidden="true">↗</span></a>)}</div></div></section>

      <section class="catalog-hub__section catalog-hub__wrap" aria-labelledby="objects-title"><div class="catalog-hub__section-head"><p class="catalog-hub__eyebrow">За типом об’єкта</p><h2 id="objects-title">Підберіть рішення для свого об’єкта</h2><p>Для квартири, будинку, офісу, готелю, ресторану чи магазину потрібні різні сценарії використання й комплектація. Підбір залежить від розмірів, щоденного навантаження, потрібної приватності, способу відкривання та архітектури простору.</p></div><div class="catalog-object-grid">{SOLUTIONS.map((solution) => <a href={solution.path}><span>{solution.navLabel}</span><p>{solution.hubCardText}</p><b>Переглянути рішення →</b></a>)}</div></section>

      <section class="catalog-hub__section catalog-hub__wrap" aria-labelledby="projects-title"><div class="catalog-project-head"><div class="catalog-hub__section-head"><p class="catalog-hub__eyebrow">Реальні об’єкти</p><h2 id="projects-title">Скляні конструкції в реалізованих проєктах</h2><p>Реальні проєкти показують не лише зовнішній вигляд, а й тип системи, її застосування та підібрані матеріали. У кожному прикладі можна побачити задачу об’єкта, технічне рішення й готовий результат після монтажу.</p></div><div class="catalog-project-controls" aria-label="Керування каруселлю проєктів"><button type="button" aria-label="Попередні проєкти" data-catalog-project-direction="-1">←</button><button type="button" aria-label="Наступні проєкти" data-catalog-project-direction="1">→</button></div></div><div class="catalog-project-viewport" data-catalog-projects-carousel tabindex="0" aria-label="Реалізовані проєкти Space Glass"><div class="catalog-project-grid">{catalogProjects.map((project) => <a href={`/projects/${project.slug}/`}><div><img src={project.cover.src.replace('.webp', '-480.webp')} width={project.cover.width} height={project.cover.height} alt={project.cover.alt} loading="lazy" decoding="async" /></div><p>{project.city} · {project.constructionType}</p><h3>{project.cardTitle}</h3><b>Переглянути проєкт →</b></a>)}</div></div><a class="catalog-hub__text-link" href="/projects/">Усі реалізовані проєкти →</a></section>

      <section class="catalog-hub__band"><div class="catalog-hub__section catalog-hub__wrap catalog-choose" aria-labelledby="choose-title"><div class="catalog-hub__section-head"><p class="catalog-hub__eyebrow">Комплектація</p><h2 id="choose-title">Що врахувати під час вибору</h2><p>Рішення починається з призначення конструкції, точних розмірів і вимог до безпеки. Далі узгоджуємо тип та товщину скла, профіль і фурнітуру, спосіб відкривання, монтажні основи й умови встановлення.</p></div><div class="catalog-choose__grid">{choosePoints.map(([heading, text]) => <article><h3>{heading}</h3><p>{text}</p></article>)}</div><a class="catalog-hub__text-link" href="/knowledge/">Матеріали про скло та конструкції →</a></div></section>

      <section class="catalog-hub__section catalog-hub__wrap catalog-experience" aria-labelledby="experience-title"><div class="catalog-experience__copy"><p class="catalog-hub__eyebrow">Досвід Space Glass</p><h2 id="experience-title">Від задуму до точної реалізації</h2><p>Проєктуємо скляні та алюмінієві конструкції під конкретний простір, виготовляємо за погодженими параметрами й монтуємо на об’єкті.</p><a class="catalog-hub__text-link" href="/about/">Більше про Space Glass →</a></div><dl>{stats.map(([value, label]) => <div><dt>{value}</dt><dd>{label}</dd></div>)}</dl></section>

      <section class="catalog-hub__section catalog-hub__wrap" aria-labelledby="process-title"><div class="catalog-hub__section-head"><p class="catalog-hub__eyebrow">Етапи роботи</p><h2 id="process-title">Від запиту до готової конструкції</h2><p>Space Glass супроводжує проєкт від перших фото, розмірів або креслень до точного заміру й технічного рішення. Після погодження комплектації виготовляємо конструкцію, організовуємо доставку та виконуємо монтаж на об’єкті.</p></div><ol class="catalog-process">{processSteps.map(([heading, text], index) => <li><span>{String(index + 1).padStart(2, '0')}</span><h3>{heading}</h3><p>{text}</p></li>)}</ol></section>

      <section class="catalog-hub__geo catalog-hub__wrap" aria-labelledby="geo-title"><div><p class="catalog-hub__eyebrow">Географія</p><h2 id="geo-title">Проєктування та монтаж по Україні</h2><p>Space Glass працює з житловими, комерційними й архітектурними об’єктами у Києві, Одесі, Львові та інших містах України. Формат роботи й логістику визначаємо відповідно до конструкції та розташування об’єкта.</p></div><nav aria-label="Міста роботи"><a href="/city/kyiv/">Київ ↗</a><a href="/city/odesa/">Одеса ↗</a><a href="/city/lviv/">Львів ↗</a></nav></section>

      <div class="catalog-hub__section catalog-hub__wrap catalog-faq" id="catalog-faq"><FAQBlock eyebrow="FAQ" title="Питання про вибір конструкцій" intro="Відповіді про вибір типу конструкції, безпечного скла, профілю, фурнітури та індивідуальних розмірів. Дізнайтеся, як підготуватися до заміру, від чого залежить вартість і що врахувати під час монтажу та експлуатації." items={faqItems} visibleCount={6} variant="compact" locale="uk" /></div>

      <section class="catalog-cta catalog-hub__wrap" aria-labelledby="catalog-cta-title"><div><p class="catalog-hub__eyebrow">Обговоримо ваш проєкт</p><h2 id="catalog-cta-title">Потрібна конструкція за індивідуальними розмірами?</h2><p>Надішліть фото, приблизні розміри або креслення. Допоможемо визначити тип системи, матеріали та наступні кроки.</p></div><div class="catalog-hub__actions"><a class="button button--mint" href="/quote/">Отримати розрахунок</a><a class="button button--light" href="/contacts/">Зв’язатися з командою</a></div></section>
    </main><Footer />
  </div>
</BaseLayout>
<style is:inline>
  .catalog-card a,.catalog-card a:hover,.catalog-card a:focus,.catalog-card a:focus-visible,.catalog-card a:active{text-decoration:none!important}
  .catalog-card h3 a:hover,.catalog-card h3 a:focus,.catalog-card h3 a:focus-visible,.catalog-card h3 a:active,.catalog-card li a:hover,.catalog-card li a:focus,.catalog-card li a:focus-visible,.catalog-card li a:active{color:var(--catalog-mint)}
  .catalog-project-head{display:flex;align-items:end;justify-content:space-between;gap:30px}
  .catalog-project-controls{display:flex;flex:0 0 auto;gap:8px;margin-bottom:clamp(30px,4vw,48px)}
  .catalog-project-controls button{display:grid;width:48px;height:48px;padding:0;border:1px solid var(--catalog-line);border-radius:50%;background:#fff;place-items:center;color:var(--catalog-ink);font-size:20px;cursor:pointer}
  .catalog-project-controls button:hover,.catalog-project-controls button:focus-visible{border-color:var(--catalog-mint);color:var(--catalog-mint)}
  .catalog-project-viewport{overflow-x:auto;padding-bottom:14px;scroll-snap-type:x mandatory;scrollbar-width:thin;scrollbar-color:var(--catalog-mint) #eaf1ee;overscroll-behavior-inline:contain}
  .catalog-project-grid{display:flex;width:max-content;gap:18px;margin:0;padding:0;overflow:visible}
  .catalog-project-grid>a{width:clamp(250px,23vw,320px);min-width:0;flex:none;scroll-snap-align:start}
  @media(max-width:1050px){.catalog-project-grid{gap:16px}.catalog-project-grid>a{width:min(44vw,430px)}}
  @media(max-width:640px){.catalog-project-head{display:block}.catalog-project-controls{margin-top:-12px;margin-bottom:24px}.catalog-project-viewport{margin-inline:-20px;padding-inline:20px}.catalog-project-grid{gap:14px}.catalog-project-grid>a{width:82vw}}
</style>
<script is:inline>
  const catalogProjectsCarousel = document.querySelector('[data-catalog-projects-carousel]');
  const scrollCatalogProjects = (direction) => {
    if (!catalogProjectsCarousel) return;
    const card = catalogProjectsCarousel.querySelector('.catalog-project-grid > a');
    const distance = card ? card.getBoundingClientRect().width + 18 : catalogProjectsCarousel.clientWidth;
    catalogProjectsCarousel.scrollBy({ left: direction * distance, behavior: 'smooth' });
  };
  document.querySelectorAll('[data-catalog-project-direction]').forEach((button) => button.addEventListener('click', () => scrollCatalogProjects(Number(button.dataset.catalogProjectDirection))));
  catalogProjectsCarousel?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
      event.preventDefault();
      scrollCatalogProjects(event.key === 'ArrowRight' ? 1 : -1);
    }
  });
</script>
