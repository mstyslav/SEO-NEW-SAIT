---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQBlock from '../../components/FAQBlock.astro';
import TrustBar from '../../components/TrustBar.astro';
import PriceBlock from '../../components/PriceBlock.astro';
import { absoluteUrl, faqSchema, type JsonLdObject } from '../../seo/schema';
import '../../styles/category-pages.css';
import '../../styles/shower-master.css';

const origin = Astro.site ?? Astro.url.origin;
const pageUrl = absoluteUrl('/catalog/piddon/', origin);

const title = 'Душові піддони';
const metaTitle = 'Душові піддони — купити піддон для душу зі штучного каменю | Space Glass';
const metaDescription =
  'Душові піддони зі штучного каменю: квадратні, прямокутні та п’ятикутні моделі Weston із сифоном у комплекті, антиковзанням та тонким профілем 30–32 мм. Підбираємо піддон під скляну душову Space Glass за розміром і формою. Замір, доставка по Україні, монтаж у Києві, Одесі та Львові.';

// --- Real Weston shower-tray models -----------------------------------------
// Data taken from weston.com.ua product pages (Product JSON-LD + characteristics
// blocks). Prices are indicative, for the starting size, and can change — they
// are shown as "орієнтовно від". Where the category and product pages disagree,
// the product page is used.
const models = [
  {
    id: 'weston-es-h',
    name: 'Weston ES-H',
    shape: 'Прямокутний / квадратний',
    priceFrom: 'орієнтовно від 13 000 грн',
    priceNote: 'за дані виробника, розмір 900×900 мм',
    sizes: ['900×900', '800×1200', '900×1200', '900×1600'],
    colors: ['Білий', 'Графіт'],
    mediaTone: 'light',
    image: 'es-h-white',
    imageAlt: 'Душовий піддон Weston ES-H зі штучного каменю, білий, прямокутної форми',
    specs: [
      ['Матеріал', 'Штучний мармур (кварцова сировина)'],
      ['Профіль', '30 мм'],
      ['Макс. навантаження', 'до 375 кг'],
      ['Антиковзання', 'Клас 3'],
      ['Комплектація', 'Сифон + декоративна кришка з каменю'],
      ['Гарантія', '5 років (виробник)']
    ],
    blurb: 'Флагманська серія з виразною кам’яною текстурою. Два кольори, широкий діапазон розмірів — базове рішення під Walk-In та душі в нішу.'
  },
  {
    id: 'weston-es-a',
    name: 'Weston ES-A',
    shape: 'Квадратний / прямокутний',
    priceFrom: 'орієнтовно від 11 700 грн',
    priceNote: 'за дані виробника, розмір 800×1000 мм',
    sizes: ['800×800', '800×1000', '900×900', '800×1200', '800×1400', '900×1200'],
    colors: ['Білий', 'Графіт'],
    mediaTone: 'light',
    image: 'es-a-white',
    imageAlt: 'Душовий піддон Weston ES-A зі штучного каменю, білий, квадратної форми',
    specs: [
      ['Матеріал', 'Штучний камінь (кварцова сировина)'],
      ['Профіль', '30 мм'],
      ['Макс. навантаження', 'до 375 кг'],
      ['Антиковзання', 'Клас 3'],
      ['Комплектація', 'Сифон + декоративна кришка з каменю'],
      ['Гарантія', '5 років (виробник)']
    ],
    blurb: 'Найбільший вибір типорозмірів — від компактних 800×800 до видовжених 800×1400 мм. Для вузьких і нестандартних душових зон.'
  },
  {
    id: 'weston-wpd-k',
    name: 'Weston WPD-K',
    shape: 'Квадратний / прямокутний',
    priceFrom: 'орієнтовно від 10 500 грн',
    priceNote: 'за дані виробника, розмір 900×900 мм',
    sizes: ['900×900', '1200×900'],
    colors: ['Білий'],
    mediaTone: 'dark',
    image: 'wpd-k-square',
    imageAlt: 'Душовий піддон Weston WPD-K зі штучного мармуру, білий, квадратний',
    specs: [
      ['Матеріал', 'Надміцний штучний мармур'],
      ['Профіль', '32 мм'],
      ['Макс. навантаження', 'до 500 кг'],
      ['Поверхня', 'Не стає слизькою при контакті з водою'],
      ['Комплектація', 'Сифон + декоративна накладка'],
      ['Гарантія', '5 років (виробник)']
    ],
    blurb: 'Посилений штучний мармур із запасом на навантаження до 500 кг. Дві форми — квадрат 900×900 та прямокутник 1200×900 мм.'
  },
  {
    id: 'weston-wpd-p',
    name: 'Weston WPD-P',
    shape: 'П’ятикутний',
    priceFrom: 'орієнтовно від 9 500 грн',
    priceNote: 'за дані виробника, розмір 900×900 мм',
    sizes: ['900×900', '1000×1000'],
    colors: ['Білий'],
    mediaTone: 'dark',
    image: 'wpd-p-pentagon',
    imageAlt: 'Душовий піддон Weston WPD-P зі штучного каменю, білий, п’ятикутної форми зі скошеною передньою гранню',
    specs: [
      ['Матеріал', 'Штучний камінь (кварцова сировина)'],
      ['Профіль', '32 мм'],
      ['Макс. навантаження', 'до 500 кг'],
      ['Поверхня', 'Не стає слизькою при контакті з водою'],
      ['Комплектація', 'Сифон + декоративна накладка'],
      ['Гарантія', '5 років (виробник)']
    ],
    blurb: 'Кутове рішення зі скошеною передньою гранню — економить простір у невеликій ванній та поєднується з п’ятикутною скляною кабіною.'
  }
];

const priceDisclaimer =
  'Ціни орієнтовні, за даними виробника Weston, вказані для стартового розміру та можуть змінюватися. Точну вартість, розмір і наявність підтверджуємо за запитом.';

// --- Choose by shape / size ------------------------------------------------
const byShape = [
  ['Квадратні', 'Для компактних і кутових душів: 800×800, 900×900, 1000×1000 мм. Симетрична зона під двері або Walk-In.'],
  ['Прямокутні', 'Для ніш і просторіших зон: 800×1200, 900×1200, 900×1600 мм. Комфортний душ уздовж стіни.'],
  ['П’ятикутні', 'Зі скошеною передньою гранню для кута кімнати — під п’ятикутну скляну кабіну.']
];
const bySize = [
  ['Компактний душ', '800×800 – 900×900 мм', 'Мінімальна зручна зона для однієї людини у невеликій ванній.'],
  ['Стандарт', '900×1000 – 900×1200 мм', 'Найпопулярніший діапазон під душові двері та перегородки в нішу.'],
  ['Walk-In / великий', '900×1400 – 900×1600 мм', 'Видовжена зона під відкриту перегородку без дверей.']
];

// --- How to choose -------------------------------------------------------
const chooseSteps = [
  ['Заміряйте зону', 'Ширина та глибина мокрої зони по чистовому оздобленню, з урахуванням майбутнього скла.'],
  ['Оберіть форму', 'Квадрат — кут або двері, прямокутник — ніша та Walk-In, п’ятикутник — зрізаний кут.'],
  ['Профіль і вхід', 'Тонкий піддон 30–32 мм дає майже врівень вхід; висоту входу узгоджуємо зі склом.'],
  ['Злив і поверхня', 'Розташування випуску, сифон у комплекті, антиковзання — перевіряємо до замовлення.']
];

// --- Tray vs flush --------------------------------------------------------
const baseCards = [
  {
    name: 'З готовим піддоном',
    text: 'Штучний камінь спрощує гідроізоляцію та організацію зливу: сифон і декоративна кришка вже в комплекті. Розмір і форму піддона узгоджуємо зі скляною конструкцією до фінального заміру.',
    href: '#catalog',
    linkLabel: 'Перейти до каталогу піддонів →'
  },
  {
    name: 'Душ урівень з підлогою',
    text: 'Плитка по стяжці з ухилом до точкового трапа або лінійного водовідведення — без піддона. Потрібна підготовлена основа з правильною гідроізоляцією; геометрію враховуємо під час заміру.'
  }
];

// --- Bundle: tray + Space Glass shower -----------------------------------
const showerLinks = [
  ['Скляні перегородки для душу (Walk-In)', '/dushovi-kabiny/peregorodka-dlya-dusha/'],
  ['Скляні душові двері', '/dushovi-kabiny/dushovi-dveri/'],
  ['Кутові душові кабіни', '/dushovi-kabiny/kutovi/'],
  ['Душові кабіни в нішу', '/dushovi-kabiny/u-nishu/'],
  ['Розсувні душові кабіни', '/dushovi-kabiny/rozsuvni/'],
  ['П’ятикутні душові кабіни', '/dushovi-kabiny/piatykutni/']
];

// --- Related / useful links --------------------------------------------
const relatedLinks = [
  ['Усі види душових кабін', '/dushovi-kabiny/'],
  ['Душові піддони: підбір під конструкцію', '/dushovi-kabiny/dushovi-piddony/'],
  ['Як обрати душову кабіну', '/knowledge/yak-obraty-dushovu-kabinu/'],
  ['Душова в нішу: замір', '/knowledge/dushova-v-nishu-zamir/'],
  ['Як підготувати простір до заміру', '/knowledge/yak-pidhotuvaty-prostir-do-zamiru/'],
  ['Догляд за склом і поверхнями', '/knowledge/doglyad-za-sklyanymy-konstruktsiyamy/'],
  ['Від чого залежить ціна конструкції', '/knowledge/vid-choho-zalezhyt-tsina-sklyanoyi-konstruktsiyi/'],
  ['Оплата та доставка', '/oplata-dostavka/']
];

// --- FAQ (real search intents) ----------------------------------------
const faq: [string, string][] = [
  ['Скільки коштує душовий піддон?', 'Піддони зі штучного каменю Weston — орієнтовно від 9 500 грн за стартовий розмір. Кінцева ціна залежить від моделі, розміру, форми та кольору. Ціни за даними виробника, актуальну вартість і наявність підтверджуємо за запитом.'],
  ['Як підібрати розмір душового піддона?', 'Заміряйте фактичну ширину та глибину мокрої зони по чистовому оздобленню й врахуйте місце під майбутню скляну конструкцію. Компактний душ — 800×800–900×900 мм, стандарт — 900×1000–900×1200 мм, Walk-In — 900×1400–900×1600 мм.'],
  ['Який матеріал піддона кращий?', 'Штучний камінь (мармурова крихта на кварцовій основі) міцніший за акрил, приємний на дотик, стійкий до подряпин і легко очищається. Моделі Weston витримують навантаження 375–500 кг і мають тонкий профіль 30–32 мм.'],
  ['Яка форма піддона потрібна?', 'Квадратні моделі — для кутових душів і зон під двері, прямокутні — для ніш і Walk-In, п’ятикутні зі скошеною гранню — для кута невеликої ванної під п’ятикутну кабіну.'],
  ['Чи слизький піддон зі штучного каменю?', 'Ні. Серія Weston ES має поверхню з 3 класом протиковзання, моделі WPD не стають слизькими при контакті з водою й зберігають комфортні тактильні властивості.'],
  ['Чи входить сифон у комплект?', 'Так. У піддонах Weston сифон і декоративна кришка (накладка) вже входять у комплектацію — докуповувати ці деталі не потрібно.'],
  ['Чи обов’язково робити душ із піддоном?', 'Ні. Скляну душову можна встановити і без піддона — на підготовлену підлогу з гідроізоляцією та ухилом до трапа. Піддон спрощує монтаж і водовідведення.'],
  ['Коли потрібно визначитися з піддоном?', 'До фінального заміру скла. Встановлений або точно обраний піддон задає геометрію, точки кріплення та розміри скляної конструкції.'],
  ['Чи можна замовити піддон разом зі скляною душовою?', 'Так, це бажаний сценарій. Space Glass підбирає піддон за розміром і формою та узгоджує його зі скляною перегородкою, дверима чи кабіною як одну систему.'],
  ['Чи є доставка піддонів по Україні?', 'Так. Виробник відправляє піддони по Україні; для замовлень зі скляною конструкцією Space Glass організовує доставку та монтаж у Києві, Одесі та Львові, в інших містах — за домовленістю.'],
  ['Яка гарантія на душовий піддон?', 'Виробник Weston надає 5 років гарантії на піддони зі штучного каменю за умови правильного монтажу та експлуатації.'],
  ['Який профіль (висота) у піддонів?', 'Моделі Weston мають тонкий профіль 30–32 мм, що дає майже врівень вхід у душ. Точну висоту входу узгоджуємо зі скляною конструкцією.']
];

// --- Structured data ----------------------------------------------------
const itemList: JsonLdObject = {
  '@type': 'ItemList',
  '@id': `${pageUrl}#models`,
  name: 'Душові піддони',
  numberOfItems: models.length,
  itemListElement: models.map((model, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Product',
      name: `Душовий піддон ${model.name}`,
      category: 'Душові піддони',
      brand: { '@type': 'Brand', name: 'Weston' },
      material: model.specs[0][1],
      image: absoluteUrl(`/images/catalog/piddony/${model.image}-900.webp`, origin)
    }
  }))
};
const faqStructuredData = faqSchema(faq.map(([question, answer]) => ({ question, answer })));
const structuredData: JsonLdObject[] = [itemList, ...(faqStructuredData ? [faqStructuredData] : [])];
---
<BaseLayout
  title={metaTitle}
  description={metaDescription}
  image="/images/catalog/piddony/es-h-white-900.webp"
  schemaType="CollectionPage"
  structuredData={structuredData}
  heroPreloadSrc="/images/catalog/piddony/piddony-hero-1200.webp"
  heroPreloadSrcset="/images/catalog/piddony/piddony-hero-480.webp 480w, /images/catalog/piddony/piddony-hero-768.webp 768w, /images/catalog/piddony/piddony-hero-1200.webp 1200w, /images/catalog/piddony/piddony-hero-1600.webp 1600w"
  heroPreloadSizes="(max-width: 900px) calc(100vw - 48px), 52vw"
>
<div class="sg-page-shell">
  <Header />
  <main id="main">
    <section class="category-hero category-hero--photo">
      <div class="category-hero__copy">
        <Breadcrumbs items={[{ label: 'Головна', href: '/' }, { label: 'Каталог', href: '/catalog/' }, { label: title }]} />
        <p class="eyebrow">Душові кабіни / Піддони</p>
        <h1>Душові піддони</h1>
        <p class="lead">Душові піддони зі штучного каменю під скляну душову Space Glass. Квадратні, прямокутні та п’ятикутні моделі Weston із сифоном у комплекті, антиковзанням і тонким профілем 30–32 мм. Підбираємо піддон за розміром і формою душової зони, узгоджуємо зі склом, організовуємо доставку та монтаж.</p>
        <div class="hero__actions">
          <a class="button button--mint" href="#catalog">Обрати піддон</a>
          <a class="button button--outline" href="/contacts/#contact-form">Отримати розрахунок</a>
        </div>
      </div>
      <figure class="category-hero__figure">
        <div class="category-hero__frame">
          <img
            src="/images/catalog/piddony/piddony-hero-1200.webp"
            srcset="/images/catalog/piddony/piddony-hero-480.webp 480w, /images/catalog/piddony/piddony-hero-768.webp 768w, /images/catalog/piddony/piddony-hero-1200.webp 1200w, /images/catalog/piddony/piddony-hero-1600.webp 1600w"
            sizes="(max-width: 900px) calc(100vw - 48px), 52vw"
            alt="Прямокутний душовий піддон зі штучного каменю в сучасній ванній кімнаті"
            width="1600"
            height="1045"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </figure>
    </section>

    <TrustBar locale="uk" />

    <section class="category-section category-section--mint">
      <div class="category-heading"><div><p class="eyebrow">Про піддони</p><h2>Піддон зі штучного каменю як частина душової системи</h2></div><p>Разом зі скляною конструкцією піддон працює як одна система: розміри, форма та вхід не конфліктують між собою.</p></div>
      <div class="category-intro-grid">
        <div class="category-prose">
          <p>Душовий піддон формує мокру зону, тримає ухил до зливу та захищає підлогу від протікання. Піддони зі штучного каменю (мармурова крихта на кварцовій основі) міцніші за акрил, мають приємну на дотик матову поверхню з кам’яною текстурою, стійкі до подряпин і легко очищаються.</p>
          <p>У каталозі — моделі виробника Weston: серії ES зі штучного мармуру з антиковзанням 3 класу та посилені моделі WPD із запасом на навантаження до 500 кг. Тонкий профіль 30–32 мм робить вхід у душ майже врівень з підлогою, а сифон і декоративна кришка входять у комплект.</p>
          <p>Space Glass підбирає піддон під конкретну душову зону та узгоджує його геометрію зі скляною перегородкою, дверима або кабіною ще до виробництва скла.</p>
        </div>
        <ul class="category-intro__spec">
          <li><b>Штучний камінь</b><span>кварцова сировина, матова кам’яна текстура</span></li>
          <li><b>Профіль 30–32 мм</b><span>майже врівень вхід у душ</span></li>
          <li><b>Антиковзання</b><span>клас 3 у серії ES</span></li>
          <li><b>Сифон у комплекті</b><span>сифон + декоративна кришка</span></li>
        </ul>
      </div>
    </section>

    <section id="catalog" class="category-section">
      <div class="category-heading"><div><p class="eyebrow">Каталог</p><h2>Душові піддони Weston</h2></div><p>Реальні моделі зі штучного каменю. Ціни орієнтовні, за даними виробника — точну вартість і наявність підтверджуємо за запитом.</p></div>
      <div class="piddon-grid">
        {models.map((model) => (
          <article class={`piddon-card piddon-card--${model.mediaTone}`}>
            <div class="piddon-card__media">
              <img
                src={`/images/catalog/piddony/${model.image}-480.webp`}
                srcset={`/images/catalog/piddony/${model.image}-480.webp 480w, /images/catalog/piddony/${model.image}-900.webp 900w`}
                sizes="(max-width: 700px) 90vw, (max-width: 1100px) 44vw, 30vw"
                alt={model.imageAlt}
                width="480"
                height="480"
                loading="lazy"
                decoding="async"
              />
              <span class="piddon-card__shape">{model.shape}</span>
            </div>
            <div class="piddon-card__body">
              <h3>{model.name}</h3>
              <p class="piddon-card__blurb">{model.blurb}</p>
              <p class="piddon-card__price"><strong>{model.priceFrom}</strong><span>{model.priceNote}</span></p>
              <dl class="piddon-card__specs">
