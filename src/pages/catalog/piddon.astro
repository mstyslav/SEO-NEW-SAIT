      <a class="button button--white" href="/contacts/#contact-form">Отримати розрахунок</a>
    </section>
  </main>
  <Footer />
</div>

<style>
  /* Piddon catalog — scoped page styles built on existing Space Glass tokens
     (--green-line, --mint, --mint-dark, --muted, --text, --radius). No new
     global rules; mirrors the .catalog-card / category-pages card rhythm. */
  .piddon-grid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:16px;
  }
  .piddon-card{
    display:flex;
    flex-direction:column;
    border:1px solid var(--green-line);
    border-radius:16px;
    overflow:hidden;
    background:#fff;
  }
  .piddon-card__media{
    position:relative;
    aspect-ratio:16/11;
    background:#eef4f1;
  }
  .piddon-card--dark .piddon-card__media{background:#17171a}
  .piddon-card__media img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
  }
  .piddon-card__shape{
    position:absolute;
    left:14px;
    bottom:14px;
    padding:6px 11px;
    border-radius:999px;
    background:rgba(255,255,255,.92);
    color:var(--text);
    font-size:.78rem;
    font-weight:700;
    line-height:1;
  }
  .piddon-card__body{
    display:flex;
    flex-direction:column;
    gap:12px;
    padding:24px;
  }
  .piddon-card__body h3{margin:0}
  .piddon-card__blurb{
    margin:0;
    color:var(--muted);
    font-size:.95rem;
    line-height:1.55;
  }
  .piddon-card__price{
    display:flex;
    flex-direction:column;
    gap:2px;
    margin:2px 0 0;
  }
  .piddon-card__price strong{font-size:1.15rem;letter-spacing:-.01em}
  .piddon-card__price span{color:var(--muted);font-size:.82rem}
  .piddon-card__specs{
    display:grid;
    gap:0;
    margin:4px 0 0;
    border-top:1px solid var(--green-line);
  }
  .piddon-card__specs div{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
    padding:11px 0;
    border-bottom:1px solid var(--green-line);
  }
  .piddon-card__specs dt{color:var(--muted);font-size:.88rem}
  .piddon-card__specs dd{margin:0;font-weight:700;font-size:.88rem}
  .piddon-card__meta{margin:0;font-size:.88rem;color:var(--text)}
  .piddon-card__meta b{color:var(--muted);font-weight:700}
  .piddon-card__cta{margin-top:8px;text-align:center}
  .piddon-note{
    margin:22px 0 0;
    color:var(--muted);
    font-size:.86rem;
    line-height:1.6;
    max-width:80ch;
  }

  .category-icon-card--static{min-height:0;padding:24px;cursor:default}
  .category-icon-card--static:hover{transform:none;border-color:var(--green-line);box-shadow:none}
  .category-icon-card--static h3{margin:0 0 10px}

  .piddon-table-wrap{
    overflow-x:auto;
    border:1px solid var(--green-line);
    border-radius:16px;
    background:#fff;
  }
  .piddon-table{
    width:100%;
    border-collapse:collapse;
    font-size:.9rem;
    min-width:760px;
  }
  .piddon-table th,
  .piddon-table td{
    padding:14px 16px;
    text-align:left;
    border-bottom:1px solid var(--green-line);
    vertical-align:top;
  }
  .piddon-table thead th{
    background:#f3fbf7;
    font-size:.78rem;
    text-transform:uppercase;
    letter-spacing:.06em;
    color:var(--mint-dark);
  }
  .piddon-table tbody th{font-weight:800}
  .piddon-table tbody tr:last-child th,
  .piddon-table tbody tr:last-child td{border-bottom:0}

  .piddon-bundle{
    display:grid;
    grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);
    gap:40px;
    align-items:center;
  }
  .piddon-bundle__media{
    margin:0;
    border:1px solid var(--green-line);
    border-radius:16px;
    overflow:hidden;
    background:#eef4f1;
  }
  .piddon-bundle__media img{display:block;width:100%;height:100%;object-fit:cover}
  .piddon-bundle__copy p{margin:0 0 18px;color:var(--muted);line-height:1.7}
  .piddon-bundle__links{
    list-style:none;
    margin:0;
    padding:0;
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:10px;
  }
  .piddon-bundle__links a{
    display:block;
    padding:14px 16px;
    border:1px solid var(--green-line);
    border-radius:12px;
    color:var(--text);
    font-weight:700;
    font-size:.9rem;
    line-height:1.4;
  }
  .piddon-bundle__links a:hover,
  .piddon-bundle__links a:focus-visible{border-color:var(--mint-dark);background:#f3fbf7}

  @media(max-width:1100px){
    .piddon-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  }
  @media(max-width:900px){
    .piddon-bundle{grid-template-columns:1fr;gap:24px}
    .piddon-bundle__links{grid-template-columns:1fr}
  }
  @media(max-width:700px){
    .piddon-grid{grid-template-columns:1fr}
    .piddon-card__body{padding:20px}
  }
</style>
</BaseLayout>
