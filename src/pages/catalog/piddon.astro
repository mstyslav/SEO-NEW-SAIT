          <figure class="hardware-details__item">
            <img src="/images/catalog/piddony/drain-detail-480.webp" srcset="/images/catalog/piddony/drain-detail-480.webp 480w, /images/catalog/piddony/drain-detail-900.webp 900w" sizes="(max-width: 900px) 90vw, 45vw" alt="Сифон для душового піддона, що входить у комплект" width="900" height="1351" loading="lazy" decoding="async" />
            <figcaption>Сифон у комплекті</figcaption>
