lay:grid;gap:3px}.config-result strong{font-size:26px}.config-result small{color:var(--muted);font-size:12px}.project-grid,.mini-grid,.related-grid{display:grid;gap:14px}.project-grid{grid-template-columns:1fr 1fr 1fr}.project-grid figure{margin:0}.project-grid img,.video-card{width:100%;aspect-ratio:4/3;object-fit:cover}.project-grid figcaption{font-size:12px;color:var(--muted);padding-top:8px}.video-card{border:0;background:#103f34;color:white;display:grid;place-items:center;align-content:center;gap:7px}.video-card span{font-size:36px}.video-card small{max-width:26ch}.mini-grid{grid-template-columns:repeat(4,1fr)}.mini-grid a,.related-grid a{border:1px solid var(--line);text-decoration:none;color:inherit;background:white;overflow:hidden}.mini-grid img,.related-grid img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block}.mini-grid a>small,.mini-grid h3,.mini-grid p,.mini-grid strong{margin-left:14px;margin-right:14px}.mini-grid a>small{display:block;margin-top:14px;color:#176b55;text-transform:uppercase;letter-spacing:.08em;font-size:10px}.mini-grid h3{font-size:18px;margin-top:7px;margin-bottom:5px}.mini-grid p{font-size:13px;line-height:1.45;color:var(--muted);min-height:38px}.mini-grid strong{display:block;margin-bottom:16px;color:#176b55;font-size:13px}.spec-layout{display:grid;grid-template-columns:1.25fr .75fr;gap:36px}.spec-table{margin:0}.spec-table div{display:grid;grid-template-columns:1fr 1fr;gap:20px;padding:14px 0;border-bottom:1px solid var(--line)}.spec-table dt{color:var(--muted)}.spec-table dd{margin:0;font-weight:800}.docs{display:grid;align-content:start;gap:9px}.docs>a{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;border:1px solid var(--line);padding:16px;text-decoration:none;color:inherit}.docs>a span{font-size:10px;color:#176b55;font-weight:800}.docs i{font-style:normal}.seo-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:42px}.seo-grid p{font-size:16px;line-height:1.65;color:#3f4d49}.seo-grid nav{display:grid;align-content:start}.seo-grid nav a{padding:13px 0;border-bottom:1px solid var(--line);text-decoration:none;color:inherit;font-weight:700}.related-grid{grid-template-columns:repeat(3,1fr)}.related-grid h3,.related-grid span{margin-left:14px;margin-right:14px}.related-grid h3{margin-bottom:8px}.related-grid span{display:block;color:#176b55;font-weight:700;font-size:13px;margin-bottom:16px}.faq-wrap{padding-top:58px}.quote{margin:0 34px 64px;padding:34px;background:#0e4f3d;color:#fff;display:flex;justify-content:space-between;align-items:end;gap:28px}.quote h2{font-size:36px;margin:4px 0 8px}.quote p:not(.eyebrow){margin:0;color:#d8eee7}.quote a{background:var(--mint);color:#0e251f;text-decoration:none;padding:14px 18px;font-weight:800}.lightbox{border:0;padding:0;background:#0b0f0e;max-width:min(94vw,1400px);max-height:92vh}.lightbox::backdrop{background:rgba(0,0,0,.82)}.lightbox img{display:block;max-width:92vw;max-height:88vh;object-fit:contain}.lightbox button{position:absolute;right:12px;top:10px;z-index:2;width:42px;height:42px;border-radius:50%;border:0;background:white;font-size:27px;cursor:pointer}
@media(max-width:980px){.product-main{grid-template-columns:1fr}.buy-box{position:static}.config-grid{grid-template-columns:repeat(2,1fr)}.mini-grid{grid-template-columns:repeat(2,1fr)}.project-grid{grid-template-columns:1fr 1fr}.video-card{grid-column:1/-1;aspect-ratio:16/6}.spec-layout,.seo-grid{grid-template-columns:1fr}.sg-home-category-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:620px){.breadcrumbs,.product-title-block,.product-main,.section{padding-left:18px;padding-right:18px}.product-main{gap:20px}.product-title-block h1{font-size:38px}.product-facts,.quick-specs{grid-template-columns:1fr 1fr}.config-grid,.project-grid,.mini-grid,.related-grid{grid-template-columns:1fr}.video-card{grid-column:auto;aspect-ratio:4/3}.config-result,.quote{align-items:stretch;flex-direction:column}.quote{margin:0 18px 38px}.main-photo{aspect-ratio:4/3}}
</style>

<script is:inline>
(() => {
  const product = { id:'SG-WI-BL-001', title:'Душова перегородка Walk-In Black', href:'/catalog/dushova-perehorodka-walk-in-black/', image:'/images/v5/product-1.webp', price:'від 12 900 ₴' };
  const wishlistKey = 'sg-wishlist';
  const button = document.getElementById('wishlist');
  const read = () => { try { return JSON.parse(localStorage.getItem(wishlistKey) || '[]'); } catch { return []; } };
  const renderWish = () => {
    if (!button) return;
    const active = read().some((item) => (item.id || item) === product.id || item.href === product.href);
    button.classList.toggle('is-active', active);
    button.setAttribute('aria-pressed', String(active));
    button.querySelector('span').textContent = active ? '♥' : '♡';
    button.querySelector('b').textContent = active ? 'В обраному' : 'В обране';
  };
  button?.addEventListener('click', () => {
    let list = read();
    const exists = list.some((item) => (item.id || item) === product.id || item.href === product.href);
    list = exists ? list.filter((item) => (item.id || item) !== product.id && item.href !== product.href) : [...list, product];
    localStorage.setItem(wishlistKey, JSON.stringify(list));
    renderWish();
    dispatchEvent(new Event('sg-wishlist-change'));
  });
  renderWish();

  const mainImg = document.querySelector('.main-photo img');
  const lightbox = document.getElementById('product-lightbox');
  const lightboxImg = lightbox?.querySelector('img');
  document.querySelectorAll('.thumbs button[data-src]').forEach((thumb) => {
    thumb.addEventListener('click', () => {
      document.querySelectorAll('.thumbs button').forEach((el) => el.classList.remove('active'));
      thumb.classList.add('active');
      if (mainImg) { mainImg.src = thumb.dataset.src; mainImg.alt = thumb.dataset.alt || ''; }
    });
  });
  document.querySelector('[data-gallery-open]')?.addEventListener('click', () => {
    if (lightbox && lightboxImg && mainImg) { lightboxImg.src = mainImg.src; lightboxImg.alt = mainImg.alt; lightbox.showModal(); }
  });
  lightbox?.querySelector('button')?.addEventListener('click', () => lightbox.close());
  lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) lightbox.close(); });

  const calc = document.getElementById('cfg-calc');
  calc?.addEventListener('click', () => {
    const width = Number(document.getElementById('cfg-width')?.value || 1200);
    const height = Number(document.getElementById('cfg-height')?.value || 2000);
    const thickness = document.getElementById('cfg-thickness')?.value;
    const glass = document.getElementById('cfg-glass')?.value;
    const hardware = document.getElementById('cfg-hardware')?.value;
    const tray = document.getElementById('cfg-tray')?.value;
    const install = document.getElementById('cfg-install')?.value;
    let price = 12900 * (width / 1200) * (height / 2000);
    if (thickness === '10') price *= 1.13;
    if (glass === 'satin') price *= 1.10;
    if (glass === 'tinted') price *= 1.16;
    if (hardware === 'chrome') price *= 1.04;
    if (hardware === 'graphite') price *= 1.07;
    if (tray === 'stone') price += 8900;
    if (tray === 'acrylic') price += 4200;
    if (install === 'yes') price += 2500;
    const result = document.getElementById('cfg-result');
    if (result) result.textContent = `від ${Math.round(price / 100) * 100.toLocaleString?.('uk-UA') || Math.round(price / 100) * 100} ₴`.replace(/(\d)(?=(\d{3})+\s₴)/g,'$1 ');
  });
})();
</script>
