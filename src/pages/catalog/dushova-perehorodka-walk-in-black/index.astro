---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FAQBlock from '../../../components/FAQBlock.astro';
import GoogleReviews from '../../../components/GoogleReviews.astro';

const faq = [
  ['Скільки коштує душова скляна перегородка?', 'Ціна залежить від ширини та висоти скла, товщини 8 або 10 мм, кольору скла, фурнітури, способу кріплення, піддона та монтажу. На сторінці можна отримати попередній розрахунок.'],
  ['Чи можна виготовити перегородку за індивідуальними розмірами?', 'Так. Душову скляну перегородку виготовляємо під конкретний отвір після перевірки розмірів або професійного заміру.'],
  ['Яке скло використовується?', 'Для душових перегородок використовуємо безпечне загартоване скло ESG. Товщину підбираємо за габаритами та способом кріплення.'],
  ['Яку товщину скла обрати — 8 чи 10 мм?', 'Для більшості стаціонарних перегородок базовим рішенням є 8 мм. Для збільшених габаритів або окремих вузлів може бути рекомендовано 10 мм.'],
  ['Які кольори скла доступні?', 'Можна обрати прозоре, Satin, сіре або бронзове тоноване скло. Доступність конкретного відтінку підтверджуємо перед виробництвом.'],
  ['Які кольори фурнітури доступні?', 'Базово доступні чорна матова, хром і брашована сталь. Для окремих систем можливі золоті та індивідуальні кольори.'],
  ['Чи потрібен стабілізатор?', 'Потреба у стабілізуючій штанзі залежить від ширини полотна, висоти, товщини скла та схеми кріплення.'],
  ['Чи можна встановити перегородку на душовий піддон?', 'Так. Конструкцію можна адаптувати під піддон або встановлення безпосередньо на підлогу з лінійним трапом.'],
  ['Чи можна замовити душовий піддон разом із перегородкою?', 'Так. Підберемо піддон за розміром і геометрією душової зони, щоб конструкція працювала як єдина система.'],
  ['Чи виконуєте монтаж?', 'Так. Монтаж доступний у регіонах обслуговування Space Glass. Для інших міст можемо організувати виготовлення та доставку.'],
  ['Чи є доставка по Україні?', 'Так, організовуємо доставку скляних конструкцій по Україні.'],
  ['Який строк виготовлення?', 'Строк залежить від скла, фурнітури, нестандартних опцій і поточного завантаження виробництва. Точний строк фіксуємо після погодження замовлення.'],
  ['Чи є гарантія?', 'Так, на конструкцію діє гарантія 2 роки відповідно до умов замовлення та правильної експлуатації.'],
  ['Чи можна замовити тільки виготовлення без монтажу?', 'Так. Для частини проєктів можливе виготовлення та доставка без монтажу.'],
  ['Як правильно зробити замір?', 'Для попереднього розрахунку достатньо ширини, висоти та фото місця монтажу. Перед виробництвом рекомендуємо професійний замір.'],
  ['Чи можна зробити нестандартну форму?', 'Так, нестандартні рішення розглядаємо індивідуально після креслення або заміру.'],
  ['Як доглядати за склом?', 'Рекомендуємо неабразивні засоби, м’яку серветку та регулярне видалення води зі скла після душу.'],
  ['Чи працюєте з дизайнерами та архітекторами?', 'Так. Працюємо за кресленнями, специфікаціями та дизайн-проєктами.'],
  ['Що потрібно для попереднього розрахунку?', 'Надішліть ширину, висоту, фото душової зони, місто та бажані колір скла і фурнітури.'],
  ['Як оформити замовлення?', 'Оберіть параметри у конфігураторі або надішліть заявку. Після технічного уточнення підготуємо остаточну комплектацію та пропозицію.']
];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Душова скляна перегородка',
  sku: 'SG-00001',
  brand: { '@type': 'Brand', name: 'Space Glass' },
  description: 'Душова скляна перегородка на замовлення із загартованого скла ESG 8–10 мм. Індивідуальні розміри, вибір кольору скла та фурнітури, доставка по Україні.',
  image: ['/images/v5/product-1.webp','/images/v5/project-1.webp','/images/v5/project-2.webp'],
  category: 'Душові перегородки зі скла',
  additionalProperty: [
    { '@type':'PropertyValue', name:'Товщина скла', value:'8 або 10 мм' },
    { '@type':'PropertyValue', name:'Колір скла', value:'Прозоре, Satin, сіре, бронза' },
    { '@type':'PropertyValue', name:'Розмір', value:'Індивідуальний' },
    { '@type':'PropertyValue', name:'Доставка', value:'По Україні' }
  ],
  offers: {
    '@type': 'Offer',
    priceCurrency: 'UAH',
    price: '12900',
    availability: 'https://schema.org/PreOrder',
    url: 'https://space-glass.com.ua/catalog/dushova-perehorodka-walk-in-black/'
  }
};
---
<BaseLayout title="Душова скляна перегородка на замовлення — ціна | Space Glass" description="Душова скляна перегородка зі загартованого скла 8–10 мм на замовлення. Індивідуальні розміри, прозоре, Satin, сіре або бронзове скло, вибір фурнітури, доставка по Україні." image="/images/v5/product-1.webp" structuredData={productSchema}>
<div class="sg-page-shell">
  <Header />
  <main id="main" class="product-page">
    <nav class="breadcrumbs" aria-label="Навігація"><a href="/">Головна</a><span>›</span><a href="/dushovi-kabiny/">Душові кабіни</a><span>›</span><span>Душова скляна перегородка</span></nav>

    <header class="product-title-block">
      <p class="eyebrow">Душові перегородки зі скла</p>
      <h1>Душова скляна перегородка</h1>
      <p>Стаціонарна перегородка для душу із загартованого скла, виготовлена за індивідуальними розмірами. Підбираємо товщину та колір скла, фурнітуру, кріплення і комплектацію під конкретну душову зону.</p>
    </header>

    <section class="product-main">
      <div class="gallery" data-gallery>
        <button class="main-photo" type="button" data-gallery-open aria-label="Відкрити велике фото душової скляної перегородки">
          <img src="/images/v5/product-1.webp" alt="Душова скляна перегородка із прозорого загартованого скла 8 мм" width="1200" height="820" fetchpriority="high" />
          <span class="badge">Виготовлення під розмір</span>
          <span class="photo-hint">Відкрити фото</span>
        </button>
        <div class="thumbs" aria-label="Галерея товару">
          <button type="button" class="active" data-src="/images/v5/product-1.webp" data-alt="Душова скляна перегородка із прозорого скла"><img src="/images/v5/product-1.webp" alt="Душова скляна перегородка — загальний вигляд" /></button>
          <button type="button" data-src="/images/v5/project-1.webp" data-alt="Скляна перегородка для душу в сучасній ванній"><img src="/images/v5/project-1.webp" alt="Скляна перегородка для душу в інтер’єрі" /></button>
          <button type="button" data-src="/images/v5/project-2.webp" data-alt="Душова перегородка зі скла на замовлення"><img src="/images/v5/project-2.webp" alt="Душова перегородка зі скла на замовлення" /></button>
          <button class="video-thumb" type="button" aria-label="Відео з реалізованого об’єкта">▶ <span>Відео</span></button>
        </div>
      </div>

      <aside class="buy-box">
        <div class="buy-box__top">
          <p class="lead">Прозора й візуально легка душова зона без стандартних розмірних обмежень.</p>
          <button id="wishlist" class="wishlist" type="button" aria-pressed="false" data-wishlist-product data-product-id="SG-00001" data-product-title="Душова скляна перегородка" data-product-href="/catalog/dushova-perehorodka-walk-in-black/" data-product-image="/images/v5/product-1.webp" data-product-price="від 12 900 ₴"><span data-wishlist-icon>♡</span><b data-wishlist-text>В обране</b></button>
        </div>

        <div class="product-facts" aria-label="Основна інформація про товар">
          <div><span>Артикул</span><strong>SG-00001</strong></div>
          <div><span>Виготовлення</span><strong>За індивідуальним розміром</strong></div>
          <div><span>Власне виробництво</span><strong>Space Glass, Україна</strong></div>
          <div><span>Доставка</span><strong>По Україні</strong></div>
          <div><span>Гарантія</span><strong>2 роки</strong></div>
        </div>

        <div class="price"><small>Орієнтовна ціна від</small><strong>12 900 ₴</strong><p>Попередня вартість для базової комплектації. Точну ціну визначаємо після розмірів, вибору скла, фурнітури та умов монтажу.</p></div>

        <div class="quick-specs">
          <div><span>Скло</span><strong>Загартоване ESG</strong></div>
          <div><span>Товщина</span><strong>8 / 10 мм</strong></div>
          <div><span>Колір скла</span><strong>Прозоре / Satin / сіре / бронза</strong></div>
          <div><span>Фурнітура</span><strong>Black / Chrome / Brushed</strong></div>
        </div>

        <a href="#configurator" class="primary">Розрахувати конструкцію →</a>
      </aside>
    </section>

    <section id="configurator" class="section configurator">
      <div class="section-head section-head--compact">
        <p class="eyebrow">Конфігуратор</p>
        <h2>Зберіть свою душову перегородку</h2>
        <p>Вкажіть базові параметри. Конфігуратор дає орієнтовну вартість, а фінальну комплектацію підтвердимо після технічної перевірки розмірів і вузлів кріплення.</p>
      </div>
      <div class="config-grid">
        <label>Ширина, мм<input id="cfg-width" type="number" value="900" min="500" max="1800" step="10" /></label>
        <label>Висота, мм<input id="cfg-height" type="number" value="2000" min="1600" max="2600" step="10" /></label>
        <label>Товщина скла<select id="cfg-thickness"><option value="8">8 мм</option><option value="10">10 мм</option></select></label>
        <label>Колір скла<select id="cfg-glass"><option value="clear">Прозоре</option><option value="satin">Satin / матове</option><option value="gray">Тоноване сіре</option><option value="bronze">Тоноване бронза</option></select></label>
        <label>Фурнітура<select id="cfg-hardware"><option value="black">Чорна матова</option><option value="chrome">Хром</option><option value="brushed">Брашована сталь</option><option value="gold">Золото</option><option value="custom">Індивідуальний колір</option></select></label>
        <label>Кріплення<select id="cfg-mount"><option value="profile">Профіль</option><option value="connectors">Точкові конектори</option></select></label>
        <label>Стабілізатор<select id="cfg-stabilizer"><option value="yes">Потрібен</option><option value="no">Не потрібен</option></select></label>
        <label>Душовий піддон<select id="cfg-tray"><option value="none">Без піддона</option><option value="stone">Штучний камінь</option><option value="acrylic">Акриловий</option></select></label>
        <label>Монтаж<select id="cfg-install"><option value="yes">Потрібен</option><option value="no">Без монтажу</option></select></label>
        <label>Місто<input id="cfg-city" type="text" placeholder="Наприклад, Київ" /></label>
      </div>
      <div class="config-result"><button id="cfg-calc" type="button">Показати орієнтовну ціну</button><div><strong id="cfg-result">від 12 900 ₴</strong><small>Не є публічною офертою. Фінальну ціну підтвердимо після технічної перевірки.</small></div></div>
    </section>

    <section class="section product-copy">
      <div class="section-head section-head--compact"><p class="eyebrow">Про продукт</p><h2>Скляна перегородка для душу на замовлення</h2></div>
      <div class="copy-grid">
        <div><p>Душова скляна перегородка відокремлює мокру зону та захищає ванну кімнату від бризок, не перевантажуючи простір. Стаціонарне скляне полотно добре підходить для сучасних душових зон, walk-in рішень, монтажу на плитку або душовий піддон.</p><p>Кожну перегородку виготовляємо за індивідуальними розмірами. Перед виробництвом перевіряємо ширину й висоту, товщину загартованого скла, спосіб кріплення, потребу у стабілізаторі, геометрію стін та сумісність із піддоном.</p></div>
        <div><p>Для візуального оформлення можна обрати прозоре, матове Satin, сіре або бронзове тоноване скло. Фурнітура доступна в чорному, хромованому, брашованому та інших виконаннях залежно від системи.</p><p>Якщо потрібна готова душова зона, до перегородки можна додати піддон, замір і професійний монтаж. Доставку готових конструкцій організовуємо по Україні.</p></div>
      </div>
      <div class="benefit-grid"><article><b>Індивідуальні розміри</b><span>Виготовлення під конкретну душову зону</span></article><article><b>Безпечне скло</b><span>Загартоване ESG 8 або 10 мм</span></article><article><b>Вибір дизайну</b><span>Колір скла, фурнітура та кріплення</span></article><article><b>Комплексне рішення</b><span>Піддон, замір, доставка та монтаж</span></article></div>
    </section>

    <section class="section projects">
      <div class="section-head section-head--compact"><p class="eyebrow">Реальні об’єкти</p><h2>Як виглядає душова перегородка після монтажу</h2><p>Фотографії допомагають оцінити пропорції, прозорість скла та вигляд фурнітури в реальному інтер’єрі. Пізніше ці фото замінимо на конкретні реалізовані об’єкти Space Glass.</p></div>
      <div class="project-grid"><figure><img src="/images/v5/product-1.webp" alt="Душова скляна перегородка з прозорого скла" loading="lazy" /><figcaption>Прозоре скло · мінімалістична душова зона</figcaption></figure><figure><img src="/images/v5/project-1.webp" alt="Скляна перегородка для душу з чорною фурнітурою" loading="lazy" /><figcaption>Чорна фурнітура · індивідуальний розмір</figcaption></figure><figure><img src="/images/v5/project-2.webp" alt="Душова перегородка зі скла в сучасній ванній" loading="lazy" /><figcaption>Виготовлення під інтер’єр</figcaption></figure></div>
    </section>

    <GoogleReviews />

    <section class="section together">
      <div class="section-head section-head--compact"><p class="eyebrow">Комплект</p><h2>Разом з душовою перегородкою замовляють</h2><p>Комплектуючі та послуги, які допомагають зібрати завершену душову зону без пошуку сумісних елементів у різних постачальників.</p></div>
      <div class="mini-grid">
        <a href="/catalog/dushovi-piddony/"><img src="/images/s20/product-detail.webp" alt="Душовий піддон для скляної перегородки" loading="lazy" /><small>Душові піддони</small><h3>Душовий піддон</h3><p>Підбираємо під розмір та геометрію душової зони.</p><strong>Підібрати →</strong></a>
        <a href="/catalog/"><img src="/images/s20/product-interior.webp" alt="Стабілізуюча штанга для душової перегородки" loading="lazy" /><small>Комплектуючі</small><h3>Стабілізуюча штанга</h3><p>Підвищує жорсткість великих скляних полотен.</p><strong>Переглянути →</strong></a>
        <a href="/dzerkala/"><img src="/images/v5/project-1.webp" alt="Дзеркало на замовлення для ванної кімнати" loading="lazy" /><small>Для ванної</small><h3>Дзеркало на замовлення</h3><p>Під розмір і стиль ванної кімнати.</p><strong>Переглянути →</strong></a>
        <a href="#quote"><img src="/images/v5/project-2.webp" alt="Професійний замір та монтаж душової перегородки" loading="lazy" /><small>Сервіс</small><h3>Замір і монтаж</h3><p>Перевірка геометрії, підготовка та встановлення.</p><strong>Розрахувати →</strong></a>
      </div>
    </section>

    <section class="section specs">
      <div class="section-head section-head--compact"><p class="eyebrow">Характеристики</p><h2>Технічні параметри душової перегородки</h2><p>Фінальні параметри визначаються після перевірки розмірів, геометрії стін і обраного способу монтажу.</p></div>
      <div class="spec-layout">
        <dl class="spec-table">
          <div><dt>Артикул</dt><dd>SG-00001</dd></div>
          <div><dt>Тип конструкції</dt><dd>Стаціонарна душова перегородка</dd></div>
          <div><dt>Скло</dt><dd>Загартоване ESG</dd></div>
          <div><dt>Товщина скла</dt><dd>8 або 10 мм</dd></div>
          <div><dt>Колір скла</dt><dd>Прозоре / Satin / сіре / бронза</dd></div>
          <div><dt>Фурнітура</dt><dd>Чорна / хром / брашована / індивідуальна</dd></div>
          <div><dt>Розміри</dt><dd>Індивідуальні</dd></div>
          <div><dt>Піддон</dt><dd>З піддоном або без</dd></div>
          <div><dt>Доставка</dt><dd>По Україні</dd></div>
          <div><dt>Гарантія</dt><dd>2 роки</dd></div>
        </dl>
        <div class="docs"><p class="eyebrow">Документація</p><a href="#quote"><span>PDF</span><b>Схема правильного заміру</b><i>↗</i></a><a href="#quote"><span>PDF</span><b>Інструкція з догляду за склом</b><i>↗</i></a><a href="#quote"><span>INFO</span><b>Умови гарантії та монтажу</b><i>↗</i></a></div>
      </div>
    </section>

    <section class="section related">
      <div class="section-head section-head--compact"><p class="eyebrow">Інші рішення</p><h2>Схожі душові конструкції</h2><p>Якщо потрібні двері, кутова форма або інший спосіб відкривання, перегляньте інші душові рішення Space Glass.</p></div>
      <div class="related-grid"><a href="/dushovi-kabiny/"><img src="/images/v5/product-3.webp" alt="Кутова скляна душова кабіна" loading="lazy"/><h3>Кутова душова</h3><span>Переглянути →</span></a><a href="/dushovi-kabiny/"><img src="/images/v5/product-5.webp" alt="Скляні двері для душової ніші" loading="lazy"/><h3>Душова в нішу</h3><span>Переглянути →</span></a><a href="/dushovi-kabiny/"><img src="/images/v5/product-2.webp" alt="Душова перегородка з хромованою фурнітурою" loading="lazy"/><h3>Перегородка Chrome</h3><span>Переглянути →</span></a></div>
