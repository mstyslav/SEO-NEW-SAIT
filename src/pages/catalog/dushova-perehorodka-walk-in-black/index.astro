---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FAQBlock from '../../../components/FAQBlock.astro';

const faq = [
  ['Від чого залежить ціна Walk-In перегородки?', 'Від ширини та висоти скла, товщини, типу скла, фурнітури, способу кріплення, доставки та монтажу.'],
  ['Чи можна виготовити перегородку за моїми розмірами?', 'Так. Конструкцію виготовляємо індивідуально після перевірки розмірів або професійного заміру.'],
  ['Яке скло використовується?', 'Для Walk-In використовуємо безпечне загартоване скло ESG відповідної товщини.'],
  ['Яку товщину скла обрати — 8 чи 10 мм?', 'Товщину підбираємо за габаритами, способом кріплення та жорсткістю конструкції.'],
  ['Чи можна обрати чорну фурнітуру?', 'Так. Доступні чорна матова, хром та інші варіанти залежно від системи.'],
  ['Чи можливе матове або тоноване скло?', 'Так, доступні прозоре, Satin, тоноване та інші декоративні варіанти.'],
  ['Чи потрібен професійний замір?', 'Для індивідуальної конструкції професійний замір рекомендований.'],
  ['Чи виконуєте монтаж?', 'Так, професійний монтаж доступний у регіонах обслуговування Space Glass.'],
  ['Чи є доставка по Україні?', 'Так, організовуємо доставку по Україні.'],
  ['Який строк виготовлення?', 'Строк залежить від комплектації, скла, фурнітури та завантаження виробництва.'],
  ['Чи є гарантія?', 'Так, для цієї конструкції передбачена гарантія 2 роки за умовами замовлення.'],
  ['Чи можна замовити тільки скло без монтажу?', 'Так, для частини замовлень можливе виготовлення та доставка без монтажу.'],
  ['Чи можна встановити Walk-In на душовий піддон?', 'Так, конструкція може бути адаптована під душовий піддон або монтаж безпосередньо на підлогу.'],
  ['Як доглядати за склом?', 'Рекомендуємо м’які неабразивні засоби та регулярне видалення води зі скла.'],
  ['Чи можна зробити нестандартну форму?', 'Так, нестандартні рішення розглядаємо індивідуально після креслення або заміру.'],
  ['Чи можна додати стабілізуючу штангу?', 'Так. Тип і розташування стабілізатора підбираємо під конструкцію.'],
  ['Чи працюєте з дизайнерами й архітекторами?', 'Так, можемо працювати за кресленнями та специфікаціями.'],
  ['Що потрібно для попереднього розрахунку?', 'Надішліть ширину, висоту, фото місця монтажу, місто та бажану комплектацію.'],
  ['Чи можна підібрати душовий піддон разом із перегородкою?', 'Так. Підберемо піддон за розміром і геометрією Walk-In, щоб вузол працював як єдина система.'],
  ['Як оформити замовлення?', 'Натисніть «Отримати розрахунок» і надішліть параметри — після технічного уточнення підготуємо пропозицію.']
];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Душова перегородка Walk-In Black',
  sku: 'SG-WI-BL-001',
  brand: { '@type': 'Brand', name: 'Space Glass' },
  description: 'Безрамна душова перегородка Walk-In Black із загартованого скла, індивідуальне виготовлення.',
  image: ['/images/v5/product-1.webp'],
  category: 'Душові кабіни',
  offers: {
    '@type': 'Offer',
    priceCurrency: 'UAH',
    price: '12900',
    availability: 'https://schema.org/PreOrder',
    url: 'https://space-glass.com.ua/catalog/dushova-perehorodka-walk-in-black/'
  }
};
---
<BaseLayout title="Душова перегородка Walk-In Black на замовлення | Space Glass" description="Душова перегородка Walk-In Black із загартованого скла 8–10 мм. Індивідуальні розміри, доставка по Україні, професійний монтаж." image="/images/v5/product-1.webp" structuredData={productSchema}>
<div class="sg-page-shell">
  <Header />
  <main id="main" class="product-page">
    <nav class="breadcrumbs" aria-label="Навігація"><a href="/">Головна</a><span>›</span><a href="/dushovi-kabiny/">Душові кабіни</a><span>›</span><span>Walk-In Black</span></nav>

    <header class="product-title-block">
      <p class="eyebrow">Душові кабіни · Walk-In</p>
      <h1>Душова перегородка Walk-In Black</h1>
    </header>

    <section class="product-main">
      <div class="gallery" data-gallery>
        <button class="main-photo" type="button" data-gallery-open aria-label="Відкрити велике фото">
          <img src="/images/v5/product-1.webp" alt="Душова перегородка Walk-In Black із загартованого прозорого скла" width="1200" height="820" fetchpriority="high" />
          <span class="badge">На замовлення</span>
          <span class="photo-hint">Натисніть, щоб відкрити фото</span>
        </button>
        <div class="thumbs" aria-label="Галерея товару">
          <button type="button" class="active" data-src="/images/v5/product-1.webp" data-alt="Walk-In Black — загальний вигляд"><img src="/images/v5/product-1.webp" alt="" /></button>
          <button type="button" data-src="/images/v5/project-1.webp" data-alt="Walk-In перегородка у ванній кімнаті"><img src="/images/v5/project-1.webp" alt="" /></button>
          <button type="button" data-src="/images/v5/project-2.webp" data-alt="Скляна конструкція Space Glass в інтер’єрі"><img src="/images/v5/project-2.webp" alt="" /></button>
          <button class="video-thumb" type="button" aria-label="Відео з об’єкта">▶ <span>Відео</span></button>
        </div>
      </div>

      <aside class="buy-box">
        <div class="buy-box__top">
          <p class="lead">Безрамна душова перегородка із безпечного загартованого скла для сучасної ванної кімнати.</p>
          <button id="wishlist" class="wishlist" type="button" aria-pressed="false"><span>♡</span><b>В обране</b></button>
        </div>

        <div class="product-facts" aria-label="Основна інформація про товар">
          <div><span>Артикул</span><strong>SG-WI-BL-001</strong></div>
          <div><span>Виготовлення</span><strong>Під ваш розмір</strong></div>
          <div><span>Виробництво</span><strong>Space Glass, Україна</strong></div>
          <div><span>Доставка</span><strong>По Україні</strong></div>
          <div><span>Гарантія</span><strong>2 роки</strong></div>
        </div>

        <div class="price"><small>Орієнтовна ціна від</small><strong>12 900 ₴</strong><p>Точна вартість залежить від розмірів, скла, фурнітури та монтажу.</p></div>

        <div class="quick-specs">
          <div><span>Скло</span><strong>ESG 8 / 10 мм</strong></div>
          <div><span>Фурнітура</span><strong>Black / Chrome</strong></div>
          <div><span>Розмір</span><strong>Індивідуальний</strong></div>
          <div><span>Монтаж</span><strong>Доступний</strong></div>
        </div>

        <a href="#configurator" class="primary">Розрахувати конструкцію →</a>
      </aside>
    </section>

    <section id="configurator" class="section configurator">
      <div class="section-head section-head--compact">
        <p class="eyebrow">Конфігуратор</p>
        <h2>Зберіть свою Walk-In перегородку</h2>
        <p>Оберіть базові параметри конструкції. Результат нижче — попередня оцінка; фінальну комплектацію та ціну підтвердимо після технічної перевірки.</p>
      </div>
      <div class="config-grid">
        <label>Ширина, мм<input id="cfg-width" type="number" value="1200" min="400" max="2500" step="10" /></label>
        <label>Висота, мм<input id="cfg-height" type="number" value="2000" min="1200" max="2600" step="10" /></label>
        <label>Товщина скла<select id="cfg-thickness"><option value="8">8 мм</option><option value="10">10 мм</option></select></label>
        <label>Тип скла<select id="cfg-glass"><option value="clear">Прозоре ESG</option><option value="satin">Satin</option><option value="tinted">Тоноване</option></select></label>
        <label>Фурнітура<select id="cfg-hardware"><option value="black">Чорна матова</option><option value="chrome">Хром</option><option value="graphite">Графіт</option></select></label>
        <label>Стабілізатор<select id="cfg-stabilizer"><option value="yes">Потрібен</option><option value="no">Не потрібен</option></select></label>
        <label>Душовий піддон<select id="cfg-tray"><option value="none">Без піддона</option><option value="stone">Штучний камінь</option><option value="acrylic">Акриловий</option></select></label>
        <label>Монтаж<select id="cfg-install"><option value="yes">Потрібен</option><option value="no">Без монтажу</option></select></label>
        <label>Місто<input id="cfg-city" type="text" placeholder="Наприклад, Київ" /></label>
      </div>
      <div class="config-result"><button id="cfg-calc" type="button">Показати орієнтовну ціну</button><div><strong id="cfg-result">від 12 900 ₴</strong><small>Фінальну ціну підтвердимо після технічної перевірки.</small></div></div>
    </section>

    <section class="section projects">
      <div class="section-head section-head--compact"><p class="eyebrow">Реальні об’єкти</p><h2>Як Walk-In виглядає після монтажу</h2><p>Приклади виконаних конструкцій допомагають оцінити пропорції, колір фурнітури та вигляд скла в реальному інтер’єрі.</p></div>
      <div class="project-grid"><figure><img src="/images/v5/project-1.webp" alt="Walk-In перегородка після монтажу" loading="lazy" /><figcaption>Прозоре скло · чорна фурнітура</figcaption></figure><figure><img src="/images/v5/project-2.webp" alt="Скляна душова конструкція Space Glass" loading="lazy" /><figcaption>Індивідуальне виготовлення</figcaption></figure><button class="video-card" type="button"><span>▶</span><b>Відео з об’єкта</b><small>Відео завантажуватиметься тільки після натискання.</small></button></div>
    </section>

    <section class="section together">
      <div class="section-head section-head--compact"><p class="eyebrow">Комплект</p><h2>Разом з цим рішенням замовляють</h2><p>Не альтернативи, а речі й послуги, які доповнюють саме цю душову конструкцію та допомагають зібрати завершений комплект.</p></div>
      <div class="mini-grid">
        <a href="/catalog/dushovi-piddony/"><img src="/images/s20/product-detail.webp" alt="Душовий піддон для Walk-In" loading="lazy" /><small>Душові піддони</small><h3>Душовий піддон</h3><p>Підбираємо під розмір та геометрію Walk-In.</p><strong>Підібрати →</strong></a>
        <a href="/catalog/"><img src="/images/s20/product-interior.webp" alt="Стабілізуюча штанга для Walk-In" loading="lazy" /><small>Комплектуючі</small><h3>Стабілізуюча штанга</h3><p>Додає жорсткості великому полотну.</p><strong>Переглянути →</strong></a>
        <a href="/dzerkala/"><img src="/images/v5/project-1.webp" alt="Дзеркало на замовлення для ванної" loading="lazy" /><small>Для ванної</small><h3>Дзеркало на замовлення</h3><p>Під розмір і стиль ванної кімнати.</p><strong>Переглянути →</strong></a>
        <a href="#quote"><img src="/images/v5/project-2.webp" alt="Замір і монтаж скляної конструкції" loading="lazy" /><small>Сервіс</small><h3>Замір і монтаж</h3><p>Професійна підготовка та встановлення.</p><strong>Розрахувати →</strong></a>
      </div>
    </section>

    <section class="section specs">
      <div class="section-head section-head--compact"><p class="eyebrow">Характеристики</p><h2>Технічні параметри</h2><p>Фінальна комплектація підтверджується після перевірки розмірів та умов монтажу.</p></div>
      <div class="spec-layout">
        <dl class="spec-table">
          <div><dt>Тип конструкції</dt><dd>Безрамна Walk-In</dd></div>
          <div><dt>Скло</dt><dd>Загартоване ESG</dd></div>
          <div><dt>Товщина скла</dt><dd>8 або 10 мм</dd></div>
          <div><dt>Колір скла</dt><dd>Прозоре / Satin / тоноване</dd></div>
          <div><dt>Фурнітура</dt><dd>Чорна / хром / графіт</dd></div>
          <div><dt>Розміри</dt><dd>Індивідуальні</dd></div>
          <div><dt>Доставка</dt><dd>По Україні</dd></div>
          <div><dt>Гарантія</dt><dd>2 роки</dd></div>
        </dl>
        <div class="docs"><p class="eyebrow">Документація</p><a href="#quote"><span>SVG</span><b>Схема заміру</b><i>↗</i></a><a href="#quote"><span>PDF</span><b>Інструкція з догляду</b><i>↗</i></a></div>
      </div>
    </section>

    <section class="section seo-copy">
      <div class="section-head section-head--compact"><p class="eyebrow">Про продукт</p><h2>Безрамна душова перегородка Walk-In на замовлення</h2></div>
      <div class="seo-grid"><div><p>Walk-In Black — мінімалістичне рішення без дверей для сучасної душової зони. Прозоре загартоване скло зберігає світло та відчуття відкритості, а чорна фурнітура додає виразний архітектурний акцент.</p><p>Кожну перегородку виготовляємо за індивідуальними розмірами. Перед виробництвом перевіряємо габарити, спосіб кріплення, товщину скла, потребу в стабілізаторі та сумісність із душовим піддоном.</p></div><nav aria-label="Корисні посилання"><a href="/dushovi-kabiny/">Усі душові кабіни →</a><a href="/catalog/dushovi-piddony/">Душові піддони →</a><a href="/poslugy/dushovi-konstruktsii/">Душові конструкції на замовлення →</a><a href="/projects/">Реалізовані проєкти →</a></nav></div>
    </section>

    <section class="section related">
      <div class="section-head section-head--compact"><p class="eyebrow">Альтернативи</p><h2>Схожі рішення</h2><p>Інші конфігурації душових конструкцій, якщо потрібен інший спосіб відкривання, форма або візуальний ефект.</p></div>
      <div class="related-grid"><a href="/dushovi-kabiny/"><img src="/images/v5/product-3.webp" alt="Кутова душова кабіна" loading="lazy"/><h3>Кутова душова</h3><span>Переглянути →</span></a><a href="/dushovi-kabiny/"><img src="/images/v5/product-5.webp" alt="Душова в нішу" loading="lazy"/><h3>Душова в нішу</h3><span>Переглянути →</span></a><a href="/dushovi-kabiny/"><img src="/images/v5/product-2.webp" alt="Walk-In з іншою фурнітурою" loading="lazy"/><h3>Walk-In Chrome</h3><span>Переглянути →</span></a></div>
    </section>

    <section class="section faq-wrap"><FAQBlock title="FAQ про душові Walk-In" intro="Відповідаємо на основні питання про ціну, скло, піддон, замір, виготовлення, доставку, монтаж і гарантію." items={faq} visibleCount={6} /></section>

    <section id="quote" class="quote"><div><p class="eyebrow">Розрахунок</p><h2>Потрібна така конструкція?</h2><p>Надішліть фото або розміри — підготуємо попередню комплектацію та вартість.</p></div><a href="/quote/">Отримати розрахунок →</a></section>
  </main>
  <Footer />
</div>

<dialog class="lightbox" id="product-lightbox"><button type="button" aria-label="Закрити">×</button><img src="/images/v5/product-1.webp" alt="Душова перегородка Walk-In Black" /></dialog>
</BaseLayout>

<style>
.product-page{--ink:#14201d;--muted:#66736f;--line:#dce7e3;--mint:#7fd7bd;--deep:#0e4f3d;max-width:1380px;margin:0 auto;background:#fff;color:var(--ink)}.breadcrumbs{padding:24px 34px 0;display:flex;gap:9px;font-size:13px;color:var(--muted)}.breadcrumbs a{color:inherit}.product-title-block{padding:34px 34px 24px;max-width:980px}.eyebrow{text-transform:uppercase;letter-spacing:.18em;font-size:11px;font-weight:800;color:#176b55}.product-title-block h1{font-size:clamp(38px,5vw,64px);line-height:.98;letter-spacing:-.045em;margin:9px 0 0}.product-main{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(360px,.8fr);gap:34px;padding:0 34px 58px}.main-photo{position:relative;width:100%;border:0;padding:0;background:#edf3f1;aspect-ratio:16/11;overflow:hidden;cursor:zoom-in}.main-photo img{width:100%;height:100%;object-fit:cover;display:block;transition:none!important;transform:none!important}.badge{position:absolute;top:16px;left:16px;background:#103e32;color:#fff;padding:8px 11px;border-radius:999px;font-size:11px;text-transform:uppercase;letter-spacing:.08em}.photo-hint{position:absolute;right:14px;bottom:14px;background:rgba(10,33,27,.78);color:white;padding:8px 10px;border-radius:8px;font-size:11px}.thumbs{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:9px}.thumbs button{border:1px solid var(--line);padding:0;background:white;aspect-ratio:4/3;overflow:hidden}.thumbs button.active{border-color:#1a725b}.thumbs img{width:100%;height:100%;object-fit:cover}.video-thumb{display:grid;place-items:center;color:#0e4f3d;font-weight:800}.video-thumb span{font-size:11px}.buy-box{border:1px solid var(--line);padding:24px;align-self:start;position:sticky;top:90px}.buy-box__top{display:grid;grid-template-columns:1fr auto;gap:18px;align-items:start}.lead{font-size:18px;line-height:1.5;margin:0;color:#33413d}.wishlist{border:1px solid var(--line);background:white;border-radius:999px;padding:10px 13px;display:flex;align-items:center;gap:7px;color:var(--ink);curso