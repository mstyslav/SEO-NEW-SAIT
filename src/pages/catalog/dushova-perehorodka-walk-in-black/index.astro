---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const faq = [
  ['Від чого залежить ціна Walk-In перегородки?', 'Від ширини та висоти скла, товщини, типу скла, кольору фурнітури, способу кріплення, доставки та монтажу.'],
  ['Чи можна виготовити перегородку за моїми розмірами?', 'Так. Конструкцію виготовляємо індивідуально після перевірки розмірів або професійного заміру.'],
  ['Яке скло використовується?', 'Для Walk-In використовуємо безпечне загартоване скло ESG відповідної товщини.'],
  ['Яку товщину скла обрати — 8 чи 10 мм?', 'Товщину підбираємо за габаритами, способом кріплення та жорсткістю конструкції.'],
  ['Чи можна обрати чорну фурнітуру?', 'Так. Доступні чорна матова та інші варіанти виконання.'],
  ['Чи можливе матове або тоноване скло?', 'Так, доступні прозоре, Satin, тоноване та інші декоративні варіанти.'],
  ['Чи потрібен професійний замір?', 'Для індивідуальної конструкції професійний замір рекомендований.'],
  ['Чи виконуєте монтаж?', 'Так, професійний монтаж доступний у регіонах обслуговування Space Glass.'],
  ['Чи є доставка по Україні?', 'Так, організовуємо доставку по Україні.'],
  ['Чи доставляєте до Європи?', 'Так, для частини конструкцій доступна доставка до країн Європи.'],
  ['Який строк виготовлення?', 'Строк залежить від комплектації, скла, фурнітури та завантаження виробництва.'],
  ['Чи є гарантія?', 'Так, гарантійні умови зазначаються в замовленні.'],
  ['Чи можна замовити тільки скло без монтажу?', 'Так, для частини замовлень можливе виготовлення та доставка без монтажу.'],
  ['Чи можна встановити Walk-In на піддон?', 'Так, конструкція може бути адаптована під піддон або монтаж на підлогу.'],
  ['Як доглядати за склом?', 'Рекомендуємо м’які неабразивні засоби та регулярне видалення води зі скла.'],
  ['Чи можна зробити нестандартну форму?', 'Так, нестандартні рішення розглядаємо індивідуально після креслення або заміру.'],
  ['Чи можна додати стабілізуючу штангу?', 'Так. Тип і розташування стабілізатора підбираємо під конструкцію.'],
  ['Чи працюєте з дизайнерами й архітекторами?', 'Так, можемо працювати за кресленнями та специфікаціями.'],
  ['Що потрібно для попереднього розрахунку?', 'Надішліть ширину, висоту, фото місця монтажу, місто та бажану комплектацію.'],
  ['Як оформити замовлення?', 'Натисніть «Отримати розрахунок» і надішліть параметри — після технічного уточнення підготуємо пропозицію.']
];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Душова перегородка Walk-In Black',
  sku: 'SG-WI-BL-001',
  brand: { '@type': 'Brand', name: 'Space Glass' },
  description: 'Безрамна душова перегородка Walk-In Black із загартованого скла, індивідуальне виготовлення.',
  image: ['/images/v5/product-1.webp'],
  category: 'Душові кабіни',
  offers: { '@type': 'Offer', priceCurrency: 'UAH', price: '12900', availability: 'https://schema.org/PreOrder', url: 'https://space-glass.com.ua/catalog/dushova-perehorodka-walk-in-black/' }
};
---
<BaseLayout title="Душова перегородка Walk-In Black на замовлення | Space Glass" description="Душова перегородка Walk-In Black із загартованого скла 8–10 мм. Індивідуальні розміри, доставка по Україні та Європі, професійний монтаж." image="/images/v5/product-1.webp" structuredData={productSchema}>
<div class="sg-page-shell">
  <Header />
  <main id="main" class="product-page">
    <nav class="breadcrumbs" aria-label="Навігація"><a href="/">Головна</a><span>›</span><a href="/dushovi-kabiny/">Душові кабіни</a><span>›</span><span>Walk-In Black</span></nav>

    <header class="product-title-block">
      <p class="eyebrow">Душові кабіни · Walk-In</p>
      <h1>Душова перегородка Walk-In Black</h1>
      <div class="title-meta"><span>SKU: <strong>SG-WI-BL-001</strong></span><span>Виготовлення під розмір</span><span>Space Glass</span></div>
    </header>

    <section class="product-main">
      <div class="gallery">
        <div class="main-photo">
          <img src="/images/v5/product-1.webp" alt="Душова перегородка Walk-In Black із загартованого прозорого скла" width="1100" height="760" fetchpriority="high" />
          <span class="badge">На замовлення</span>
          <button id="wishlist" class="wishlist" type="button" aria-pressed="false" aria-label="Додати товар в обране">♡</button>
        </div>
        <div class="thumbs">
          <button type="button" class="active"><img src="/images/v5/product-1.webp" alt="Walk-In Black — загальний вигляд" /></button>
          <button type="button"><img src="/images/v5/project-1.webp" alt="Walk-In перегородка у ванній кімнаті" /></button>
          <button type="button"><img src="/images/v5/project-2.webp" alt="Приклад скляної конструкції Space Glass" /></button>
          <button class="video-thumb" type="button" aria-label="Відео з об’єкта">▶ <span>Відео</span></button>
        </div>
      </div>

      <aside class="buy-box">
        <p class="lead">Безрамна душова перегородка із безпечного загартованого скла для сучасної ванної кімнати.</p>
        <div class="price"><small>Орієнтовна ціна від</small><strong>12 900 ₴</strong><p>Точна вартість залежить від розмірів, скла, фурнітури, доставки та монтажу.</p></div>
        <div class="quick-specs">
          <div><span>Скло</span><strong>ESG 8 / 10 мм</strong></div>
          <div><span>Фурнітура</span><strong>Black / Chrome</strong></div>
          <div><span>Розмір</span><strong>Індивідуальний</strong></div>
          <div><span>Монтаж</span><strong>Доступний</strong></div>
        </div>
        <a href="#configurator" class="primary">Розрахувати конструкцію →</a>
        <button id="wishlist-secondary" type="button" class="secondary">♡ Додати в обране</button>
        <div class="trust"><span>Власне виробництво</span><span>Доставка UA + EU</span><span>Гарантія 2 роки</span></div>
      </aside>
    </section>

    <section id="configurator" class="section configurator">
      <div class="section-head"><p class="eyebrow">Конфігуратор</p><h2>Зберіть свою Walk-In перегородку</h2><p>Параметри дають попередню оцінку. Остаточну ціну підтверджуємо після технічної перевірки.</p></div>
      <div class="config-grid">
        <label>Ширина, мм<input id="cfg-width" type="number" value="1200" min="400" max="2500" step="10" /></label>
        <label>Висота, мм<input id="cfg-height" type="number" value="2000" min="1200" max="2600" step="10" /></label>
        <label>Товщина скла<select id="cfg-thickness"><option value="8">8 мм</option><option value="10">10 мм</option></select></label>
        <label>Тип скла<select id="cfg-glass"><option value="clear">Прозоре ESG</option><option value="satin">Satin</option><option value="tinted">Тоноване</option></select></label>
        <label>Колір фурнітури<select id="cfg-hardware"><option value="black">Чорна матова</option><option value="chrome">Хром</option></select></label>
        <label>Стабілізатор<select id="cfg-stabilizer"><option value="yes">Так</option><option value="no">Ні</option></select></label>
        <label>Монтаж<select id="cfg-install"><option value="yes">Потрібен</option><option value="no">Без монтажу</option></select></label>
        <label>Доставка<select id="cfg-delivery"><option value="ua">Україна</option><option value="eu">Європа</option><option value="pickup">Самовивіз</option></select></label>
      </div>
      <div class="config-result"><button id="cfg-calc" type="button">Показати орієнтовну ціну</button><div><strong id="cfg-result">від 12 900 ₴</strong><small>Не є публічною офертою</small></div></div>
    </section>

    <section class="section projects">
      <div class="section-head"><p class="eyebrow">Реальні об’єкти</p><h2>Як Walk-In виглядає після монтажу</h2></div>
      <div class="project-grid"><figure><img src="/images/v5/project-1.webp" alt="Walk-In перегородка після монтажу" loading="lazy" /><figcaption>Прозоре скло · чорна фурнітура</figcaption></figure><figure><img src="/images/v5/project-2.webp" alt="Скляна душова конструкція Space Glass" loading="lazy" /><figcaption>Індивідуальне виготовлення</figcaption></figure><button class="video-card" type="button"><span>▶</span><b>Відео з об’єкта</b><small>Відео завантажуватиметься тільки після натискання.</small></button></div>
    </section>

    <section class="section together">
      <div class="section-head"><p class="eyebrow">Комплект</p><h2>Разом з цим рішенням замовляють</h2></div>
      <div class="mini-grid">
        <a href="/catalog/"><div class="mini-photo"></div><h3>Стабілізуюча штанга</h3><p>Для жорсткості конструкції</p><strong>від 1 200 ₴</strong></a>
        <a href="/catalog/"><div class="mini-photo"></div><h3>Скляна полиця</h3><p>Індивідуальний розмір</p><strong>від 1 800 ₴</strong></a>
        <a href="/dzerkala/"><div class="mini-photo"></div><h3>Дзеркало на замовлення</h3><p>Під стиль ванної кімнати</p><strong>від 2 900 ₴</strong></a>
        <a href="#quote"><div class="mini-photo service"></div><h3>Професійний монтаж</h3><p>Замір, доставка та монтаж</p><strong>Розрахувати →</strong></a>
      </div>
    </section>

    <section class="section specs">
      <div class="section-head"><p class="eyebrow">Характеристики</p><h2>Технічні параметри Walk-In Black</h2></div>
      <dl><div><dt>Тип конструкції</dt><dd>Безрамна Walk-In</dd></div><div><dt>Скло</dt><dd>Загартоване ESG</dd></div><div><dt>Товщина скла</dt><dd>8 або 10 мм</dd></div><div><dt>Колір скла</dt><dd>Прозоре / Satin / тоноване</dd></div><div><dt>Фурнітура</dt><dd>Чорна матова / хром</dd></div><div><dt>Розміри</dt><dd>Індивідуальні</dd></div><div><dt>Виробництво</dt><dd>Space Glass, Україна</dd></div><div><dt>Доставка</dt><dd>Україна та Європа</dd></div></dl>
    </section>

    <section class="section seo-copy"><div><p class="eyebrow">Про продукт</p><h2>Безрамна душова перегородка Walk-In на замовлення</h2><p>Walk-In Black — мінімалістичне рішення без дверей для сучасної душової зони. Конструкція візуально не перевантажує простір, а прозоре загартоване скло зберігає світло та відчуття відкритості.</p><p>Кожну перегородку виготовляємо за індивідуальними розмірами. Перед виробництвом перевіряємо габарити, спосіб кріплення, товщину скла та необхідність стабілізатора.</p></div><nav><a href="/dushovi-kabiny/">Усі душові кабіни →</a><a href="/rishennya/dlya-kvartyry/">Рішення для квартири →</a><a href="/projects/">Реалізовані проєкти →</a></nav></section>

    <section class="section related"><div class="section-head"><p class="eyebrow">Альтернативи</p><h2>Схожі рішення</h2></div><div class="mini-grid"><a href="/dushovi-kabiny/"><div class="mini-photo"></div><h3>Walk-In Clear</h3><p>Прозоре скло · хром</p></a><a href="/dushovi-kabiny/"><div class="mini-photo"></div><h3>Walk-In Bronze</h3><p>Тоноване скло</p></a><a href="/dushovi-kabiny/"><div class="mini-photo"></div><h3>Walk-In Satin</h3><p>Матове скло</p></a><a href="/dushovi-kabiny/"><div class="mini-photo"></div><h3>Walk-In з дверима</h3><p>Розпашне рішення</p></a></div></section>

    <section class="section faq-section"><div class="section-head"><p class="eyebrow">FAQ</p><h2>Часті питання</h2></div><div id="faq-list" class="faq-grid">{faq.slice(0,6).map(([q,a],i)=><details data-extra={i>=6 ? '1' : '0'}><summary>{q}</summary><p>{a}</p></details>)}</div><div id="faq-extra" class="faq-grid hidden">{faq.slice(6).map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div><button id="faq-more" class="faq-more" type="button">Показати всі 20 питань</button></section>

    <section id="quote" class="quote"><div><p class="eyebrow">Space Glass</p><h2>Потрібна така конструкція?</h2><p>Надішліть фото, розміри або креслення — підготуємо попередній розрахунок.</p></div><a href="/contact/">Отримати розрахунок →</a></section>
  </main>
  <Footer />
</div>
</BaseLayout>

<script>
const wishButtons=[document.getElementById('wishlist'),document.getElementById('wishlist-secondary')].filter(Boolean);
let wished=localStorage.getItem('sg-wish-SG-WI-BL-001')==='1';
function syncWish(){wishButtons.forEach((b)=>{b.setAttribute('aria-pressed',String(wished));b.textContent=wished?'♥ В обраному':'♡ Додати в обране';if(b.classList.contains('wishlist')) b.textContent=wished?'♥':'♡';});}
syncWish();wishButtons.forEach((b)=>b.addEventListener('click',()=>{wished=!wished;localStorage.setItem('sg-wish-SG-WI-BL-001',wished?'1':'0');syncWish();}));
const calc=document.getElementById('cfg-calc');calc?.addEventListener('click',()=>{const w=Number((document.getElementById('cfg-width')).value||1200);const h=Number((document.getElementById('cfg-height')).value||2000);const t=Number((document.getElementById('cfg-thickness')).value||8);const glass=(document.getElementById('cfg-glass')).value;const install=(document.getElementById('cfg-install')).value;let price=12900*(w/1200)*(h/2000);if(t===10)price*=1.14;if(glass==='satin')price*=1.12;if(glass==='tinted')price*=1.15;if(install==='yes')price+=2500;document.getElementById('cfg-result').textContent=`від ${Math.round(price/100)*100 .toLocaleString('uk-UA')} ₴`;});
const more=document.getElementById('faq-more');const extra=document.getElementById('faq-extra');more?.addEventListener('click',()=>{extra?.classList.toggle('hidden');more.textContent=extra?.classList.contains('hidden')?'Показати всі 20 питань':'Показати менше';});
</script>

<style>
.product-page{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;color:#18211e}.breadcrumbs,.product-title-block,.product-main,.section,.quote{max-width:1320px;margin-left:auto;margin-right:auto;padding-left:24px;padding-right:24px}.breadcrumbs{padding-top:26px;font-size:13px;color:#72807b;display:flex;gap:8px}.breadcrumbs a{color:inherit;text-decoration:none}.product-title-block{padding-top:30px;padding-bottom:24px}.eyebrow{color:#147b63;text-transform:uppercase;letter-spacing:.16em;font-size:12px;font-weight:800}.product-title-block h1{font-size:clamp(42px,5vw,64px);line-height:.98;letter-spacing:-.045em;margin:9px 0 15px;max-width:980px}.title-meta{display:flex;gap:20px;flex-wrap:wrap;color:#6d7874;font-size:13px}.product-main{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(360px,.65fr);gap:34px;padding-bottom:60px}.main-photo{position:relative;aspect-ratio:1.45/1;border-radius:18px;overflow:hidden;background:#eef3f1}.main-photo img{width:100%;height:100%;display:block;object-fit:cover}.badge{position:absolute;left:16px;top:16px;background:#11342d;color:#fff;border-radius:999px;padding:7px 10px;font-size:11px;text-transform:uppercase}.wishlist{position:absolute;right:16px;top:16px;width:44px;height:44px;border-radius:50%;border:1px solid #d8e1de;background:#fff;font-size:23px;cursor:pointer}.thumbs{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px}.thumbs button{border:1px solid #dfe6e3;border-radius:10px;overflow:hidden;background:#fff;aspect-ratio:1.4/1}.thumbs img{width:100%;height:100%;object-fit:cover}.video-thumb{font-weight:700;color:#124338}.video-thumb span{display:block;font-size:12px}.buy-box{border:1px solid #dfe6e3;border-radius:18px;padding:24px;align-self:start;position:sticky;top:90px}.lead{font-size:17px;line-height:1.55;color:#46534f}.price{border-top:1px solid #e4eae8;border-bottom:1px solid #e4eae8;padding:18px 0;margin:20px 0}.price small{display:block;color:#78827e;font-size:12px}.price strong{display:block;font-size:31px;letter-spacing:-.03em;margin:4px 0}.price p{font-size:12px;line-height:1.45;color:#7a8581;margin:0}.quick-specs{display:grid;grid-template-columns:1fr 1fr;gap:10px}.quick-specs div{background:#f7f9f8;border-radius:10px;padding:11px}.quick-specs span{display:block;font-size:11px;color:#78827e}.quick-specs strong{font-size:13px}.primary,.secondary{display:block;width:100%;box-sizing:border-box;text-align:center;border-radius:11px;padding:13px 16px;font-weight:800;text-decoration:none;margin-top:12px}.primary{background:#79cfb4;color:#10241e}.secondary{background:#fff;border:1px solid #cdd8d4;color:#17352d}.trust{display:grid;grid-template-columns:1fr;gap:7px;margin-top:16px;font-size:12px;color:#5f6b66}.section{padding-top:66px;padding-bottom:66px;border-top:1px solid #e8eeeb}.section-head{display:grid;grid-template-columns:170px minmax(0,720px);gap:20px;align-items:start;margin-bottom:28px}.section-head h2{font-size:clamp(32px,3.6vw,46px);line-height:1;letter-spacing:-.035em;margin:0}.section-head p:last-child{grid-column:2;color:#66716d;max-width:720px}.configurator{background:#f6f8f7;max-width:none;padding-left:max(24px,calc((100vw - 1320px)/2 + 24px));padding-right:max(24px,calc((100vw - 1320px)/2 + 24px))}.config-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.config-grid label{font-size:12px;color:#5d6964;font-weight:700}.config-grid input,.config-grid select{width:100%;box-sizing:border-box;margin-top:6px;padding:12px;border:1px solid #d3ddda;border-radius:10px;background:#fff;color:#18211e}.config-result{margin-top:18px;padding-top:18px;border-top:1px solid #dde5e2;display:flex;align-items:center;gap:18px}.config-result button{border:0;border-radius:10px;background:#79cfb4;padding:13px 18px;font-weight:800}.config-result strong{display:block;font-size:22px}.config-result small{display:block;color:#7a8581;font-size:11px}.project-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px}.project-grid