---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="Заявка на розрахунок скляної конструкції | Space Glass"
  description="Опишіть потрібну скляну конструкцію, вкажіть місто та приблизні розміри. Space Glass уточнить деталі й підготує попередній розрахунок."
>
  <Header />

  <main class="quote-page">
    <section class="quote-page__hero">
      <div class="container quote-page__hero-grid">
        <div>
          <p class="eyebrow">Заявка на розрахунок</p>
          <h1 data-quote-heading>Розрахуємо вашу конструкцію</h1>
          <p data-quote-intro>Вкажіть, що потрібно, додайте приблизні розміри та контакти. Менеджер уточнить технічні деталі й підготує попередню вартість.</p>
        </div>
        <div class="quote-page__steps">
          <span class="is-active">01 Завдання</span>
          <span>02 Контакти</span>
          <span>03 Розрахунок</span>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container quote-layout">
        <aside class="quote-summary quote-summary--guide" data-generic-quote>
          <p class="eyebrow">Що підготувати</p>
          <h2>Достатньо базової інформації</h2>
          <ol class="quote-guide">
            <li><b>Оберіть конструкцію</b><span>Наприклад: душова, перегородка, двері, дзеркало або огорожа.</span></li>
            <li><b>Опишіть розміри</b><span>Можна приблизно: ширина × висота, кількість секцій або розмір прорізу.</span></li>
            <li><b>Вкажіть місто</b><span>Це потрібно для розрахунку заміру, доставки та монтажу.</span></li>
          </ol>
          <p class="quote-summary__notice">Фото чи креслення не обов’язкові для першої заявки — за потреби менеджер підкаже, як їх надіслати. Остаточну вартість підтвердимо після технічної перевірки розмірів і умов монтажу.</p>
        </aside>

        <aside class="quote-summary" data-configured-quote hidden>
          <div class="quote-summary__image">
            <img src="/images/s20/product-main.webp" alt="Walk-in Premium Black" width="760" height="620" />
          </div>
          <div class="quote-summary__head">
            <small>Душові кабіни / Walk-in</small>
            <h2 data-quote-product>Walk-in Premium Black</h2>
            <span>Артикул: SG-WI-001</span>
          </div>

          <dl class="quote-summary__parameters" data-quote-parameters>
            <div><dt>Конфігурація</dt><dd>Завантаження параметрів…</dd></div>
          </dl>

          <div class="quote-summary__price">
            <span>Попередня ціна</span>
            <strong data-quote-price>Уточнюється</strong>
          </div>
          <p class="quote-summary__notice">Попередня ціна не є офертою. Фінальна вартість залежить від перевірки розмірів, фурнітури, доставки та монтажних умов.</p>
        </aside>

        <div class="quote-form-card">
          <p class="eyebrow">Контактні дані</p>
          <h2>Дані для розрахунку</h2>

          <form class="quote-form quote-form--simple" data-quote-form data-lead-form data-success-url="/thank-you/?type=quote">
            <label data-construction-field>
              <span>Що потрібно *</span>
              <select name="construction_type" required>
                <option value="">Оберіть конструкцію</option>
                <option>Душова конструкція</option>
                <option>Скляна перегородка</option>
                <option>Скляні двері</option>
                <option>Скляна огорожа</option>
                <option>Дзеркало</option>
                <option>Безрамне скління</option>
                <option>Фасад або вітрина</option>
                <option>Інша конструкція</option>
              </select>
            </label>

            <div class="quote-form__row">
              <label>
                <span>Ім’я *</span>
                <input name="name" autocomplete="name" placeholder="Ваше ім’я" required />
              </label>
              <label>
                <span>Телефон *</span>
                <input name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="+38" required />
              </label>
            </div>

            <label class="quote-form__city">
              <span>Місто</span>
              <input name="city" autocomplete="address-level2" placeholder="Київ, Львів, Одеса..." />
            </label>

            <label>
              <span>Приблизні розміри та побажання</span>
              <textarea name="comment" rows="5" placeholder="Наприклад: перегородка 2500 × 2700 мм, матове скло, потрібні замір і монтаж"></textarea>
            </label>

            <input type="hidden" name="configuration" data-quote-config-input />
            <input type="hidden" name="estimated_price" data-quote-price-input />
            <input type="hidden" name="source_page" data-source-page />

            <label class="quote-consent">
              <input name="consent" value="accepted" type="checkbox" required />
              <span>Погоджуюсь на обробку даних згідно з <a href="/privacy-policy/">політикою конфіденційності</a>.</span>
            </label>

            <button class="button button--mint quote-form__submit" type="submit">Отримати попередній розрахунок</button>
            <p class="quote-form__status" data-quote-status data-form-status role="status" hidden></p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const params = new URLSearchParams(window.location.search);
    const projectRaw = params.get('project') || '';
    const configRaw = params.get('config') || params.get('request') || '';
    const priceRaw = params.get('price') || '';
    const productRaw = params.get('product') || '';
    let projectPayload = null;
    try { projectPayload = projectRaw ? JSON.parse(decodeURIComponent(projectRaw)) : null; } catch {}

    const decodedConfig = decodeURIComponent(configRaw || '');
    const decodedPrice = decodeURIComponent(priceRaw || '');
    const hasConfiguration = Boolean(projectPayload || decodedConfig || decodedPrice || productRaw);

    const genericQuote = document.querySelector('[data-generic-quote]');
    const configuredQuote = document.querySelector('[data-configured-quote]');
    genericQuote.hidden = hasConfiguration;
    configuredQuote.hidden = !hasConfiguration;

    if (hasConfiguration) {
      document.querySelector('[data-quote-heading]').textContent = 'Перевірте конфігурацію та залиште контакти';
      document.querySelector('[data-quote-intro]').textContent = 'Ми отримали вибрані параметри. Додайте контакти — менеджер перевірить комплектацію та підготує комерційну пропозицію.';
      document.querySelector('.quote-page__steps span').textContent = '01 Конфігурація';
    }

    document.querySelector('[data-quote-product]').textContent = projectPayload ? 'Комплексний проєкт Space Glass' : (productRaw || 'Індивідуальна конструкція');
    const parameterRoot = document.querySelector('[data-quote-parameters]');
    if (projectPayload?.items?.length) {
      document.querySelector('[data-quote-price]').textContent = `${Math.round(projectPayload.total || 0).toLocaleString('uk-UA')} грн`;
      document.querySelector('[data-quote-config-input]').value = JSON.stringify(projectPayload);
      parameterRoot.innerHTML = projectPayload.items.map((item, index) => `
        <div>
          <dt>${index + 1}. ${item.name}</dt>
          <dd>${item.configuration} · ${item.quantity || 1} шт.</dd>
        </div>
      `).join('');
    } else {
    document.querySelector('[data-quote-price]').textContent = decodedPrice || 'Уточнюється';
    document.querySelector('[data-quote-config-input]').value = decodedConfig;
    document.querySelector('[data-quote-price-input]').value = decodedPrice;

    if (!projectPayload && decodedConfig) {
      const parts = decodedConfig
        .replace(/^Хочу отримати КП:\s*/i, '')
        .replace(/\.\s*Попередня ціна:.*$/i, '')
        .split(/[·,]/)
        .map(value => value.trim())
        .filter(Boolean);

      parameterRoot.innerHTML = parts.map((part, index) => `
        <div>
          <dt>${index === 0 ? 'Тип' : `Параметр ${index + 1}`}</dt>
          <dd>${part}</dd>
        </div>
      `).join('');
    } else if (!projectPayload && hasConfiguration) {
      parameterRoot.innerHTML = `
        <div><dt>Статус</dt><dd>Конфігурацію можна уточнити з менеджером</dd></div>
      `;
    }
    }

    const form = document.querySelector('[data-quote-form]');
    const status = document.querySelector('[data-quote-status]');
    const constructionField = document.querySelector('[data-construction-field]');
    constructionField.hidden = hasConfiguration;
    form.elements.construction_type.required = !hasConfiguration;
    form.elements.construction_type.value = hasConfiguration ? 'Конфігурацію вже сформовано' : '';
    form.elements.source_page.value = document.referrer || window.location.href;

    const savedDraft = JSON.parse(localStorage.getItem('spaceGlassQuoteDraft') || '{}');
    ['construction_type','name','phone','email','city','comment'].forEach((field) => {
      if (savedDraft[field] && form.elements[field]) form.elements[field].value = savedDraft[field];
    });

    form.addEventListener('input', () => {
      const draft = {};
      ['construction_type','name','phone','email','city','comment'].forEach((field) => {
        draft[field] = form.elements[field]?.value || '';
      });
      localStorage.setItem('spaceGlassQuoteDraft', JSON.stringify(draft));
    });

    form.addEventListener('submit', () => localStorage.removeItem('spaceGlassQuoteDraft'));
  </script>
</BaseLayout>
