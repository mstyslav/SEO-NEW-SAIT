---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FAQBlock from '../components/FAQBlock.astro';
const serviceFaqs = [
  [
    "Як отримати попередній розрахунок?",
    "Надішліть фото, приблизні розміри або креслення. Ми уточнимо технічні деталі та підготуємо попередню оцінку."
  ],
  [
    "Де доступний монтаж?",
    "Основні міста монтажу — Київ, Львів та Одеса з областями."
  ],
  [
    "Чи є доставка по Україні?",
    "Так, готові товари та комплектуючі доставляємо по всій Україні."
  ],
  [
    "Чи виконуєте ви замір?",
    "Так, професійний замір доступний для індивідуальних конструкцій у містах монтажу."
  ],
  [
    "Чи можна замовити тільки виготовлення?",
    "Так, у частині проєктів можливе виготовлення без монтажу з доставкою на об’єкт."
  ],
  [
    "Чи готуєте технічні креслення?",
    "Так, для складних конструкцій готуємо креслення та специфікацію перед запуском у виробництво."
  ],
  [
    "Як проходить консультація?",
    "Уточнюємо задачу, тип об’єкта, розміри, бюджет, матеріали та бажаний результат."
  ],
  [
    "Що потрібно підготувати перед заміром?",
    "Бажано завершити основні чорнові роботи та забезпечити доступ до отвору."
  ],
  [
    "Чи працюєте з дизайнерами й архітекторами?",
    "Так, надаємо технічну інформацію, консультації та супровід проєкту."
  ],
  [
    "Чи можна замовити монтаж після доставки?",
    "Так, якщо монтаж доступний у вашому місті та конструкція підготовлена для встановлення."
  ],
  [
    "Чи виконуєте демонтаж?",
    "Так, демонтаж старих конструкцій оцінюється окремо після огляду об’єкта."
  ],
  [
    "Які строки виготовлення?",
    "Строк залежить від типу конструкції, матеріалів, складності та завантаження виробництва."
  ],
  [
    "Чи надається гарантія?",
    "Так, гарантія залежить від типу конструкції, фурнітури та формату монтажу."
  ],
  [
    "Чи є післягарантійний сервіс?",
    "Так, доступні консультації, регулювання та заміна окремих комплектуючих."
  ],
  [
    "Чи можна реалізувати проєкт поетапно?",
    "Так, великі об’єкти можна розділити на етапи за погодженим графіком."
  ],
  [
    "Чи працюєте з комерційними об’єктами?",
    "Так, реалізуємо проєкти для офісів, магазинів, ресторанів, готелів і клінік."
  ],
  [
    "Чи допомагаєте обрати скло та фурнітуру?",
    "Так, підбираємо матеріали відповідно до навантаження, дизайну, бюджету й умов експлуатації."
  ],
  [
    "Чи можна замовити термінове виготовлення?",
    "Можливість термінового виробництва залежить від комплектації та завантаження."
  ],
  [
    "Які способи оплати доступні?",
    "Умови оплати визначаються залежно від типу замовлення, обсягу й формату робіт."
  ],
  [
    "Як почати роботу?",
    "Надішліть фото, розміри, креслення або короткий опис через форму на сайті."
  ]
];
const cards = [["01", "Консультація", "Уточнюємо завдання, бюджет, строки та формат реалізації."], ["02", "Замір", "Перевіряємо геометрію, основи, примикання та доступ до об’єкта."], ["03", "Проєктування", "Готуємо креслення, специфікацію скла й фурнітури."], ["04", "Виготовлення", "Виробляємо конструкцію за погодженими параметрами."], ["05", "Доставка", "Організовуємо логістику по Україні та до об’єкта монтажу."], ["06", "Монтаж і сервіс", "Встановлюємо, перевіряємо та надаємо післямонтажну підтримку."]];
---
<BaseLayout title="Послуги Space Glass" description="Замір, проєктування, виготовлення, доставка, монтаж і сервіс скляних конструкцій.">
  <div class="sg-page-shell">
    <Header />
    <main id="main">
      <section class="inner-hero">
        <div class="inner-hero__copy">
          <p class="eyebrow">Послуги</p>
          <h1>Від першої консультації до готової конструкції</h1>
          <p class="lead">Один відповідальний процес: технічний аналіз, проєктування, виробництво, логістика та монтаж.</p>
          <a class="button button--mint" href="#inner-cta">Отримати консультацію</a>
        </div>
        <div class="inner-hero__visual"><span>SPACE GLASS</span></div>
      </section>
      <section class="inner-section">
        <div class="inner-section__heading"><p class="eyebrow">Space Glass</p><h2>Системний підхід до кожного завдання</h2></div>
        <div class="inner-card-grid">
          {cards.map(([num,title,text]) => <article class="inner-card"><span>{num}</span><h3>{title}</h3><p>{text}</p><a href={title === "Консультація" ? "/contacts/" : title === "Замір" ? "/services/zamer/" : title === "Проєктування" ? "/services/proektuvannya/" : title === "Виготовлення" ? "/services/vyhotovlennya/" : title === "Доставка" ? "/services/dostavka/" : "/services/montazh/"}>Детальніше →</a></article>)}
        </div>
      </section>
      <section class="inner-band">
        <div><b>Білий простір</b><span>Чистий і зрозумілий дизайн</span></div>
        <div><b>Бірюзовий акцент</b><span>Кнопки, лінії та активні елементи</span></div>
        <div><b>Чорна рамка бренду</b><span>Однакова шапка і футер</span></div>
      </section>
      <section class="inner-section inner-section--faq">
        <FAQBlock
          title="FAQ про послуги Space Glass"
          intro="Відповідаємо на питання про замір, проєктування, виготовлення, доставку, монтаж, гарантію та сервіс."
          items={serviceFaqs}
          visibleCount={6}
        />
      </section>
      <section id="inner-cta" class="inner-cta">
        <div><p class="eyebrow eyebrow--light">Заявка</p><h2>Отримати консультацію</h2><p>Надішліть фото, розміри або креслення — підготуємо попередню оцінку.</p></div>
        <a class="button button--white" href="mailto:info@space-glass.com.ua">Надіслати запит</a>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
