---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<BaseLayout
  title="Space Glass — hochwertige Glaskonstruktionen"
  description="Wir planen, fertigen und montieren hochwertige Glaskonstruktionen für private und gewerbliche Projekte."
  locale="de"
>
  <Header locale="de" />
  <main class="localized-home">
    <section class="localized-home__hero">
      <div class="container">
        <p class="eyebrow">SPACE GLASS</p>
        <h1>Raum. Licht. Space Glass</h1>
        <p>Wir planen, fertigen und montieren hochwertige Glaskonstruktionen für private und gewerbliche Projekte.</p>
        <div>
          <a class="button button--mint" href="/de/quote/">Angebot erhalten</a>
          <a class="button button--outline" href="/de/catalog/">Katalog öffnen</a>
        </div>
      </div>
    </section>
    <section class="section localized-home__notice"><div class="container"><p>Die vollständige deutsche Version verwendet eigene SEO-URLs und behält die gewählte Sprache bei der Navigation bei.</p></div></section>
  </main>
  <Footer locale="de" />
</BaseLayout>
