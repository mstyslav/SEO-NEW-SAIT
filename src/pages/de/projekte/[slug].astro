---
// DE project case pages — one per entry of INTL_CASES (src/i18n/intl-routes.ts).
import IntlCasePage from '../../../components/intl/IntlCasePage.astro';
import { INTL_CASES, assertIntlRoute } from '../../../i18n/intl-routes';

export function getStaticPaths() {
  return INTL_CASES.map((item) => ({ params: { slug: item.de }, props: { caseId: item.id } }));
}

const { caseId } = Astro.props;
assertIntlRoute(Astro.url.pathname, `case:${caseId}`, 'de');
---
<IntlCasePage locale="de" caseId={caseId} />
