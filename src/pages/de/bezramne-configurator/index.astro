---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DynamicConfigurator from '../../../components/configurator/DynamicConfigurator.astro';
import config from '../../../pricing/configs/frameless-glazing.json';
import tariffs from '../../../pricing/tariffs.json';
import labelsAll from '../../../i18n/configurator-labels.json';
import uiAll from '../../../i18n/configurator-ui.json';

const locale = 'de';
const labels = labelsAll[locale];
const ui = uiAll[locale];
const title = labels['frameless'];
const tariff = tariffs.categories[config.category];
---
<BaseLayout
  title={`${title} — Space Glass`}
  description={ui.configureText}
  locale={locale}
>
  <Header locale={locale} />
  <main>
    <section class="config-demo-hero">
      <div class="container">
        <p class="eyebrow">Space Glass Configurator</p>
        <h1>{title}</h1>
        <p>{ui.configureText}</p>
      </div>
    </section>
    <section class="section">
      <div class="container">
        <DynamicConfigurator
          config={config}
          tariff={tariff}
          currency={tariffs.currency}
          productName={title}
          locale={locale}
        />
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</BaseLayout>
