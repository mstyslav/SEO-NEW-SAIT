---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SolutionRequestForm from '../../components/SolutionRequestForm.astro';
const items = ['Консультація і підбір рішення','Замір та технічна перевірка','Індивідуальне виготовлення','Доставка та монтаж','Гарантія та сервіс','Пов’язані товари й проєкти'];
---
<BaseLayout title="Скляні рішення для приватного будинку — Space Glass" description="Сходи, тераси, душові, перегородки, фасади та вхідні системи.">
<div class="sg-page-shell"><Header/><main id="main">
<section class="inner-hero"><div class="inner-hero__copy"><p class="eyebrow">Рішення</p><h1>Скляні рішення для приватного будинку</h1><p class="lead">Сходи, тераси, душові, перегородки, фасади та вхідні системи.</p><a class="button button--mint" href="#solution-request">Отримати розрахунок</a></div><div class="inner-hero__visual"><span>SPACE GLASS</span></div></section>
<section class="inner-section"><div class="inner-section__heading"><p class="eyebrow">Комплексний підхід</p><h2>Від ідеї до готової конструкції</h2></div><div class="inner-card-grid">{items.map((item,i)=><article class="inner-card"><span>{String(i+1).padStart(2,'0')}</span><h3>{item}</h3><p>Підбираємо формат роботи під конкретний об’єкт і задачу.</p><a href="#solution-request">Детальніше →</a></article>)}</div></section>
<SolutionRequestForm solutionTitle="Скляні рішення для приватного будинку" example="Скляна огорожа тераси для приватного будинку у Львові" />
</main><Footer/></div></BaseLayout>
