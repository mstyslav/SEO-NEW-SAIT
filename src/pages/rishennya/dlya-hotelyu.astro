const heroImage = {
  base: 'solution-hotel',
  width: 1280,
  height: 960,
  alt: 'Преміальний готель зі скляною вхідною групою та панорамним фасадним склінням'
};

const productLinks = [
  { label: 'Душові кабіни', href: '/dushovi-kabiny/', html: 'Однотипні душові рішення для серійного оснащення номерів.' },
  { label: 'Скляні перегородки', href: '/sklyani-perehorodky/', html: 'Зонування номерів, лобі та зон ресепшн.' },
  { label: 'Скляні огорожі', href: '/sklyani-ohorozhi/', html: 'Огорожі сходів, терас і басейнів на території готелю.' },
  { label: 'Скляні двері', href: '/sklyani-dveri/', html: 'Вхідні групи та двері громадських зон.' },
  { label: 'Дзеркала на замовлення', href: '/dzerkala/', html: 'Дзеркала для номерів і санвузлів, зокрема з LED-підсвіткою.' },
  { label: 'Скляні фасади', href: '/poslugy/sklyani-fasady/', html: 'Фасадне скління лобі та панорамних вітражів.' }
];

const scenarios = [
  { title: 'Номерний фонд, який треба оснастити однаково', text: 'Типорозмір душової чи перегородки погоджують один раз і тиражують на десятки номерів — це прискорює виготовлення й подальший сервіс.' },
  { title: 'Лобі та ресепшн як обличчя готелю', text: 'Панорамне фасадне скління працює на перше враження гостя ще з вулиці.' },
  { title: 'Дзеркала для номерів і санвузлів', text: 'Дзеркала з LED-підсвіткою тиражуються за єдиним технічним рішенням для всього номерного фонду.' },
  { title: 'Заміна конструкцій без зупинки заселення', text: 'Монтаж розбивають на етапи за поверхами чи блоками номерів за погодженим графіком.' }
];

const choosePoints = [
  { title: 'Формат душової під номер', text: 'Walk-in залишає відкритий прохід і добре працює у просторих санвузлах. Ніша чи кутова конструкція економлять місце в компактних номерах.', link: { label: 'Як обрати душову кабіну зі скла', href: '/knowledge/yak-obraty-dushovu-kabinu/' } },
  { title: 'Walk-in чи закрита кабіна', text: 'Walk-in простіша в щоденному прибиранні між заїздами гостей. Закрита кабіна краще утримує тепло й бризки.', link: { label: 'Душова Walk-in: переваги, обмеження та розміри', href: '/knowledge/walk-in-perevahy-nedoliky/' } },
  { title: 'Дзеркало для номера', text: 'Розмір, форма і тип підсвітки узгоджуються під єдиний дизайн-код готелю та тиражуються на весь номерний фонд.', link: { label: 'Як обрати розмір і форму дзеркала', href: '/knowledge/yak-obraty-dzerkalo-rozmir-forma/' } }
];

const materials = [
  { title: 'Загартоване скло', text: 'Базовий матеріал для душових і перегородок номерного фонду — безпечний і простий у щоденному обслуговуванні.' },
  { title: 'Триплекс', text: 'Застосовується для огорож терас і басейнів, а також фасадних ділянок з підвищеними вимогами до безпеки.' },
  { title: 'Алюмінієві фасадні системи', text: 'Стійково-ригельні конструкції для панорамного скління лобі та громадських зон.' },
  { title: 'Фурнітура для інтенсивної експлуатації', text: 'Посилені петлі, доводчики та замки, розраховані на щоденне навантаження готельного об’єкта.' }
];

const priceFactors = [
  'кількість номерів і типорозмірів',
  'тип душової чи перегородки',
  'скло та фурнітура',
  'фасадні системи громадських зон',
  'графік поетапного монтажу',
  'доставка на об’єкт'
];

const safetyPoints = [
  { title: 'Безпечне скло для гостей', text: 'Загартоване скло душових і перегородок безпечне при пошкодженні та відповідає стандартним вимогам до конструкцій громадського використання.' },
  { title: 'Стійкість до інтенсивної експлуатації', text: 'Фурнітуру для громадських зон підбирають з розрахунком на щоденне інтенсивне використання гостями — посилені напрямні, доводчики й захисні покриття.' },
  { title: 'Уніфіковане технічне рішення', text: 'Єдина специфікація скла, профілю та фурнітури для всього номерного фонду спрощує подальший сервіс і заміну окремих елементів.' }
];

const processSteps = [
  { title: 'Консультація', text: 'Уточнюємо кількість номерів, типорозміри, бажаний результат і орієнтовний бюджет проєкту.' },
  { title: 'Замір', text: 'Виїжджаємо на об’єкт і фіксуємо фактичну геометрію номерів чи громадських зон.' },
  { title: 'Проєктування', text: 'Готуємо креслення з розмірами, склом, профілем і вузлами кріплення для типового рішення.' },
  { title: 'Виготовлення', text: 'Виробляємо партію конструкцій на власному обладнанні під погоджені параметри.' },
  { title: 'Доставка', text: 'Пакуємо та доставляємо готові конструкції в Києві, Одесі, Львові та по Україні.' },
  { title: 'Монтаж', text: 'Встановлюємо поетапно за погодженим графіком і передаємо об’єкт із гарантією.' }
];

const experienceStats = [
  { value: '10+', label: 'років реального досвіду в реалізації скляних та алюмінієвих конструкцій' },
  { value: '5 000+', label: 'реалізованих проєктів для дому та бізнесу в Україні та Європі' },
  { value: '50 000+', label: 'м² виконаного засклення житлових та комерційних об’єктів' }
];

const cityLinks = [
  { label: 'Київ', href: '/city/kyiv/' },
  { label: 'Одеса', href: '/city/odesa/' },
  { label: 'Львів', href: '/city/lviv/' }
];

const faq: [string, string][] = [
  ['Чи можна виготовити однакові душові кабіни для всіх номерів?', 'Так, для готелів погоджуємо один типорозмір і комплектацію, що прискорює виготовлення й монтаж усієї партії.'],
  ['Чи проводите монтаж без зупинки роботи готелю?', 'Графік монтажу погоджуємо індивідуально, щоб мінімізувати вплив на заселених гостей і роботу персоналу.'],
  ['Яке скло використовують для фасаду готелю?', 'Найчастіше триплекс або енергоефективні склопакети в алюмінієвій стійково-ригельній системі.'],
  ['Чи можлива поетапна заміна душових у номерах?', 'Так, заміну можна розбити на етапи за поверхами чи блоками номерів за погодженим графіком.'],
  ['Чи надається гарантія на готельні об’єкти?', 'Так, гарантійні умови фіксуються в договорі та залежать від типу конструкції й обсягу проєкту.'],
  ['Чи можлива робота за межами Києва, Одеси й Львова?', 'Так, реалізуємо готельні проєкти по всій Україні — умови доставки й монтажу узгоджуються під конкретний об’єкт.'],
  ['Скільки часу займає монтаж душової в одному номері?', 'Строк залежить від типу конструкції та готовності приміщення, фіксується після заміру й погодження графіка.'],
  ['Чи можна отримати зразок чи фото до замовлення партії?', 'Так, для великих партій погоджуємо еталонний зразок конструкції перед запуском повного виготовлення.'],
  ['Чи підходять дзеркала з підсвіткою для номерів?', 'Так, LED-підсвітка узгоджується як частина єдиного дизайн-коду готелю й тиражується на весь номерний фонд.'],
  ['Чи можна замовити огорожу для басейну готелю?', 'Так, огорожі басейнів виконують із триплексу з урахуванням вимог безпеки для зон з підвищеною вологістю.'],
  ['Чи витримує скло у громадських зонах інтенсивний трафік?', 'Так, за умови посиленої фурнітури — доводчиків і напрямних, підібраних під очікувану кількість гостей.'],
  ['Чи можна замовити нестандартний розмір душової для мансардних номерів?', 'Так, конструкції під нестандартну геометрію проєктують індивідуально після заміру.'],
  ['Що входить у комплектацію серійного замовлення?', 'Скло, профіль, фурнітура, виготовлення, доставка та монтаж — комплектація фіксується в комерційній пропозиції.'],
  ['Чи можна змінити комплектацію під час виконання проєкту?', 'До запуску виробництва — так, після повторного погодження специфікації для всієї партії.'],
  ['Як доглядати за душовими та перегородками в готелі?', 'Використовуйте неабразивні засоби, регулярно перевіряйте напрямні й ущільнення при щоденному прибиранні.'],
  ['Чи можна встановити вхідну групу під фірмовий стиль готелю?', 'Так, профіль, скло та фурнітуру підбирають з урахуванням архітектури й бренд-буку об’єкта.'],
  ['Скільки триває виготовлення партії для номерного фонду?', 'Строк залежить від кількості одиниць і складності конструкції, фіксується після погодження специфікації.'],
  ['Чи можлива доставка й монтаж у кілька етапів для різних поверхів?', 'Так, великі проєкти зазвичай реалізують поетапно за погодженим графіком.'],
  ['Чи потрібен окремий проєкт для лобі та номерів?', 'Так, громадські зони й номери мають різні вимоги до скла й навантажень, тому проєктуються окремо.'],
  ['Що робити, якщо після заселення частини номерів виявлено нестандартну геометрію?', 'Такі номери фіксують окремо на замірі — для них готують індивідуальне рішення в межах загального проєкту.']
];


const breadcrumbItems = [
  { label: 'Головна', href: '/' },
  { label: 'Рішення', href: '/rishennya/' },
  { label: 'Для готелю', href: PATH }
];

const structuredData: JsonLdObject[] = [
  breadcrumbSchema(breadcrumbItems.map((item) => ({ label: item.label, href: absoluteUrl(item.href, origin) }))),
  faqSchema(faq.map(([question, answer]) => ({ question, answer })))
].filter(Boolean) as JsonLdObject[];
---
<SolutionDetailPage
  path={PATH}
  title={title}
  description={description}
  h1={h1}
  heroLead={heroLead}
  heroImage={heroImage}
  scenarios={scenarios}
  choosePoints={choosePoints}
  materials={materials}
  safetyPoints={safetyPoints}
  priceFactors={priceFactors}
  processSteps={processSteps}
  experienceStats={experienceStats}
  faq={faq}
  breadcrumbItems={breadcrumbItems}
  structuredData={structuredData}
  formExample="Скляні душові перегородки для номерів готелю в Одесі"
/>
