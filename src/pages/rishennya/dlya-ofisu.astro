---
// Solution page — shared SolutionDetailPage template (same visual system as the
// catalog sections). This file keeps the page's own texts; tiles, projects and
// SEO copy come from src/data/solution-pages.ts.
import SolutionDetailPage from '../../components/solutions/SolutionDetailPage.astro';
import { absoluteUrl, breadcrumbSchema, faqSchema, type JsonLdObject } from '../../seo/schema';

const PATH = '/rishennya/dlya-ofisu/';
const origin = Astro.site ?? Astro.url.origin;

// PRIMARY intent = object type ("для офісу"), not product type — офісні перегородки
// remain the primary target of /sklyani-perehorodky/ofisni/. See report for rationale.
const title = 'Скляні конструкції для офісу на замовлення | Space Glass';
const description =
  'Скляні конструкції для офісу на замовлення: перегородки, двері та алюмінієві системи для кабінетів і переговорних. Проєктування, виготовлення й монтаж у Києві, Одесі, Львові та по Україні.';
const h1 = 'Скляні конструкції для офісу';
const heroLead =
  'Перегородки, двері та скляні системи в алюмінієвому профілі для зонування робочого простору без втрати світла — в Києві, Одесі, Львові та по всій Україні.';
const heroImage = {
  base: 'solution-office-meeting-room',
  width: 1280,
  height: 960,
  alt: 'Сучасний офіс зі скляними перегородками та дверима в алюмінієвому профілі'
};

const productLinks = [
  { label: 'Офісні скляні перегородки', href: '/sklyani-perehorodky/ofisni/', html: 'Стаціонарні та мобільні перегородки для зонування опенспейсу й кабінетів.' },
  { label: 'Loft-перегородки', href: '/sklyani-perehorodky/loft/', html: 'Перегородки в чорному металевому профілі для сучасного офісного інтер’єру.' },
  { label: 'Скляні двері', href: '/sklyani-dveri/', html: 'Розпашні, розсувні та маятникові двері в комплекті з перегородками.' },
  { label: 'Алюмінієві конструкції', href: '/alyuminiyevi-konstrukcziyi/', html: 'Профільні системи для суцільноскляних перегородок і фасадів переговорних.' },
  { label: 'Архітектурні системи', href: '/arkhitekturni-systemy/', html: 'Фасадне скління вхідних груп бізнес-центрів і великих холів.' }
];

const scenarios = [
  { title: 'Опенспейс, який треба ділити на зони', text: 'Мобільні перегородки на напрямних дозволяють змінювати планування без капітального ремонту при рості команди.' },
  { title: 'Переговорна кімната зі скляними стінами', text: 'Звукоізоляційний склопакет і матова смуга дають приватність розмов, не перетворюючи кімнату на закриту коробку.' },
  { title: 'Ресепшн і вхідна зона', text: 'Суцільноскляний фасад формує перше враження про компанію ще з коридору бізнес-центру.' },
  { title: 'Кабінети керівництва', text: 'Скляні перегородки з дверима зберігають статусність окремого кабінету, не ізолюючи його від решти команди.' }
];

const choosePoints = [
  { title: 'Загальні принципи вибору перегородки', text: 'Формат залежить від планування, кількості дверних груп і того, наскільки часто офіс змінює конфігурацію.', link: { label: 'Як обрати скляну перегородку для офісу', href: '/knowledge/yak-obraty-sklyanu-perehorodku/' } },
  { title: 'Loft чи суцільноскляна перегородка', text: 'Loft-перегородка з видимим профілем-сіткою формує впізнаваний індустріальний стиль. Суцільноскляна — мінімальний каркас і максимум світла.', link: { label: 'LOFT-перегородки: профіль, скло та конструкція', href: '/knowledge/loft-perehorodky-vydy-sklo-profili/' } },
  { title: 'Розпашні чи розсувні двері', text: 'Розсувні двері економлять простір проходу в коридорах з інтенсивним рухом. Розпашні звичніші для окремих кабінетів.', link: { label: 'Розпашні чи розсувні скляні двері: порівняння', href: '/knowledge/rozpashni-chy-rozsuvni-sklyani-dveri/' } }
];

const materials = [
  { title: 'Загартоване скло', text: 'Основний матеріал для офісних перегородок і дверей — безпечний при пошкодженні та витримує щоденне інтенсивне використання.' },
  { title: 'Звукоізоляційні склопакети', text: 'Застосовуються в переговорних кімнатах, де потрібен знижений рівень шуму між приміщеннями.' },
  { title: 'Алюмінієвий профіль', text: 'Формує каркас перегородок і дверей, доступний у чорному, білому та натуральному кольорі під фірмовий стиль офісу.' },
  { title: 'Фурнітура', text: 'Доводчики, напрямні й замки підбираються під інтенсивність експлуатації офісного простору.' }
];

const priceFactors = [
  'метраж і кількість перегородок',
  'кількість дверних груп',
  'тип скла — прозоре, матове чи звукоізоляційне',
  'система профілю та колір',
  'фурнітура й тип відкривання',
  'монтаж і графік робіт в офісі'
];

const safetyPoints = [
  { title: 'Безпечне скло щодня', text: 'Загартоване скло витримує інтенсивне щоденне використання в прохідних зонах і при пошкодженні не утворює гострих уламків.' },
  { title: 'Приватність без глухих стін', text: 'Матування, тонування чи плівка з логотипом закривають окремі зони від сторонніх очей, зберігаючи загальне освітлення опенспейсу.' },
  { title: 'Механізми під навантаження', text: 'Доводчики й напрямні дверей підбираються під кількість відкривань на день — критично для прохідних кабінетів і переговорних.' }
];

const processSteps = [
  { title: 'Консультація', text: 'Уточнюємо задачу, планування офісу, бажаний результат і орієнтовний бюджет.' },
  { title: 'Замір', text: 'Виїжджаємо на об’єкт і фіксуємо фактичну геометрію приміщення та отворів.' },
  { title: 'Проєктування', text: 'Готуємо креслення з розмірами, склом, профілем і вузлами кріплення.' },
  { title: 'Виготовлення', text: 'Виробляємо конструкцію на власному обладнанні під погоджені параметри.' },
  { title: 'Доставка', text: 'Пакуємо та доставляємо готову конструкцію в Києві, Одесі, Львові та по Україні.' },
  { title: 'Монтаж', text: 'Встановлюємо, перевіряємо роботу механізмів і передаємо об’єкт із гарантією.' }
];

const experienceStats = [
  { value: '10+', label: 'років реального досвіду в реалізації скляних та алюмінієвих конструкцій' },
  { value: '5 000+', label: 'реалізованих проєктів для дому та бізнесу в Україні та Європі' },
  { value: '50 000+', label: 'м² виконаного засклення житлових та комерційних об’єктів' }
];

const cityLinks = [
  { label: 'Київ', href: '/city/kyiv/' },
  { label: 'Одеса', href: '/city/odesa/' },
  { label: 'Львів', href: '/city/lviv/' }
];

const faq: [string, string][] = [
  ['Чим loft-перегородка відрізняється від суцільноскляної?', 'Loft-перегородка має видимий металевий профіль-сітку, суцільноскляна — мінімальний каркас або кріплення без видимих стійок.'],
  ['Чи можна встановити перегородку без демонтажу стелі?', 'Так, більшість систем монтуються до наявної стелі та підлоги без капітальних робіт.'],
  ['Чи забезпечують перегородки звукоізоляцію?', 'Так, за умови відповідного склопакета — для переговорних рекомендуємо посилену звукоізоляцію.'],
  ['Чи можна замовити перегородку з матованою смугою чи логотипом?', 'Так, матування, тонування чи плівку з логотипом наносять за погодженим макетом.'],
  ['Скільки триває монтаж офісних перегородок?', 'Строк залежить від метражу й кількості дверних груп, фіксується після заміру та погодження проєкту.'],
  ['Чи можна перенести перегородку в інше місце офісу?', 'Мобільні системи на напрямних можна демонтувати й зібрати повторно на новому місці. Стаціонарні перегородки розраховані на постійне розташування.'],
  ['Чи можна встановити перегородку в орендованому офісі?', 'Так, за погодженням із орендодавцем — мобільні системи особливо зручні, якщо конструкцію потрібно буде демонтувати при переїзді.'],
  ['Який клас вогнестійкості мають скляні перегородки?', 'Клас вогнестійкості залежить від обраної системи скла й профілю та уточнюється на етапі проєктування під вимоги конкретного приміщення.'],
  ['Чи можна змінити конфігурацію офісу після монтажу?', 'Мобільні перегородки дозволяють це зробити без демонтажу капітальних елементів. Стаціонарні системи змінити складніше.'],
  ['Чи проводите монтаж у неробочий час?', 'Графік монтажу погоджуємо індивідуально, щоб мінімізувати вплив на роботу команди.'],
  ['Чи можна встановити двері прямо в скляну перегородку?', 'Так, розпашні, розсувні чи маятникові двері інтегруються в перегородку ще на етапі проєктування.'],
  ['Яке скло краще для переговорної кімнати?', 'Звукоізоляційний склопакет із матованою чи тонованою смугою — знижує шум і додає приватності без повної ізоляції від команди.'],
  ['Чи можна підібрати колір профілю під фірмовий стиль?', 'Так, доступні чорний, білий, натуральний алюміній та індивідуальні кольори залежно від системи.'],
  ['Скільки коштує м² офісної перегородки?', 'Вартість залежить від скла, профілю, фурнітури та кількості дверей — попередній розрахунок готуємо після фото й приблизного метражу.'],
  ['Чи потрібен професійний замір для офісу?', 'Так, фінальний замір фіксує фактичну геометрію приміщення та розташування комунікацій перед виготовленням.'],
  ['Чи можна встановити суцільноскляну перегородку без видимого профілю?', 'Так, суцільноскляні системи використовують мінімальні точкові кріплення замість суцільного каркаса.'],
  ['Чи витримують перегородки інтенсивний прохідний трафік?', 'Так, за умови посиленої фурнітури — доводчиків і напрямних, підібраних під кількість відкривань на день.'],
  ['Чи можна замовити лише виготовлення без монтажу?', 'У частині випадків так, із доставкою готової конструкції — деталі узгоджуються індивідуально.'],
  ['Чи є гарантія на офісні конструкції?', 'Так, гарантійні умови фіксуються в договорі та залежать від типу системи й обсягу проєкту.'],
  ['Що робити, якщо стіни чи стеля офісу нерівні?', 'Відхилення фіксуються під час заміру та враховуються профілями кріплення або індивідуальною геометрією скла.']
];


const breadcrumbItems = [
  { label: 'Головна', href: '/' },
  { label: 'Рішення', href: '/rishennya/' },
  { label: 'Для офісу', href: PATH }
];

const structuredData: JsonLdObject[] = [
  breadcrumbSchema(breadcrumbItems.map((item) => ({ label: item.label, href: absoluteUrl(item.href, origin) }))),
  faqSchema(faq.map(([question, answer]) => ({ question, answer })))
].filter(Boolean) as JsonLdObject[];
---
<SolutionDetailPage
  path={PATH}
  title={title}
  description={description}
  h1={h1}
  heroLead={heroLead}
  heroImage={heroImage}
  scenarios={scenarios}
  choosePoints={choosePoints}
  materials={materials}
  safetyPoints={safetyPoints}
  priceFactors={priceFactors}
  processSteps={processSteps}
  experienceStats={experienceStats}
  faq={faq}
  breadcrumbItems={breadcrumbItems}
  structuredData={structuredData}
  formExample="Скляна офісна перегородка з дверима у Києві"
/>
