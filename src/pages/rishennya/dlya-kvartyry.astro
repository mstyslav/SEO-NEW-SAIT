---
// Bespoke exemplar SEO/UX build for this one solution page — deliberately not using
// the shared SolutionPage.astro/solutions.ts/solutions.css so the other 5 solution
// pages and the /rishennya/ hub (owned by a parallel task) stay untouched.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQBlock from '../../components/FAQBlock.astro';
import SolutionRequestForm from '../../components/SolutionRequestForm.astro';
import ProjectCard from '../../components/projects/ProjectCard.astro';
import { absoluteUrl, breadcrumbSchema, faqSchema, type JsonLdObject } from '../../seo/schema';
import '../../styles/projects-common.css';
import '../../styles/solution-kvartyry.css';

const PATH = '/rishennya/dlya-kvartyry/';
const origin = Astro.site ?? Astro.url.origin;

const title = 'Скляні конструкції для квартири на замовлення | Space Glass';
const description =
  'Скляні конструкції для квартири на замовлення: душові кабіни, перегородки, скляні двері, дзеркала та огорожі. Проєктування, виготовлення й монтаж у Києві, Одесі, Львові та по Україні.';
const h1 = 'Скляні конструкції для квартири';
const heroLead =
  'Індивідуальні скляні рішення для ванної, кухні, гардеробної та житлового простору — від заміру й проєктування до виготовлення та монтажу в Києві, Одесі, Львові та по всій Україні.';
const heroImage = {
  base: 'solution-apartment',
  width: 1280,
  height: 1001,
  alt: 'Сучасна квартира зі скляною перегородкою в чорному алюмінієвому профілі'
};

const productLinks = [
  {
    label: 'Душові кабіни зі скла',
    href: '/dushovi-kabiny/',
    html: 'Walk-in, кутові, у нішу та розсувні душові конструкції для ванної кімнати.'
  },
  {
    label: 'Скляні перегородки',
    href: '/sklyani-perehorodky/',
    html: '<a href="/sklyani-perehorodky/loft/">Loft</a>, <a href="/sklyani-perehorodky/mizhkimnatni/">міжкімнатні</a> та <a href="/sklyani-perehorodky/rozsuvni/">розсувні</a> перегородки для зонування квартири.',
    calc: '/peregorodky-configurator/'
  },
  { label: 'Скляні двері', href: '/sklyani-dveri/', html: 'Розпашні, розсувні та приховані двері в алюмінієвому профілі.' },
  { label: 'Дзеркала на замовлення', href: '/dzerkala/', html: 'Дзеркала з LED-підсвіткою, у рамі та за індивідуальною формою.', calc: '/dzerkala-configurator/' },
  { label: 'Скляні огорожі', href: '/sklyani-ohorozhi/', html: 'Огорожі сходів і антресолей для дворівневих квартир.' }
];

const scenarios = [
  { title: 'Ванна без другого вікна', text: 'Прозора або злегка тонована душова перегородка не забирає єдине джерело світла в кімнаті — на відміну від глухої стіни чи шторки.' },
  { title: 'Кухня-студія без стін', text: 'Розсувна скляна перегородка відокремлює кухню від вітальні, коли потрібно локалізувати запахи, і повністю відкриває простір в інший час.' },
  { title: 'Дворівнева квартира зі сходами', text: 'Скляна огорожа замінює глухі перила й зберігає світло між поверхами дуплексу чи мансарди.' },
  { title: 'Гардеробна замість комори', text: 'Скляні двері чи розсувна система відкривають гардеробну, не перевантажуючи невеликий коридор глухими стулками.' }
];

const materials = [
  { title: 'Загартоване скло', text: 'Базовий матеріал для душових кабін, перегородок і дверей — безпечне при пошкодженні та стійке до вологи й перепадів температури.' },
  { title: 'Товщина скла', text: 'Товщину для перегородок і дверей підбирають індивідуально — за розміром полотна, кількістю опор і навантаженням.', link: { label: 'Як обирають товщину скла', href: '/knowledge/tovshchyna-skla-8-10-12-mm/' } },
  { title: 'Триплекс', text: 'Застосовується для огорож сходів і антресолей у дворівневих квартирах, де скло несе конструктивне навантаження.' },
  { title: 'Алюмінієвий профіль', text: 'Формує каркас перегородок і дверей, доступний у різних кольорах під інтер’єр — від чорного матового до природного алюмінію.' }
];

const choosePoints = [
  { title: 'Скло для вологих зон', text: 'Для душових кабін і перегородок у ванній застосовують загартоване скло з водовідштовхувальним покриттям — воно витримує перепади температури й довше залишається чистим без розводів.' },
  { title: 'Матове чи прозоре скло', text: 'Матове, сатиноване або тоноване скло приховує кімнату від сусідніх приміщень, зберігаючи світло. Прозоре скло підходить там, де приватність не критична — наприклад, для перегородки кухні-студії.' },
  { title: 'Розсувні чи розпашні системи', text: 'У невеликих кімнатах розсувні двері й перегородки економлять простір для відкривання. Розпашні системи звичніші в експлуатації й підходять для просторих санвузлів і гардеробних.', link: { label: 'Розпашні чи розсувні двері: як обрати', href: '/knowledge/rozpashni-chy-rozsuvni-sklyani-dveri/' } }
];

const safetyPoints = [
  { title: 'Безпечне скло', text: 'Загартоване скло при пошкодженні розсипається на дрібні тупі гранули без гострих країв — це стандарт безпеки для душових, дверей і перегородок у житловому просторі.', link: { label: 'Як обрати душову кабіну зі скла', href: '/knowledge/yak-obraty-dushovu-kabinu/' } },
  { title: 'Приватність без глухих стін', text: 'Матування, сатинування чи тонування закривають кімнату від сторонніх очей, зберігаючи природне світло — актуально для санвузла, гардеробної чи спальні за перегородкою.' },
  { title: 'Безпека для дітей і побуту', text: 'Кромки скла обробляються, а фурнітура підбирається під навантаження конкретної конструкції, щоб виключити люфт і випадкове защемлення.' }
];

const priceFactors = [
  'площа й кількість полотен конструкції',
  'тип і товщина скла',
  'колір і система профілю',
  'фурнітура та тип відкривання',
  'складність геометрії приміщення',
  'монтаж і доступ до об’єкта'
];

const processSteps = [
  { title: 'Консультація', text: 'Уточнюємо задачу, тип приміщення, бажаний результат і орієнтовний бюджет.' },
  { title: 'Замір', text: 'Виїжджаємо на об’єкт і фіксуємо фактичну геометрію отвору чи приміщення.' },
  { title: 'Проєктування', text: 'Готуємо креслення з розмірами, склом, профілем і вузлами кріплення.' },
  { title: 'Виготовлення', text: 'Виробляємо конструкцію на власному обладнанні під погоджені параметри.' },
  { title: 'Доставка', text: 'Пакуємо та доставляємо готову конструкцію в Києві, Одесі, Львові та по Україні.' },
  { title: 'Монтаж', text: 'Встановлюємо, перевіряємо роботу механізмів і передаємо об’єкт із гарантією.' }
];

const experienceStats = [
  { value: '10+', label: 'років реального досвіду в реалізації скляних та алюмінієвих конструкцій' },
  { value: '5 000+', label: 'реалізованих проєктів для дому та бізнесу в Україні та Європі' },
  { value: '50 000+', label: 'м² виконаного засклення житлових та комерційних об’єктів' }
];

const cityLinks = [
  { label: 'Київ', href: '/city/kyiv/' },
  { label: 'Одеса', href: '/city/odesa/' },
  { label: 'Львів', href: '/city/lviv/' }
];

const faq: [string, string][] = [
  ['Яке скло краще для душової кабіни в квартирі?', 'Загартоване скло товщиною від 6 до 10 мм із водовідштовхувальним покриттям — воно безпечне, витримує вологість і легше очищується від вапняного нальоту.'],
  ['Чи можна замовити перегородку без демонтажу ремонту?', 'Так, більшість перегородок і дверей монтуються в готовий отвір після фінальних поверхонь без порушення сусідніх стін.'],
  ['Скільки коштує скляна перегородка для квартири?', 'Вартість залежить від розмірів, типу скла, профілю та фурнітури. Попередній розрахунок готуємо після фото та приблизних розмірів.'],
  ['Чи роблять дзеркала за нестандартною формою?', 'Так, дзеркала виготовляють за будь-якою погодженою формою, розміром і типом підсвітки під конкретну стіну чи нішу.'],
  ['Чи потрібен професійний замір?', 'Для точного виготовлення так — фінальний замір проводять після завершення стін, підлоги й стелі у зоні монтажу.'],
  ['Чи можна отримати попередній розрахунок без виїзду майстра?', 'Так, для орієнтовної оцінки достатньо фото приміщення, приблизних розмірів і побажань щодо скла — точну вартість підтверджуємо після заміру.'],
  ['Яка товщина скла використовується для цільноскляних перегородок?', 'Зазвичай від 6 до 16 мм — конкретну товщину підбирають залежно від розміру, способу кріплення й навантаження на конструкцію.'],
  ['Чим загартоване скло безпечніше звичайного?', 'При пошкодженні воно розсипається на дрібні тупі гранули без гострих країв, тоді як звичайне скло утворює небезпечні уламки.'],
  ['Чи можна зробити перегородку матовою для приватності?', 'Так, доступні матове, сатиноване й тоноване скло — вони приховують кімнату від сусідніх приміщень, зберігаючи природне світло.'],
  ['Чи підходять розсувні двері для маленької кімнати?', 'Так, розсувні системи не потребують простору для відкривання стулки, тому економлять місце в невеликих кімнатах і коридорах.'],
  ['Скільки триває виготовлення перегородки чи дверей?', 'Строк залежить від розмірів, скла та фурнітури, фіксується після погодження креслення і комплектації.'],
  ['Чи можна змінити розміри після оформлення замовлення?', 'До запуску у виробництво — так, після повторного погодження. Загартоване скло після виготовлення вже не підрізають і не свердлять.'],
  ['Чи можна встановити скляну конструкцію в орендованій квартирі?', 'Так, за погодженням із власником — перегородки, двері та душові монтуються без порушення несучих стін і комунікацій.'],
  ['Як доглядати за скляною перегородкою чи дверима?', 'Використовуйте неабразивні засоби, регулярно очищайте напрямні й ущільнення, звертайтеся в сервіс при появі люфту.'],
  ['Чи глушить скляна перегородка звук між кімнатами?', 'Скляна перегородка не замінює капітальну стіну за рівнем звукоізоляції, але щільні притвори й товще скло помітно знижують побутовий шум і зберігають відчуття окремого приміщення.'],
  ['Чим loft-перегородка відрізняється від звичайної скляної?', 'Loft-перегородка має видимий металевий профіль-сітку, що ділить полотно на секції, — впізнаваний стиль для кухні чи вітальні. Звичайна перегородка може бути суцільним полотном без цього поділу.'],
  ['Чи безпечні скляні перегородки для дітей?', 'Так, застосовується загартоване або ламіноване скло без гострих країв, а фурнітура підбирається під навантаження конкретної конструкції.'],
  ['Чи можна замовити лише виготовлення без монтажу?', 'У частині випадків так, із доставкою готової конструкції — деталі узгоджуються індивідуально.'],
  ['Чи потрібен окремий каркас для дзеркала з LED-підсвіткою?', 'Ні, підсвітка інтегрується безпосередньо в конструкцію дзеркала ще на етапі проєктування.'],
  ['Що робити, якщо стіни у квартирі нерівні?', 'Відхилення фіксуються під час заміру та враховуються профілями кріплення або індивідуальною геометрією скла.']
];

const projectSlugs = ['loft-kyiv', 'bath-screen-akvarel-odesa', 'mirrored-wardrobe-doors-milos-odesa', 'wardrobe-partition-crystal-springs-kyiv', 'kitchen-partition-fjord-kyiv'];
const allProjects = await getCollection('projects', ({ data }) => data.status === 'published' && data.locale === 'uk');
const projects = projectSlugs
  .map((slug) => allProjects.find((p) => p.data.slug === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p))
  .map((p) => p.data);

const breadcrumbItems = [
  { label: 'Головна', href: '/' },
  { label: 'Рішення', href: '/rishennya/' },
  { label: 'Для квартири', href: PATH }
];

const structuredData: JsonLdObject[] = [
  breadcrumbSchema(breadcrumbItems.map((item) => ({ label: item.label, href: absoluteUrl(item.href, origin) }))),
  faqSchema(faq.map(([question, answer]) => ({ question, answer })))
].filter(Boolean) as JsonLdObject[];

const heroSrcset = `/images/solutions-new/${heroImage.base}-640.webp 640w, /images/solutions-new/${heroImage.base}.webp ${heroImage.width}w`;
const heroSizes = '(max-width: 900px) 100vw, 50vw';
---
<BaseLayout
  title={title}
  description={description}
  locale="uk"
  alternateLocales={['uk']}
  schemaType="Service"
  structuredData={structuredData}
  image={`/images/solutions-new/${heroImage.base}.webp`}
>
  <div class="sg-page-shell">
    <Header />
    <main id="main" class="sgk-page">
      <nav class="sgk-breadcrumbs" aria-label="Хлібні крихти">
        {breadcrumbItems.map((item, index) => (
          <>
            {index > 0 && <span aria-hidden="true">/</span>}
            {index === breadcrumbItems.length - 1
              ? <span aria-current="page">{item.label}</span>
              : <a href={item.href}>{item.label}</a>}
          </>
        ))}
      </nav>

      <section class="sgk-hero">
        <div class="sgk-hero__copy">
          <p class="eyebrow">Рішення · Для квартири</p>
          <h1>{h1}</h1>
          <p class="lead">{heroLead}</p>
          <div class="sgk-hero__actions">
            <a class="button button--mint" href="#solution-request">Отримати розрахунок</a>
            <a class="button button--outline" href="/projects/">Переглянути проєкти</a>
          </div>
        </div>
        <div class="sgk-hero__media">
          <img
            src={`/images/solutions-new/${heroImage.base}.webp`}
            srcset={heroSrcset}
            sizes={heroSizes}
            width={heroImage.width}
            height={heroImage.height}
            alt={heroImage.alt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </section>

      <section class="sgk-section" aria-label="Які конструкції підходять для квартири">
        <div class="sgk-section-head"><p class="eyebrow">Продукти</p><h2>Які конструкції підходять для квартири</h2><p>Найчастіше квартирі потрібне поєднання кількох рішень: душова кабіна у ванній, перегородка для зонування й двері чи дзеркало під конкретну стіну.</p></div>
        <div class="sgk-product-grid">
          {productLinks.map((item) => (
            <article class="sgk-product-card">
              <h3><a href={item.href}>{item.label}</a></h3>
              <p set:html={item.html} />
              <div class="sgk-product-card__foot">
                <a href={item.href} aria-hidden="true">→</a>
                {item.calc && <a class="sgk-product-card__calc" href={item.calc}>Розрахувати вартість онлайн</a>}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="sgk-section" aria-label="Реальні сценарії для квартири">
        <div class="sgk-section-head"><p class="eyebrow">Задачі об’єкта</p><h2>Реальні сценарії</h2></div>
        <div class="sgk-scenario-grid">
          {scenarios.map((scenario) => (
            <article class="sgk-scenario-card">
              <h3>{scenario.title}</h3>
              <p>{scenario.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="sgk-section">
        <div class="sgk-section-head"><p class="eyebrow">Вибір рішення</p><h2>Як обрати рішення</h2><p>Формат конструкції залежить від кімнати, вологості, освітлення й того, наскільки простір потребує приватності. Детальний розбір — у гайді <a href="/knowledge/yak-obraty-sklyanu-perehorodku/">як обрати скляну перегородку</a>.</p></div>
        <div class="sgk-choose-grid">
          {choosePoints.map((point) => (
            <article class="sgk-choose-card">
              <h3>{point.title}</h3>
              <p>{point.text}</p>
              {point.link && <a class="sgk-inline-link" href={point.link.href}>{point.link.label} →</a>}
            </article>
          ))}
        </div>
      </section>

      <section class="sgk-section">
        <div class="sgk-section-head"><p class="eyebrow">Матеріали</p><h2>Матеріали та скло</h2></div>
        <div class="sgk-material-grid">
          {materials.map((material) => (
            <article class="sgk-material-card">
              <h3>{material.title}</h3>
              <p>{material.text}</p>
              {material.link && <a class="sgk-inline-link" href={material.link.href}>{material.link.label} →</a>}
            </article>
          ))}
        </div>
      </section>

      <section class="sgk-section">
        <div class="sgk-section-head"><p class="eyebrow">Вартість</p><h2>Скільки коштують скляні конструкції для квартири</h2><p>Фіксованої ціни немає — вартість завжди прораховується під конкретний об’єкт. На неї впливають:</p></div>
        <ul class="sgk-price-list">
          {priceFactors.map((factor) => <li>{factor}</li>)}
        </ul>
        <p class="sgk-price-note">Орієнтовну вартість перегородки можна отримати онлайн у <a href="/peregorodky-configurator/">калькуляторі перегородок</a> або дзеркала — у <a href="/dzerkala-configurator/">калькуляторі дзеркал</a>. Детальніше про фактори ціни — у статті <a href="/knowledge/vid-choho-zalezhyt-tsina-sklyanoyi-konstruktsiyi/">від чого залежить вартість скляної конструкції</a>.</p>
      </section>

      <section class="sgk-section">
        <div class="sgk-section-head"><p class="eyebrow">Безпека</p><h2>Безпека та приватність</h2></div>
        <div class="sgk-safety-grid">
          {safetyPoints.map((point) => (
            <article class="sgk-safety-card">
              <h3>{point.title}</h3>
              <p>{point.text}</p>
              {point.link && <a class="sgk-inline-link" href={point.link.href}>{point.link.label} →</a>}
            </article>
          ))}
        </div>
      </section>

      {projects.length > 0 && (
        <section class="sgk-section sgk-projects">
          <div class="sgk-section-head"><p class="eyebrow">Проєкти</p><h2>Реалізовані об’єкти</h2></div>
          <div class="projects-index-v2__grid">
            {projects.map((project) => <ProjectCard project={project} hrefPrefix="/projects" />)}
          </div>
          <a class="sgk-text-link" href="/projects/">Усі реалізовані проєкти Space Glass →</a>
        </section>
      )}

      <section class="sgk-section sgk-experience">
        <div class="sgk-section-head"><p class="eyebrow">Досвід</p><h2>Досвід Space Glass</h2></div>
        <div class="sgk-experience-grid">
          {experienceStats.map((stat) => (
            <div class="sgk-experience-stat"><b>{stat.value}</b><span>{stat.label}</span></div>
          ))}
        </div>
        <a class="sgk-text-link" href="/about/">Детальніше про компанію Space Glass →</a>
      </section>

      <section class="sgk-section">
        <div class="sgk-section-head"><p class="eyebrow">Процес</p><h2>Як ми працюємо</h2></div>
        <div class="sgk-process-grid">
          {processSteps.map((step, index) => (
            <div class="sgk-process-step">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <b>{step.title}</b>
              <p>{step.text}</p>
            </div>
          ))}
        </div>
        <a class="sgk-text-link" href="/poslugy/">Детальніше про процес роботи Space Glass →</a>
      </section>

      <section class="sgk-section sgk-geography">
        <div class="sgk-section-head"><p class="eyebrow">Географія</p><h2>Працюємо у вашому місті</h2></div>
        <p>Space Glass реалізує проєкти у Києві, Одесі, Львові та інших містах України. Команда виконує замір, проєктування, виготовлення, доставку та монтаж конструкцій відповідно до вимог конкретного об’єкта.</p>
        <div class="sgk-city-links">
          {cityLinks.map((city) => <a href={city.href}>{city.label}</a>)}
        </div>
      </section>

      <section class="sgk-section">
        <FAQBlock
          title="FAQ про скляні конструкції для квартири: вибір, безпека та монтаж"
          intro="Відповідаємо на 20 основних питань про скляні конструкції для квартири — вибір скла, безпеку, вартість і монтаж."
          items={faq}
          visibleCount={6}
        />
      </section>

      <section class="sgk-section">
        <div class="sgk-section-head"><p class="eyebrow">Інше рішення</p><h2>Дивіться також</h2></div>
        <a class="sgk-cross" href="/rishennya/dlya-budynku/">
          <h3>Для будинку</h3>
          <p>Скляні огорожі, навіси, тераси, безрамне скління та алюмінієві системи для приватного будинку.</p>
          <b aria-hidden="true">→</b>
        </a>
      </section>

      <SolutionRequestForm solutionTitle={h1} example="Loft-перегородка для кухні з матовим склом у Києві" />
    </main>
    <Footer />
  </div>
</BaseLayout>
