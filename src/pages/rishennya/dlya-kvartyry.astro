  { label: 'Скляні двері', href: '/sklyani-dveri/', html: 'Розпашні, розсувні та приховані двері в алюмінієвому профілі.' },
  { label: 'Дзеркала на замовлення', href: '/dzerkala/', html: 'Дзеркала з LED-підсвіткою, у рамі та за індивідуальною формою.', calc: '/dzerkala-configurator/' },
  { label: 'Скляні огорожі', href: '/sklyani-ohorozhi/', html: 'Огорожі сходів і антресолей для дворівневих квартир.' }
];

const scenarios = [
  { title: 'Ванна без другого вікна', text: 'Прозора або злегка тонована душова перегородка не забирає єдине джерело світла в кімнаті — на відміну від глухої стіни чи шторки.' },
  { title: 'Кухня-студія без стін', text: 'Розсувна скляна перегородка відокремлює кухню від вітальні, коли потрібно локалізувати запахи, і повністю відкриває простір в інший час.' },
  { title: 'Дворівнева квартира зі сходами', text: 'Скляна огорожа замінює глухі перила й зберігає світло між поверхами дуплексу чи мансарди.' },
  { title: 'Гардеробна замість комори', text: 'Скляні двері чи розсувна система відкривають гардеробну, не перевантажуючи невеликий коридор глухими стулками.' }
];

const materials = [
  { title: 'Загартоване скло', text: 'Базовий матеріал для душових кабін, перегородок і дверей — безпечне при пошкодженні та стійке до вологи й перепадів температури.' },
  { title: 'Товщина скла', text: 'Товщину для перегородок і дверей підбирають індивідуально — за розміром полотна, кількістю опор і навантаженням.', link: { label: 'Як обирають товщину скла', href: '/knowledge/tovshchyna-skla-8-10-12-mm/' } },
  { title: 'Триплекс', text: 'Застосовується для огорож сходів і антресолей у дворівневих квартирах, де скло несе конструктивне навантаження.' },
  { title: 'Алюмінієвий профіль', text: 'Формує каркас перегородок і дверей, доступний у різних кольорах під інтер’єр — від чорного матового до природного алюмінію.' }
];

const choosePoints = [
  { title: 'Скло для вологих зон', text: 'Для душових кабін і перегородок у ванній застосовують загартоване скло з водовідштовхувальним покриттям — воно витримує перепади температури й довше залишається чистим без розводів.' },
  { title: 'Матове чи прозоре скло', text: 'Матове, сатиноване або тоноване скло приховує кімнату від сусідніх приміщень, зберігаючи світло. Прозоре скло підходить там, де приватність не критична — наприклад, для перегородки кухні-студії.' },
  { title: 'Розсувні чи розпашні системи', text: 'У невеликих кімнатах розсувні двері й перегородки економлять простір для відкривання. Розпашні системи звичніші в експлуатації й підходять для просторих санвузлів і гардеробних.', link: { label: 'Розпашні чи розсувні двері: як обрати', href: '/knowledge/rozpashni-chy-rozsuvni-sklyani-dveri/' } }
];

const safetyPoints = [
  { title: 'Безпечне скло', text: 'Загартоване скло при пошкодженні розсипається на дрібні тупі гранули без гострих країв — це стандарт безпеки для душових, дверей і перегородок у житловому просторі.', link: { label: 'Як обрати душову кабіну зі скла', href: '/knowledge/yak-obraty-dushovu-kabinu/' } },
  { title: 'Приватність без глухих стін', text: 'Матування, сатинування чи тонування закривають кімнату від сторонніх очей, зберігаючи природне світло — актуально для санвузла, гардеробної чи спальні за перегородкою.' },
  { title: 'Безпека для дітей і побуту', text: 'Кромки скла обробляються, а фурнітура підбирається під навантаження конкретної конструкції, щоб виключити люфт і випадкове защемлення.' }
];

const priceFactors = [
  'площа й кількість полотен конструкції',
  'тип і товщина скла',
  'колір і система профілю',
  'фурнітура та тип відкривання',
  'складність геометрії приміщення',
  'монтаж і доступ до об’єкта'
];

const processSteps = [
  { title: 'Консультація', text: 'Уточнюємо задачу, тип приміщення, бажаний результат і орієнтовний бюджет.' },
  { title: 'Замір', text: 'Виїжджаємо на об’єкт і фіксуємо фактичну геометрію отвору чи приміщення.' },
  { title: 'Проєктування', text: 'Готуємо креслення з розмірами, склом, профілем і вузлами кріплення.' },
  { title: 'Виготовлення', text: 'Виробляємо конструкцію на власному обладнанні під погоджені параметри.' },
  { title: 'Доставка', text: 'Пакуємо та доставляємо готову конструкцію в Києві, Одесі, Львові та по Україні.' },
  { title: 'Монтаж', text: 'Встановлюємо, перевіряємо роботу механізмів і передаємо об’єкт із гарантією.' }
];

const experienceStats = [
  { value: '10+', label: 'років реального досвіду в реалізації скляних та алюмінієвих конструкцій' },
  { value: '5 000+', label: 'реалізованих проєктів для дому та бізнесу в Україні та Європі' },
  { value: '50 000+', label: 'м² виконаного засклення житлових та комерційних об’єктів' }
];

const cityLinks = [
  { label: 'Київ', href: '/city/kyiv/' },
  { label: 'Одеса', href: '/city/odesa/' },
  { label: 'Львів', href: '/city/lviv/' }
];

const faq: [string, string][] = [
  ['Яке скло краще для душової кабіни в квартирі?', 'Загартоване скло товщиною від 6 до 10 мм із водовідштовхувальним покриттям — воно безпечне, витримує вологість і легше очищується від вапняного нальоту.'],
  ['Чи можна замовити перегородку без демонтажу ремонту?', 'Так, більшість перегородок і дверей монтуються в готовий отвір після фінальних поверхонь без порушення сусідніх стін.'],
  ['Скільки коштує скляна перегородка для квартири?', 'Вартість залежить від розмірів, типу скла, профілю та фурнітури. Попередній розрахунок готуємо після фото та приблизних розмірів.'],
  ['Чи роблять дзеркала за нестандартною формою?', 'Так, дзеркала виготовляють за будь-якою погодженою формою, розміром і типом підсвітки під конкретну стіну чи нішу.'],
  ['Чи потрібен професійний замір?', 'Для точного виготовлення так — фінальний замір проводять після завершення стін, підлоги й стелі у зоні монтажу.'],
  ['Чи можна отримати попередній розрахунок без виїзду майстра?', 'Так, для орієнтовної оцінки достатньо фото приміщення, приблизних розмірів і побажань щодо скла — точну вартість підтверджуємо після заміру.'],
  ['Яка товщина скла використовується для цільноскляних перегородок?', 'Зазвичай від 6 до 16 мм — конкретну товщину підбирають залежно від розміру, способу кріплення й навантаження на конструкцію.'],
  ['Чим загартоване скло безпечніше звичайного?', 'При пошкодженні воно розсипається на дрібні тупі гранули без гострих країв, тоді як звичайне скло утворює небезпечні уламки.'],
  ['Чи можна зробити перегородку матовою для приватності?', 'Так, доступні матове, сатиноване й тоноване скло — вони приховують кімнату від сусідніх приміщень, зберігаючи природне світло.'],
  ['Чи підходять розсувні двері для маленької кімнати?', 'Так, розсувні системи не потребують простору для відкривання стулки, тому економлять місце в невеликих кімнатах і коридорах.'],
  ['Скільки триває виготовлення перегородки чи дверей?', 'Строк залежить від розмірів, скла та фурнітури, фіксується після погодження креслення і комплектації.'],
  ['Чи можна змінити розміри після оформлення замовлення?', 'До запуску у виробництво — так, після повторного погодження. Загартоване скло після виготовлення вже не підрізають і не свердлять.'],
  ['Чи можна встановити скляну конструкцію в орендованій квартирі?', 'Так, за погодженням із власником — перегородки, двері та душові монтуються без порушення несучих стін і комунікацій.'],
  ['Як доглядати за скляною перегородкою чи дверима?', 'Використовуйте неабразивні засоби, регулярно очищайте напрямні й ущільнення, звертайтеся в сервіс при появі люфту.'],
  ['Чи глушить скляна перегородка звук між кімнатами?', 'Скляна перегородка не замінює капітальну стіну за рівнем звукоізоляції, але щільні притвори й товще скло помітно знижують побутовий шум і зберігають відчуття окремого приміщення.'],
  ['Чим loft-перегородка відрізняється від звичайної скляної?', 'Loft-перегородка має видимий металевий профіль-сітку, що ділить полотно на секції, — впізнаваний стиль для кухні чи вітальні. Звичайна перегородка може бути суцільним полотном без цього поділу.'],
  ['Чи безпечні скляні перегородки для дітей?', 'Так, застосовується загартоване або ламіноване скло без гострих країв, а фурнітура підбирається під навантаження конкретної конструкції.'],
  ['Чи можна замовити лише виготовлення без монтажу?', 'У частині випадків так, із доставкою готової конструкції — деталі узгоджуються індивідуально.'],
  ['Чи потрібен окремий каркас для дзеркала з LED-підсвіткою?', 'Ні, підсвітка інтегрується безпосередньо в конструкцію дзеркала ще на етапі проєктування.'],
  ['Що робити, якщо стіни у квартирі нерівні?', 'Відхилення фіксуються під час заміру та враховуються профілями кріплення або індивідуальною геометрією скла.']
];


const breadcrumbItems = [
  { label: 'Головна', href: '/' },
  { label: 'Рішення', href: '/rishennya/' },
  { label: 'Для квартири', href: PATH }
];

const structuredData: JsonLdObject[] = [
  breadcrumbSchema(breadcrumbItems.map((item) => ({ label: item.label, href: absoluteUrl(item.href, origin) }))),
  faqSchema(faq.map(([question, answer]) => ({ question, answer })))
].filter(Boolean) as JsonLdObject[];
---
<SolutionDetailPage
  path={PATH}
  title={title}
  description={description}
  h1={h1}
  heroLead={heroLead}
  heroImage={heroImage}
  scenarios={scenarios}
  choosePoints={choosePoints}
  materials={materials}
  safetyPoints={safetyPoints}
  priceFactors={priceFactors}
  processSteps={processSteps}
  experienceStats={experienceStats}
  faq={faq}
  breadcrumbItems={breadcrumbItems}
  structuredData={structuredData}
  formExample="Loft-перегородка для кухні з матовим склом у Києві"
/>
