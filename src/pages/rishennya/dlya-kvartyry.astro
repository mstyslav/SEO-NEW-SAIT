  {
    label: 'Скляні перегородки',
    href: '/sklyani-perehorodky/',
    html: '<a href="/sklyani-perehorodky/loft/">Loft</a>, <a href="/sklyani-perehorodky/mizhkimnatni/">міжкімнатні</a> та <a href="/sklyani-perehorodky/rozsuvni/">розсувні</a> перегородки для зонування квартири.',
    calc: '/peregorodky-configurator/'
