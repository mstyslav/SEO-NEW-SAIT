---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const solutions = [
  ['Для квартири', 'Скляні перегородки, душові кабіни, двері, дзеркала та огородження для сучасних квартир.', '/images/v5/project-1.webp', '/rishennya/dlya-kvartyry/', 'Сучасна квартира зі скляною перегородкою в чорному алюмінієвому профілі'],
  ['Для приватного будинку', 'Скляні огородження, тераси, душові, перегородки, фасадне скління та вхідні групи.', '/images/v5/project-2.webp', '/rishennya/dlya-budynku/', 'Сучасний приватний будинок з панорамним фасадним склінням і скляною терасою'],
  ['Для офісу', 'Скляні офісні перегородки, двері, мобільні системи та фасадне скління для бізнес-просторів.', '/images/v5/project-3.webp', '/rishennya/dlya-ofisu/', 'Сучасний офіс зі скляними перегородками та дверима в алюмінієвому профілі'],
  ['Для готелю', 'Скляні душові, перегородки, огородження, дзеркала, вхідні групи та фасадне скління.', '/images/v5/project-4.webp', '/rishennya/dlya-hotelyu/', 'Преміальний готель зі скляною вхідною групою та панорамним фасадним склінням'],
  ['Для ресторану', 'Скляні перегородки, фасади, вхідні групи, двері, тераси, дзеркала та декоративне скло.', '/images/s19/menu-loft.webp', '/rishennya/dlya-restoranu/', 'Сучасний ресторан з панорамним скляним фасадом і скляними перегородками'],
  ['Для магазину', 'Скляні вітрини, фасадне скління, вхідні групи, двері та перегородки для магазинів і шоурумів.', '/images/v5/project-3.webp', '/rishennya/dlya-magazynu/', 'Преміальний магазин зі скляною вітриною, фасадом та вхідною групою']
];
---
<BaseLayout title="Скляні конструкції для дому та бізнесу | Space Glass" description="Скляні конструкції на замовлення для квартир, будинків, офісів, готелів, ресторанів і магазинів: перегородки, двері, душові, огородження, вітрини та фасадне скління Space Glass.">
  <div class="sg-page-shell">
    <Header />
    <main id="main">
      <section class="projects-v14-hero">
        <p class="eyebrow">Готові рішення</p>
        <h1>Скляні конструкції для дому та бізнесу</h1>
        <p class="lead">Готові рішення Space Glass для житлових і комерційних просторів: від проєктування та виготовлення до професійного монтажу скляних конструкцій.</p>
      </section>
      <section class="projects-v14-grid" aria-label="Скляні рішення за типом об’єкта">
        {solutions.map(([title, description, image, href, alt]) => <a href={href}>
          <div><img src={image} alt={alt} width="640" height="416" loading="lazy" decoding="async" /></div>
          <small>Готове рішення</small>
          <h2>{title}</h2>
          <p>{description}</p>
          <b>Переглянути рішення →</b>
        </a>)}
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
