---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import TrustBar from '../../components/TrustBar.astro';
import Footer from '../../components/Footer.astro';
import FAQBlock from '../../components/FAQBlock.astro';
import { SOLUTIONS, CITY_LINKS, PROCESS_STEPS } from '../../data/solutions';
import { absoluteUrl, faqSchema, type JsonLdObject } from '../../seo/schema';
import loftProject from '../../content/projects/loft-kyiv.json';
import hotelProject from '../../content/projects/hotel-dvoryanskyi-showers-odesa.json';
import lvivProject from '../../content/projects/shower-sloped-ceiling-lviv.json';
import restaurantProject from '../../content/projects/restaurant-glazing-artshat-odesa.json';
import '../../styles/solutions.css';

const origin = Astro.site ?? Astro.url.origin;
const faqItems: [string, string][] = [
  ['Що надіслати для попереднього розрахунку?', 'Достатньо фото місця монтажу, приблизних розмірів і короткого опису задачі. Якщо є креслення або дизайн-проєкт, додайте їх до запиту.'],
  ['Як зрозуміти, яка конструкція підійде моєму об’єкту?', 'Спочатку визначаємо функцію конструкції, доступний простір, спосіб відкривання, потребу в приватності та умови експлуатації. Після цього підбираємо скло, профіль і фурнітуру.'],
  ['Які скляні перегородки обрати для житлового або робочого простору?', 'Вибір залежить від потрібної звукоізоляції, приватності, способу відкривання та геометрії приміщення. Після заміру підбираємо формат скла, профілю й кріплень.'],
  ['Які бувають скляні двері?', 'Використовують розпашні, розсувні та маятникові системи. Конкретний тип визначаємо за доступним місцем, частотою користування та вимогами до інтер’єру.'],
  ['Як вибрати душову кабіну зі скла?', 'Враховуємо розміри й геометрію зони, розташування сантехніки, напрямок відкривання та спосіб відведення води. Конструкцію виготовляємо за фактичними розмірами.'],
  ['Яке скло використовують для огорож?', 'Тип, товщину та спосіб кріплення визначають за геометрією, висотою і розрахунковими навантаженнями. Для відповідальних конструкцій можуть застосовувати загартоване скло або триплекс.'],
  ['Коли підходить безрамне скління?', 'Безрамні системи обирають, коли важливі панорамність, природне світло та мінімальна кількість видимих профілів. Можливість застосування залежить від отвору й умов експлуатації.'],
  ['Що таке загартоване скло?', 'Це термічно оброблене скло з підвищеною механічною та термічною стійкістю. У разі руйнування воно розпадається на дрібні фрагменти.'],
  ['Що таке триплекс?', 'Триплекс складається з кількох шарів скла, з’єднаних плівкою або спеціальним складом. При пошкодженні фрагменти утримуються всередині багатошарової структури.'],
  ['Яку товщину скла потрібно обрати?', 'Товщину не визначають лише за зовнішнім виглядом. Вона залежить від розміру полотна, типу конструкції, кріплень, навантажень і умов використання.'],
  ['Наскільки безпечні скляні конструкції?', 'Безпеку забезпечує правильний тип скла, розрахована товщина, відповідна фурнітура та професійний монтаж. Комплектацію підбирають для конкретної конструкції й умов експлуатації.'],
  ['Яке скло краще: прозоре, матове чи тоноване?', 'Прозоре зберігає максимум світла, матове додає приватності, а тоноване змінює сприйняття простору й зменшує візуальну відкритість. Вибір залежить від задачі та інтер’єру.'],
  ['Як підібрати профіль і фурнітуру?', 'Враховуємо вагу скла, спосіб відкривання, інтенсивність використання, колірні рішення та умови монтажу. Усі елементи мають працювати як одна система.'],
  ['Коли потрібно проводити замір?', 'Точний замір виконують після готовності поверхонь і прорізів, що впливають на конструкцію. Це дозволяє коректно підготувати креслення та вузли примикання.'],
  ['Від чого залежить вартість конструкції?', 'Від розмірів, типу й товщини скла, профілю, фурнітури, способу відкривання, складності виготовлення, доставки та монтажу. Точний розрахунок можливий після узгодження комплектації.'],
  ['Чи можна виконати конструкцію за готовим дизайн-проєктом?', 'Так. Креслення й візуалізації використовуємо як основу, а технічні вузли та розміри уточнюємо після перевірки фактичної геометрії об’єкта.'],
  ['Чи виготовляєте конструкції за індивідуальними розмірами?', 'Так. Розміри та конфігурацію визначаємо за результатами заміру, технічними умовами об’єкта й погодженим рішенням.'],
  ['Скільки триває виготовлення?', 'Термін залежить від типу конструкції, скла, обробки, фурнітури та складності проєкту. Його визначаємо після узгодження креслень і комплектації.'],
  ['Що входить у монтаж скляної конструкції?', 'Склад робіт залежить від системи та об’єкта. Перед початком погоджуємо підготовку місця, доставку, монтаж, регулювання фурнітури й перевірку готової конструкції.'],
  ['Де Space Glass виконує замір і монтаж?', 'Працюємо у Києві, Одесі та Львові, а також реалізуємо проєкти в інших містах України. Формат виїзду, доставки й монтажу погоджуємо окремо.']
];

const faqStructuredData = faqSchema(faqItems.map(([question, answer]) => ({ question, answer })));
const structuredData: JsonLdObject[] = [
  {
    '@type': 'ItemList',
    name: 'Скляні рішення за типом об’єкта',
    numberOfItems: SOLUTIONS.length,
    itemListElement: SOLUTIONS.map((solution, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: solution.navLabel,
      url: absoluteUrl(solution.path, origin)
    }))
  },
  ...(faqStructuredData ? [faqStructuredData] : [])
];

const categoryLinks = [
  { label: 'Скляні перегородки', href: '/sklyani-perehorodky/' },
  { label: 'Скляні двері', href: '/sklyani-dveri/' },
  { label: 'Душові кабіни', href: '/dushovi-kabiny/' },
  { label: 'Скляні огорожі', href: '/sklyani-ohorozhi/' },
  { label: 'Безрамне скління', href: '/bezramne-configurator/' },
  { label: 'Дзеркала', href: '/dzerkala/' },
  { label: 'Архітектурні системи', href: '/arkhitekturni-systemy/' },
  { label: 'Алюмінієві конструкції', href: '/alyuminiievi-konstruktsii/' }
];

const featuredProjects = [loftProject, hotelProject, lvivProject, restaurantProject];
const experienceStats = [
  ['5 000+', 'реалізованих проєктів'],
  ['50 000+', 'м² виконаного засклення'],
  ['10+ років', 'реального досвіду'],
  ['Україна', 'Київ · Одеса · Львів']
];
const choosePoints = [
  ['Призначення простору', 'Для житлового інтер’єру важливі світло, приватність і зручність відкривання. Для бізнесу також враховуємо потік людей та інтенсивність використання.'],
  ['Тип і безпека скла', 'Загартоване скло застосовують у душових, дверях і перегородках. Для огорож та інших відповідальних ділянок тип і товщину визначають за конструкцією та навантаженням.'],
  ['Прозорість і приватність', 'Прозоре скло зберігає максимум світла. Матове, тоноване або декоративне допомагає відокремити приватні зони без масивних стін.'],
  ['Спосіб відкривання', 'Розпашна система потребує вільної зони перед полотном. Розсувна економить місце, але вимагає точної геометрії напрямних і примикань.']
];
---
<BaseLayout
  title="Скляні рішення для квартири, будинку й бізнесу | Space Glass"
  description="Скляні рішення для квартири, будинку та бізнесу: перегородки, двері, душові, огорожі й системи скління. Проєктування, виготовлення та монтаж у Києві, Одесі, Львові та по Україні."
  locale="uk"
  schemaType="CollectionPage"
  structuredData={structuredData}
  heroPreloadSrc="/images/solutions-new/rishennya-hero-desktop.webp"
  heroPreloadSrcset="/images/solutions-new/rishennya-hero-desktop.webp 1280w"
  heroPreloadSizes="(max-width: 900px) calc(100vw - 32px), 48vw"
>
  <div class="sg-page-shell">
    <Header />
    <main id="main" class="rishennya-hub">
      <div class="rishennya-hub__wrap">
        <header class="rishennya-hub__hero">
          <div class="rishennya-hub__hero-copy">
            <p class="eyebrow">Рішення Space Glass</p>
            <h1>Скляні рішення за типом об’єкта</h1>
            <p class="lead">Скляні та алюмінієві конструкції для квартири, будинку та бізнесу: скляні перегородки, Loft-перегородки й скляні двері, душові кабіни, огорожі, дзеркала, навіси, безрамне, панорамне та фасадне скління, алюмінієві вікна, двері й розсувні системи, перголи та ZIP-системи сонцезахисту. Проєктуємо та виготовляємо конструкції за індивідуальними розмірами, виконуємо замір, доставку й монтаж у Києві, Одесі, Львові та по Україні.</p>
            <div class="rishennya-hub__hero-actions">
              <a class="button button--mint" href="#solutions">Обрати рішення</a>
              <a class="button button--outline" href="/quote/">Надіслати проєкт</a>
            </div>
          </div>
          <div class="rishennya-hub__hero-media">
            <picture>
              <source media="(max-width: 900px)" srcset="/images/solutions-new/rishennya-hero-mobile.webp" />
              <img
                src="/images/solutions-new/rishennya-hero-desktop.webp"
                width="1280"
                height="1001"
                alt="Скляні рішення Space Glass — креслення, зразки скла та алюмінієві профілі"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          </div>
        </header>
        <TrustBar />

        <section class="rishennya-hub__solutions" id="solutions" aria-labelledby="solutions-title">
          <div class="solution-section-head">
            <p class="eyebrow">За типом об’єкта</p>
            <h2 id="solutions-title">Рішення для житлових і комерційних просторів</h2>
            <p>Оберіть простір, щоб переглянути відповідні конструкції, приклади реалізацій і рекомендації з вибору.</p>
          </div>
          <div class="rishennya-hub__grid">
            {SOLUTIONS.map((solution) => (
              <a class="rishennya-hub__card" href={solution.path}>
                <div class="rishennya-hub__card-media">
                  <img
                    src={`/images/solutions-new/${solution.heroImage.base}-800.webp`}
                    srcset={`/images/solutions-new/${solution.heroImage.base}-640.webp 640w, /images/solutions-new/${solution.heroImage.base}-800.webp 800w, /images/solutions-new/${solution.heroImage.base}.webp ${solution.heroImage.width}w`}
                    sizes="(max-width: 700px) calc(100vw - 32px), (max-width: 1050px) 50vw, 33vw"
                    width={solution.heroImage.width}
                    height={solution.heroImage.height}
                    alt={solution.heroImage.alt}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="rishennya-hub__card-body">
                  <p>Скляні рішення</p>
                  <h3>{solution.navLabel}</h3>
                  <span>{solution.hubCardText}</span>
                  <b>Рішення {solution.navLabel.toLowerCase()} <span aria-hidden="true">→</span></b>
                </div>
              </a>
            ))}
          </div>
        </section>

        <section class="rishennya-hub__section rishennya-hub__projects" aria-labelledby="projects-title">
          <div class="solution-section-head">
            <p class="eyebrow">Реальні об’єкти</p>
            <h2 id="projects-title">Реалізовані рішення Space Glass</h2>
            <p>Реальні проєкти Space Glass у Києві, Одесі, Львові та по Україні: скляні перегородки, Loft-перегородки й скляні двері, душові кабіни, огорожі, безрамне, панорамне та фасадне скління, алюмінієві конструкції, перголи й ZIP-системи. Показуємо задачу, підібране рішення, матеріали та готовий результат на конкретному об’єкті.</p>
          </div>
          <div class="rishennya-showcase">
            {featuredProjects.map((project) => (
              <a class="rishennya-showcase__card" href={`/projects/${project.slug}/`}>
                <div class="rishennya-showcase__media">
                  <img
                    src={project.cover.src.replace('.webp', '-480.webp')}
                    srcset={`${project.cover.src.replace('.webp', '-480.webp')} 480w, ${project.cover.width > 720 ? project.cover.src.replace('.webp', '-720.webp') : project.cover.src} ${Math.min(project.cover.width, 720)}w`}
                    sizes="(max-width: 700px) calc(100vw - 32px), (max-width: 1050px) 50vw, 25vw"
                    width={project.cover.width}
                    height={project.cover.height}
                    alt={project.cover.alt}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="rishennya-showcase__body">
                  <p>{project.city} · {project.constructionType}</p>
                  <h3>{project.cardTitle}</h3>
                  <b>Переглянути проєкт <span aria-hidden="true">→</span></b>
                </div>
              </a>
            ))}
          </div>
          <a class="rishennya-hub__section-link" href="/projects/">Дивитися всі проєкти →</a>
        </section>

        <section class="rishennya-hub__section rishennya-hub__categories" aria-labelledby="categories-title">
          <div class="solution-section-head"><p class="eyebrow">Категорії</p><h2 id="categories-title">Які конструкції можна поєднати в одному проєкті</h2><p>В одному проєкті Space Glass поєднує скляні та алюмінієві конструкції: перегородки, двері, огорожі, навіси, безрамне скління, алюмінієві вікна й розсувні системи, перголи та ZIP-системи сонцезахисту. Узгоджуємо скло, профіль, фурнітуру, колір і геометрію конструкцій для квартир, будинків, офісів та комерційних об’єктів.</p></div>
          <div class="rishennya-hub__category-links">
            {categoryLinks.map((item) => <a href={item.href}>{item.label}<span aria-hidden="true">↗</span></a>)}
          </div>
        </section>

        <section class="rishennya-hub__section rishennya-experience" aria-labelledby="experience-title">
          <div class="rishennya-experience__copy">
            <p class="eyebrow">Досвід Space Glass</p>
            <h2 id="experience-title">Досвід, підтверджений реалізованими об’єктами</h2>
            <p>Space Glass працює зі скляними та алюмінієвими конструкціями з 2014 року. Супроводжуємо житлові, комерційні й архітектурні проєкти від консультації та креслень до виготовлення, логістики й монтажу.</p>
            <a class="rishennya-hub__section-link" href="/about/">Про Space Glass →</a>
          </div>
          <div class="rishennya-experience__stats">
            {experienceStats.map(([value, label]) => <article><strong>{value}</strong><span>{label}</span></article>)}
          </div>
        </section>

        <section class="rishennya-hub__section rishennya-choose" aria-labelledby="choose-title">
          <div class="solution-section-head"><p class="eyebrow">Практичний вибір</p><h2 id="choose-title">Що врахувати перед вибором конструкції</h2></div>
          <div class="rishennya-choose__grid">
            {choosePoints.map(([title, text], index) => <article><span>0{index + 1}</span><h3>{title}</h3><p>{text}</p></article>)}
          </div>
          <a class="rishennya-hub__section-link" href="/quote/">Отримати рекомендацію для свого об’єкта →</a>
        </section>

        <section class="rishennya-hub__section rishennya-process" aria-labelledby="process-title">
          <div class="solution-section-head"><p class="eyebrow">Від ідеї до монтажу</p><h2 id="process-title">Як проходить реалізація проєкту</h2></div>
          <div class="solution-process-grid">
            {PROCESS_STEPS.map((step, index) => <article class="solution-process-step"><span>0{index + 1}</span><b>{step.title}</b><p>{step.text}</p></article>)}
          </div>
        </section>

        <section class="rishennya-hub__section rishennya-hub__geography" aria-labelledby="geography-title">
          <div class="solution-section-head"><p class="eyebrow">Географія</p><h2 id="geography-title">Реалізуємо проєкти у Києві, Одесі, Львові та по Україні</h2><p>Географія впливає на організацію заміру, доставки та монтажу, але не змінює принцип роботи: конструкцію проєктують за фактичними параметрами об’єкта.</p></div>
          <div class="rishennya-cities">
            {CITY_LINKS.map((city) => <a href={city.href}><span>{city.label}</span><b>Проєкти та послуги <i aria-hidden="true">→</i></b></a>)}
          </div>
          <p class="rishennya-hub__geography-note">Для інших міст України формат заміру, доставки й монтажу погоджуємо відповідно до типу та масштабу проєкту.</p>
        </section>

        <section class="rishennya-hub__section rishennya-faq">
          <FAQBlock title="Поширені запитання про скляні рішення" items={faqItems} visibleCount={6} variant="compact" locale="uk" />
        </section>

        <section class="rishennya-final-cta" aria-labelledby="cta-title">
          <div><p class="eyebrow">Ваш проєкт</p><h2 id="cta-title">Підберемо рішення під ваш простір</h2><p>Надішліть фото, приблизні розміри або креслення. Уточнимо задачу, запропонуємо відповідну конструкцію та підготуємо попередній розрахунок.</p></div>
          <div class="rishennya-final-cta__actions"><a class="button button--mint" href="/quote/">Надіслати проєкт</a><a class="button button--outline" href="/contacts/">Зв’язатися з командою</a></div>
        </section>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
