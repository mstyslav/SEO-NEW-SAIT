---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SOLUTIONS, CITY_LINKS } from '../../data/solutions';
import { absoluteUrl, breadcrumbSchema, type JsonLdObject } from '../../seo/schema';
import '../../styles/solutions.css';

const origin = Astro.site ?? Astro.url.origin;
const breadcrumbItems = [
  { label: 'Головна', href: '/' },
  { label: 'Рішення', href: '/rishennya/' }
];
const structuredData: JsonLdObject[] = [
  breadcrumbSchema(breadcrumbItems.map((item) => ({ label: item.label, href: absoluteUrl(item.href, origin) })))
];

const categoryLinks = [
  { label: 'Скляні перегородки', href: '/sklyani-perehorodky/' },
  { label: 'Скляні двері', href: '/sklyani-dveri/' },
  { label: 'Душові кабіни', href: '/dushovi-kabiny/' },
  { label: 'Скляні огорожі', href: '/sklyani-ohorozhi/' },
  { label: 'Безрамне скління', href: '/bezramne-configurator/' },
  { label: 'Дзеркала', href: '/dzerkala/' },
  { label: 'Архітектурні системи', href: '/arkhitekturni-systemy/' },
  { label: 'Алюмінієві конструкції', href: '/alyuminiievi-konstruktsii/' }
];
---
<BaseLayout
  title="Скляні рішення для дому та бізнесу | Space Glass"
  description="Скляні конструкції для квартир, будинків, офісів, ресторанів, готелів і магазинів. Перегородки, двері, душові, огорожі та алюмінієві системи Space Glass у Києві, Одесі, Львові та по Україні."
  locale="uk"
  schemaType="CollectionPage"
  structuredData={structuredData}
>
  <div class="sg-page-shell">
    <Header />
    <main id="main" class="rishennya-hub">
      <nav class="rishennya-hub__breadcrumbs" aria-label="Хлібні крихти">
        <a href="/">Головна</a><span aria-hidden="true">/</span><span aria-current="page">Рішення</span>
      </nav>

      <div class="rishennya-hub__wrap">
        <header class="rishennya-hub__hero">
          <p class="eyebrow">Рішення</p>
          <h1>Скляні рішення для дому та бізнесу</h1>
          <p class="lead">Проєктуємо, виготовляємо та монтуємо скляні й алюмінієві конструкції для житлових і комерційних просторів у Києві, Одесі, Львові та по всій Україні.</p>
        </header>

        <section class="rishennya-hub__grid" aria-label="Рішення за типом об’єкта">
          {SOLUTIONS.map((solution) => (
            <a class="rishennya-hub__card" href={solution.path}>
              <div class="rishennya-hub__card-media">
                <img
                  src={`/images/solutions-new/${solution.heroImage.base}.webp`}
                  srcset={`/images/solutions-new/${solution.heroImage.base}-640.webp 640w, /images/solutions-new/${solution.heroImage.base}.webp ${solution.heroImage.width}w`}
                  sizes="(max-width: 700px) calc(100vw - 32px), (max-width: 1050px) 50vw, 33vw"
                  width={solution.heroImage.width}
                  height={solution.heroImage.height}
                  alt={solution.heroImage.alt}
                  loading={solution.slug === 'dlya-kvartyry' ? 'eager' : 'lazy'}
                  fetchpriority={solution.slug === 'dlya-kvartyry' ? 'high' : undefined}
                  decoding="async"
                />
              </div>
              <div class="rishennya-hub__card-body">
                <p>Скляні рішення</p>
                <h2>{solution.navLabel}</h2>
                <span>{solution.hubCardText}</span>
                <b aria-hidden="true">Переглянути рішення →</b>
              </div>
            </a>
          ))}
        </section>

        <section class="rishennya-hub__categories" aria-label="Скляні конструкції за категоріями">
          <div class="solution-section-head"><p class="eyebrow">Категорії</p><h2>Скляні конструкції за категоріями</h2><p>Кожне рішення поєднує кілька продуктових напрямків Space Glass — від скляних перегородок і дверей до безрамного скління та алюмінієвих систем.</p></div>
          <div class="rishennya-hub__category-links">
            {categoryLinks.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>
        </section>

        <section class="rishennya-hub__geography" aria-label="Географія робіт">
          <div class="solution-section-head"><p class="eyebrow">Географія</p><h2>Працюємо у вашому місті</h2></div>
          <p>Space Glass реалізує проєкти у Києві, Одесі, Львові та інших містах України. Команда виконує замір, проєктування, виготовлення, доставку та монтаж конструкцій відповідно до вимог конкретного об’єкта.</p>
          <div class="solution-city-links">
            {CITY_LINKS.map((city) => <a href={city.href}>{city.label}</a>)}
          </div>
        </section>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
