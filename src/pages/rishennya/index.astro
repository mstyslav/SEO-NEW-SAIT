---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// Base-file width varies per image because a few sources had
// their existing external white-margin artifact cropped out — the -640
// variant is regenerated from the same cropped source, so it's always
// exactly 640w, but the "full" srcset candidate's real w-descriptor must
// match its actual pixel width or the browser's responsive-selection math
// is (very slightly) wrong. See git history for the crop rationale/pixels.
const solutions = [
  ['Для квартири', 'Скляні перегородки, душові кабіни, двері, дзеркала та огородження для сучасних квартир.', '/images/solutions-new/solution-apartment.webp', '/rishennya/dlya-kvartyry/', 'Сучасна квартира зі скляною перегородкою в чорному алюмінієвому профілі', 1280],
  ['Для будинку', 'Скляні огородження, тераси, душові, перегородки, фасадне скління та вхідні групи.', '/images/solutions-new/solution-house.webp', '/rishennya/dlya-budynku/', 'Сучасний приватний будинок з панорамним фасадним склінням і скляною терасою', 1280],
  ['Для офісу', 'Скляні офісні перегородки, двері, мобільні системи та фасадне скління для бізнес-просторів.', '/images/solutions-new/solution-office-meeting-room.webp', '/rishennya/dlya-ofisu/', 'Сучасний офіс зі скляними перегородками та дверима в алюмінієвому профілі', 1280],
  ['Для готелю', 'Скляні душові, перегородки, огородження, дзеркала, вхідні групи та фасадне скління.', '/images/solutions-new/solution-hotel.webp', '/rishennya/dlya-hotelyu/', 'Преміальний готель зі скляною вхідною групою та панорамним фасадним склінням', 1280],
  ['Для ресторану', 'Скляні перегородки, фасади, вхідні групи, двері, тераси, дзеркала та декоративне скло.', '/images/solutions-new/solution-restaurant.webp', '/rishennya/dlya-restoranu/', 'Сучасний ресторан з панорамним скляним фасадом і скляними перегородками', 1280],
  ['Для магазину', 'Скляні вітрини, фасадне скління, вхідні групи, двері та перегородки для магазинів і шоурумів.', '/images/solutions-new/solution-shop.webp', '/rishennya/dlya-magazynu/', 'Преміальний магазин зі скляною вітриною, фасадом та вхідною групою', 1280]
];
import "../../styles/projects-v14.css";
---
<BaseLayout title="Скляні конструкції для дому та бізнесу | Space Glass" description="Скляні конструкції на замовлення для квартир, будинків, офісів, готелів, ресторанів і магазинів: перегородки, двері, душові, огородження, вітрини та фасадне скління Space Glass.">
  <div class="sg-page-shell">
    <Header />
    <main id="main">
      <section class="projects-v14-hero">
        <p class="eyebrow">Рішення</p>
        <h1>Скляні конструкції для дому та бізнесу</h1>
        <p class="lead">Рішення Space Glass для житлових і комерційних просторів: від проєктування та виготовлення до професійного монтажу скляних конструкцій.</p>
      </section>
      <section class="projects-v14-grid" aria-label="Скляні рішення за типом об’єкта">
        {solutions.map(([title, description, image, href, alt, fullWidth], index) => <a href={href}>
          <div class="solution-image"><img
            src={image}
            srcset={index === 0
              ? `${image.replace('.webp', '-640.webp')} 640w, ${image.replace('.webp', '-800.webp')} 800w, ${image} ${fullWidth}w`
              : `${image.replace('.webp', '-640.webp')} 640w, ${image.replace('.webp', '-800.webp')} 800w, ${image} ${fullWidth}w`}
            sizes="(max-width: 640px) calc(100vw - 48px), (max-width: 1000px) 50vw, 33vw"
            alt={alt}
            width="640"
            height="416"
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : undefined}
            decoding="async"
          /></div>
          <small>Скляні рішення</small>
          <h2>{title}</h2>
          <p>{description}</p>
          <b>Переглянути рішення →</b>
        </a>)}
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
  .projects-v14-grid > a {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border-radius: 18px;
    background: linear-gradient(145deg, #fff 80%, #f2faf6);
    transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
  }

  .projects-v14-grid > a:hover {
    border-color: #96cdb9;
    box-shadow: 0 16px 38px rgba(10, 70, 50, .08);
    transform: translateY(-2px);
  }

  .projects-v14-grid .solution-image {
    display: block;
    width: calc(100% + 2px);
    height: auto;
    min-height: 0;
    margin: -1px -1px 0;
    padding: 0;
    overflow: hidden;
    aspect-ratio: 20 / 13;
    background: none;
    line-height: 0;
  }

  .projects-v14-grid .solution-image img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    object-fit: cover;
    object-position: center;
    transform: scale(1.005);
  }

  @media (max-width: 760px) {
    .projects-v14-grid > a {
      border-radius: 14px;
    }

    .projects-v14-grid .solution-image {
      aspect-ratio: 16 / 9;
    }
  }
</style>
