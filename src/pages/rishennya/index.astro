---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const solutions = [
  ['Для квартири', 'Скляні перегородки, душові кабіни, двері, дзеркала та огородження на замовлення для сучасних квартир.', '/images/v5/project-1.webp', '/rishennya/dlya-kvartyry/', 'Скляні перегородки та конструкції для квартири'],
  ['Для приватного будинку', 'Скляні сходи й огородження, тераси, душові, перегородки, фасадне скління та вхідні групи для приватного будинку.', '/images/v5/project-2.webp', '/rishennya/dlya-budynku/', 'Скляні конструкції та фасадне скління приватного будинку'],
  ['Для офісу', 'Скляні офісні перегородки, двері, мобільні системи та фасадне скління для сучасних офісів і бізнес-просторів.', '/images/v5/project-3.webp', '/rishennya/dlya-ofisu/', 'Скляні офісні перегородки та двері'],
  ['Для готелю', 'Скляні душові, перегородки, огородження, дзеркала, вхідні групи та фасадне скління для готелів і апарт-готелів.', '/images/v5/project-4.webp', '/rishennya/dlya-hotelyu/', 'Скляні конструкції та фасадне скління для готелю'],
  ['Для ресторану', 'Скляні перегородки, фасади, вхідні групи, двері, тераси, дзеркала та декоративне скло для ресторанів і кафе.', '/images/s19/menu-loft.webp', '/rishennya/dlya-restoranu/', 'Скляні перегородки та фасад для ресторану'],
  ['Для магазину', 'Скляні вітрини, фасадне скління, вхідні групи, двері та перегородки на замовлення для магазинів, бутиків і шоурумів.', '/images/s19/menu-facades.webp', '/rishennya/dlya-magazynu/', 'Скляна вітрина та фасадне скління магазину']
];
---
<BaseLayout title="Скляні конструкції для дому та бізнесу | Space Glass" description="Скляні конструкції на замовлення для квартир, будинків, офісів, готелів, ресторанів і магазинів: перегородки, двері, душові, огородження, вітрини та фасадне скління Space Glass.">
  <div class="sg-page-shell">
    <Header />
    <main id="main">
      <section class="projects-v14-hero">
        <p class="eyebrow">Готові рішення</p>
        <h1>Скляні конструкції для дому та бізнесу</h1>
        <p class="lead">Готові рішення Space Glass для житлових і комерційних просторів: від проєктування та виготовлення до професійного монтажу скляних конструкцій.</p>
      </section>
      <section class="projects-v14-grid" aria-label="Скляні рішення за типом об’єкта">
        {solutions.map(([title, description, image, href, alt]) => <a href={href}>
          <div><img src={image} alt={alt} width="640" height="416" loading="lazy" decoding="async" /></div>
          <small>Готове рішення</small>
          <h2>{title}</h2>
          <p>{description}</p>
          <b>Переглянути рішення →</b>
        </a>)}
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
