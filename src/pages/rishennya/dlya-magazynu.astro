---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SolutionRequestForm from '../../components/SolutionRequestForm.astro';

const services = [
  ['Скляні вітрини', 'Панорамні вітрини для магазинів, бутиків і шоурумів з акцентом на максимальну прозорість та огляд товару.'],
  ['Фасадне скління', 'Сучасні скляні фасади та алюмінієві системи для торгових приміщень і комерційних об’єктів.'],
  ['Вхідні групи', 'Скляні двері, портали та вхідні конструкції, розраховані на інтенсивне щоденне використання.'],
  ['Скляні перегородки', 'Зонування торгового простору прозорими, матовими або декоративними скляними перегородками.'],
  ['Дзеркала та декоративне скло', 'Індивідуальні дзеркала, панелі та декоративні рішення для оформлення інтер’єру магазину.'],
  ['Індивідуальні конструкції', 'Проєктуємо нестандартні скляні рішення під архітектуру, бренд та конкретні розміри приміщення.']
];

const faq = [
  ['Яке скло використовують для магазинів?', 'Тип скла підбираємо відповідно до розмірів, конструкції та навантажень. Для безпечних комерційних рішень застосовуємо загартоване скло, триплекс та відповідні склопакети.'],
  ['Чи можна виготовити вітрину за індивідуальними розмірами?', 'Так. Вітрини, двері, перегородки та фасадні конструкції проєктуємо під конкретний проріз і дизайн торгового приміщення.'],
  ['Чи працюєте ви з дизайнерами та архітекторами?', 'Так. Можемо працювати за кресленнями проєктанта, допомагати з технічними рішеннями та підбором скла, профілю і фурнітури.'],
  ['Чи можливий монтаж у працюючому магазині?', 'Формат і графік монтажу погоджуємо індивідуально, щоб мінімізувати вплив робіт на роботу торгового приміщення.']
];
---
<BaseLayout title="Скляні вітрини та конструкції для магазинів | Space Glass" description="Скляні вітрини, фасадне скління, вхідні групи, двері та перегородки для магазинів, бутиків і шоурумів. Проєктування, виготовлення та монтаж Space Glass.">
  <div class="sg-page-shell">
    <Header />
    <main id="main">
      <section class="projects-v14-hero">
        <p class="eyebrow">Рішення · Для магазину</p>
        <h1>Скляні конструкції для магазинів, бутиків і шоурумів</h1>
        <p class="lead">Вітрини, фасадне скління, вхідні групи, двері та перегородки на замовлення. Створюємо прозорі комерційні простори, які відкривають товар покупцеві та підкреслюють архітектуру бренду.</p>
        <div class="hero__actions">
          <a class="button button--mint" href="#solution-request">Отримати розрахунок →</a>
          <a class="button button--outline" href="/projects/">Переглянути проєкти</a>
        </div>
      </section>

      <section class="sg-projects" aria-label="Скляні рішення для магазину">
        <div class="sg-projects__intro">
          <p class="eyebrow">Retail glass</p>
          <h2>Вітрина, яка працює на продаж</h2>
          <p>Скло дає максимум світла й огляду, а правильно спроєктовані профілі, двері та вузли створюють чистий сучасний фасад. Підбираємо рішення з урахуванням розмірів, безпеки, інтенсивності використання та дизайну приміщення.</p>
        </div>
        <a class="sg-project-image" href="#solution-request"><img src="/images/solutions/solution-shop.webp" width="1280" height="832" alt="Преміальний магазин зі скляною вітриною, фасадом та вхідною групою" fetchpriority="high" decoding="async" /></a>
      </section>

      <section class="sg-categories">
        <div class="sg-section-title"><h2>Що можемо реалізувати</h2></div>
        <div class="sg-categories__grid">
          {services.map(([title,text]) => (
            <a class="sg-category-card" href="#solution-request">
              <span class="sg-category-card__icon">◇</span>
              <h2>{title}</h2>
              <p>{text}</p>
              <b>→</b>
            </a>
          ))}
        </div>
      </section>

      <section class="sg-final-benefits">
        <div><span>◇</span><b>Індивідуальні розміри</b><small>Під конкретний торговий простір</small></div>
        <div><span>▱</span><b>Безпечне скло</b><small>Рішення відповідно до задачі конструкції</small></div>
        <div><span>⚒</span><b>Професійний монтаж</b><small>Точність вузлів та акуратна реалізація</small></div>
        <div><span>◯</span><b>Комплексне рішення</b><small>Від проєктування до готової конструкції</small></div>
      </section>

      <section class="section sg-faq">
        <div class="container">
          <p class="eyebrow">FAQ</p>
          <h2>Часті запитання про скління магазинів</h2>
          <div class="sg-categories__grid">
            {faq.map(([q,a]) => <div class="sg-category-card"><h2>{q}</h2><p>{a}</p></div>)}
          </div>
        </div>
      </section>

      <SolutionRequestForm solutionTitle="Скляні конструкції для магазину" example="Скляна вітрина та вхідна група для магазину у Львові" />
    </main>
    <Footer />
  </div>
</BaseLayout>
