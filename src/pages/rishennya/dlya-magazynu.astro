---
// Solution page — shared SolutionDetailPage template (same visual system as the
// catalog sections). This file keeps the page's own texts; tiles, projects and
// SEO copy come from src/data/solution-pages.ts.
import SolutionDetailPage from '../../components/solutions/SolutionDetailPage.astro';
import { absoluteUrl, breadcrumbSchema, faqSchema, type JsonLdObject } from '../../seo/schema';

const PATH = '/rishennya/dlya-magazynu/';
const origin = Astro.site ?? Astro.url.origin;

// PRIMARY intent = object type ("для магазину"), not product type — «скляні вітрини»
// remain a strong secondary/product cluster, not the primary target of this page.
const title = 'Скляні конструкції для магазину на замовлення | Space Glass';
const description =
  'Скляні конструкції для магазину на замовлення: вітрини, вхідні групи, перегородки та фасадні системи. Виготовлення й монтаж Space Glass у Києві, Одесі, Львові та по Україні.';
const h1 = 'Скляні конструкції для магазину';
const heroLead =
  'Вітрини, вхідні групи та перегородки для торгових приміщень — прозорі рішення, які відкривають товар покупцю з вулиці, в Києві, Одесі, Львові та по всій Україні.';
const heroImage = {
  base: 'solution-shop',
  width: 1280,
  height: 721,
  alt: 'Преміальний магазин зі скляною вітриною, фасадом та вхідною групою'
};

const productLinks = [
  { label: 'Архітектурні системи', href: '/arkhitekturni-systemy/', html: 'Фасадне скління та панорамні вітрини на першому поверсі.' },
  { label: 'Скляні двері', href: '/sklyani-dveri/', html: 'Вхідні групи для торгового приміщення з інтенсивним трафіком.' },
  { label: 'Скляні перегородки', href: '/sklyani-perehorodky/', html: 'Зонування торгового залу та примірочних без втрати огляду товару.' },
  { label: 'Алюмінієві конструкції', href: '/alyuminiyevi-konstrukcziyi/', html: 'Профільні системи для вітрин і вхідних груп.' }
];

const scenarios = [
  { title: 'Вітрина першого поверху з інтенсивним трафіком', text: 'Мінімум рам і посилена фурнітура вхідної групи витримують сотні відкривань щодня.' },
  { title: 'Торговий зал без глухих стін', text: 'Перегородки відокремлюють примірочні чи касову зону, зберігаючи огляд товару з будь-якої точки залу.' },
  { title: 'Бренд на фасаді', text: 'Гравіювання чи плівка з логотипом інтегруються прямо в скло вітрини замість окремої вивіски.' },
  { title: 'Примірочні без відчуття тісноти', text: 'Матоване чи сатиноване скло дає приватність примірочній зоні, не перетворюючи її на глуху кабінку.' }
];

const choosePoints = [
  { title: 'Триплекс для вітрини першого поверху', text: 'Скло, доступне з вулиці, вимагає підвищеної безпеки — при пошкодженні воно має лишатися в рамі, а не розсипатися на тротуар.', link: { label: 'Heat Soak Test загартованого скла: коли він потрібен', href: '/knowledge/heat-soak-test-zagartovanogo-skla/' } },
  { title: 'Підготовка приміщення до заміру', text: 'Точний розрахунок вітрини чи вхідної групи можливий лише після фінального заміру фактичного прорізу фасаду.', link: { label: 'Як підготувати простір до заміру', href: '/knowledge/yak-pidhotuvaty-prostir-do-zamiru/' } },
  { title: 'Фурнітура під трафік магазину', text: 'Двері з інтенсивною прохідністю комплектують посиленими доводчиками й напрямними, розрахованими на сотні відкривань щодня.' }
];

const materials = [
  { title: 'Триплекс', text: 'Основний матеріал для вітрин і фасадних конструкцій першого поверху — безпечний при ударному навантаженні з вулиці.' },
  { title: 'Загартоване скло', text: 'Застосовується для дверей і внутрішніх перегородок торгового приміщення.' },
  { title: 'Алюмінієві профільні системи', text: 'Формують мінімалістичний каркас вітрини та вхідної групи.' },
  { title: 'Фурнітура', text: 'Посилені доводчики й напрямні для дверей з високою інтенсивністю використання.' }
];

const priceFactors = [
  'площа вітрини чи фасаду',
  'тип і товщина скла',
  'система профілю',
  'фурнітура під трафік',
  'нанесення логотипа чи плівки',
  'монтаж і графік робіт у приміщенні'
];

const safetyPoints = [
  { title: 'Безпечне скло на рівні вулиці', text: 'Триплекс для вітрин не розсипається при пошкодженні — критично важливо для конструкцій, доступних перехожим.' },
  { title: 'Стійкість до щоденного трафіку', text: 'Вхідні групи з інтенсивним використанням комплектують фурнітурою, розрахованою на сотні відкривань щодня без втрати плавності ходу.' },
  { title: 'Перевірене загартоване скло', text: 'Для відповідальних конструкцій застосовується скло з підтвердженою термічною обробкою, що знижує ризик спонтанного руйнування.' }
];

const processSteps = [
  { title: 'Консультація', text: 'Уточнюємо задачу, тип приміщення, бажаний результат і орієнтовний бюджет.' },
  { title: 'Замір', text: 'Виїжджаємо на об’єкт і фіксуємо фактичну геометрію фасаду чи торгового залу.' },
  { title: 'Проєктування', text: 'Готуємо креслення з розмірами, склом, профілем і вузлами кріплення.' },
  { title: 'Виготовлення', text: 'Виробляємо конструкцію на власному обладнанні під погоджені параметри.' },
  { title: 'Доставка', text: 'Пакуємо та доставляємо готову конструкцію в Києві, Одесі, Львові та по Україні.' },
  { title: 'Монтаж', text: 'Встановлюємо, перевіряємо роботу механізмів і передаємо об’єкт із гарантією.' }
];

const experienceStats = [
  { value: '10+', label: 'років реального досвіду в реалізації скляних та алюмінієвих конструкцій' },
  { value: '5 000+', label: 'реалізованих проєктів для дому та бізнесу в Україні та Європі' },
  { value: '50 000+', label: 'м² виконаного засклення житлових та комерційних об’єктів' }
];

const cityLinks = [
  { label: 'Київ', href: '/city/kyiv/' },
  { label: 'Одеса', href: '/city/odesa/' },
  { label: 'Львів', href: '/city/lviv/' }
];

const faq: [string, string][] = [
  ['Яке скло використовують для вітрини магазину?', 'Найчастіше триплекс — при пошкодженні він залишається цілим, що важливо для конструкцій на рівні вулиці.'],
  ['Чи можна замовити вітрину за нестандартним розміром прорізу?', 'Так, вітрини й вхідні групи виготовляють за фактичною геометрією фасаду конкретного приміщення.'],
  ['Чи витримує вхідна група інтенсивний трафік?', 'Так, за умови посиленої фурнітури — доводчиків і напрямних, підібраних під очікувану кількість відкривань щодня.'],
  ['Чи можна нанести логотип або плівку на вітрину?', 'Так, гравіювання, тонування чи брендовану плівку наносимо за погодженим макетом.'],
  ['Скільки триває виготовлення вітрини?', 'Строк залежить від розмірів і складності конструкції, фіксується після заміру та погодження креслення.'],
  ['Чи можна інтегрувати підсвітку у вітрину?', 'Так, підсвітку узгоджуємо на етапі проєктування — вона підкреслює товар і фасад магазину в темний час доби.'],
  ['Що таке Heat Soak Test і чи потрібен він для вітрини?', 'Це додаткова термічна перевірка загартованого скла, яка знижує ризик спонтанного руйнування — застосовується для відповідальних фасадних конструкцій.'],
  ['Чи можна зонувати торговий зал без глухих перегородок?', 'Так, прозорі або матовані скляні перегородки відокремлюють примірочні чи касову зону, зберігаючи огляд товару.'],
  ['Чи проводите монтаж без зупинки роботи магазину?', 'Графік монтажу погоджуємо індивідуально, щоб мінімізувати вплив на роботу торгового приміщення.'],
  ['Чи можна замовити примірочні зі скляними дверима?', 'Так, матоване чи сатиноване скло забезпечує приватність, зберігаючи світло в примірочній зоні.'],
  ['Скільки коштує скляна вітрина для магазину?', 'Вартість залежить від площі, товщини скла, профілю та фурнітури. Попередній розрахунок готуємо після фото й приблизних розмірів.'],
  ['Чи потрібен професійний замір перед виготовленням?', 'Так, фінальний замір фіксує фактичну геометрію фасадного прорізу перед виготовленням вітрини.'],
  ['Чи можна замовити лише виготовлення без монтажу?', 'У частині випадків так, із доставкою готової конструкції — деталі узгоджуються індивідуально.'],
  ['Як доглядати за скляною вітриною магазину?', 'Використовуйте неабразивні засоби для скла та регулярно перевіряйте напрямні й ущільнення вхідної групи.'],
  ['Чи можна замовити розсувну вхідну групу для магазину?', 'Так, розсувні системи економлять простір проходу там, де прогнозується високий трафік покупців.'],
  ['Чи є гарантія на конструкції для магазину?', 'Так, гарантійні умови фіксуються в договорі та залежать від типу конструкції й обсягу проєкту.'],
  ['Чи можна працювати за кресленнями архітектора чи дизайнера?', 'Так, можемо реалізувати проєкт за наданими кресленнями, узгодивши технічні деталі скла й профілю.'],
  ['Чи можлива доставка обладнання в інші міста?', 'Так, реалізуємо проєкти по всій Україні — умови доставки й монтажу узгоджуються під конкретний об’єкт.'],
  ['Чи можна замінити частину вітрини без демонтажу всієї конструкції?', 'Це залежить від конструктиву — модульні системи дозволяють замінити окрему секцію, суцільні полотна виготовляють заново.'],
  ['Що робити, якщо фасад приміщення ще не готовий до заміру?', 'Попередній розрахунок можна отримати за кресленням чи фото проєкту, фінальний замір — після завершення фасадних робіт.']
];


const breadcrumbItems = [
  { label: 'Головна', href: '/' },
  { label: 'Рішення', href: '/rishennya/' },
  { label: 'Для магазину', href: PATH }
];

const structuredData: JsonLdObject[] = [
  breadcrumbSchema(breadcrumbItems.map((item) => ({ label: item.label, href: absoluteUrl(item.href, origin) }))),
  faqSchema(faq.map(([question, answer]) => ({ question, answer })))
].filter(Boolean) as JsonLdObject[];
---
<SolutionDetailPage
  path={PATH}
  title={title}
  description={description}
  h1={h1}
  heroLead={heroLead}
  heroImage={heroImage}
  scenarios={scenarios}
  choosePoints={choosePoints}
  materials={materials}
  safetyPoints={safetyPoints}
  priceFactors={priceFactors}
  processSteps={processSteps}
  experienceStats={experienceStats}
  faq={faq}
  breadcrumbItems={breadcrumbItems}
  structuredData={structuredData}
  formExample="Скляна вітрина та вхідна група для магазину у Львові"
/>
