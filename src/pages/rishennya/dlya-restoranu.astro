---
// Bespoke SEO/UX build, mirroring the approved /rishennya/dlya-kvartyry/ pattern.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQBlock from '../../components/FAQBlock.astro';
import SolutionRequestForm from '../../components/SolutionRequestForm.astro';
import ProjectCard from '../../components/projects/ProjectCard.astro';
import { absoluteUrl, breadcrumbSchema, faqSchema, type JsonLdObject } from '../../seo/schema';
import '../../styles/projects-common.css';
import '../../styles/solution-kvartyry.css';

const PATH = '/rishennya/dlya-restoranu/';
const origin = Astro.site ?? Astro.url.origin;

const title = 'Скляні конструкції для ресторану на замовлення | Space Glass';
const description =
  'Скляні конструкції для ресторану на замовлення: перегородки, вітрини, тераси та фасадне скління. Проєктування, виготовлення й монтаж Space Glass у Києві, Одесі, Львові та по Україні.';
const h1 = 'Скляні конструкції для ресторану';
const heroLead =
  'Перегородки, вітрини, тераси та фасадне скління для ресторанів і кафе — рішення, які зонують простір і зберігають видимість залу в Києві, Одесі, Львові та по всій Україні.';
const heroImage = {
  base: 'solution-restaurant',
  width: 1280,
  height: 854,
  alt: 'Сучасний ресторан з панорамним скляним фасадом і скляними перегородками'
};

const productLinks = [
  { label: 'Скляні перегородки', href: '/sklyani-perehorodky/', html: 'Зонування залу на приватні й загальні зони без втрати світла.' },
  { label: 'Скляні двері', href: '/sklyani-dveri/', html: 'Вхідні групи та двері між залами закладу.' },
  { label: 'Архітектурні системи', href: '/arkhitekturni-systemy/', html: 'Фасадне скління та панорамні вітрини на першому поверсі.' },
  { label: 'Безрамне скління', href: '/bezramne-configurator/', html: 'Скління літньої тераси без вертикальних рам.' },
  { label: 'Алюмінієві конструкції', href: '/alyuminiievi-konstruktsii/', html: 'Розсувні фасадні системи для сезонного відкриття тераси.' }
];

const scenarios = [
  { title: 'Тераса, яка живе сезонно', text: 'Розсувне чи безрамне скління відкриває терасу навесні й закриває на зимовий період без демонтажу конструкції.' },
  { title: 'Зал без відчуття тісноти', text: 'Прозорі або частково матові перегородки відокремлюють банкетну зону від загального залу, зберігаючи простір і світло.' },
  { title: 'Вітрина як частина вуличного трафіку', text: 'Панорамне фасадне скління показує інтер’єр перехожим ще до входу в заклад.' },
  { title: 'Приватна VIP-зона в залі', text: 'Скляна перегородка з дверима виділяє окремий кабінет для гостей, не ізолюючи його візуально від загального залу.' }
];

const choosePoints = [
  { title: 'Слайдингова чи складана система', text: 'Слайдингові панелі розсуваються вздовж напрямної, складані — збираються гармошкою збоку. Вибір залежить від ширини прорізу й бажаного кута відкриття.', link: { label: 'Слайдингова чи складна система скління: що краще', href: '/knowledge/slaydingova-chy-skladana-systema/' } },
  { title: 'Тепле чи холодне скління тераси', text: 'Холодний контур підходить для сезонної літньої тераси. Теплий контур зі склопакетом дозволяє використовувати простір і в прохолодну пору.', link: { label: 'Тепле чи холодне скління тераси: різниця', href: '/knowledge/teple-chy-kholodne-sklinnya-terasy/' } },
  { title: 'Безрамне скління для максимального огляду', text: 'Відсутність вертикальних стійок зберігає панораму вулиці чи двору — важливо для терас із видом, який є частиною атмосфери закладу.', link: { label: 'Системи безрамного скління: як обрати механіку', href: '/knowledge/bezramne-sklinnya-systemy-yak-obraty/' } }
];

const materials = [
  { title: 'Загартоване скло', text: 'Застосовується для перегородок і дверей у зоні обслуговування гостей — безпечне при інтенсивному використанні.' },
  { title: 'Триплекс', text: 'Використовується для фасадного скління та вітрин, де важлива додаткова безпека на рівні вулиці.' },
  { title: 'Алюмінієві розсувні системи', text: 'Дозволяють повністю відкривати терасу в теплий сезон і закривати на зиму.' },
  { title: 'Фурнітура', text: 'Ролики й напрямні для розсувних фасадів підбираються під частоту відкривання протягом дня.' }
];

const priceFactors = [
  'площа тераси чи фасаду',
  'тип системи скління — слайдингова, складана чи безрамна',
  'тепла чи холодна конструкція',
  'скло та фурнітура',
  'кількість дверних і фасадних груп',
  'монтаж і сезонність робіт'
];

const safetyPoints = [
  { title: 'Безпечне скло на рівні вулиці', text: 'Триплекс для вітрин і фасадних ділянок першого поверху не розсипається при пошкодженні — важливо для конструкцій, доступних з тротуару.' },
  { title: 'Стійкість до сезонних навантажень', text: 'Розсувні й безрамні системи терас розраховують на вітрове навантаження та цикли відкривання протягом сезону.' },
  { title: 'Гігієнічні поверхні в залі', text: 'Скляні перегородки й двері в зоні обслуговування гостей легко очищуються та не накопичують запахів, на відміну від текстильних розділювачів.' }
];

const processSteps = [
  { title: 'Консультація', text: 'Уточнюємо задачу, тип закладу, бажаний результат і орієнтовний бюджет.' },
  { title: 'Замір', text: 'Виїжджаємо на об’єкт і фіксуємо фактичну геометрію тераси, фасаду чи залу.' },
  { title: 'Проєктування', text: 'Готуємо креслення з розмірами, склом, профілем і вузлами кріплення.' },
  { title: 'Виготовлення', text: 'Виробляємо конструкцію на власному обладнанні під погоджені параметри.' },
  { title: 'Доставка', text: 'Пакуємо та доставляємо готову конструкцію в Києві, Одесі, Львові та по Україні.' },
  { title: 'Монтаж', text: 'Встановлюємо, перевіряємо роботу механізмів і передаємо об’єкт із гарантією.' }
];

const experienceStats = [
  { value: '10+', label: 'років реального досвіду в реалізації скляних та алюмінієвих конструкцій' },
  { value: '5 000+', label: 'реалізованих проєктів для дому та бізнесу в Україні та Європі' },
  { value: '50 000+', label: 'м² виконаного засклення житлових та комерційних об’єктів' }
];

const cityLinks = [
  { label: 'Київ', href: '/city/kyiv/' },
  { label: 'Одеса', href: '/city/odesa/' },
  { label: 'Львів', href: '/city/lviv/' }
];

const faq: [string, string][] = [
  ['Чи можна засклити терасу ресторану на літо?', 'Так, розсувні або безрамні системи дозволяють повністю відкривати терасу влітку й закривати на холодний сезон.'],
  ['Яке скло використовують для вітрини кафе?', 'Найчастіше триплекс — він безпечніший на рівні вулиці та витримує зовнішні навантаження.'],
  ['Чи можна зонувати зал без глухих перегородок?', 'Так, прозорі або частково матові скляні перегородки розділяють простір, зберігаючи світло й видимість залу.'],
  ['Чи проводите монтаж без зупинки роботи закладу?', 'Графік монтажу погоджуємо індивідуально, щоб мінімізувати вплив на роботу закладу.'],
  ['Чи можна нанести логотип на скло вітрини?', 'Так, гравіювання чи плівку з логотипом наносимо за погодженим макетом.'],
  ['Чи можна змінювати конфігурацію тераси між сезонами?', 'Так, розсувні та безрамні системи дозволяють щороку відкривати терасу навесні й закривати на зиму без заміни конструкції.'],
  ['Слайдингова чи складана система краще для тераси ресторану?', 'Слайдингова підходить для широких прорізів з рівномірним розсуванням, складана — там, де потрібен більший кут відкриття збоку.'],
  ['Чи запотіває скло вітрини взимку?', 'Це залежить від перепаду температур і вентиляції залу — енергоефективний склопакет знижує ризик конденсату.'],
  ['Чи можна відокремити банкетну залу без ремонту?', 'Так, скляні перегородки монтуються в готовий отвір без демонтажу стель і підлоги.'],
  ['Скільки коштує засклення тераси ресторану?', 'Вартість залежить від площі, типу системи та скла. Попередній розрахунок готуємо після фото й приблизних розмірів.'],
  ['Чи можна встановити двері прямо в скляну вітрину?', 'Так, вхідна група проєктується як частина фасадної конструкції ще на етапі креслення.'],
  ['Чи потрібен професійний замір для тераси?', 'Так, фінальний замір фіксує фактичну геометрію тераси чи фасаду перед виготовленням конструкції.'],
  ['Чи можна демонтувати скління тераси на зиму повністю?', 'Це залежить від обраної системи — розсувні й складані конструкції зазвичай не демонтують, а закривають на сезон.'],
  ['Чи витримує фасадне скління інтенсивний потік гостей?', 'Так, за умови посиленої фурнітури для дверей і вхідних груп із високою прохідністю.'],
  ['Скільки триває виготовлення терасного скління?', 'Строк залежить від площі й складності конструкції, фіксується після заміру та погодження креслення.'],
  ['Чи можна замовити лише виготовлення без монтажу?', 'У частині випадків так, із доставкою готової конструкції — деталі узгоджуються індивідуально.'],
  ['Як доглядати за розсувними системами тераси?', 'Регулярно очищайте напрямні від пилу й піску, перевіряйте ролики та ущільнення перед початком сезону.'],
  ['Чи можна засклити терасу нестандартної форми?', 'Так, конструкції проєктують за фактичною геометрією тераси конкретного закладу.'],
  ['Чи є гарантія на конструкції для ресторану?', 'Так, гарантійні умови фіксуються в договорі та залежать від типу системи й обсягу проєкту.'],
  ['Що робити, якщо приміщення закладу ще на етапі ремонту?', 'Попередній розрахунок можна отримати за кресленням чи планом приміщення, фінальний замір — після завершення чорнових робіт.']
];

const projectSlugs = ['restaurant-glazing-artshat-odesa', 'coffee-ocean-facade-odesa'];
const allProjects = await getCollection('projects', ({ data }) => data.status === 'published' && data.locale === 'uk');
const projects = projectSlugs
  .map((slug) => allProjects.find((p) => p.data.slug === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p))
  .map((p) => p.data);

const breadcrumbItems = [
  { label: 'Головна', href: '/' },
  { label: 'Рішення', href: '/rishennya/' },
  { label: 'Для ресторану', href: PATH }
];

const structuredData: JsonLdObject[] = [
  breadcrumbSchema(breadcrumbItems.map((item) => ({ label: item.label, href: absoluteUrl(item.href, origin) }))),
  faqSchema(faq.map(([question, answer]) => ({ question, answer })))
].filter(Boolean) as JsonLdObject[];

const heroSrcset = `/images/solutions-new/${heroImage.base}-640.webp 640w, /images/solutions-new/${heroImage.base}.webp ${heroImage.width}w`;
const heroSizes = '(max-width: 900px) 100vw, 50vw';
---
<BaseLayout
  title={title}
  description={description}
  locale="uk"
  alternateLocales={['uk']}
  schemaType="Service"
  structuredData={structuredData}
  image={`/images/solutions-new/${heroImage.base}.webp`}
>
  <div class="sg-page-shell">
    <Header />
    <main id="main" class="sgk-page">
      <nav class="sgk-breadcrumbs" aria-label="Хлібні крихти">
        {breadcrumbItems.map((item, index) => (
          <>
            {index > 0 && <span aria-hidden="true">/</span>}
            {index === breadcrumbItems.length - 1
              ? <span aria-current="page">{item.label}</span>
              : <a href={item.href}>{item.label}</a>}
          </>
        ))}
      </nav>

      <section class="sgk-hero">
        <div class="sgk-hero__copy">
          <p class="eyebrow">Рішення · Для ресторану</p>
          <h1>{h1}</h1>
          <p class="lead">{heroLead}</p>
          <div class="sgk-hero__actions">
            <a class="button button--mint" href="#solution-request">Отримати розрахунок</a>
            <a class="button button--outline" href="/projects/">Переглянути проєкти</a>
          </div>
        </div>
        <div class="sgk-hero__media">
          <img
            src={`/images/solutions-new/${heroImage.base}.webp`}
            srcset={heroSrcset}
            sizes={heroSizes}
            width={heroImage.width}
            height={heroImage.height}
            alt={heroImage.alt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </section>

      <section class="sgk-section" aria-label="Які конструкції підходять для ресторану">
        <div class="sgk-section-head"><p class="eyebrow">Продукти</p><h2>Які конструкції підходять для ресторану</h2><p>Закладу харчування зазвичай потрібне поєднання рішень: вітрина й фасад для вуличного трафіку, перегородки для залу та скління тераси.</p></div>
        <div class="sgk-product-grid">
          {productLinks.map((item) => (
            <article class="sgk-product-card">
              <h3><a href={item.href}>{item.label}</a></h3>
              <p set:html={item.html} />
              <div class="sgk-product-card__foot">
                <a href={item.href} aria-hidden="true">→</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="sgk-section" aria-label="Реальні сценарії для ресторану">
        <div class="sgk-section-head"><p class="eyebrow">Задачі об’єкта</p><h2>Реальні сценарії</h2></div>
        <div class="sgk-scenario-grid">
          {scenarios.map((scenario) => (
            <article class="sgk-scenario-card">
              <h3>{scenario.title}</h3>
              <p>{scenario.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="sgk-section">
        <div class="sgk-section-head"><p class="eyebrow">Вибір рішення</p><h2>Як обрати рішення</h2><p>У закладах харчування скло одночасно виконує зонування, впускає світло й формує вітрину для гостей із вулиці.</p></div>
        <div class="sgk-choose-grid">
          {choosePoints.map((point) => (
            <article class="sgk-choose-card">
              <h3>{point.title}</h3>
              <p>{point.text}</p>
              {point.link && <a class="sgk-inline-link" href={point.link.href}>{point.link.label} →</a>}
            </article>
          ))}
        </div>
      </section>

      <section class="sgk-section">
        <div class="sgk-section-head"><p class="eyebrow">Матеріали</p><h2>Матеріали та системи</h2></div>
        <div class="sgk-material-grid">
          {materials.map((material) => (
            <article class="sgk-material-card">
              <h3>{material.title}</h3>
              <p>{material.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="sgk-section">
        <div class="sgk-section-head"><p class="eyebrow">Вартість</p><h2>Скільки коштують скляні конструкції для ресторану</h2><p>Фіксованої ціни немає — вартість завжди прораховується під конкретний заклад. На неї впливають:</p></div>
        <ul class="sgk-price-list">
          {priceFactors.map((factor) => <li>{factor}</li>)}
        </ul>
        <p class="sgk-price-note">Детальніше про фактори ціни — у статті <a href="/knowledge/vid-choho-zalezhyt-tsina-sklyanoyi-konstruktsiyi/">від чого залежить вартість скляної конструкції</a>.</p>
      </section>

      <section class="sgk-section">
        <div class="sgk-section-head"><p class="eyebrow">Безпека</p><h2>Безпека та гігієна</h2></div>
        <div class="sgk-safety-grid">
          {safetyPoints.map((point) => (
            <article class="sgk-safety-card">
              <h3>{point.title}</h3>
              <p>{point.text}</p>
            </article>
          ))}
        </div>
      </section>

      {projects.length > 0 && (
        <section class="sgk-section sgk-projects">
          <div class="sgk-section-head"><p class="eyebrow">Проєкти</p><h2>Реалізовані об’єкти</h2></div>
          <div class="projects-index-v2__grid">
            {projects.map((project) => <ProjectCard project={project} hrefPrefix="/projects" />)}
          </div>
          <a class="sgk-text-link" href="/projects/">Усі реалізовані проєкти Space Glass →</a>
        </section>
      )}

      <section class="sgk-section sgk-experience">
        <div class="sgk-section-head"><p class="eyebrow">Досвід</p><h2>Досвід Space Glass</h2></div>
        <div class="sgk-experience-grid">
          {experienceStats.map((stat) => (
            <div class="sgk-experience-stat"><b>{stat.value}</b><span>{stat.label}</span></div>
          ))}
        </div>
        <a class="sgk-text-link" href="/about/">Детальніше про компанію Space Glass →</a>
      </section>

      <section class="sgk-section">
        <div class="sgk-section-head"><p class="eyebrow">Процес</p><h2>Як ми працюємо</h2></div>
        <div class="sgk-process-grid">
          {processSteps.map((step, index) => (
            <div class="sgk-process-step">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <b>{step.title}</b>
              <p>{step.text}</p>
            </div>
          ))}
        </div>
        <a class="sgk-text-link" href="/poslugy/">Детальніше про процес роботи Space Glass →</a>
      </section>

      <section class="sgk-section sgk-geography">
        <div class="sgk-section-head"><p class="eyebrow">Географія</p><h2>Працюємо у вашому місті</h2></div>
