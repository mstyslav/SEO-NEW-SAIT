---
// RU glass partitions hub (mirrors src/pages/sklyani-perehorodky/index.astro; content: src/data/ru/partition-catalog.ru.ts).
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FAQBlock from '../../../components/FAQBlock.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TrustBar from '../../../components/TrustBar.astro';
import ProjectCard from '../../../components/projects/ProjectCard.astro';
import ProfileRequestForm from '../../../components/profile/ProfileRequestForm.astro';
import { absoluteUrl, faqSchema, type JsonLdObject } from '../../../seo/schema';
import { PARTITION_HUB, PARTITION_IMG } from '../../../data/partition-catalog';
import { partitionCategoriesRu as partitionCategories, partitionHubSystemsRu as partitionHubSystems } from '../../../data/ru/partition-catalog.ru';
import { localizedPath } from '../../../i18n/helpers';
import { profileIcons } from '../../../data/profile-icons';
import '../../../styles/category-pages.css';
import '../../../styles/shower-master.css';
import '../../../styles/profile-systems.css';
import '../../../styles/projects-common.css';
import { HUB_CONFIGURATORS } from '../../../data/configurator-links';
import UsefulArticles from '../../../components/profile/UsefulArticles.astro';
import PartitionPriceBlock from '../../../components/pricing/PartitionPriceBlock.astro';
import { CARD_SYSTEM_PRICE, systemPricePerM2 } from '../../../pricing/partition-prices';

const lp = (path: string) => localizedPath(path, 'ru');
const origin = Astro.site ?? Astro.url.origin;
const pageUrl = absoluteUrl(lp(PARTITION_HUB), origin);

const title = 'Стеклянные перегородки';
const h1 = 'Стеклянные перегородки на заказ';
const metaTitle = 'Стеклянные перегородки на заказ — лофт, раздвижные | Space Glass';
const metaDescription =
  'Стеклянные перегородки для квартир и офисов: лофт, цельностеклянные, раздвижные, телескопические, с дверьми. Стекло и триплекс. Киев, Одесса, Львов.';

const heroSrc = (w: number) => `${PARTITION_IMG}/hero-hub-${w}.webp`;
const heroSrcset = `${heroSrc(480)} 480w, ${heroSrc(900)} 900w, ${heroSrc(1080)} 1080w`;
const heroSizes = '(max-width: 900px) 100vw, 50vw';

const hubItems = partitionCategories.map((category) => ({ title: category.name, note: category.cardNote, href: lp(category.path), icon: profileIcons[`partitions/${category.slug}`] }));

const projectSlugs = ['sklyani-peregorodky-dlya-ofisu-v-m-odesa', 'mizhkimnatni-peregorodky-v-styli-loft-zhk-atlant-m-kyyiv', 'rozdilennya-peregorodkomu-prostoru-ta-obklejka-lakobelem-dvernyh-portaliv-dlya-stomatalogii-m-odesa', 'dzerkalni-dveri-v-garderob', 'sklinni-riznogo-typu-dlya-gotelno-restorannogo-kompleksu-2', 'sklyani-peregorodky-u-garderobnu-v-m-odesa'];
const allProjects = (await getCollection('projects', ({ data }) => data.status === 'published' && data.locale === 'uk')).map(({ data }) => data);
const projects = projectSlugs.map((slug) => allProjects.find((project) => project.slug === slug)).filter((project): project is NonNullable<typeof project> => Boolean(project));

const benefits: [string, string][] = [
  ['Свет', 'Стекло делит пространство, но не забирает дневной свет.'],
  ['Быстро', 'Монтаж за 1 день, без мокрых работ и пыли.'],
  ['Безопасность', 'Закалённое стекло и триплекс без острых осколков.'],
  ['Тишина', 'Уплотнители и триплекс заметно снижают шум.'],
  ['Под интерьер', 'Прозрачное, матовое, рифлёное стекло; профиль любого цвета.'],
  ['Гарантия', '5 лет на стекло, 2 года на фурнитуру и 1 год на монтаж.']
];

const types: [string, string][] = [
  ['Стационарные', 'Неподвижные полотна в профиле или на зажимах — лофт и цельностеклянные перегородки.'],
  ['С дверьми', 'Распашные, раздвижные или маятниковые двери в одной линии с перегородкой.'],
  ['Раздвижные', 'Подвесные на верхней шине или нижнеопорные на направляющих, в том числе телескопические.'],
  ['Трансформирующиеся', '«Гармошка» или поворотные полотна, которые полностью открывают проём.']
];

const faq: [string, string][] = [
  ['Какие бывают стеклянные перегородки?', 'Стационарные (лофт и цельностеклянные), с дверьми, раздвижные — подвесные, нижнеопорные и телескопические, а также трансформирующиеся.'],
  ['Какое стекло используют?', 'Закалённое стекло 8–12 мм или триплекс — безопасные и прочные.'],
  ['Сколько стоит стеклянная перегородка?', 'Цена стеклянной перегородки зависит от площади, типа системы, толщины и обработки стекла, наличия дверей, фурнитуры и условий монтажа. Пришлите план или фото с размерами — подготовим расчёт под ваш проект.'],
  ['Какую перегородку выбрать для квартиры?', 'Лофт — лофт-перегородка в чёрном профиле, минимализм — перегородка в профиле или PUR на точках, без места для двери — раздвижные PIANO или SUSPENS.'],
  ['Какую перегородку выбрать для офиса?', 'Кабинеты — перегородка с дверью, переговорные в open space — CAJA, поток людей — PENDULA.'],
  ['Можно ли перегородку с дверью?', 'Да, распашной, раздвижной или маятниковой.'],
  ['Изолирует ли стеклянная перегородка звук?', 'Да, частично; с триплексом и уплотнителями — заметно лучше.'],
  ['Можно ли матовое или тонированное стекло?', 'Да, а также рифлёное и матирование полосами или логотипом.'],
  ['Чем подвесная перегородка отличается от нижнеопорной?', 'У подвесной вес на потолке и нет порога; у нижнеопорной — на полу, поэтому можно более крупные полотна.'],
  ['Что такое телескопическая перегородка?', 'Несколько раздвижных полотен на параллельных шинах, которые складываются одно за другим.'],
  ['Что такое трансформирующаяся перегородка?', 'Перегородка, полотна которой складываются «гармошкой» или откатываются и полностью освобождают проём.'],
  ['Нужно ли разрешение на перегородку?', 'Обычно нет — перегородка не несущая.'],
  ['Можно ли установить в готовом ремонте?', 'Да, монтаж чистый, без мокрых работ.'],
  ['Сколько длится монтаж?', 'Обычно один день для квартиры, 1–3 дня для офиса.'],
  ['Сколько ждать изготовления?', 'До 20 рабочих дней после согласования всех деталей проекта.'],
  ['Делаете ли чертёж?', 'Да, согласовываем размеры, сетку шпросов и двери до изготовления.'],
  ['Работаете ли с юридическими лицами?', 'Да, по договору, с полным пакетом документов.'],
  ['Как ухаживать за стеклом?', 'Средством для стекла и мягкой тряпкой; фурнитуру регулируем в рамках сервиса.'],
  ['Где выполняете замер и монтаж?', 'В Киеве, Одессе и Львове с областями.'],
  ['Есть ли гарантия?', 'Да, 5 лет на стекло, 2 года на фурнитуру и 1 год на монтаж.']
];

const relatedLinks: [string, string][] = [
  ['Межкомнатные стеклянные перегородки', '/sklyani-perehorodky/mizhkimnatni/'],
  ['Стеклянные двери', '/sklyani-dveri/'],
  ['Стеклянные межкомнатные двери', '/sklyani-perehorodky/sklyani-mizhkimnatni-dveri/'],
  ['Душевые кабины', '/dushovi-kabiny/'],
  ['Зеркала', '/dzerkala/'],
  ['Стекло для офиса', '/dlya-biznesu/dlya-ofisu/'],
  ['Для бизнеса', '/dlya-biznesu/'],
  ['Безрамное остекление', '/bezramne-sklinnya/'],
  ['Алюминиевые конструкции', '/alyuminiyevi-konstrukcziyi/']
];

const faqStructuredData = faqSchema(faq.map(([question, answer]) => ({ question, answer })));
const itemList: JsonLdObject = {
  '@type': 'ItemList',
  '@id': `${pageUrl}#directions`,
  name: title,
  numberOfItems: partitionCategories.length,
  itemListElement: partitionCategories.map((category, index) => ({ '@type': 'ListItem', position: index + 1, name: category.name, url: absoluteUrl(lp(category.path), origin) }))
};
const structuredData: JsonLdObject[] = [itemList, ...(faqStructuredData ? [faqStructuredData] : [])];
---
<BaseLayout
  title={metaTitle}
  description={metaDescription}
  image={heroSrc(1080)}
  locale="ru"
  schemaType="CollectionPage"
  structuredData={structuredData}
  alternateLocales={['uk', 'ru']}
  heroPreloadSrc={heroSrc(900)}
  heroPreloadSrcset={heroSrcset}
  heroPreloadSizes={heroSizes}
>
<div class="sg-page-shell">
  <Header />
  <main id="main">
    <section class="category-hero category-hero--photo profile-hero">
      <div class="category-hero__copy">
        <Breadcrumbs items={[{ label: 'Главная', href: lp('/') }, { label: title }]} />
        <p class="eyebrow">{title}</p>
        <h1>{h1}</h1>
        <p class="lead">Перегородки из стекла для квартир, домов, офисов, клиник и салонов: лофт, цельностеклянные, раздвижные, трансформирующиеся и с дверьми. Зонирование без потери света — замер, изготовление и монтаж в Киеве, Одессе и Львове.</p>
        <div class="hero__actions">
          <a class="button button--mint" href="#types">Выбрать вид</a>
          <a class="button button--outline" href="#request">Получить расчёт</a>
          <a class="button button--outline" href={lp(HUB_CONFIGURATORS['/sklyani-perehorodky/'])}>Рассчитать в конфигураторе</a>
        </div>
      </div>
      <figure class="category-hero__figure">
        <div class="category-hero__frame">
          <img src={heroSrc(900)} srcset={heroSrcset} sizes={heroSizes} alt="Стеклянная перегородка между спальней и гардеробной" width="1080" height="772" decoding="async" fetchpriority="high" />
        </div>
      </figure>
    </section>

    <TrustBar locale="ru" />

    <section class="category-section category-section--mint">
      <div class="category-heading"><div><p class="eyebrow">Space Glass</p><h2>Зонирование без глухих стен</h2></div></div>
      <div class="category-intro-grid">
        <div class="category-prose">
          <p>Стеклянная перегородка делит пространство на зоны, но оставляет свет и ощущение простора. Она тоньше стены, монтируется за день и не требует мокрых работ — поэтому её выбирают и для квартир, и для офисов.</p>
          <p>Мы изготавливаем стационарные перегородки в тонком профиле и на точечных зажимах, лофт-перегородки в чёрном профиле, перегородки с распашными, раздвижными и маятниковыми дверями, подвесные, нижнеопорные, телескопические и трансформирующиеся системы.</p>
          <p>Ниже — виды перегородок и системы, с которыми мы работаем.</p>
        </div>
        <ul class="category-intro__spec">
          <li><b>9 видов</b><span>от лофт до трансформирующихся</span></li>
          <li><b>Стекло 8–12 мм</b><span>закалённое или триплекс</span></li>
          <li><b>Монтаж за 1 день</b><span>без мокрых работ</span></li>
          <li><b>Киев · Одесса · Львов</b><span>замер, монтаж и сервис</span></li>
        </ul>
      </div>
    </section>

    <section id="types" class="category-section">
      <div class="category-heading"><div><p class="eyebrow">Виды</p><h2>Какие стеклянные перегородки мы делаем</h2></div><p>Выберите вид — на каждой странице системы с фото, характеристиками и советами.</p></div>
      <div class="category-icon-grid category-icon-grid--showers">
        {hubItems.map((item) => (
          <a class="category-icon-card" href={item.href}>
            <span class="category-icon-card__icon" set:html={item.icon} />
            <h3>{item.title}</h3>
            <p>{item.note}</p>
            <b aria-hidden="true">→</b>
          </a>
        ))}
      </div>
    </section>

    <section id="systems" class="category-section category-section--mint">
      <div class="category-heading"><div><p class="eyebrow">Системы</p><h2>Системы стеклянных перегородок</h2></div><p>Больше систем — на страницах видов.</p></div>
      <div class="profile-grid">
        {partitionHubSystems.map((system) => (
          <article class="profile-card">
            <div class="profile-card__media">
              <img src={`${PARTITION_IMG}/${system.image}-480.webp`} srcset={`${PARTITION_IMG}/${system.image}-480.webp 480w, ${PARTITION_IMG}/${system.image}-900.webp 900w`} sizes="(max-width: 700px) 90vw, (max-width: 1100px) 44vw, 30vw" alt={system.alt} width="480" height="480" loading="lazy" decoding="async" />
              <span class="profile-card__kind">{system.title ? `${system.name} · ${system.kind}` : system.kind}</span>
            </div>
            <div class="profile-card__body">
              <h3>{system.title ?? system.name}</h3>
              <p class="profile-card__blurb">{system.blurb}</p>
              {CARD_SYSTEM_PRICE[system.key] && <p class="profile-card__price"><strong>Ориентировочная стоимость от {systemPricePerM2(CARD_SYSTEM_PRICE[system.key]).toLocaleString('uk-UA')} грн/м²</strong><span>с монтажом</span></p>}
              <a class="button button--mint profile-card__cta" href={lp(system.href)}>Подробнее о системе →</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <PartitionPriceBlock variant="hub" locale="ru" />

    <section class="category-section">
      <div class="category-heading"><div><p class="eyebrow">Конструкция</p><h2>Как работает перегородка</h2></div><p>От типа конструкции зависят проход, место и внешний вид.</p></div>
      <dl class="material-thickness">
        {types.map(([name, text]) => <div><dt>{name}</dt><dd>{text}</dd></div>)}
      </dl>
    </section>

    <section class="category-section category-section--mint">
      <div class="category-heading"><div><p class="eyebrow">Преимущества</p><h2>Почему стеклянная перегородка</h2></div></div>
      <div class="material-grid material-grid--parts">
        {benefits.map(([name, text]) => <article><b>{name}</b><p>{text}</p></article>)}
      </div>
    </section>

    {projects.length > 0 && (
      <section class="category-section">
        <div class="category-heading category-heading--projects">
          <div class="category-heading--projects__title"><p class="eyebrow">Портфолио</p><h2>Наши стеклянные перегородки</h2></div>
          <div class="category-heading--projects__aside"><a class="category-arrow-link" href={lp('/project/')}>Все проекты <span aria-hidden="true">→</span></a></div>
        </div>
        <div class="projects-index-v2__grid category-projects-grid">
          {projects.map((project) => <ProjectCard project={project} locale="ru" href={lp(`/project/${project.slug}/`)} />)}
        </div>
      </section>
    )}

    <section class="category-process">
      <div class="category-heading"><div><p class="eyebrow eyebrow--light">Процесс</p><h2>От замера до готовой перегородки</h2></div></div>
      <div class="category-process__grid">
        <div><span>01</span><b>Запрос</b><small>План или фото с размерами</small></div>
        <div><span>02</span><b>Консультация</b><small>Система, стекло, двери</small></div>
        <div><span>03</span><b>Замер</b><small>Стены, пол, потолок</small></div>
        <div><span>04</span><b>Чертёж</b><small>Размеры, шпросы, двери</small></div>
        <div><span>05</span><b>Изготовление</b><small>Закалка стекла под размер</small></div>
        <div><span>06</span><b>Монтаж</b><small>Чистый монтаж за 1 день</small></div>
      </div>
    </section>

    <section class="category-section category-geo">
      <div class="category-geo__grid">
        <div class="category-geo__copy">
          <p class="eyebrow">География</p>
          <h2>Стеклянные перегородки: замер и монтаж<br />в Киеве, Одессе и Львове</h2>
          <p>Выезжаем на замер, согласовываем чертёж, изготавливаем и монтируем перегородки в квартирах, домах, офисах, клиниках и заведениях.</p>
          <p>Для объектов в других регионах условия согласовываем отдельно.</p>
        </div>
        <ul class="category-geo__cities"><li><b>Киев</b><span>замер и монтаж</span></li><li><b>Одесса</b><span>замер и монтаж</span></li><li><b>Львов</b><span>замер и монтаж</span></li></ul>
      </div>
    </section>

    <UsefulArticles path="/sklyani-perehorodky/" locale="ru" />

    <section class="category-section category-section--faq">
      <FAQBlock title="FAQ о стеклянных перегородках" intro="О видах, стекле, дверях, звукоизоляции, цене и монтаже." items={faq} visibleCount={6} expandTo={faq.length} locale="ru" />
    </section>

    <section class="category-section category-links">
      <div class="category-heading"><div><p class="eyebrow">Полезное</p><h2>Дальше по теме</h2></div></div>
      <div class="category-links__grid category-links__grid--8">
        {relatedLinks.map(([label, href]) => <a href={lp(href)}>{label}</a>)}
      </div>
    </section>

    <ProfileRequestForm
      page={lp(PARTITION_HUB)}
      product={title}
      title={'Нужен предварительный расчёт?'}
      text={'Пришлите план или фото помещения с размерами — подберём систему и подготовим ориентировочную стоимость.'}
      options={[...partitionCategories.map((c) => c.name), ...partitionHubSystems.map((s) => s.title ?? s.name)]}
      optionsLabel="Вид или система"
      commentPlaceholder="Помещение (квартира, офис), размеры, нужны ли двери, стекло, город"
      locale="ru"
    />
  </main>
  <Footer />
</div>
</BaseLayout>
