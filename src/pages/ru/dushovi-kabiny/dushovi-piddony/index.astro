---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import FAQBlock from '../../../../components/FAQBlock.astro';
import TrustBar from '../../../../components/TrustBar.astro';
import PriceBlock from '../../../../components/PriceBlock.astro';
import { absoluteUrl, faqSchema, type JsonLdObject } from '../../../../seo/schema';
import { piddonySeriesRu as piddonySeries, formatUah, seriesPriceFromRu } from '../../../../data/dushovi-piddony';
import { localizedPath } from '../../../../i18n/helpers';
import '../../../../styles/category-pages.css';
import '../../../../styles/shower-master.css';

const locale = 'ru' as const;
const lp = (path: string) => localizedPath(path, locale);

const origin = Astro.site ?? Astro.url.origin;
const pageUrl = absoluteUrl('/ru/dushovi-kabiny/dushovi-piddony/', origin);

const title = 'Душевые поддоны';
const metaTitle = 'Душевые поддоны — купить поддон для душа из искусственного камня | Space Glass';
const metaDescription =
  'Душевые поддоны из искусственного мрамора и камня: квадратные, прямоугольные и пятиугольные, с сифоном в комплекте и противоскольжением. Выбор размера и цвета с ценами, подбор под стеклянную душевую Space Glass, доставка по Украине.';
const priceDisclaimer = 'Цены ориентировочные и зависят от выбранного размера и комплектации. Точную стоимость подтверждаем при заказе.';

const allPrices = piddonySeries.flatMap((s) =>
  s.variants.map((v) => v.price).filter((p): p is number => typeof p === 'number')
);
const overallFrom = formatUah(Math.min(...allPrices));
const priceDisclaimerSentences = priceDisclaimer.split(/(?<=\.) /);

// SSR initial selection for each card (works with JS disabled too).
const cardInit = piddonySeries.map((s) => {
  const firstAvailable = s.variants.find((v) => v.price !== null);
  const size = firstAvailable ? firstAvailable.size : s.sizes[0];
  const color = s.colors[0];
  const variant =
    s.variants.find((v) => v.size === size && v.color === color) ??
    s.variants.find((v) => v.size === size);
  const known = !!variant && typeof variant.price === 'number';
  const config = `${size} мм${s.colors.length > 1 ? ` · ${color}` : ''}`;
  const params = new URLSearchParams({ product: s.publicName, config });
  if (known && variant) params.set('price', formatUah(variant.price));
  return {
    size,
    color,
    known,
    priceLabel: known && variant ? formatUah(variant.price as number) : 'Уточнить наличие',
    ctaHref: `${lp('/contacts/')}?${params.toString()}#contact-form`,
    ctaLabel: known ? 'Получить точную стоимость' : 'Уточнить наличие'
  };
});

const sizeAvailable = (series: (typeof piddonySeries)[number], size: string) =>
  series.variants.some((v) => v.size === size && v.price !== null);

// --- Choose by shape / size ------------------------------------------------
const byShape = [
  ['Квадратные', 'Для компактных и угловых душевых: 800×800, 900×900, 1000×1000 мм. Симметричная зона под двери или Walk-In.'],
  ['Прямоугольные', 'Для ниш и более просторных зон: 800×1200, 900×1200, 900×1600 мм. Комфортная душевая вдоль стены.'],
  ['Пятиугольные', 'Со скошенной передней гранью для угла комнаты — под пятиугольную стеклянную кабину.']
];
const bySize = [
  ['Компактный душ', '800×800 – 900×900 мм', 'Минимальная удобная зона для одного человека в небольшой ванной.'],
  ['Стандарт', '900×1000 – 900×1200 мм', 'Самый популярный диапазон под душевые двери и перегородки в нишу.'],
  ['Walk-In / большой', '900×1400 – 900×1600 мм', 'Вытянутая зона под открытую перегородку без дверей.']
];

// --- How to choose -------------------------------------------------------
const chooseSteps = [
  ['Измерьте зону', 'Ширина и глубина мокрой зоны по чистовой отделке с учётом будущего стекла.'],
  ['Выберите форму', 'Квадрат — угол или двери, прямоугольник — ниша и Walk-In, пятиугольник — срезанный угол.'],
  ['Толщина и вход', 'Толщина поддона 30–32 мм обеспечивает вход почти вровень с полом; уровень входа согласуем со стеклом.'],
  ['Слив и поверхность', 'Расположение выпуска, сифон в комплекте, противоскольжение — проверяем до заказа.']
];

// --- Tray vs flush --------------------------------------------------------
const baseCards = [
  {
    name: 'С готовым поддоном',
    text: 'Искусственный камень упрощает гидроизоляцию и организацию слива: сифон и декоративная накладка уже в комплекте. Размер и форму поддона согласуем со стеклянной конструкцией до финального замера.',
    href: '#catalog',
    linkLabel: 'Перейти к каталогу поддонов →'
  },
  {
    name: 'Душ вровень с полом',
    text: 'Плитка по стяжке с уклоном к точечному трапу или линейному водоотводу — без поддона. Требуется подготовленное основание с правильной гидроизоляцией; геометрию учитываем при замере.'
  }
];

const showerLinks = [
  ['Стеклянные перегородки для душа (Walk-In)', lp('/dushovi-kabiny/peregorodka-dlya-dusha/')],
  ['Стеклянные душевые двери', lp('/dushovi-kabiny/dushovi-dveri/')],
  ['Угловые душевые кабины', lp('/dushovi-kabiny/kutovi/')],
  ['Душевые кабины в нишу', lp('/dushovi-kabiny/u-nishu/')],
  ['Раздвижные душевые кабины', lp('/dushovi-kabiny/rozsuvni/')],
  ['Пятиугольные душевые кабины', lp('/dushovi-kabiny/piatykutni/')]
];

const relatedLinks = [
  ['Все виды душевых кабин', lp('/dushovi-kabiny/')],
  ['Как выбрать душевую кабину', lp('/knowledge/yak-obraty-dushovu-kabinu/')],
  ['Душевая в нишу: замер', lp('/knowledge/dushova-v-nishu-zamir/')],
  ['Как подготовить пространство к замеру', lp('/knowledge/yak-pidhotuvaty-prostir-do-zamiru/')],
  ['Уход за стеклом и поверхностями', lp('/knowledge/doglyad-za-sklyanymy-konstruktsiyamy/')],
  ['От чего зависит цена конструкции', lp('/knowledge/vid-choho-zalezhyt-tsina-sklyanoyi-konstruktsiyi/')],
  ['Оплата и доставка', lp('/oplata-dostavka/')]
];

// --- FAQ (real search intents) ----------------------------------------
const faq: [string, string][] = [
  ['Сколько стоит душевой поддон?', `Душевые поддоны из искусственного камня — ориентировочно от ${overallFrom} за размер 900×900 мм. Итоговая цена зависит от серии, размера и цвета. Точную стоимость подтверждаем при заказе.`],
  ['Как подобрать размер душевого поддона?', 'Измерьте фактическую ширину и глубину мокрой зоны по чистовой отделке и учтите место под будущую стеклянную конструкцию. Компактный душ — 800×800–900×900 мм, стандарт — 900×1000–900×1200 мм, Walk-In — 900×1400–900×1600 мм.'],
  ['Какой материал поддона лучше?', 'Искусственный камень (мраморная крошка на кварцевой основе) прочнее акрила, приятен на ощупь, устойчив к царапинам и легко очищается. Поддоны в каталоге выдерживают нагрузку 375–500 кг и имеют толщину 30–32 мм.'],
  ['Какая форма поддона нужна?', 'Квадратные поддоны — для угловых душевых и зон под двери, прямоугольные — для ниш и Walk-In, пятиугольные со скошенной гранью — для угла небольшой ванной под пятиугольную кабину.'],
  ['Скользкий ли поддон из искусственного камня?', 'Нет. Мраморные серии имеют поверхность с 3 классом противоскольжения, усиленные модели не становятся скользкими при контакте с водой и сохраняют комфортные тактильные свойства.'],
  ['Входит ли сифон в комплект?', 'Да. Сифон и декоративная накладка уже входят в комплектацию поддонов — докупать эти детали не нужно.'],
  ['Обязательно ли делать душ с поддоном?', 'Нет. Стеклянную душевую можно установить и без поддона — на подготовленный пол с гидроизоляцией и уклоном к трапу. Поддон упрощает монтаж и водоотведение.'],
  ['Когда нужно определиться с поддоном?', 'До финального замера стекла. Установленный или точно выбранный поддон задаёт геометрию, точки крепления и размеры стеклянной конструкции.'],
  ['Можно ли заказать поддон вместе со стеклянной душевой?', 'Да, это предпочтительный сценарий. Space Glass подбирает поддон по размеру и форме и согласует его со стеклянной перегородкой, дверьми или кабиной как единую систему.'],
  ['Есть ли доставка поддонов по Украине?', 'Да. Доставку поддонов организуем по Украине; для заказов со стеклянной конструкцией выполняем доставку и монтаж в Киеве, Одессе и Львове, в других городах — по договорённости.'],
  ['Какая гарантия на душевой поддон?', 'Производитель предоставляет 5 лет гарантии на поддоны из искусственного камня при условии правильного монтажа и эксплуатации.'],
  ['Какая толщина душевого поддона?', 'Поддоны в каталоге имеют толщину 30–32 мм, что обеспечивает вход в душ почти вровень с полом. Уровень входа согласуем со стеклянной конструкцией.']
];

// --- Structured data (no supplier name / codes) ----------------------
const itemList: JsonLdObject = {
  '@type': 'ItemList',
  '@id': `${pageUrl}#catalog`,
  name: 'Душевые поддоны',
  numberOfItems: piddonySeries.length,
  itemListElement: piddonySeries.map((s, index) => {
    const cover = s.images[0];
    return {
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Product',
        name: s.publicName,
        category: 'Душевые поддоны',
        material: s.material,
        image: absoluteUrl(`${cover.base}-${cover.widths[cover.widths.length - 1]}.webp`, origin)
      }
    };
  })
};
const faqStructuredData = faqSchema(faq.map(([question, answer]) => ({ question, answer })));
const structuredData: JsonLdObject[] = [itemList, ...(faqStructuredData ? [faqStructuredData] : [])];

const tableHeads = ['Поддон', 'Форма', 'Размеры, мм', 'Толщина поддона', 'Нагрузка', 'Противоскольжение', 'Цвет', 'Цена'];
---
<BaseLayout
  title={metaTitle}
  description={metaDescription}
  locale="ru"
  image="/images/catalog/piddony/piddon-1-white-900.webp"
  schemaType="CollectionPage"
  structuredData={structuredData}
  heroPreloadSrc="/images/catalog/piddony/piddon-1-graphite-900.webp"
  heroPreloadSrcset="/images/catalog/piddony/piddon-1-graphite-480.webp 480w, /images/catalog/piddony/piddon-1-graphite-900.webp 900w"
  heroPreloadSizes="(max-width: 900px) calc(100vw - 48px), 52vw"
>
<div class="sg-page-shell">
  <Header locale="ru" />
  <main id="main">
    <section class="category-hero category-hero--photo">
      <div class="category-hero__copy">
        <Breadcrumbs items={[{ label: 'Главная', href: lp('/') }, { label: 'Душевые кабины', href: lp('/dushovi-kabiny/') }, { label: title }]} />
        <p class="eyebrow">Душевые кабины / Поддоны</p>
        <h1>Душевые поддоны</h1>
        <p class="lead">Душевые поддоны из искусственного камня под стеклянную душевую Space Glass. Квадратные, прямоугольные и пятиугольные поддоны с сифоном в комплекте и противоскольжением. Подбираем поддон по размеру и форме душевой зоны, согласуем со стеклом, организуем доставку и монтаж.</p>
        <div class="hero__actions">
          <a class="button button--mint" href="#catalog">Выбрать поддон</a>
          <a class="button button--outline" href={`${lp('/contacts/')}#contact-form`}>Получить расчёт</a>
        </div>
      </div>
      <figure class="category-hero__figure">
        <div class="category-hero__frame">
          <img
            src="/images/catalog/piddony/piddon-1-graphite-900.webp"
            srcset="/images/catalog/piddony/piddon-1-graphite-480.webp 480w, /images/catalog/piddony/piddon-1-graphite-900.webp 900w"
            sizes="(max-width: 900px) calc(100vw - 48px), 52vw"
            alt="Прямоугольный душевой поддон из искусственного камня в современной ванной комнате"
            width="1600"
            height="826"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </figure>
    </section>

    <TrustBar locale="ru" />

    <section class="category-section category-section--mint">
      <div class="category-heading"><div><p class="eyebrow">О поддонах</p><h2>Поддон из искусственного камня как часть душевой системы</h2></div><p>Вместе со стеклянной конструкцией поддон работает как единая система: размеры, форма и вход не конфликтуют между собой.</p></div>
      <div class="category-intro-grid">
        <div class="category-prose">
          <p>Душевой поддон формирует мокрую зону, обеспечивает уклон к сливу и защищает пол от протекания. Поддоны из искусственного камня (мраморная крошка на кварцевой основе) прочнее акрила, имеют приятную на ощупь матовую поверхность с каменной текстурой, устойчивы к царапинам и легко очищаются.</p>
          <p>В каталоге — душевые поддоны из искусственного мрамора и камня: серии с 3 классом противоскольжения и усиленные модели с запасом нагрузки до 500 кг. Толщина 30–32 мм обеспечивает вход в душ почти вровень с полом, а сифон и декоративная накладка входят в комплект.</p>
          <p>Space Glass подбирает поддон под конкретную душевую зону и согласует его геометрию со стеклянной перегородкой, дверьми или кабиной ещё до изготовления стекла.</p>
        </div>
        <ul class="category-intro__spec">
          <li><b>Искусственный камень и мрамор</b><span>кварцевое сырьё, матовая каменная текстура</span></li>
          <li><b>Толщина поддона 30–32 мм</b><span>вход в душ почти вровень с полом</span></li>
          <li><b>Противоскольжение</b><span>класс 3 у мраморных серий</span></li>
          <li><b>Сифон в комплекте</b><span>сифон + декоративная накладка</span></li>
        </ul>
      </div>
    </section>

    <section id="catalog" class="category-section">
      <div class="category-heading"><div><p class="eyebrow">Каталог</p><h2>Каталог душевых поддонов</h2></div><p>Поддоны из искусственного мрамора и камня.<br class="piddon-desktop-break" /> Выберите размер и цвет — стоимость обновится сразу.</p></div>
      <div class="piddon-grid">
        {piddonySeries.map((series, i) => {
          const init = cardInit[i];
          const cover = series.images[0];
          const maxW = cover.widths[cover.widths.length - 1];
          return (
            <article class:list={['piddon-card', `piddon-card--${series.mediaTone}`]} data-piddon-card>
              <div class="piddon-card__media" data-gallery>
                <img
                  class="piddon-card__photo"
                  data-gallery-main
                  src={`${cover.base}-480.webp`}
                  srcset={`${cover.base}-480.webp 480w, ${cover.base}-${maxW}.webp ${maxW}w`}
                  sizes="(max-width: 700px) 90vw, (max-width: 1100px) 44vw, 30vw"
                  alt={cover.alt}
                  width={cover.w}
                  height={cover.h}
                  loading="lazy"
                  decoding="async"
                />
                <span class="piddon-card__badge">{series.formatBadge}</span>
                <span class="piddon-card__delivery-badge">✓ Бесплатная доставка</span>
                {series.images.length > 1 && (
                  <div class="piddon-card__thumbs" role="group" aria-label="Фотографии поддона">
                    {series.images.map((img, idx) => {
                      const iMax = img.widths[img.widths.length - 1];
                      return (
                        <button
                          type="button"
                          class="piddon-card__thumb"
                          data-thumb
                          data-src={`${img.base}-480.webp`}
                          data-srcset={`${img.base}-480.webp 480w, ${img.base}-${iMax}.webp ${iMax}w`}
                          data-alt={img.alt}
                          data-color={img.color ?? ''}
                          aria-label={img.alt}
                          aria-current={idx === 0 ? 'true' : 'false'}
                        >
                          <img src={`${img.base}-480.webp`} alt="" width="80" height="80" loading="lazy" decoding="async" />
                        </button>
                      );
                    })}
                  </div>
                )}
              </div>

              <div class="piddon-card__body">
                <h3>{series.publicName}</h3>
                <p class="piddon-card__formats">{series.formatsLabel}</p>
                <p class="piddon-card__blurb">{series.blurb}</p>

                <div class="piddon-picker" data-picker data-name={series.publicName} data-variants={JSON.stringify(series.variants)}>
                  <fieldset class="piddon-picker__group">
                    <legend>Размер, мм</legend>
                    <div class="piddon-picker__opts">
                      {series.sizes.map((sz) => {
                        const avail = sizeAvailable(series, sz);
                        const selected = sz === init.size;
                        return (
                          <button
                            type="button"
                            class:list={['piddon-size', selected && 'is-selected', !avail && 'is-unavailable']}
                            data-size={sz}
                            data-available={avail ? 'true' : 'false'}
                            aria-pressed={selected ? 'true' : 'false'}
                          >{sz}</button>
                        );
                      })}
                    </div>
                  </fieldset>

                  {series.colors.length > 1 && (
                    <fieldset class="piddon-picker__group">
                      <legend>Цвет</legend>
                      <div class="piddon-colors" role="radiogroup">
                        {series.colors.map((c, ci) => (
                          <label class="piddon-color">
                            <input type="radio" name={`color-${series.id}`} value={c} data-color checked={ci === 0} />
                            <span>{c}</span>
                          </label>
                        ))}
                      </div>
                    </fieldset>
                  )}

                  <div class="piddon-picker__out">
                    <div class="piddon-picker__price">
                      <strong data-price class:list={[!init.known && 'is-unknown']}>{init.priceLabel}</strong>
                      <span data-price-note hidden={!init.known}>ориентировочная цена за выбранный размер</span>
                    </div>
                    <div class="piddon-free-delivery" aria-label="Бесплатная доставка">✓ Бесплатная доставка</div>
                    <a class="button button--mint piddon-picker__cta" data-cta href={init.ctaHref}>{init.ctaLabel}</a>
                  </div>
                </div>

                <dl class="piddon-card__specs">
                  <div><dt>Материал</dt><dd>{series.material}</dd></div>
                  <div><dt>Толщина поддона</dt><dd>{series.thickness}</dd></div>
                  <div><dt>Вес</dt><dd>{series.weight}</dd></div>
                  <div><dt>Макс. нагрузка</dt><dd>{series.maxLoad}</dd></div>
                  {series.antiSlip && <div><dt>Противоскольжение</dt><dd>{series.antiSlip}</dd></div>}
                  <div><dt>Комплектация</dt><dd>{series.kit}</dd></div>
                </dl>
                <p class="piddon-card__meta"><b>Размеры, мм:</b> {series.sizes.join(' · ')}</p>
                <p class="piddon-card__meta"><b>Цвет:</b> {series.colors.join(' · ')}</p>
              </div>
            </article>
          );
        })}
      </div>
      <p class="piddon-note piddon-catalog-note">{priceDisclaimer}</p>
    </section>

    <section class="category-section category-section--mint">
      <div class="category-heading"><div><p class="eyebrow">Быстрый выбор</p><h2>Выберите по форме и размеру</h2></div><p>Форма зависит от планировки, размер<br class="piddon-desktop-break" /> — от фактической мокрой зоны и места под стекло.</p></div>

      <div class="material-subblock">
        <h3>По форме</h3>
        <div class="category-icon-grid">
          {byShape.map(([name, text]) => (
            <div class="category-icon-card category-icon-card--static">
              <h3>{name}</h3>
              <p>{text}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="material-subblock">
        <h3 class="piddon-zone-size-title">По размеру зоны</h3>
        <div class="category-steps">
          {bySize.map(([name, size, text]) => (
            <div class="category-steps__item"><span>{size}</span><b>{name}</b><p>{text}</p></div>
          ))}
        </div>
      </div>
    </section>

    <section class="category-section">
