<script>
/* SPACE GLASS TRAY FORM — SINGLE STABLE CONTROLLER */
(() => {
  const initTrayForm = () => {
    const form =
      document.querySelector('[data-tray-order-form]');

    const json =
      document.getElementById('tray-config-data');

    if (!form || !json) return;

    let variants;

    try {
      variants = JSON.parse(
        json.textContent || '[]'
      );
    } catch (error) {
      console.error('[tray-form] JSON error', error);
      return;
    }

    const shapeInputs = Array.from(
      form.querySelectorAll(
        'input[name="tray_shape"], input[name="shape"]'
      )
    );

    const sizes =
      form.querySelector('[data-tray-sizes]');

    const colors =
      form.querySelector('[data-tray-colors]');

    const sizeInput =
      form.querySelector('[data-tray-size]');

    const colorInput =
      form.querySelector('[data-tray-color]');

    const configuration =
      form.querySelector('[data-tray-configuration]');

    const product =
      form.querySelector('input[name="product"]');

    const priceRow =
      form.querySelector('[data-tray-live-price]');

    const priceText =
      form.querySelector('[data-tray-live-price-value]');

    if (
      !shapeInputs.length ||
      !sizes ||
      !colors ||
      !sizeInput ||
      !colorInput
    ) {
      console.error('[tray-form] markup incomplete');
      return;
    }

    const shapeMap = {
      "Прямоугольный": "rect",
      "Квадратный": "square",
      "Пятиугольный": "pentagon",
      "rect": "rect",
      "square": "square",
      "pentagon": "pentagon"
    };

    let selectedSize = '';
    let selectedColor = '';

    const getShapeInput = () =>
      shapeInputs.find(input => input.checked);

    const getShape = () => {
      const input = getShapeInput();

      return input
        ? shapeMap[input.value] || ''
        : '';
    };

    const getShapeLabel = () => {
      const input = getShapeInput();

      if (!input) return '';

      const label = input.closest('label');

      return (
        label
          ?.querySelector(
            '.tray-shape-option__label'
          )
          ?.textContent
          ?.trim()
        ||
        input.value
      );
    };

    const uniq = array =>
      [...new Set(array.filter(Boolean))];

    const availableForShape = () => {
      const shape = getShape();

      return variants.filter(
        variant =>
          variant.shape === shape
      );
    };

    const setButtonState = (
      container,
      attribute,
      value
    ) => {
      container
        .querySelectorAll(
          '.tray-config-choice'
        )
        .forEach(button => {
          const active =
            button.dataset[attribute] === value;

          button.classList.toggle(
            'is-selected',
            active
          );

          button.setAttribute(
            'aria-pressed',
            active ? 'true' : 'false'
          );

          /*
           * VISUAL STATE:
           * inline intentionally wins over
           * accumulated legacy tray CSS.
           */
          button.style.setProperty(
            'background',
            active ? '#f0faf6' : '#ffffff',
            'important'
          );

          button.style.setProperty(
            'border',
            active
              ? '2px solid #70c8ae'
              : '1px solid #dfe7e4',
            'important'
          );

          button.style.setProperty(
            'color',
            '#202925',
            'important'
          );

          button.style.setProperty(
            'border-radius',
            '14px',
            'important'
          );

          button.style.setProperty(
            'font-weight',
            active ? '700' : '500',
            'important'
          );

          button.style.setProperty(
            'box-shadow',
            active
              ? '0 0 0 1px rgba(112,200,174,.10)'
              : 'none',
            'important'
          );
        });
    };

    const updateResult = () => {
      sizeInput.value = selectedSize;
      colorInput.value = selectedColor;

      const shape = getShape();

      const match =
        shape &&
        selectedSize &&
        selectedColor
          ? variants.find(
              variant =>
                variant.shape === shape &&
                variant.size === selectedSize &&
                variant.color === selectedColor
            )
          : null;

      if (configuration) {
        configuration.value = [
          getShapeLabel()
            ? `Форма: ${getShapeLabel()}`
            : '',

          selectedSize
            ? `Размер: ${selectedSize} мм`
            : '',

          selectedColor
            ? `Цвет: ${selectedColor}`
            : ''
        ]
          .filter(Boolean)
          .join(' · ');
      }

      if (match) {
        if (priceRow && priceText) {
          priceText.textContent =
            new Intl.NumberFormat('uk-UA')
              .format(match.price) +
            ' грн';

          priceRow.hidden = false;
        }

        if (product && match.product) {
          product.value = match.product;
        }
      } else {
        if (priceRow) {
          priceRow.hidden = true;
        }

        if (priceText) {
          priceText.textContent = '';
        }
      }
    };

    const renderColors = () => {
      /*
       * ВАЖНО:
       * полностью создаём кнопки один раз после выбора размера.
       * Никаких observer и рекурсивных render-вызовов.
       */
      colors.replaceChildren();

      selectedColor = '';

      const availableColors =
        uniq(
          availableForShape()
            .filter(
              variant =>
                variant.size === selectedSize
            )
            .map(
              variant =>
                variant.color
            )
        );

      for (const color of availableColors) {
        const button =
          document.createElement('button');

        button.type = 'button';

        button.className =
          'tray-config-choice tray-config-color';

        button.dataset.color = color;

        button.setAttribute(
          'aria-pressed',
          'false'
        );

        button.style.setProperty(
          'background',
          '#ffffff',
          'important'
        );

        button.style.setProperty(
          'border',
          '1px solid #dfe7e4',
          'important'
        );

        button.style.setProperty(
          'color',
          '#202925',
          'important'
        );

        button.style.setProperty(
          'border-radius',
          '14px',
          'important'
        );

        const dot =
          document.createElement('span');

        dot.className =
          'tray-config-color__dot';

        const lower =
          String(color).toLowerCase();

        dot.classList.add(
          lower.includes('граф') ||
          lower.includes('graph')
            ? 'is-graphite'
            : 'is-white'
        );

        const label =
          document.createElement('span');

        label.textContent = color;

        button.append(dot, label);

        /*
         * ОДИН click handler.
         */
        button.onclick = event => {
          event.preventDefault();

          selectedColor = color;

          setButtonState(
            colors,
            'color',
            color
          );

          updateResult();
        };

        colors.append(button);
      }

      updateResult();
    };

    const renderSizes = () => {
      sizes.replaceChildren();
      colors.replaceChildren();

      selectedSize = '';
      selectedColor = '';

      const availableSizes =
        uniq(
          availableForShape()
            .map(
              variant =>
                variant.size
            )
        );

      for (const size of availableSizes) {
        const button =
          document.createElement('button');

        button.type = 'button';

        button.className =
          'tray-config-choice tray-config-size';

        button.dataset.size = size;

        button.setAttribute(
          'aria-pressed',
          'false'
        );

        button.style.setProperty(
          'background',
          '#ffffff',
          'important'
        );

        button.style.setProperty(
          'border',
          '1px solid #dfe7e4',
          'important'
        );

        button.style.setProperty(
          'color',
          '#202925',
          'important'
        );

        button.style.setProperty(
          'border-radius',
          '14px',
          'important'
        );

        button.textContent = size;

        button.onclick = event => {
          event.preventDefault();

          selectedSize = size;
          selectedColor = '';

          setButtonState(
            sizes,
            'size',
            size
          );

          renderColors();
        };

        sizes.append(button);
      }

      updateResult();
    };

    /*
     * ФОРМА ПОДДОНА
     */
    for (const input of shapeInputs) {
      input.onchange = () => {
        selectedSize = '';
        selectedColor = '';

        renderSizes();
      };
    }

    /*
     * Начальное состояние.
     */
    renderSizes();

    console.log(
      '[tray-form] stable controller initialized',
      variants.length,
      'variants'
    );
  };

  if (document.readyState === 'loading') {
    document.addEventListener(
      'DOMContentLoaded',
      initTrayForm,
      { once: true }
    );
  } else {
    initTrayForm();
  }
})();
</script>


