      <script
        type="application/json"
        id="tray-config-data"
        set:html={JSON.stringify(
          piddonySeries.flatMap((series) =>
            series.variants
              .filter(
                (variant) =>
                  variant.availability === 'available' &&
                  typeof variant.price === 'number'
              )
              .map((variant) => {
                const [a, b] = variant.size
                  .split('×')
                  .map(Number);

                const shape =
                  series.id === 's3'
                    ? 'pentagon'
                    : a === b
                      ? 'square'
                      : 'rect';

                return {
                  seriesId: series.id,
                  product: series.publicName,
                  shape,
                  size: variant.size,
                  color: variant.color,
                  price: variant.price
                };
              })
          )
        )}
      ></script>

