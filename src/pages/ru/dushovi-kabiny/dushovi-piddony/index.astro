<script>
  document.querySelectorAll('[data-piddon-card]').forEach((card) => {
    const picker = card.querySelector('[data-picker]');
    if (!(picker instanceof HTMLElement)) return;

    let variants = [];
    try { variants = JSON.parse(picker.dataset.variants || '[]'); } catch { variants = []; }
    const productName = picker.dataset.name || 'Душевой поддон';

    const sizeBtns = Array.from(picker.querySelectorAll('[data-size]'));
    const colorInputs = Array.from(picker.querySelectorAll('input[data-color]'));
    const priceEl = picker.querySelector('[data-price]');
    const noteEl = picker.querySelector('[data-price-note]');
    const cta = picker.querySelector('[data-cta]');
    const mainPhoto = card.querySelector('[data-gallery-main]');
    const thumbs = Array.from(card.querySelectorAll('[data-thumb]'));

    const fmt = (n) => `${Number(n).toLocaleString('ru-RU')} грн`;

    let selSize =
      (sizeBtns.find((b) => b.getAttribute('aria-pressed') === 'true') || sizeBtns[0])?.dataset.size ||
      (variants[0] && variants[0].size) || '';
    let selColor =
      (colorInputs.find((i) => i.checked) || colorInputs[0])?.value ||
      (variants[0] && variants[0].color) || '';

    const render = () => {
      sizeBtns.forEach((b) => {
        const on = b.dataset.size === selSize;
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
        b.classList.toggle('is-selected', on);
      });

      const v =
        variants.find((x) => x.size === selSize && x.color === selColor) ||
        variants.find((x) => x.size === selSize) ||
        null;
      const known = !!v && typeof v.price === 'number';

      if (priceEl) {
        priceEl.textContent = known ? fmt(v.price) : 'Уточнить наличие';
        priceEl.classList.toggle('is-unknown', !known);
      }
      if (noteEl) noteEl.hidden = !known;

      const config = `${selSize} мм${colorInputs.length ? ` · ${selColor}` : ''}`;
      const params = new URLSearchParams({ product: productName, config });
      if (known) params.set('price', fmt(v.price));
      if (cta) {
        cta.setAttribute('href', `/ru/contacts/?${params.toString()}#contact-form`);
        cta.textContent = known ? 'Получить точную стоимость' : 'Уточнить наличие';
      }
    };

    const activateThumb = (thumb) => {
      if (!(mainPhoto instanceof HTMLImageElement) || !thumb) return;
      if (thumb.dataset.src) mainPhoto.src = thumb.dataset.src;
      mainPhoto.srcset = thumb.dataset.srcset || '';
      if (thumb.dataset.alt) mainPhoto.alt = thumb.dataset.alt;
      thumbs.forEach((t) => t.setAttribute('aria-current', t === thumb ? 'true' : 'false'));
    };

    const swapMainByColor = (color) => {
      const t = thumbs.find((x) => x.dataset.color === color);
      if (t) activateThumb(t);
    };

    sizeBtns.forEach((b) =>
      b.addEventListener('click', () => {
        selSize = b.dataset.size || selSize;
        render();
      })
    );

    colorInputs.forEach((input) =>
      input.addEventListener('change', () => {
        selColor = input.value;
        render();
        swapMainByColor(selColor);
      })
    );

    thumbs.forEach((thumb) =>
      thumb.addEventListener('click', () => {
        activateThumb(thumb);
        const color = thumb.dataset.color;
        if (color) {
          const match = colorInputs.find((x) => x.value === color);
          if (match && !match.checked) {
            match.checked = true;
            selColor = color;
            render();
          }
        }
      })
    );

    render();
  });
</script>

