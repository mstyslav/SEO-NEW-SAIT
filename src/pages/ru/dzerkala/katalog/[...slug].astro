---
// LED mirror catalog (RU) — twin of src/pages/dzerkala/katalog/[...slug].astro. noindex, not in the sitemap.
import LedMirrorsCatalog from '../../../../components/led-mirrors/LedMirrorsCatalog.astro';
import LedMirrorModel from '../../../../components/led-mirrors/LedMirrorModel.astro';
import LedCatalogBlockPreview from '../../../../components/led-mirrors/LedCatalogBlockPreview.astro';
import pub from '../../../../data/led-mirrors/public.json';

export function getStaticPaths() {
  return [{ params: { slug: undefined } }, { params: { slug: 'preview-led-block' } }, ...pub.models.map((m) => ({ params: { slug: m.slug } }))];
}
const { slug } = Astro.params;
const model = slug ? pub.models.find((m) => m.slug === slug) : undefined;
---
{slug === 'preview-led-block' ? <LedCatalogBlockPreview locale="ru" /> : model ? <LedMirrorModel model={model} locale="ru" /> : <LedMirrorsCatalog locale="ru" />}
