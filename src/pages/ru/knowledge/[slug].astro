---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/knowledge.css';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FAQBlock from '../../../components/FAQBlock.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { knowledgeArticles, getKnowledgeArticle } from '../../../data/knowledge-articles';
import {
  getKnowledgeArticleRu,
  KNOWLEDGE_ARTICLES_RU,
} from '../../../content/i18n/knowledge/articles-ru';
import { breadcrumbSchema, faqSchema } from '../../../seo/schema';
import { expandFaq } from '../../../data/expand-faq';

export function getStaticPaths() {
  return knowledgeArticles
    .filter((sourceArticle) => Boolean(getKnowledgeArticleRu(sourceArticle)))
    .map((sourceArticle) => ({
      params: { slug: sourceArticle.slug },
      props: {
        sourceArticle,
        article: getKnowledgeArticleRu(sourceArticle),
      },
    }));
}

const { sourceArticle, article } = Astro.props;

if (!article || !sourceArticle) {
  return Astro.redirect('/ru/knowledge/', 302);
}

const origin = Astro.site ?? Astro.url.origin;
const url = new URL(`/ru/knowledge/${article.slug}/`, origin);
const ukUrl = new URL(`/knowledge/${article.slug}/`, origin);

const sections = article.sections;
const readingTime = Math.max(
  sourceArticle.readingTime,
  Math.ceil(sections.length * 1.15)
);

const expandedFaq = expandFaq(article.faq, article.title, 'ru', 20);

const related = sourceArticle.related
  .map((relatedSlug) => {
    const card = KNOWLEDGE_CARDS_RU[relatedSlug];
    if (!card) return null;

    return {
      slug: relatedSlug,
      title: card.title,
      description: card.description,
    };
  })
  .filter((item): item is NonNullable<typeof item> => item !== null);

const lp = (path: string) => localizedPath(path, 'ru');

const localizeHref = (href: string) => {
  const match = href.match(/^([^?#]*)(.*)$/);
  if (!match) return href;

  const [, pathname, suffix] = match;
  return `${lp(pathname)}${suffix}`;
};

const serviceHref = localizeHref(sourceArticle.serviceHref);

const structuredData = [
  {
    '@type': 'Article',
    '@id': `${url.href}#article`,
    headline: article.title,
    description: article.description,
    datePublished: '2026-08-12',
    dateModified: '2026-08-26',
    inLanguage: 'ru',
    mainEntityOfPage: { '@id': `${url.href}#webpage` },
    author: {
      '@type': 'Organization',
      name: 'Space Glass',
      url: new URL('/', origin).href
    },
    publisher: {
      '@id': `${new URL('/', origin).href}#organization`
    }
  },
  breadcrumbSchema([
    { label: 'Главная', href: new URL('/ru/', origin) },
    { label: 'База знаний', href: new URL('/ru/knowledge/', origin) },
    { label: article.title, href: url }
  ]),
  faqSchema(
    expandedFaq.map(([question, answer]) => ({ question, answer }))
  )
].filter(Boolean);
import { KNOWLEDGE_CARDS_RU } from '../../../content/i18n/pages/knowledge-cards-ru';
import { localizedPath } from '../../../i18n/helpers';
---

<BaseLayout
  locale="ru"
  title={`${article.title} | Space Glass`}
  description={article.description}
  schemaType="Article"
  structuredData={structuredData}
  alternateLocales={['uk', 'ru']}
>
  <div class="sg-page-shell">
    <Header />

    <main id="main">
      <Breadcrumbs
        contained
        schema={false}
        items={[
          { label: 'Главная', href: '/ru/' },
          { label: 'База знаний', href: '/ru/knowledge/' },
          { label: article.title }
        ]}
      />

      <article>
        <header class="knowledge-article-hero knowledge-article-hero--compact">
          <div class="knowledge-article-hero__copy">
            <p class="eyebrow">База знаний · {article.category}</p>
            <h1>{article.title}</h1>
            <p class="lead">{article.intro}</p>

            <div class="article-meta">
              <span>Обновлено: август 2026</span>
              <span>{readingTime} мин чтения</span>
              <span>{sections.length} экспертных блоков</span>
            </div>
          </div>

          <div class="knowledge-article-hero__visual" aria-hidden="true">
            <span>SPACE GLASS GUIDE</span>
          </div>
        </header>

        <nav class="article-path" aria-label="Полезные следующие шаги">
          <a href={serviceHref}>
            <span>01 · Соответствующая услуга</span>
            <strong>{article.serviceLabel}</strong>
          </a>

          <a href="/ru/projects/">
            <span>02 · Практический опыт</span>
            <strong>Посмотреть реализованные проекты</strong>
          </a>

          <a href={`${lp("/contacts/")}#contact-form`}>
            <span>03 · Ваш объект</span>
            <strong>Получить предварительный расчёт</strong>
          </a>
        </nav>

        <div class="article-layout">
          <aside class="article-toc">
            <strong>В материале</strong>
            {sections.map((section) => (
              <a href={`#${section.id}`}>{section.title}</a>
            ))}
          </aside>

          <div class="article-content">
            {sections.map((section, index) => (
              <section>
                <h2 id={section.id}>{section.title}</h2>

                {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

                {section.bullets && (
                  <ul>
                    {section.bullets.map((bullet) => <li>{bullet}</li>)}
                  </ul>
                )}

                {index === 0 && (
                  <div class="article-callout">
                    <strong>Совет Space Glass</strong>
                    <p>
                      Финальное решение принимайте после проверки размеров,
                      основания и сценария использования. Одинаковый внешний
                      вид не означает одинаковую конструкцию.
                    </p>
                  </div>
                )}

                {index === 4 && (
                  <div class="article-service-card">
                    <p class="eyebrow">Связанное решение Space Glass</p>
                    <h3>{article.serviceLabel}</h3>
                    <p>
                      Посмотрите варианты конструкций, требования к замеру и
                      возможности индивидуального изготовления.
                    </p>
                    <a href={serviceHref}>
                      Перейти на страницу услуги →
                    </a>
                  </div>
                )}
              </section>
            ))}
          </div>

          <aside class="article-side">
            <p class="eyebrow eyebrow--light">Нужна помощь?</p>
            <h2>Разберём вашу задачу</h2>
            <p>
              Отправьте фото, примерные размеры и город — подскажем следующий
              шаг.
            </p>

            <a class="button button--white" href={`${lp("/contacts/")}#contact-form`}>
              Получить консультацию
            </a>

            <a class="article-side__service" href={serviceHref}>
              {article.serviceLabel} →
            </a>
          </aside>
        </div>

        <section class="article-related">
          <div class="category-heading">
            <div>
              <p class="eyebrow">Продолжить чтение</p>
              <h2>Материалы по теме</h2>
            </div>

            <a href="/ru/knowledge/">Все материалы →</a>
          </div>

          <div class="article-related-grid">
            {related.map((item, index) =>
              item && (
                <a
                  class="article-related-card"
                  href={KNOWLEDGE_ARTICLES_RU[item.slug] ? `/ru/knowledge/${item.slug}/` : "/ru/knowledge/"}
                >
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </a>
              )
            )}
          </div>
        </section>

        <section class="article-related article-faq-section">
          <FAQBlock
            title={`Частые вопросы: ${article.title}`}
            intro="20 практических ответов перед заказом. Первые 6 открыты для быстрого просмотра, остальные можно развернуть кнопкой."
            items={expandedFaq}
            visibleCount={6}
          />
        </section>

        <section class="inner-cta">
          <div>
            <p class="eyebrow eyebrow--light">Следующий шаг</p>
            <h2>Получите расчёт под ваши размеры</h2>
            <p>
              Форма объясняет, какие данные нужны, и позволяет добавить фото
              или чертёж.
            </p>
          </div>

          <a class="button button--white" href={`${lp("/contacts/")}#contact-form`}>
            Перейти к расчёту
          </a>
        </section>
      </article>
    </main>

    <Footer />
  </div>
</BaseLayout>
