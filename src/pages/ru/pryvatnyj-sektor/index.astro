---
// /ru/pryvatnyj-sektor/ — RU private houses and cottages landing (mirrors src/pages/pryvatnyj-sektor/index.astro).
// Same SolutionDetailPage template with locale="ru"; tiles and SEO copy from src/data/ru/solution-pages.ru.ts.
import SolutionDetailPage from '../../../components/solutions/SolutionDetailPage.astro';
import { privateSectorExtraRu } from '../../../data/ru/solution-pages.ru';
import { absoluteUrl, breadcrumbSchema, faqSchema, type JsonLdObject } from '../../../seo/schema';
import { localizedPath } from '../../../i18n/helpers';

const PATH = '/pryvatnyj-sektor/';
const lp = (path: string) => localizedPath(path, 'ru');
const origin = Astro.site ?? Astro.url.origin;

const title = 'Стеклянные конструкции для частного дома и коттеджа | Space Glass';
const description =
  'Стекло для частного дома и коттеджа: ограждения лестниц и террас, безрамное остекление, входные группы, козырьки, душевые, перегородки, двери, зеркала. Замер и монтаж.';
const h1 = 'Стеклянные конструкции для частного дома и коттеджа';
const heroLead =
  'Ограждения, остекление террас и фасадов, входные группы, козырьки, душевые, перегородки, двери и зеркала для частного дома — проектируем под архитектуру и изготавливаем на собственном производстве с монтажом в Киеве, Одессе, Львове и по Украине.';
const heroImage = {
  base: 'solution-house',
  width: 1280,
  height: 941,
  alt: 'Частный дом с панорамным остеклением, стеклянной террасой и ограждением'
};

const scenarios = [
  { title: 'Лестница и второй этаж', text: 'Стеклянное ограждение лестницы и галереи делает холл светлым и безопасным — без массивных балясин, которые перекрывают пространство.' },
  { title: 'Терраса, которой пользуются круглый год', text: 'Безрамное или тёплое алюминиевое остекление превращает открытую террасу в комнату с видом на сад.' },
  { title: 'Вход в дом', text: 'Входная группа из стекла и алюминия вместе со стеклянным козырьком защищает крыльцо от дождя и подчёркивает фасад.' },
  { title: 'Санузлы и ванные комнаты', text: 'Душевые кабины, перегородки Walk-In и зеркала с подсветкой выполняем под размеры каждой ванной в доме.' }
];

const choosePoints = [
  { title: 'Ограждение лестницы, балкона или террасы', text: 'Для ограждений используют триплекс: при повреждении стекло остаётся в креплении. Безрамная система на зажимном профиле выглядит легче, стоечная — дешевле и проще в монтаже.', link: { label: 'Стеклянные ограждения: требования и безопасность', href: '/knowledge/sklyani-ohorozhi-vymohy-bezpeka/' } },
  { title: 'Безрамное или тёплое остекление', text: 'Безрамное остекление даёт максимальный обзор и подходит для сезонной террасы или беседки. Если пространство отапливают, выбирают тёплый алюминиевый контур со стеклопакетом.', link: { label: 'Тёплое или холодное остекление террасы', href: '/knowledge/teple-chy-kholodne-sklinnya-terasy/' } },
  { title: 'Козырёк над входом', text: 'Козырёк рассчитывают на снег и ветер: консольный — для небольшого выноса, на тягах или кронштейнах — для более широких входов и террас.', link: { label: 'Стеклянные козырьки', href: '/sklyani-kozyrky/' } }
];

const materials = [
  { title: 'Триплекс', text: 'Основное стекло для ограждений, козырьков и навесов — выдерживает наружные нагрузки и не рассыпается при повреждении.' },
  { title: 'Закалённое стекло', text: 'Для душевых, дверей, перегородок и безрамного остекления — в 5–6 раз прочнее обычного.' },
  { title: 'Алюминиевые системы', text: 'Тёплый или холодный профиль для входных групп, раздвижных дверей, зимних садов и фасадов.' },
  { title: 'Фурнитура для улицы', text: 'Нержавеющая сталь и порошковое покрытие — для конструкций, которые работают под открытым небом круглый год.' }
];

const safetyPoints = [
  { title: 'Безопасность на высоте', text: 'Ограждения лестниц, галерей и балконов рассчитываем по высоте падения и нагрузке на поручень.' },
  { title: 'Снег, ветер и перепады температур', text: 'Козырьки, остекление террас и фасадов подбираем под климатические нагрузки конкретного региона.' },
  { title: 'Гарантия на конструкции', text: 'После монтажа проверяем работу механизмов и передаём объект с гарантией и сервисом.' }
];

const priceFactors = [
  'тип конструкции и площадь стекла',
  'толщина и тип стекла — закалённое или триплекс',
  'система крепления и фурнитура',
  'цвет профиля и отделка',
  'сложность объекта: высота, рельеф, доступ',
  'доставка и монтаж'
];

const processSteps = [
  { title: 'Консультация', text: 'Обсуждаем задачу, стиль дома и бюджет, подбираем варианты конструкций.' },
  { title: 'Замер', text: 'Выезжаем на объект и фиксируем фактическую геометрию лестницы, проёмов или террасы.' },
  { title: 'Договор', text: 'Согласовываем спецификацию, стоимость и сроки выполнения.' },
  { title: 'Проектирование', text: 'Готовим чертежи с размерами, стеклом, профилем и узлами крепления.' },
  { title: 'Изготовление', text: 'Производим конструкции на собственном оборудовании и контролируем качество.' },
  { title: 'Монтаж и сдача', text: 'Устанавливаем, регулируем и передаём объект с гарантией.' }
];

const experienceStats = [
  { value: '10+', label: 'лет реального опыта в реализации стеклянных и алюминиевых конструкций' },
  { value: '5 000+', label: 'реализованных проектов для дома и бизнеса в Украине и Европе' },
  { value: '50 000+', label: 'м² выполненного остекления жилых и коммерческих объектов' }
];

const faq: [string, string][] = [
  ['Какие стеклянные конструкции можно заказать для частного дома?', 'Ограждения лестниц, балконов и террас, безрамное и панорамное остекление, входные группы, козырьки и навесы, душевые кабины, перегородки, двери, зеркала, раздвижные двери на террасу и зимние сады.'],
  ['Можно ли заказать несколько конструкций для дома в одном проекте?', 'Да. Комплексный заказ удобнее: один замер, единый цвет профиля и фурнитуры, согласованный график монтажа.'],
  ['Какое стекло используют для ограждения лестницы в доме?', 'Триплекс — ламинированное закалённое стекло. Даже при повреждении оно остаётся в креплении и не создаёт опасных осколков.'],
  ['Можно ли остеклить террасу коттеджа без рам?', 'Да, безрамное остекление — отдельное решение для террас и беседок: створки раздвигаются или складываются без вертикальных стоек.'],
  ['Выдерживает ли стеклянный козырёк снег?', 'Да, если он рассчитан под снеговую нагрузку региона. Для козырьков используют только триплекс и соответствующие крепления.'],
  ['На каком этапе строительства лучше обращаться?', 'Лучше всего — до стяжки и отделки: так закладываются крепления ограждений, пороги раздвижных дверей и водоотвод террасы.'],
  ['Можно ли рассчитать стоимость по проекту дома?', 'Да, предварительный расчёт готовим по чертежам, плану или фото с размерами. Точная цена — после замера.'],
  ['Сколько длится изготовление и монтаж?', 'Сроки зависят от типа и количества конструкций и фиксируются в договоре после замера и согласования чертежей.'],
  ['Работаете ли за городом и в коттеджных городках?', 'Да, выезжаем на замер и монтаж в коттеджные городки и пригороды Киева, Одессы, Львова и по всей Украине.'],
  ['Даёте ли гарантию на конструкции?', 'Да, на стекло, фурнитуру и монтаж предоставляем гарантию, а также выполняем сервисное обслуживание.'],
  ['Можно ли совместить стекло с алюминиевыми окнами и дверями дома?', 'Да, подбираем профиль и цвет так, чтобы ограждения, двери, входная группа и остекление выглядели как одна система.'],
  ['Как ухаживать за наружными стеклянными конструкциями?', 'Мойте стекло неабразивными средствами, периодически очищайте направляющие и уплотнения, а при появлении люфта обращайтесь в сервис.']
];

const breadcrumbItems = [
  { label: 'Главная', href: lp('/') },
  { label: 'Частный сектор', href: lp(PATH) }
];

const structuredData: JsonLdObject[] = [
  breadcrumbSchema(breadcrumbItems.map((item) => ({ label: item.label, href: absoluteUrl(item.href, origin) }))),
  faqSchema(faq.map(([question, answer]) => ({ question, answer })))
].filter(Boolean) as JsonLdObject[];
---
<SolutionDetailPage
  path={PATH}
  extra={privateSectorExtraRu}
  eyebrow="Частный сектор · дома и коттеджи"
  title={title}
  description={description}
  h1={h1}
  heroLead={heroLead}
  heroImage={heroImage}
  scenarios={scenarios}
  choosePoints={choosePoints}
  materials={materials}
  safetyPoints={safetyPoints}
  priceFactors={priceFactors}
  processSteps={processSteps}
  experienceStats={experienceStats}
  faq={faq}
  breadcrumbItems={breadcrumbItems}
  structuredData={structuredData}
  formExample="Стеклянное ограждение лестницы и козырёк над входом для коттеджа под Киевом"
  locale="ru"
/>
