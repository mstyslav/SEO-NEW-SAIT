---
// RU frameless glazing subsections — shared catalog template; content in src/data/ru/frameless-catalog.ru.ts.
import ProfileCategoryPage from '../../../components/profile/ProfileCategoryPage.astro';
import { framelessCategoriesRu } from '../../../data/ru/frameless-catalog.ru';
export function getStaticPaths() {
  return framelessCategoriesRu.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}
const { category } = Astro.props;
---
<ProfileCategoryPage category={category} locale="ru" />
