---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
const pages = import.meta.glob<{ default: AstroComponentFactory }>('../../**/*.astro', { eager: true });
export function getStaticPaths() {
  const legal = ['publichna-oferta','cookies','harantiia','povernennia','privacy'];
  return legal.map((path) => ({ params: { path } }));
}
const source = `../../${Astro.params.path}.astro`;
const Page = pages[source]?.default;
if (!Page) return Astro.redirect('/');
---
<Page locale="ru" />
