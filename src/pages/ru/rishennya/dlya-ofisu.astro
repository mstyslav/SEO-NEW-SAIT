---
// RU version of /rishennya/dlya-ofisu/ — shared SolutionDetailPage template with locale="ru"; tiles, projects and
// SEO copy come from src/data/ru/solution-pages.ru.ts.
import SolutionDetailPage from '../../../components/solutions/SolutionDetailPage.astro';
import { absoluteUrl, breadcrumbSchema, faqSchema, type JsonLdObject } from '../../../seo/schema';
import { localizedPath } from '../../../i18n/helpers';

const PATH = '/rishennya/dlya-ofisu/';
const lp = (path: string) => localizedPath(path, 'ru');
const origin = Astro.site ?? Astro.url.origin;

const title = 'Стеклянные конструкции для офиса на заказ | Space Glass';
const description =
  'Стеклянные конструкции для офиса на заказ: перегородки, двери и алюминиевые системы для кабинетов и переговорных. Проектирование, изготовление и монтаж в Киеве, Одессе, Львове и по Украине.';
const h1 = 'Стеклянные конструкции для офиса';
const heroLead =
  'Перегородки, двери и стеклянные системы в алюминиевом профиле для зонирования рабочего пространства без потери света — в Киеве, Одессе, Львове и по всей Украине.';
const heroImage = {
  base: 'solution-office-meeting-room',
  width: 1280,
  height: 960,
  alt: 'Современный офис со стеклянными перегородками и дверями в алюминиевом профиле'
};


const scenarios = [
  { title: 'Опенспейс, который нужно делить на зоны', text: 'Мобильные перегородки на направляющих позволяют менять планировку без капитального ремонта при росте команды.' },
  { title: 'Переговорная комната со стеклянными стенами', text: 'Звукоизоляционный стеклопакет и матовая полоса дают приватность разговоров, не превращая комнату в закрытую коробку.' },
  { title: 'Ресепшн и входная зона', text: 'Цельностеклянный фасад формирует первое впечатление о компании ещё из коридора бизнес-центра.' },
  { title: 'Кабинеты руководства', text: 'Стеклянные перегородки с дверями сохраняют статусность отдельного кабинета, не изолируя его от остальной команды.' }
];

const choosePoints = [
  { title: 'Общие принципы выбора перегородки', text: 'Формат зависит от планировки, количества дверных групп и того, насколько часто офис меняет конфигурацию.', link: { label: 'Как выбрать стеклянную перегородку для офиса', href: '/knowledge/yak-obraty-sklyanu-perehorodku/' } },
  { title: 'Loft или цельностеклянная перегородка', text: 'Loft-перегородка с видимым профилем-сеткой формирует узнаваемый индустриальный стиль. Цельностеклянная — минимальный каркас и максимум света.', link: { label: 'LOFT-перегородки: профиль, стекло и конструкция', href: '/knowledge/loft-perehorodky-vydy-sklo-profili/' } },
  { title: 'Распашные или раздвижные двери', text: 'Раздвижные двери экономят пространство прохода в коридорах с интенсивным движением. Распашные привычнее для отдельных кабинетов.', link: { label: 'Распашные или раздвижные стеклянные двери: сравнение', href: '/knowledge/rozpashni-chy-rozsuvni-sklyani-dveri/' } }
];

const materials = [
  { title: 'Закалённое стекло', text: 'Основной материал для офисных перегородок и дверей — безопасен при повреждении и выдерживает ежедневное интенсивное использование.' },
  { title: 'Звукоизоляционные стеклопакеты', text: 'Применяются в переговорных комнатах, где нужен сниженный уровень шума между помещениями.' },
  { title: 'Алюминиевый профиль', text: 'Формирует каркас перегородок и дверей, доступен в чёрном, белом и натуральном цвете под фирменный стиль офиса.' },
  { title: 'Фурнитура', text: 'Доводчики, направляющие и замки подбираются под интенсивность эксплуатации офисного пространства.' }
];

const priceFactors = [
  'метраж и количество перегородок',
  'количество дверных групп',
  'тип стекла — прозрачное, матовое или звукоизоляционное',
  'система профиля и цвет',
  'фурнитура и тип открывания',
  'монтаж и график работ в офисе'
];

const safetyPoints = [
  { title: 'Безопасное стекло каждый день', text: 'Закалённое стекло выдерживает интенсивное ежедневное использование в проходных зонах и при повреждении не образует острых осколков.' },
  { title: 'Приватность без глухих стен', text: 'Матирование, тонирование или плёнка с логотипом закрывают отдельные зоны от посторонних глаз, сохраняя общее освещение опенспейса.' },
  { title: 'Механизмы под нагрузку', text: 'Доводчики и направляющие дверей подбираются под количество открываний в день — критично для проходных кабинетов и переговорных.' }
];

const processSteps = [
  { title: 'Консультация', text: 'Уточняем задачу, планировку офиса, желаемый результат и ориентировочный бюджет.' },
  { title: 'Замер', text: 'Выезжаем на объект и фиксируем фактическую геометрию помещения и проёмов.' },
  { title: 'Проектирование', text: 'Готовим чертёж с размерами, стеклом, профилем и узлами крепления.' },
  { title: 'Изготовление', text: 'Производим конструкцию на собственном оборудовании под согласованные параметры.' },
  { title: 'Доставка', text: 'Упаковываем и доставляем готовую конструкцию в Киеве, Одессе, Львове и по Украине.' },
  { title: 'Монтаж', text: 'Устанавливаем, проверяем работу механизмов и передаём объект с гарантией.' }
];

const experienceStats = [
  { value: '10+', label: 'лет реального опыта в реализации стеклянных и алюминиевых конструкций' },
  { value: '5 000+', label: 'реализованных проектов для дома и бизнеса в Украине и Европе' },
  { value: '50 000+', label: 'м² выполненного остекления жилых и коммерческих объектов' }
];


const faq: [string, string][] = [
  ['Чем loft-перегородка отличается от цельностеклянной?', 'Loft-перегородка имеет видимый металлический профиль-сетку, цельностеклянная — минимальный каркас или крепление без видимых стоек.'],
  ['Можно ли установить перегородку без демонтажа потолка?', 'Да, большинство систем монтируются к имеющемуся потолку и полу без капитальных работ.'],
  ['Обеспечивают ли перегородки звукоизоляцию?', 'Да, при соответствующем стеклопакете — для переговорных рекомендуем усиленную звукоизоляцию.'],
  ['Можно ли заказать перегородку с матированной полосой или логотипом?', 'Да, матирование, тонирование или плёнку с логотипом наносят по согласованному макету.'],
  ['Сколько длится монтаж офисных перегородок?', 'Срок зависит от метража и количества дверных групп, фиксируется после замера и согласования проекта.'],
  ['Можно ли перенести перегородку в другое место офиса?', 'Мобильные системы на направляющих можно демонтировать и собрать повторно на новом месте. Стационарные перегородки рассчитаны на постоянное расположение.'],
  ['Можно ли установить перегородку в арендованном офисе?', 'Да, по согласованию с арендодателем — мобильные системы особенно удобны, если конструкцию нужно будет демонтировать при переезде.'],
  ['Какой класс огнестойкости у стеклянных перегородок?', 'Класс огнестойкости зависит от выбранной системы стекла и профиля и уточняется на этапе проектирования под требования конкретного помещения.'],
  ['Можно ли изменить конфигурацию офиса после монтажа?', 'Мобильные перегородки позволяют сделать это без демонтажа капитальных элементов. Стационарные системы изменить сложнее.'],
  ['Проводите ли монтаж в нерабочее время?', 'График монтажа согласовываем индивидуально, чтобы минимизировать влияние на работу команды.'],
  ['Можно ли установить двери прямо в стеклянную перегородку?', 'Да, распашные, раздвижные или маятниковые двери интегрируются в перегородку ещё на этапе проектирования.'],
  ['Какое стекло лучше для переговорной комнаты?', 'Звукоизоляционный стеклопакет с матированной или тонированной полосой — снижает шум и добавляет приватности без полной изоляции от команды.'],
  ['Можно ли подобрать цвет профиля под фирменный стиль?', 'Да, доступны чёрный, белый, натуральный алюминий и индивидуальные цвета в зависимости от системы.'],
  ['Сколько стоит м² офисной перегородки?', 'Стоимость зависит от стекла, профиля, фурнитуры и количества дверей — предварительный расчёт готовим по фото и примерному метражу.'],
  ['Нужен ли профессиональный замер для офиса?', 'Да, финальный замер фиксирует фактическую геометрию помещения и расположение коммуникаций перед изготовлением.'],
  ['Можно ли установить цельностеклянную перегородку без видимого профиля?', 'Да, цельностеклянные системы используют минимальные точечные крепления вместо сплошного каркаса.'],
  ['Выдерживают ли перегородки интенсивный проходной трафик?', 'Да, при усиленной фурнитуре — доводчиках и направляющих, подобранных под количество открываний в день.'],
  ['Можно ли заказать только изготовление без монтажа?', 'В ряде случаев да, с доставкой готовой конструкции — детали согласовываются индивидуально.'],
  ['Есть ли гарантия на офисные конструкции?', 'Да, гарантийные условия фиксируются в договоре и зависят от типа системы и объёма проекта.'],
  ['Что делать, если стены или потолок офиса неровные?', 'Отклонения фиксируются при замере и учитываются профилями крепления или индивидуальной геометрией стекла.']
];


const breadcrumbItems = [
  { label: 'Главная', href: lp('/') },
  { label: 'Решения', href: lp('/rishennya/') },
  { label: 'Для офиса', href: lp(PATH) }
];

const structuredData: JsonLdObject[] = [
  breadcrumbSchema(breadcrumbItems.map((item) => ({ label: item.label, href: absoluteUrl(item.href, origin) }))),
  faqSchema(faq.map(([question, answer]) => ({ question, answer })))
].filter(Boolean) as JsonLdObject[];
---
<SolutionDetailPage
  path={PATH}
  title={title}
  description={description}
  h1={h1}
  heroLead={heroLead}
  heroImage={heroImage}
  scenarios={scenarios}
  choosePoints={choosePoints}
  materials={materials}
  safetyPoints={safetyPoints}
  priceFactors={priceFactors}
  processSteps={processSteps}
  experienceStats={experienceStats}
  faq={faq}
  breadcrumbItems={breadcrumbItems}
  structuredData={structuredData}
  formExample="Стеклянная офисная перегородка с дверью в Киеве"
  locale="ru"
/>
