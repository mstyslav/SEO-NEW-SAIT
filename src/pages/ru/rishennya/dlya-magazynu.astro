---
// RU version of /rishennya/dlya-magazynu/ — shared SolutionDetailPage template with locale="ru"; tiles, projects and
// SEO copy come from src/data/ru/solution-pages.ru.ts.
import SolutionDetailPage from '../../../components/solutions/SolutionDetailPage.astro';
import { absoluteUrl, breadcrumbSchema, faqSchema, type JsonLdObject } from '../../../seo/schema';
import { localizedPath } from '../../../i18n/helpers';

const PATH = '/rishennya/dlya-magazynu/';
const lp = (path: string) => localizedPath(path, 'ru');
const origin = Astro.site ?? Astro.url.origin;

const title = 'Стеклянные конструкции для магазина на заказ | Space Glass';
const description =
  'Стеклянные конструкции для магазина на заказ: витрины, входные группы, перегородки и фасадные системы. Изготовление и монтаж Space Glass в Киеве, Одессе, Львове и по Украине.';
const h1 = 'Стеклянные конструкции для магазина';
const heroLead =
  'Витрины, входные группы и перегородки для торговых помещений — прозрачные решения, которые открывают товар покупателю с улицы, в Киеве, Одессе, Львове и по всей Украине.';
const heroImage = {
  base: 'solution-shop',
  width: 1280,
  height: 721,
  alt: 'Премиальный магазин со стеклянной витриной, фасадом и входной группой'
};


const scenarios = [
  { title: 'Витрина первого этажа с интенсивным трафиком', text: 'Минимум рам и усиленная фурнитура входной группы выдерживают сотни открываний ежедневно.' },
  { title: 'Торговый зал без глухих стен', text: 'Перегородки отделяют примерочные или кассовую зону, сохраняя обзор товара из любой точки зала.' },
  { title: 'Бренд на фасаде', text: 'Гравировка или плёнка с логотипом интегрируются прямо в стекло витрины вместо отдельной вывески.' },
  { title: 'Примерочные без ощущения тесноты', text: 'Матированное или сатинированное стекло даёт приватность зоне примерочной, не превращая её в глухую кабинку.' }
];

const choosePoints = [
  { title: 'Триплекс для витрины первого этажа', text: 'Стекло, доступное с улицы, требует повышенной безопасности — при повреждении оно должно оставаться в раме, а не рассыпаться на тротуар.', link: { label: 'Heat Soak Test закалённого стекла: когда он нужен', href: '/knowledge/heat-soak-test-zagartovanogo-skla/' } },
  { title: 'Подготовка помещения к замеру', text: 'Точный расчёт витрины или входной группы возможен только после финального замера фактического проёма фасада.', link: { label: 'Как подготовить пространство к замеру', href: '/knowledge/yak-pidhotuvaty-prostir-do-zamiru/' } },
  { title: 'Фурнитура под трафик магазина', text: 'Двери с интенсивной проходимостью комплектуют усиленными доводчиками и направляющими, рассчитанными на сотни открываний ежедневно.' }
];

const materials = [
  { title: 'Триплекс', text: 'Основной материал для витрин и фасадных конструкций первого этажа — безопасен при ударной нагрузке с улицы.' },
  { title: 'Закалённое стекло', text: 'Применяется для дверей и внутренних перегородок торгового помещения.' },
  { title: 'Алюминиевые профильные системы', text: 'Формируют минималистичный каркас витрины и входной группы.' },
  { title: 'Фурнитура', text: 'Усиленные доводчики и направляющие для дверей с высокой интенсивностью использования.' }
];

const priceFactors = [
  'площадь витрины или фасада',
  'тип и толщина стекла',
  'система профиля',
  'фурнитура под трафик',
  'нанесение логотипа или плёнки',
  'монтаж и график работ в помещении'
];

const safetyPoints = [
  { title: 'Безопасное стекло на уровне улицы', text: 'Триплекс для витрин не рассыпается при повреждении — критически важно для конструкций, доступных прохожим.' },
  { title: 'Устойчивость к ежедневному трафику', text: 'Входные группы с интенсивным использованием комплектуют фурнитурой, рассчитанной на сотни открываний ежедневно без потери плавности хода.' },
  { title: 'Проверенное закалённое стекло', text: 'Для ответственных конструкций применяется стекло с подтверждённой термической обработкой, что снижает риск спонтанного разрушения.' }
];

const processSteps = [
  { title: 'Консультация', text: 'Уточняем задачу, тип помещения, желаемый результат и ориентировочный бюджет.' },
  { title: 'Замер', text: 'Выезжаем на объект и фиксируем фактическую геометрию фасада или торгового зала.' },
  { title: 'Проектирование', text: 'Готовим чертёж с размерами, стеклом, профилем и узлами крепления.' },
  { title: 'Изготовление', text: 'Производим конструкцию на собственном оборудовании под согласованные параметры.' },
  { title: 'Доставка', text: 'Упаковываем и доставляем готовую конструкцию в Киеве, Одессе, Львове и по Украине.' },
  { title: 'Монтаж', text: 'Устанавливаем, проверяем работу механизмов и передаём объект с гарантией.' }
];

const experienceStats = [
  { value: '10+', label: 'лет реального опыта в реализации стеклянных и алюминиевых конструкций' },
  { value: '5 000+', label: 'реализованных проектов для дома и бизнеса в Украине и Европе' },
  { value: '50 000+', label: 'м² выполненного остекления жилых и коммерческих объектов' }
];


const faq: [string, string][] = [
  ['Какое стекло используют для витрины магазина?', 'Чаще всего триплекс — при повреждении он остаётся целым, что важно для конструкций на уровне улицы.'],
  ['Можно ли заказать витрину под нестандартный размер проёма?', 'Да, витрины и входные группы изготавливают по фактической геометрии фасада конкретного помещения.'],
  ['Выдерживает ли входная группа интенсивный трафик?', 'Да, при усиленной фурнитуре — доводчиках и направляющих, подобранных под ожидаемое количество открываний в день.'],
  ['Можно ли нанести логотип или плёнку на витрину?', 'Да, гравировку, тонировку или брендированную плёнку наносим по согласованному макету.'],
  ['Сколько длится изготовление витрины?', 'Срок зависит от размеров и сложности конструкции, фиксируется после замера и согласования чертежа.'],
  ['Можно ли интегрировать подсветку в витрину?', 'Да, подсветку согласовываем на этапе проектирования — она подчёркивает товар и фасад магазина в тёмное время суток.'],
  ['Что такое Heat Soak Test и нужен ли он для витрины?', 'Это дополнительная термическая проверка закалённого стекла, которая снижает риск спонтанного разрушения — применяется для ответственных фасадных конструкций.'],
  ['Можно ли зонировать торговый зал без глухих перегородок?', 'Да, прозрачные или матированные стеклянные перегородки отделяют примерочные или кассовую зону, сохраняя обзор товара.'],
  ['Проводите ли монтаж без остановки работы магазина?', 'График монтажа согласовываем индивидуально, чтобы минимизировать влияние на работу торгового помещения.'],
  ['Можно ли заказать примерочные со стеклянными дверями?', 'Да, матированное или сатинированное стекло обеспечивает приватность, сохраняя свет в зоне примерочной.'],
  ['Сколько стоит стеклянная витрина для магазина?', 'Стоимость зависит от площади, толщины стекла, профиля и фурнитуры. Предварительный расчёт готовим по фото и примерным размерам.'],
  ['Нужен ли профессиональный замер перед изготовлением?', 'Да, финальный замер фиксирует фактическую геометрию фасадного проёма перед изготовлением витрины.'],
  ['Можно ли заказать только изготовление без монтажа?', 'В ряде случаев да, с доставкой готовой конструкции — детали согласовываются индивидуально.'],
  ['Как ухаживать за стеклянной витриной магазина?', 'Используйте неабразивные средства для стекла и регулярно проверяйте направляющие и уплотнения входной группы.'],
  ['Можно ли заказать раздвижную входную группу для магазина?', 'Да, раздвижные системы экономят пространство прохода там, где прогнозируется высокий трафик покупателей.'],
  ['Есть ли гарантия на конструкции для магазина?', 'Да, гарантийные условия фиксируются в договоре и зависят от типа конструкции и объёма проекта.'],
  ['Можно ли работать по чертежам архитектора или дизайнера?', 'Да, можем реализовать проект по предоставленным чертежам, согласовав технические детали стекла и профиля.'],
  ['Возможна ли доставка оборудования в другие города?', 'Да, реализуем проекты по всей Украине — условия доставки и монтажа согласовываются под конкретный объект.'],
  ['Можно ли заменить часть витрины без демонтажа всей конструкции?', 'Это зависит от конструктива — модульные системы позволяют заменить отдельную секцию, сплошные полотна изготавливают заново.'],
  ['Что делать, если фасад помещения ещё не готов к замеру?', 'Предварительный расчёт можно получить по чертежу или фото проекта, финальный замер — после завершения фасадных работ.']
];


const breadcrumbItems = [
  { label: 'Главная', href: lp('/') },
  { label: 'Решения', href: lp('/rishennya/') },
  { label: 'Для магазина', href: lp(PATH) }
];

const structuredData: JsonLdObject[] = [
  breadcrumbSchema(breadcrumbItems.map((item) => ({ label: item.label, href: absoluteUrl(item.href, origin) }))),
  faqSchema(faq.map(([question, answer]) => ({ question, answer })))
].filter(Boolean) as JsonLdObject[];
---
<SolutionDetailPage
  path={PATH}
  title={title}
  description={description}
  h1={h1}
  heroLead={heroLead}
  heroImage={heroImage}
  scenarios={scenarios}
  choosePoints={choosePoints}
  materials={materials}
  safetyPoints={safetyPoints}
  priceFactors={priceFactors}
  processSteps={processSteps}
  experienceStats={experienceStats}
  faq={faq}
  breadcrumbItems={breadcrumbItems}
  structuredData={structuredData}
  formExample="Стеклянная витрина и входная группа для магазина во Львове"
  locale="ru"
/>
