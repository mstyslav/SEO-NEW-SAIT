---
// RU version of /rishennya/dlya-restoranu/ — shared SolutionDetailPage template with locale="ru"; tiles, projects and
// SEO copy come from src/data/ru/solution-pages.ru.ts.
import SolutionDetailPage from '../../../components/solutions/SolutionDetailPage.astro';
import { absoluteUrl, breadcrumbSchema, faqSchema, type JsonLdObject } from '../../../seo/schema';
import { localizedPath } from '../../../i18n/helpers';

const PATH = '/rishennya/dlya-restoranu/';
const lp = (path: string) => localizedPath(path, 'ru');
const origin = Astro.site ?? Astro.url.origin;

const title = 'Стеклянные конструкции для ресторана на заказ | Space Glass';
const description =
  'Стеклянные конструкции для ресторана на заказ: перегородки, витрины, террасы и фасадное остекление. Проектирование, изготовление и монтаж Space Glass в Киеве, Одессе, Львове и по Украине.';
const h1 = 'Стеклянные конструкции для ресторана';
const heroLead =
  'Перегородки, витрины, террасы и фасадное остекление для ресторанов и кафе — решения, которые зонируют пространство и сохраняют видимость зала в Киеве, Одессе, Львове и по всей Украине.';
const heroImage = {
  base: 'solution-restaurant',
  width: 1280,
  height: 854,
  alt: 'Современный ресторан с панорамным стеклянным фасадом и стеклянными перегородками'
};


const scenarios = [
  { title: 'Терраса, которая живёт сезонно', text: 'Раздвижное или безрамное остекление открывает террасу весной и закрывает на зимний период без демонтажа конструкции.' },
  { title: 'Зал без ощущения тесноты', text: 'Прозрачные или частично матовые перегородки отделяют банкетную зону от общего зала, сохраняя пространство и свет.' },
  { title: 'Витрина как часть уличного трафика', text: 'Панорамное фасадное остекление показывает интерьер прохожим ещё до входа в заведение.' },
  { title: 'Приватная VIP-зона в зале', text: 'Стеклянная перегородка с дверью выделяет отдельный кабинет для гостей, не изолируя его визуально от общего зала.' }
];

const choosePoints = [
  { title: 'Слайдинговая или складная система', text: 'Слайдинговые панели раздвигаются вдоль направляющей, складные — собираются гармошкой сбоку. Выбор зависит от ширины проёма и желаемого угла открытия.', link: { label: 'Слайдинговая или складная система остекления: что лучше', href: '/knowledge/slaydingova-chy-skladana-systema/' } },
  { title: 'Тёплое или холодное остекление террасы', text: 'Холодный контур подходит для сезонной летней террасы. Тёплый контур со стеклопакетом позволяет использовать пространство и в прохладное время.', link: { label: 'Тёплое или холодное остекление террасы: разница', href: '/knowledge/teple-chy-kholodne-sklinnya-terasy/' } },
  { title: 'Безрамное остекление для максимального обзора', text: 'Отсутствие вертикальных стоек сохраняет панораму улицы или двора — важно для террас с видом, который является частью атмосферы заведения.', link: { label: 'Системы безрамного остекления: как выбрать механику', href: '/knowledge/bezramne-sklinnya-systemy-yak-obraty/' } }
];

const materials = [
  { title: 'Закалённое стекло', text: 'Применяется для перегородок и дверей в зоне обслуживания гостей — безопасно при интенсивном использовании.' },
  { title: 'Триплекс', text: 'Используется для фасадного остекления и витрин, где важна дополнительная безопасность на уровне улицы.' },
  { title: 'Алюминиевые раздвижные системы', text: 'Позволяют полностью открывать террасу в тёплый сезон и закрывать на зиму.' },
  { title: 'Фурнитура', text: 'Ролики и направляющие для раздвижных фасадов подбираются под частоту открывания в течение дня.' }
];

const priceFactors = [
  'площадь террасы или фасада',
  'тип системы остекления — слайдинговая, складная или безрамная',
  'тёплая или холодная конструкция',
  'стекло и фурнитура',
  'количество дверных и фасадных групп',
  'монтаж и сезонность работ'
];

const safetyPoints = [
  { title: 'Безопасное стекло на уровне улицы', text: 'Триплекс для витрин и фасадных участков первого этажа не рассыпается при повреждении — важно для конструкций, доступных с тротуара.' },
  { title: 'Устойчивость к сезонным нагрузкам', text: 'Раздвижные и безрамные системы террас рассчитывают на ветровую нагрузку и циклы открывания в течение сезона.' },
  { title: 'Гигиеничные поверхности в зале', text: 'Стеклянные перегородки и двери в зоне обслуживания гостей легко очищаются и не накапливают запахи, в отличие от текстильных разделителей.' }
];

const processSteps = [
  { title: 'Консультация', text: 'Уточняем задачу, тип заведения, желаемый результат и ориентировочный бюджет.' },
  { title: 'Замер', text: 'Выезжаем на объект и фиксируем фактическую геометрию террасы, фасада или зала.' },
  { title: 'Проектирование', text: 'Готовим чертёж с размерами, стеклом, профилем и узлами крепления.' },
  { title: 'Изготовление', text: 'Производим конструкцию на собственном оборудовании под согласованные параметры.' },
  { title: 'Доставка', text: 'Упаковываем и доставляем готовую конструкцию в Киеве, Одессе, Львове и по Украине.' },
  { title: 'Монтаж', text: 'Устанавливаем, проверяем работу механизмов и передаём объект с гарантией.' }
];

const experienceStats = [
  { value: '10+', label: 'лет реального опыта в реализации стеклянных и алюминиевых конструкций' },
  { value: '5 000+', label: 'реализованных проектов для дома и бизнеса в Украине и Европе' },
  { value: '50 000+', label: 'м² выполненного остекления жилых и коммерческих объектов' }
];


const faq: [string, string][] = [
  ['Можно ли застеклить террасу ресторана на лето?', 'Да, раздвижные или безрамные системы позволяют полностью открывать террасу летом и закрывать на холодный сезон.'],
  ['Какое стекло используют для витрины кафе?', 'Чаще всего триплекс — он безопаснее на уровне улицы и выдерживает внешние нагрузки.'],
  ['Можно ли зонировать зал без глухих перегородок?', 'Да, прозрачные или частично матовые стеклянные перегородки разделяют пространство, сохраняя свет и видимость зала.'],
  ['Проводите ли монтаж без остановки работы заведения?', 'График монтажа согласовываем индивидуально, чтобы минимизировать влияние на работу заведения.'],
  ['Можно ли нанести логотип на стекло витрины?', 'Да, гравировку или плёнку с логотипом наносим по согласованному макету.'],
  ['Можно ли менять конфигурацию террасы между сезонами?', 'Да, раздвижные и безрамные системы позволяют каждый год открывать террасу весной и закрывать на зиму без замены конструкции.'],
  ['Слайдинговая или складная система лучше для террасы ресторана?', 'Слайдинговая подходит для широких проёмов с равномерным раздвижением, складная — там, где нужен больший угол открытия сбоку.'],
  ['Запотевает ли стекло витрины зимой?', 'Это зависит от перепада температур и вентиляции зала — энергоэффективный стеклопакет снижает риск конденсата.'],
  ['Можно ли отделить банкетный зал без ремонта?', 'Да, стеклянные перегородки монтируются в готовый проём без демонтажа потолков и пола.'],
  ['Сколько стоит остекление террасы ресторана?', 'Стоимость зависит от площади, типа системы и стекла. Предварительный расчёт готовим по фото и примерным размерам.'],
  ['Можно ли установить двери прямо в стеклянную витрину?', 'Да, входная группа проектируется как часть фасадной конструкции ещё на этапе чертежа.'],
  ['Нужен ли профессиональный замер для террасы?', 'Да, финальный замер фиксирует фактическую геометрию террасы или фасада перед изготовлением конструкции.'],
  ['Можно ли полностью демонтировать остекление террасы на зиму?', 'Это зависит от выбранной системы — раздвижные и складные конструкции обычно не демонтируют, а закрывают на сезон.'],
  ['Выдерживает ли фасадное остекление интенсивный поток гостей?', 'Да, при усиленной фурнитуре для дверей и входных групп с высокой проходимостью.'],
  ['Сколько длится изготовление остекления террасы?', 'Срок зависит от площади и сложности конструкции, фиксируется после замера и согласования чертежа.'],
  ['Можно ли заказать только изготовление без монтажа?', 'В ряде случаев да, с доставкой готовой конструкции — детали согласовываются индивидуально.'],
  ['Как ухаживать за раздвижными системами террасы?', 'Регулярно очищайте направляющие от пыли и песка, проверяйте ролики и уплотнения перед началом сезона.'],
  ['Можно ли застеклить террасу нестандартной формы?', 'Да, конструкции проектируют по фактической геометрии террасы конкретного заведения.'],
  ['Есть ли гарантия на конструкции для ресторана?', 'Да, гарантийные условия фиксируются в договоре и зависят от типа системы и объёма проекта.'],
  ['Что делать, если помещение заведения ещё на этапе ремонта?', 'Предварительный расчёт можно получить по чертежу или плану помещения, финальный замер — после завершения черновых работ.']
];


const breadcrumbItems = [
  { label: 'Главная', href: lp('/') },
  { label: 'Решения', href: lp('/rishennya/') },
  { label: 'Для ресторана', href: lp(PATH) }
];

const structuredData: JsonLdObject[] = [
  breadcrumbSchema(breadcrumbItems.map((item) => ({ label: item.label, href: absoluteUrl(item.href, origin) }))),
  faqSchema(faq.map(([question, answer]) => ({ question, answer })))
].filter(Boolean) as JsonLdObject[];
---
<SolutionDetailPage
  path={PATH}
  title={title}
  description={description}
  h1={h1}
  heroLead={heroLead}
  heroImage={heroImage}
  scenarios={scenarios}
  choosePoints={choosePoints}
  materials={materials}
  safetyPoints={safetyPoints}
  priceFactors={priceFactors}
  processSteps={processSteps}
  experienceStats={experienceStats}
  faq={faq}
  breadcrumbItems={breadcrumbItems}
  structuredData={structuredData}
  formExample="Стеклянная перегородка между залами ресторана в Одессе"
  locale="ru"
/>
