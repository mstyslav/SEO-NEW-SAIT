---
// RU version of /rishennya/dlya-hotelyu/ — shared SolutionDetailPage template with locale="ru"; tiles, projects and
// SEO copy come from src/data/ru/solution-pages.ru.ts.
import SolutionDetailPage from '../../../components/solutions/SolutionDetailPage.astro';
import { absoluteUrl, breadcrumbSchema, faqSchema, type JsonLdObject } from '../../../seo/schema';
import { localizedPath } from '../../../i18n/helpers';

const PATH = '/rishennya/dlya-hotelyu/';
const lp = (path: string) => localizedPath(path, 'ru');
const origin = Astro.site ?? Astro.url.origin;

const title = 'Стеклянные конструкции для гостиницы на заказ | Space Glass';
const description =
  'Стеклянные конструкции для гостиницы на заказ: душевые, перегородки, ограждения, двери, фасады. Комплексные решения Space Glass в Киеве, Одессе, Львове и по Украине.';
const h1 = 'Стеклянные конструкции для гостиницы';
const heroLead =
  'Комплексное остекление гостиничных номеров и общественных зон: душевые, перегородки, входные группы и фасадные системы для объектов HoReCa в Киеве, Одессе, Львове и по всей Украине.';
const heroImage = {
  base: 'solution-hotel',
  width: 1280,
  height: 960,
  alt: 'Премиальная гостиница со стеклянной входной группой и панорамным фасадным остеклением'
};


const scenarios = [
  { title: 'Номерной фонд, который нужно оснастить одинаково', text: 'Типоразмер душевой или перегородки согласовывают один раз и тиражируют на десятки номеров — это ускоряет изготовление и дальнейший сервис.' },
  { title: 'Лобби и ресепшн как лицо гостиницы', text: 'Панорамное фасадное остекление работает на первое впечатление гостя ещё с улицы.' },
  { title: 'Зеркала для номеров и санузлов', text: 'Зеркала с LED-подсветкой тиражируются по единому техническому решению для всего номерного фонда.' },
  { title: 'Замена конструкций без остановки заселения', text: 'Монтаж разбивают на этапы по этажам или блокам номеров по согласованному графику.' }
];

const choosePoints = [
  { title: 'Формат душевой под номер', text: 'Walk-in оставляет открытый проход и хорошо работает в просторных санузлах. Ниша или угловая конструкция экономят место в компактных номерах.', link: { label: 'Как выбрать душевую кабину из стекла', href: '/knowledge/yak-obraty-dushovu-kabinu/' } },
  { title: 'Walk-in или закрытая кабина', text: 'Walk-in проще в ежедневной уборке между заездами гостей. Закрытая кабина лучше удерживает тепло и брызги.', link: { label: 'Душевая Walk-in: преимущества, ограничения и размеры', href: '/knowledge/walk-in-perevahy-nedoliky/' } },
  { title: 'Зеркало для номера', text: 'Размер, форма и тип подсветки согласовываются под единый дизайн-код гостиницы и тиражируются на весь номерной фонд.', link: { label: 'Как выбрать размер и форму зеркала', href: '/knowledge/yak-obraty-dzerkalo-rozmir-forma/' } }
];

const materials = [
  { title: 'Закалённое стекло', text: 'Базовый материал для душевых и перегородок номерного фонда — безопасный и простой в ежедневном обслуживании.' },
  { title: 'Триплекс', text: 'Применяется для ограждений террас и бассейнов, а также фасадных участков с повышенными требованиями к безопасности.' },
  { title: 'Алюминиевые фасадные системы', text: 'Стоечно-ригельные конструкции для панорамного остекления лобби и общественных зон.' },
  { title: 'Фурнитура для интенсивной эксплуатации', text: 'Усиленные петли, доводчики и замки, рассчитанные на ежедневную нагрузку гостиничного объекта.' }
];

const priceFactors = [
  'количество номеров и типоразмеров',
  'тип душевой или перегородки',
  'стекло и фурнитура',
  'фасадные системы общественных зон',
  'график поэтапного монтажа',
  'доставка на объект'
];

const safetyPoints = [
  { title: 'Безопасное стекло для гостей', text: 'Закалённое стекло душевых и перегородок безопасно при повреждении и соответствует стандартным требованиям к конструкциям общественного использования.' },
  { title: 'Устойчивость к интенсивной эксплуатации', text: 'Фурнитуру для общественных зон подбирают с расчётом на ежедневное интенсивное использование гостями — усиленные направляющие, доводчики и защитные покрытия.' },
  { title: 'Унифицированное техническое решение', text: 'Единая спецификация стекла, профиля и фурнитуры для всего номерного фонда упрощает дальнейший сервис и замену отдельных элементов.' }
];

const processSteps = [
  { title: 'Консультация', text: 'Уточняем количество номеров, типоразмеры, желаемый результат и ориентировочный бюджет проекта.' },
  { title: 'Замер', text: 'Выезжаем на объект и фиксируем фактическую геометрию номеров или общественных зон.' },
  { title: 'Проектирование', text: 'Готовим чертёж с размерами, стеклом, профилем и узлами крепления для типового решения.' },
  { title: 'Изготовление', text: 'Производим партию конструкций на собственном оборудовании под согласованные параметры.' },
  { title: 'Доставка', text: 'Упаковываем и доставляем готовые конструкции в Киеве, Одессе, Львове и по Украине.' },
  { title: 'Монтаж', text: 'Устанавливаем поэтапно по согласованному графику и передаём объект с гарантией.' }
];

const experienceStats = [
  { value: '10+', label: 'лет реального опыта в реализации стеклянных и алюминиевых конструкций' },
  { value: '5 000+', label: 'реализованных проектов для дома и бизнеса в Украине и Европе' },
  { value: '50 000+', label: 'м² выполненного остекления жилых и коммерческих объектов' }
];


const faq: [string, string][] = [
  ['Можно ли изготовить одинаковые душевые кабины для всех номеров?', 'Да, для гостиниц согласовываем один типоразмер и комплектацию, что ускоряет изготовление и монтаж всей партии.'],
  ['Проводите ли монтаж без остановки работы гостиницы?', 'График монтажа согласовываем индивидуально, чтобы минимизировать влияние на заселённых гостей и работу персонала.'],
  ['Какое стекло используют для фасада гостиницы?', 'Чаще всего триплекс или энергоэффективные стеклопакеты в алюминиевой стоечно-ригельной системе.'],
  ['Возможна ли поэтапная замена душевых в номерах?', 'Да, замену можно разбить на этапы по этажам или блокам номеров по согласованному графику.'],
  ['Предоставляется ли гарантия на гостиничные объекты?', 'Да, гарантийные условия фиксируются в договоре и зависят от типа конструкции и объёма проекта.'],
  ['Возможна ли работа за пределами Киева, Одессы и Львова?', 'Да, реализуем гостиничные проекты по всей Украине — условия доставки и монтажа согласовываются под конкретный объект.'],
  ['Сколько времени занимает монтаж душевой в одном номере?', 'Срок зависит от типа конструкции и готовности помещения, фиксируется после замера и согласования графика.'],
  ['Можно ли получить образец или фото до заказа партии?', 'Да, для больших партий согласовываем эталонный образец конструкции перед запуском полного изготовления.'],
  ['Подходят ли зеркала с подсветкой для номеров?', 'Да, LED-подсветка согласовывается как часть единого дизайн-кода гостиницы и тиражируется на весь номерной фонд.'],
  ['Можно ли заказать ограждение для бассейна гостиницы?', 'Да, ограждения бассейнов выполняют из триплекса с учётом требований безопасности для зон с повышенной влажностью.'],
  ['Выдерживает ли стекло в общественных зонах интенсивный трафик?', 'Да, при усиленной фурнитуре — доводчиках и направляющих, подобранных под ожидаемое количество гостей.'],
  ['Можно ли заказать нестандартный размер душевой для мансардных номеров?', 'Да, конструкции под нестандартную геометрию проектируют индивидуально после замера.'],
  ['Что входит в комплектацию серийного заказа?', 'Стекло, профиль, фурнитура, изготовление, доставка и монтаж — комплектация фиксируется в коммерческом предложении.'],
  ['Можно ли изменить комплектацию во время выполнения проекта?', 'До запуска производства — да, после повторного согласования спецификации для всей партии.'],
  ['Как ухаживать за душевыми и перегородками в гостинице?', 'Используйте неабразивные средства, регулярно проверяйте направляющие и уплотнения при ежедневной уборке.'],
  ['Можно ли установить входную группу под фирменный стиль гостиницы?', 'Да, профиль, стекло и фурнитуру подбирают с учётом архитектуры и брендбука объекта.'],
  ['Сколько длится изготовление партии для номерного фонда?', 'Срок зависит от количества единиц и сложности конструкции, фиксируется после согласования спецификации.'],
  ['Возможны ли доставка и монтаж в несколько этапов для разных этажей?', 'Да, крупные проекты обычно реализуют поэтапно по согласованному графику.'],
  ['Нужен ли отдельный проект для лобби и номеров?', 'Да, общественные зоны и номера имеют разные требования к стеклу и нагрузкам, поэтому проектируются отдельно.'],
  ['Что делать, если после заселения части номеров выявлена нестандартная геометрия?', 'Такие номера фиксируют отдельно на замере — для них готовят индивидуальное решение в рамках общего проекта.']
];


const breadcrumbItems = [
  { label: 'Главная', href: lp('/') },
  { label: 'Решения', href: lp('/rishennya/') },
  { label: 'Для гостиницы', href: lp(PATH) }
];

const structuredData: JsonLdObject[] = [
  breadcrumbSchema(breadcrumbItems.map((item) => ({ label: item.label, href: absoluteUrl(item.href, origin) }))),
  faqSchema(faq.map(([question, answer]) => ({ question, answer })))
].filter(Boolean) as JsonLdObject[];
---
<SolutionDetailPage
  path={PATH}
  title={title}
  description={description}
  h1={h1}
  heroLead={heroLead}
  heroImage={heroImage}
  scenarios={scenarios}
  choosePoints={choosePoints}
  materials={materials}
  safetyPoints={safetyPoints}
  priceFactors={priceFactors}
  processSteps={processSteps}
  experienceStats={experienceStats}
  faq={faq}
  breadcrumbItems={breadcrumbItems}
  structuredData={structuredData}
  formExample="Стеклянные душевые перегородки для номеров гостиницы в Одессе"
  locale="ru"
/>
