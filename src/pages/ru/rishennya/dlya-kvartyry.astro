---
// RU version of /rishennya/dlya-kvartyry/ — shared SolutionDetailPage template with locale="ru"; tiles, projects and
// SEO copy come from src/data/ru/solution-pages.ru.ts.
import SolutionDetailPage from '../../../components/solutions/SolutionDetailPage.astro';
import { absoluteUrl, breadcrumbSchema, faqSchema, type JsonLdObject } from '../../../seo/schema';
import { localizedPath } from '../../../i18n/helpers';

const PATH = '/rishennya/dlya-kvartyry/';
const lp = (path: string) => localizedPath(path, 'ru');
const origin = Astro.site ?? Astro.url.origin;

const title = 'Стеклянные конструкции для квартиры на заказ | Space Glass';
const description =
  'Стеклянные конструкции для квартиры на заказ: душевые кабины, перегородки, стеклянные двери, зеркала и ограждения. Проектирование, изготовление и монтаж в Киеве, Одессе, Львове и по Украине.';
const h1 = 'Стеклянные конструкции для квартиры';
const heroLead =
  'Индивидуальные стеклянные решения для ванной, кухни, гардеробной и жилого пространства — от замера и проектирования до изготовления и монтажа в Киеве, Одессе, Львове и по всей Украине.';
const heroImage = {
  base: 'solution-apartment',
  width: 1280,
  height: 1001,
  alt: 'Современная квартира со стеклянной перегородкой в чёрном алюминиевом профиле'
};


const scenarios = [
  { title: 'Ванная без второго окна', text: 'Прозрачная или слегка тонированная душевая перегородка не забирает единственный источник света в комнате — в отличие от глухой стены или шторки.' },
  { title: 'Кухня-студия без стен', text: 'Раздвижная стеклянная перегородка отделяет кухню от гостиной, когда нужно локализовать запахи, и полностью открывает пространство в другое время.' },
  { title: 'Двухуровневая квартира с лестницей', text: 'Стеклянное ограждение заменяет глухие перила и сохраняет свет между этажами дуплекса или мансарды.' },
  { title: 'Гардеробная вместо кладовки', text: 'Стеклянные двери или раздвижная система открывают гардеробную, не перегружая небольшой коридор глухими створками.' }
];

const materials = [
  { title: 'Закалённое стекло', text: 'Базовый материал для душевых кабин, перегородок и дверей — безопасен при повреждении и устойчив к влаге и перепадам температуры.' },
  { title: 'Толщина стекла', text: 'Толщину для перегородок и дверей подбирают индивидуально — по размеру полотна, количеству опор и нагрузке.', link: { label: 'Как выбирают толщину стекла', href: '/knowledge/tovshchyna-skla-8-10-12-mm/' } },
  { title: 'Триплекс', text: 'Применяется для ограждений лестниц и антресолей в двухуровневых квартирах, где стекло несёт конструктивную нагрузку.' },
  { title: 'Алюминиевый профиль', text: 'Формирует каркас перегородок и дверей, доступен в разных цветах под интерьер — от чёрного матового до натурального алюминия.' }
];

const choosePoints = [
  { title: 'Стекло для влажных зон', text: 'Для душевых кабин и перегородок в ванной применяют закалённое стекло с водоотталкивающим покрытием — оно выдерживает перепады температуры и дольше остаётся чистым без разводов.' },
  { title: 'Матовое или прозрачное стекло', text: 'Матовое, сатинированное или тонированное стекло скрывает комнату от соседних помещений, сохраняя свет. Прозрачное стекло подходит там, где приватность не критична — например, для перегородки кухни-студии.' },
  { title: 'Раздвижные или распашные системы', text: 'В небольших комнатах раздвижные двери и перегородки экономят пространство для открывания. Распашные системы привычнее в эксплуатации и подходят для просторных санузлов и гардеробных.', link: { label: 'Распашные или раздвижные двери: как выбрать', href: '/knowledge/rozpashni-chy-rozsuvni-sklyani-dveri/' } }
];

const safetyPoints = [
  { title: 'Безопасное стекло', text: 'Закалённое стекло при повреждении рассыпается на мелкие тупые гранулы без острых краёв — это стандарт безопасности для душевых, дверей и перегородок в жилом пространстве.', link: { label: 'Как выбрать душевую кабину из стекла', href: '/knowledge/yak-obraty-dushovu-kabinu/' } },
  { title: 'Приватность без глухих стен', text: 'Матирование, сатинирование или тонирование закрывают комнату от посторонних глаз, сохраняя естественный свет — актуально для санузла, гардеробной или спальни за перегородкой.' },
  { title: 'Безопасность для детей и быта', text: 'Кромки стекла обрабатываются, а фурнитура подбирается под нагрузку конкретной конструкции, чтобы исключить люфт и случайное защемление.' }
];

const priceFactors = [
  'площадь и количество полотен конструкции',
  'тип и толщина стекла',
  'цвет и система профиля',
  'фурнитура и тип открывания',
  'сложность геометрии помещения',
  'монтаж и доступ к объекту'
];

const processSteps = [
  { title: 'Консультация', text: 'Уточняем задачу, тип помещения, желаемый результат и ориентировочный бюджет.' },
  { title: 'Замер', text: 'Выезжаем на объект и фиксируем фактическую геометрию проёма или помещения.' },
  { title: 'Проектирование', text: 'Готовим чертёж с размерами, стеклом, профилем и узлами крепления.' },
  { title: 'Изготовление', text: 'Производим конструкцию на собственном оборудовании под согласованные параметры.' },
  { title: 'Доставка', text: 'Упаковываем и доставляем готовую конструкцию в Киеве, Одессе, Львове и по Украине.' },
  { title: 'Монтаж', text: 'Устанавливаем, проверяем работу механизмов и передаём объект с гарантией.' }
];

const experienceStats = [
  { value: '10+', label: 'лет реального опыта в реализации стеклянных и алюминиевых конструкций' },
  { value: '5 000+', label: 'реализованных проектов для дома и бизнеса в Украине и Европе' },
  { value: '50 000+', label: 'м² выполненного остекления жилых и коммерческих объектов' }
];


const faq: [string, string][] = [
  ['Какое стекло лучше для душевой кабины в квартире?', 'Закалённое стекло толщиной от 6 до 10 мм с водоотталкивающим покрытием — оно безопасно, выдерживает влажность и легче очищается от известкового налёта.'],
  ['Можно ли заказать перегородку без демонтажа ремонта?', 'Да, большинство перегородок и дверей монтируются в готовый проём после финишной отделки без нарушения соседних стен.'],
  ['Сколько стоит стеклянная перегородка для квартиры?', 'Стоимость зависит от размеров, типа стекла, профиля и фурнитуры. Предварительный расчёт готовим по фото и примерным размерам.'],
  ['Делают ли зеркала нестандартной формы?', 'Да, зеркала изготавливают любой согласованной формы, размера и типа подсветки под конкретную стену или нишу.'],
  ['Нужен ли профессиональный замер?', 'Для точного изготовления да — финальный замер проводят после завершения стен, пола и потолка в зоне монтажа.'],
  ['Можно ли получить предварительный расчёт без выезда мастера?', 'Да, для ориентировочной оценки достаточно фото помещения, примерных размеров и пожеланий по стеклу — точную стоимость подтверждаем после замера.'],
  ['Какая толщина стекла используется для цельностеклянных перегородок?', 'Обычно от 6 до 16 мм — конкретную толщину подбирают в зависимости от размера, способа крепления и нагрузки на конструкцию.'],
  ['Чем закалённое стекло безопаснее обычного?', 'При повреждении оно рассыпается на мелкие тупые гранулы без острых краёв, тогда как обычное стекло образует опасные осколки.'],
  ['Можно ли сделать перегородку матовой для приватности?', 'Да, доступны матовое, сатинированное и тонированное стекло — они скрывают комнату от соседних помещений, сохраняя естественный свет.'],
  ['Подходят ли раздвижные двери для маленькой комнаты?', 'Да, раздвижные системы не требуют пространства для открывания створки, поэтому экономят место в небольших комнатах и коридорах.'],
  ['Сколько длится изготовление перегородки или дверей?', 'Срок зависит от размеров, стекла и фурнитуры, фиксируется после согласования чертежа и комплектации.'],
  ['Можно ли изменить размеры после оформления заказа?', 'До запуска в производство — да, после повторного согласования. Закалённое стекло после изготовления уже не подрезают и не сверлят.'],
  ['Можно ли установить стеклянную конструкцию в арендованной квартире?', 'Да, по согласованию с владельцем — перегородки, двери и душевые монтируются без нарушения несущих стен и коммуникаций.'],
  ['Как ухаживать за стеклянной перегородкой или дверями?', 'Используйте неабразивные средства, регулярно очищайте направляющие и уплотнения, обращайтесь в сервис при появлении люфта.'],
  ['Глушит ли стеклянная перегородка звук между комнатами?', 'Стеклянная перегородка не заменяет капитальную стену по уровню звукоизоляции, но плотные притворы и более толстое стекло заметно снижают бытовой шум и сохраняют ощущение отдельного помещения.'],
  ['Чем loft-перегородка отличается от обычной стеклянной?', 'Loft-перегородка имеет видимый металлический профиль-сетку, который делит полотно на секции, — узнаваемый стиль для кухни или гостиной. Обычная перегородка может быть сплошным полотном без такого деления.'],
  ['Безопасны ли стеклянные перегородки для детей?', 'Да, применяется закалённое или ламинированное стекло без острых краёв, а фурнитура подбирается под нагрузку конкретной конструкции.'],
  ['Можно ли заказать только изготовление без монтажа?', 'В ряде случаев да, с доставкой готовой конструкции — детали согласовываются индивидуально.'],
  ['Нужен ли отдельный каркас для зеркала с LED-подсветкой?', 'Нет, подсветка интегрируется непосредственно в конструкцию зеркала ещё на этапе проектирования.'],
  ['Что делать, если стены в квартире неровные?', 'Отклонения фиксируются при замере и учитываются профилями крепления или индивидуальной геометрией стекла.']
];


const breadcrumbItems = [
  { label: 'Главная', href: lp('/') },
  { label: 'Решения', href: lp('/rishennya/') },
  { label: 'Для квартиры', href: lp(PATH) }
];

const structuredData: JsonLdObject[] = [
  breadcrumbSchema(breadcrumbItems.map((item) => ({ label: item.label, href: absoluteUrl(item.href, origin) }))),
  faqSchema(faq.map(([question, answer]) => ({ question, answer })))
].filter(Boolean) as JsonLdObject[];
---
<SolutionDetailPage
  path={PATH}
  title={title}
  description={description}
  h1={h1}
  heroLead={heroLead}
  heroImage={heroImage}
  scenarios={scenarios}
  choosePoints={choosePoints}
  materials={materials}
  safetyPoints={safetyPoints}
  priceFactors={priceFactors}
  processSteps={processSteps}
  experienceStats={experienceStats}
  faq={faq}
  breadcrumbItems={breadcrumbItems}
  structuredData={structuredData}
  formExample="Loft-перегородка для кухни с матовым стеклом в Киеве"
  locale="ru"
/>
