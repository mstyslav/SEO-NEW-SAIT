---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const solutions = [
  ['Для квартиры', 'Душевые, перегородки, двери, зеркала и ограждения для современной квартиры.', '/images/v5/project-1.webp', '/rishennya/dlya-kvartyry/?lang=ru'],
  ['Для частного дома', 'Лестницы, террасы, душевые, перегородки, фасады и входные системы.', '/images/v5/project-2.webp', '/rishennya/dlya-budynku/?lang=ru'],
  ['Для офиса', 'Офисные перегородки, двери, мобильные системы и фасадное остекление.', '/images/v5/project-3.webp', '/rishennya/dlya-ofisu/?lang=ru'],
  ['Для отеля', 'Душевые, ограждения, перегородки, зеркала и фасадные системы для HoReCa.', '/images/v5/project-4.webp', '/rishennya/dlya-hotelyu/?lang=ru'],
  ['Для ресторана', 'Перегородки, фасады, двери, террасы, зеркала и декоративное стекло.', '/images/s19/menu-loft.webp', '/rishennya/dlya-restoranu/?lang=ru']
];
---
<BaseLayout title="Готовые решения Space Glass" description="Готовые стеклянные решения Space Glass для квартир, домов, офисов, отелей и ресторанов." locale="ru">
  <div class="sg-page-shell">
    <Header locale="ru" />
    <main id="main">
      <section class="projects-v14-hero">
        <p class="eyebrow">Готовые решения</p>
        <h1>Стеклянные решения для вашего пространства</h1>
        <p class="lead">Выберите тип объекта, чтобы посмотреть комплексный подход к проектированию, изготовлению и монтажу.</p>
      </section>
      <section class="projects-v14-grid" aria-label="Решения по типу пространства">
        {solutions.map(([title, description, image, href]) => <a href={href}>
          <div><img src={image} alt={title} width="640" height="416" loading="lazy" /></div>
          <small>Готовое решение</small>
          <h2>{title}</h2>
          <p>{description}</p>
          <b>Посмотреть решение →</b>
        </a>)}
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
