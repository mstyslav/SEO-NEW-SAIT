---
// RU project pages /ru/project/{slug}/ — same UA project entity (src/content/projects) rendered by ProjectDetail
// with locale="ru"; RU texts in src/data/ru/projects.ru.ts.
import { getCollection } from 'astro:content';
import ProjectDetail from '../../../components/projects/ProjectDetail.astro';
import ProjectCasePremium from '../../../components/projects/ProjectCasePremium.astro';
import { projectCase } from '../../../data/project-cases';
import { selectRelatedProjects } from '../../../data/select-related-projects';
import { hasProjectRu } from '../../../data/ru/projects.ru';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.status === 'published' && hasProjectRu(data.slug));
  return projects.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const allProjects = await getCollection('projects', ({ data }) => data.status === 'published');
const relatedProjects = selectRelatedProjects(entry.data, allProjects, 5);
// Projects listed in src/data/project-cases.ts use the premium case template; all others — ProjectDetail.
const caseContent = projectCase(entry.data.slug, 'ru');
---
{caseContent
  ? <ProjectCasePremium project={entry.data} relatedProjects={relatedProjects} locale="ru" draft={caseContent} />
  : <ProjectDetail project={entry.data} relatedProjects={relatedProjects} locale="ru" />}
