---
// RU version of /arkhitekturni-systemy/ (same layout, cards and FAQ; Russian text).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FAQBlock from '../../../components/FAQBlock.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { localizedPath } from '../../../i18n/helpers';
import '../../../styles/category-pages.css';
const lp = (path: string) => localizedPath(path, 'ru');
const faq = [["Что входит в архитектурные системы?", "Безрамное остекление, фасады, Loft-системы, профильные решения, фурнитура и специальные стеклянные конструкции."], ["Работаете ли вы с архитекторами?", "Да, предоставляем технические консультации, чертежи, спецификации и сопровождение проекта."], ["Можно ли получить DWG или PDF узлов?", "Да, для части систем можем подготовить или предоставить технические материалы."], ["Выполняете ли фасадное остекление?", "Да, реализуем структурное, полуструктурное, накладное и другие типы фасадного остекления."], ["Возможны ли индивидуальные профили?", "Возможность зависит от системы, объёма и технического задания."], ["Какое стекло используется?", "Закалённое стекло, триплекс, стеклопакеты и специальные виды стекла в зависимости от конструкции."], ["Делаете ли безрамное остекление?", "Да, для террас, балконов, офисов, беседок и других пространств."], ["Работаете ли с крупными объектами?", "Да, выполняем коммерческие и девелоперские проекты."], ["Есть ли монтаж в регионах?", "Монтаж доступен в ключевых городах, а логистика — по Украине."], ["Можно ли заказать только поставку?", "Да, отдельные системы и комплектующие можно заказать без монтажа."], ["Есть ли гарантия?", "Да, гарантия зависит от типа системы, материалов и формата работ."], ["Как формируется цена?", "По площади, системе, стеклу, профилю, фурнитуре, монтажу и логистике."], ["Можно ли интегрировать автоматику?", "Да, для отдельных дверных и раздвижных систем."], ["Возможно ли энергосберегающее остекление?", "Да, подбираем стеклопакеты и покрытия в соответствии с требованиями."], ["Готовите ли спецификацию?", "Да, для согласованных систем формируем перечень материалов и комплектующих."], ["Работаете ли с алюминиевыми системами?", "Да, выполняем окна, двери, фасады, зимние сады и раздвижные решения."], ["Можно ли сделать чёрный Loft?", "Да, чёрный профиль — один из самых популярных вариантов."], ["Есть ли противопожарные решения?", "Возможность зависит от сертифицированной системы и требований проекта."], ["Что нужно для просчёта?", "Чертежи, фасады, разрезы, размеры и краткое описание требований."], ["Сопровождаете ли согласование?", "Да, в рамках нашей компетенции предоставляем техническое сопровождение и документацию."]];
// Cards link to the matching section; directions without their own page stay plain cards (no dead "#" links).
const systems: [string, string?][] = [['Безрамное остекление', '/bezramne-sklinnya/'], ['Loft-системы', '/sklyani-perehorodky/loft-sklyani-peregorodku/'], ['Стеклянные фасады', '/poslugy/sklyani-fasady/'], ['Профильные системы', '/alyuminiyevi-konstrukcziyi/'], ['Стеклянные ограждения', '/sklyani-ohorozhi/'], ['Стеклянные двери', '/sklyani-dveri/'], ['Стекло и материалы'], ['Фурнитура и аксессуары']];
---
<BaseLayout locale="ru" title="Архитектурные стеклянные и алюминиевые системы | Space Glass" description="Стеклянные и алюминиевые системы для архитекторов и сложных объектов: безрамное остекление, фасады, Loft, ограждения, двери, фурнитура. Подбор системы под проект.">
<div class="sg-page-shell"><Header/><main id="main">
<div class="category-breadcrumbs"><Breadcrumbs items={[{label:'Главная',href:lp('/')},{label:'Архитектурные системы'}]} /></div>
<section class="category-hero"><div class="category-hero__copy"><p class="eyebrow">Архитектурные системы</p><h1>Стеклянные и алюминиевые системы для сложных проектов</h1><p class="lead">Безрамное остекление, фасады, Loft-системы, профили, фурнитура и специальные решения.</p><a class="button button--mint" href="#architecture-request">Получить расчёт</a></div><div class="category-hero__visual"><span>SPACE GLASS</span></div></section>
<section class="category-section"><div class="category-heading"><div><p class="eyebrow">Системы</p><h2>Выберите направление</h2></div></div><div class="category-type-grid">{systems.map(([item, href],i)=>{const Card = href ? 'a' : 'div'; return <Card class="category-type-card" href={href && lp(href)}><div class="category-type-card__visual"><span>{String(i+1).padStart(2,'0')}</span></div><div class="category-type-card__body"><h3>{item}</h3><p>Подбор системы по архитектуре, нагрузке и бюджету.</p>{href && <b>Подробнее →</b>}</div></Card>})}</div></section>
<section class="category-section category-section--faq"><FAQBlock title="FAQ об архитектурных системах" intro="20 ответов об остеклении, фасадах, профилях, чертежах, монтаже и гарантии." items={faq} visibleCount={6} locale="ru" /></section>
<section id="architecture-request" class="inner-cta"><div><p class="eyebrow">Проект</p><h2>Пришлите чертежи или техническое задание</h2><p>Подготовим предварительную конфигурацию и оценку.</p></div><a class="button button--white" href={lp('/contacts/')}>Отправить запрос</a></section>
</main><Footer/></div></BaseLayout>
