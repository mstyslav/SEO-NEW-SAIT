---
import SeoLanding from '../components/seo/SeoLanding.astro';
import { allSeoPages, pathFor, type SeoPage } from '../data/seo-pages';
import type { Locale } from '../i18n/helpers';

const existingRoutes = new Set(['projects']);
const details = {
 uk:{ city:'Професійний замір, продумана логістика та монтаж скляних конструкцій у місті й області.', article:'Порівнюємо гартоване та ламіноване скло за руйнуванням, навантаженням і сферою застосування.', project:'Loft-перегородка з рифленим склом: технічне рішення, чорний профіль і акуратний монтаж.' },
 ru:{ city:'Профессиональный замер, продуманная логистика и монтаж стеклянных конструкций в городе и области.', article:'Сравниваем закалённое и ламинированное стекло по разрушению, нагрузкам и сфере применения.', project:'Loft-перегородка с рифлёным стеклом: техническое решение, чёрный профиль и аккуратный монтаж.' },
 en:{ city:'Professional measurement, planned logistics and installation of glass structures across the city and region.', article:'A practical comparison of tempered and laminated glass by breakage behaviour, loads and application.', project:'A fluted-glass loft partition: engineering choices, black profiles and a precise installation.' },
 de:{ city:'Professionelles Aufmaß, geplante Logistik und Montage von Glaskonstruktionen in Stadt und Region.', article:'Vergleich von Einscheiben- und Verbundsicherheitsglas nach Bruchbild, Belastung und Anwendung.', project:'Loft-Trennwand mit Rillenglas: technische Planung, schwarze Profile und präzise Montage.' }
};
const cityNames = {uk:{kyiv:'Києві',lviv:'Львові',odesa:'Одесі'},ru:{kyiv:'Киеве',lviv:'Львове',odesa:'Одессе'},en:{kyiv:'Kyiv',lviv:'Lviv',odesa:'Odesa'},de:{kyiv:'Kyjiw',lviv:'Lwiw',odesa:'Odesa'}};
function supporting(locale:Locale):SeoPage[] {
    locale = locale ?? 'uk';
const d = details[locale] ?? details.uk;
 const cityPages=Object.entries(cityNames[locale] ?? cityNames.uk)
 .map(([slug,name])=>({slug:`mista/${slug}`,kind:'city' as const,title:`Glass installation in ${name} | Space Glass`,description:d.city,eyebrow:name,h1:({uk:`Скляні конструкції з монтажем у ${name}`,ru:`Стеклянные конструкции с монтажом в ${name}`,en:`Glass installation in ${name}`,de:`Glasmontage in ${name}`} as any)[locale],intro:d.city,sections:[{title:({uk:'Послуги в місті',ru:'Услуги в городе',en:'Local service',de:'Service vor Ort'} as any)[locale],text:d.city}],faq:[]}));
 return [...cityPages,{slug:'baza-znan/yak-obraty-sklo',kind:'article',title:'Safety glass guide | Space Glass',description:d.article,eyebrow:({uk:'База знань',ru:'База знаний',en:'Knowledge base',de:'Ratgeber'} as any)[locale],h1:({uk:'Як обрати безпечне скло',ru:'Как выбрать безопасное стекло',en:'How to choose safety glass',de:'Sicherheitsglas richtig wählen'} as any)[locale],intro:d.article,sections:[{title:({uk:'Гартоване чи триплекс',ru:'Закалённое или триплекс',en:'Tempered or laminated',de:'ESG oder VSG'} as any)[locale],text:d.article}],faq:[]},{slug:'projects/loft-kyiv',kind:'project',title:'Loft partition Kyiv | Space Glass',description:d.project,eyebrow:({uk:'Проєкт',ru:'Проект',en:'Project',de:'Referenz'} as any)[locale],h1:({uk:'Loft-перегородка в Києві',ru:'Loft-перегородка в Киеве',en:'Loft partition in Kyiv',de:'Loft-Trennwand in Kyjiw'} as any)[locale],intro:d.project,sections:[{title:({uk:'Завдання і реалізація',ru:'Задача и реализация',en:'Brief and delivery',de:'Aufgabe und Umsetzung'} as any)[locale],text:d.project}],faq:[]}];
}
export function getStaticPaths() {
  const existingRoutes = new Set(['projects']);
  const details = {
   uk:{ city:'Професійний замір, продумана логістика та монтаж скляних конструкцій у місті й області.', article:'Порівнюємо гартоване та ламіноване скло за руйнуванням, навантаженням і сферою застосування.', project:'Loft-перегородка з рифленим склом: технічне рішення, чорний профіль і акуратний монтаж.' },
   ru:{ city:'Профессиональный замер, продуманная логистика и монтаж стеклянных конструкций в городе и области.', article:'Сравниваем закалённое и ламинированное стекло по разрушению, нагрузкам и сфере применения.', project:'Loft-перегородка с рифлёным стеклом: техническое решение, чёрный профиль и аккуратный монтаж.' },
   en:{ city:'Professional measurement, planned logistics and installation of glass structures across the city and region.', article:'A practical comparison of tempered and laminated glass by breakage behaviour, loads and application.', project:'A fluted-glass loft partition: engineering choices, black profiles and a precise installation.' },
   de:{ city:'Professionelles Aufmaß, geplante Logistik und Montage von Glaskonstruktionen in Stadt und Region.', article:'Vergleich von Einscheiben- und Verbundsicherheitsglas nach Bruchbild, Belastung und Anwendung.', project:'Loft-Trennwand mit Rillenglas: technische Planung, schwarze Profile und präzise Montage.' }
  };
  const cityNames = {uk:{kyiv:'Києві',lviv:'Львові',odesa:'Одесі'},ru:{kyiv:'Киеве',lviv:'Львове',odesa:'Одессе'},en:{kyiv:'Kyiv',lviv:'Lviv',odesa:'Odesa'},de:{kyiv:'Kyjiw',lviv:'Lwiw',odesa:'Odesa'}};
  function supporting(locale:Locale):SeoPage[] {
   locale = locale ?? 'uk';
   const d = details[locale] ?? details.uk;
   const cityPages=Object.entries(cityNames[locale]?? cityNames.uk).map(([slug,name])=>({slug:`mista/${slug}`,kind:'city' as const,title:`Glass installation in ${name} | Space Glass`,description:d.city,eyebrow:name,h1:({uk:`Скляні конструкції з монтажем у ${name}`,ru:`Стеклянные конструкции с монтажом в ${name}`,en:`Glass installation in ${name}`,de:`Glasmontage in ${name}`} as any)[locale],intro:d.city,sections:[{title:({uk:'Послуги в місті',ru:'Услуги в городе',en:'Local service',de:'Service vor Ort'} as any)[locale],text:d.city}],faq:[]}));
   return [...cityPages,{slug:'baza-znan/yak-obraty-sklo',kind:'article',title:'Safety glass guide | Space Glass',description:d.article,eyebrow:({uk:'База знань',ru:'База знаний',en:'Knowledge base',de:'Ratgeber'} as any)[locale],h1:({uk:'Як обрати безпечне скло',ru:'Как выбрать безопасное стекло',en:'How to choose safety glass',de:'Sicherheitsglas richtig wählen'} as any)[locale],intro:d.article,sections:[{title:({uk:'Гартоване чи триплекс',ru:'Закалённое или триплекс',en:'Tempered or laminated',de:'ESG oder VSG'} as any)[locale],text:d.article}],faq:[]},{slug:'projects/loft-kyiv',kind:'project',title:'Loft partition Kyiv | Space Glass',description:d.project,eyebrow:({uk:'Проєкт',ru:'Проект',en:'Project',de:'Referenz'} as any)[locale],h1:({uk:'Loft-перегородка в Києві',ru:'Loft-перегородка в Киеве',en:'Loft partition in Kyiv',de:'Loft-Trennwand in Kyjiw'} as any)[locale],intro:d.project,sections:[{title:({uk:'Завдання і реалізація',ru:'Задача и реализация',en:'Brief and delivery',de:'Aufgabe und Umsetzung'} as any)[locale],text:d.project}],faq:[]}];
  }
  const locales: Locale[] = ['uk','ru'];
 return locales.flatMap(locale => [...allSeoPages(locale),...supporting(locale)].filter(page=>!existingRoutes.has(page.slug) && !(locale === 'uk' && page.slug === 'projects/loft-kyiv')).map(page=>({params:{seo:pathFor(locale,page.slug).replace(/^\//,'').replace(/\/$/,'')},props:{page,locale}})));
}
const { page, locale } = Astro.props;
---
<SeoLanding page={page} locale={locale} />
