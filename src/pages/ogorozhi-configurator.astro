---
// Glass railings configurator (UK). Price model: src/data/railing-pricing.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQBlock from '../components/FAQBlock.astro';
import RailingConfigurator from '../components/railings/RailingConfigurator.astro';
import { RAILINGS_HUB } from '../data/railing-catalog';
import '../styles/category-pages.css';

const faq: [string, string][] = [
  ['Наскільки точна ціна в конфігураторі?', 'Це орієнтовна вартість для типових умов. Остаточну ціну, товщину скла й крок кріплень визначаємо після заміру.'],
  ['Що входить у ціну?', 'Профіль або стійки, скло, кріплення, обрані опції (колір, матування, поручень) і, якщо обрано, замір, доставка й монтаж.'],
  ['Яку систему обрати?', 'Безрамні профілі (DELGADO, FORMAL, CLIP, ANTE, VARIANTE, BALDOSA) — для мінімалізму, SOLO — точкове кріплення, GARDO і DENSARO — стійки з поручнем, LINEO і CANTO — французькі балкони.'],
  ['Що робити з готовою конфігурацією?', 'На останньому кроці залиште ім’я й телефон — ми отримаємо всі параметри й зв’яжемося, щоб домовитися про замір.'],
  ['Чи можна нестандартну форму чи кут?', 'Так. Оберіть найближчу форму й опишіть кути та ухили в коментарі — врахуємо після заміру.'],
  ['Де виконуєте монтаж?', 'У Києві, Одесі та Львові з областями. Інші регіони — за домовленістю.']
];
---
<BaseLayout
  title="Конфігуратор скляної огорожі — розрахунок ціни онлайн | Space Glass"
  description="Конфігуратор скляної огорожі: оберіть систему, форму, розміри, скло й поручень — побачите схему та орієнтовну вартість у гривнях і надішлете заявку на замір."
  alternateLocales={['uk']}
>
<div class="sg-page-shell">
  <Header />
  <main id="main">
    <section class="category-section" style="padding-bottom:24px">
      <Breadcrumbs items={[{ label: 'Головна', href: '/' }, { label: 'Скляні огорожі', href: RAILINGS_HUB }, { label: 'Конфігуратор' }]} />
      <p class="eyebrow">Конфігуратор</p>
      <h1>Конфігуратор скляної огорожі</h1>
      <p class="lead">Оберіть систему, форму, розміри, скло й поручень — схема та орієнтовна вартість оновлюються одразу. Готову конфігурацію надішліть нам, і ми домовимося про замір.</p>
    </section>
    <RailingConfigurator />
    <section class="category-section category-section--faq">
      <FAQBlock title="Питання про конфігуратор" intro="Як працює розрахунок і що буде після заявки." items={faq} visibleCount={6} />
    </section>
  </main>
  <Footer />
</div>
</BaseLayout>
