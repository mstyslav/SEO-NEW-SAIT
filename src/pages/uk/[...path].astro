---
// /uk/* is a legacy compatibility layer only: every one of these pages has
// always self-canonicalized to the unprefixed URL, sitemap.xml.ts already
// excludes them as "non-canonical duplicates", and no internal link on the
// site ever points at /uk/*. Rendering them used to go through
// import.meta.glob('../**/*.astro') to dynamically pick the matching
// unprefixed page component — but that glob makes every page on the site a
// module-graph dependency of this one catch-all, so Rollup bundled their
// CSS into shared chunks and every /uk/* page ended up loading dozens of
// unrelated pages' stylesheets. Since these routes already claim (via
// canonical/sitemap) to just BE the unprefixed page, redirecting there
// instead of re-rendering the content is the correct fix, not a behavior
// change: it removes the shared module graph at the root instead of
// patching the resulting CSS bloat.
export function getStaticPaths() {
  const excluded = /\.\.\/(?:uk|ru|api)\//;
  // /uk/catalog/ and /uk/rishennya/ have their own static override files
  // (src/pages/uk/catalog/, src/pages/uk/rishennya/) that already render —
  // and self-canonicalize — independently. Astro gives those higher route
  // priority, but this catch-all still attempts to build the same output
  // path and clobbers the static file's render with a redirect. Excluding
  // them here avoids the collision instead of relying on write-order luck.
  const staticOverrides = new Set(['catalog', 'rishennya']);

  const modules = import.meta.glob('../**/*.astro');

const generatedPaths = Object.keys(modules)
  .filter(
    (file) =>
      !excluded.test(file) &&
      !file.includes('[') &&
      file !== '../index.astro'
  )
  .map((file) => {
    const path = file
      .replace(/^\.\.\//, '')
      .replace(/(?:\/index)?\.astro$/, '');

    return { params: { path } };
  })
  // Vite's glob occasionally emits a spurious extra key for a file (e.g.
  // "./catalog/index.astro" alongside the real "../catalog/index.astro"),
  // which survives the leading "../" strip as a "."-prefixed path. The old
  // eager-render code silently absorbed these via its own redirect('/')
  // fallback when no page matched; filter them out here for the same effect.
  .filter((entry) => !staticOverrides.has(entry.params.path) && !entry.params.path.startsWith('.'));

return [
  { params: { path: undefined } },
  ...generatedPaths
];
}

const target = Astro.params.path ? `/${Astro.params.path}/` : '/';
return Astro.redirect(target);
---
