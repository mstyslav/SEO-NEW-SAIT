---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FAQBlock from '../../../components/FAQBlock.astro';
import { localeFromPath, normalizeLocale, localizedPath } from '../../../i18n/helpers';
import '../../../styles/legacy-product.css';
import '../../../styles/category-pages.css';
const locale = normalizeLocale(Astro.props.locale ?? Astro.url.searchParams.get('lang') ?? localeFromPath(Astro.url.pathname));
const lp = (path: string) => localizedPath(path, locale);
const content = {
 uk: { title: "Офісні скляні перегородки", description: "Світле та функціональне зонування офісів із можливістю підвищеної звукоізоляції.", category: "Скляні перегородки", calc: "Розрахувати", quote: "Отримати КП", faqTitle: "FAQ про офісні скляні перегородки", faqIntro: "20 відповідей про вартість, матеріали, замір, монтаж і експлуатацію.", warranty: "Гарантія 2 роки",
 faq: [
 ["Чи можна виготовити офісні перегородки за індивідуальними розмірами?","Так, кожну конструкцію проєктуємо під фактичну геометрію приміщення, висоту стелі, точки кріплення та планування офісу."],
 ["Яке скло використовується для офісних перегородок?","Зазвичай використовуємо загартоване скло або триплекс 8–12 мм залежно від розміру секцій, вимог безпеки та акустики."],
 ["Чи можна зробити матове або тоноване скло?","Так, доступні прозорі, матові, тоновані, рифлені та комбіновані варіанти скла з брендованими плівками."],
 ["Чи входить монтаж у вартість?","Монтаж розраховується окремо після уточнення міста, доступу на об’єкт, складності кріплень і графіка робіт."],
 ["Скільки триває виготовлення?","Типовий строк залежить від системи, фурнітури, кольору профілю та завантаження виробництва після затвердження заміру."],
 ["Чи виконуєте замір офісу?","Так, організовуємо точний замір після попереднього погодження конфігурації, орієнтовного бюджету та адреси об’єкта."],
 ["Яка гарантія на перегородки?","Надаємо гарантію 2 роки на конструкції та виконані монтажні роботи згідно з договором."],
 ["Чи можна інтегрувати двері?","Так, у перегородки інтегруємо розпашні, маятникові, розсувні або loft-двері з потрібною фурнітурою."],
 ["Чи підходять перегородки для переговорних кімнат?","Так, підбираємо конфігурацію з урахуванням приватності, акустики, дверей, ущільнювачів і сценарію використання."],
 ["Чи можна підвищити звукоізоляцію?","Можна використати триплекс, подвійне скління, ущільнення та правильні вузли примикання, але фінальний ефект залежить від усього приміщення."],
 ["Який профіль доступний?","Доступні чорний, графітовий, алюмінієвий, RAL-фарбування та slim-профілі залежно від системи."],
 ["Чи можна монтувати в готовому офісі?","Так, роботи плануємо поетапно, щоб мінімізувати пил, шум і перерви в роботі команди."],
 ["Чи потрібні креслення від клієнта?","Якщо креслення є — це пришвидшує розрахунок, але ми можемо стартувати з фото, розмірів і плану приміщення."],
 ["Чи можна перенести перегородки після монтажу?","Для частини систем можливий демонтаж і повторний монтаж, але це потрібно врахувати ще на етапі вибору конструкції."],
 ["Чи робите брендовані офісні перегородки?","Так, можемо додати логотипи, декоративні смуги, приватні зони та інші елементи айдентики."],
 ["Як формується ціна?","На ціну впливають площа, тип скла, профіль, двері, фурнітура, колір, доставка, монтаж і складність об’єкта."],
 ["Чи доставляєте по Україні?","Так, організовуємо доставку та монтаж по Україні з урахуванням габаритів скла і графіка об’єкта."],
 ["Чи можна замовити лише виготовлення без монтажу?","Так, але для великих офісних систем рекомендуємо професійний монтаж для безпеки та коректної гарантії."],
 ["Як доглядати за скляними перегородками?","Достатньо м’яких засобів для скла, регулярного очищення профілю та періодичної перевірки фурнітури."],
 ["Як отримати попередній розрахунок?","Надішліть план, фото, орієнтовні розміри та побажання щодо скла, профілю й дверей — підготуємо базову комплектацію."]]},
 ru: { title: "Офисные стеклянные перегородки", description: "Светлое и функциональное зонирование офисов с возможностью усиленной звукоизоляции.", category: "Стеклянные перегородки", calc: "Рассчитать", quote: "Получить КП", faqTitle: "FAQ об офисных стеклянных перегородках", faqIntro: "20 ответов о цене, материалах, замере, монтаже и эксплуатации.", warranty: "Гарантия 2 года", faq: [
 ["Можно изготовить офисные перегородки по индивидуальным размерам?","Да. Мы проектируем каждую конструкцию под фактическую геометрию помещения, высоту потолка, точки крепления и планировку офиса."],
 ["Какое стекло используется для офисных перегородок?","Обычно применяем закалённое стекло или триплекс толщиной 8–12 мм — выбор зависит от размера секций, требований безопасности и акустики."],
 ["Можно выбрать матовое или тонированное стекло?","Да. Доступны прозрачные, матовые, тонированные, рифлёные и комбинированные варианты, а также брендированные плёнки."],
 ["Монтаж входит в стоимость?","Монтаж рассчитывается отдельно после уточнения города, доступа на объект, сложности креплений и рабочего графика."],
 ["Сколько занимает изготовление?","Срок зависит от системы, фурнитуры, цвета профиля и загрузки производства после утверждения замера."],
 ["Вы выполняете замер офиса?","Да. Точный замер организуем после предварительного согласования конфигурации, ориентировочного бюджета и адреса объекта."],
 ["Какая гарантия на перегородки?","Предоставляем гарантию 2 года на конструкции и выполненные монтажные работы согласно договору."],
 ["Можно встроить двери в перегородку?","Да. Интегрируем распашные, маятниковые, раздвижные или loft-двери с подходящей фурнитурой."],
 ["Подходят ли перегородки для переговорных комнат?","Да. Подбираем конфигурацию с учётом приватности, акустики, дверей, уплотнителей и сценария использования."],
 ["Можно повысить звукоизоляцию?","Можно использовать триплекс, двойное остекление, уплотнения и корректные узлы примыкания, но итоговый эффект зависит от всего помещения."],
 ["Какие профили доступны?","Доступны чёрный, графитовый, алюминиевый профили, окраска по RAL и slim-системы — в зависимости от выбранной конструкции."],
 ["Можно монтировать перегородки в действующем офисе?","Да. Работы планируем поэтапно, чтобы снизить шум, пыль и простои команды."],
 ["Нужны ли чертежи от клиента?","Если чертежи есть, они ускорят расчёт, но начать можно с фото, размеров и плана помещения."],
 ["Можно перенести перегородки после монтажа?","Для части систем возможны демонтаж и повторная установка, но это важно учитывать ещё на этапе выбора конструкции."],
 ["Делаете брендированные офисные перегородки?","Да. Можем добавить логотипы, декоративные полосы, приватные зоны и другие элементы фирменного стиля."],
 ["Как формируется цена?","На цену влияют площадь, тип стекла, профиль, двери, фурнитура, цвет, доставка, монтаж и сложность объекта."],
 ["Доставляете по Украине?","Да. Организуем доставку и монтаж по Украине с учётом габаритов стекла и графика объекта."],
 ["Можно заказать только изготовление без монтажа?","Да, но для крупных офисных систем рекомендуем профессиональный монтаж ради безопасности и корректной гарантии."],
 ["Как ухаживать за стеклянными перегородками?","Достаточно мягких средств для стекла, регулярной очистки профиля и периодической проверки фурнитуры."],
 ["Как получить предварительный расчёт?","Отправьте план, фото, ориентировочные размеры и пожелания по стеклу, профилю и дверям — мы подготовим базовую комплектацию."]]},
 en: { title: "Office glass partitions", description: "Bright, functional office zoning with optional acoustic upgrades.", category: "Glass partitions", calc: "Calculate", quote: "Request quote", faqTitle: "Office glass partitions FAQ", faqIntro: "20 practical answers about price, materials, site survey, installation and everyday use.", warranty: "2-year warranty", faq: [
 ["Can office partitions be made to custom dimensions?","Yes. Every partition is engineered around the actual room geometry, ceiling height, fixing points and office layout."],
 ["What glass is used for office partitions?","We usually specify 8–12 mm tempered glass or laminated safety glass, depending on panel size, safety requirements and acoustic goals."],
 ["Can I choose frosted or tinted glass?","Yes. Clear, frosted, tinted, fluted and mixed glass options are available, including branded privacy film."],
 ["Is installation included in the price?","Installation is quoted separately after we confirm the city, site access, fixing complexity and work schedule."],
 ["How long does production take?","Lead time depends on the system, hardware, profile colour and production workload after the final survey is approved."],
 ["Do you provide an office site survey?","Yes. We arrange a precise survey after the initial configuration, approximate budget and project address are confirmed."],
 ["What warranty do the partitions have?","We provide a 2-year warranty for the structures and completed installation works under the contract."],
 ["Can doors be integrated into the partition?","Yes. We can integrate hinged, pivot, sliding or loft-style doors with the appropriate hardware set."],
 ["Are these partitions suitable for meeting rooms?","Yes. We select the configuration around privacy, acoustics, doors, seals and the way the room will be used."],
 ["Can sound insulation be improved?","Yes. Laminated glass, double glazing, seals and correct junction details can help, but the final result depends on the whole room."],
 ["Which profile finishes are available?","Black, graphite, aluminium, RAL-painted and slim profile systems are available depending on the chosen construction."],
 ["Can installation be done in an operating office?","Yes. We plan the works in stages to reduce dust, noise and disruption for the team."],
 ["Do you need drawings from the client?","Drawings speed up the estimate, but we can start with photos, approximate dimensions and a floor plan."],
 ["Can the partitions be moved after installation?","Some systems can be dismantled and reinstalled, but this should be considered when choosing the partition type."],
 ["Can you produce branded office partitions?","Yes. We can add logos, decorative bands, privacy zones and other brand-identity details."],
 ["What affects the final price?","Area, glass type, profile, doors, hardware, colour, delivery, installation and site complexity all affect the price."],
 ["Do you deliver across Ukraine?","Yes. We arrange delivery and installation across Ukraine, taking glass dimensions and the project schedule into account."],
 ["Can I order manufacturing only without installation?","Yes, although for large office systems we recommend professional installation for safety and warranty accuracy."],
 ["How should glass partitions be maintained?","Use mild glass cleaners, clean the profile regularly and periodically check the hardware."],
 ["How can I get a preliminary estimate?","Send a plan, photos, approximate dimensions and preferences for glass, profiles and doors — we will prepare a base specification."]]},
 de: { title: "Glastrennwände fürs Büro", description: "Helle, funktionale Bürozonierung mit optional verbesserter Schalldämmung.", category: "Glastrennwände", calc: "Berechnen", quote: "Angebot anfragen", faqTitle: "FAQ zu Büro-Glastrennwänden", faqIntro: "20 praxisnahe Antworten zu Preis, Materialien, Aufmaß, Montage und Nutzung.", warranty: "2 Jahre Garantie", faq: [
 ["Können Bürotrennwände nach Maß gefertigt werden?","Ja. Jede Konstruktion wird auf die tatsächliche Raumgeometrie, Deckenhöhe, Befestigungspunkte und Büroplanung abgestimmt."],
 ["Welches Glas wird für Bürotrennwände verwendet?","Meist setzen wir 8–12 mm Einscheibensicherheitsglas oder Verbundsicherheitsglas ein — abhängig von Feldgröße, Sicherheit und Akustik."],
 ["Sind mattes oder getöntes Glas möglich?","Ja. Klare, matte, getönte, geriffelte und kombinierte Glasvarianten sowie gebrandete Sichtschutzfolien sind möglich."],
 ["Ist die Montage im Preis enthalten?","Die Montage wird separat kalkuliert, nachdem Stadt, Objektzugang, Befestigungsaufwand und Zeitplan geklärt sind."],
 ["Wie lange dauert die Fertigung?","Die Lieferzeit hängt vom System, der Beschlagwahl, der Profilfarbe und der Produktionsauslastung nach freigegebenem Aufmaß ab."],
 ["Führen Sie ein Aufmaß im Büro durch?","Ja. Das genaue Aufmaß organisieren wir nach Abstimmung der Grundkonfiguration, des Richtbudgets und der Objektadresse."],
 ["Welche Garantie gilt für die Trennwände?","Wir geben 2 Jahre Garantie auf die Konstruktionen und die ausgeführten Montagearbeiten gemäß Vertrag."],
 ["Können Türen integriert werden?","Ja. Dreh-, Pendel-, Schiebe- oder Loft-Türen können mit passenden Beschlägen in die Trennwand integriert werden."],
 ["Eignen sich die Trennwände für Besprechungsräume?","Ja. Wir wählen die Konfiguration passend zu Privatsphäre, Akustik, Türen, Dichtungen und Nutzungsprofil."],
 ["Lässt sich die Schalldämmung verbessern?","Ja. Verbundsicherheitsglas, Doppelverglasung, Dichtungen und saubere Anschlussdetails helfen, das Ergebnis hängt jedoch vom gesamten Raum ab."],
 ["Welche Profiloberflächen sind verfügbar?","Je nach System sind schwarze, graphitfarbene, aluminiumfarbene, RAL-lackierte und besonders schlanke Profile verfügbar."],
 ["Kann in einem laufenden Büro montiert werden?","Ja. Wir planen die Arbeiten abschnittsweise, um Staub, Lärm und Unterbrechungen für das Team zu reduzieren."],
 ["Benötigen Sie Zeichnungen vom Kunden?","Zeichnungen beschleunigen die Kalkulation, aber Fotos, grobe Maße und ein Grundriss reichen für den Start aus."],
 ["Können Trennwände später versetzt werden?","Einige Systeme lassen sich demontieren und erneut montieren; das sollte jedoch bereits bei der Systemwahl berücksichtigt werden."],
 ["Fertigen Sie gebrandete Bürotrennwände?","Ja. Logos, Dekorstreifen, Sichtschutzbereiche und weitere Elemente der Corporate Identity können integriert werden."],
 ["Wodurch wird der Preis bestimmt?","Fläche, Glasart, Profil, Türen, Beschläge, Farbe, Lieferung, Montage und Objektkomplexität beeinflussen den Preis."],
 ["Liefern Sie in der ganzen Ukraine?","Ja. Lieferung und Montage organisieren wir in der Ukraine unter Berücksichtigung von Glasabmessungen und Projektterminplan."],
 ["Kann nur die Fertigung ohne Montage bestellt werden?","Ja. Bei großen Bürosystemen empfehlen wir jedoch professionelle Montage für Sicherheit und eine korrekte Garantieabwicklung."],
 ["Wie pflegt man Glastrennwände?","Milde Glasreiniger, regelmäßige Profilreinigung und eine gelegentliche Prüfung der Beschläge reichen in der Regel aus."],
 ["Wie erhalte ich eine erste Kostenschätzung?","Senden Sie Grundriss, Fotos, ungefähre Maße sowie Wünsche zu Glas, Profilen und Türen — wir erstellen eine Basisspezifikation."]]},
};
const tr = content[locale] ?? content.uk;
const title = tr.title;
const description = tr.description;
const image = "/images/s20/product-main.webp";
const features = locale === 'uk' ? ["Стаціонарні та мобільні системи", "Прозоре або матове скло", "Інтегровані двері"] : [tr.description, tr.warranty, tr.quote];
const faq = tr.faq;
const faqSchema = { '@type':'FAQPage', mainEntity: faq.map(([name, text]) => ({ '@type':'Question', name, acceptedAnswer:{ '@type':'Answer', text }})) };

const pageLabels = {
  uk: { order:'● Під замовлення', price:'від 150 $/м²', priceNote:'Попередня базова ставка', specEyebrow:'Конструкція', specTitle:'Підбираємо систему під задачу', specText:'Враховуємо розміри, спосіб відкривання, дизайн профілю, тип скла, акустику та монтажні умови.', specs:[['Виготовлення','Індивідуальне'],['Скло','Загартоване / триплекс'],['Профіль','Чорний, графіт, RAL'],['Монтаж','По Україні'],['Проєктування','За замірами або кресленнями'],['Гарантія','']], processEyebrow:'Етапи', processTitle:'Від ідеї до монтажу', processText:'Один процес для приватних і комерційних проєктів.', steps:[['01','Запит','Фото, розміри або креслення'],['02','Розрахунок','Система та комплектація'],['03','Замір','Точна геометрія'],['04','Проєкт','Креслення і погодження'],['05','Виробництво','Контроль якості'],['06','Монтаж','Здача готової конструкції']], ctaEyebrow:'Попередній розрахунок', ctaTitle:'Надішліть фото або креслення', ctaText:'Підготуємо комплектацію та орієнтовну вартість.' },
  ru: { order:'● Под заказ', price:'от 150 $/м²', priceNote:'Предварительная базовая ставка', specEyebrow:'Конструкция', specTitle:'Подбираем систему под задачу', specText:'Учитываем размеры, способ открывания, дизайн профиля, тип стекла, акустику и условия монтажа.', specs:[['Изготовление','Индивидуальное'],['Стекло','Закалённое / триплекс'],['Профиль','Чёрный, графит, RAL'],['Монтаж','По Украине'],['Проектирование','По замерам или чертежам'],['Гарантия','']], processEyebrow:'Этапы', processTitle:'От идеи до монтажа', processText:'Единый процесс для частных и коммерческих проектов.', steps:[['01','Запрос','Фото, размеры или чертежи'],['02','Расчёт','Система и комплектация'],['03','Замер','Точная геометрия'],['04','Проект','Чертежи и согласование'],['05','Производство','Контроль качества'],['06','Монтаж','Передача готовой конструкции']], ctaEyebrow:'Предварительный расчёт', ctaTitle:'Отправьте фото или чертёж', ctaText:'Подготовим комплектацию и ориентировочную стоимость.' },
  en: { order:'● Made to order', price:'from $150/m²', priceNote:'Preliminary base rate', specEyebrow:'Construction', specTitle:'We specify the system for the brief', specText:'We account for dimensions, opening type, profile design, glass type, acoustics and installation conditions.', specs:[['Manufacturing','Custom-made'],['Glass','Tempered / laminated'],['Profile','Black, graphite, RAL'],['Installation','Across Ukraine'],['Design','Based on survey or drawings'],['Warranty','']], processEyebrow:'Process', processTitle:'From idea to installation', processText:'One workflow for private and commercial projects.', steps:[['01','Request','Photos, dimensions or drawings'],['02','Estimate','System and specification'],['03','Survey','Exact geometry'],['04','Design','Drawings and approval'],['05','Production','Quality control'],['06','Installation','Completed handover']], ctaEyebrow:'Preliminary estimate', ctaTitle:'Send photos or drawings', ctaText:'We will prepare the specification and an approximate cost.' },
  de: { order:'● Auf Bestellung', price:'ab 150 $/m²', priceNote:'Vorläufiger Basissatz', specEyebrow:'Konstruktion', specTitle:'Wir wählen das passende System', specText:'Wir berücksichtigen Maße, Öffnungsart, Profildesign, Glasart, Akustik und Montagebedingungen.', specs:[['Fertigung','Nach Maß'],['Glas','ESG / VSG'],['Profil','Schwarz, Graphit, RAL'],['Montage','In der Ukraine'],['Planung','Nach Aufmaß oder Zeichnungen'],['Garantie','']], processEyebrow:'Ablauf', processTitle:'Von der Idee bis zur Montage', processText:'Ein klarer Prozess für private und gewerbliche Projekte.', steps:[['01','Anfrage','Fotos, Maße oder Zeichnungen'],['02','Kalkulation','System und Ausstattung'],['03','Aufmaß','Exakte Geometrie'],['04','Planung','Zeichnungen und Freigabe'],['05','Fertigung','Qualitätskontrolle'],['06','Montage','Übergabe der fertigen Konstruktion']], ctaEyebrow:'Erste Kostenschätzung', ctaTitle:'Senden Sie Fotos oder Zeichnungen', ctaText:'Wir erstellen Spezifikation und Richtpreis.' }
};
const labels = pageLabels[locale] ?? pageLabels.uk;

---
<BaseLayout title={`${title} — Space Glass`} description={description} locale={locale} structuredData={faqSchema}>
<div class="sg-page-shell"><Header/><main id="main">
<section class="product-premium product-premium--s19 category-product-hero">
 <div class="product-gallery product-gallery--real"><button class="product-gallery__main" type="button"><img src={image} alt={title} width="1800" height="1300"/></button></div>
 <div class="product-premium__info"><p class="eyebrow">{tr.category}</p><div class="product-state product-state--order">{labels.order}</div><h1>{title}</h1><p class="lead">{description}</p><div class="product-price-row"><strong>{labels.price}</strong><span>{labels.priceNote}</span></div>
 <ul class="detail-feature-list">{features.map(item=><li>✓ {item}</li>)}</ul>
 <div class="product-actions"><a class="button button--mint" href={lp("/peregorodky-configurator/")}>{tr.calc}</a><a class="button button--outline" href={lp("/quote/")}>{tr.quote}</a></div></div>
</section>
<section class="product-spec-section"><div class="product-spec-intro"><p class="eyebrow">{labels.specEyebrow}</p><h2>{labels.specTitle}</h2><p>{labels.specText}</p></div><div class="product-spec-table">
{labels.specs.map(([name,value]) => <div><span>{name}</span><b>{value || tr.warranty}</b></div>)}</div></section>
<section class="category-section"><div class="category-heading"><div><p class="eyebrow">{labels.processEyebrow}</p><h2>{labels.processTitle}</h2></div><p>{labels.processText}</p></div><div class="category-process__grid category-process__grid--light">{labels.steps.map(([num,name,text]) => <div><span>{num}</span><b>{name}</b><small>{text}</small></div>)}</div></section>
<section class="section"><FAQBlock title={tr.faqTitle} intro={tr.faqIntro} items={faq} visibleCount={20}/></section>
<section class="inner-cta"><div><p class="eyebrow eyebrow--light">{labels.ctaEyebrow}</p><h2>{labels.ctaTitle}</h2><p>{labels.ctaText}</p></div><a class="button button--white" href={lp("/quote/")}>{tr.quote}</a></section>
</main><Footer/></div></BaseLayout>
