---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQBlock from '../../components/FAQBlock.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import '../../styles/category-pages.css';

const title = "Металопластикові конструкції";
const subtitle = "Металопластикові вікна, двері, балконні блоки та розсувні ПВХ-системи на замовлення";
const items = ["Металопластикові вікна", "Металопластикові двері", "Балконні блоки", "Розсувні системи"];
const faq = [
  ["Від чого залежить ціна металопластикових конструкцій?","Від розмірів, профільної системи, склопакета, фурнітури, ламінування, монтажу та додаткових опцій."],
  ["Чи виготовляєте металопластикові вікна за індивідуальними розмірами?","Так, конструкції виготовляються під конкретний проріз після перевірки розмірів і комплектації."],
  ["Які склопакети можна встановити?","Доступні енергоефективні, мультифункціональні, сонцезахисні та інші типи склопакетів залежно від задачі."],
  ["Чи можна вибрати колір профілю?","Так, доступні білі профілі, ламінування під дерево та інші декори залежно від обраної системи."],
  ["Чи є металопластикові двері?","Так, виготовляємо вхідні, балконні та інші ПВХ-двері з відповідною фурнітурою та склопакетами."],
  ["Чи робите балконні блоки?","Так, можемо виготовити віконно-дверні балконні блоки та комплексні рішення для скління балконів."],
  ["Чи є розсувні металопластикові системи?","Так, доступні розсувні рішення для терас, балконів та великих світлових прорізів."],
  ["Чи виконуєте монтаж?","Так, монтаж узгоджується окремо залежно від міста, типу конструкції та стану прорізу."],
  ["Чи є доставка по Україні?","Так, доставка конструкцій можлива по Україні. Деталі залежать від габаритів і регіону."],
  ["Яка гарантія?","Гарантія залежить від профільної системи, фурнітури, склопакета та умов монтажу."],
  ["Чи потрібен професійний замір?","Для індивідуального виготовлення професійний замір рекомендований, щоб коректно визначити монтажні зазори та конфігурацію."],
  ["Чи можна замовити тільки виготовлення без монтажу?","Так, для частини замовлень можливе виготовлення з доставкою без монтажу."],
  ["Яку фурнітуру можна обрати?","Комплектація підбирається під вагу стулки, спосіб відкривання, вимоги до безпеки та бюджет."],
  ["Чи є енергоефективні рішення?","Так, можна підібрати профіль, склопакет і дистанційну рамку з урахуванням вимог до теплоізоляції."],
  ["Чи можна зробити нестандартну форму або великі розміри?","Можливість залежить від профільної системи, армування, габаритів і статичних вимог."],
  ["Чи працюєте з приватними та комерційними об’єктами?","Так, підбираємо металопластикові конструкції для квартир, будинків, офісів і комерційних приміщень."],
  ["Що потрібно для попереднього розрахунку?","Надішліть приблизні розміри, кількість конструкцій, фото прорізів і бажаний тип відкривання."],
  ["Чи можна замінити старі вікна?","Так, демонтаж старих конструкцій і монтаж нових можна включити до проєкту після оцінки об’єкта."],
  ["Які строки виготовлення?","Строк залежить від профільної системи, комплектації, кольору, склопакетів і завантаження виробництва."],
  ["Чи можна отримати консультацію перед замовленням?","Так, допоможемо підібрати профіль, склопакет, відкривання та комплектацію під ваш бюджет і задачу."]
];
---
<BaseLayout title="Металопластикові конструкції та вікна на замовлення — Space Glass" description="Металопластикові вікна, ПВХ-двері, балконні блоки та розсувні системи на замовлення. Індивідуальні розміри, енергоефективні склопакети, доставка та монтаж.">
<div class="sg-page-shell">
  <Header />
  <main id="main">
    <div class="category-breadcrumbs"><Breadcrumbs items={[{label:'Головна',href:'/'},{label:title}]} /></div>
    <section class="category-hero">
      <div class="category-hero__copy">
        <p class="eyebrow">Віконні системи</p>
        <h1>Металопластикові конструкції на замовлення</h1>
        <p class="lead">{subtitle}. Підбираємо профіль, склопакет і фурнітуру під житлові та комерційні об’єкти.</p>
        <div class="hero__actions"><a class="button button--mint" href="#category-request">Отримати розрахунок</a><a class="button button--outline" href="#types">Переглянути види</a></div>
      </div>
      <div class="category-hero__visual"><div class="category-hero__glass"></div><span>WINDOW SYSTEMS</span></div>
    </section>

    <section id="types" class="category-section">
      <div class="category-heading"><div><p class="eyebrow">Види</p><h2>Металопластикові вікна, двері та ПВХ-системи</h2></div><p>Після вибору типу уточнимо розміри, профільну систему, склопакет, колір, фурнітуру, доставку та формат монтажу.</p></div>
      <div class="category-type-grid">
        {items.map((item,i)=><a class="category-type-card" href="#category-request"><div class="category-type-card__visual"><span>{String(i+1).padStart(2,'0')}</span></div><div class="category-type-card__body"><small>{String(i+1).padStart(2,'0')}</small><h3>{item}</h3><p>Індивідуальна комплектація під розміри, енергоефективність і спосіб використання.</p><b>Отримати розрахунок →</b></div></a>)}
      </div>
    </section>

    <section class="category-section category-section--mint">
      <div class="category-heading"><div><p class="eyebrow">Комплектація</p><h2>Що впливає на комфорт і ціну</h2></div><p>Правильне поєднання профілю, склопакета та фурнітури визначає теплоізоляцію, шумоізоляцію, герметичність і ресурс конструкції.</p></div>
      <div class="material-grid">
        <article><span>01</span><h3>Профільна система</h3><p>Підбираємо ПВХ-профіль за монтажною глибиною, кількістю камер, армуванням і вимогами до енергоефективності.</p></article>
        <article><span>02</span><h3>Склопакет</h3><p>Можливі енергоефективні, мультифункціональні, сонцезахисні та інші склопакети відповідно до орієнтації та призначення приміщення.</p></article>
        <article><span>03</span><h3>Фурнітура</h3><p>Підбираємо механізми відкривання, мікропровітрювання, посилену або протизламну комплектацію залежно від задачі.</p></article>
      </div>
    </section>

    <section class="category-process">
      <div class="category-heading"><div><p class="eyebrow eyebrow--light">Процес</p><h2>Від заміру до готових вікон</h2></div></div>
      <div class="category-process__grid">
        <div><span>01</span><b>Запит</b><small>Розміри, фото або проєкт</small></div>
        <div><span>02</span><b>Підбір системи</b><small>Профіль, склопакет, фурнітура</small></div>
        <div><span>03</span><b>Замір</b><small>Перевірка прорізів</small></div>
        <div><span>04</span><b>Погодження</b><small>Конфігурація і колір</small></div>
        <div><span>05</span><b>Виготовлення</b><small>Комплектація та контроль</small></div>
        <div><span>06</span><b>Доставка / монтаж</b><small>За погодженим форматом</small></div>
      </div>
    </section>

    <section class="category-section category-seo">
      <div class="category-seo__grid">
        <div><p class="eyebrow">Про категорію</p><h2>Металопластикові вікна та двері для дому і бізнесу</h2></div>
        <div><p>Металопластикові конструкції — це вікна, двері, балконні блоки та розсувні ПВХ-системи, які виготовляються під конкретні розміри прорізу. При виборі важливо враховувати не лише профіль, а й склопакет, армування, фурнітуру, спосіб відкривання та монтаж.</p><p>Для попереднього розрахунку достатньо приблизних розмірів і фото. Після уточнення конфігурації визначаємо остаточну комплектацію, вартість і строки виготовлення.</p></div>
      </div>
    </section>

    <section class="category-section category-section--faq">
      <FAQBlock title="FAQ про металопластикові конструкції, вікна та двері" intro="Відповідаємо на питання про ПВХ-профілі, склопакети, фурнітуру, ціни, замір, доставку, монтаж і строки виготовлення." items={faq} visibleCount={6} />
    </section>

    <section id="category-request" class="inner-cta"><div><p class="eyebrow eyebrow--light">Заявка</p><h2>Потрібен розрахунок металопластикових конструкцій?</h2><p>Надішліть фото, розміри, кількість конструкцій або креслення.</p></div><a class="button button--white" href="mailto:info@space-glass.com.ua">Надіслати запит</a></section>
  </main>
  <Footer />
</div>
</BaseLayout>
