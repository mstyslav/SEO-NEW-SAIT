---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/knowledge.css';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FAQBlock from '../../../components/FAQBlock.astro';

const faq = [
  ['Що безпечніше — загартоване скло чи триплекс?','Обидва варіанти безпечні за правильного застосування. Вибір залежить від конструкції та вимог до утримання уламків.'],
  ['Яку товщину скла обрати?','Товщину визначають за габаритами, способом кріплення, типом конструкції та навантаженнями.'],
  ['Чи можна використовувати звичайне скло?','Для більшості душових, дверей, огорож і перегородок використовують безпечне загартоване скло або триплекс.']
];
---
<BaseLayout title="Яке скло краще: загартоване чи триплекс — Space Glass" description="Порівняння загартованого скла і триплексу: безпека, міцність, ціна та сфери застосування.">
<div class="sg-page-shell">
  <Header />
  <main id="main">
    <article>
      <section class="knowledge-article-hero">
        <div class="knowledge-article-hero__copy">
          <p class="eyebrow">Knowledge Hub / Матеріали</p>
          <h1>Загартоване скло чи триплекс: що обрати?</h1>
          <p class="lead">Розбираємо різницю в безпеці, конструктиві, вартості та практичному застосуванні.</p>
          <div class="article-meta">
            <span>Оновлено: 2026</span>
            <span>Час читання: 8 хв</span>
            <span>Експертний матеріал Space Glass</span>
          </div>
        </div>
        <div class="knowledge-article-hero__visual"><span>GLASS GUIDE</span></div>
      </section>

      <section class="article-layout">
        <aside class="article-toc">
          <strong>Зміст</strong>
          <a href="#difference">Основна різниця</a>
          <a href="#tempered">Загартоване скло</a>
          <a href="#triplex">Триплекс</a>
          <a href="#comparison">Порівняння</a>
          <a href="#applications">Сфери застосування</a>
          <a href="#conclusion">Висновок</a>
        </aside>

        <div class="article-content">
          <h2 id="difference">Основна різниця</h2>
          <p>Загартоване скло проходить термічну обробку, яка підвищує його міцність. У разі руйнування воно розсипається на дрібні фрагменти. Триплекс складається з двох або більше шарів скла, з’єднаних плівкою або полімерним прошарком.</p>

          <div class="article-callout">
            <strong>Ключовий принцип:</strong>
            <p>Загартоване скло сильне саме по собі, а триплекс додатково утримує уламки після руйнування.</p>
          </div>

          <h2 id="tempered">Коли обирають загартоване скло</h2>
          <p>Його часто використовують для душових, дверей, перегородок, меблів та інших конструкцій, де важлива механічна міцність і чистий зовнішній вигляд.</p>
          <ul>
            <li>висока міцність у порівнянні зі звичайним склом;</li>
            <li>підходить для безрамних конструкцій;</li>
            <li>широкий вибір товщини, кольору та обробки;</li>
            <li>після загартування скло вже не можна підрізати або свердлити.</li>
          </ul>

          <h2 id="triplex">Коли потрібен триплекс</h2>
          <p>Триплекс застосовують там, де після можливого руйнування важливо утримати фрагменти в конструкції: в огорожах, підлогах, навісах, фасадах і складних архітектурних рішеннях.</p>

          <h2 id="comparison">Порівняння матеріалів</h2>
          <table class="article-table">
            <thead><tr><th>Параметр</th><th>Загартоване скло</th><th>Триплекс</th></tr></thead>
            <tbody>
              <tr><td>Конструкція</td><td>Один загартований лист</td><td>Кілька шарів із прошарком</td></tr>
              <tr><td>Поведінка при руйнуванні</td><td>Дрібні фрагменти</td><td>Фрагменти утримуються плівкою</td></tr>
              <tr><td>Вага</td><td>Нижча</td><td>Вища</td></tr>
              <tr><td>Вартість</td><td>Зазвичай нижча</td><td>Зазвичай вища</td></tr>
              <tr><td>Типове застосування</td><td>Душові, двері, перегородки</td><td>Огорожі, підлоги, навіси</td></tr>
            </tbody>
          </table>

          <h2 id="applications">Як обрати матеріал під конструкцію</h2>
          <p>Рішення не повинно базуватися лише на ціні. Потрібно врахувати габарити, спосіб кріплення, висоту, навантаження, тип приміщення та наслідки можливого руйнування.</p>

          <h2 id="conclusion">Висновок</h2>
          <p>Для більшості душових і внутрішніх перегородок достатньо правильно підібраного загартованого скла. Для огорож, підлог, навісів та конструкцій із підвищеними вимогами часто доцільний триплекс.</p>
        </div>

        <aside class="article-side">
          <p class="eyebrow eyebrow--light">Потрібна допомога?</p>
          <h3>Підберемо скло під ваш проєкт</h3>
          <p>Надішліть фото, креслення або короткий опис конструкції.</p>
          <a class="button button--white" href="mailto:info@space-glass.com.ua">Отримати консультацію</a>
        </aside>
      </section>

      <section class="article-related">
        <div class="category-heading">
          <div><p class="eyebrow">Далі читати</p><h2>Пов’язані матеріали</h2></div>
          <a href="/knowledge/">Усі статті →</a>
        </div>
        <div class="article-related-grid">
          <a class="article-related-card" href="#"><span>01</span><h3>Скло 8 мм чи 10 мм</h3><p>Як товщина впливає на конструкцію та ціну.</p></a>
          <a class="article-related-card" href="#"><span>02</span><h3>Як обрати фурнітуру</h3><p>Петлі, профілі, ручки та покриття.</p></a>
          <a class="article-related-card" href="#"><span>03</span><h3>Підготовка отвору до заміру</h3><p>Що потрібно завершити перед виїздом спеціаліста.</p></a>
        </div>
      </section>

      <section class="article-related">
        <FAQBlock
          title="FAQ про безпечне скло"
          intro="20 коротких відповідей про загартоване скло, триплекс, товщину, безпеку та застосування."
          items={faq}
          visibleCount={6}
        />
      </section>
    </article>
  </main>
  <Footer />
</div>
</BaseLayout>
