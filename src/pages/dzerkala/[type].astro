---
// Mirror child pages /dzerkala/{slug}/ — same catalog template as the
// aluminium / metal-plastic sections. Routes come from mirror-types.ts
// (legacy-compatible slugs); page content from mirror-catalog.ts.
import ProfileCategoryPage from '../../components/profile/ProfileCategoryPage.astro';
import { mirrorTypes } from '../../data/mirror-types';
import { getMirrorCategory } from '../../data/mirror-catalog';

export function getStaticPaths() {
  return mirrorTypes.map((mirror) => ({ params: { type: mirror.slug } }));
}

const { type } = Astro.params;
---
<ProfileCategoryPage category={getMirrorCategory(type as string)} />
