---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQBlock from '../../components/FAQBlock.astro';
import '../../styles/category-pages.css';

const title = "Дзеркала";
const subtitle = "LED, у рамі, панно, на стіну та індивідуальні форми";
const items = ["LED", "У рамі", "Панно", "На стіну", "Фігурні", "Для ванної"];
const faq = [
  [
    "Від чого залежить ціна?",
    "Від габаритів, типу скла, профілю, фурнітури, складності та монтажу."
  ],
  [
    "Чи є індивідуальні розміри?",
    "Так, більшість конструкцій виготовляємо за погодженими розмірами."
  ],
  [
    "Де доступний монтаж?",
    "Основні міста монтажу — Київ, Львів та Одеса з областями."
  ],
  [
    "Чи є доставка по Україні?",
    "Готові товари та комплектуючі доставляємо по всій Україні."
  ],
  [
    "Які матеріали використовуються?",
    "Матеріали підбираються за призначенням конструкції, навантаженням і дизайном."
  ],
  [
    "Чи можна обрати колір профілю?",
    "Так, доступні стандартні та індивідуальні кольори залежно від системи."
  ],
  [
    "Які строки виготовлення?",
    "Термін визначається після погодження креслення, комплектації та завантаження виробництва."
  ],
  [
    "Чи надається гарантія?",
    "Так, гарантія залежить від типу конструкції, матеріалів та умов монтажу."
  ],
  [
    "Чи потрібен професійний замір?",
    "Для індивідуальних конструкцій професійний замір рекомендований або обов’язковий."
  ],
  [
    "Чи можна замовити тільки виготовлення?",
    "Так, у частині проєктів можливе виготовлення без монтажу з доставкою."
  ],
  [
    "Чи робите технічні креслення?",
    "Так, перед запуском складних конструкцій готуємо та погоджуємо креслення."
  ],
  [
    "Чи можна інтегрувати двері?",
    "Так, залежно від системи доступні розпашні, розсувні, маятникові та pivot-рішення."
  ],
  [
    "Чи працюєте з дизайнерами й архітекторами?",
    "Так, надаємо технічні матеріали, консультації та супровід проєкту."
  ],
  [
    "Чи можна використати матове скло?",
    "Так, доступні матове, тоноване, освітлене, рифлене та декоративне скло."
  ],
  [
    "Чи працюєте з комерційними об’єктами?",
    "Так, реалізуємо рішення для офісів, магазинів, ресторанів, готелів і клінік."
  ],
  [
    "Чи можливий демонтаж старих конструкцій?",
    "Так, демонтаж оцінюється окремо після огляду об’єкта."
  ],
  [
    "Що потрібно для попередньої оцінки?",
    "Фото, приблизні розміри, місто та короткий опис бажаного рішення."
  ],
  [
    "Чи можна замовити поетапну реалізацію?",
    "Так, великі проєкти можна поділяти на етапи за погодженим графіком."
  ],
  [
    "Які способи оплати доступні?",
    "Умови оплати залежать від типу товару, обсягу та формату робіт."
  ],
  [
    "Чи є сервіс після монтажу?",
    "Так, доступні гарантійні та післягарантійні консультації й обслуговування."
  ]
]
---
<BaseLayout title={`${title} — Space Glass`} description={subtitle}>
<div class="sg-page-shell">
  <Header />
  <main id="main">
    <section class="category-hero">
      <div class="category-hero__copy"><p class="eyebrow">{title}</p><h1>{title} на замовлення</h1><p class="lead">{subtitle}</p><div class="hero__actions"><a class="button button--mint" href="#category-request">Отримати розрахунок</a><a class="button button--outline" href="#types">Переглянути види</a></div></div>
      <div class="category-hero__visual"><div class="category-hero__glass"></div><span>SPACE GLASS</span></div>
    </section>

    <section id="types" class="category-section">
      <div class="category-heading"><div><p class="eyebrow">Види</p><h2>Оберіть відповідне рішення</h2></div><p>Після вибору типу уточнимо розміри, матеріали, колір, комплектацію та формат монтажу.</p></div>
      <div class="category-type-grid">
        {items.map((item,i)=><a class="category-type-card" href="#"><div class="category-type-card__visual"><span>{String(i+1).padStart(2,'0')}</span></div><div class="category-type-card__body"><small>{String(i+1).padStart(2,'0')}</small><h3>{item}</h3><p>Індивідуальна конфігурація під ваш простір.</p><b>Детальніше →</b></div></a>)}
      </div>
    </section>

    <section class="category-process">
      <div class="category-heading"><div><p class="eyebrow eyebrow--light">Процес</p><h2>Від запиту до готової конструкції</h2></div></div>
      <div class="category-process__grid">
        <div><span>01</span><b>Запит</b><small>Фото, розміри або креслення</small></div>
        <div><span>02</span><b>Оцінка</b><small>Попередня комплектація</small></div>
        <div><span>03</span><b>Замір</b><small>Перевірка геометрії</small></div>
        <div><span>04</span><b>Креслення</b><small>Технічне узгодження</small></div>
        <div><span>05</span><b>Виготовлення</b><small>Контроль якості</small></div>
        <div><span>06</span><b>Монтаж</b><small>Здача та гарантія</small></div>
      </div>
    </section>

    <section class="category-section category-section--faq">
      <FAQBlock
        title={`FAQ про ${title.toLowerCase()}: ціни, монтаж, матеріали та замовлення`}
        intro={`Відповідаємо на основні питання про ${title.toLowerCase()}, строки, гарантію, доставку й індивідуальне виготовлення.`}
        items={faq}
        visibleCount={6}
      />
    </section>

    <section id="category-request" class="inner-cta"><div><p class="eyebrow eyebrow--light">Заявка</p><h2>Потрібен попередній розрахунок?</h2><p>Надішліть фото, розміри або креслення.</p></div><a class="button button--white" href="mailto:info@space-glass.com.ua">Надіслати запит</a></section>
  </main>
  <Footer />
</div>
</BaseLayout>
