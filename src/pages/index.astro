---
import { getCollection } from 'astro:content';
import translations from '../i18n/translations.json';
import { localeFromPath, normalizeLocale, localizedPath } from '../i18n/helpers';
const pageLocale = normalizeLocale(Astro.url.searchParams.get('lang') ?? localeFromPath(Astro.url.pathname));
const pageT = translations[pageLocale] ?? translations.uk;
const lp = (path: string) => localizedPath(path, pageLocale);
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/homepage.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FAQBlock from '../components/FAQBlock.astro';

const categories: [string, string, string, string, boolean?][] = [
  ['Душові кабіни','Walk-in, двері, кабіни в нішу, шторки та душові піддони','/dushovi-kabiny/','<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M12 41V17c0-7 5-11 12-11h8v35"/><path d="M21 13h11M25 18v5m-6-2 2 4m10-4-2 4"/></svg>'],
  ['Скляні перегородки','Loft, офісні, міжкімнатні, мобільні та безрамні системи','/sklyani-perehorodky/','<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M7 8h34v32H7zM18 8v32M30 8v32"/><path d="M7 25h34"/></svg>'],
  ['Скляні двері','Розпашні, розсувні, маятникові та двері в профілі','/sklyani-dveri/','<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M9 42V6h30v36M15 42V11h18v31"/><circle cx="29" cy="26" r="1"/></svg>'],
  ['Скляні огорожі','Сходи, балкони, тераси, безрамні та стійкові рішення','/sklyani-ohorozhi/','<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M7 39h11V29h10V19h13"/><path d="M9 33 39 9M15 31V22m10 1v-9m9 1V7"/></svg>'],
  ['Дзеркала','LED, у ванну, в рамі, панно та індивідуальні розміри','/dzerkala/','<svg viewBox="0 0 48 48" aria-hidden="true"><ellipse cx="24" cy="24" rx="14" ry="18"/><ellipse cx="24" cy="24" rx="10" ry="14"/><path d="m18 23 7-9m-5 16 9-12"/></svg>'],
  ['Скляні фасади','Вітринне, структурне та стійково-ригельне скління','/arkhitekturni-systemy/','<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M6 41V9h36v32M18 9v32M30 9v32M6 24h36"/><path d="M10 5h28"/></svg>'],
  ['Безрамне скління','Тераси, балкони, альтанки та панорамні розсувні системи','/poslugy/bezramne-sklinnya/','<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M7 40 13 8h22l6 32"/><path d="M13 8v32m11-32v32m11-32v32"/><path d="M7 40h34"/></svg>'],
  ['Алюмінієві конструкції','Вікна, двері, розсувні та фасадні системи, зимові сади','/alyuminiievi-konstruktsii/','<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M6 40V8h36v32H6zM24 8v32M6 24h36"/><path d="M27 14h9v8h-9zM12 28h9v7h-9z"/></svg>'],
  ['Металопластикові конструкції','Вікна, двері, балконні та розсувні системи','/metaloplastykovi-konstruktsii/','<svg viewBox="0 0 48 48" aria-hidden="true"><rect x="7" y="8" width="34" height="32" rx="1"/><path d="M24 8v32M7 24h34"/><path d="m29 15 6 5-6 5"/></svg>'],
  ['Скло для бізнесу','Скляні рішення для магазинів, офісів, ресторанів та комерційних просторів.','/poslugy/sklo-dlia-biznesu/','<svg viewBox="0 0 48 48"><path d="M6 44V20l6-10h24l6 10v24"/><path d="M6 44h36M14 44V28h8v16M28 44V28h8v16"/></svg>', true],
];

const products = [
  ['Душова кабіна Walk-in Premium Black','від 18 450 грн','/images/v5/product-1.webp','В наявності'],
  ['Скляна перегородка Loft Double','від 24 980 грн','/images/v5/product-2.webp','В наявності'],
  ['Розсувні двері Glass Slide Comfort','від 16 790 грн','/images/v5/product-3.webp','Під замовлення'],
  ['Огорожа на сходи Clear View','від 12 560 грн/м.п.','/images/v5/product-4.webp','В наявності'],
  ['Душова кабіна у нішу Minimal','від 15 990 грн','/images/v5/product-5.webp','В наявності'],
  ['Loft-перегородка Slim Line','від 21 300 грн','/images/v5/product-6.webp','Під замовлення'],
];

const publishedProjects = await getCollection('projects', ({ data }) => data.status === 'published' && data.locale === 'uk');
const homeProjects = publishedProjects
  .map(({ data }) => data)
  .sort((a, b) => a.sortOrder - b.sortOrder);

const faq = [
  [
    "Як отримати попередній розрахунок?",
    "Надішліть фото, приблизні розміри або креслення. Ми уточнимо деталі та підготуємо попередню оцінку."
  ],
  [
    "У яких містах доступний монтаж?",
    "Основний монтаж виконуємо у Києві, Львові та Одесі з областями."
  ],
  [
    "Чи є доставка по Україні?",
    "Так, готові товари, фурнітуру та окремі конструкції доставляємо по Україні."
  ],
  [
    "Чи працюєте ви з комерційними об’єктами?",
    "Так, реалізуємо проєкти для офісів, магазинів, ресторанів, готелів і клінік."
  ],
  [
    "Чи можна замовити конструкцію за індивідуальними розмірами?",
    "Так, більшість конструкцій виготовляємо індивідуально після технічної перевірки."
  ],
  [
    "Чи виконуєте ви замір?",
    "Так, професійний замір доступний у містах монтажу."
  ],
  [
    "Які строки виготовлення?",
    "Строк залежить від типу конструкції, матеріалів, складності та завантаження виробництва."
  ],
  [
    "Чи надаєте гарантію?",
    "Так, гарантія залежить від виду конструкції, фурнітури й формату монтажу."
  ],
  [
    "Чи можна замовити тільки виготовлення без монтажу?",
    "Так, для частини товарів і конструкцій доступне виготовлення з доставкою."
  ],
  [
    "Чи робите технічні креслення?",
    "Так, для складних виробів готуємо та погоджуємо креслення перед виробництвом."
  ],
  [
    "Яке скло ви використовуєте?",
    "Загартоване скло, триплекс, склопакети та спеціальні види скла залежно від задачі."
  ],
  [
    "Чи можна обрати колір профілю та фурнітури?",
    "Так, доступні стандартні й індивідуальні кольори залежно від системи."
  ],
  [
    "Чи працюєте з дизайнерами та архітекторами?",
    "Так, надаємо консультації, технічні матеріали та супровід проєкту."
  ],
  [
    "Чи виконуєте демонтаж старих конструкцій?",
    "Так, демонтаж оцінюється окремо після огляду об’єкта."
  ],
  [
    "Чи можна реалізувати проєкт поетапно?",
    "Так, великі проєкти можна поділити на етапи за погодженим графіком."
  ],
  [
    "Що потрібно надіслати для розрахунку?",
    "Фото, приблизні розміри, місто та короткий опис бажаної конструкції."
  ],
  [
    "Чи є післягарантійний сервіс?",
    "Так, доступні регулювання, консультації та заміна окремих комплектуючих."
  ],
  [
    "Чи доставляєте ви до Європи?",
    "Так, окремі товари та конструкції можемо доставляти до країн Європи."
  ],
  [
    "Від чого залежить вартість?",
    "Від розмірів, типу скла, профілю, фурнітури, складності монтажу та логістики."
  ],
  [
    "Як розпочати роботу?",
    "Залиште заявку або надішліть фото й розміри — спеціаліст зв’яжеться з вами для уточнення."
  ]
];
---
<BaseLayout title="Space Glass — скляні конструкції в Україні" description="Скляні перегородки, душові, огорожі, фасади та готові товари. Монтаж у Києві, Львові й Одесі. Доставка по Україні.">
  <div class="sg-page-shell">
    <Header />
    <main id="main">
      <section class="sg-hero">
        <div class="sg-hero__copy">
          <p class="eyebrow">Скляні конструкції преміум-класу</p>
          <h1>Простір<br>Світло<br><span>Space Glass</span></h1>
          <p>Виготовляємо скляні конструкції для дому, бізнесу та комерційних проєктів будь-якої складності.</p>
          <div class="hero__actions">
            <a class="button button--mint" href="/catalog/">Переглянути каталог скляних конструкцій →</a>
            <a class="button button--outline" href="#quote">Отримати розрахунок</a>
          </div>
        </div>
        <div class="sg-hero__image">
          <img
            src="/images/v5/hero.webp"
            srcset="/images/v5/hero-480.webp 480w, /images/v5/hero-800.webp 800w, /images/v5/hero-1200.webp 1200w, /images/v5/hero.webp 1600w"
            sizes="(max-width: 900px) 100vw, min(50vw, 748px)"
            width="1600" height="987"
            alt="Скляна перегородка Space Glass"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />
          <span class="sg-glass-line" aria-hidden="true"></span>
        </div>
      </section>

      <section class="sg-benefits">
        <div><span>◇</span><b>Власне виробництво</b><small>В Україні</small></div>
        <div><span>◉</span><b>Гарантія 2 роки</b><small>На всі конструкції</small></div>
        <div><span>▱</span><b>Доставка по Україні</b><small>Та Європі</small></div>
        <div><span>◯</span><b>Індивідуальні рішення</b><small>Під ваш проєкт</small></div>
      </section>

      <section class="sg-categories">
        <div class="sg-categories__grid sg-home-category-grid">
          {categories.map(([title,text,href,icon,tabletMobileOnly]) => (
            <a class={`sg-category-card${tabletMobileOnly ? ' sg-category-card--tablet-mobile-only' : ''}`} href={href}>
              <span class="sg-category-card__icon" set:html={icon} />
              <h2>{title}</h2>
              <p>{text}</p>
              <b>→</b>
            </a>
          ))}
        </div>
        <a class="sg-all-link" href="/poslugy/">Переглянути всі напрямки та послуги →</a>
      </section>

      <section class="sg-products">
        <div class="sg-section-title"><h2>Популярні рішення</h2><a href="/catalog/">Переглянути всі скляні рішення →</a></div>
        <div class="sg-product-grid">
          {products.map(([title,price,image,status],i) => (
            <a class="sg-product-card" href="/catalog/piddon/">
              <div class="sg-product-card__media">
                <img src={image} alt={title} width="152" height="121" loading="lazy" />
                <span class="sg-heart">♡</span>
              </div>
              <div class="sg-product-card__body">
                <small class={status === 'Під замовлення' ? 'is-order' : ''}>● {status}</small>
                <h3>{title}</h3>
                <strong>{price}</strong>
                <span class="sg-product-button">Докладніше про скляне рішення →</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="sg-projects">
        <div class="sg-projects__intro">
          <h2>Наші проєкти</h2>
          <p>Реалізовані рішення для квартир, будинків, офісів, ресторанів та готелів.</p>
          <a href={lp('/projects/')}>Дивитися всі реалізовані проєкти →</a>
          <div class="sg-projects__controls" aria-label="Керування каруселлю проєктів">
            <button type="button" data-projects-prev aria-label="Попередні проєкти">←</button>
            <button type="button" data-projects-next aria-label="Наступні проєкти">→</button>
          </div>
        </div>
        <div class="sg-projects__viewport" data-projects-carousel tabindex="0" aria-label="Реалізовані проєкти Space Glass">
          <div class="sg-projects__track">
            {homeProjects.map((project) => (
              <a class="sg-project-image" href={lp(`/projects/${project.slug}/`)} aria-label={`Переглянути проєкт: ${project.cardTitle}`}>
                <img
                  src={project.cover.src}
                  width={project.cover.width}
                  height={project.cover.height}
                  alt={project.cover.alt}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="sg-final-benefits">
        <div><span>◇</span><b>Індивідуальні рішення</b><small>Розробляємо під ваш проєкт та розміри</small></div>
        <div><span>▱</span><b>Якісні матеріали</b><small>Загартоване скло та фурнітура преміум-класу</small></div>
        <div><span>⚒</span><b>Професійний монтаж</b><small>Досвідчені монтажні бригади</small></div>
        <div><span>◇</span><b>Гарантія та сервіс</b><small>Підтримка після монтажу</small></div>
      </section>

      <section class="section sg-faq sg-faq--home">
        <FAQBlock
          title="Часті запитання"
          intro="Відповідаємо на основні питання про розрахунок, замір, виготовлення, доставку, монтаж, гарантію та сервіс."
          items={faq}
          visibleCount={6}
        />
      </section>

      <section id="quote" class="section quote-v4">
        <div class="container quote-v4__grid">
          <div><p class="eyebrow eyebrow--light">Заявка</p><h2>Покажіть нам ваш простір</h2><p>Надішліть фото, розміри або креслення — підготуємо попередній розрахунок.</p></div>
          <form class="quote-form quote-form--home-final" data-home-quote-form>
            <label>
              <span>{pageT.name}</span>
              <input type="text" name="name" autocomplete="name" />
            </label>

            <label>
              <span>{pageT.phone}</span>
              <input type="tel" name="phone" autocomplete="tel" />
            </label>

            <label>
              <span>{pageT.city}</span>
              <input type="text" name="city" autocomplete="address-level2" />
            </label>

            <label class="quote-form--home-final__need">
              <span>{pageT.need}</span>
              <input type="text" name="message" placeholder="Наприклад: душова Walk-in" />
            </label>

            <button class="button button--white quote-form--home-final__submit" type="submit">
              {pageT.preliminaryQuote}
            </button>
          </form>
        </div>
      </section>
    </main>
    <Footer />
    <script>
      const projectsCarousel = document.querySelector('[data-projects-carousel]');
      const scrollProjects = (direction) => {
        if (!projectsCarousel) return;
        const card = projectsCarousel.querySelector('.sg-project-image');
        const gap = 10;
        const distance = card ? card.getBoundingClientRect().width + gap : projectsCarousel.clientWidth;
        projectsCarousel.scrollBy({ left: direction * distance, behavior: 'smooth' });
      };
      document.querySelector('[data-projects-prev]')?.addEventListener('click', () => scrollProjects(-1));
      document.querySelector('[data-projects-next]')?.addEventListener('click', () => scrollProjects(1));
      if (projectsCarousel) {
        let pointerId = null;
        let dragStartX = 0;
        let dragStartScroll = 0;
        let hasDragged = false;

        projectsCarousel.addEventListener('pointerdown', (event) => {
          if (event.pointerType === 'mouse' && event.button !== 0) return;
          pointerId = event.pointerId;
          dragStartX = event.clientX;
          dragStartScroll = projectsCarousel.scrollLeft;
          hasDragged = false;
        });
        projectsCarousel.addEventListener('pointermove', (event) => {
          if (pointerId !== event.pointerId) return;
          const distance = event.clientX - dragStartX;
          if (!hasDragged && Math.abs(distance) > 5) {
            hasDragged = true;
            projectsCarousel.classList.add('is-dragging');
            projectsCarousel.setPointerCapture(event.pointerId);
          }
          if (hasDragged) projectsCarousel.scrollLeft = dragStartScroll - distance;
        });
        const endProjectDrag = (event) => {
          if (pointerId !== event.pointerId) return;
          if (projectsCarousel.hasPointerCapture(event.pointerId)) projectsCarousel.releasePointerCapture(event.pointerId);
          pointerId = null;
          projectsCarousel.classList.remove('is-dragging');
        };
        projectsCarousel.addEventListener('pointerup', endProjectDrag);
        projectsCarousel.addEventListener('pointercancel', endProjectDrag);
        projectsCarousel.addEventListener('click', (event) => {
          if (!hasDragged) return;
          event.preventDefault();
          event.stopPropagation();
          hasDragged = false;
        }, true);
      }
      projectsCarousel?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          event.preventDefault();
          scrollProjects(event.key === 'ArrowRight' ? 1 : -1);
        }
      });

      const homeQuoteForm = document.querySelector('[data-home-quote-form]');
      homeQuoteForm?.addEventListener('submit', (event) => {
        event.preventDefault();
        const data = new FormData(homeQuoteForm);
        const request = [
          data.get('name'),
          data.get('phone'),
          data.get('city'),
          data.get('message')
        ].filter(Boolean).join(' · ');

        window.location.href = `/quote/?request=${encodeURIComponent(request)}`;
      });
    </script>
  </div>
</BaseLayout>
