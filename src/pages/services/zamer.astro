---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQBlock from '../../components/FAQBlock.astro';
const faq = [["Як отримати попередній розрахунок?", "Надішліть фото, приблизні розміри або креслення. Ми уточнимо технічні деталі та підготуємо попередню оцінку."], ["Де доступний монтаж?", "Основні міста монтажу — Київ, Львів та Одеса з областями."], ["Чи є доставка по Україні?", "Так, готові товари та комплектуючі доставляємо по всій Україні."], ["Чи виконуєте ви замір?", "Так, професійний замір доступний для індивідуальних конструкцій у містах монтажу."], ["Чи можна замовити тільки виготовлення?", "Так, у частині проєктів можливе виготовлення без монтажу з доставкою на об’єкт."], ["Чи готуєте технічні креслення?", "Так, для складних конструкцій готуємо креслення та специфікацію перед запуском у виробництво."], ["Як проходить консультація?", "Уточнюємо задачу, тип об’єкта, розміри, бюджет, матеріали та бажаний результат."], ["Що потрібно підготувати перед заміром?", "Бажано завершити основні чорнові роботи та забезпечити доступ до отвору."], ["Чи працюєте з дизайнерами й архітекторами?", "Так, надаємо технічну інформацію, консультації та супровід проєкту."], ["Чи можна замовити монтаж після доставки?", "Так, якщо монтаж доступний у вашому місті та конструкція підготовлена для встановлення."]];
import "../../styles/internal-pages.css";
---
<BaseLayout title="Замір скляних конструкцій — Space Glass" description="Перевіряємо геометрію, основи, примикання, доступ і монтажні умови.">
<div class="sg-page-shell"><Header/><main id="main"><Breadcrumbs contained items={[{label:'Головна',href:'/'},{label:'Послуги',href:'/services/'},{label:'Замір'}]} />
<section class="inner-hero"><div class="inner-hero__copy"><p class="eyebrow">Послуги</p><h1>Замір скляних конструкцій</h1><p class="lead">Перевіряємо геометрію, основи, примикання, доступ і монтажні умови.</p><a class="button button--mint" href="#service-request">Отримати консультацію</a></div><div class="inner-hero__visual"><span>SPACE GLASS</span></div></section>
<section class="inner-section"><div class="inner-section__heading"><p class="eyebrow">Як ми працюємо</p><h2>Прозорий процес і відповідальність за результат</h2></div><div class="inner-card-grid">
<article class="inner-card"><span>01</span><h3>Заявка</h3><p>Фото, розміри або креслення.</p></article>
<article class="inner-card"><span>02</span><h3>Оцінка</h3><p>Уточнення технічних деталей.</p></article>
<article class="inner-card"><span>03</span><h3>Виконання</h3><p>Робота за погодженим планом.</p></article>
</div></section>
<section class="inner-section inner-section--faq"><FAQBlock title="Часті запитання" intro="Основні відповіді щодо послуги, строків, вартості та організації робіт." items={faq} visibleCount={6} /></section>
<section id="service-request" class="inner-cta"><div><p class="eyebrow">Заявка</p><h2>Обговоримо ваш проєкт</h2><p>Надішліть фото, розміри або креслення.</p></div><a class="button button--white" href="/contacts/">Надіслати запит</a></section>
</main><Footer/></div></BaseLayout>
