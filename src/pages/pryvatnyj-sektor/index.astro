---
// /pryvatnyj-sektor/ — private houses and cottages landing on its old production URL.
// Same visual system as the solution pages (SolutionDetailPage); tiles, projects and
// SEO copy come from privateSectorExtra in src/data/solution-pages.ts.
import SolutionDetailPage from '../../components/solutions/SolutionDetailPage.astro';
import { privateSectorExtra } from '../../data/solution-pages';
import { absoluteUrl, breadcrumbSchema, faqSchema, type JsonLdObject } from '../../seo/schema';

const PATH = '/pryvatnyj-sektor/';
const origin = Astro.site ?? Astro.url.origin;

const title = 'Скляні конструкції для приватного будинку та котеджу | Space Glass';
const description =
  'Скло для приватного будинку й котеджу: огорожі сходів і терас, безрамне скління, вхідні групи, козирки, душові, перегородки, двері, дзеркала. Замір і монтаж.';
const h1 = 'Скляні конструкції для приватного будинку та котеджу';
const heroLead =
  'Огорожі, скління терас і фасадів, вхідні групи, козирки, душові, перегородки, двері й дзеркала для приватного будинку — проєктуємо під архітектуру й виготовляємо на власному виробництві з монтажем у Києві, Одесі, Львові та по Україні.';
const heroImage = {
  base: 'solution-house',
  width: 1280,
  height: 941,
  alt: 'Приватний будинок з панорамним склінням, скляною терасою та огорожею'
};

const scenarios = [
  { title: 'Сходи й другий поверх', text: 'Скляна огорожа сходів і галереї робить хол світлим і безпечним — без масивних балясин, що перекривають простір.' },
  { title: 'Тераса, яку використовують цілий рік', text: 'Безрамне або тепле алюмінієве скління перетворює відкриту терасу на кімнату з видом на сад.' },
  { title: 'Вхід у будинок', text: 'Вхідна група зі скла й алюмінію разом зі скляним козирком захищає ґанок від дощу та підкреслює фасад.' },
  { title: 'Санвузли та ванні кімнати', text: 'Душові кабіни, перегородки Walk-In і дзеркала з підсвіткою виконуємо під розміри кожної ванної в будинку.' }
];

const choosePoints = [
  { title: 'Огорожа сходів, балкона чи тераси', text: 'Для огорож використовують триплекс: при пошкодженні скло лишається в кріпленні. Безрамна система на затискному профілі виглядає легше, стійкова — дешевша й простіша в монтажі.', link: { label: 'Скляні огорожі: вимоги та безпека', href: '/knowledge/sklyani-ohorozhi-vymohy-bezpeka/' } },
  { title: 'Безрамне чи тепле скління', text: 'Безрамне скління дає максимальний огляд і підходить для сезонної тераси чи альтанки. Якщо простір опалюють, обирають теплий алюмінієвий контур зі склопакетом.', link: { label: 'Тепле чи холодне скління тераси', href: '/knowledge/teple-chy-kholodne-sklinnya-terasy/' } },
  { title: 'Козирок над входом', text: 'Козирок розраховують на сніг і вітер: консольний — для невеликого виносу, на тягах чи кронштейнах — для ширших входів і терас.', link: { label: 'Скляні козирки', href: '/sklyani-kozyrky/' } }
];

const materials = [
  { title: 'Триплекс', text: 'Основне скло для огорож, козирків і навісів — витримує зовнішні навантаження й не розсипається при пошкодженні.' },
  { title: 'Загартоване скло', text: 'Для душових, дверей, перегородок і безрамного скління — у 5–6 разів міцніше за звичайне.' },
  { title: 'Алюмінієві системи', text: 'Теплий або холодний профіль для вхідних груп, розсувних дверей, зимових садів і фасадів.' },
  { title: 'Фурнітура для вулиці', text: 'Нержавіюча сталь і порошкове покриття — для конструкцій, що працюють просто неба цілий рік.' }
];

const safetyPoints = [
  { title: 'Безпека на висоті', text: 'Огорожі сходів, галерей і балконів розраховуємо за висотою падіння й навантаженням на поручень.' },
  { title: 'Сніг, вітер і перепади температур', text: 'Козирки, скління терас і фасадів підбираємо під кліматичні навантаження конкретного регіону.' },
  { title: 'Гарантія на конструкції', text: 'Після монтажу перевіряємо роботу механізмів і передаємо об’єкт із гарантією та сервісом.' }
];

const priceFactors = [
  'тип конструкції та площа скла',
  'товщина й тип скла — загартоване чи триплекс',
  'система кріплення та фурнітура',
  'колір профілю й оздоблення',
  'складність об’єкта: висота, рельєф, доступ',
  'доставка та монтаж'
];

const processSteps = [
  { title: 'Консультація', text: 'Обговорюємо задачу, стиль будинку й бюджет, підбираємо варіанти конструкцій.' },
  { title: 'Замір', text: 'Виїжджаємо на об’єкт і фіксуємо фактичну геометрію сходів, прорізів чи тераси.' },
  { title: 'Договір', text: 'Погоджуємо специфікацію, вартість і строки виконання.' },
  { title: 'Проєктування', text: 'Готуємо креслення з розмірами, склом, профілем і вузлами кріплення.' },
  { title: 'Виготовлення', text: 'Виробляємо конструкції на власному обладнанні та контролюємо якість.' },
  { title: 'Монтаж і здача', text: 'Встановлюємо, регулюємо й передаємо об’єкт із гарантією.' }
];

const experienceStats = [
  { value: '10+', label: 'років реального досвіду в реалізації скляних та алюмінієвих конструкцій' },
  { value: '5 000+', label: 'реалізованих проєктів для дому та бізнесу в Україні та Європі' },
  { value: '50 000+', label: 'м² виконаного засклення житлових та комерційних об’єктів' }
];

const faq: [string, string][] = [
  ['Які скляні конструкції можна замовити для приватного будинку?', 'Огорожі сходів, балконів і терас, безрамне та панорамне скління, вхідні групи, козирки й навіси, душові кабіни, перегородки, двері, дзеркала, розсувні двері на терасу та зимові сади.'],
  ['Чи можна замовити кілька конструкцій для будинку в одному проєкті?', 'Так. Комплексне замовлення зручніше: один замір, єдиний колір профілю й фурнітури, узгоджений графік монтажу.'],
  ['Яке скло використовують для огорожі сходів у будинку?', 'Триплекс — ламіноване загартоване скло. Навіть при пошкодженні воно лишається в кріпленні й не створює небезпечних уламків.'],
  ['Чи можна засклити терасу котеджу без рам?', 'Так, безрамне скління — окреме рішення для терас і альтанок: стулки розсуваються або складаються без вертикальних стійок.'],
  ['Чи витримує скляний козирок сніг?', 'Так, якщо його розраховано під снігове навантаження регіону. Для козирків використовують тільки триплекс і відповідні кріплення.'],
  ['На якому етапі будівництва краще звертатися?', 'Найкраще — до стяжки й оздоблення: так закладаються кріплення огорож, пороги розсувних дверей і водовідведення тераси.'],
  ['Чи можна розрахувати вартість за проєктом будинку?', 'Так, попередній розрахунок готуємо за кресленнями, планом або фото з розмірами. Точна ціна — після заміру.'],
  ['Скільки триває виготовлення й монтаж?', 'Строки залежать від типу й кількості конструкцій і фіксуються в договорі після заміру та погодження креслень.'],
  ['Чи працюєте за містом і в котеджних містечках?', 'Так, виїжджаємо на замір і монтаж у котеджні містечка та передмістя Києва, Одеси, Львова й по всій Україні.'],
  ['Чи даєте гарантію на конструкції?', 'Так, на скло, фурнітуру й монтаж надаємо гарантію, а також виконуємо сервісне обслуговування.'],
  ['Чи можна поєднати скло з алюмінієвими вікнами та дверима будинку?', 'Так, підбираємо профіль і колір так, щоб огорожі, двері, вхідна група й скління виглядали як одна система.'],
  ['Як доглядати за зовнішніми скляними конструкціями?', 'Мийте скло неабразивними засобами, періодично очищайте напрямні й ущільнення, а при появі люфту звертайтеся в сервіс.']
];

const breadcrumbItems = [
  { label: 'Головна', href: '/' },
  { label: 'Приватний сектор', href: PATH }
];

const structuredData: JsonLdObject[] = [
  breadcrumbSchema(breadcrumbItems.map((item) => ({ label: item.label, href: absoluteUrl(item.href, origin) }))),
  faqSchema(faq.map(([question, answer]) => ({ question, answer })))
].filter(Boolean) as JsonLdObject[];
---
<SolutionDetailPage
  path={PATH}
  extra={privateSectorExtra}
  eyebrow="Приватний сектор · будинки та котеджі"
  title={title}
  description={description}
  h1={h1}
  heroLead={heroLead}
  heroImage={heroImage}
  scenarios={scenarios}
  choosePoints={choosePoints}
  materials={materials}
  safetyPoints={safetyPoints}
  priceFactors={priceFactors}
  processSteps={processSteps}
  experienceStats={experienceStats}
  faq={faq}
  breadcrumbItems={breadcrumbItems}
  structuredData={structuredData}
  formExample="Скляна огорожа сходів і козирок над входом для котеджу під Києвом"
/>
