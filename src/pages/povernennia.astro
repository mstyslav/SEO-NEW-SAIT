---
import LegalStructuredPage from '../components/LegalStructuredPage.astro';
import { localeFromPath, normalizeLocale } from '../i18n/helpers';
const locale = normalizeLocale(Astro.props.locale ?? localeFromPath(Astro.url.pathname));
const isRussian = locale === 'ru';
const title = isRussian ? 'Возврат товара' : 'Повернення товару';
const description = isRussian ? 'Возврат стандартных товаров и претензии по индивидуальным стеклянным изделиям Space Glass: осмотр при доставке, доказательства и порядок обращения.' : 'Повернення стандартних товарів і претензії щодо індивідуальних скляних виробів Space Glass: огляд при доставці, докази та порядок звернення.';
const sections = isRussian ? [
  ['1. Стандартные товары', 'Стандартные товары, не изготовленные под индивидуальные параметры Покупателя, могут быть возвращены в случаях и порядке, предусмотренных действующим законодательством, при сохранении товарного вида, комплектации и предоставленных документов.'],
  ['2. Индивидуальные изделия', 'Стеклянные конструкции, изготовленные или укомплектованные по размерам, чертежу, цвету, фурнитуре или другому индивидуальному выбору Покупателя, рассматриваются отдельно. Не каждое индивидуальное изделие автоматически исключено из возврата: возможность и способ защиты прав зависят от закона, фактических характеристик изделия и основания обращения.'],
  ['3. Осмотр при доставке', 'При получении проверьте упаковку, стекло, фурнитуру, количество мест и видимые повреждения. Обнаруженное повреждение зафиксируйте на фото или видео до монтажа или использования и сообщите Space Glass, а при доставке перевозчиком попросите оформить соответствующий акт.'],
  ['4. Обращение и доказательства', 'Направьте описание проблемы, фото или видео, документы доставки, номер или дату заказа и контакты на info@space-glass.com.ua. Не устанавливайте и не изменяйте изделие, если для рассмотрения недостатка необходим осмотр.'],
  ['5. Рассмотрение и решение', 'После проверки Space Glass предложит предусмотренное законом и соответствующее обстоятельствам решение — ремонт, замену, доукомплектацию, возврат средств или иной способ урегулирования. Срок и порядок зависят от характера товара, подтверждённых обстоятельств и применимых требований закона.']
] : [
  ['1. Стандартні товари', 'Стандартні товари, які не виготовлялися під індивідуальні параметри Покупця, можуть бути повернені у випадках і порядку, передбачених чинним законодавством, за умови збереження товарного вигляду, комплектації та наданих документів.'],
  ['2. Індивідуальні вироби', 'Скляні конструкції, виготовлені або укомплектовані за розмірами, кресленням, кольором, фурнітурою чи іншим індивідуальним вибором Покупця, розглядаються окремо. Не кожен індивідуальний виріб автоматично виключений із повернення: можливість і спосіб захисту прав залежать від закону, фактичних характеристик виробу та підстави звернення.'],
  ['3. Огляд при доставці', 'Під час отримання перевірте пакування, скло, фурнітуру, кількість місць і видимі пошкодження. Виявлене пошкодження зафіксуйте на фото чи відео до монтажу або використання та повідомте Space Glass, а під час доставки перевізником попросіть оформити відповідний акт.'],
  ['4. Звернення та докази', 'Надішліть опис проблеми, фото чи відео, документи доставки, номер або дату замовлення та контакти на info@space-glass.com.ua. Не встановлюйте і не змінюйте виріб, якщо для розгляду недоліку потрібен огляд.'],
  ['5. Розгляд і рішення', 'Після перевірки Space Glass запропонує передбачене законом і відповідне обставинам рішення — ремонт, заміну, доукомплектацію, повернення коштів або інший спосіб врегулювання. Строк і порядок залежать від характеру товару, підтверджених обставин та застосовних вимог закону.']
];
const faq = isRussian ? [{question:'Можно ли вернуть стандартный товар?',answer:'Да, если соблюдены применимые требования законодательства и товар сохранён в надлежащем состоянии.'},{question:'Все ли индивидуальные изделия не подлежат возврату?',answer:'Нет. Возможность возврата или другого способа защиты оценивается по закону, фактическим параметрам изделия и причине обращения.'}] : [{question:'Чи можна повернути стандартний товар?',answer:'Так, якщо дотримано застосовних вимог законодавства і товар збережений у належному стані.'},{question:'Чи всі індивідуальні вироби не підлягають поверненню?',answer:'Ні. Можливість повернення або іншого способу захисту оцінюється за законом, фактичними параметрами виробу та причиною звернення.'}];
const toc = sections.map(([label], index) => ({ id: `section-${index + 1}`, label }));
---
<LegalStructuredPage locale={locale} title={title} description={description} faq={faq} toc={toc} updated={isRussian ? '4 августа 2026' : '4 серпня 2026'}>
  {sections.map(([heading, text], index) => <section id={toc[index].id}><h2>{heading}</h2><p>{text}</p></section>)}
</LegalStructuredPage>
