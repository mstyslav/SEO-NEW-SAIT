---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localeFromPath, normalizeLocale, localizedPath } from '../i18n/helpers';

const locale = normalizeLocale(Astro.url.searchParams.get('lang') ?? localeFromPath(Astro.url.pathname));
const lp = (path: string) => localizedPath(path, locale);
const ru = locale === 'ru';
const copy = ru ? {
  title: 'Контакты Space Glass', description: 'Офисы Space Glass в Киеве, Одессе и Львове. Телефон, email, график работы и Google Maps.',
  eyebrow: 'Контакты', heading: 'Обсудим ваш проект', intro: 'Отправьте приблизительные размеры и опишите задачу — подготовим предварительную оценку.',
  name: 'Имя', namePlaceholder: 'Ваше имя', phone: 'Телефон', city: 'Город', cityPlaceholder: 'Киев, Львов, Одесса...',
  need: 'Что требуется', needPlaceholder: 'Кратко опишите конструкцию', file: 'Фото или чертёж', chooseFile: 'Выбрать файл', noFile: 'Файл не выбран',
  consent: 'Соглашаюсь с', privacy: 'политикой конфиденциальности', submit: 'Отправить запрос', offices: 'Наши офисы', chooseCity: 'Выберите город',
  schedule: 'График', route: 'Проложить маршрут', map: 'Открыть карту'
} : {
  title: 'Контакти Space Glass', description: 'Офіси Space Glass у Києві, Одесі та Львові. Телефон, email, графік та Google Maps.',
  eyebrow: 'Контакти', heading: 'Обговоримо ваш проєкт', intro: 'Надішліть приблизні розміри й опишіть задачу — підготуємо попередню оцінку.',
  name: 'Ім’я', namePlaceholder: 'Ваше ім’я', phone: 'Телефон', city: 'Місто', cityPlaceholder: 'Київ, Львів, Одеса...',
  need: 'Що потрібно', needPlaceholder: 'Коротко опишіть конструкцію', file: 'Фото або креслення', chooseFile: 'Вибрати файл', noFile: 'Файл не вибрано',
  consent: 'Погоджуюсь із', privacy: 'політикою конфіденційності', submit: 'Надіслати запит', offices: 'Наші офіси', chooseCity: 'Оберіть місто',
  schedule: 'Графік', route: 'Прокласти маршрут', map: 'Відкрити карту'
};

const offices = [
  {
    id: 'odesa',
    city: ru ? 'Одесса' : 'Одеса',
    address: ru ? 'ул. Глиняная, 5' : 'вул. Глиняна, 5',
    phone: '+38 (073) 425 14 00',
    email: 'info@space-glass.com.ua',
    hours: ru ? 'Пн–Пт: 09:00–19:00' : 'Пн–Пт: 09:00–19:00',
    query: 'Одеса, вул. Глиняна, 5'
  },
  {
    id: 'kyiv',
    city: ru ? 'Киев' : 'Київ',
    address: ru ? 'ул. Лауреатская, 8' : 'вул. Лауреатська, 8',
    phone: '+38 (073) 425 14 00',
    email: 'info@space-glass.com.ua',
    hours: 'Пн–Пт: 09:00–19:00',
    query: 'Київ, вул. Лауреатська, 8'
  },
  {
    id: 'lviv',
    city: ru ? 'Львов' : 'Львів',
    address: ru ? 'ул. Кульпарковская, 144' : 'вул. Кульпарківська, 144',
    phone: '+38 (073) 425 14 00',
    email: 'info@space-glass.com.ua',
    hours: 'Пн–Пт: 09:00–19:00',
    query: 'Львів, вул. Кульпарківська, 144'
  }
];
---
<BaseLayout title={copy.title} description={copy.description} locale={locale}>
<div class="sg-page-shell">
  <Header />
  <main id="main">
    <section class="contacts-v15-hero">
      <div>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.heading}</h1>
        <p class="lead">{copy.intro}</p>
      </div>
      <form class="quote-form contacts-v15-form" data-lead-form data-success-url="/thank-you/">
        <div class="contacts-form-grid">
          <label>{copy.name}<input name="name" type="text" autocomplete="name" placeholder={copy.namePlaceholder} required /></label>
          <label>{copy.phone}<input name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="+38" required /></label>
        </div>
        <label>{copy.city}<input name="city" autocomplete="address-level2" type="text" placeholder={copy.cityPlaceholder} /></label>
        <label>{copy.need}<textarea name="comment" rows="5" placeholder={copy.needPlaceholder}></textarea></label>
        <label class="contacts-file-field">
          <span>{copy.file}</span>
          <span class="contacts-file-control">
            <span class="contacts-file-button">{copy.chooseFile}</span>
            <span class="contacts-file-name" data-file-name data-empty-label={copy.noFile}>{copy.noFile}</span>
          </span>
          <input class="contacts-file-input" name="attachment" type="file" accept=".jpg,.jpeg,.png,.webp,.pdf,.dwg" data-file-input />
        </label>
        <label class="quote-consent"><input name="consent" value="accepted" type="checkbox" required /><span>{copy.consent} <a href={lp('/privacy-policy/')}>{copy.privacy}</a>.</span></label>
        <button class="button button--mint" type="submit">{copy.submit}</button>
        <p data-form-status hidden role="status"></p>
      </form>
    </section>

    <section class="contacts-v15-section">
      <div class="contacts-v15-head">
        <div>
          <p class="eyebrow">{copy.offices}</p>
          <h2>{copy.chooseCity}</h2>
        </div>
      </div>

      <div class="contacts-tabs" data-contact-tabs>
        <div class="contacts-tabs__buttons" role="tablist" aria-label={copy.offices}>
          {offices.map((office, index) => (
            <button
              class:list={['contacts-tab-button', index === 0 && 'is-active']}
              type="button"
              role="tab"
              id={`office-tab-${office.id}`}
              aria-controls={`office-panel-${office.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? '0' : '-1'}
              data-office-button={office.id}>
              {office.city}
            </button>
          ))}
        </div>

        <div class="contacts-tabs__shell">
          {offices.map((office, index) => (
            <article
              class:list={['contacts-office-panel', index === 0 && 'is-active']}
              id={`office-panel-${office.id}`}
              role="tabpanel"
              aria-labelledby={`office-tab-${office.id}`}
              hidden={index !== 0}
              data-office-panel={office.id}>
              <div class="contacts-office-info">
                <p class="eyebrow">{office.city}</p>
                <h3>{office.address}</h3>

                <div class="contacts-office-info__rows">
                  <div>
                    <span>{copy.phone}</span>
                    <a href={`tel:${office.phone.replace(/\s|\(|\)|-/g,'')}`}>{office.phone}</a>
                  </div>
                  <div>
                    <span>Email</span>
                    <a href={`mailto:${office.email}`}>{office.email}</a>
                  </div>
                  <div>
                    <span>{copy.schedule}</span>
                    <b>{office.hours}</b>
                  </div>
                </div>

                <div class="contacts-office-actions">
                  <a
                    class="button button--mint"
                    target="_blank"
                    rel="noopener noreferrer"
                    href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(office.query)}`}>
                    {copy.route}
                  </a>
                  <a
                    class="button button--outline"
                    target="_blank"
                    rel="noopener noreferrer"
                    href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(office.query)}`}>
                    {copy.map}
                  </a>
                </div>

                <div class="contacts-social-mini" aria-label="Соціальні мережі Space Glass">

<a href="https://www.instagram.com/spaceglass_od/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="5"></rect>
    <circle cx="12" cy="12" r="4"></circle>
    <circle cx="17.5" cy="6.5" r="1"></circle>
  </svg>
</a>
<a href="https://t.me/spaceglass" target="_blank" rel="noopener noreferrer" aria-label="Telegram">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M21 4 3.8 10.6c-.8.3-.8 1.4 0 1.7l4.3 1.4 1.6 5c.2.7 1.1.9 1.6.4l2.4-2.5 4.1 3c.6.4 1.4.1 1.6-.6L22 5.2c.2-.8-.3-1.4-1-1.2Z"></path>
    <path d="m8.1 13.7 9.8-6.2-7.6 8.1"></path>
  </svg>
</a>
<a href="https://www.tiktok.com/@spaceglass" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M14 3v10.2a4.4 4.4 0 1 1-3.8-4.4"></path>
    <path d="M14 3c.6 2.6 2.2 4.2 4.8 4.8"></path>
  </svg>
</a>
<a href="https://www.facebook.com/spaceglasscomua" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M14 8h3V4.5c-.6-.1-1.8-.2-3.2-.2-3.1 0-5.2 1.9-5.2 5.4V13H5v4h3.6v7H13v-7h3.6l.6-4H13v-3c0-1.2.3-2 1-2Z"></path>
  </svg>
</a>
<a href="https://www.youtube.com/@spaceglass5552" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M21 8.2a3 3 0 0 0-2.1-2.1C17 5.6 12 5.6 12 5.6s-5 0-6.9.5A3 3 0 0 0 3 8.2 31 31 0 0 0 2.6 12 31 31 0 0 0 3 15.8a3 3 0 0 0 2.1 2.1c1.9.5 6.9.5 6.9.5s5 0 6.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .4-3.8 31 31 0 0 0-.4-3.8Z"></path>
    <path d="m10 9 5 3-5 3V9Z"></path>
  </svg>
</a>

                </div>
              </div>

              <div class="contacts-office-map">
                <iframe
                  src={`https://www.google.com/maps?q=${encodeURIComponent(office.query)}&output=embed`}
                  title={`Карта офісу Space Glass — ${office.city}`}
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  allowfullscreen>
                </iframe>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</div>
</BaseLayout>

<script>
  document.querySelectorAll('[data-file-input]').forEach((input) => {
    const field = input.closest('.contacts-file-field');
    const name = field?.querySelector('[data-file-name]');
    input.addEventListener('change', () => {
      if (!name) return;
      name.textContent = input.files?.[0]?.name || name.dataset.emptyLabel || '';
      name.classList.toggle('has-file', Boolean(input.files?.length));
    });
  });

  document.querySelectorAll('[data-contact-tabs]').forEach((tabs) => {
    const buttons = tabs.querySelectorAll('[data-office-button]');
    const panels = tabs.querySelectorAll('[data-office-panel]');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const office = button.getAttribute('data-office-button');

        buttons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-selected', String(active));
          item.setAttribute('tabindex', active ? '0' : '-1');
        });

        panels.forEach((panel) => {
          panel.classList.toggle(
            'is-active',
            panel.getAttribute('data-office-panel') === office
          );
          panel.hidden = panel.getAttribute('data-office-panel') !== office;
        });
      });
    });
  });
</script>

<style>
/* Moved from global.css: rules used exclusively on this page (contacts-only classes). */
/* Sprint 5 — single switchable office map */
.contacts-v15-hero{
  display:grid;
  grid-template-columns:.9fr 1.1fr;
  gap:54px;
  align-items:center;
  padding:76px 58px;
  background:#fff;
  border-bottom:1px solid var(--line);
}

.contacts-v15-form{
  padding:28px;
  background:#063d2b;
}

.contacts-v15-section{
  padding:72px 58px;
  background:#fff;
}

.contacts-v15-head{
  display:flex;
  justify-content:space-between;
  gap:44px;
  align-items:end;
  max-width:1460px;
  margin:0 auto 26px;
}

.contacts-v15-head>div{
  max-width:720px;
}

.contacts-v15-head>p{
  max-width:520px;
  color:var(--muted);
}

.contacts-tabs{
  max-width:1460px;
  margin:0 auto;
  padding:30px;
  border:1px solid var(--green-line);
  border-radius:24px;
  background:#fff;
  box-shadow:0 16px 44px rgba(14,56,40,.055);
}

.contacts-tabs__buttons{
  display:flex;
  gap:10px;
  margin-bottom:18px;
}

.contacts-tab-button{
  min-width:116px;
  min-height:48px;
  padding:0 22px;
  border:1px solid var(--green-line);
  border-radius:10px;
  background:#fff;
  color:#141916;
  font-size:15px;
  font-weight:750;
  cursor:pointer;
  transition:
    background .18s ease,
    color .18s ease,
    border-color .18s ease,
    transform .18s ease;
}

.contacts-tab-button:hover{
  border-color:var(--mint-dark);
  background:#f2faf6;
  transform:translateY(-1px);
}

.contacts-tabs__shell{
  position:relative;
}

.contacts-office-panel{
  display:none;
  grid-template-columns:.72fr 1.28fr;
  min-height:460px;
  overflow:hidden;
  border:1px solid var(--green-line);
  border-radius:18px;
}

.contacts-office-panel.is-active{
  display:grid;
}

.contacts-office-info{
  padding:42px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  background:#fff;
}

.contacts-office-info h3{
  margin:6px 0 26px;
  font-size:clamp(2.3rem,3.8vw,4.4rem);
  line-height:.98;
}

.contacts-office-info__rows{
  display:grid;
  gap:14px;
}

.contacts-office-info__rows>div{
  padding-bottom:12px;
  border-bottom:1px solid var(--line);
}

.contacts-office-info__rows span,
.contacts-office-info__rows a,
.contacts-office-info__rows b{
  display:block;
}

.contacts-office-info__rows span{
  margin-bottom:4px;
  color:var(--muted);
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:.08em;
}

.contacts-office-info__rows a,
.contacts-office-info__rows b{
  color:#111;
  font-size:15px;
}

.contacts-office-actions{
  display:grid;
  grid-template-columns:minmax(0,max-content);
  gap:10px;
  margin-top:24px;
}

.contacts-social-mini{
  display:flex;
  gap:8px;
  margin-top:24px;
}

.contacts-social-mini a{
  display:grid;
  place-items:center;
  width:36px;
  height:36px;
  border:1px solid var(--green-line);
  border-radius:8px;
  color:#111;
  font-weight:800;
}

.contacts-social-mini a:hover{
  border-color:var(--mint-dark);
  background:#eff9f4;
  color:var(--mint-dark);
}

.contacts-office-map{
  position:relative;
  min-height:460px;
  background:#eff9f4;
}

.contacts-office-map iframe{
  display:block;
  width:100%;
  height:100%;
  min-height:460px;
  border:0;
}

@media(max-width:900px) {

.contacts-v15-hero,
  .contacts-office-panel{
    grid-template-columns:1fr;
  }

.contacts-v15-head{
    align-items:flex-start;
    flex-direction:column;
  }

.contacts-office-map,
  .contacts-office-map iframe{
    min-height:390px;
  }

}

@media(max-width:620px) {

.contacts-v15-hero,
  .contacts-v15-section{
    padding:50px 22px;
  }

.contacts-tabs{
    padding:18px;
    border-radius:18px;
  }

.contacts-tabs__buttons{
    overflow-x:auto;
    padding-bottom:4px;
  }

.contacts-tab-button{
    flex:0 0 auto;
  }

.contacts-office-info{
    padding:28px 22px;
  }

.contacts-office-actions{
    flex-direction:column;
  }

}

/* Sprint 6 — clean forms, CTA and footer/header fixes */

/* Contact hero: remove heavy green form background */
.contacts-v15-hero{
  background:#fff;
  align-items:stretch;
}

.contacts-v15-form{
  align-self:center;
  padding:30px;
  border:1px solid var(--green-line);
  border-radius:22px;
  background:#fff;
  box-shadow:0 14px 38px rgba(14,56,40,.055);
}

.contacts-v15-form::before{
  content:"";
  display:block;
  width:72px;
  height:4px;
  margin-bottom:22px;
  border-radius:999px;
  background:var(--mint);
}

.contacts-v15-form label{
  color:#1b211e;
  font-size:12px;
  font-weight:700;
}

.contacts-v15-form input,
.contacts-v15-form textarea{
  color:#111;
  background:#fff;
  border-bottom:1px solid #b8ccc3;
}

.contacts-file-field{
  position:relative;
  overflow:hidden;
}

.contacts-file-input{
  position:absolute!important;
  width:1px!important;
  height:1px!important;
  min-height:0!important;
  opacity:0;
  pointer-events:none;
}

.contacts-file-control{
  display:flex;
  align-items:center;
  gap:12px;
  width:100%;
  min-height:58px;
  padding:10px 12px;
  border:1px solid var(--green-line);
  border-radius:10px;
  background:#fff;
  cursor:pointer;
  text-transform:none!important;
  letter-spacing:0!important;
}

.contacts-file-button{
  flex:0 0 auto;
  padding:9px 14px;
  border-radius:7px;
  background:#eef3f0;
  color:#111;
  font-size:14px!important;
  font-weight:700!important;
  text-transform:none!important;
  letter-spacing:0!important;
}

.contacts-file-name{
  min-width:0;
  overflow:hidden;
  color:var(--muted);
  font-size:14px!important;
  font-weight:500!important;
  text-overflow:ellipsis;
  text-transform:none!important;
  white-space:nowrap;
  letter-spacing:0!important;
}

.contacts-file-name.has-file{color:#111}

@media(max-width:520px) {

.contacts-file-control{align-items:stretch;flex-direction:column}

.contacts-file-button{text-align:center}

}

.contacts-v15-form input:focus,
.contacts-v15-form textarea:focus{
  border-color:var(--mint-dark);
  outline:none;
}

.contacts-form-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:18px;
}

.contacts-file-field{
  margin-top:6px;
  padding:14px 16px;
  border:1px dashed var(--green-line);
  border-radius:12px;
  background:#f8fcfa;
}

.contacts-file-field input{
  margin-top:8px;
  padding:0;
  border:0;
}

@media(max-width:620px) {

.contacts-form-grid{
    grid-template-columns:1fr;
  }

}

/* Contact textarea fixed size, no resize handle or stray line */
.contacts-v15-form textarea{
  min-height:120px;
  resize:none;
  border:1px solid var(--green-line);
  border-radius:10px;
  padding:14px;
}

.contacts-v15-form input,
.contacts-v15-form select{
  min-height:50px;
  border:1px solid var(--green-line);
  border-radius:10px;
  padding:0 14px;
}

.contacts-v15-form label{
  gap:8px;
}

.contacts-v15-form input,
.contacts-v15-form textarea{
  border-bottom:1px solid var(--green-line);
}

.contacts-social-mini{
  display:grid!important;
  grid-template-columns:repeat(5,38px)!important;
  gap:8px!important;
  margin-top:24px!important;
}

.contacts-social-mini a{
  border-color:var(--green-line)!important;
  color:#111!important;
  background:#fff!important;
}

.contacts-social-mini a:hover{
  color:var(--mint-dark)!important;
}

.contacts-social-mini a{width:48px!important;height:48px!important;padding:10px!important}

.contacts-social-mini svg{width:22px!important;height:22px!important}
</style>
