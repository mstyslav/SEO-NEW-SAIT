<section class="contacts-section contacts-geography"><div class="contacts-section__inner"><div class="contacts-geography__copy"><div class="contacts-section-head"><p class="eyebrow">{copy.geoEyebrow}</p><h2>{copy.geoTitle}</h2><p>{copy.geoText}</p></div><div class="contacts-city-list" aria-label={copy.geoCitiesAria}><span>{ru?'Киев':'Київ'}</span><span>{ru?'Одесса':'Одеса'}</span><span>{ru?'Львов':'Львів'}</span></div></div><div class="contacts-maps"><figure class="contacts-map contacts-map--ukraine" role="img" aria-label={copy.geoMapAria}><svg viewBox={viewBox} aria-hidden="true" focusable="false"><path class="contacts-map__outline" d={CONTACT_MAPS.ukraine.path}/>{ukCities.map((c) => <g class="contacts-map__city" data-city={c.id}><circle cx={c.x} cy={c.y} r="5"/><text x={c.x + 11} y={c.y + 5}>{c.label}</text></g>)}</svg><figcaption>{copy.mapUkraineCaption}</figcaption></figure><figure class="contacts-map contacts-map--austria" role="img" aria-label={copy.geoMapAriaAt}><svg viewBox={viewBox} aria-hidden="true" focusable="false"><path class="contacts-map__outline" d={CONTACT_MAPS.austria.path}/><g class="contacts-map__city contacts-map__city--area" data-city="wien"><circle cx={CONTACT_MAPS.austria.markers.wien.x} cy={CONTACT_MAPS.austria.markers.wien.y} r="5"/><text x={CONTACT_MAPS.austria.markers.wien.x - 11} y={CONTACT_MAPS.austria.markers.wien.y + 5} text-anchor="end">{wienLabel}</text></g></svg><figcaption>{copy.mapAustriaCaption}</figcaption></figure></div><div class="contacts-markets" aria-label={copy.marketsAria}><div class="contacts-market contacts-market--offices"><p class="contacts-market__kind"><span class="contacts-market__dot" aria-hidden="true"></span>{copy.marketOffices}</p><h3>{marketText(uaMarket.label, locale)}</h3><p>{marketText(uaMarket.note, locale)}</p></div>{serviceMarkets.map(({ market, contacts: mc }) => <div class="contacts-market contacts-market--area" data-market={market.code}><p class="contacts-market__kind"><span class="contacts-market__dot" aria-hidden="true"></span>{copy.marketArea}</p><h3>{marketText(market.serviceArea, locale)}</h3><p>{marketText(market.note, locale)}</p><div class="contacts-market__actions">{mc.phone && !mc.fallback.includes('phone') && <a href={telHref(mc.phone)}>{mc.phone.display}</a>}{mc.whatsapp && <a href={whatsappHref(mc.whatsapp)} target="_blank" rel="noopener noreferrer">WhatsApp</a>}{mc.email && <a href={`mailto:${mc.email}`}>{mc.email}</a>}<a class="contacts-market__cta" href="#contact-form">{copy.marketRequest}</a></div></div>)}</div></div></section><section class="contacts-b2b"><div class="contacts-b2b__inner"><div><p class="eyebrow">{copy.b2bEyebrow}</p><h2>{copy.b2bTitle}</h2><p>{copy.b2bText}</p><p class="contacts-b2b__line">{copy.b2bLine}</p></div><a class="button button--mint" href={`${lp('/contacts/')}#contact-form`}>{copy.b2bCta}</a></div></section><section class="contacts-section contacts-faq"><div class="contacts-section__inner"><FAQBlock eyebrow="FAQ" title={copy.faqTitle} intro={copy.faqIntro} items={faqs} visibleCount={6} locale={locale} /></div></section>
