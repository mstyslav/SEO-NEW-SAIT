---
import { MARKETS, activeMarkets, marketContacts, marketText, resolveMarket, telHref, whatsappHref } from '../data/markets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FAQBlock from '../components/FAQBlock.astro';
import '../styles/contacts-final.css';
import { CONTACT_MAPS, CONTACT_MAP_VIEWBOX } from '../data/contact-maps';
import { localeFromPath, normalizeLocale, localizedPath } from '../i18n/helpers';
import { officeSchema } from '../seo/schema';
const locale = normalizeLocale(Astro.url.searchParams.get('lang') ?? localeFromPath(Astro.url.pathname));
const lp = (path: string) => localizedPath(path, locale);
const ru = locale === 'ru';
const copy = ru ? { title:'Контакты Space Glass — Киев, Одесса, Львов',description:'Контакты Space Glass в Киеве, Одессе и Львове: телефон, email, график работы. Отправьте фото, размеры или чертёж — рассчитаем стеклянную конструкцию.',eyebrow:'Контакты',heading:'Обсудим ваш проект',intro:'Отправьте приблизительные размеры и опишите задачу — подготовим предварительную оценку.',name:'Имя',namePlaceholder:'Ваше имя',phone:'Телефон',city:'Город',cityPlaceholder:'Киев, Львов, Одесса...',need:'Что требуется',needPlaceholder:'Кратко опишите конструкцию',file:'Фото или чертёж',chooseFile:'Выбрать файл',noFile:'Файл не выбран',consent:'Соглашаюсь с',privacy:'политикой конфиденциальности',submit:'Отправить запрос',offices:'Наши офисы',chooseCity:'Выберите город',schedule:'График',route:'Проложить маршрут',map:'Открыть карту',quickLinksAria:'Быстрые контакты',calcEyebrow:'Для расчёта',calcTitle:'Что отправить для предварительной оценки',geoEyebrow:'География',geoTitle:'Реализуем проекты по всей Украине',geoText:'Основные команды Space Glass работают в Киеве, Одессе и Львове. Реализацию проектов в других городах Украины согласовываем в зависимости от типа конструкции, объёма работ и логистики.',geoCitiesAria:'Основные города Space Glass',geoMapAria:'Карта Украины с городами Львов, Киев и Одесса',geoMapAriaAt:'Карта Австрии с отметкой Вены',mapUkraineCaption:'Украина — офисы в Киеве, Одессе и Львове',mapAustriaCaption:'Австрия — зона обслуживания, Вена',marketsAria:'Рынки Space Glass',marketOffices:'Офисы',marketArea:'Зона обслуживания',marketRequest:'Отправить запрос',socialAria:'Социальные сети Space Glass',b2bEyebrow:'Для бизнеса',b2bTitle:'Работаете над коммерческим проектом?',b2bText:'Сотрудничаем с архитекторами, дизайнерами, застройщиками и генеральными подрядчиками. Работаем с чертежами, спецификациями и проектной документацией.',b2bLine:'Офисы · магазины · рестораны · отели · жилые комплексы · частные объекты',b2bCta:'Отправить проект',faqTitle:'Часто задаваемые вопросы',faqIntro:'Ответы про расчёт, замер, файлы, производство, монтаж и географию работы.' } : { title:'Контакти Space Glass — Київ, Одеса, Львів',description:'Контакти Space Glass у Києві, Одесі та Львові. Надішліть фото, розміри або креслення для розрахунку скляних та алюмінієвих конструкцій.',eyebrow:'Контакти',heading:'Обговоримо ваш проєкт',intro:'Надішліть фото, приблизні розміри або креслення — підготуємо попередній розрахунок і підкажемо оптимальне технічне рішення.',name:'Ім’я',namePlaceholder:'Ваше ім’я',phone:'Телефон',city:'Місто',cityPlaceholder:'Київ, Львів, Одеса...',need:'Що потрібно',needPlaceholder:'Коротко опишіть конструкцію',file:'Фото або креслення',chooseFile:'Вибрати файл',noFile:'Файл не вибрано',consent:'Погоджуюсь із',privacy:'політикою конфіденційності',submit:'Надіслати запит',offices:'Наші офіси',chooseCity:'Оберіть місто',schedule:'Графік',route:'Прокласти маршрут',map:'Відкрити карту',quickLinksAria:'Швидкі контакти',calcEyebrow:'Для розрахунку',calcTitle:'Що надіслати для попередньої оцінки',geoEyebrow:'Географія',geoTitle:'Реалізуємо проєкти по всій Україні',geoText:'Основні команди Space Glass працюють у Києві, Одесі та Львові. Реалізацію проєктів в інших містах України узгоджуємо залежно від типу конструкції, обсягу робіт та логістики.',geoCitiesAria:'Основні міста Space Glass',geoMapAria:'Карта України з містами Львів, Київ і Одеса',geoMapAriaAt:'Карта Австрії з позначкою Відня',mapUkraineCaption:'Україна — офіси в Києві, Одесі та Львові',mapAustriaCaption:'Австрія — зона обслуговування, Відень',marketsAria:'Ринки Space Glass',marketOffices:'Офіси',marketArea:'Зона обслуговування',marketRequest:'Надіслати запит',socialAria:'Соціальні мережі Space Glass',b2bEyebrow:'Для бізнесу',b2bTitle:'Працюєте над комерційним проєктом?',b2bText:'Співпрацюємо з архітекторами, дизайнерами, забудовниками та генеральними підрядниками. Працюємо з кресленнями, специфікаціями та проєктною документацією.',b2bLine:'Офіси · магазини · ресторани · готелі · житлові комплекси · приватні об’єкти',b2bCta:'Надіслати проєкт',faqTitle:'Поширені запитання',faqIntro:'Відповіді про розрахунок, замір, файли, виробництво, монтаж і географію роботи.' };
// Offices, phone, e-mail and Telegram come from the market config (src/data/markets.ts).
const uaMarket = MARKETS.UA;
const viewBox = `0 0 ${CONTACT_MAP_VIEWBOX.width} ${CONTACT_MAP_VIEWBOX.height}`;
const ukCities = ([['lviv', ru?'Львов':'Львів'], ['kyiv', ru?'Киев':'Київ'], ['odesa', ru?'Одесса':'Одеса']] as const).map(([id, label]) => ({ id, label, ...CONTACT_MAPS.ukraine.markers[id] }));
const wienLabel = ru ? 'Вена' : 'Відень';
const pageMarket = resolveMarket(locale);
const contacts = marketContacts(pageMarket);
const uaContacts = marketContacts(uaMarket);
const offices = uaMarket.offices.map((office) => ({ id: office.id, city: marketText(office.city, locale), address: marketText(office.street, locale), phone: uaContacts.phone!.display, email: uaContacts.email!, hours: office.hours, query: office.mapQuery, page: office.page }));
// Other active markets without offices (Austria): shown next to the map as service areas, never as office markers.
const serviceMarkets = activeMarkets().filter((market) => market.presence === 'service-area').map((market) => ({ market, contacts: marketContacts(market) }));
// Structured data for the three offices listed on this page (address, phone, hours as shown below). The same @id is
// used on /contacts/ and /ru/contacts/, so the node is identical on both: the official Ukrainian address and city page.
const officeNodes = uaMarket.offices.map((office) => officeSchema(Astro.site ?? Astro.url.origin, { id: office.id, city: office.city.uk, streetAddress: office.street.uk, url: office.page, countryCode: uaMarket.countryCode }));
const socials = [['Instagram','https://www.instagram.com/spaceglass_od/'],['Telegram','https://t.me/spaceglass'],['TikTok','https://www.tiktok.com/@spaceglass'],['Facebook','https://www.facebook.com/spaceglasscomua'],['YouTube','https://www.youtube.com/@spaceglass_od']];
const calculationItems = ru ? [['01','Фото объекта','Поможет понять тип конструкции, проём и условия будущего монтажа.'],['02','Приблизительные размеры','Для предварительного расчёта достаточно основных габаритов конструкции.'],['03','Чертёж / PDF / DWG','Если проект уже подготовлен — отправьте чертёж или техническую документацию для проверки.']] : [['01','Фото об’єкта','Допоможе зрозуміти тип конструкції, отвір та умови майбутнього монтажу.'],['02','Приблизні розміри','Для попереднього розрахунку достатньо основних габаритів конструкції.'],['03','Креслення / PDF / DWG','Якщо проєкт уже підготовлений — надішліть креслення або технічну документацію для перевірки.']];
const faqs: [string,string][] = ru ? [
['Можно ли получить предварительный расчёт дистанционно?','Да. Отправьте фото, приблизительные размеры или чертёж — мы подготовим предварительную оценку и уточним дальнейшие шаги.'],
['Что нужно отправить для предварительного расчёта?','Достаточно фото объекта, ориентировочных размеров, города и краткого описания нужной конструкции.'],
['Можно ли отправить фото объекта?','Да, фото помогут оценить геометрию проёма, условия монтажа и предложить подходящее решение.'],
['Можно ли отправить PDF или DWG?','Да. Прикладывайте PDF, DWG или другую техническую документацию — это ускоряет проверку и расчёт.'],
['Обязательно ли иметь готовый чертёж?','Нет. Для начала достаточно фото и приблизительных размеров; при необходимости техническое решение и чертёж подготовим вместе.'],
['Как быстро вы подготовите предварительный расчёт?','Срок зависит от сложности запроса и полноты данных. Менеджер сообщит ориентировочное время после получения заявки.'],
['Можно ли заказать выезд на замер?','Да. Профессиональный замер организуем после первичного согласования задачи и удобного времени для доступа на объект.'],
['В каких городах работает Space Glass?','Основные команды работают в Киеве, Одессе и Львове. Реализацию в других городах согласовываем отдельно.'],
['Работаете ли вы по всей Украине?','Да, выполняем проекты по Украине с учётом логистики, типа конструкции, объёма работ и возможности монтажа.'],
['Можно ли заказать только изготовление без монтажа?','Да, для части конструкций возможны отдельное изготовление и доставка. Условия зависят от системы и комплектации.'],
['Выполняете ли вы монтаж конструкций?','Да. Монтаж выполняют опытные бригады после согласования технического решения и готовности объекта.'],
['Работаете ли вы с частными заказчиками?','Да, реализуем решения для квартир, домов, террас, ванных комнат и других частных объектов.'],
['Работаете ли вы с бизнесом и застройщиками?','Да. Сотрудничаем с архитекторами, дизайнерами, застройщиками и компаниями над коммерческими и архитектурными объектами.'],
['Можно ли получить коммерческое предложение для компании?','Да. Отправьте техническое задание, чертёж или спецификацию — подготовим предложение с нужным объёмом работ.'],
['Работаете ли вы с нестандартными размерами?','Да. Большинство стеклянных и алюминиевых конструкций проектируем по фактической геометрии конкретного объекта.'],
['Можно ли заказать индивидуальное проектирование?','Да. Для сложных решений готовим техническую проработку, чертежи и спецификацию до запуска в производство.'],
['Какие данные нужны для точного расчёта?','Для точного расчёта нужны финальные размеры после замера, тип стекла, фурнитура, способ монтажа и город объекта.'],
['Можно ли согласовать материалы и фурнитуру до заказа?','Да. До запуска в производство согласовываем стекло, цвет и тип фурнитуры, профили и другие важные детали.'],
['Как происходит оплата и запуск в производство?','После согласования комплектации и стоимости фиксируем условия оплаты. Производство запускается после подтверждения заказа.'],
['Как со мной свяжутся после отправки заявки?','Менеджер Space Glass позвонит или напишет в рабочее время, чтобы уточнить детали и предложить следующий шаг.']
] : [
['Чи можна отримати попередній розрахунок дистанційно?','Так. Надішліть фото, приблизні розміри або креслення — ми підготуємо попередню оцінку та уточнимо наступні кроки.'],
['Що потрібно надіслати для попереднього розрахунку?','Достатньо фото об’єкта, орієнтовних розмірів, міста та короткого опису потрібної конструкції.'],
['Чи можна надіслати фото об’єкта?','Так, фото допоможуть оцінити геометрію отвору, умови монтажу та запропонувати відповідне рішення.'],
['Чи можна надіслати PDF або DWG?','Так. Додавайте PDF, DWG або іншу технічну документацію — це пришвидшує перевірку та розрахунок.'],
['Чи обов’язково мати готове креслення?','Ні. Для старту достатньо фото й приблизних розмірів; за потреби технічне рішення та креслення підготуємо разом.'],
['Як швидко ви підготуєте попередній розрахунок?','Термін залежить від складності запиту та повноти даних. Менеджер повідомить орієнтовний час після отримання заявки.'],
['Чи можна замовити виїзд на замір?','Так. Професійний замір організовуємо після первинного узгодження задачі та зручного часу для доступу на об’єкт.'],
['У яких містах працює Space Glass?','Основні команди працюють у Києві, Одесі та Львові. Реалізацію в інших містах узгоджуємо окремо.'],
['Чи працюєте ви по всій Україні?','Так, виконуємо проєкти по Україні з урахуванням логістики, типу конструкції, обсягу робіт і можливості монтажу.'],
['Чи можна замовити тільки виготовлення без монтажу?','Так, для частини конструкцій можливі окреме виготовлення та доставка. Умови залежать від системи й комплектації.'],
['Чи виконуєте ви монтаж конструкцій?','Так. Монтаж виконують досвідчені бригади після погодження технічного рішення та готовності об’єкта.'],
['Чи працюєте ви з приватними замовниками?','Так, реалізуємо рішення для квартир, будинків, терас, ванних кімнат та інших приватних об’єктів.'],
['Чи працюєте ви з бізнесом і забудовниками?','Так. Співпрацюємо з архітекторами, дизайнерами, забудовниками й компаніями над комерційними та архітектурними об’єктами.'],
['Чи можна отримати комерційну пропозицію для компанії?','Так. Надішліть технічне завдання, креслення або специфікацію — підготуємо пропозицію з потрібним обсягом робіт.'],
['Чи працюєте ви з нестандартними розмірами?','Так. Більшість скляних та алюмінієвих конструкцій проєктуємо за фактичною геометрією конкретного об’єкта.'],
['Чи можна замовити індивідуальне проєктування?','Так. Для складних рішень готуємо технічне опрацювання, креслення та специфікацію до запуску у виробництво.'],
['Які дані потрібні для точного прорахунку?','Для точного розрахунку потрібні фінальні розміри після заміру, тип скла, фурнітура, спосіб монтажу та місто об’єкта.'],
['Чи можна узгодити матеріали та фурнітуру до замовлення?','Так. До запуску у виробництво погоджуємо скло, колір і тип фурнітури, профілі та інші важливі деталі.'],
['Як відбувається оплата та запуск у виробництво?','Після погодження комплектації та вартості фіксуємо умови оплати. Виробництво запускається після підтвердження замовлення.'],
['Як зі мною зв’яжуться після відправлення заявки?','Менеджер Space Glass зателефонує або напише у робочий час, щоб уточнити деталі та запропонувати наступний крок.']
];
---
<BaseLayout title={copy.title} description={copy.description} locale={locale} schemaType="ContactPage" structuredData={officeNodes}><div class="sg-page-shell contacts-page"><Header /><main id="main">
<section class="contacts-hero"><div class="contacts-hero__copy"><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.heading}</h1><p class="lead">{copy.intro}</p><div class="contacts-quick-links" aria-label={copy.quickLinksAria}>{contacts.phone && <a href={telHref(contacts.phone)}>{contacts.phone.display}</a>}{contacts.whatsapp && <a href={whatsappHref(contacts.whatsapp)} target="_blank" rel="noopener noreferrer">WhatsApp</a>}{contacts.email && <a href={`mailto:${contacts.email}`}>{contacts.email}</a>}{contacts.telegram && <a href={contacts.telegram} target="_blank" rel="noopener noreferrer">Telegram</a>}</div></div><form id="contact-form" class="quote-form contacts-form" data-lead-form data-success-url="/thank-you/"><div class="contacts-form-grid"><label class="contacts-form__field contacts-form__field--name">{copy.name}<input name="name" type="text" autocomplete="name" placeholder={copy.namePlaceholder} required /></label><label class="contacts-form__field contacts-form__field--phone">{copy.phone}<input name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="+38" required /></label><label class="contacts-form__field contacts-form__field--city">{copy.city}<input name="city" autocomplete="address-level2" type="text" placeholder={copy.cityPlaceholder} /></label><label class="contacts-form__field contacts-form__field--need">{copy.need}<textarea name="comment" rows="5" placeholder={copy.needPlaceholder}></textarea></label></div><label class="contacts-file-field"><span>{copy.file}</span><span class="contacts-file-control"><span class="contacts-file-button">{copy.chooseFile}</span><span class="contacts-file-name" data-file-name data-empty-label={copy.noFile}>{copy.noFile}</span></span><input class="contacts-file-input" name="attachment" type="file" accept=".jpg,.jpeg,.png,.webp,.pdf,.dwg" data-file-input /></label><div class="contacts-form__footer"><label class="quote-consent"><input name="consent" value="accepted" type="checkbox" required /><span>{copy.consent} <a href={lp('/privacy-policy/')}>{copy.privacy}</a>.</span></label><button class="button button--mint" type="submit">{copy.submit}</button></div><p data-form-status hidden role="status"></p></form></section>
<section class="contacts-section contacts-calculation"><div class="contacts-section__inner"><div class="contacts-section-head"><p class="eyebrow">{copy.calcEyebrow}</p><h2>{copy.calcTitle}</h2></div><div class="contacts-editorial-list">{calculationItems.map(([number,title,text]) => <article class="contacts-editorial-item"><span class="contacts-editorial-item__number">{number}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
