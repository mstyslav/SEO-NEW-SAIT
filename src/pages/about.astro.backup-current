---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const values = [
  ['Якість','Перевірені матеріали, сертифіковане скло та надійна фурнітура.'],
  ['Професіоналізм','Досвід, технічна точність і контроль деталей на кожному етапі.'],
  ['Надійність','Плануємо строки, фіксуємо рішення та відповідаємо за результат.'],
  ['Індивідуальний підхід','Кожен проєкт адаптуємо під архітектуру, розміри й задачу.']
];

const team = [
  ['Олександр','Співвласник, співзасновник'],
  ['Мстислав','Співвласник, співзасновник'],
  ['Микола','Керівник відділу продажів'],
  ['Юлія','Контент-мейкер'],
  ['Анастасія','SMM-спеціаліст'],
  ['Євген','Майстер з монтажу'],
  ['Марія','Акаунт-менеджер'],
  ['Юлія','Організатор'],
  ['Мілана','Менеджер проєкту'],
  ['Артур','Майстер з монтажу'],
  ['Петро','Помічник майстра з монтажу'],
  ['Максим','Комірник, логіст']
];

const clients = ['CHOICE','GAGARINN PLAZA','MARISTELLA','NOFILTERS','ZDRAVO','CHERRY TWINS ODESSA'];
const systems = ['ALUPROF','SADEV','DORMA','SCHÜCO','AGC','Q-railing','SIEGENIA'];
---
<BaseLayout title="Про Space Glass — команда, історія та скляні конструкції" description="Space Glass — команда з понад 10-річним досвідом у скляних та алюмінієвих конструкціях. 5 000+ реалізованих проєктів і понад 50 000 м² скління.">
<div class="sg-page-shell">
  <Header />
  <main id="main" class="about-final">
    <section class="hero">
      <div class="hero__copy">
        <p class="kicker">Про нас</p>
        <h1>SPACE GLASS</h1>
        <p class="hero__subtitle">Скляні та алюмінієві конструкції<br/>для сучасної архітектури</p>
        <div class="hero__actions">
          <a class="btn btn--mint" href="/projects/">Переглянути проєкти →</a>
          <a class="btn btn--ghost" href="#contact">Зв’язатися з нами</a>
        </div>
      </div>
      <div class="hero__image">
        <img src="/images/v5/hero.webp" alt="Скляні та алюмінієві конструкції Space Glass у сучасному інтер’єрі" width="1200" height="800" fetchpriority="high" />
      </div>
    </section>

    <section class="facts" aria-label="Space Glass у цифрах">
      <article><span class="fact-icon">⌂</span><strong>5 000+</strong><p>реалізованих<br/>проєктів</p></article>
      <article><span class="fact-icon">㎡</span><strong>50 000+ м²</strong><p>виконаного<br/>скління</p></article>
      <article><span class="fact-icon">✺</span><strong>10+ років</strong><p>досвіду у скляних<br/>конструкціях</p></article>
      <article><span class="fact-icon">⌖</span><strong>3 міста</strong><p>Одеса · Київ · Львів</p></article>
    </section>

    <section class="story-values">
      <div class="story">
        <p class="kicker">Наша історія</p>
        <h2>Досвід, що створює майбутнє</h2>
        <p>Space Glass виросла з практичного досвіду у сфері скла та фурнітури. Із 2014 року ми розвивали технічну експертизу, формували команду, запускали власні процеси та поступово переходили від окремих виробів до комплексних скляних і алюмінієвих рішень.</p>
        <p>Сьогодні ми працюємо з приватними та комерційними об’єктами, проєктуємо, виготовляємо й монтуємо конструкції різної складності та супроводжуємо замовника від першої консультації до реалізації.</p>
        <div class="timeline">
          <article><b>2014</b><span>Початок професійного шляху у сфері скла</span></article>
          <article><b>2016</b><span>Розширення напрямів та формування команди</span></article>
          <article><b>2018</b><span>Перші великі приватні й комерційні об’єкти</span></article>
          <article><b>2020</b><span>Посилення виробничих і монтажних процесів</span></article>
          <article><b>2022+</b><span>Новий етап розвитку та масштабні проєкти</span></article>
        </div>
      </div>
      <div class="values">
        <p class="kicker">Наші цінності</p>
        {values.map(([title,text]) => <article><span>◇</span><div><h3>{title}</h3><p>{text}</p></div></article>)}
      </div>
    </section>

    <section class="team-section">
      <div class="section-head">
        <p class="kicker">Наша команда</p>
        <h2>Люди, які створюють простір</h2>
      </div>
      <div class="team-grid">
        {team.map(([name,role],i) => (
          <article class="team-card">
            <div class="team-photo"><span>{String(i+1).padStart(2,'0')}</span></div>
            <div class="team-caption"><h3>{name}</h3><p>{role}</p></div>
          </article>
        ))}
      </div>
      <a class="team-join" href="#career">Приєднуйся до команди →</a>
    </section>

    <section class="lower-grid">
      <div class="panel clients-panel">
        <p class="kicker">Нам довіряють</p>
        <h2>Компанії та проєкти, з якими ми працювали</h2>
        <div class="client-logos">
          {clients.map((name) => <div class="logo-word">{name}</div>)}
        </div>
        <a class="small-link" href="/projects/">Дивитися всі проєкти →</a>
      </div>

      <div class="panel career-panel" id="career">
        <p class="kicker">Хочу в команду</p>
        <h2>Розкажіть про себе</h2>
        <p>Залиште контакт і напрям, який вас цікавить.</p>
        <form>
          <input type="text" aria-label="Ім’я" placeholder="Ваше ім’я" />
          <input type="tel" aria-label="Телефон" placeholder="Телефон" />
          <select aria-label="Напрям роботи"><option>Напрям роботи</option><option>Монтаж</option><option>Продажі</option><option>Проєктування</option><option>Маркетинг</option><option>Інше</option></select>
          <button type="button" class="btn btn--dark">Надіслати заявку ↗</button>
        </form>
        <small>Ми зв’яжемося з вами найближчим часом.</small>
      </div>

      <div class="panel systems-panel">
        <p class="kicker">Системи та бренди</p>
        <h2>Працюємо з перевіреними рішеннями</h2>
        <div class="systems-logos">
          {systems.map((name) => <div class="logo-word logo-word--system">{name}</div>)}
        </div>
        <a class="small-link" href="/catalog/">Детальніше про системи →</a>
      </div>
    </section>

    <section class="final-cta" id="contact">
      <div class="final-cta__icon">⌂</div>
      <div><h2>Готові реалізувати ваш проєкт?</h2><p>Зв’яжіться з нами — створимо простір, який надихає.</p></div>
      <a class="btn btn--dark" href="/#quote">Обговорити проєкт →</a>
    </section>
  </main>
  <Footer />
</div>
</BaseLayout>

<style>
  .about-final{--mint:#77cbb0;--green:#0d5b46;--ink:#101413;--muted:#65706c;--line:#dce5e1;background:#fff;color:var(--ink)}
  .about-final *{box-sizing:border-box}.kicker{margin:0 0 10px;text-transform:uppercase;letter-spacing:.18em;font-size:11px;font-weight:900;color:#2d8368}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 20px;border-radius:4px;font-weight:800;text-decoration:none;border:0}.btn--mint{background:var(--mint);color:#0c201a}.btn--ghost{background:#fff;color:var(--ink);border:1px solid #cfd9d5}.btn--dark{background:var(--green);color:#fff}
  .hero{display:grid;grid-template-columns:42% 58%;min-height:420px;border-bottom:1px solid var(--line)}.hero__copy{padding:56px 5.2% 40px;display:flex;flex-direction:column;justify-content:center}.hero h1{font-size:clamp(56px,6vw,92px);line-height:.9;letter-spacing:-.05em;margin:6px 0 18px}.hero__subtitle{font-size:22px;line-height:1.3;margin:0;color:#232a27}.hero__actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:28px}.hero__image{overflow:hidden;min-height:420px}.hero__image img{width:100%;height:100%;object-fit:cover;display:block}
  .facts{display:grid;grid-template-columns:repeat(4,1fr);padding:28px 5.2%;border-bottom:1px solid var(--line)}.facts article{padding:2px 26px 2px 0;border-right:1px solid var(--line);display:grid;grid-template-columns:auto 1fr;column-gap:14px;align-items:start}.facts article:last-child{border-right:0}.fact-icon{grid-row:1/3;color:#2d8368;font-size:28px}.facts strong{font-size:clamp(29px,2.8vw,46px);line-height:1;color:#2c8a6d;letter-spacing:-.04em}.facts p{margin:8px 0 0;font-size:14px;line-height:1.35}
  .story-values{display:grid;grid-template-columns:1.35fr .65fr;gap:7%;padding:46px 5.2% 52px;border-bottom:1px solid var(--line)}.story h2,.section-head h2,.panel h2,.final-cta h2{margin:0;font-size:clamp(28px,2.6vw,44px);line-height:1.05;letter-spacing:-.035em}.story>p:not(.kicker){max-width:820px;color:#404a46;line-height:1.6}.timeline{display:grid;grid-template-columns:repeat(5,1fr);margin-top:38px;border-top:1px solid #b8d3c9}.timeline article{position:relative;padding:18px 18px 0 0}.timeline article:before{content:"";width:7px;height:7px;border-radius:50%;background:#1d745a;position:absolute;top:-4px;left:0}.timeline b{font-size:18px}.timeline span{display:block;font-size:12px;line-height:1.4;margin-top:8px;color:#46514d}.values{padding-top:4px}.values>article{display:flex;gap:14px;padding:10px 0}.values>article>span{font-size:22px;color:#2d8a6c}.values h3{margin:0 0 4px;font-size:15px}.values p{margin:0;color:#4f5b56;font-size:12px;line-height:1.4}
  .team-section{padding:32px 4.7% 20px;background:#fff;border-bottom:1px solid var(--line)}.section-head{text-align:left;margin-bottom:14px}.team-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}.team-card{min-width:0}.team-photo{aspect-ratio:4/5;background:linear-gradient(145deg,#e8e5dd,#f4f1e9);display:flex;align-items:center;justify-content:center;border:1px solid #e1e5e2;color:#a5aca9;font-size:28px;font-weight:900}.team-caption{text-align:center;padding:7px 4px 10px}.team-caption h3{font-size:12px;margin:0 0 2px}.team-caption p{font-size:10px;margin:0;color:#606a66}.team-join{display:block;width:max-content;margin:0 auto;color:#22795f;border:1px solid #85cbb5;padding:8px 16px;text-decoration:none;font-size:12px;font-weight:800}
  .lower-grid{display:grid;grid-template-columns:1fr 1.05fr 1fr;border-bottom:1px solid var(--line)}.panel{padding:34px 5vw;min-height:300px}.panel h2{font-size:23px;margin-bottom:20px}.clients-panel,.systems-panel{background:#fff}.career-panel{background:linear-gradient(120deg,#f4fbf8,#eef8f4)}.client-logos{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1px solid var(--line);border-left:1px solid var(--line)}.systems-logos{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.logo-word{min-height:62px;display:flex;align-items:center;justify-content:center;text-align:center;padding:8px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);font-weight:800;font-size:13px;color:#6f7774;letter-spacing:.035em}.logo-word--system{font-size:15px;color:#333b38}.small-link{display:inline-block;margin-top:14px;border:1px solid #79bba6;padding:9px 14px;color:#176b53;text-decoration:none;font-size:12px;font-weight:800}.career-panel>p:not(.kicker){margin:6px 0 18px;color:#5f6c67}.career-panel form{display:grid;grid-template-columns:1fr 1fr;gap:10px}.career-panel input,.career-panel select{height:42px;border:1px solid #ccd8d3;border-radius:4px;background:#fff;padding:0 12px;color:#2a302e}.career-panel button{min-height:42px}.career-panel small{display:block;margin-top:12px;color:#58645f}
  .final-cta{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:24px;padding:22px 17%;background:linear-gradient(90deg,#f7fbf9,#fff)}.final-cta__icon{width:58px;height:58px;border-radius:50%;background:#d9f0e8;display:flex;align-items:center;justify-content:center;color:#2d8066;font-size:26px}.final-cta h2{font-size:27px}.final-cta p{margin:4px 0 0;color:#4d5954}
  @media(max-width:1100px){.hero{grid-template-columns:1fr}.hero__image{min-height:360px}.facts{grid-template-columns:1fr 1fr}.story-values{grid-template-columns:1fr}.team-grid{grid-template-columns:repeat(3,1fr)}.lower-grid{grid-template-columns:1fr}.timeline{grid-template-columns:repeat(3,1fr)}.final-cta{padding:28px 6%}}
  @media(max-width:680px){.hero__copy{padding:46px 22px 34px}.hero h1{font-size:54px}.facts{grid-template-columns:1fr;padding:22px}.facts article{border-right:0;border-bottom:1px solid var(--line);padding:16px 0}.story-values{padding:44px 22px}.timeline{grid-template-columns:1fr}.team-grid{grid-template-columns:repeat(2,1fr)}.panel{padding:32px 22px}.career-panel form{grid-template-columns:1fr}.final-cta{grid-template-columns:1fr;padding:30px 22px}.final-cta__icon{display:none}}
</style>