---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { seoPages } from '../../data/seo-pages';
const pages = seoPages.filter((page) => page.kind === 'service');
---
<BaseLayout title="Скляні та алюмінієві рішення | Space Glass" description="Каталог індивідуальних скляних та алюмінієвих рішень Space Glass: душові, перегородки, огорожі, фасади, двері, тераси та дзеркала.">
  <Header />
  <main id="main" class="hub">
    <p class="eyebrow">Space Glass</p>
    <h1>Скляні та алюмінієві рішення</h1>
    <p class="lead">Оберіть напрямок, перегляньте варіанти виконання та надішліть дані для попереднього розрахунку.</p>
    <div class="grid">{pages.map((page, index) => <a href={`/${page.slug}/`}><span>{String(index + 1).padStart(2,'0')}</span><h2>{page.h1}</h2><p>{page.description}</p><b>Детальніше →</b></a>)}</div>
  </main>
  <Footer />
</BaseLayout>
<style>.hub{padding:70px clamp(22px,5vw,80px)}h1{font-size:clamp(44px,7vw,92px);max-width:1000px;line-height:.98}.lead{font-size:21px;max-width:760px;line-height:1.6}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:55px}.grid a{min-height:280px;padding:28px;border:1px solid #d9e7df;border-radius:18px;color:inherit;text-decoration:none}.grid span{color:#16875f;font-size:12px}.grid h2{margin-top:50px}.grid p{line-height:1.6}@media(max-width:900px){.grid{grid-template-columns:1fr 1fr}}@media(max-width:560px){.grid{grid-template-columns:1fr}}</style>
