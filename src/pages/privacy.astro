---
import LegalStructuredPage from '../components/LegalStructuredPage.astro';
import { localeFromPath, normalizeLocale, localizedPath } from '../i18n/helpers';
const locale = normalizeLocale(Astro.props.locale ?? localeFromPath(Astro.url.pathname));
const isRussian = locale === 'ru';
const title = isRussian ? 'Политика конфиденциальности' : 'Політика конфіденційності';
const description = isRussian ? 'Как Space Glass обрабатывает персональные данные: формы, обращения, cookies, права пользователей и сроки хранения.' : 'Як Space Glass обробляє персональні дані: форми, звернення, cookies, права користувачів і строки зберігання.';
const sections = isRussian ? [
  ['1. Кто обрабатывает данные', 'Space Glass обрабатывает данные, которые вы добровольно передаёте через сайт https://space-glass.com.ua/: имя, телефон, email, город, описание проекта, файлы и сообщения. Сайт также может получать технические данные браузера, устройства, IP-адрес и сведения о действиях, необходимые для работы и безопасности.'],
  ['2. Цели и основания обработки', 'Данные используются для ответа на обращения, подготовки расчёта, оформления и исполнения заказа, сервисной поддержки, коммуникации, обеспечения безопасности сайта и улучшения сервиса. В зависимости от ситуации основанием может быть ваш запрос или согласие, заключение и исполнение договора, законная обязанность либо обоснованный интерес в безопасной работе сервиса.'],
  ['3. Формы и коммуникация', 'Отправляя форму, вы разрешаете использовать указанные контакты для связи по вашему запросу. Не передавайте через формы пароли, полные платёжные реквизиты или избыточные чувствительные данные.'],
  ['4. Cookies', 'Сайт использует необходимые cookies и может использовать необязательные cookies только после согласия там, где это технически поддерживается. Подробнее — в Политике использования Cookie.'],
  ['5. Получатели данных', 'Доступ могут получать уполномоченные сотрудники Space Glass и поставщики, фактически привлекаемые для хостинга, почты, связи, CRM или аналитики. Конкретный поставщик или инструмент применяется только если он действительно подключён; эта политика не утверждает использование неподтверждённых сервисов. Данные передаются лишь в объёме, необходимом для соответствующей функции или требования закона.'],
  ['6. Срок хранения и безопасность', 'Данные хранятся не дольше, чем требуется для цели обработки, исполнения договорённостей, гарантийной поддержки и применимых обязанностей учёта или защиты прав. Фактический срок зависит от вида данных и обращения. Space Glass применяет соразмерные организационные и технические меры, но ни один способ передачи данных не гарантирует абсолютной безопасности.'],
  ['7. Ваши права', 'В пределах применимого законодательства вы можете запросить доступ, исправление или удаление данных, ограничение обработки, возразить против неё, получить данные в переносимом формате либо отозвать согласие. Для обращения напишите на info@space-glass.com.ua. Перед исполнением запроса может потребоваться разумная проверка личности.']
] : [
  ['1. Хто обробляє дані', 'Space Glass обробляє дані, які ви добровільно передаєте через сайт https://space-glass.com.ua/: ім’я, телефон, email, місто, опис проєкту, файли та повідомлення. Сайт також може отримувати технічні дані браузера, пристрою, IP-адресу й відомості про дії, необхідні для роботи та безпеки.'],
  ['2. Цілі та підстави обробки', 'Дані використовуються для відповіді на звернення, підготовки розрахунку, оформлення й виконання замовлення, сервісної підтримки, комунікації, безпеки сайту та покращення сервісу. Залежно від ситуації підставою може бути ваш запит або згода, укладення й виконання договору, законний обов’язок або обґрунтований інтерес у безпечній роботі сервісу.'],
  ['3. Форми та комунікація', 'Надсилаючи форму, ви дозволяєте використовувати зазначені контакти для зв’язку щодо запиту. Не передавайте через форми паролі, повні платіжні реквізити або надлишкові чутливі дані.'],
  ['4. Cookies', 'Сайт використовує необхідні cookies і може використовувати необов’язкові cookies лише після згоди там, де це технічно підтримується. Докладніше — у Політиці використання Cookie.'],
  ['5. Одержувачі даних', 'Доступ можуть отримувати уповноважені працівники Space Glass і постачальники, фактично залучені для хостингу, пошти, зв’язку, CRM або аналітики. Конкретний постачальник чи інструмент застосовується лише якщо він дійсно підключений; ця політика не стверджує використання непідтверджених сервісів. Дані передаються лише в обсязі, потрібному для відповідної функції або вимоги закону.'],
  ['6. Строк зберігання та безпека', 'Дані зберігаються не довше, ніж потрібно для мети обробки, виконання домовленостей, гарантійної підтримки та застосовних обов’язків обліку або захисту прав. Фактичний строк залежить від виду даних і звернення. Space Glass застосовує співмірні організаційні й технічні заходи, але жоден спосіб передавання даних не гарантує абсолютної безпеки.'],
  ['7. Ваші права', 'У межах застосовного законодавства ви можете запросити доступ, виправлення або видалення даних, обмеження обробки, заперечити проти неї, отримати дані у переносимому форматі або відкликати згоду. Для звернення напишіть на info@space-glass.com.ua. Перед виконанням запиту може знадобитися розумна перевірка особи.']
];
const toc = sections.map(([label], index) => ({ id: `section-${index + 1}`, label }));
---
<LegalStructuredPage locale={locale} title={title} description={description} toc={toc} updated={isRussian ? '4 августа 2026' : '4 серпня 2026'}>
  {sections.map(([heading, text], index) => (
    <section id={toc[index].id}>
      <h2>{heading}</h2>
      <p>{text}</p>
      {index === 3 && <p><a href={localizedPath('/cookies/', locale)}>{isRussian ? 'Открыть Политику использования Cookie' : 'Відкрити Політику використання Cookie'}</a>.</p>}
    </section>
  ))}
</LegalStructuredPage>
