---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQBlock from '../../components/FAQBlock.astro';
import '../../styles/category-pages.css';
const faq = [["Що входить до архітектурних систем?", "Безрамне скління, фасади, Loft-системи, профільні рішення, фурнітура та спеціальні скляні конструкції."], ["Чи працюєте ви з архітекторами?", "Так, надаємо технічні консультації, креслення, специфікації та супровід проєкту."], ["Чи можна отримати DWG або PDF вузлів?", "Так, для частини систем можемо підготувати або надати технічні матеріали."], ["Чи виконуєте фасадне скління?", "Так, реалізуємо структурне, напівструктурне, накладне та інші типи фасадного скління."], ["Чи можливі індивідуальні профілі?", "Можливість залежить від системи, обсягу та технічного завдання."], ["Яке скло використовується?", "Загартоване скло, триплекс, склопакети та спеціальні види скла залежно від конструкції."], ["Чи робите безрамне скління?", "Так, для терас, балконів, офісів, альтанок та інших просторів."], ["Чи працюєте з великими об’єктами?", "Так, виконуємо комерційні й девелоперські проєкти."], ["Чи є монтаж у регіонах?", "Монтаж доступний у ключових містах, а логістика — по Україні."], ["Чи можна замовити лише постачання?", "Так, окремі системи та комплектуючі можна замовити без монтажу."], ["Чи є гарантія?", "Так, гарантія залежить від типу системи, матеріалів і формату робіт."], ["Як формується ціна?", "За площею, системою, склом, профілем, фурнітурою, монтажем та логістикою."], ["Чи можна інтегрувати автоматику?", "Так, для окремих дверних і розсувних систем."], ["Чи можливе енергозберігаюче скління?", "Так, підбираємо склопакети та покриття відповідно до вимог."], ["Чи готуєте специфікацію?", "Так, для погоджених систем формуємо перелік матеріалів і комплектуючих."], ["Чи працюєте з алюмінієвими системами?", "Так, виконуємо вікна, двері, фасади, зимові сади та розсувні рішення."], ["Чи можна зробити чорний Loft?", "Так, чорний профіль є одним із найпопулярніших варіантів."], ["Чи є протипожежні рішення?", "Можливість залежить від сертифікованої системи та вимог проєкту."], ["Що потрібно для прорахунку?", "Креслення, фасади, розрізи, розміри та короткий опис вимог."], ["Чи супроводжуєте погодження?", "Так, у межах нашої компетенції надаємо технічний супровід та документацію."]];
const systems = ['Безрамне скління','Loft-системи','Скляні фасади','Профільні системи','Скляні огорожі','Скляні двері','Скло та матеріали','Фурнітура та аксесуари'];
---
<BaseLayout title="Архітектурні системи — Space Glass" description="Архітектурні скляні та алюмінієві системи для приватних і комерційних об’єктів.">
<div class="sg-page-shell"><Header/><main id="main">
<section class="category-hero"><div class="category-hero__copy"><p class="eyebrow">Архітектурні системи</p><h1>Скляні та алюмінієві системи для складних проєктів</h1><p class="lead">Безрамне скління, фасади, Loft-системи, профілі, фурнітура та спеціальні рішення.</p><a class="button button--mint" href="#architecture-request">Отримати розрахунок</a></div><div class="category-hero__visual"><span>SPACE GLASS</span></div></section>
<section class="category-section"><div class="category-heading"><div><p class="eyebrow">Системи</p><h2>Оберіть напрям</h2></div></div><div class="category-type-grid">{systems.map((item,i)=><a class="category-type-card" href="#"><div class="category-type-card__visual"><span>{String(i+1).padStart(2,'0')}</span></div><div class="category-type-card__body"><h3>{item}</h3><p>Підбір системи за архітектурою, навантаженням і бюджетом.</p><b>Детальніше →</b></div></a>)}</div></section>
<section class="category-section category-section--faq"><FAQBlock title="FAQ про архітектурні системи" intro="20 відповідей про скління, фасади, профілі, креслення, монтаж і гарантію." items={faq} visibleCount={6} /></section>
<section id="architecture-request" class="inner-cta"><div><p class="eyebrow">Проєкт</p><h2>Надішліть креслення або технічне завдання</h2><p>Підготуємо попередню конфігурацію та оцінку.</p></div><a class="button button--white" href="/contacts/">Надіслати запит</a></section>
</main><Footer/></div></BaseLayout>
