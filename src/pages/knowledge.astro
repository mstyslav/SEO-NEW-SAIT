---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/knowledge.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { knowledgeArticles, knowledgeCategories } from '../data/knowledge-articles';
---
<BaseLayout
  title="База знань про скляні конструкції | Space Glass"
  description="Практичні матеріали Space Glass про вибір скла, душових, перегородок, дверей, дзеркал, огорож, замір, монтаж, вартість і догляд."
  schemaType="CollectionPage"
  alternateLocales={['uk']}
>
  <div class="sg-page-shell">
    <Header />
    <main id="main">
      <section class="knowledge-v14-hero">
        <div>
          <p class="eyebrow">Практичні поради Space Glass</p>
          <h1>База знань про скляні конструкції</h1>
          <p class="lead">Допомагаємо розібратися у матеріалах, конструкціях, замірі, монтажі та догляді до замовлення.</p>
        </div>
        <div class="knowledge-v14-brand" aria-hidden="true"><span>SPACE GLASS</span></div>
      </section>

      <nav class="knowledge-filters" aria-label="Фільтр матеріалів">
        <button class="is-active" type="button" data-knowledge-filter="all">Усі матеріали</button>
        {knowledgeCategories.map((category) => <button type="button" data-knowledge-filter={category}>{category}</button>)}
      </nav>

      <section class="knowledge-library" aria-labelledby="knowledge-library-title">
        <div class="category-heading">
          <div><p class="eyebrow" data-knowledge-count>{knowledgeArticles.length} експертних матеріалів</p><h2 id="knowledge-library-title">Від вибору до експлуатації</h2></div>
        </div>
        <div class="knowledge-library__grid" data-knowledge-grid>
          {knowledgeArticles.map((item, index) => (
            <article class="knowledge-card" data-category={item.category}>
              <div class="knowledge-card__meta"><span>{String(index + 1).padStart(2, '0')}</span><span>{item.category}</span><span>{item.readingTime} хв</span></div>
              <h2><a href={`/knowledge/${item.slug}/`}>{item.title}</a></h2>
              <p>{item.description}</p>
              <a class="knowledge-card__link" href={`/knowledge/${item.slug}/`}>Читати матеріал →</a>
            </article>
          ))}
        </div>
        <p class="knowledge-empty" data-knowledge-empty hidden>За цим запитом матеріалів не знайдено. Спробуйте коротше формулювання.</p>
      </section>

      <section class="inner-cta">
        <div><p class="eyebrow eyebrow--light">Потрібна порада для вашого об’єкта?</p><h2>Покажіть фото або креслення</h2><p>Менеджер уточнить завдання і підкаже, які дані потрібні для попереднього розрахунку.</p></div>
        <a class="button button--white" href="/quote/">Поставити запитання</a>
      </section>
    </main>
    <Footer />
  </div>

  <script>
    const cards = [...document.querySelectorAll<HTMLElement>('.knowledge-card')];
    const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-knowledge-filter]')];
    const empty = document.querySelector<HTMLElement>('[data-knowledge-empty]');
    const count = document.querySelector<HTMLElement>('[data-knowledge-count]');
    let category = 'all';
    const countLabel = (value: number) => {
      const mod10 = value % 10;
      const mod100 = value % 100;
      if (mod10 === 1 && mod100 !== 11) return `${value} експертний матеріал`;
      if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return `${value} експертні матеріали`;
      return `${value} експертних матеріалів`;
    };
    const update = () => {
      let visible = 0;
      cards.forEach((card) => {
        const matchesCategory = category === 'all' || card.dataset.category === category;
        card.hidden = !matchesCategory;
        if (!card.hidden) visible += 1;
      });
      if (empty) empty.hidden = visible > 0;
      if (count) count.textContent = countLabel(visible);
    };
    filters.forEach((button) => button.addEventListener('click', () => {
      category = button.dataset.knowledgeFilter ?? 'all';
      filters.forEach((item) => item.classList.toggle('is-active', item === button));
      update();
    }));
  </script>
</BaseLayout>

<style>
  .knowledge-v14-hero {
    gap:0;
    padding:0;
    align-items:stretch;
  }
  .knowledge-card { cursor:pointer; }
  .knowledge-card__link:focus-visible { outline:2px solid var(--mint-dark); outline-offset:3px; }
  @media(min-width:1100px) {
    .knowledge-filters { flex-wrap:nowrap; gap:7px; padding-inline:28px; }
    .knowledge-filters button { min-width:0; padding:10px 12px; font-size:clamp(10px,.78vw,13px); white-space:nowrap; }
  }
  .knowledge-v14-hero > div:first-child {
    display:flex;
    min-height:520px;
    padding:70px 58px;
    flex-direction:column;
    justify-content:center;
  }
  .knowledge-v14-brand {
    position:relative;
    display:flex;
    min-height:520px;
    align-items:flex-end;
    justify-content:flex-end;
    padding:38px 44px;
    overflow:hidden;
    border-left:1px solid var(--line);
    background:linear-gradient(135deg,#fff,#eefaf5);
  }
  .knowledge-v14-brand::before,
  .knowledge-v14-brand::after {
    content:"";
    position:absolute;
    border:2px solid rgba(88,190,157,.65);
    transform:rotate(35deg);
  }
  .knowledge-v14-brand::before {
    width:310px;
    height:500px;
    top:4px;
    right:56px;
  }
  .knowledge-v14-brand::after {
    width:155px;
    height:270px;
    top:135px;
    right:190px;
  }
  .knowledge-v14-brand span {
    position:relative;
    z-index:1;
    color:var(--mint-dark);
    font-size:clamp(2.25rem,4vw,4rem);
    font-weight:900;
    letter-spacing:-.035em;
    white-space:nowrap;
  }
  @media(max-width:900px) {
    .knowledge-v14-hero > div:first-child { min-height:0; padding:58px 40px; }
    .knowledge-v14-brand { min-height:340px; border-top:1px solid var(--line); border-left:0; }
    .knowledge-v14-brand::before { width:240px; height:390px; right:46px; }
    .knowledge-v14-brand::after { width:120px; height:210px; top:92px; right:150px; }
  }
  @media(max-width:640px) {
    .knowledge-v14-hero > div:first-child { padding:44px 24px; }
    .knowledge-v14-brand { min-height:280px; padding:26px; }
    .knowledge-v14-brand::before { right:-16px; }
    .knowledge-v14-brand::after { right:86px; }
    .knowledge-v14-brand span { font-size:2rem; }
  }
</style>
