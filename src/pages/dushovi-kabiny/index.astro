---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQBlock from '../../components/FAQBlock.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TrustBar from '../../components/TrustBar.astro';
import PriceBlock from '../../components/PriceBlock.astro';
import ProjectCard from '../../components/projects/ProjectCard.astro';
import '../../styles/category-pages.css';
import '../../styles/projects-common.css';
import '../../styles/shower-master.css';

const title = "Скляні душові кабіни";
const h1 = "Скляні душові кабіни на замовлення";
const subtitle = "Душові кабіни зі скла за індивідуальними розмірами: перегородки Walk-In, кутові, у нішу, розсувні, складні системи, душові двері, піддони та шторки на ванну.";

const iconWrap = (p: string) =>
  `<svg viewBox="0 0 40 40" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${p}</svg>`;
const icons = {
  screen: iconWrap('<path d="M6 34h28"/><path d="M9 34V7"/><rect x="9" y="7" width="17" height="27"/>'),
  corner: iconWrap('<path d="M5 34h30"/><path d="M7 34V13l13-4v25"/><path d="M20 9l13 4v21"/><path d="M27 13v20"/><path d="M24.5 22h.01"/>'),
  niche: iconWrap('<path d="M6 6v30M34 6v30"/><path d="M6 34h28"/><rect x="12" y="9" width="16" height="25"/><path d="M20 9v25"/><path d="M17.5 21h.01"/>'),
  sliding: iconWrap('<path d="M5 9h30"/><path d="M6 34h28"/><rect x="8" y="11" width="15" height="23"/><rect x="18" y="11" width="15" height="23"/><path d="M25 22h4"/>'),
  door: iconWrap('<path d="M8 34h24"/><path d="M12 34V8h16v26"/><path d="M12 8v26"/><path d="M24.5 21h.01"/>'),
  fold: iconWrap('<path d="M5 34h30M7 8h26"/><path d="M9 10l7 24 7-24 8 24"/><circle cx="16" cy="34" r="1"/><circle cx="31" cy="34" r="1"/>'),
  tray: iconWrap('<path d="M6 24h28l-3 9H9z"/><path d="M10 20h20"/><path d="M14 16h12"/><path d="M19 28h2"/>'),
  bath: iconWrap('<path d="M5 22h30v4a5 5 0 0 1-5 5H10a5 5 0 0 1-5-5z"/><path d="M8 22v-4a3 3 0 0 1 3-3h2"/><rect x="20" y="7" width="12" height="15"/>')
};

const items = [
  { title: "Скляні перегородки для душу", note: "Стаціонарні Walk-In перегородки без дверей — мінімалістичне рішення під фактичні розміри душової зони.", href: "/dushovi-kabiny/peregorodka-dlya-dusha/", icon: icons.screen },
  { title: "Скляні душові двері", note: "Окремий дверний блок у нішу або між стіною та стаціонарним склом — розпашний чи розсувний.", href: "/dushovi-kabiny/dushovi-dveri/", icon: icons.door },
  { title: "Скляні кутові душові кабіни", note: "Дві скляні площини формують душову в куті кімнати з індивідуально підібраним входом.", href: "/dushovi-kabiny/kutovi/", icon: icons.corner },
  { title: "Розсувні душові кабіни", note: "Стулки рухаються вздовж напрямної та не потребують місця перед душовою для відкривання.", href: "/dushovi-kabiny/rozsuvni/", icon: icons.sliding },
  { title: "Душові кабіни в нішу", note: "Скляні двері або двері з нерухомою частиною для готового отвору між трьома стінами.", href: "/dushovi-kabiny/u-nishu/", icon: icons.niche },
  { title: "Складні душові кабіни", note: "Двері гармошка для компактних душових, ніш і ванн — коли розпашна стулка займає забагато місця.", href: "/dushovi-kabiny/skladni/", icon: icons.fold },
  { title: "Душові піддони", note: "Підбір піддона за розміром і формою з урахуванням майбутньої скляної конструкції та водовідведення.", href: "/dushovi-kabiny/dushovi-piddony/", icon: icons.tray },
  { title: "Скляні шторки на ванну", note: "Стаціонарні, розпашні або складні скляні екрани на ванну замість текстильної шторки.", href: "/dushovi-kabiny/shtorky-dlia-vanny/", icon: icons.bath }
];

const priceFactors: [string, string][] = [
  ["Розміри", "Ширина, висота та площа скла"],
  ["Тип і скло", "Конструкція, товщина, колір і обробка"],
  ["Фурнітура", "Петлі, профіль, ручки, система відкривання"],
  ["Монтаж", "Складність встановлення та умови об'єкта"]
];

const hardwareParts = [
  ["Петлі", "Тримають полотно, задають кут і плавність відкривання дверей."],
  ["Стабілізуючі штанги", "З'єднують скло зі стіною або стелею й фіксують геометрію широких і високих полотен."],
  ["Ручки", "Підбираються під тип дверей, вагу скла та дизайн конструкції; доступні різні форми й фініші залежно від системи."],
  ["Профілі та кріплення", "Пристінні профілі, затискачі й кутові з'єднання скла до стін."],
  ["Ущільнювачі та магнітні притвори", "Зменшують вихід води й закривають зазори по контуру дверей."],
  ["Направляюча та ролики", "Застосовуються у розсувних системах і відповідають за плавний рух полотна та стабільність конструкції."]
];

const hardwareDetails = [
  { label: "Петлі", src: "/images/catalog/dushovi-kabiny/hardware/petli-new.webp", alt: "Хромована петля на скляних дверях душової кабіни крупним планом" },
  { label: "Стабілізуюча штанга", src: "/images/catalog/dushovi-kabiny/hardware/stabilizator-new.webp", alt: "Стабілізуюча штанга душової конструкції зі скла крупним планом" },
  { label: "Ручки", src: "/images/catalog/dushovi-kabiny/hardware/ruchky.webp", alt: "Хромована ручка на скляних дверях душової кабіни крупним планом" },
  { label: "Направляюча та ролики", src: "/images/projects/sliding-shower-doors-kyiv/sliding-shower-doors-kyiv-detail-02.webp", alt: "Роликові каретки розсувних душових дверей крупним планом на верхній хромованій рейці" }
];

const glassOptions = [
  { name: "Прозоре", note: "Максимум світла, візуально не зменшує ванну", cls: "sw-glass-clear" },
  { name: "Освітлене (Extra Clear)", note: "Без зеленого відтінку торця, чистіша передача кольору", cls: "sw-glass-extra" },
  { name: "Матове (Satin)", note: "Розсіює світло, додає приватності, менш помітні патьоки", cls: "sw-glass-satin" },
  { name: "Графіт", note: "Сірий тон, приглушує відображення, глибший вигляд", cls: "sw-glass-graphite" },
  { name: "Бронза", note: "Теплий відтінок, поєднується з латунню та деревом", cls: "sw-glass-bronze" },
  { name: "Рифлене / декоративне", note: "Фактура й часткова приватність зі збереженням світла", cls: "sw-glass-fluted" }
];

const hardwareFinishes = [
  { name: "Хром", cls: "sw-hw-chrome" },
  { name: "Чорний", cls: "sw-hw-black" },
  { name: "Матова сталь", cls: "sw-hw-steel" },
  { name: "Золото", cls: "sw-hw-gold" },
  { name: "Латунь", cls: "sw-hw-brass" },
  { name: "Бронза", cls: "sw-hw-bronze" }
];

const trayCards = [
  {
    name: "З піддоном",
    text: "Готовий піддон спрощує організацію зливу та гідроізоляцію. Його розмір і геометрію бажано узгодити зі скляною конструкцією до фінального заміру.",
    href: "/dushovi-kabiny/dushovi-piddony/",
    linkLabel: "Переглянути душові піддони →"
  },
  {
    name: "Без піддона",
    text: "Душ урівень з підлогою: плитка по стяжці з ухилом до точкового трапа або лінійного водовідведення. Такий варіант вимагає підготовленої основи з правильною гідроізоляцією."
  }
];

const prepSteps = [
  ["Фото", "Кілька знімків душової зони загалом і місць майбутнього кріплення."],
  ["Орієнтовні розміри", "Ширина, висота та глибина зони — навіть приблизні цифри допомагають з оцінкою."],
  ["Тип конструкції", "Перегородка, двері, кутова, у нішу, розсувна, складна, піддон або шторка на ванну."],
  ["Стан душової зони", "Чи завершене чистове оздоблення, де злив і чи є ухил підлоги."]
];

const relatedLinks = [
  ["Душові піддони", "/dushovi-kabiny/dushovi-piddony/"],
  ["Складні душові двері", "/dushovi-kabiny/skladni/"],
  ["Як обрати душову кабіну", "/knowledge/yak-obraty-dushovu-kabinu/"],
  ["Walk-in: переваги й недоліки", "/knowledge/walk-in-perevahy-nedoliky/"],
  ["Душова в нішу: замір", "/knowledge/dushova-v-nishu-zamir/"],
  ["Розпашні чи розсувні двері", "/knowledge/rozpashni-chy-rozsuvni-sklyani-dveri/"],
  ["Товщина скла: 8, 10, 12 мм", "/knowledge/tovshchyna-skla-8-10-12-mm/"],
  ["Фурнітура для душової", "/knowledge/furnitura-dlya-dushovoyi/"]
];

const showerProjects = (await getCollection('projects', ({ data }) =>
  data.status === 'published' && data.locale === 'uk' && data.category === 'showers'))
  .map(({ data }) => data)
  .sort((a, b) => a.sortOrder - b.sortOrder)
  .slice(0, 6);

const faq = [
  ["Скільки коштує скляна душова кабіна на замовлення?", "Вартість залежить від розмірів, типу конструкції, скла, фурнітури та монтажу. Стартовий орієнтир для базової перегородки наведено в блоці «Вартість душових конструкцій»; кутові, розсувні, складні та нішеві системи розраховуються індивідуально після заміру й погодження креслення."],
  ["Чи можна дізнатися приблизну ціну до заміру?", "Так. Попередній орієнтир дамо за фото, приблизними розмірами та типом конструкції. Точну суму фіксуємо після заміру й погодження креслення, скла та комплектації."],
  ["Чи можна виготовити душову зі скла за індивідуальними розмірами?", "Так. Більшість конструкцій проєктуємо під фактичний отвір, нішу або кут конкретної ванної кімнати після заміру або перевірки наданих розмірів."],
  ["Яку товщину скла обрати — 8 чи 10 мм?", "Для більшості стаціонарних перегородок базове рішення — 8 мм; для збільшених габаритів або окремих вузлів може бути рекомендовано 10 мм. Це не універсальне правило — товщину підтверджують за розрахунком."],
  ["Наскільки безпечне загартоване скло?", "Загартоване скло міцніше за звичайне і при пошкодженні розсипається на дрібні негострі фрагменти. За запитом доступний додатковий heat-soak тест."],
  ["Що таке Walk-In та скляна перегородка для душу?", "Це стаціонарна скляна перегородка без дверей. Підходить для просторих ванних і відкритого входу в душ; для компактних приміщень частіше беруть кутові або конструкції у нішу з дверима."],
  ["Коли підходить кутова душова кабіна?", "Коли душ розташований у куті кімнати. Вхід організовують розпашними або розсувними дверима між двома скляними боками."],
  ["Чим особлива душова в нішу?", "Готова ніша між трьох стін закривається однією площиною скла з дверима або дверима з нерухомою секцією."],
  ["Розсувні чи розпашні двері — що обрати?", "Розпашні простіші за конструкцією, але потребують місця на відкривання. Розсувні рухаються вздовж напрямної і не займають простір перед душем."],
  ["Коли варто обрати складні душові двері гармошка?", "Коли потрібно максимально звільнити прохід і перед душовою мало місця для розпашної стулки. Складні системи використовують у душових зонах, нішах і для окремих шторок на ванну."],
  ["Чи можна встановити душ на піддон?", "Так. Конструкцію адаптуємо під готовий піддон; його геометрію бажано визначити до фінального заміру скла."],
  ["Чи можна зробити душ без піддона, урівень з підлогою?", "Так, зі стяжкою з ухилом до точкового трапа або лінійного водовідведення. Такий варіант вимагає підготовленої основи з гідроізоляцією."],
  ["Які варіанти скла доступні?", "Прозоре, освітлене (Extra Clear), матове (Satin), графітове, бронзове тоноване та рифлене/декоративне. Доступність конкретного відтінку підтверджуємо перед виробництвом."],
  ["Чим відрізняється матове й тоноване скло?", "Матове (Satin) розсіює світло й приховує силуети, залишаючись нейтральним за кольором. Тоноване додає відтінок і змінює сприйняття інтер'єру."],
  ["Які кольори фурнітури доступні?", "Базово — хром, чорний і брашована сталь. Інші фініші доступні для окремих систем, де відповідне покриття передбачене виробником."],
  ["Коли робити замір?", "Фінальний замір виконують після завершення чистових поверхонь, які формують отвір, нішу або кут, і коли відомі розташування зливу та точки кріплення."],
  ["Скільки триває виготовлення?", "Термін залежить від типу конструкції, обробки скла, фурнітури та завантаження виробництва і фіксується після погодження креслення й комплектації."],
  ["Чи входить монтаж у вартість?", "Монтаж і доставка розраховуються окремо та вказуються в пропозиції. Основні міста монтажу — Київ, Львів та Одеса з областями."],
  ["Як доглядати за скляною душовою?", "Використовуйте неабразивні засоби, після душу видаляйте воду зі скла, періодично оглядайте ущільнювачі та петлі."],
  ["Чи працюєте в Києві, Одесі та Львові?", "Замір і монтаж виконуємо у Києві, Львові та Одесі з областями. Умови доставки готових виробів залежать від міста, габаритів і доступу до об'єкта."]
];
---
<BaseLayout title={`${h1} | Space Glass`} description={subtitle}>
<div class="sg-page-shell">
  <Header />
  <main id="main">
    <section class="category-hero category-hero--photo">
      <div class="category-hero__copy">
        <Breadcrumbs items={[{ label: 'Головна', href: '/' }, { label: title }]} />
        <p class="eyebrow">{title}</p>
        <h1>{h1}</h1>
        <p class="lead">Виготовляємо скляні душові кабіни та душові конструкції зі скла за індивідуальними розмірами. Проєктуємо перегородки Walk-In, душові двері, кутові й нішеві кабіни, розсувні та складні системи; підбираємо скло, фурнітуру, виконуємо замір, виготовлення та монтаж.</p>
        <div class="hero__actions">
          <a class="button button--mint" href="#price">Отримати розрахунок</a>
          <a class="button button--outline" href="#types">Переглянути 8 напрямів</a>
        </div>
      </div>
      <figure class="category-hero__figure">
        <div class="category-hero__frame">
          <img
            src="/images/catalog/dushovi-kabiny/dushovi-kabiny-1200.webp"
            srcset="/images/catalog/dushovi-kabiny/dushovi-kabiny-480.webp 480w, /images/catalog/dushovi-kabiny/dushovi-kabiny-768.webp 768w, /images/catalog/dushovi-kabiny/dushovi-kabiny-1200.webp 1200w, /images/catalog/dushovi-kabiny/dushovi-kabiny-1600.webp 1600w"
            sizes="(max-width: 900px) calc(100vw - 48px), 52vw"
            alt="Скляна душова кабіна на замовлення за індивідуальними розмірами"
            width="1600"
            height="1200"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </figure>
    </section>

    <TrustBar locale="uk" />

    <section class="category-section category-section--mint">
      <div class="category-heading"><div><p class="eyebrow">Індивідуальне виготовлення</p><h2>Душові кабіни зі скла під ваш простір</h2></div></div>
      <div class="category-intro-grid">
        <div class="category-prose">
          <p>Ми виготовляємо не стандартні готові бокси, а скляні душові конструкції під конкретне приміщення. Фактична геометрія ванної кімнати, ніша, кут, піддон або підготовлена підлога визначають розміри скла та схему відкривання.</p>
          <p>Робота йде повним циклом: замір, проєктування та узгодження креслення, виготовлення скла й комплектація фурнітурою, доставка та монтаж. До запуску у виробництво погоджуємо тип конструкції, скло, фурнітуру та спосіб відкривання.</p>
        </div>
        <ul class="category-intro__spec">
          <li><b>Індивідуальні розміри</b><span>під фактичний отвір, нішу або кут</span></li>
          <li><b>Загартоване скло</b><span>тип і товщину визначаємо за конструкцією</span></li>
          <li><b>8 окремих напрямів</b><span>від Walk-In до складних систем і піддонів</span></li>
          <li><b>Київ · Одеса · Львів</b><span>замір і монтаж у ключових регіонах</span></li>
        </ul>
      </div>
    </section>

    <section id="types" class="category-section">
      <div class="category-heading"><div><p class="eyebrow">Види</p><h2>Види скляних душових конструкцій</h2></div><p>Оберіть сценарій — далі уточнимо розміри, скло, фурнітуру, спосіб відкривання та монтаж.</p></div>
      <div class="category-icon-grid category-icon-grid--showers">
        {items.map((item)=>(
          <a class="category-icon-card" href={item.href}>
            <span class="category-icon-card__icon" set:html={item.icon} />
            <h3>{item.title}</h3>
            <p>{item.note}</p>
            <b aria-hidden="true">→</b>
          </a>
        ))}
      </div>
    </section>

    <section class="category-section category-section--mint">
      <div class="category-heading"><div><p class="eyebrow">Матеріали</p><h2>Скло та фурнітура</h2></div><p>Тип скла та фініш фурнітури підбираємо під інтер'єр, конструкцію і сценарій використання.</p></div>

      <div class="material-subblock">
        <h3>Варіанти скла</h3>
        <div class="swatch-grid swatch-grid--glass">
          {glassOptions.map((g)=>(
            <figure class="swatch">
              <span class={`swatch__panel ${g.cls}`} aria-hidden="true"></span>
              <figcaption><b>{g.name}</b><small>{g.note}</small></figcaption>
            </figure>
          ))}
        </div>
        <dl class="material-thickness">
          <div><dt>8 мм</dt><dd>Базове рішення для більшості душових конструкцій.</dd></div>
          <div><dt>10 мм або ламіноване скло</dt><dd>Для окремих конструкцій за проєктним чи конструкторським розрахунком.</dd></div>
        </dl>
      </div>

      <div class="material-subblock">
        <h3>Фурнітура та комплектуючі</h3>
        <div class="material-grid material-grid--parts">
          {hardwareParts.map(([name,text])=>(<article><b>{name}</b><p>{text}</p></article>))}
        </div>
        <div class="hardware-details">
          {hardwareDetails.map((d)=>(
            <figure class="hardware-details__item">
              <img src={d.src} alt={d.alt} width="960" height="1280" loading="lazy" decoding="async" />
              <figcaption>{d.label}</figcaption>
            </figure>
          ))}
        </div>
      </div>

      <div class="material-subblock">
        <h3>Кольори фурнітури</h3>
        <div class="swatch-grid swatch-grid--hardware">
          {hardwareFinishes.map((hw)=>(
            <figure class="swatch swatch--round">
              <span class={`swatch__dot ${hw.cls}`} aria-hidden="true"></span>
              <figcaption><b>{hw.name}</b></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="category-section">
      <div class="category-heading"><div><p class="eyebrow">Основа</p><h2>З піддоном чи без піддона</h2></div><p>Обидва варіанти робочі — різниця в підготовці підлоги та геометрії входу.</p></div>
      <div class="category-duo">
        {trayCards.map((item)=>(
          <article>
            <h3>{item.name}</h3>
            <p>{item.text}</p>
            {item.href && item.linkLabel && <a class="category-arrow-link" href={item.href}>{item.linkLabel}</a>}
          </article>
        ))}
      </div>
    </section>

    <section class="category-section category-section--mint">
      <div class="category-heading"><div><p class="eyebrow">Підготовка</p><h2>Що потрібно для розрахунку</h2></div><p>Цього достатньо для попередньої оцінки. Фінальні вимоги узгоджує технолог за конкретним об'єктом.</p></div>
      <div class="category-steps">
        {prepSteps.map(([name,text],i)=>(
          <div class="category-steps__item"><span>{String(i+1).padStart(2,'0')}</span><b>{name}</b><p>{text}</p></div>
        ))}
      </div>
    </section>

    <div id="price">
      <PriceBlock
        heading="Вартість душових конструкцій"
        kicker="Орієнтир для базової комплектації"
        amount="від 11 800 грн"
        amountNote="Стартова вартість залежить від формату конструкції, розмірів, скла, фурнітури та умов монтажу. Кутові, нішеві, розсувні, складні системи й нестандартні рішення розраховуємо індивідуально."
        bullets={[
          "Базова конструкція — просте рішення зі стандартною комплектацією.",
          "Індивідуальні розміри — виготовлення за фактичними розмірами душової зони.",
          "Скло та фурнітура — тип скла, петлі, профілі, ручки й система відкривання впливають на підсумкову вартість."
        ]}
        ctaLabel="Розрахувати мою душову"
        ctaHref="/contacts/#contact-form"
        factorsTitle="Що впливає на вартість"
        factors={priceFactors}
      />
    </div>

    {showerProjects.length > 0 && (
      <section class="category-section">
        <div class="category-heading category-heading--top category-heading--projects">
          <div class="category-heading--projects__title"><p class="eyebrow">Портфоліо</p><h2>Реалізовані душові конструкції</h2></div>
          <div class="category-heading--projects__aside"><a class="category-arrow-link" href="/projects/">Переглянути всі проєкти <span aria-hidden="true">→</span></a><p>Реальні кутові кабіни, душові в нішу, перегородки та двері зі скла Space Glass.</p></div>
        </div>
        <div class="projects-index-v2__grid category-projects-grid">
          {showerProjects.map((project) => <ProjectCard project={project} hrefPrefix="/projects" />)}
        </div>
      </section>
    )}

    <section class="category-process">
      <div class="category-heading"><div><p class="eyebrow eyebrow--light">Процес</p><h2>Від запиту до готової конструкції</h2></div></div>
      <div class="category-process__grid">
        <div><span>01</span><b>Запит</b><small>Фото, розміри або креслення</small></div>
        <div><span>02</span><b>Оцінка</b><small>Попередня комплектація</small></div>
        <div><span>03</span><b>Замір</b><small>Перевірка геометрії</small></div>
        <div><span>04</span><b>Проєкт</b><small>Технічне узгодження креслення</small></div>
        <div><span>05</span><b>Виготовлення</b><small>Контроль якості</small></div>
        <div><span>06</span><b>Монтаж</b><small>Здача конструкції</small></div>
      </div>
    </section>

    <section class="category-section category-geo">
      <div class="category-geo__grid">
        <div class="category-geo__copy"><p class="eyebrow">Географія</p><h2>Замір і монтаж скляних душових кабін</h2><p>Замір і монтаж виконуємо у Києві, Львові та Одесі з областями. Умови доставки готових виробів залежать від міста, габаритів і доступу до об'єкта.</p></div>
        <ul class="category-geo__cities"><li><b>Київ</b><span>замір і монтаж</span></li><li><b>Одеса</b><span>замір і монтаж</span></li><li><b>Львів</b><span>замір і монтаж</span></li></ul>
      </div>
    </section>

    <section class="category-section category-section--faq">
      <FAQBlock
        title="FAQ про скляні душові кабіни: ціна, розміри, скло, монтаж"
        intro="Відповідаємо на основні питання про душові кабіни зі скла, перегородки, двері, розсувні й складні системи, піддони, замір та монтаж."
        items={faq}
        visibleCount={6}
        expandTo={faq.length}
      />
    </section>

    <section class="category-section category-links">
      <div class="category-heading"><div><p class="eyebrow">Корисне</p><h2>Далі по темі</h2></div></div>
      <div class="category-links__grid category-links__grid--8">
        {relatedLinks.map(([label,href])=>(<a href={href}>{label}</a>))}
      </div>
    </section>

    <section id="category-request" class="inner-cta">
      <div><p class="eyebrow eyebrow--light">Заявка</p><h2>Потрібен попередній розрахунок?</h2><p>Надішліть фото, приблизні розміри або креслення — запропонуємо тип скляної душової конструкції та підготуємо орієнтовну вартість.</p></div>
      <a class="button button--white" href="/contacts/#contact-form">Отримати розрахунок</a>
    </section>
  </main>
  <Footer />
</div>
</BaseLayout>
