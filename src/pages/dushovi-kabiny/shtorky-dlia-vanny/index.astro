---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FAQBlock from '../../../components/FAQBlock.astro';
import '../../../styles/product-detail.css';
import '../../../styles/legacy-product.css';

const title = "Скляні шторки на ванну";
const subtitle = "Скляні шторки для ванної на замовлення — стаціонарні, розпашні або складні екрани під конкретну ванну та геометрію приміщення.";
const price = "Ціна за індивідуальним розрахунком";
const features = ["Стаціонарні, розпашні та складні рішення", "Виготовлення під фактичний розмір ванни", "Прозоре, матове або декоративне скло", "Фурнітура та кріплення під обрану схему"];
const faq = [
  ["Чим скляна шторка на ванну відрізняється від душової перегородки?", "Вона встановлюється безпосередньо на борт ванни та захищає зону душу від бризок, не перетворюючи ванну на окрему душову кабіну."],
  ["Які бувають скляні шторки для ванної?", "Стаціонарні, розпашні та складні. Вибір залежить від довжини ванни, змішувача, меблів і того, наскільки широкий захист потрібен."],
  ["Чи можна зробити складну шторку гармошка?", "Так, якщо геометрія ванни та доступна фурнітура дозволяють безпечно реалізувати складну систему."],
  ["Чи можна зробити шторку за індивідуальними розмірами?", "Так. Скло виготовляємо після заміру або перевірки фактичних розмірів ванни та стіни."],
  ["Від чого залежить ціна?", "Від ширини й висоти скла, кількості секцій, способу відкривання, типу скла, фурнітури та монтажу."]
];
---
<BaseLayout title="Скляні шторки на ванну на замовлення | Space Glass" description={subtitle}>
  <div class="sg-page-shell">
    <Header />
    <main id="main">
      <Breadcrumbs contained items={[{label:'Головна',href:'/'},{label:'Душові кабіни',href:'/dushovi-kabiny/'},{label:title}]} />
      <section class="product-detail-hero">
        <div class="product-detail-hero__media">
          <img src="/images/s20/product-interior.webp" alt="Скляна шторка на ванну" width="1800" height="1500" />
        </div>
        <div class="product-detail-hero__copy">
          <p class="eyebrow">Скло для ванної</p>
          <h1>{title}</h1>
          <p class="lead">{subtitle}</p>
          <div class="product-detail-price">{price}</div>
          <div class="hero__actions">
            <a class="button button--mint" href="/contacts/#contact-form">Отримати розрахунок</a>
            <a class="button button--outline" href="/dushovi-kabiny/">Всі види душових</a>
          </div>
        </div>
      </section>

      <section class="product-detail-section">
        <div class="category-heading"><div><p class="eyebrow">Варіанти</p><h2>Скляний екран під вашу ванну</h2></div><p>Шторку проєктуємо під реальну довжину борту, розташування змішувача та простір поруч. Це дозволяє обрати потрібну ширину захисту й зручну механіку відкривання.</p></div>
        <div class="product-feature-grid">{features.map((feature, i) => <article><span>{String(i + 1).padStart(2, '0')}</span><h3>{feature}</h3></article>)}</div>
      </section>

      <section class="product-spec-section">
        <div><p class="eyebrow">Перед замовленням</p><h2>Що перевіряємо</h2></div>
        <dl class="product-spec-list">
          <div><dt>Борт ванни</dt><dd>Ширина, рівність і зона встановлення скла</dd></div>
          <div><dt>Стіна</dt><dd>Вертикальність і можливість надійного кріплення</dd></div>
          <div><dt>Змішувач</dt><dd>Його положення впливає на ширину захисту</dd></div>
          <div><dt>Відкривання</dt><dd>Стаціонарне, розпашне або складне</dd></div>
          <div><dt>Скло</dt><dd>Тип і товщина визначаються конструкцією</dd></div>
          <div><dt>Фурнітура</dt><dd>Петлі, профіль або складний механізм за схемою</dd></div>
        </dl>
      </section>

      <section class="product-gallery-strip">
        <img src="/images/s19/walkin-angle.webp" alt="Скляна шторка для ванної — загальний ракурс" width="1400" height="1700" loading="lazy" />
        <img src="/images/catalog/dushovi-kabiny/hardware/petli-new.webp" alt="Петля скляної шторки на ванну" width="960" height="1280" loading="lazy" />
        <img src="/images/catalog/dushovi-kabiny/hardware/ruchky.webp" alt="Фурнітура скляної шторки для ванної" width="960" height="1280" loading="lazy" />
      </section>

      <section class="product-detail-section">
        <div class="category-heading"><div><p class="eyebrow">Пов'язані рішення</p><h2>Якщо потрібна інша схема</h2></div></div>
        <div class="product-feature-grid">
          <article><h3><a href="/dushovi-kabiny/skladni/">Складні душові системи</a></h3><p>Коли потрібна шторка або двері гармошка.</p></article>
          <article><h3><a href="/dushovi-kabiny/peregorodka-dlya-dusha/">Скляні перегородки для душу</a></h3><p>Для окремої Walk-In душової зони.</p></article>
          <article><h3><a href="/dushovi-kabiny/dushovi-dveri/">Скляні душові двері</a></h3><p>Для ніші або повноцінної душової конструкції.</p></article>
          <article><h3><a href="/knowledge/yak-obraty-dushovu-kabinu/">Як обрати душову конструкцію</a></h3><p>Порівняння форматів перед замовленням.</p></article>
        </div>
      </section>

      <FAQBlock eyebrow="FAQ" title="Часті запитання про скляні шторки на ванну" description="Про стаціонарні, розпашні й складні варіанти, розміри та монтаж." items={faq} initiallyVisible={5} />

      <section class="inner-cta">
        <div><p class="eyebrow eyebrow--light">Попередня оцінка</p><h2>Надішліть фото ванни та приблизні розміри</h2><p>Порадимо формат шторки та підготуємо індивідуальний розрахунок.</p></div>
        <a class="button button--white" href="/contacts/#contact-form">Отримати розрахунок</a>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
