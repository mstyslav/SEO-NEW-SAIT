---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FAQBlock from '../../../components/FAQBlock.astro';
import '../../../styles/product-detail.css';
import '../../../styles/legacy-product.css';

const title = "Скляні душові двері";
const subtitle = "Душові двері зі скла на замовлення для ніш і комбінованих конструкцій: розпашні, розсувні або складні рішення під фактичний отвір.";
const price = "Ціна за індивідуальним розрахунком";
const features = ["Виготовлення під фактичний отвір", "Розпашні, розсувні або складні схеми", "Ущільнення та магнітний притвор за системою", "Фурнітура під вагу та геометрію скла"];
const faq = [
  ["Які душові двері можна виготовити зі скла?", "Розпашні, розсувні та складні. Конкретну систему підбираємо за шириною отвору, вільним місцем перед душовою та бажаною шириною проходу."],
  ["Чи можна зробити двері в готову душову нішу?", "Так. Після чистового оздоблення вимірюємо отвір і виготовляємо дверне полотно або двері з нерухомою секцією під фактичну геометрію."],
  ["Яке скло використовують для душових дверей?", "Застосовуємо безпечне загартоване скло; товщину, тип і обробку визначаємо під конкретну конструкцію та фурнітуру."],
  ["Чи можна замінити старі душові двері новими скляними?", "У багатьох випадках так. Спочатку перевіряємо отвір, основу, місця кріплення та можливість встановлення нової системи."],
  ["Від чого залежить ціна?", "Від розміру полотна, типу відкривання, скла, фурнітури, ущільнень і умов монтажу. Точний розрахунок робимо після узгодження схеми."]
];
---
<BaseLayout title="Скляні душові двері на замовлення | Space Glass" description={subtitle}>
  <div class="sg-page-shell">
    <Header />
    <main id="main">
      <Breadcrumbs contained items={[{label:'Головна',href:'/'},{label:'Душові кабіни',href:'/dushovi-kabiny/'},{label:title}]} />
      <section class="product-detail-hero">
        <div class="product-detail-hero__media">
          <img src="/images/projects/sliding-shower-doors-kyiv/sliding-shower-doors-kyiv-detail-02.webp" alt="Скляні душові двері з фурнітурою" width="960" height="1280" />
        </div>
        <div class="product-detail-hero__copy">
          <p class="eyebrow">Душові двері зі скла</p>
          <h1>{title}</h1>
          <p class="lead">{subtitle}</p>
          <div class="product-detail-price">{price}</div>
          <div class="hero__actions">
            <a class="button button--mint" href="/contacts/#contact-form">Отримати розрахунок</a>
            <a class="button button--outline" href="/dushovi-kabiny/">Всі види душових</a>
          </div>
        </div>
      </section>

      <section class="product-detail-section">
        <div class="category-heading"><div><p class="eyebrow">Варіанти</p><h2>Двері під геометрію душової</h2></div><p>Тип відкривання обираємо не тільки за дизайном, а й за реальним простором перед душовою, шириною проходу та розташуванням сантехніки.</p></div>
        <div class="product-feature-grid">{features.map((feature, i) => <article><span>{String(i + 1).padStart(2, '0')}</span><h3>{feature}</h3></article>)}</div>
      </section>

      <section class="product-spec-section">
        <div><p class="eyebrow">Перед замовленням</p><h2>Що перевіряємо на замірі</h2></div>
        <dl class="product-spec-list">
          <div><dt>Отвір</dt><dd>Ширина та висота після чистового оздоблення</dd></div>
          <div><dt>Відкривання</dt><dd>Розпашне, розсувне або складне залежно від простору</dd></div>
          <div><dt>Основа</dt><dd>Піддон або підготовлена підлога</dd></div>
          <div><dt>Притвор</dt><dd>Положення ущільнювачів і магнітних елементів</dd></div>
          <div><dt>Скло</dt><dd>Тип і товщина — за конструкцією та габаритами</dd></div>
          <div><dt>Фурнітура</dt><dd>Петлі, ручка, напрямна або складний механізм</dd></div>
        </dl>
      </section>

      <section class="product-gallery-strip">
        <img src="/images/s19/walkin-angle.webp" alt="Скляні двері в душовій конструкції" width="1400" height="1700" loading="lazy" />
        <img src="/images/catalog/dushovi-kabiny/hardware/ruchky.webp" alt="Ручка скляних душових дверей" width="960" height="1280" loading="lazy" />
        <img src="/images/catalog/dushovi-kabiny/hardware/petli-new.webp" alt="Петля скляних душових дверей" width="960" height="1280" loading="lazy" />
      </section>

      <section class="product-detail-section">
        <div class="category-heading"><div><p class="eyebrow">Пов'язані рішення</p><h2>Оберіть механіку відкривання</h2></div></div>
        <div class="product-feature-grid">
          <article><h3><a href="/dushovi-kabiny/rozsuvni/">Розсувні душові кабіни</a></h3><p>Коли перед душовою немає місця для розпашної стулки.</p></article>
          <article><h3><a href="/dushovi-kabiny/skladni/">Складні двері гармошка</a></h3><p>Для компактного проходу та складної геометрії.</p></article>
          <article><h3><a href="/dushovi-kabiny/u-nishu/">Душові в нішу</a></h3><p>Для готового отвору між стінами.</p></article>
          <article><h3><a href="/knowledge/rozpashni-chy-rozsuvni-sklyani-dveri/">Розпашні чи розсувні?</a></h3><p>Порівняння двох основних схем.</p></article>
        </div>
      </section>

      <FAQBlock eyebrow="FAQ" title="Часті запитання про скляні душові двері" description="Про типи відкривання, нішу, скло та розрахунок." items={faq} initiallyVisible={5} />

      <section class="inner-cta">
        <div><p class="eyebrow eyebrow--light">Попередня оцінка</p><h2>Надішліть фото отвору та розміри</h2><p>Порадимо тип дверей і підготуємо попередній розрахунок без конфігуратора.</p></div>
        <a class="button button--white" href="/contacts/#contact-form">Отримати розрахунок</a>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
