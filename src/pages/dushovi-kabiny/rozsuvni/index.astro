---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FAQBlock from '../../../components/FAQBlock.astro';
import '../../../styles/product-detail.css';
import '../../../styles/legacy-product.css';

const title = "Розсувні душові кабіни зі скла";
const subtitle = "Скляні душові кабіни з розсувними дверима на замовлення — для ванних кімнат, де важливо не займати простір перед душовою розпашною стулкою.";
const price = "Ціна за індивідуальним розрахунком";
const features = ["Без зони розпашного відкривання", "Рухомі та стаціонарні скляні секції", "Напрямна й ролики під конкретну систему", "Індивідуальні розміри після заміру"];
const faq = [
  ["Коли варто обрати розсувну душову кабіну?", "Коли перед душовою мало місця для відкривання дверей або потрібно зберегти вільний прохід у компактній ванній кімнаті."],
  ["Чи можна зробити розсувні двері в душову нішу?", "Так. Розсувну систему можна спроєктувати для готової ніші або як частину кутової душової конструкції."],
  ["Від чого залежить плавність ходу дверей?", "Від правильно підібраної системи, геометрії, роликів, напрямної та точності монтажу."],
  ["Чи можна встановити розсувну душову на піддон?", "Так. Геометрію піддона та скляної системи узгоджуємо до фінального заміру."],
  ["Від чого залежить ціна?", "Від кількості полотен, ширини проходу, системи роликів і напрямних, скла, фурнітури та монтажу."]
];
---
<BaseLayout title="Розсувні душові кабіни зі скла на замовлення | Space Glass" description={subtitle}>
  <div class="sg-page-shell">
    <Header />
    <main id="main">
      <Breadcrumbs contained items={[{label:'Головна',href:'/'},{label:'Душові кабіни',href:'/dushovi-kabiny/'},{label:title}]} />
      <section class="product-detail-hero">
        <div class="product-detail-hero__media">
          <img src="/images/projects/sliding-shower-doors-kyiv/sliding-shower-doors-kyiv-detail-02.webp" alt="Розсувні скляні двері душової кабіни" width="960" height="1280" />
        </div>
        <div class="product-detail-hero__copy">
          <p class="eyebrow">Розсувні душові системи</p>
          <h1>{title}</h1>
          <p class="lead">{subtitle}</p>
          <div class="product-detail-price">{price}</div>
          <div class="hero__actions">
            <a class="button button--mint" href="/contacts/#contact-form">Отримати розрахунок</a>
            <a class="button button--outline" href="/dushovi-kabiny/">Всі види душових</a>
          </div>
        </div>
      </section>

      <section class="product-detail-section">
        <div class="category-heading"><div><p class="eyebrow">Переваги</p><h2>Розсувне відкривання без зайвої дуги</h2></div><p>Стулка рухається вздовж напрямної, тому перед душовою не потрібно залишати місце для розпашних дверей. Це особливо корисно поруч із умивальником, меблями або проходом.</p></div>
        <div class="product-feature-grid">{features.map((feature, i) => <article><span>{String(i + 1).padStart(2, '0')}</span><h3>{feature}</h3></article>)}</div>
      </section>

      <section class="product-spec-section">
        <div><p class="eyebrow">Проєктування</p><h2>Що потрібно врахувати</h2></div>
        <dl class="product-spec-list">
          <div><dt>Ширина проходу</dt><dd>Визначає кількість і розмір рухомих секцій</dd></div>
          <div><dt>Напрям руху</dt><dd>Підбираємо під планування ванної кімнати</dd></div>
          <div><dt>Напрямна</dt><dd>Система залежить від габаритів і ваги скла</dd></div>
          <div><dt>Основа</dt><dd>Піддон або підготовлена підлога</dd></div>
          <div><dt>Скло</dt><dd>Тип і товщина визначаються проєктом</dd></div>
          <div><dt>Монтаж</dt><dd>Точність геометрії критична для плавного руху</dd></div>
        </dl>
      </section>

      <section class="product-gallery-strip">
        <img src="/images/projects/sliding-shower-doors-kyiv/sliding-shower-doors-kyiv-detail-02.webp" alt="Ролики та напрямна розсувної душової" width="960" height="1280" loading="lazy" />
        <img src="/images/s19/walkin-angle.webp" alt="Розсувна скляна душова в інтер'єрі" width="1400" height="1700" loading="lazy" />
        <img src="/images/catalog/dushovi-kabiny/hardware/ruchky.webp" alt="Ручка скляних розсувних дверей" width="960" height="1280" loading="lazy" />
      </section>

      <section class="product-detail-section">
        <div class="category-heading"><div><p class="eyebrow">Порівняння</p><h2>Якщо потрібне інше відкривання</h2></div></div>
        <div class="product-feature-grid">
          <article><h3><a href="/dushovi-kabiny/dushovi-dveri/">Скляні душові двері</a></h3><p>Усі основні типи дверних рішень.</p></article>
          <article><h3><a href="/dushovi-kabiny/skladni/">Складні душові двері</a></h3><p>Коли потрібно ще більше звільнити прохід.</p></article>
          <article><h3><a href="/dushovi-kabiny/u-nishu/">Душові в нішу</a></h3><p>Для готового отвору між стінами.</p></article>
          <article><h3><a href="/knowledge/rozpashni-chy-rozsuvni-sklyani-dveri/">Розпашні чи розсувні?</a></h3><p>Практичне порівняння механік.</p></article>
        </div>
      </section>

      <FAQBlock eyebrow="FAQ" title="Часті запитання про розсувні душові кабіни" description="Про напрямні, нішу, піддон і розрахунок." items={faq} initiallyVisible={5} />

      <section class="inner-cta">
        <div><p class="eyebrow eyebrow--light">Попередня оцінка</p><h2>Надішліть фото та ширину душової</h2><p>Перевіримо, чи підійде розсувна схема, і підготуємо попередній розрахунок.</p></div>
        <a class="button button--white" href="/contacts/#contact-form">Отримати розрахунок</a>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
