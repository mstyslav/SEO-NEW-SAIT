---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FAQBlock from '../../../components/FAQBlock.astro';
import '../../../styles/product-detail.css';
import '../../../styles/legacy-product.css';

const title = "Складні душові кабіни та двері гармошка";
const subtitle = "Складні скляні душові двері для ніш, компактних душових зон і ванн — коли перед конструкцією мало місця для розпашної стулки.";
const price = "Ціна за індивідуальним розрахунком";
const features = [
  "Складні стулки для економії простору",
  "Для душової зони, ніші або ванни",
  "Виготовлення за індивідуальними розмірами",
  "Підбір скла, фурнітури та схеми відкривання"
];
const faq = [
  ["Коли варто обрати складні душові двері?", "Коли перед душовою мало вільного місця для повноцінної розпашної стулки. Складні секції зменшують зону, потрібну для відкривання."],
  ["Чи можна зробити двері гармошка для душової ніші?", "Так. Схему підбираємо після заміру з урахуванням ширини отвору, напрямку складання та місць кріплення."],
  ["Чи підходить складна система для ванни?", "Так, складний механізм може застосовуватися і для скляної шторки на ванну, якщо це дозволяють геометрія та обрана фурнітура."],
  ["Чим складні двері відрізняються від розсувних?", "Розсувні стулки рухаються вздовж напрямної, а складні секції складаються одна до одної. Вибір залежить від ширини отвору, доступного місця та бажаного проходу."],
  ["Чи можна замовити нестандартний розмір?", "Так. Скло та схема фурнітури готуються під фактичні розміри після заміру або перевірки креслення."]
];
---
<BaseLayout title="Складні душові кабіни та двері гармошка на замовлення | Space Glass" description={subtitle}>
  <div class="sg-page-shell">
    <Header />
    <main id="main">
      <Breadcrumbs contained items={[{label:'Головна',href:'/'},{label:'Душові кабіни',href:'/dushovi-kabiny/'},{label:'Складні душові кабіни'}]} />
      <section class="product-detail-hero">
        <div class="product-detail-hero__media">
          <img src="/images/s20/product-interior.webp" alt="Складна скляна душова система гармошка" width="1800" height="1500" />
        </div>
        <div class="product-detail-hero__copy">
          <p class="eyebrow">Скляні душові конструкції</p>
          <h1>{title}</h1>
          <p class="lead">{subtitle}</p>
          <div class="product-detail-price">{price}</div>
          <div class="hero__actions">
            <a class="button button--mint" href="/contacts/#contact-form">Отримати розрахунок</a>
            <a class="button button--outline" href="/dushovi-kabiny/">Всі види душових</a>
          </div>
        </div>
      </section>

      <section class="product-detail-section">
        <div class="category-heading">
          <div><p class="eyebrow">Коли це зручно</p><h2>Складна система для компактного простору</h2></div>
          <p>Гармошка дає змогу організувати ширший прохід там, де розпашні двері конфліктують із сантехнікою, меблями або проходом.</p>
        </div>
        <div class="product-feature-grid">
          {features.map((feature, i) => <article><span>{String(i + 1).padStart(2, '0')}</span><h3>{feature}</h3></article>)}
        </div>
      </section>

      <section class="product-spec-section">
        <div><p class="eyebrow">Проєктування</p><h2>Що врахувати перед замовленням</h2></div>
        <dl class="product-spec-list">
          <div><dt>Отвір</dt><dd>Фактична ширина та висота після чистового оздоблення</dd></div>
          <div><dt>Складання</dt><dd>Напрямок і зона, у яку повинні складатися стулки</dd></div>
          <div><dt>Скло</dt><dd>Тип і товщина визначаються конструкцією та габаритами</dd></div>
          <div><dt>Фурнітура</dt><dd>Комплект підбирається під кількість секцій і вагу полотен</dd></div>
          <div><dt>Основа</dt><dd>Піддон або підлога з підготовленим водовідведенням</dd></div>
          <div><dt>Монтаж</dt><dd>Київ, Одеса, Львів та області</dd></div>
        </dl>
      </section>

      <section class="product-detail-section">
        <div class="category-heading"><div><p class="eyebrow">Застосування</p><h2>Душова, ніша або ванна</h2></div></div>
        <div class="product-feature-grid">
          <article><span>01</span><h3>Душова зона</h3><p>Коли потрібен прохід без великої дуги відкривання дверей.</p></article>
          <article><span>02</span><h3>Ніша</h3><p>Складні двері закривають готовий отвір між стінами.</p></article>
          <article><span>03</span><h3>Ванна</h3><p>Складна скляна шторка може звільняти край ванни після користування душем.</p></article>
          <article><span>04</span><h3>Маленька ванна кімната</h3><p>Рішення розглядаємо, коли сантехніка або меблі обмежують розпашне відкривання.</p></article>
        </div>
      </section>

      <FAQBlock eyebrow="FAQ" title="Часті запитання про складні душові двері" description="Про гармошку, нішу, ванну та індивідуальні розміри." items={faq} initiallyVisible={5} />

      <section class="inner-cta">
        <div><p class="eyebrow eyebrow--light">Попередня оцінка</p><h2>Покажіть нам душову зону</h2><p>Надішліть фото та приблизні розміри — запропонуємо схему складання і підготуємо розрахунок.</p></div>
        <a class="button button--white" href="/contacts/#contact-form">Отримати розрахунок</a>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
