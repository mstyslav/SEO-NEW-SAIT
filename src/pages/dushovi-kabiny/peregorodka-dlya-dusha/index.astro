---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FAQBlock from '../../../components/FAQBlock.astro';
import '../../../styles/product-detail.css';
import '../../../styles/legacy-product.css';

const title = "Скляні перегородки для душу";
const subtitle = "Скляні душові перегородки на замовлення за індивідуальними розмірами: стаціонарні Walk-In конструкції без дверей із мінімалістичною фурнітурою та професійним монтажем.";
const price = "Ціна за індивідуальним розрахунком";
const features = ["Стаціонарна Walk-In конструкція без дверей", "Загартоване скло під фактичні розміри", "Профіль або точкові кріплення залежно від проєкту", "Монтаж і герметизація душової зони"];
const faq = [
  ["Що таке скляна перегородка для душу Walk-In?", "Це стаціонарне скляне полотно без дверей, яке відділяє душову зону та залишає відкритий прохід."],
  ["Яка товщина скла використовується?", "Для більшості конструкцій базовим рішенням є загартоване скло 8 мм; 10 мм або інше рішення застосовуємо за габаритами та проєктним розрахунком."],
  ["Чи можна зробити перегородку за індивідуальними розмірами?", "Так. Виготовляємо скляну душову перегородку під фактичний отвір після заміру або перевірки наданих розмірів."],
  ["Чи потрібен піддон для Walk-In перегородки?", "Ні. Перегородку можна встановити як на готовий душовий піддон, так і на підготовлену підлогу з гідроізоляцією та водовідведенням."],
  ["Від чого залежить вартість?", "Від ширини й висоти скла, типу та обробки полотна, способу кріплення, фурнітури й умов монтажу. Точну ціну підтверджуємо після узгодження конструкції."]
];
---
<BaseLayout title="Скляні перегородки для душу на замовлення | Space Glass" description={subtitle}>
  <div class="sg-page-shell">
    <Header />
    <main id="main">
      <Breadcrumbs contained items={[{label:'Головна',href:'/'},{label:'Душові кабіни',href:'/dushovi-kabiny/'},{label:title}]} />
      <section class="product-detail-hero">
        <div class="product-detail-hero__media">
          <img src="/images/s19/walkin-main.webp" alt="Скляна перегородка для душу Walk-In" width="1400" height="1700" />
        </div>
        <div class="product-detail-hero__copy">
          <p class="eyebrow">Скляні душові конструкції</p>
          <h1>{title}</h1>
          <p class="lead">{subtitle}</p>
          <div class="product-detail-price">{price}</div>
          <div class="hero__actions">
            <a class="button button--mint" href="/contacts/#contact-form">Отримати розрахунок</a>
            <a class="button button--outline" href="/dushovi-kabiny/">Всі види душових</a>
          </div>
        </div>
      </section>

      <section class="product-detail-section">
        <div class="category-heading">
          <div><p class="eyebrow">Walk-In</p><h2>Стаціонарна душова перегородка зі скла</h2></div>
          <p>Таке рішення відділяє мокру зону без дверей і зайвих рам. Геометрію полотна визначаємо під конкретну ванну кімнату, розташування змішувача та напрямок бризок.</p>
        </div>
        <div class="product-feature-grid">
          {features.map((feature, i) => <article><span>{String(i + 1).padStart(2, '0')}</span><h3>{feature}</h3></article>)}
        </div>
      </section>

      <section class="product-spec-section">
        <div><p class="eyebrow">Що врахувати</p><h2>Перед замовленням перегородки</h2></div>
        <dl class="product-spec-list">
          <div><dt>Ширина проходу</dt><dd>Визначає комфорт входу та захист від бризок</dd></div>
          <div><dt>Висота скла</dt><dd>Погоджується з геометрією приміщення й кріпленнями</dd></div>
          <div><dt>Основа</dt><dd>Піддон або підлога з готовою гідроізоляцією та ухилом</dd></div>
          <div><dt>Скло</dt><dd>Прозоре, освітлене, матове чи тоноване — за проєктом</dd></div>
          <div><dt>Кріплення</dt><dd>Профіль, затискачі та стабілізуюча штанга за конструктивом</dd></div>
          <div><dt>Монтаж</dt><dd>Київ, Одеса, Львів та області</dd></div>
        </dl>
      </section>

      <section class="product-gallery-strip">
        <img src="/images/s19/walkin-angle.webp" alt="Скляна душова перегородка — загальний ракурс" width="1400" height="1700" loading="lazy" />
        <img src="/images/s19/walkin-detail.webp" alt="Кріплення скляної перегородки для душу" width="1400" height="1700" loading="lazy" />
        <img src="/images/s20/product-interior.webp" alt="Душова перегородка зі скла в інтер'єрі" width="1800" height="1500" loading="lazy" />
      </section>

      <section class="product-detail-section">
        <div class="category-heading"><div><p class="eyebrow">Далі по темі</p><h2>Корисно перед замовленням</h2></div></div>
        <div class="product-feature-grid">
          <article><h3><a href="/knowledge/walk-in-perevahy-nedoliky/">Walk-In: переваги й недоліки</a></h3></article>
          <article><h3><a href="/knowledge/tovshchyna-skla-8-10-12-mm/">Товщина скла 8, 10, 12 мм</a></h3></article>
          <article><h3><a href="/knowledge/furnitura-dlya-dushovoyi/">Фурнітура для душової</a></h3></article>
          <article><h3><a href="/dushovi-kabiny/dushovi-piddony/">Душові піддони</a></h3></article>
        </div>
      </section>

      <FAQBlock eyebrow="FAQ" title="Часті запитання про скляні перегородки для душу" description="Про Walk-In, розміри, скло, піддон і розрахунок." items={faq} initiallyVisible={5} />

      <section class="inner-cta">
        <div><p class="eyebrow eyebrow--light">Попередня оцінка</p><h2>Надішліть фото та розміри душової</h2><p>Запропонуємо геометрію перегородки, варіант кріплення та підготуємо індивідуальний розрахунок.</p></div>
        <a class="button button--white" href="/contacts/#contact-form">Отримати розрахунок</a>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
