---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FAQBlock from '../../../components/FAQBlock.astro';
import TrustBar from '../../../components/TrustBar.astro';
import PriceBlock from '../../../components/PriceBlock.astro';
import { absoluteUrl, faqSchema, type JsonLdObject } from '../../../seo/schema';
import { piddonySeries, formatUah, seriesPriceFrom, priceDisclaimer } from '../../../data/dushovi-piddony';
import '../../../styles/category-pages.css';
import '../../../styles/shower-master.css';

const origin = Astro.site ?? Astro.url.origin;
const pageUrl = absoluteUrl('/dushovi-kabiny/dushovi-piddony/', origin);

const title = 'Душові піддони';
const metaTitle = 'Душові піддони — купити піддон для душу зі штучного каменю | Space Glass';
const metaDescription =
  'Душові піддони зі штучного мармуру та каменю: квадратні, прямокутні та п’ятикутні, із сифоном у комплекті й антиковзанням. Вибір розміру та кольору з цінами, підбір під скляну душову Space Glass, доставка по Україні.';

const allPrices = piddonySeries.flatMap((s) =>
  s.variants.map((v) => v.price).filter((p): p is number => typeof p === 'number')
);
const overallFrom = formatUah(Math.min(...allPrices));
const priceDisclaimerSentences = priceDisclaimer.split(/(?<=\.) /);

// SSR initial selection for each card (works with JS disabled too).
const cardInit = piddonySeries.map((s) => {
  const firstAvailable = s.variants.find((v) => v.price !== null);
  const size = firstAvailable ? firstAvailable.size : s.sizes[0];
  const color = s.colors[0];
  const variant =
    s.variants.find((v) => v.size === size && v.color === color) ??
    s.variants.find((v) => v.size === size);
  const known = !!variant && typeof variant.price === 'number';
  const config = `${size} мм${s.colors.length > 1 ? ` · ${color}` : ''}`;
  const params = new URLSearchParams({ product: s.publicName, config });
  if (known && variant) params.set('price', formatUah(variant.price));
  return {
    size,
    color,
    known,
    priceLabel: known && variant ? formatUah(variant.price as number) : 'Уточнити наявність',
    ctaHref: `/contacts/?${params.toString()}#contact-form`,
    ctaLabel: known ? 'Отримати точну вартість' : 'Уточнити наявність'
  };
});

const sizeAvailable = (series: (typeof piddonySeries)[number], size: string) =>
  series.variants.some((v) => v.size === size && v.price !== null);

// --- Choose by shape / size ------------------------------------------------
const byShape = [
  ['Квадратні', 'Для компактних і кутових душів: 800×800, 900×900, 1000×1000 мм. Симетрична зона під двері або Walk-In.'],
  ['Прямокутні', 'Для ніш і просторіших зон: 800×1200, 900×1200, 900×1600 мм. Комфортний душ уздовж стіни.'],
  ['П’ятикутні', 'Зі скошеною передньою гранню для кута кімнати — під п’ятикутну скляну кабіну.']
];
const bySize = [
  ['Компактний душ', '800×800 – 900×900 мм', 'Мінімальна зручна зона для однієї людини у невеликій ванній.'],
  ['Стандарт', '900×1000 – 900×1200 мм', 'Найпопулярніший діапазон під душові двері та перегородки в нішу.'],
  ['Walk-In / великий', '900×1400 – 900×1600 мм', 'Видовжена зона під відкриту перегородку без дверей.']
];

// --- How to choose -------------------------------------------------------
const chooseSteps = [
  ['Заміряйте зону', 'Ширина та глибина мокрої зони по чистовому оздобленню, з урахуванням майбутнього скла.'],
  ['Оберіть форму', 'Квадрат — кут або двері, прямокутник — ніша та Walk-In, п’ятикутник — зрізаний кут.'],
  ['Товщина і вхід', 'Товщина піддону 30–32 мм дає майже врівень вхід; рівень входу узгоджуємо зі склом.'],
  ['Злив і поверхня', 'Розташування випуску, сифон у комплекті, антиковзання — перевіряємо до замовлення.']
];

// --- Tray vs flush --------------------------------------------------------
const baseCards = [
  {
    name: 'З готовим піддоном',
    text: 'Штучний камінь спрощує гідроізоляцію та організацію зливу: сифон і декоративна накладка вже в комплекті. Розмір і форму піддона узгоджуємо зі скляною конструкцією до фінального заміру.',
    href: '#catalog',
    linkLabel: 'Перейти до каталогу піддонів →'
  },
  {
    name: 'Душ урівень з підлогою',
    text: 'Плитка по стяжці з ухилом до точкового трапа або лінійного водовідведення — без піддона. Потрібна підготовлена основа з правильною гідроізоляцією; геометрію враховуємо під час заміру.'
  }
];

const showerLinks = [
  ['Скляні перегородки для душу (Walk-In)', '/dushovi-kabiny/peregorodka-dlya-dusha/'],
  ['Скляні душові двері', '/dushovi-kabiny/dushovi-dveri/'],
  ['Кутові душові кабіни', '/dushovi-kabiny/kutovi/'],
  ['Душові кабіни в нішу', '/dushovi-kabiny/u-nishu/'],
  ['Розсувні душові кабіни', '/dushovi-kabiny/rozsuvni/'],
  ['П’ятикутні душові кабіни', '/dushovi-kabiny/piatykutni/']
];

const relatedLinks = [
  ['Усі види душових кабін', '/dushovi-kabiny/'],
  ['Як обрати душову кабіну', '/knowledge/yak-obraty-dushovu-kabinu/'],
  ['Душова в нішу: замір', '/knowledge/dushova-v-nishu-zamir/'],
  ['Як підготувати простір до заміру', '/knowledge/yak-pidhotuvaty-prostir-do-zamiru/'],
  ['Догляд за склом і поверхнями', '/knowledge/doglyad-za-sklyanymy-konstruktsiyamy/'],
  ['Від чого залежить ціна конструкції', '/knowledge/vid-choho-zalezhyt-tsina-sklyanoyi-konstruktsiyi/'],
  ['Оплата та доставка', '/oplata-dostavka/']
];

// --- FAQ (real search intents) ----------------------------------------
const faq: [string, string][] = [
  ['Скільки коштує душовий піддон?', `Душові піддони зі штучного каменю — орієнтовно від ${overallFrom} за розмір 900×900 мм. Кінцева ціна залежить від серії, розміру та кольору. Точну вартість підтверджуємо при замовленні.`],
  ['Як підібрати розмір душового піддона?', 'Заміряйте фактичну ширину та глибину мокрої зони по чистовому оздобленню й врахуйте місце під майбутню скляну конструкцію. Компактний душ — 800×800–900×900 мм, стандарт — 900×1000–900×1200 мм, Walk-In — 900×1400–900×1600 мм.'],
  ['Який матеріал піддона кращий?', 'Штучний камінь (мармурова крихта на кварцовій основі) міцніший за акрил, приємний на дотик, стійкий до подряпин і легко очищається. Піддони в каталозі витримують навантаження 375–500 кг і мають товщину 30–32 мм.'],
  ['Яка форма піддона потрібна?', 'Квадратні піддони — для кутових душів і зон під двері, прямокутні — для ніш і Walk-In, п’ятикутні зі скошеною гранню — для кута невеликої ванної під п’ятикутну кабіну.'],
  ['Чи слизький піддон зі штучного каменю?', 'Ні. Мармурові серії мають поверхню з 3 класом протиковзання, посилені моделі не стають слизькими при контакті з водою й зберігають комфортні тактильні властивості.'],
  ['Чи входить сифон у комплект?', 'Так. Сифон і декоративна накладка вже входять у комплектацію піддонів — докуповувати ці деталі не потрібно.'],
  ['Чи обов’язково робити душ із піддоном?', 'Ні. Скляну душову можна встановити і без піддона — на підготовлену підлогу з гідроізоляцією та ухилом до трапа. Піддон спрощує монтаж і водовідведення.'],
  ['Коли потрібно визначитися з піддоном?', 'До фінального заміру скла. Встановлений або точно обраний піддон задає геометрію, точки кріплення та розміри скляної конструкції.'],
  ['Чи можна замовити піддон разом зі скляною душовою?', 'Так, це бажаний сценарій. Space Glass підбирає піддон за розміром і формою та узгоджує його зі скляною перегородкою, дверима чи кабіною як одну систему.'],
  ['Чи є доставка піддонів по Україні?', 'Так. Доставку піддонів організовуємо по Україні; для замовлень зі скляною конструкцією виконуємо доставку та монтаж у Києві, Одесі та Львові, в інших містах — за домовленістю.'],
  ['Яка гарантія на душовий піддон?', 'Виробник надає 5 років гарантії на піддони зі штучного каменю за умови правильного монтажу та експлуатації.'],
  ['Яка товщина душового піддона?', 'Піддони в каталозі мають товщину 30–32 мм, що дає майже врівень вхід у душ. Рівень входу узгоджуємо зі скляною конструкцією.']
];

// --- Structured data (no supplier name / codes) ----------------------
const itemList: JsonLdObject = {
  '@type': 'ItemList',
  '@id': `${pageUrl}#catalog`,
  name: 'Душові піддони',
  numberOfItems: piddonySeries.length,
  itemListElement: piddonySeries.map((s, index) => {
    const cover = s.images[0];
    return {
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Product',
        name: s.publicName,
        category: 'Душові піддони',
        material: s.material,
        image: absoluteUrl(`${cover.base}-${cover.widths[cover.widths.length - 1]}.webp`, origin)
      }
    };
  })
};
const faqStructuredData = faqSchema(faq.map(([question, answer]) => ({ question, answer })));
const structuredData: JsonLdObject[] = [itemList, ...(faqStructuredData ? [faqStructuredData] : [])];

const tableHeads = ['Піддон', 'Форма', 'Розміри, мм', 'Товщина піддону', 'Навантаження', 'Антиковзання', 'Колір', 'Ціна'];
---
<BaseLayout
  title={metaTitle}
  description={metaDescription}
  image="/images/catalog/piddony/piddon-1-white-900.webp"
  schemaType="CollectionPage"
  structuredData={structuredData}
  heroPreloadSrc="/images/catalog/piddony/piddony-hero-1200.webp"
  heroPreloadSrcset="/images/catalog/piddony/piddony-hero-480.webp 480w, /images/catalog/piddony/piddony-hero-768.webp 768w, /images/catalog/piddony/piddony-hero-1200.webp 1200w, /images/catalog/piddony/piddony-hero-1600.webp 1600w"
  heroPreloadSizes="(max-width: 900px) calc(100vw - 48px), 52vw"
>
<div class="sg-page-shell">
  <Header />
  <main id="main">
    <section class="category-hero category-hero--photo">
      <div class="category-hero__copy">
        <Breadcrumbs items={[{ label: 'Головна', href: '/' }, { label: 'Душові кабіни', href: '/dushovi-kabiny/' }, { label: title }]} />
        <p class="eyebrow">Душові кабіни / Піддони</p>
        <h1>Душові піддони</h1>
        <p class="lead">Душові піддони зі штучного каменю під скляну душову Space Glass. Квадратні, прямокутні та п’ятикутні піддони із сифоном у комплекті та антиковзанням. Підбираємо піддон за розміром і формою душової зони, узгоджуємо зі склом, організовуємо доставку та монтаж.</p>
        <div class="hero__actions">
          <a class="button button--mint" href="#catalog">Обрати піддон</a>
          <a class="button button--outline" href="/contacts/#contact-form">Отримати розрахунок</a>
        </div>
      </div>
      <figure class="category-hero__figure">
        <div class="category-hero__frame">
          <img
            src="/images/catalog/piddony/piddony-hero-1200.webp"
            srcset="/images/catalog/piddony/piddony-hero-480.webp 480w, /images/catalog/piddony/piddony-hero-768.webp 768w, /images/catalog/piddony/piddony-hero-1200.webp 1200w, /images/catalog/piddony/piddony-hero-1600.webp 1600w"
            sizes="(max-width: 900px) calc(100vw - 48px), 52vw"
            alt="Прямокутний душовий піддон зі штучного каменю в сучасній ванній кімнаті"
            width="1600"
            height="826"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </figure>
    </section>

    <TrustBar locale="uk" />

    <section class="category-section category-section--mint">
      <div class="category-heading"><div><p class="eyebrow">Про піддони</p><h2>Піддон зі штучного каменю як частина душової системи</h2></div><p>Разом зі скляною конструкцією піддон працює як одна система: розміри, форма та вхід не конфліктують між собою.</p></div>
      <div class="category-intro-grid">
        <div class="category-prose">
          <p>Душовий піддон формує мокру зону, тримає ухил до зливу та захищає підлогу від протікання. Піддони зі штучного каменю (мармурова крихта на кварцовій основі) міцніші за акрил, мають приємну на дотик матову поверхню з кам’яною текстурою, стійкі до подряпин і легко очищаються.</p>
          <p>У каталозі — душові піддони зі штучного мармуру та каменю: серії з антиковзанням 3 класу та посилені моделі із запасом навантаження до 500 кг. Товщина 30–32 мм робить вхід у душ майже врівень з підлогою, а сифон і декоративна накладка входять у комплект.</p>
          <p>Space Glass підбирає піддон під конкретну душову зону та узгоджує його геометрію зі скляною перегородкою, дверима або кабіною ще до виробництва скла.</p>
        </div>
        <ul class="category-intro__spec">
          <li><b>Штучний камінь і мармур</b><span>кварцова сировина, матова кам’яна текстура</span></li>
          <li><b>Товщина піддону 30–32 мм</b><span>майже врівень вхід у душ</span></li>
          <li><b>Антиковзання</b><span>клас 3 у мармурових серіях</span></li>
          <li><b>Сифон у комплекті</b><span>сифон + декоративна накладка</span></li>
        </ul>
      </div>
    </section>

    <section id="catalog" class="category-section">
      <div class="category-heading"><div><p class="eyebrow">Каталог</p><h2>Каталог душових піддонів</h2></div><p>Піддони зі штучного мармуру та каменю.<br class="piddon-desktop-break" /> Оберіть розмір і колір — вартість оновиться одразу.</p></div>
      <div class="piddon-grid">
        {piddonySeries.map((series, i) => {
          const init = cardInit[i];
          const cover = series.images[0];
          const maxW = cover.widths[cover.widths.length - 1];
          return (
            <article class:list={['piddon-card', `piddon-card--${series.mediaTone}`]} data-piddon-card>
              <div class="piddon-card__media" data-gallery>
                <img
                  class="piddon-card__photo"
                  data-gallery-main
                  src={`${cover.base}-480.webp`}
                  srcset={`${cover.base}-480.webp 480w, ${cover.base}-${maxW}.webp ${maxW}w`}
                  sizes="(max-width: 700px) 90vw, (max-width: 1100px) 44vw, 30vw"
                  alt={cover.alt}
                  width={cover.w}
                  height={cover.h}
                  loading="lazy"
                  decoding="async"
                />
                <span class="piddon-card__badge">{series.formatBadge}</span>
                <span class="piddon-card__delivery-badge">✓ Безкоштовна доставка</span>
                {series.images.length > 1 && (
                  <div class="piddon-card__thumbs" role="group" aria-label="Фотографії піддона">
                    {series.images.map((img, idx) => {
                      const iMax = img.widths[img.widths.length - 1];
                      return (
                        <button
                          type="button"
                          class="piddon-card__thumb"
                          data-thumb
                          data-src={`${img.base}-480.webp`}
                          data-srcset={`${img.base}-480.webp 480w, ${img.base}-${iMax}.webp ${iMax}w`}
                          data-alt={img.alt}
                          data-color={img.color ?? ''}
                          aria-label={img.alt}
                          aria-current={idx === 0 ? 'true' : 'false'}
                        >
                          <img src={`${img.base}-480.webp`} alt="" width="80" height="80" loading="lazy" decoding="async" />
                        </button>
                      );
                    })}
                  </div>
                )}
              </div>

              <div class="piddon-card__body">
                <h3>{series.publicName}</h3>
                <p class="piddon-card__formats">{series.formatsLabel}</p>
                <p class="piddon-card__blurb">{series.blurb}</p>

                <div class="piddon-picker" data-picker data-name={series.publicName} data-variants={JSON.stringify(series.variants)}>
                  <fieldset class="piddon-picker__group">
                    <legend>Розмір, мм</legend>
                    <div class="piddon-picker__opts">
                      {series.sizes.map((sz) => {
                        const avail = sizeAvailable(series, sz);
                        const selected = sz === init.size;
                        return (
                          <button
                            type="button"
                            class:list={['piddon-size', selected && 'is-selected', !avail && 'is-unavailable']}
                            data-size={sz}
                            data-available={avail ? 'true' : 'false'}
                            aria-pressed={selected ? 'true' : 'false'}
                          >{sz}</button>
                        );
                      })}
                    </div>
                  </fieldset>

                  {series.colors.length > 1 && (
                    <fieldset class="piddon-picker__group">
                      <legend>Колір</legend>
                      <div class="piddon-colors" role="radiogroup">
                        {series.colors.map((c, ci) => (
                          <label class="piddon-color">
                            <input type="radio" name={`color-${series.id}`} value={c} data-color checked={ci === 0} />
                            <span>{c}</span>
                          </label>
                        ))}
                      </div>
                    </fieldset>
                  )}

                  <div class="piddon-picker__out">
                    <div class="piddon-picker__price">
                      <strong data-price class:list={[!init.known && 'is-unknown']}>{init.priceLabel}</strong>
                      <span data-price-note hidden={!init.known}>орієнтовна ціна за обраний розмір</span>
                    </div>
                    <div class="piddon-free-delivery" aria-label="Безкоштовна доставка">✓ Безкоштовна доставка</div>
                    <a class="button button--mint piddon-picker__cta" data-cta href={init.ctaHref}>{init.ctaLabel}</a>
                  </div>
                </div>

                <dl class="piddon-card__specs">
                  <div><dt>Матеріал</dt><dd>{series.material}</dd></div>
                  <div><dt>Товщина піддону</dt><dd>{series.thickness}</dd></div>
                  <div><dt>Вага</dt><dd>{series.weight}</dd></div>
                  <div><dt>Макс. навантаження</dt><dd>{series.maxLoad}</dd></div>
                  {series.antiSlip && <div><dt>Антиковзання</dt><dd>{series.antiSlip}</dd></div>}
                  <div><dt>Комплектація</dt><dd>{series.kit}</dd></div>
                </dl>
                <p class="piddon-card__meta"><b>Розміри, мм:</b> {series.sizes.join(' · ')}</p>
                <p class="piddon-card__meta"><b>Колір:</b> {series.colors.join(' · ')}</p>
              </div>
            </article>
          );
        })}
      </div>
      <p class="piddon-note piddon-catalog-note">{priceDisclaimer}</p>
    </section>

    <section class="category-section category-section--mint">
      <div class="category-heading"><div><p class="eyebrow">Швидкий вибір</p><h2>Оберіть за формою та розміром</h2></div><p>Форма залежить від планування, розмір<br class="piddon-desktop-break" /> — від фактичної мокрої зони та місця під скло.</p></div>

      <div class="material-subblock">
        <h3>За формою</h3>
        <div class="category-icon-grid">
