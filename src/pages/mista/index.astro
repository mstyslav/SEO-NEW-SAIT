---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { seoPages } from '../../data/seo-pages';
const pages = seoPages.filter((page) => page.kind === 'city');
---
<BaseLayout title="Скляні конструкції у містах України | Space Glass" description="Локальні сторінки Space Glass: скляні конструкції, замір, виготовлення, доставка та монтаж у ключових містах України.">
  <Header />
  <main id="main" class="hub">
    <p class="eyebrow">Локальне SEO</p><h1>Скляні конструкції у містах України</h1><p class="lead">Замір, виготовлення, доставка та монтаж у ключових регіонах.</p>
    <div class="grid">{pages.map((page) => <a href={`/${page.slug}/`}><h2>{page.h1}</h2><p>{page.intro}</p><b>Відкрити сторінку →</b></a>)}</div>
  </main><Footer />
</BaseLayout>
<style>.hub{padding:70px clamp(22px,5vw,80px)}h1{font-size:clamp(44px,7vw,88px);line-height:1}.lead{font-size:22px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:48px}.grid a{padding:28px;border:1px solid #d9e7df;border-radius:18px;color:inherit;text-decoration:none}.grid p{line-height:1.65}@media(max-width:850px){.grid{grid-template-columns:1fr 1fr}}@media(max-width:560px){.grid{grid-template-columns:1fr}}</style>
