.about-directions__list a { display: flex; min-height: 88px; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 22px; color: var(--ink); font-size: 14px; font-weight: 700; line-height: 1.4; text-decoration: none; }
.about-directions__arrow { width: 18px; height: 18px; flex: 0 0 18px; color: var(--green-deep); fill: none; stroke: currentColor; stroke-width: 1.35; stroke-linecap: round; stroke-linejoin: round; }
