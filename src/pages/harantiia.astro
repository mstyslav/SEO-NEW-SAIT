---
import LegalStructuredPage from '../components/LegalStructuredPage.astro';
import { localeFromPath, normalizeLocale } from '../i18n/helpers';
const locale = normalizeLocale(Astro.props.locale ?? localeFromPath(Astro.url.pathname));
const isRussian = locale === 'ru';
const title = isRussian ? 'Условия гарантии' : 'Умови гарантії';
const description = isRussian ? 'Гарантия Space Glass на стеклянные конструкции, фурнитуру и монтаж: срок 2 года, исключения и порядок обращения.' : 'Гарантія Space Glass на скляні конструкції, фурнітуру та монтаж: строк 2 роки, винятки і порядок звернення.';
const sections = isRussian ? [
  ['1. Основная гарантия', 'Гарантия Space Glass составляет 2 года на изготовленные или поставленные конструкции, если иной срок прямо не согласован в документах заказа.'],
  ['2. Изделие и производство', 'Гарантия распространяется на производственные недостатки, несоответствие согласованной спецификации и дефекты материалов, существовавшие до передачи изделия Покупателю.'],
  ['3. Фурнитура', 'Фурнитура обслуживается в пределах гарантийных условий производителя или условий Space Glass, если она поставлена Space Glass в составе заказа.'],
  ['4. Монтаж', 'Гарантия на монтаж действует только в случае, когда монтаж выполняли специалисты Space Glass. Space Glass не обещает гарантию на работы третьих лиц или самостоятельный монтаж.'],
  ['5. Исключения', 'Гарантия не покрывает механические повреждения после приёмки, неправильную эксплуатацию или уход, самостоятельное сверление, резку, регулировку или изменение конструкции, деформацию оснований, стен или проёмов и последствия стороннего монтажа.'],
  ['6. Как обратиться', 'Направьте номер или описание заказа, фото или видео дефекта, дату обнаружения и контакты на info@space-glass.com.ua. После проверки Space Glass предложит соответствующее обстоятельствам решение: ремонт, замену элемента, регулировку или другой способ устранения недостатка.']
] : [
  ['1. Основна гарантія', 'Гарантія Space Glass становить 2 роки на виготовлені або поставлені конструкції, якщо інший строк прямо не погоджено у документах замовлення.'],
  ['2. Виріб і виробництво', 'Гарантія поширюється на виробничі недоліки, невідповідність погодженій специфікації та дефекти матеріалів, які існували до передачі виробу Покупцю.'],
  ['3. Фурнітура', 'Фурнітура обслуговується в межах гарантійних умов виробника або умов Space Glass, якщо її поставила Space Glass у складі замовлення.'],
  ['4. Монтаж', 'Гарантія на монтаж застосовується лише тоді, коли монтаж виконували фахівці Space Glass. Space Glass не обіцяє гарантію на роботи третіх осіб або самостійний монтаж.'],
  ['5. Винятки', 'Гарантія не покриває механічні пошкодження після приймання, неправильну експлуатацію або догляд, самостійне свердління, різання, регулювання чи зміну конструкції, деформацію основ, стін або прорізів і наслідки стороннього монтажу.'],
  ['6. Як звернутися', 'Надішліть номер або опис замовлення, фото чи відео дефекту, дату виявлення та контакти на info@space-glass.com.ua. Після перевірки Space Glass запропонує відповідне обставинам рішення: ремонт, заміну елемента, регулювання або інший спосіб усунення недоліку.']
];
const faq = isRussian ? [{question:'Каков срок гарантии?',answer:'Основной срок гарантии Space Glass — 2 года, если для конкретного изделия письменно не согласовано иное.'},{question:'Действует ли гарантия на сторонний монтаж?',answer:'Space Glass не предоставляет гарантию на работы третьих лиц; связанные с таким монтажом недостатки не покрываются.'}] : [{question:'Який строк гарантії?',answer:'Основний строк гарантії Space Glass — 2 роки, якщо для конкретного виробу письмово не погоджено інше.'},{question:'Чи діє гарантія на сторонній монтаж?',answer:'Space Glass не надає гарантію на роботи третіх осіб; пов’язані з таким монтажем недоліки не покриваються.'}];
const toc = sections.map(([label], index) => ({ id: `section-${index + 1}`, label }));
---
<LegalStructuredPage locale={locale} title={title} description={description} faq={faq} toc={toc} updated={isRussian ? '4 августа 2026' : '4 серпня 2026'}>
  {sections.map(([heading, text], index) => <section id={toc[index].id}><h2>{heading}</h2><p>{text}</p></section>)}
</LegalStructuredPage>
