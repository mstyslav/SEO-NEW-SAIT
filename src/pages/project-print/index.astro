---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Проєкт Space Glass"
  description="Резюме проєкту Space Glass для друку або збереження у PDF."
>
  <main class="print-project">
    <header class="print-project__header">
      <img src="/images/space-glass-brand-logo.jpg" alt="Space Glass" width="180" height="140" />
      <div>
        <p>SPACE GLASS</p>
        <h1>Резюме проєкту</h1>
        <span data-print-date></span>
      </div>
    </header>

    <section class="print-project__summary">
      <div><span>Кількість позицій</span><b data-print-count>0</b></div>
      <div><span>Попередня сума</span><b data-print-total>0 грн</b></div>
    </section>

    <section class="print-project__items" data-print-items></section>

    <section class="print-project__note">
      <h2>Коментар</h2>
      <p data-print-note>—</p>
    </section>

    <footer class="print-project__footer">
      <p>Попередня сума не є офертою. Фінальна вартість підтверджується менеджером Space Glass після перевірки розмірів, матеріалів, доставки та монтажних умов.</p>
      <div>
        <span>space-glass.com.ua</span>
        <span>info@space-glass.com.ua</span>
        <span>+38 (073) 425 14 00</span>
      </div>
    </footer>

    <button class="print-project__button" type="button" onclick="window.print()">Зберегти як PDF / Друк</button>
  </main>

  <script>
    const money = (value) => `${Math.round(value).toLocaleString('uk-UA')} грн`;
    let project = { items: [], note: '' };

    try {
      project = JSON.parse(localStorage.getItem('spaceGlassProject') || '{"items":[],"note":""}');
    } catch {}

    const items = Array.isArray(project.items) ? project.items : [];
    const count = items.reduce((sum, item) => sum + Number(item.quantity || 1), 0);
    const total = items.reduce((sum, item) => sum + Number(item.price || 0) * Number(item.quantity || 1), 0);

    document.querySelector('[data-print-date]').textContent =
      new Date().toLocaleDateString('uk-UA');
    document.querySelector('[data-print-count]').textContent = count;
    document.querySelector('[data-print-total]').textContent = money(total);
    document.querySelector('[data-print-note]').textContent = project.note || '—';

    document.querySelector('[data-print-items]').innerHTML = items.map((item, index) => `
      <article class="print-project-item">
        <img src="${item.image || '/images/s20/product-main.webp'}" alt="" />
        <div>
          <small>${item.category || 'Space Glass'}</small>
          <h2>${index + 1}. ${item.name || 'Конструкція'}</h2>
          <p>${item.configuration || 'Індивідуальна конфігурація'}</p>
          <dl>
            <div><dt>Кількість</dt><dd>${item.quantity || 1}</dd></div>
            <div><dt>Попередня ціна</dt><dd>${money(Number(item.price || 0) * Number(item.quantity || 1))}</dd></div>
          </dl>
        </div>
      </article>
    `).join('');
  </script>
</BaseLayout>
