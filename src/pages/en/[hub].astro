---
// EN product and service hub pages — every route of kind "hub" in src/i18n/intl-routes.ts.
import IntlHubPage from '../../components/intl/IntlHubPage.astro';
import { INTL_ROUTES, assertIntlRoute, intlSlug } from '../../i18n/intl-routes';

export function getStaticPaths() {
  return INTL_ROUTES.filter((route) => route.kind === 'hub').map((route) => ({ params: { hub: intlSlug(route, 'en') }, props: { id: route.id } }));
}

const { id } = Astro.props;
assertIntlRoute(Astro.url.pathname, id, 'en');
---
<IntlHubPage locale="en" id={id} />
