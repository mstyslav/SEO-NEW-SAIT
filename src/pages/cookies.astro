---
import LegalStructuredPage from '../components/LegalStructuredPage.astro';
import { localeFromPath, normalizeLocale, localizedPath } from '../i18n/helpers';
const locale = normalizeLocale(Astro.props.locale ?? localeFromPath(Astro.url.pathname));
const isRussian = locale === 'ru';
const title = isRussian ? 'Политика использования Cookie' : 'Політика використання Cookie';
const description = isRussian ? 'Какие cookies может использовать Space Glass, как управлять согласием и изменять настройки конфиденциальности.' : 'Які cookies може використовувати Space Glass, як керувати згодою та змінювати налаштування приватності.';
const labels = isRussian ? ['Необходимые cookies', 'Аналитические cookies', 'Маркетинговые cookies', 'Встроенный контент', 'Управление согласием', 'Категории cookies'] : ['Необхідні cookies', 'Аналітичні cookies', 'Маркетингові cookies', 'Вбудований контент', 'Керування згодою', 'Категорії cookies'];
const toc = labels.map((label, index) => ({ id: `section-${index + 1}`, label: `${index + 1}. ${label}` }));
const text = isRussian ? {
  necessary: 'Необходимые cookies и записи localStorage обеспечивают основные функции сайта, проекта или корзины, конфигуратора, безопасность форм и сохранение выбора согласия. Их нельзя отключить через баннер, поскольку они необходимы для запрошенного сервиса.',
  analytics: 'Аналитические cookies могут помогать понять использование страниц. Они загружаются только после согласия там, где это технически поддерживается. Space Glass не утверждает, что GA4, Meta Pixel или иной инструмент активен, если его подключение не подтверждено кодом сайта.',
  marketing: 'Маркетинговые cookies могут использоваться для персонализации рекламы или измерения кампаний только после фактического подключения соответствующего инструмента и, когда требуется, после согласия пользователя.',
  embeds: 'Страницы могут содержать карты, видео, социальные ссылки или другой внешний контент. Такой поставщик может обрабатывать технические данные и устанавливать собственные cookies при загрузке или взаимодействии согласно своим условиям. Где это поддерживается, необязательный контент не загружается до согласия.',
  consent: 'Вы можете разрешить необязательные cookies либо оставить только необходимые. Чтобы изменить выбор, откройте настройки ниже. Также можно удалить cookies и данные сайта средствами браузера; после этого сайт снова запросит выбор.',
  button: 'Настройки Cookie', privacy: 'Политика конфиденциальности', category: 'Категория', purpose: 'Назначение', required: 'Согласие', no: 'Не требуется', yes: 'Требуется', depends: 'Зависит от сервиса'
} : {
  necessary: 'Необхідні cookies і записи localStorage забезпечують основні функції сайту, проєкту або кошика, конфігуратора, безпеку форм і збереження вибору згоди. Їх не можна вимкнути через банер, оскільки вони потрібні для запитаного сервісу.',
  analytics: 'Аналітичні cookies можуть допомагати зрозуміти використання сторінок. Вони завантажуються лише після згоди там, де це технічно підтримується. Space Glass не стверджує, що GA4, Meta Pixel або інший інструмент активний, якщо його підключення не підтверджене кодом сайту.',
  marketing: 'Маркетингові cookies можуть використовуватися для персоналізації реклами або вимірювання кампаній лише після фактичного підключення відповідного інструмента і, коли це потрібно, після згоди користувача.',
  embeds: 'Сторінки можуть містити карти, відео, соціальні посилання або інший зовнішній контент. Такий постачальник може обробляти технічні дані та встановлювати власні cookies під час завантаження або взаємодії згідно зі своїми умовами. Де це підтримується, необов’язковий контент не завантажується до згоди.',
  consent: 'Ви можете дозволити необов’язкові cookies або залишити лише необхідні. Щоб змінити вибір, відкрийте налаштування нижче. Також можна видалити cookies і дані сайту засобами браузера; після цього сайт знову запропонує вибір.',
  button: 'Налаштування Cookie', privacy: 'Політика конфіденційності', category: 'Категорія', purpose: 'Призначення', required: 'Згода', no: 'Не потрібна', yes: 'Потрібна', depends: 'Залежить від сервісу'
};
---
<LegalStructuredPage locale={locale} title={title} description={description} toc={toc} updated={isRussian ? '4 августа 2026' : '4 серпня 2026'}>
  <section id={toc[0].id}><h2>{toc[0].label}</h2><p>{text.necessary}</p></section>
  <section id={toc[1].id}><h2>{toc[1].label}</h2><p>{text.analytics}</p></section>
  <section id={toc[2].id}><h2>{toc[2].label}</h2><p>{text.marketing}</p></section>
  <section id={toc[3].id}><h2>{toc[3].label}</h2><p>{text.embeds}</p></section>
  <section id={toc[4].id}><h2>{toc[4].label}</h2><p>{text.consent}</p><button class="button button--mint" type="button" data-cookie-settings>{text.button}</button><p><a href={localizedPath('/privacy/', locale)}>{text.privacy}</a></p></section>
  <section id={toc[5].id}><h2>{toc[5].label}</h2><div class="legal-table-wrap"><table><thead><tr><th>{text.category}</th><th>{text.purpose}</th><th>{text.required}</th></tr></thead><tbody><tr><td>{labels[0]}</td><td>{isRussian ? 'Работа сайта, формы, проект и сохранение выбора' : 'Робота сайту, форми, проєкт і збереження вибору'}</td><td>{text.no}</td></tr><tr><td>{labels[1]}</td><td>{isRussian ? 'Статистика, если инструмент подключён' : 'Статистика, якщо інструмент підключений'}</td><td>{text.yes}</td></tr><tr><td>{labels[2]}</td><td>{isRussian ? 'Реклама, если инструмент подключён' : 'Реклама, якщо інструмент підключений'}</td><td>{text.yes}</td></tr><tr><td>{labels[3]}</td><td>{isRussian ? 'Карты, видео и внешние виджеты' : 'Карти, відео та зовнішні віджети'}</td><td>{text.depends}</td></tr></tbody></table></div></section>
  <script>document.querySelector('[data-cookie-settings]')?.addEventListener('click', () => { localStorage.removeItem('sg-cookie-consent'); location.reload(); });</script>
</LegalStructuredPage>
