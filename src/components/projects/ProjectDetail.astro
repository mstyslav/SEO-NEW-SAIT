---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import FAQBlock from '../FAQBlock.astro';
import GoogleReviews from '../GoogleReviews.astro';
import ProjectGallery from './ProjectGallery.astro';
import ProjectCard from './ProjectCard.astro';
import ProjectRequestForm from './ProjectRequestForm.astro';
import { projectCategoryMap } from '../../data/project-taxonomy';
import { buildProjectFaq } from '../../data/project-faq';
import { buildProjectFacts } from '../../data/project-facts';
import { projectRequestExample } from '../../data/project-request-examples';
import { absoluteUrl, breadcrumbSchema, faqSchema, type JsonLdObject } from '../../seo/schema';
import { localizeProjectRu } from '../../data/ru/projects.ru';
import { buildProjectFactsRu, buildProjectFaqRu, projectRequestExampleRu } from '../../data/ru/project-helpers.ru';
import { hasLocalizedRoute, localizedPath, type Locale } from '../../i18n/helpers';
import '../../styles/projects-common.css';
import '../../styles/project-detail-v2.css';
import fs from 'node:fs';
import path from 'node:path';

const { project: sourceProject, relatedProjects = [], locale = 'uk' as Locale } = Astro.props;
const isRu = locale === 'ru';
const lp = (path: string) => localizedPath(path, locale);
// RU pages render the same UA entity with its RU texts merged in (src/data/ru/projects.ru.ts).
const project = isRu ? localizeProjectRu(sourceProject) : sourceProject;
const origin = Astro.site ?? Astro.url.origin;
// Unprefixed path for UA: the canonical URL regardless of which route
// (/project/ or the /uk/project/ duplicate) actually rendered the page —
// matches BaseLayout's own stripLocale()/localizedPath() canonical logic and
// what sitemap.xml.ts lists, so structured data always describes the real
// canonical URL instead of the redundant /uk/-prefixed one. RU: /ru/project/{slug}/.
const projectPath = lp(`/project/${project.slug}/`);
const canonical = absoluteUrl(projectPath, origin);
const hasRu = hasLocalizedRoute(`/project/${project.slug}/`, 'ru');
const category = projectCategoryMap[project.category];
const categoryLabel = isRu ? category.labelRu : category.label;
const projectFaq = isRu ? buildProjectFaqRu(project) : buildProjectFaq(project);
const faqItems = projectFaq.map(({ question, answer }) => [question, answer] as [string, string]);
const requestExample = isRu ? projectRequestExampleRu(project) : projectRequestExample(project);
const projectFacts = isRu ? buildProjectFactsRu(project) : buildProjectFacts(project);
const tx = {
  uk: {
    home: 'Головна', projects: 'Наші проєкти', breadcrumbs: 'Хлібні крихти', cta: 'Розрахувати подібний проєкт', factsLabel: 'Характеристики проєкту',
    task: 'Задача клієнта', solution: 'Рішення Space Glass', gallery: 'Фото в інтер’єрі', materials: 'Матеріали', installation: 'Монтаж', result: 'Результат',
    data: 'Дані реалізованого проєкту', priceEyebrow: 'Вартість', priceTitle: 'Вартість подібного рішення', from: 'Від', perM2: 'грн/м²', numLocale: 'uk-UA',
    priceText: 'Вартість розраховується індивідуально та залежить від розмірів конструкції, типу скла, профілю, фурнітури та складності монтажу.',
    priceCta: 'Розрахувати вартість за моїми розмірами', serviceEyebrow: 'Від рішення до замовлення', serviceTitle: 'Потрібне схоже рішення?',
    faqPrefix: 'Питання', faqIntro: 'Відповіді про розрахунок, індивідуальні розміри, матеріали, монтаж і догляд.', relatedEyebrow: 'Схожі проєкти', relatedTitle: 'Інші реалізовані рішення'
  },
  ru: {
    home: 'Главная', projects: 'Наши проекты', breadcrumbs: 'Хлебные крошки', cta: 'Рассчитать похожий проект', factsLabel: 'Характеристики проекта',
    task: 'Задача клиента', solution: 'Решение Space Glass', gallery: 'Фото в интерьере', materials: 'Материалы', installation: 'Монтаж', result: 'Результат',
    data: 'Данные реализованного проекта', priceEyebrow: 'Стоимость', priceTitle: 'Стоимость похожего решения', from: 'От', perM2: 'грн/м²', numLocale: 'ru-UA',
    priceText: 'Стоимость рассчитывается индивидуально и зависит от размеров конструкции, типа стекла, профиля, фурнитуры и сложности монтажа.',
    priceCta: 'Рассчитать стоимость по моим размерам', serviceEyebrow: 'От решения к заказу', serviceTitle: 'Нужно похожее решение?',
    faqPrefix: 'Вопросы', faqIntro: 'Ответы о расчёте, индивидуальных размерах, материалах, монтаже и уходе.', relatedEyebrow: 'Похожие проекты', relatedTitle: 'Другие реализованные решения'
  }
}[isRu ? 'ru' : 'uk'];

const projectSchema: JsonLdObject = {
  '@type': 'CreativeWork',
  '@id': `${canonical}#project`,
  url: canonical,
  name: project.h1,
  headline: project.h1,
  description: project.seo.description,
  inLanguage: locale,
  image: [project.cover, ...project.gallery].map((image) => ({
    '@type': 'ImageObject',
    url: absoluteUrl(image.src, origin),
    width: image.width,
    height: image.height,
    caption: image.caption ?? image.alt
  })),
  creator: { '@id': `${new URL('/', origin).href}#organization` },
  ...(project.city ? { locationCreated: { '@type': 'Place', name: project.city } } : {}),
  about: [project.constructionType, categoryLabel]
};

const breadcrumbItems = [
  { label: tx.home, href: lp('/') },
  { label: tx.projects, href: lp('/project/') },
  { label: project.h1, href: projectPath }
];

const structuredData = [
  projectSchema,
  breadcrumbSchema(breadcrumbItems.map((item) => ({ label: item.label, href: absoluteUrl(item.href, origin) }))),
  faqSchema(projectFaq)
].filter(Boolean) as JsonLdObject[];

// Hero (LCP) image: responsive variants live next to the cover as `-{width}.webp` (same
// convention as the project cards); only widths whose file exists are offered.
const coverVariant = (w: number) => project.cover.src.replace(/\.webp$/, `-${w}.webp`);
const heroSrcset = [480, 720, 960]
  .filter((w) => w < project.cover.width && fs.existsSync(path.join(process.cwd(), 'public', coverVariant(w))))
  .map((w) => `${coverVariant(w)} ${w}w`)
  .concat(`${project.cover.src} ${project.cover.width}w`)
  .join(', ');
// Mirrors project-detail-v2.css: full width under 1050px (16px / 58px gutters), 1.05fr column above.
const heroSizes = '(max-width: 700px) calc(100vw - 32px), (max-width: 1050px) calc(100vw - 116px), calc((min(1380px, 100vw - 116px) - 28px) * 0.525)';
---
<BaseLayout
  title={project.seo.title}
  description={project.seo.description}
  locale={locale}
  image={project.cover.src}
  structuredData={structuredData}
  alternateLocales={hasRu ? ['uk', 'ru'] : ['uk']}
  heroPreloadSrc={project.cover.src}
  heroPreloadSrcset={heroSrcset}
  heroPreloadSizes={heroSizes}
>
  <div class="sg-page-shell">
    <Header locale={locale} />
    <main id="main" class="project-detail-v2">
      <nav class="project-detail-v2__breadcrumbs" aria-label={tx.breadcrumbs}>
        {breadcrumbItems.map((item, index) => (
          <>
            {index > 0 && <span aria-hidden="true">/</span>}
            {index === breadcrumbItems.length - 1
              ? <span aria-current="page">{item.label}</span>
              : <a href={item.href}>{item.label}</a>}
          </>
        ))}
      </nav>

      <section class="project-detail-v2__hero">
        <div class="project-detail-v2__hero-copy">
          <p class="eyebrow">{[project.city, project.objectType].filter(Boolean).join(' / ')}</p>
          <h1>{project.h1}</h1>
          <p class="lead">{project.shortDescription}</p>
          <a class="button button--mint" href="#project-request">{tx.cta}</a>
        </div>
        <div class="project-detail-v2__hero-media">
          <img src={project.cover.src} srcset={heroSrcset} sizes={heroSizes} width={project.cover.width} height={project.cover.height} alt={project.cover.alt} loading="eager" decoding="async" fetchpriority="high" />
        </div>
      </section>

      <section class="project-detail-v2__facts" aria-label={tx.factsLabel}>
        {project.characteristics.map(({ label, value }) => <div><b>{label}</b><span>{value}</span></div>)}
      </section>

      <div class="project-detail-v2__wrap">
        <section class="project-detail-v2__story">
          <article><p class="eyebrow">{tx.task}</p><h2>{project.clientTask.title}</h2><p>{project.clientTask.text}</p></article>
          <article><p class="eyebrow">{tx.solution}</p><h2>{project.solution.title}</h2><p>{project.solution.text}</p></article>
        </section>

        <ProjectGallery images={project.gallery} cover={project.cover} title={`${tx.gallery}: ${project.constructionType}`} locale={locale} />

        <section class="project-detail-v2__technical">
          <article><p class="eyebrow">{tx.materials}</p><h2>{tx.materials}: {project.constructionType}</h2><ul>{project.materials.map((material) => <li>{material}</li>)}</ul></article>
          <article><p class="eyebrow">{tx.installation}</p><h2>{project.installation.title}</h2><p>{project.installation.text}</p></article>
          <article><p class="eyebrow">{tx.result}</p><h2>{project.result.title}</h2><p>{project.result.text}</p></article>
        </section>

        {projectFacts.length > 0 && (
          <section class="project-detail-v2__data" aria-label={tx.data}>
            <p class="eyebrow">{tx.data}</p>
            <dl>
              {projectFacts.map(({ label, value }) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
            </dl>
          </section>
        )}

        <section class="project-detail-v2__price">
          <p class="eyebrow">{tx.priceEyebrow}</p>
          <h2>{tx.priceTitle}</h2>
          {project.priceFromPerM2 && (
            <p class="project-detail-v2__price-value">{tx.from} {project.priceFromPerM2.toLocaleString(tx.numLocale)} {tx.perM2}</p>
          )}
          <p>
            {tx.priceText}
            {project.priceNote && ` ${project.priceNote}`}
          </p>
          <a class="button button--mint" href="#project-request">{tx.priceCta}</a>
        </section>

        <aside class="project-detail-v2__service-link">
          <div><p class="eyebrow">{tx.serviceEyebrow}</p><h2>{tx.serviceTitle}</h2></div>
          <a href={lp(project.serviceLink.href)}>{project.serviceLink.label} <span aria-hidden="true">→</span></a>
        </aside>

        <section class="project-detail-v2__faq">
          <FAQBlock title={`${tx.faqPrefix}: ${project.constructionType}`} intro={tx.faqIntro} items={faqItems} visibleCount={6} locale={locale} />
        </section>

        {relatedProjects.length > 0 && (
          <section class="project-detail-v2__related">
            <div class="project-section-head-v2"><p class="eyebrow">{tx.relatedEyebrow}</p><h2>{tx.relatedTitle}</h2></div>
            <div class="projects-index-v2__grid">{relatedProjects.map((item) => <ProjectCard project={item} locale={locale} href={lp(`/project/${item.slug}/`)} />)}</div>
          </section>
        )}
      </div>

      <GoogleReviews locale={locale} />

      <ProjectRequestForm projectTitle={project.cardTitle} city={project.city ?? ''} requestExample={requestExample} locale={locale} />
    </main>
    <Footer locale={locale} />
  </div>
</BaseLayout>

<style>
  /* Project-specific additions kept local to this component rather than global.css. */
  .project-detail-v2__breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 16px max(58px, calc((100vw - 1380px) / 2)) 0;
    font-size: 12px;
    color: var(--muted);
  }
  .project-detail-v2__breadcrumbs a {
    color: var(--muted);
    text-decoration: none;
  }
  .project-detail-v2__breadcrumbs a:hover {
    color: var(--mint-dark);
  }
  .project-detail-v2__breadcrumbs span[aria-current] {
    color: var(--ink, #15201c);
    font-weight: 600;
  }
  @media (max-width: 760px) {
    .project-detail-v2__breadcrumbs {
      padding: 14px 24px 0;
      font-size: 11px;
    }
  }

  .project-detail-v2__data {
    margin-bottom: 60px;
    padding: 30px 34px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #fbfdfc;
  }
  .project-detail-v2__data dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px 28px;
    margin: 16px 0 0;
  }
  .project-detail-v2__data dl > div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }
  .project-detail-v2__data dt {
    color: var(--muted);
    font-size: 13px;
  }
  .project-detail-v2__data dd {
    margin: 0;
    font-weight: 700;
    text-align: right;
  }

  .project-detail-v2__price {
    margin-bottom: 60px;
    padding: 34px;
    border: 1px solid var(--green-line);
    border-radius: 14px;
    background: #eff9f4;
  }
  .project-detail-v2__price h2 {
    margin: 6px 0 12px;
  }
  .project-detail-v2__price-value {
    margin: 0 0 10px;
    color: var(--mint-dark);
    font-size: 22px;
    font-weight: 800;
  }
  .project-detail-v2__price p {
    max-width: 70ch;
    margin: 0 0 20px;
    color: var(--muted);
  }
</style>
