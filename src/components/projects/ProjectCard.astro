---
import { projectCategoryMap } from '../../data/project-taxonomy';
import type { Locale } from '../../i18n/helpers';

const { project, hrefPrefix = '/projects', priority = false, eager = false, cardCover, locale = 'uk' as Locale } = Astro.props;
const category = projectCategoryMap[project.category];
const isRu = locale === 'ru';
const localizedHrefPrefix =
  isRu && hrefPrefix.startsWith('/') && !hrefPrefix.startsWith('/ru/')
    ? `/ru${hrefPrefix}`
    : hrefPrefix;
const href = `${localizedHrefPrefix}/${project.slug}/`;
const cardTitle = isRu && project.cardTitleRu ? project.cardTitleRu : project.cardTitle;
const city = isRu && project.cityRu ? project.cityRu : project.city;
const constructionType = isRu && project.constructionTypeRu ? project.constructionTypeRu : project.constructionType;
const shortDescription = isRu && project.shortDescriptionRu ? project.shortDescriptionRu : project.shortDescription;
const categoryLabel = isRu ? category.labelRu : category.label;
const viewProjectLabel = isRu ? 'Смотреть проект' : 'Переглянути проєкт';
const viewProjectAriaPrefix = isRu ? 'Смотреть проект:' : 'Переглянути проєкт:';
const resolvedCover = cardCover ?? project.cover;

// Generated variants live next to the original as `-{width}.webp` (see /rishennya/ for the
// same convention). Never include a width >= the native size — that would upscale.
const RESPONSIVE_WIDTHS = [480, 720, 960];
const nativeWidth = resolvedCover.width;
const srcset = RESPONSIVE_WIDTHS.filter((w) => w <= nativeWidth)
  .map((w) => {
    if (cardCover) {
      return `${resolvedCover.src.replace('-720.webp', `-${w}.webp`)} ${w}w`;
    }
    return `${w === nativeWidth ? resolvedCover.src : resolvedCover.src.replace('.webp', `-${w}.webp`)} ${w}w`;
  })
  .join(', ');
// Mirrors the grid CSS in projects-common.css: 1 column under 700px, 2 columns under 1050px, 3 above.
const sizes = '(max-width: 700px) calc(100vw - 32px), (max-width: 1050px) calc((min(1380px, 100vw - 116px) - 18px) / 2), calc((min(1380px, 100vw - 116px) - 36px) / 3)';

const loading = priority || eager ? 'eager' : 'lazy';
const fetchpriority = priority ? 'high' : eager ? 'auto' : undefined;
---
<article class="project-card-v2" data-project-card data-category={project.category} data-city={project.city}>
  <a href={href} aria-label={`${viewProjectAriaPrefix} ${cardTitle}`}>
    <div class="project-card-v2__media">
      <img
        src={resolvedCover.src}
        srcset={srcset}
        sizes={sizes}
        width={resolvedCover.width}
        height={resolvedCover.height}
        alt={resolvedCover.alt}
        loading={loading}
        decoding="async"
        fetchpriority={fetchpriority}
      />
    </div>
    <div class="project-card-v2__body">
      <p>{city} <span aria-hidden="true">/</span> {categoryLabel}</p>
      <h2>{cardTitle}</h2>
      <span class="project-card-v2__type">{constructionType}</span>
      <span class="project-card-v2__description">{shortDescription}</span>
      <b>{viewProjectLabel} <span aria-hidden="true">→</span></b>
    </div>
  </a>
</article>
