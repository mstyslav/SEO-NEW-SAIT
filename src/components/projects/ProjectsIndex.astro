---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import ProjectFilters from './ProjectFilters.astro';
import '../../styles/projects-common.css';
import '../../styles/projects-index-v2.css';

// PSI (mobile + desktop) consistently reports this card's image as the actual LCP element
// on /projects/, not just the first card in sort order — give it fetchpriority=high too.
const LCP_SLUG = 'bath-screen-akvarel-odesa';
const LCP_CARD_COVER = {
  src: '/images/projects/bath-screen-akvarel-odesa/bath-screen-akvarel-odesa-card-720.webp',
  width: 720,
  height: 540
};

const projects = (await getCollection('projects', ({ data }) => data.status === 'published' && data.locale === 'uk'))
  .map(({ data }) => data)
  .sort((a, b) => a.sortOrder - b.sortOrder);
---
<div class="projects-index-v2">
  <div class="projects-index-v2__wrap">
    <header class="projects-index-v2__hero">
      <p class="eyebrow">Наші проєкти</p>
      <h1>Реалізовані конструкції Space Glass</h1>
      <p class="lead">Показуємо задачі, технічні рішення, матеріали й результат на готових об’єктах.</p>
    </header>
    <ProjectFilters projects={projects} />
    <section class="projects-index-v2__grid" aria-label="Реалізовані проєкти">
      {projects.map((project, index) => (
        <ProjectCard
          project={project}
          hrefPrefix="/projects"
          priority={index === 0 || project.slug === LCP_SLUG}
          eager={index === 1 || index === 2}
          cardCover={project.slug === LCP_SLUG ? { ...LCP_CARD_COVER, alt: project.cover.alt } : undefined}
        />
      ))}
    </section>
    <p class="projects-index-v2__empty" data-projects-empty hidden>У цій категорії проєкти ще готуються до публікації.</p>
  </div>
</div>
