---
/**
 * Compact «орієнтовна вартість від» block for the glass partitions cluster (pilot).
 * Numbers come from src/pricing/partition-prices.ts (calculator tariffs + configs, stable rate);
 * only wording lives here. Uses the PriceBlock layout/styles (card + factors column).
 */
import { systemPricePerM2, doorPrice, examplePrice, type PartitionPriceVariant, type PartitionSystemKey, type DoorKind } from '../../pricing/partition-prices';
import { localizedPath, type Locale } from '../../i18n/helpers';
// Styles: .price-block* in category-pages.css, which every page using this block already loads.

interface Props { variant: PartitionPriceVariant; locale?: Locale }
const { variant, locale = 'uk' } = Astro.props;
const ru = locale === 'ru';

const fmt = (n: number) => n.toLocaleString('uk-UA').replace(/\s/g, ' ');
const from = (n: number, perM2 = false) => `${ru ? 'от' : 'від'} ${fmt(n)} ${ru ? 'грн' : 'грн'}${perM2 ? '/м²' : ''}`;

const L = {
  frameless: ru ? 'Безрамная (цельностеклянная)' : 'Безрамна (цільноскляна)',
  profile: ru ? 'Перегородка в профиле' : 'Перегородка в профілі',
  premium: ru ? 'Premium-система' : 'Premium-система',
  loft: ru ? 'Лофт-перегородка' : 'Loft-перегородка',
  loftStd: ru ? 'Стандартный профиль' : 'Стандартний профіль',
  loftSlim: ru ? 'Тонкий профиль' : 'Тонкий профіль',
  loftPremium: ru ? 'Premium-профиль' : 'Premium-профіль'
};

type V = { heading: string; rows: [string, PartitionSystemKey][]; loftDoors?: boolean; example: [PartitionSystemKey, DoorKind | null, string]; cta: string; systemFactor: [string, string] };
const systemFactor: [string, string] = ru ? ['Система', 'Безрамная, в профиле или лофт.'] : ['Система', 'Безрамна, у профілі або Loft.'];
const doorUa = (d: DoorKind | null) => (d === 'swing' ? 'з розпашними дверима' : d === 'sliding' ? 'з розсувними дверима' : 'без дверей');
const doorRu = (d: DoorKind | null) => (d === 'swing' ? 'с распашными дверьми' : d === 'sliding' ? 'с раздвижными дверьми' : 'без дверей');
const V: Record<PartitionPriceVariant, V> = {
  hub: { heading: ru ? 'Сколько стоит стеклянная перегородка' : 'Скільки коштує скляна перегородка', rows: [[L.frameless, 'frameless'], [L.profile, 'profile'], [L.loft, 'loft']], example: ['frameless', 'swing', ru ? 'безрамная' : 'безрамна'], cta: '/peregorodky-configurator/', systemFactor },
  loft: { heading: ru ? 'Сколько стоит лофт-перегородка' : 'Скільки коштує Loft-перегородка', rows: [[L.loftStd, 'loft'], [L.loftSlim, 'loftSlim'], [L.loftPremium, 'loftPremium']], loftDoors: true, example: ['loft', 'swing', ru ? 'лофт, стандартный профиль' : 'Loft, стандартний профіль'], cta: '/loft-configurator/', systemFactor: ru ? ['Профиль', 'Стандартный, тонкий или Premium, количество шпросов.'] : ['Профіль', 'Стандартний, тонкий або Premium, кількість шпросів.'] },
  frameless: { heading: ru ? 'Сколько стоит цельностеклянная перегородка' : 'Скільки коштує цільноскляна перегородка', rows: [[L.frameless, 'frameless'], [L.premium, 'premium']], example: ['frameless', null, ru ? 'безрамная' : 'безрамна'], cta: '/peregorodky-configurator/', systemFactor: ru ? ['Система', 'Безрамная или Premium, способ крепления.'] : ['Система', 'Безрамна або Premium, спосіб кріплення.'] },
  office: { heading: ru ? 'Сколько стоит офисная перегородка' : 'Скільки коштує офісна перегородка', rows: [[L.frameless, 'frameless'], [L.profile, 'profile'], [L.premium, 'premium']], example: ['profile', 'swing', ru ? 'в профиле' : 'у профілі'], cta: '/peregorodky-configurator/', systemFactor: ru ? ['Система', 'Безрамная, в профиле или Premium.'] : ['Система', 'Безрамна, у профілі або Premium.'] },
  interior: { heading: ru ? 'Сколько стоит межкомнатная перегородка' : 'Скільки коштує міжкімнатна перегородка', rows: [[L.frameless, 'frameless'], [L.profile, 'profile'], [L.premium, 'premium']], example: ['profile', 'swing', ru ? 'в профиле' : 'у профілі'], cta: '/peregorodky-configurator/', systemFactor: ru ? ['Система', 'Безрамная, в профиле или Premium.'] : ['Система', 'Безрамна, у профілі або Premium.'] },
  doors: { heading: ru ? 'Сколько стоит перегородка с дверьми' : 'Скільки коштує перегородка з дверима', rows: [[L.frameless, 'frameless'], [L.profile, 'profile']], example: ['frameless', 'sliding', ru ? 'безрамная' : 'безрамна'], cta: '/peregorodky-configurator/', systemFactor: ru ? ['Система', 'Безрамная или в профиле.'] : ['Система', 'Безрамна або у профілі.'] }
};
const v = V[variant];
const rows = v.rows.map(([label, key]) => [label, from(systemPricePerM2(key), true)] as const);
const doors = [doorPrice('swing', v.loftDoors), doorPrice('sliding', v.loftDoors)];
const [exKey, exDoor, exSystem] = v.example;
const ex = examplePrice(exKey, exDoor);
const dim = (mm: number) => (mm / 1000).toFixed(1).replace('.', ',');
const area = ex.areaM2.toFixed(1).replace('.', ',');
const exampleText = ru
  ? `Перегородка ${dim(ex.widthMm)} × ${dim(ex.heightMm)} м (${area} м²), ${exSystem}, ${doorRu(exDoor)}, с монтажом`
  : `Перегородка ${dim(ex.widthMm)} × ${dim(ex.heightMm)} м (${area} м²), ${exSystem}, ${doorUa(exDoor)}, з монтажем`;

const t = ru
  ? { eyebrow: 'Стоимость', kicker: 'Ориентировочная стоимость от · за 1 м² с монтажом', doors: `Двери: распашные — ${from(doors[0])}, раздвижные — ${from(doors[1])}`, example: 'Пример расчёта', cta: 'Рассчитать свой размер', note: '*Ориентировочная стоимость. Точная цена зависит от комплектации и актуального курса. Рассчитайте свой размер в калькуляторе.', factorsTitle: 'От чего зависит цена',
      factors: [['Размеры', 'Цена считается за м² полотна.'], v.systemFactor, ['Двери', 'Без дверей, распашные или раздвижные.'], ['Стекло', 'Прозрачное, матовое, тонированное или триплекс.'], ['Монтаж', 'Условия объекта, этаж и доступ.']] as [string, string][] }
  : { eyebrow: 'Вартість', kicker: 'Орієнтовна вартість від · за 1 м² з монтажем', doors: `Двері: розпашні — ${from(doors[0])}, розсувні — ${from(doors[1])}`, example: 'Приклад розрахунку', cta: 'Розрахувати свій розмір', note: '*Орієнтовна вартість. Точна ціна залежить від комплектації та актуального курсу. Розрахуйте свій розмір у калькуляторі.', factorsTitle: 'Від чого залежить ціна',
      factors: [['Розміри', 'Ціна рахується за м² полотна.'], v.systemFactor, ['Двері', 'Без дверей, розпашні чи розсувні.'], ['Скло', 'Прозоре, матове, тоноване чи триплекс.'], ['Монтаж', 'Умови об’єкта, поверх і доступ.']] as [string, string][] };
---
<section id="price" class="price-block price-block--calc">
  <div class="price-block__card">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2>{v.heading}</h2>
    <p class="price-block__kicker">{t.kicker}</p>
    <ul class="price-block__rows">
      {rows.map(([label, price]) => <li><span>{label}</span><b>{price}</b></li>)}
    </ul>
    <p class="price-block__doors">{t.doors}</p>
    <div class="price-block__example">
      <p class="price-block__example-title">{t.example}</p>
      <p>{exampleText} — <b>≈&nbsp;{fmt(ex.uah)}&nbsp;грн</b></p>
    </div>
    <a class="button button--mint" href={localizedPath(v.cta, locale)}>{t.cta}</a>
    <p class="price-block__footnote">{t.note}</p>
  </div>
  <div class="price-block__factors-wrap">
    <p class="price-block__factors-title">{t.factorsTitle}</p>
    <ul class="price-block__factors">
      {t.factors.map(([label, text]) => <li><b>{label}</b><span>{text}</span></li>)}
    </ul>
  </div>
</section>
