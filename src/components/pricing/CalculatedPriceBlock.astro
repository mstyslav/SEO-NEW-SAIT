---
/**
 * Compact «орієнтовна вартість» block for catalog pages (glass partitions, frameless glazing,
 * glass railings, windows, glass doors, showers). Numbers come from src/pricing/calculated-prices.ts (the calculators' own
 * tariffs and formulas, working rate from src/pricing/currency.ts); only wording lives here. Uses the PriceBlock layout/styles (card + factors column).
 */
import { systemPricePerM2, doorPrice, examplePrice, railingGuide, isRailingVariant, RAILING_PAGES, canopyGuide, isCanopyVariant, CANOPY_PAGES, windowMarket, isWindowVariant, isDoorVariant, DOOR_PAGES, isShowerVariant, type PriceVariant, type RailingVariant, type CanopyVariant, type WindowVariant, type DoorVariant, type ShowerVariant, type SystemKey, type DoorKind, type DoorSet } from '../../pricing/calculated-prices';
import { SYSTEMS as RAILING_SYSTEMS } from '../../data/railing-pricing';
import { WINDOW_INSTALL_FROM_UAH_PER_M2, type Sash } from '../../pricing/window-pricing';
import { DOOR_MARKET, type DoorType } from '../../pricing/door-pricing';
import { SHOWER_TYPICAL, SHOWER_HUB_FROM_UAH, type ShowerTypicalKey } from '../../pricing/shower-pricing';
import { localizedPath, type Locale } from '../../i18n/helpers';
// Styles: .price-block* in category-pages.css, which every page using this block already loads.

interface Props { variant: PriceVariant; locale?: Locale }
const { variant, locale = 'uk' } = Astro.props;
const ru = locale === 'ru';

const fmt = (n: number) => n.toLocaleString('uk-UA').replace(/\s/g, ' ');
const from = (n: number, perM2 = false) => `${ru ? 'от' : 'від'} ${fmt(n)} грн${perM2 ? '/м²' : ''}`;

const L = {
  frameless: ru ? 'Безрамная (цельностеклянная)' : 'Безрамна (цільноскляна)',
  profile: ru ? 'Перегородка в профиле' : 'Перегородка в профілі',
  premium: 'Premium-система',
  loft: ru ? 'Лофт-перегородка' : 'Loft-перегородка',
  loftStd: ru ? 'Стандартный профиль' : 'Стандартний профіль',
  loftSlim: ru ? 'Тонкий профиль' : 'Тонкий профіль',
  loftPremium: ru ? 'Premium-профиль' : 'Premium-профіль',
  folding: ru ? 'Поворотно-складное («книжка»)' : 'Поворотно-складне («книжка»)',
  sliding: ru ? 'Раздвижное (слайдинг)' : 'Розсувне (слайдинг)'
};

type Example = { key: SystemKey; door?: DoorKind; ua: string; ru: string };
type V = { heading: string; rows: [string, SystemKey][]; doors?: DoorSet; example: Example; cta: string; factors: [string, string][] };

// Price factors: partitions vs frameless glazing (system factor varies per page).
const partitionFactors = (system: [string, string]): [string, string][] => ru
  ? [['Размеры', 'Цена считается за м² полотна.'], system, ['Двери', 'Без дверей, распашные или раздвижные.'], ['Стекло', 'Прозрачное, матовое, тонированное или триплекс.'], ['Монтаж', 'Условия объекта, этаж и доступ.']]
  : [['Розміри', 'Ціна рахується за м² полотна.'], system, ['Двері', 'Без дверей, розпашні чи розсувні.'], ['Скло', 'Прозоре, матове, тоноване чи триплекс.'], ['Монтаж', 'Умови об’єкта, поверх і доступ.']];
const glazingFactors: [string, string][] = ru
  ? [['Размеры проёма', 'Цена считается за м² остекления.'], ['Тип открывания', 'Поворотно-складное или раздвижное.'], ['Стекло', 'Закалённое 8–10 мм, прозрачное или тонированное.'], ['Профиль и порог', 'Цвет профиля, высота порога, угловые соединения.'], ['Монтаж', 'Основание, высота и доступ к проёму.']]
  : [['Розміри прорізу', 'Ціна рахується за м² скління.'], ['Тип відкривання', 'Поворотно-складне чи розсувне.'], ['Скло', 'Загартоване 8–10 мм, прозоре чи тоноване.'], ['Профіль і поріг', 'Колір профілю, висота порога, кутові з’єднання.'], ['Монтаж', 'Основа, висота й доступ до прорізу.']];

const P = (ua: string, r: string) => (ru ? r : ua);
const V: Record<Exclude<PriceVariant, RailingVariant | CanopyVariant | WindowVariant | DoorVariant | ShowerVariant>, V> = {
  'partition-hub': { heading: P('Скільки коштує скляна перегородка', 'Сколько стоит стеклянная перегородка'), rows: [[L.frameless, 'frameless'], [L.profile, 'profile'], [L.loft, 'loft']], doors: 'partition', example: { key: 'frameless', door: 'swing', ua: 'Перегородка {d}, безрамна, з розпашними дверима', ru: 'Перегородка {d}, безрамная, с распашными дверьми' }, cta: '/peregorodky-configurator/', factors: partitionFactors(P('Система|Безрамна, у профілі або Loft.', 'Система|Безрамная, в профиле или лофт.').split('|') as [string, string]) },
  'partition-loft': { heading: P('Скільки коштує Loft-перегородка', 'Сколько стоит лофт-перегородка'), rows: [[L.loftStd, 'loft'], [L.loftSlim, 'loftSlim'], [L.loftPremium, 'loftPremium']], doors: 'loft', example: { key: 'loft', door: 'swing', ua: 'Перегородка {d}, Loft, стандартний профіль, з розпашними дверима', ru: 'Перегородка {d}, лофт, стандартный профиль, с распашными дверьми' }, cta: '/loft-configurator/', factors: partitionFactors(P('Профіль|Стандартний, тонкий або Premium, кількість шпросів.', 'Профиль|Стандартный, тонкий или Premium, количество шпросов.').split('|') as [string, string]) },
  'partition-frameless': { heading: P('Скільки коштує цільноскляна перегородка', 'Сколько стоит цельностеклянная перегородка'), rows: [[L.frameless, 'frameless'], [L.premium, 'premium']], doors: 'partition', example: { key: 'frameless', ua: 'Перегородка {d}, безрамна, без дверей', ru: 'Перегородка {d}, безрамная, без дверей' }, cta: '/peregorodky-configurator/', factors: partitionFactors(P('Система|Безрамна або Premium, спосіб кріплення.', 'Система|Безрамная или Premium, способ крепления.').split('|') as [string, string]) },
  'partition-office': { heading: P('Скільки коштує офісна перегородка', 'Сколько стоит офисная перегородка'), rows: [[L.frameless, 'frameless'], [L.profile, 'profile'], [L.premium, 'premium']], doors: 'partition', example: { key: 'profile', door: 'swing', ua: 'Перегородка {d}, у профілі, з розпашними дверима', ru: 'Перегородка {d}, в профиле, с распашными дверьми' }, cta: '/peregorodky-configurator/', factors: partitionFactors(P('Система|Безрамна, у профілі або Premium.', 'Система|Безрамная, в профиле или Premium.').split('|') as [string, string]) },
  'partition-interior': { heading: P('Скільки коштує міжкімнатна перегородка', 'Сколько стоит межкомнатная перегородка'), rows: [[L.frameless, 'frameless'], [L.profile, 'profile'], [L.premium, 'premium']], doors: 'partition', example: { key: 'profile', door: 'swing', ua: 'Перегородка {d}, у профілі, з розпашними дверима', ru: 'Перегородка {d}, в профиле, с распашными дверьми' }, cta: '/peregorodky-configurator/', factors: partitionFactors(P('Система|Безрамна, у профілі або Premium.', 'Система|Безрамная, в профиле или Premium.').split('|') as [string, string]) },
  'partition-doors': { heading: P('Скільки коштує перегородка з дверима', 'Сколько стоит перегородка с дверьми'), rows: [[L.frameless, 'frameless'], [L.profile, 'profile']], doors: 'partition', example: { key: 'frameless', door: 'sliding', ua: 'Перегородка {d}, безрамна, з розсувними дверима', ru: 'Перегородка {d}, безрамная, с раздвижными дверьми' }, cta: '/peregorodky-configurator/', factors: partitionFactors(P('Система|Безрамна або у профілі.', 'Система|Безрамная или в профиле.').split('|') as [string, string]) },
  'glazing-hub': { heading: P('Скільки коштує безрамне скління', 'Сколько стоит безрамное остекление'), rows: [[L.folding, 'glazingFolding'], [L.sliding, 'glazingSliding']], example: { key: 'glazingFolding', ua: 'Скління {d}, поворотно-складне', ru: 'Остекление {d}, поворотно-складное' }, cta: '/bezramne-configurator/', factors: glazingFactors },
  'glazing-folding': { heading: P('Скільки коштує поворотно-складне скління', 'Сколько стоит поворотно-складное остекление'), rows: [[L.folding, 'glazingFolding']], example: { key: 'glazingFolding', ua: 'Скління {d}, поворотно-складне', ru: 'Остекление {d}, поворотно-складное' }, cta: '/bezramne-configurator/', factors: glazingFactors },
  'glazing-sliding': { heading: P('Скільки коштує розсувне безрамне скління', 'Сколько стоит раздвижное безрамное остекление'), rows: [[L.sliding, 'glazingSliding']], example: { key: 'glazingSliding', ua: 'Скління {d}, розсувне', ru: 'Остекление {d}, раздвижное' }, cta: '/bezramne-configurator/', factors: glazingFactors },
  'glazing-terrace': { heading: P('Скільки коштує безрамне скління тераси', 'Сколько стоит безрамное остекление террасы'), rows: [[L.folding, 'glazingFolding'], [L.sliding, 'glazingSliding']], example: { key: 'glazingFolding', ua: 'Скління тераси {d}, поворотно-складне', ru: 'Остекление террасы {d}, поворотно-складное' }, cta: '/bezramne-configurator/', factors: glazingFactors },
  'glazing-gazebo': { heading: P('Скільки коштує безрамне скління альтанки', 'Сколько стоит безрамное остекление беседки'), rows: [[L.folding, 'glazingFolding'], [L.sliding, 'glazingSliding']], example: { key: 'glazingFolding', ua: 'Скління альтанки {d}, поворотно-складне', ru: 'Остекление беседки {d}, поворотно-складное' }, cta: '/bezramne-configurator/', factors: glazingFactors },
  'glazing-balcony': { heading: P('Скільки коштує безрамне скління балкона', 'Сколько стоит безрамное остекление балкона'), rows: [[L.folding, 'glazingFolding'], [L.sliding, 'glazingSliding']], example: { key: 'glazingFolding', ua: 'Скління балкона {d}, поворотно-складне', ru: 'Остекление балкона {d}, поворотно-складное' }, cta: '/bezramne-configurator/', factors: glazingFactors }
};

const dim = (mm: number) => (mm / 1000).toFixed(1).replace('.', ',');
const t = ru
  ? { eyebrow: 'Стоимость', kicker: 'Ориентировочная стоимость от · за 1 м² с монтажом', example: 'Пример расчёта', cta: 'Рассчитать свой размер', note: '*Ориентировочная стоимость. Точная цена зависит от комплектации и актуального курса. Рассчитайте свой размер в калькуляторе.', factorsTitle: 'От чего зависит цена' }
  : { eyebrow: 'Вартість', kicker: 'Орієнтовна вартість від · за 1 м² з монтажем', example: 'Приклад розрахунку', cta: 'Розрахувати свій розмір', note: '*Орієнтовна вартість. Точна ціна залежить від комплектації та актуального курсу. Розрахуйте свій розмір у калькуляторі.', factorsTitle: 'Від чого залежить ціна' };

type Block = { heading: string; kicker: string; rows: (readonly [string, string] | readonly [string, string, string])[]; doorsLine: string | null; notes?: string[]; noteLink?: [string, string, string]; ctaLabel?: string; exampleText?: string; examplePrice?: string; cta: string; note: string; factors: [string, string][] };
let block: Block;

if (isRailingVariant(variant)) {
  // Glass railings: a per-metre guide for one stated size (the price per metre depends on length).
  const page = RAILING_PAGES[variant];
  const headings: Record<RailingVariant, [string, string]> = {
    'railing-hub': ['Скільки коштує скляна огорожа', 'Сколько стоит стеклянное ограждение'],
    'railing-stairs': ['Скільки коштують скляні перила для сходів', 'Сколько стоят стеклянные перила для лестницы'],
    'railing-balcony': ['Скільки коштує скляна огорожа балкона', 'Сколько стоит стеклянное ограждение балкона'],
    'railing-terrace': ['Скільки коштує скляна огорожа тераси', 'Сколько стоит стеклянное ограждение террасы'],
    'railing-pool': ['Скільки коштує скляна огорожа басейну', 'Сколько стоит стеклянное ограждение бассейна'],
    'railing-frameless': ['Скільки коштує безрамна скляна огорожа', 'Сколько стоит безрамное стеклянное ограждение'],
    'railing-posts': ['Скільки коштує скляна огорожа на стійках', 'Сколько стоит стеклянное ограждение на стойках']
  };
  const ex = railingGuide(page.example);
  const exSystem = RAILING_SYSTEMS.find((item) => item.id === page.example)!;
  const glass = exSystem.glass[0].label.replace(/^Триплекс/, ru ? 'прозрачный триплекс' : 'прозорий триплекс');
  const handrail = exSystem.handrailIncluded ? P('поручень у комплекті', 'поручень в комплекте') : P('без поручня', 'без поручня');
  const len = ex.lengthM.toFixed(1).replace('.', ',');
  block = {
    heading: P(...headings[variant]),
    kicker: P(`Орієнтир для огорожі довжиною ${len.replace(',0', '')} м · ціна за м.п. з монтажем`, `Ориентир для ограждения длиной ${len.replace(',0', '')} м · цена за м.п. с монтажом`),
    rows: [...page.systems].sort((a, b) => railingGuide(a).perMetreUah - railingGuide(b).perMetreUah).map((id) => [RAILING_SYSTEMS.find((item) => item.id === id)!.name, `≈\u00a0${fmt(railingGuide(id).perMetreUah)}\u00a0грн/м.п.`] as const),
    doorsLine: null,
    exampleText: `${ex.name} ${len} × ${ex.heightM.toFixed(1).replace('.', ',')} м, ${P('пряма', 'прямое')}, ${glass}, ${handrail}, ${P('з монтажем', 'с монтажом')}`,
    examplePrice: `≈\u00a0${fmt(ex.totalUah)}\u00a0грн (≈\u00a0${fmt(ex.perMetreUah)}\u00a0грн/м.п.)`,
    cta: '/ogorozhi-configurator/',
    note: P('*Орієнтовна вартість. Точна ціна залежить від комплектації та актуального розрахункового курсу. Розрахуйте свій розмір у калькуляторі.', '*Ориентировочная стоимость. Точная цена зависит от комплектации и актуального расчётного курса. Рассчитайте свой размер в калькуляторе.'),
    factors: ru
      ? [['Длина', 'Чем длиннее ограждение, тем ниже цена метра: минимальный монтаж и фиксированные детали распределяются, действует скидка за длину.'], ['Система крепления', 'Профиль, точечные держатели, стойки или французский балкон.'], ['Стекло', 'Толщина триплекса, прозрачное, экстрапрозрачное или тонированное, матировка.'], ['Высота и форма', 'Высота стекла, прямое, угловое или П-образное ограждение.'], ['Поручень и цвет', 'Поручень из нержавейки, покраска профиля в RAL.']]
      : [['Довжина', 'Що довша огорожа, то нижча ціна метра: мінімальний монтаж і фіксовані деталі розподіляються, діє знижка за довжину.'], ['Система кріплення', 'Профіль, точкові тримачі, стійки чи французький балкон.'], ['Скло', 'Товщина триплексу, прозоре, екстрапрозоре чи тоноване, матування.'], ['Висота й форма', 'Висота скла, пряма, кутова чи П-подібна огорожа.'], ['Поручень і колір', 'Поручень із нержавійки, фарбування профілю в RAL.']]
  };
} else if (isCanopyVariant(variant)) {
  // Glass canopies: full price of a typical finished construction per system, installation included.
  const page = CANOPY_PAGES[variant];
  const headings: Record<CanopyVariant, [string, string]> = {
    'canopy-hub': ['Скільки коштує скляний козирок', 'Сколько стоит стеклянный козырёк'],
    'canopy-console': ['Скільки коштує консольний скляний козирок', 'Сколько стоит консольный стеклянный козырёк'],
    'canopy-rods': ['Скільки коштує скляний козирок на тягах', 'Сколько стоит стеклянный козырёк на тягах'],
    'canopy-brackets': ['Скільки коштує козирок на кронштейнах', 'Сколько стоит козырёк на кронштейнах'],
    'canopy-frame': ['Скільки коштує козирок у рамі', 'Сколько стоит козырёк в раме'],
    'canopy-side': ['Скільки коштує козирок з бічним захистом', 'Сколько стоит козырёк с боковой защитой'],
    'canopy-business': ['Скільки коштує скляний козирок для бізнесу', 'Сколько стоит стеклянный козырёк для бизнеса']
  };
  const size = (g: { widthMm: number; depthMm: number }) => `${g.widthMm}\u00a0×\u00a0${g.depthMm}\u00a0мм`;
  const sideWall = (id: string) => (id === 'duravento' ? P(' + бічна стінка 1,8 м', ' + боковая стенка 1,8 м') : '');
  const ex = canopyGuide(page.example);
  block = {
    heading: P(...headings[variant]),
    kicker: P('Орієнтир для типового козирка · повна вартість з монтажем', 'Ориентир для типового козырька · полная стоимость с монтажом'),
    rows: [...page.systems].sort((a, b) => canopyGuide(a).totalUah - canopyGuide(b).totalUah).map((id) => {
      const g = canopyGuide(id);
      return [`${g.name}, ${size(g)}${sideWall(id)}`, `≈\u00a0${fmt(g.totalUah)}\u00a0грн`] as const;
    }),
    doorsLine: null,
    exampleText: P(
      `Козирок ${ex.name} ${size(ex)} (${ex.areaM2.toFixed(2).replace('.', ',')} м²)${sideWall(page.example)}, прозоре скло, кріплення до бетону чи цегли: конструкція ≈\u00a0${fmt(ex.productUah)}\u00a0грн + замір, доставка й монтаж ${fmt(ex.installUah)}\u00a0грн`,
      `Козырёк ${ex.name} ${size(ex)} (${ex.areaM2.toFixed(2).replace('.', ',')} м²)${sideWall(page.example)}, прозрачное стекло, крепление к бетону или кирпичу: конструкция ≈\u00a0${fmt(ex.productUah)}\u00a0грн + замер, доставка и монтаж ${fmt(ex.installUah)}\u00a0грн`
    ),
    examplePrice: `≈\u00a0${fmt(ex.totalUah)}\u00a0${P('грн з монтажем', 'грн с монтажом')}`,
    cta: '/kozyrky-configurator/',
    note: P('*Орієнтовна вартість типової конструкції. Точна ціна залежить від розміру, системи, скла, комплектації та умов монтажу. Розрахуйте свій розмір у калькуляторі.', '*Ориентировочная стоимость типовой конструкции. Точная цена зависит от размера, системы, стекла, комплектации и условий монтажа. Рассчитайте свой размер в калькуляторе.'),
    factors: ru
      ? [['Размер', 'Ширина и вылет козырька: от них зависят площадь стекла и монтаж.'], ['Система', 'Тяги, кронштейны, консольный профиль или рама.'], ['Стекло', 'Прозрачное, экстрапрозрачное, матовое или серое, покрытие от грязи.'], ['Крепление к стене', 'Бетон и кирпич, дерево или утеплённый фасад.'], ['Опции и монтаж', 'Водосток, герметичное примыкание, высота и доступ к входу.']]
      : [['Розмір', 'Ширина й виліт козирка: від них залежать площа скла й монтаж.'], ['Система', 'Тяги, кронштейни, консольний профіль або рама.'], ['Скло', 'Прозоре, екстрапрозоре, матове чи сіре, покриття від бруду.'], ['Кріплення до стіни', 'Бетон і цегла, дерево чи утеплений фасад.'], ['Опції та монтаж', 'Водостік, герметичне примикання, висота й доступ до входу.']]
  };
} else if (isWindowVariant(variant)) {
  // Windows: market-orientation ranges for typical constructions (no calculator), product without installation.
  const pvc = variant === 'window-pvc';
  const market = windowMarket(variant);
  const range = ([lo, hi]: readonly [number, number], unit = 'грн') => `≈\u00a0${fmt(lo)}–${fmt(hi)}\u00a0${unit}`;
  const count = (n: number) => (ru ? ['Одностворчатое', 'Двухстворчатое', 'Трёхстворчатое'] : ['Одностулкове', 'Двостулкове', 'Тристулкове'])[n - 1] ?? '';
  const sashText = (sashes: Sash[]) => {
    const tt = sashes.filter((x) => x === 'tiltTurn').length;
    const ttText = ru ? (tt === 1 ? '1 поворотно-откидная створка' : `${tt} поворотно-откидные створки`) : (tt === 1 ? '1 поворотно-відкидна стулка' : `${tt} поворотно-відкидні стулки`);
    if (!sashes.includes('fixed')) return ttText;
    if (sashes.length === 3 && sashes[1] === 'fixed') return ru ? `глухая середина + ${tt} поворотно-откидные` : `глуха середина + ${tt} поворотно-відкидні`;
    return ru ? `1 глухая + ${ttText}` : `1 глуха + ${ttText}`;
  };
  const label = (w: (typeof market.typical)[number]) => `${count(w.sashes.length)} ${P('вікно', 'окно')}, ${w.widthMm}\u00a0×\u00a0${w.heightMm}\u00a0мм`;
  const ex = market.typical[0];
  const area = ((ex.widthMm / 1000) * (ex.heightMm / 1000)).toFixed(2).replace('.', ',');
  block = {
    heading: pvc ? P('Скільки коштують металопластикові вікна', 'Сколько стоят металлопластиковые окна') : P('Скільки коштують алюмінієві вікна', 'Сколько стоят алюминиевые окна'),
    kicker: P('Ринковий орієнтир · виріб без монтажу', 'Рыночный ориентир · изделие без монтажа'),
    rows: market.typical.map((w) => [label(w), range(w.rangeUah), sashText(w.sashes)] as const),
    doorsLine: null,
    notes: [
      pvc
        ? P(`Орієнтовна вартість ПВХ-вікон — близько ${fmt(market.perM2Uah[0])}–${fmt(market.perM2Uah[1])} грн/м² для базових конфігурацій.`, `Ориентировочная стоимость ПВХ-окон — около ${fmt(market.perM2Uah[0])}–${fmt(market.perM2Uah[1])} грн/м² для базовых конфигураций.`)
        : P(`Орієнтовна вартість теплих алюмінієвих вікон — близько ${fmt(market.perM2Uah[0])}–${fmt(market.perM2Uah[1])} грн/м² для базових конфігурацій.`, `Ориентировочная стоимость тёплых алюминиевых окон — около ${fmt(market.perM2Uah[0])}–${fmt(market.perM2Uah[1])} грн/м² для базовых конфигураций.`),
      P('Вартість квадратного метра змінюється залежно від розміру конструкції, кількості відкривних стулок, профільної системи, склопакета та фурнітури. Це ринковий орієнтир, а не тариф і не формула калькулятора.', 'Стоимость квадратного метра меняется в зависимости от размера конструкции, количества открывающихся створок, профильной системы, стеклопакета и фурнитуры. Это рыночный ориентир, а не тариф и не формула калькулятора.')
    ].concat(pvc
      ? [P('Базова комплектація: професійна PVC-профільна система, двокамерний енергоощадний склопакет, фурнітура, армування, ущільнення, теплий підставочний профіль.', 'Базовая комплектация: профессиональная PVC-профильная система, двухкамерный энергосберегающий стеклопакет, фурнитура, армирование, уплотнители, тёплый подставочный профиль.')]
      : [P('Базова комплектація: тепла алюмінієва система з терморозривом (клас Aluprof MB-79N, Framex FT 72, KMD 70 або аналог), двокамерний енергоощадний склопакет, фурнітура, стандартне фарбування RAL, підставочний профіль. Великі панорамні, нестандартні та важкі конструкції — індивідуальний розрахунок.', 'Базовая комплектация: тёплая алюминиевая система с терморазрывом (класс Aluprof MB-79N, Framex FT 72, KMD 70 или аналог), двухкамерный энергосберегающий стеклопакет, фурнитура, стандартная покраска RAL, подставочный профиль. Большие панорамные, нестандартные и тяжёлые конструкции — индивидуальный расчёт.')]),
    noteLink: [
      P(`Окремо: монтаж — від ${fmt(WINDOW_INSTALL_FROM_UAH_PER_M2)} грн/м², демонтаж, доставка, підвіконня, зовнішній відлив, укоси, москітна сітка, нестандартний колір, спеціальні склопакети й посилена фурнітура. `, `Отдельно: монтаж — от ${fmt(WINDOW_INSTALL_FROM_UAH_PER_M2)} грн/м², демонтаж, доставка, подоконник, внешний отлив, откосы, москитная сетка, нестандартный цвет, специальные стеклопакеты и усиленная фурнитура. `),
      P('Як ми монтуємо вікна', 'Как мы монтируем окна'),
      '/montazh-vikon/'
    ],
    exampleText: pvc
      ? P(`${label(ex)} (${area} м²), ${sashText(ex.sashes)}, профіль 70–76 мм, двокамерний енергоощадний склопакет, теплий підставочний профіль`, `${label(ex)} (${area} м²), ${sashText(ex.sashes)}, профиль 70–76 мм, двухкамерный энергосберегающий стеклопакет, тёплый подставочный профиль`)
      : P(`${label(ex)} (${area} м²), ${sashText(ex.sashes)}, тепла система класу MB-79N / FT 72 / KMD 70, двокамерний енергоощадний склопакет, стандартний RAL`, `${label(ex)} (${area} м²), ${sashText(ex.sashes)}, тёплая система класса MB-79N / FT 72 / KMD 70, двухкамерный энергосберегающий стеклопакет, стандартный RAL`),
    examplePrice: `${range(ex.rangeUah)} ${P('без монтажу', 'без монтажа')}`,
    cta: '#request',
    ctaLabel: P('Розрахувати моє вікно', 'Рассчитать моё окно'),
    note: P('*Ринковий орієнтир для типової конструкції без монтажу, а не розрахунок калькулятора. Точна ціна залежить від розмірів, кількості стулок, типу відкривання, профільної системи, склопакета, фурнітури й кольору та підтверджується після заміру.', '*Рыночный ориентир для типовой конструкции без монтажа, а не расчёт калькулятора. Точная цена зависит от размеров, количества створок, типа открывания, профильной системы, стеклопакета, фурнитуры и цвета и подтверждается после замера.'),
    factors: pvc
      ? (ru
        ? [['Размер', 'Маленькие окна дороже за м²: рама и фурнитура есть в каждом изделии.'], ['Створки и открывание', 'Глухая часть дешевле, поворотно-откидная створка добавляет профиль и фурнитуру.'], ['Профильная система', 'Монтажная ширина, количество камер и контуров уплотнения.'], ['Стеклопакет', 'Трёхкамерный, акустический, солнцезащитный или противовзломный — дороже базового.'], ['Фурнитура и цвет', 'Усиленная или скрытая фурнитура, ламинация.']]
        : [['Розмір', 'Малі вікна дорожчі за м²: рама й фурнітура є в кожному виробі.'], ['Стулки й відкривання', 'Глуха частина дешевша, поворотно-відкидна стулка додає профіль і фурнітуру.'], ['Профільна система', 'Монтажна ширина, кількість камер і контурів ущільнення.'], ['Склопакет', 'Трикамерний, акустичний, сонцезахисний чи протизламний — дорожчий за базовий.'], ['Фурнітура й колір', 'Посилена чи прихована фурнітура, ламінація.']])
      : (ru
        ? [['Система', 'Класс тёплой системы, глубина профиля, теплоизоляция и взломостойкость.'], ['Габариты', 'Большие глухие поля дешевле за м², маленькие окна — дороже.'], ['Створки, вес и фурнитура', 'Большие и тяжёлые створки могут потребовать усиленной фурнитуры — это меняет цену.'], ['Стеклопакет', 'Трёхкамерный, акустический, солнцезащитный или противовзломный.'], ['Цвет', 'Двухцветная, структурная или «под дерево» покраска профиля.']]
        : [['Система', 'Клас теплої системи, глибина профілю, теплоізоляція й протизламність.'], ['Габарити', 'Великі глухі поля дешевші за м², малі вікна — дорожчі.'], ['Стулки, вага й фурнітура', 'Великі та важкі стулки можуть потребувати посиленої фурнітури — це змінює ціну.'], ['Склопакет', 'Трикамерний, акустичний, сонцезахисний чи протизламний.'], ['Колір', 'Двоколірне, структурне чи «під дерево» фарбування профілю.']])
  };
} else if (isDoorVariant(variant)) {
  // Glass doors: market-orientation ranges for typical configurations (no calculator), product without installation and delivery.
  const range = ([lo, hi]: readonly [number, number]) => `≈ ${fmt(lo)}–${fmt(hi)} грн`;
  const headings: Record<DoorVariant, [string, string]> = {
    'door-hub': ['Скільки коштують скляні двері', 'Сколько стоят стеклянные двери'],
    'door-swing': ['Скільки коштують розпашні скляні двері', 'Сколько стоят распашные стеклянные двери'],
    'door-pendulum': ['Скільки коштують маятникові скляні двері', 'Сколько стоят маятниковые стеклянные двери'],
    'door-sliding': ['Скільки коштують розсувні скляні двері', 'Сколько стоят раздвижные стеклянные двери']
  };
  const types: Record<DoorType, { label: [string, string]; set: (mm: number) => [string, string] }> = {
    swing: { label: ['Розпашні одностулкові двері', 'Распашные одностворчатые двери'], set: (mm) => [`ESG ${mm} мм, прозоре скло, петлі для скла, ручка, без доводчика`, `ESG ${mm} мм, прозрачное стекло, петли для стекла, ручка, без доводчика`] },
    pendulum: { label: ['Двері з підлоговим доводчиком (маятникові)', 'Двери с напольным доводчиком (маятниковые)'], set: (mm) => [`ESG ${mm} мм, фурнітура, підлоговий доводчик, ручка`, `ESG ${mm} мм, фурнитура, напольный доводчик, ручка`] },
    sliding: { label: ['Розсувні скляні двері', 'Раздвижные стеклянные двери'], set: (mm) => [`ESG ${mm} мм, розсувна система, ручка`, `ESG ${mm} мм, раздвижная система, ручка`] }
  };
  block = {
    heading: P(...headings[variant]),
    kicker: P('Орієнтовна вартість типової комплектації · виріб без монтажу та доставки', 'Ориентировочная стоимость типовой комплектации · изделие без монтажа и доставки'),
    rows: DOOR_PAGES[variant].types.map((type) => [P(...types[type].label), range(DOOR_MARKET[type].rangeUah), P(...types[type].set(DOOR_MARKET[type].glassMm))] as const),
    doorsLine: null,
    notes: [
      P('Точна ціна залежить від розміру полотна, типу фурнітури, способу кріплення, типу відкривання, обробки скла, замка, доводчика, кольору та оздоблення фурнітури, а також нестандартних рішень.', 'Точная цена зависит от размера полотна, типа фурнитуры, способа крепления, типа открывания, обработки стекла, замка, доводчика, цвета и отделки фурнитуры, а также нестандартных решений.'),
      P('Монтаж розраховується окремо після заміру та залежить від способу кріплення й комплектації.', 'Монтаж рассчитывается отдельно после замера и зависит от способа крепления и комплектации.'),
      P('Доставка розраховується окремо залежно від міста та об’єкта.', 'Доставка рассчитывается отдельно в зависимости от города и объекта.')
    ],
    cta: '#request',
    ctaLabel: P('Розрахувати мої двері', 'Рассчитать мои двери'),
    note: P('*Орієнтовна вартість типової комплектації — ринковий орієнтир для виробу без монтажу та доставки, а не тариф і не розрахунок калькулятора. Точну ціну підтверджуємо після заміру.', '*Ориентировочная стоимость типовой комплектации — рыночный ориентир для изделия без монтажа и доставки, а не тариф и не расчёт калькулятора. Точную цену подтверждаем после замера.'),
    factors: ru
      ? [['Размер полотна', 'Ширина и высота определяют вес стекла и нужную фурнитуру.'], ['Открывание и крепление', 'Распашные, маятниковые или раздвижные; крепление к стене, стеклу или в проёме.'], ['Фурнитура', 'Петли, доводчик, раздвижная система, замок; цвет и отделка фурнитуры.'], ['Стекло', 'Прозрачное, матовое, тонированное, триплекс, рисунок или логотип.'], ['Нестандартные решения', 'Большие и тяжёлые полотна, фрамуги, боковые панели, особые вырезы.']]
      : [['Розмір полотна', 'Ширина й висота визначають вагу скла та потрібну фурнітуру.'], ['Відкривання й кріплення', 'Розпашні, маятникові чи розсувні; кріплення до стіни, скла чи в прорізі.'], ['Фурнітура', 'Петлі, доводчик, розсувна система, замок; колір і оздоблення фурнітури.'], ['Скло', 'Прозоре, матове, тоноване, триплекс, малюнок чи логотип.'], ['Нестандартні рішення', 'Великі й важкі полотна, фрамуги, бічні панелі, особливі вирізи.']]
  };
} else if (isShowerVariant(variant)) {
  // Showers: typical constructions with the catalog "від" price of their base model (no calculator), product without installation.
  const labels: Record<ShowerTypicalKey, [string, string]> = {
    walkin: ['Walk-In перегородка', 'Walk-In перегородка'],
    niche: ['Двері в нішу', 'Дверь в нишу'],
    sliding: ['Розсувна конструкція', 'Раздвижная конструкция'],
    corner: ['Кутова душова кабіна', 'Угловая душевая кабина']
  };
  block = {
    heading: P('Вартість душових конструкцій', 'Стоимость душевых конструкций'),
    kicker: P('Типові конструкції · ціна виробу за базовий розмір, без монтажу', 'Типовые конструкции · цена изделия за базовый размер, без монтажа'),
    rows: SHOWER_TYPICAL.map((s) => [
      P(...labels[s.key]),
      `≈ ${from(s.fromUah)}`,
      [s.model, s.baseSize && `${s.baseSize} мм`, P(`скло ${s.glassMm} мм`, `стекло ${s.glassMm} мм`)].filter(Boolean).join(', ')
    ] as const),
    doorsLine: null,
    notes: [
      P(`Загальний стартовий орієнтир для душових конструкцій Space Glass — ${from(SHOWER_HUB_FROM_UAH)}. Окремі базові моделі, як-от пряма перегородка Walk-In, можуть коштувати менше.`, `Общий стартовый ориентир для душевых конструкций Space Glass — ${from(SHOWER_HUB_FROM_UAH)}. Отдельные базовые модели, например прямая перегородка Walk-In, могут стоить меньше.`),
      P('Вартість залежить від розміру, конфігурації, фурнітури та способу монтажу. Точну ціну підтверджуємо після заміру.', 'Стоимость зависит от размера, конфигурации, фурнитуры и способа монтажа. Точную цену подтверждаем после замера.'),
      P('Монтаж розраховується окремо після заміру та залежить від конструкції й умов на об’єкті.', 'Монтаж рассчитывается отдельно после замера и зависит от конструкции и условий на объекте.'),
      P('Доставка розраховується окремо залежно від міста та об’єкта.', 'Доставка рассчитывается отдельно в зависимости от города и объекта.')
    ],
    cta: '#request',
    ctaLabel: P('Розрахувати мою душову', 'Рассчитать мою душевую'),
    note: P('*Орієнтовна стартова вартість конкретної базової моделі за базовий розмір, без монтажу. Ціни готових моделей — на вересень 2026 року, можуть змінюватися.', '*Ориентировочная стартовая стоимость конкретной базовой модели за базовый размер, без монтажа. Цены готовых моделей — на сентябрь 2026 года, могут меняться.'),
    factors: ru
      ? [['Размеры', 'Ширина, высота и площадь стекла'], ['Тип и стекло', 'Конструкция, толщина, цвет и обработка'], ['Фурнитура', 'Петли, профиль, ручки, система открывания'], ['Монтаж', 'Сложность установки и условия объекта']]
      : [['Розміри', 'Ширина, висота та площа скла'], ['Тип і скло', 'Конструкція, товщина, колір і обробка'], ['Фурнітура', 'Петлі, профіль, ручки, система відкривання'], ['Монтаж', 'Складність встановлення та умови об’єкта']]
  };
} else {
  const v = V[variant];
  const ex = examplePrice(v.example.key, v.example.door ?? null, v.doors ?? 'partition');
  const size = `${dim(ex.widthMm)} × ${dim(ex.heightMm)} м (${(Math.round(ex.areaM2 * 10) / 10).toFixed(1).replace('.', ',')} м²)`;
  block = {
    heading: v.heading,
    kicker: t.kicker,
    rows: v.rows.map(([label, key]) => [label, from(systemPricePerM2(key), true)] as const),
    doorsLine: v.doors
      ? P(`Доплата за двері у складі перегородки: розпашні — ${from(doorPrice('swing', v.doors))}, розсувні — ${from(doorPrice('sliding', v.doors))}`, `Доплата за двери в составе перегородки: распашные — ${from(doorPrice('swing', v.doors))}, раздвижные — ${from(doorPrice('sliding', v.doors))}`)
      : null,
    exampleText: `${(ru ? v.example.ru : v.example.ua).replace('{d}', size)}, ${P('з монтажем', 'с монтажом')}`,
    examplePrice: `≈\u00a0${fmt(ex.uah)}\u00a0грн`,
    cta: v.cta,
    note: t.note,
    factors: v.factors
  };
}
---
<section id="price" class="price-block price-block--calc">
  <div class="price-block__card">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2>{block.heading}</h2>
    <p class="price-block__kicker">{block.kicker}</p>
    <ul class="price-block__rows">
      {block.rows.map(([label, price, note]) => <li><span>{label}{note && <small>{note}</small>}</span><b>{price}</b></li>)}
    </ul>
    {block.doorsLine && <p class="price-block__doors">{block.doorsLine}</p>}
    {block.notes?.map((text) => <p class="price-block__doors">{text}</p>)}
    {block.noteLink && <p class="price-block__doors">{block.noteLink[0]}<a href={localizedPath(block.noteLink[2], locale)}>{block.noteLink[1]} →</a></p>}
    {block.exampleText && (
      <div class="price-block__example">
        <p class="price-block__example-title">{t.example}</p>
        <p>{block.exampleText} — <b>{block.examplePrice}</b></p>
      </div>
    )}
    <a class="button button--mint" href={localizedPath(block.cta, locale)}>{block.ctaLabel ?? t.cta}</a>
    <p class="price-block__footnote">{block.note}</p>
  </div>
  <div class="price-block__factors-wrap">
    <p class="price-block__factors-title">{t.factorsTitle}</p>
    <ul class="price-block__factors">
      {block.factors.map(([label, text]) => <li><b>{label}</b><span>{text}</span></li>)}
    </ul>
  </div>
</section>
