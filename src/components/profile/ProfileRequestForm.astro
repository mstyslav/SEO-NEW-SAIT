---
/**
 * Inline request form for the aluminium / metal-plastic cluster pages.
 * Submits through the global `[data-lead-form]` handler (public/js/forms.js)
 * → /api/kommo-lead. Hidden fields tell the CRM exactly where the lead came
 * from: `page` (path), `product` (section name) and `configuration`
 * (the chosen system). Any link with `data-request-model="<option>"` scrolls
 * here and preselects that option.
 */
interface Props {
  id?: string;
  page: string;
  product: string;
  title: string;
  text: string;
  /** Options for "Що цікавить" — systems on a child page, directions on a hub. */
  options: string[];
  optionsLabel?: string;
  commentPlaceholder?: string;
  locale?: 'uk' | 'ru' | 'en' | 'de' | 'es';
  /**
   * Which product family the page sells — picks the middle promise in the intro list:
   * 'glazing' — profile systems with insulating glass units (aluminium, PVC, facades, frameless);
   * 'glass'   — all-glass products (showers, doors, partitions, railings, canopies, mirrors);
   * 'generic' — products without glass (insect screens).
   */
  family?: 'glazing' | 'glass' | 'generic';
}

import { intlHref } from '../../i18n/intl-routes';

const {
  id = 'request',
  page,
  product,
  title,
  text,
  options,
  optionsLabel,
  commentPlaceholder,
  locale = 'uk',
  family = 'glass'
} = Astro.props;

const L = {
  uk: {
    eyebrow: 'Заявка з цієї сторінки',
    points: ['Відповімо протягом робочого дня', { glazing: 'Підберемо систему та склопакет', glass: 'Підберемо конструкцію, скло та фурнітуру', generic: 'Підберемо рішення під ваш проріз' }[family], 'Попередній розрахунок — безкоштовно'],
    call: 'Або телефонуйте:',
    name: 'Ім’я', namePh: 'Ваше ім’я', phone: 'Телефон', city: 'Місто', cityPh: 'Київ, Одеса, Львів...',
    comment: 'Коментар', undecided: 'Ще не визначились — допоможіть обрати', option: 'Система',
    commentPh: 'Розміри прорізів, кількість виробів, побажання щодо кольору чи скла',
    consent: 'Погоджуюсь із', policy: 'політикою конфіденційності', submit: 'Надіслати заявку', policyHref: '/privacy-policy/'
  },
  ru: {
    eyebrow: 'Заявка с этой страницы',
    points: ['Ответим в течение рабочего дня', { glazing: 'Подберём систему и стеклопакет', glass: 'Подберём конструкцию, стекло и фурнитуру', generic: 'Подберём решение под ваш проём' }[family], 'Предварительный расчёт — бесплатно'],
    call: 'Или звоните:',
    name: 'Имя', namePh: 'Ваше имя', phone: 'Телефон', city: 'Город', cityPh: 'Киев, Одесса, Львов...',
    comment: 'Комментарий', undecided: 'Ещё не определились — помогите выбрать', option: 'Система',
    commentPh: 'Размеры проёмов, количество изделий, пожелания по цвету или стеклу',
    consent: 'Соглашаюсь с', policy: 'политикой конфиденциальности', submit: 'Отправить заявку', policyHref: '/ru/privacy-policy/'
  },
  en: {
    eyebrow: 'Request from this page',
    points: ['We reply within one business day', { glazing: 'We select the system and glazing unit', glass: 'We select the design, glass and hardware', generic: 'We find a solution for your opening' }[family], 'Preliminary quote — free of charge'],
    call: 'Or call us:',
    name: 'Name', namePh: 'Your name', phone: 'Phone', city: 'City / country', cityPh: 'City, country',
    comment: 'Message', undecided: 'Not sure yet — please advise', option: 'System',
    commentPh: 'Opening sizes, number of items, glass or colour preferences',
    consent: 'I agree to the', policy: 'privacy policy', submit: 'Send request', policyHref: intlHref('privacy', 'en')
  },
  de: {
    eyebrow: 'Anfrage von dieser Seite',
    points: ['Antwort innerhalb eines Werktags', { glazing: 'Wir wählen System und Isolierglas aus', glass: 'Wir wählen Konstruktion, Glas und Beschläge aus', generic: 'Wir finden die Lösung für Ihre Öffnung' }[family], 'Unverbindliche Kostenschätzung — kostenlos'],
    call: 'Oder rufen Sie an:',
    name: 'Name', namePh: 'Ihr Name', phone: 'Telefon', city: 'Ort / Land', cityPh: 'Ort, Land',
    comment: 'Nachricht', undecided: 'Noch unentschlossen — bitte beraten', option: 'System',
    commentPh: 'Maße der Öffnungen, Stückzahl, Wünsche zu Glas oder Farbe',
    consent: 'Ich stimme der', policy: 'Datenschutzerklärung', submit: 'Anfrage senden', policyHref: intlHref('privacy', 'de'), consentAfter: ' zu'
  },
  es: {
    eyebrow: 'Solicitud desde esta página',
    points: ['Respondemos en un día laborable', { glazing: 'Elegimos el sistema y el doble acristalamiento', glass: 'Elegimos el diseño, el vidrio y los herrajes', generic: 'Buscamos la solución para su hueco' }[family], 'Presupuesto orientativo gratuito'],
    call: 'O llámenos:',
    name: 'Nombre', namePh: 'Su nombre', phone: 'Teléfono', city: 'Ciudad / país', cityPh: 'Ciudad, país',
    comment: 'Mensaje', undecided: 'Aún no lo tengo claro — necesito consejo', option: 'Sistema',
    commentPh: 'Medidas de los huecos, número de unidades, preferencias de vidrio o color',
    consent: 'Acepto la', policy: 'política de privacidad', submit: 'Enviar solicitud', policyHref: intlHref('privacy', 'es')
  }
}[locale] as { eyebrow: string; points: string[]; call: string; name: string; namePh: string; phone: string; city: string; cityPh: string; comment: string; undecided: string; option: string; commentPh: string; consent: string; policy: string; submit: string; policyHref: string; consentAfter?: string };
const phoneLabel = ['en', 'de', 'es'].includes(locale) ? '+380 73 425 14 00' : '+38 (073) 425 14 00';
---
<section id={id} class="profile-request" aria-labelledby={`${id}-title`}>
  <div class="profile-request__intro">
    <p class="eyebrow">{L.eyebrow}</p>
    <h2 id={`${id}-title`}>{title}</h2>
    <p>{text}</p>
    <ul class="profile-request__points">
      {L.points.map((point) => <li>{point}</li>)}
    </ul>
    <p class="profile-request__phone">{L.call} <a href="tel:+380734251400">{phoneLabel}</a></p>
  </div>

  <form class="quote-form contacts-v15-form profile-request__form" data-lead-form data-success-url="/thank-you/">
    <input name="locale" type="hidden" value={locale} />
    <input name="page" type="hidden" value={page} />
    <input name="product" type="hidden" value={product} />
    <div class="contacts-form-grid">
      <label>{L.name}<input name="name" type="text" autocomplete="name" placeholder={L.namePh} required /></label>
      <label>{L.phone}<input name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="+38" required /></label>
    </div>
    <div class="contacts-form-grid">
      <label>{optionsLabel ?? L.option}
        <select name="configuration" data-request-select>
          <option value="">{L.undecided}</option>
          {options.map((option) => <option value={option}>{option}</option>)}
        </select>
      </label>
      <label>{L.city}<input name="city" autocomplete="address-level2" type="text" placeholder={L.cityPh} /></label>
    </div>
    <label>{L.comment}<textarea name="comment" rows="4" placeholder={commentPlaceholder ?? L.commentPh}></textarea></label>
    <label class="quote-consent"><input name="consent" value="accepted" type="checkbox" required /><span>{L.consent} <a href={L.policyHref}>{L.policy}</a>{L.consentAfter ?? ''}.</span></label>
    <button class="button button--mint" type="submit">{L.submit}</button>
    <p data-form-status hidden role="status"></p>
  </form>
</section>

<script>
  document.addEventListener('click', (event) => {
    const link = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-request-model]');
    if (!link) return;
    const select = document.querySelector<HTMLSelectElement>('[data-request-select]');
    const model = link.dataset.requestModel;
    if (select && model && [...select.options].some((option) => option.value === model)) select.value = model;
  });
</script>
