---
/**
 * Step-by-step glass canopy configurator (/kozyrky-configurator/): system → size → glass →
 * wall fixing → options → installation → request. Live SVG (front + side view), instant
 * price with a breakdown; the request goes through the global `[data-lead-form]` handler
 * with the full configuration in a hidden field.
 * Prices: canopyPrice() in src/data/canopy-pricing.ts (EUR tariffs × working rate from
 * src/pricing/currency.ts + installation); customers see UAH only.
 */
import { CANOPY_CONFIG_SYSTEMS, FIXING_LABELS, GLASS_LABELS } from '../../data/canopy-pricing';
import { CANOPY_IMG } from '../../data/canopy-catalog';
import { CANOPY_CONFIG_SYSTEMS_RU, FIXING_LABELS_RU, GLASS_LABELS_RU } from '../../data/ru/canopy-pricing.ru';
import { localizedPath, type Locale } from '../../i18n/helpers';
import '../../styles/configurator-rc.css';

interface Props { locale?: Locale }
const locale: Locale = Astro.props.locale ?? 'uk';
const isRu = locale === 'ru';
const lp = (path: string) => localizedPath(path, locale);
const systems = isRu ? CANOPY_CONFIG_SYSTEMS_RU : CANOPY_CONFIG_SYSTEMS;

// Static UI texts (server) and the strings the client script builds (passed in the JSON data as `t`).
const ui = {
  uk: {
    steps: ['Система', 'Розміри', 'Скло', 'Кріплення', 'Опції', 'Монтаж', 'Заявка'], stepsLabel: 'Кроки конфігуратора',
    hint: 'Ліворуч — вигляд спереду, праворуч — збоку. Фото — приклад системи.', estimate: 'Орієнтовна вартість', breakdown: 'Склад ціни',
    chooseSystem: 'Оберіть тип козирка', dimensions: 'Вкажіть розміри', width: 'Ширина козирка, см', depth: 'Виліт (глибина), см',
    glass: 'Скло', glassNote: 'Лише ламіноване загартоване скло (триплекс) — уламки тримаються на плівці.', coating: 'Покриття від бруду та води',
    wall: 'Стіна та кріплення', wallJoint: 'Герметичне примикання до стіни', wallNote: 'Кріплення підбираємо під стіну; для утепленого фасаду — спеціальні анкери через утеплювач.',
    options: 'Водовідвід і опції', gutter: 'Жолоб', install: 'Монтаж', installYes: 'Монтаж Space Glass', installYesNote: 'Замір, доставка, встановлення',
    installNo: 'Без монтажу', installNoNote: 'Тільки виготовлення', city: 'Місто', cities: ['Київ', 'Одеса', 'Львів'], otherCity: 'Інше місто', otherValue: 'Інше',
    yourConfig: 'Ваша конфігурація', product: 'Скляні козирки — конфігуратор', name: 'Ім’я', namePh: 'Ваше ім’я', phone: 'Телефон', comment: 'Коментар',
    commentPh: 'Тип стіни, висота над дверима, фото входу — можна надіслати після дзвінка', consent: 'Погоджуюсь із', policy: 'політикою конфіденційності',
    send: 'Надіслати конфігурацію', back: '← Назад', next: 'Далі →',
    disclaimer: 'Ціна орієнтовна: товщину скла, кількість кронштейнів і кріплення визначаємо після заміру.'
  },
  ru: {
    steps: ['Система', 'Размеры', 'Стекло', 'Крепление', 'Опции', 'Монтаж', 'Заявка'], stepsLabel: 'Шаги конфигуратора',
    hint: 'Слева — вид спереди, справа — сбоку. Фото — пример системы.', estimate: 'Ориентировочная стоимость', breakdown: 'Состав цены',
    chooseSystem: 'Выберите тип козырька', dimensions: 'Укажите размеры', width: 'Ширина козырька, см', depth: 'Вынос (глубина), см',
    glass: 'Стекло', glassNote: 'Только ламинированное закалённое стекло (триплекс) — осколки держатся на плёнке.', coating: 'Покрытие от грязи и воды',
    wall: 'Стена и крепление', wallJoint: 'Герметичное примыкание к стене', wallNote: 'Крепление подбираем под стену; для утеплённого фасада — специальные анкеры через утеплитель.',
    options: 'Водоотвод и опции', gutter: 'Желоб', install: 'Монтаж', installYes: 'Монтаж Space Glass', installYesNote: 'Замер, доставка, установка',
    installNo: 'Без монтажа', installNoNote: 'Только изготовление', city: 'Город', cities: ['Киев', 'Одесса', 'Львов'], otherCity: 'Другой город', otherValue: 'Другой',
    yourConfig: 'Ваша конфигурация', product: 'Стеклянные козырьки — конфигуратор', name: 'Имя', namePh: 'Ваше имя', phone: 'Телефон', comment: 'Комментарий',
    commentPh: 'Тип стены, высота над дверью, фото входа — можно прислать после звонка', consent: 'Соглашаюсь с', policy: 'политикой конфиденциальности',
    send: 'Отправить конфигурацию', back: '← Назад', next: 'Далее →',
    disclaimer: 'Цена ориентировочная: толщину стекла, количество кронштейнов и крепления определяем после замера.'
  }
}[locale];
const t = {
  uk: {
    numLocale: 'uk-UA', uah: 'грн', noGutter: 'Без жолоба', slimGutter: 'Тонкий жолоб', largeGutter: 'Великий жолоб',
    noteFrame: 'ELLA має вбудований водовідвід у рамі — жолоб не потрібен.', noteArch: 'Арочний козирок відводить воду по краях; жолоб — за окремим проєктом.',
    noteGutter: 'Жолоб збирає воду з краю козирка й відводить у бік або в водостік.', cm: 'см', m2: 'м²', glassLine: 'Скло', coating: 'Покриття від бруду та води',
    fixingLine: 'Кріплення', wallJoint: 'Герметичне примикання до стіни', installLine: 'Замір, доставка й монтаж', widthWord: 'Ширина', depthWord: 'Виліт',
    coatingShort: 'покриття від бруду', wallJointShort: 'герметичне примикання', slimShort: 'тонкий жолоб', largeShort: 'великий жолоб',
    summary: ['Козирок', 'Розміри', 'Скло', 'Стіна', 'Опції', 'Монтаж'], triplex: 'триплекс', noOptions: 'без опцій', yes: 'так', no: 'ні',
    total: 'Разом', approx: 'Орієнтовно', toRequest: 'До заявки →', next: 'Далі →',
    dimNoteParts: [': ширина ', ' см, виліт ', ' см. Більші розміри — за окремим проєктом.']
  },
  ru: {
    numLocale: 'ru-UA', uah: 'грн', noGutter: 'Без желоба', slimGutter: 'Тонкий желоб', largeGutter: 'Большой желоб',
    noteFrame: 'У ELLA встроенный водоотвод в раме — желоб не нужен.', noteArch: 'Арочный козырёк отводит воду по краям; желоб — по отдельному проекту.',
    noteGutter: 'Желоб собирает воду с края козырька и отводит в сторону или в водосток.', cm: 'см', m2: 'м²', glassLine: 'Стекло', coating: 'Покрытие от грязи и воды',
    fixingLine: 'Крепление', wallJoint: 'Герметичное примыкание к стене', installLine: 'Замер, доставка и монтаж', widthWord: 'Ширина', depthWord: 'Вынос',
    coatingShort: 'покрытие от грязи', wallJointShort: 'герметичное примыкание', slimShort: 'тонкий желоб', largeShort: 'большой желоб',
    summary: ['Козырёк', 'Размеры', 'Стекло', 'Стена', 'Опции', 'Монтаж'], triplex: 'триплекс', noOptions: 'без опций', yes: 'да', no: 'нет',
    total: 'Итого', approx: 'Ориентировочно', toRequest: 'К заявке →', next: 'Далее →',
    dimNoteParts: [': ширина ', ' см, вынос ', ' см. Большие размеры — по отдельному проекту.']
  }
}[locale];
const data = { systems, glass: isRu ? GLASS_LABELS_RU : GLASS_LABELS, fixing: isRu ? FIXING_LABELS_RU : FIXING_LABELS, img: CANOPY_IMG, t };
const steps = ui.steps;
const page = lp('/kozyrky-configurator/');
---
<section class="rc" data-cc>
  <script type="application/json" data-cc-data set:html={JSON.stringify(data)} />
  <ol class="rc__steps" aria-label={ui.stepsLabel}>
    {steps.map((label, i) => <li><button type="button" data-cc-goto={i}><span>{i + 1}</span>{label}</button></li>)}
  </ol>

  <div class="rc__layout">
    <div class="rc__visual">
      <div class="rc__canvas" data-cc-svg aria-hidden="true"></div>
      <div class="rc__visual-meta">
        <img data-cc-photo alt="" width="96" height="96" />
        <div><b data-cc-sysname></b><span data-cc-sysnote></span></div>
      </div>
      <p class="rc__hint">{ui.hint}</p>
    </div>

    <div class="rc__panel">
      <div class="rc__price">
        <div><small>{ui.estimate}</small><strong data-cc-total>—</strong></div>
        <button type="button" class="rc__toggle" data-cc-toggle aria-expanded="false">{ui.breakdown}</button>
      </div>
      <dl class="rc__breakdown" data-cc-breakdown hidden></dl>

      <form class="rc__body" data-cc-form onsubmit="return false">
        <fieldset class="rc__step" data-cc-step="0">
          <legend>{ui.chooseSystem}</legend>
          <!-- Server-rendered (same markup the script re-renders; the 2nd system is preselected) so the panel has its final height before JS runs — no layout shift. -->
          <div class="rc__systems" data-cc-systems>{systems.map((s, i) => <label class="rc__sys"><input type="radio" name="system" value={s.id} checked={i === 1} /><span><img src={`${CANOPY_IMG}/gp-${s.id}-192.webp`} alt="" width="120" height="120" loading="lazy" /><b>{s.title}</b><small>{s.name} · {s.note}</small></span></label>)}</div>
        </fieldset>
        <fieldset class="rc__step" data-cc-step="1" hidden>
          <legend>{ui.dimensions}</legend>
          <div class="rc__fields">
            <label>{ui.width}<input type="number" name="W" step="1" value="150" inputmode="numeric" /></label>
            <label>{ui.depth}<input type="number" name="D" step="1" value="90" inputmode="numeric" /></label>
          </div>
          <p class="rc__note" data-cc-dim-note></p>
        </fieldset>
        <fieldset class="rc__step" data-cc-step="2" hidden>
          <legend>{ui.glass}</legend>
          <p class="rc__note" style="margin:0 0 12px">{ui.glassNote}</p>
          <div class="rc__options rc__options--swatches" data-cc-glass></div>
          <label class="rc__check"><input type="checkbox" name="coating" /> {ui.coating}</label>
        </fieldset>
        <fieldset class="rc__step" data-cc-step="3" hidden>
          <legend>{ui.wall}</legend>
          <div class="rc__options" data-cc-fixing></div>
          <label class="rc__check" data-cc-wall><input type="checkbox" name="wallJoint" /> {ui.wallJoint}</label>
          <p class="rc__note">{ui.wallNote}</p>
        </fieldset>
        <fieldset class="rc__step" data-cc-step="4" hidden>
          <legend>{ui.options}</legend>
          <div data-cc-gutter-wrap>
            <p class="rc__label">{ui.gutter}</p>
            <div class="rc__options" data-cc-gutter></div>
          </div>
          <label class="rc__check" data-cc-extra-wrap><input type="checkbox" name="extra" /> <span data-cc-extra></span></label>
          <p class="rc__note" data-cc-options-note></p>
        </fieldset>
        <fieldset class="rc__step" data-cc-step="5" hidden>
          <legend>{ui.install}</legend>
          <div class="rc__options">
            <label><input type="radio" name="install" value="yes" checked /><span>{ui.installYes}<small>{ui.installYesNote}</small></span></label>
            <label><input type="radio" name="install" value="no" /><span>{ui.installNo}<small>{ui.installNoNote}</small></span></label>
          </div>
          <label class="rc__select">{ui.city}
            <select name="city">
              {ui.cities.map((city) => <option>{city}</option>)}<option value={ui.otherValue}>{ui.otherCity}</option>
            </select>
          </label>
        </fieldset>
      </form>

      <div class="rc__step" data-cc-step="6" hidden>
        <h2 class="rc__legend">{ui.yourConfig}</h2>
        <dl class="rc__summary" data-cc-summary></dl>
        <form class="quote-form contacts-v15-form rc__request" data-lead-form data-success-url={lp('/thank-you/')}>
          <input name="locale" type="hidden" value={locale} />
          <input name="page" type="hidden" value={page} />
          <input name="product" type="hidden" value={ui.product} />
          <input name="configuration" type="hidden" data-cc-config />
          <div class="contacts-form-grid">
            <label>{ui.name}<input name="name" type="text" autocomplete="name" placeholder={ui.namePh} required /></label>
            <label>{ui.phone}<input name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="+38" required /></label>
          </div>
          <label>{ui.comment}<textarea name="comment" rows="3" placeholder={ui.commentPh}></textarea></label>
          <label class="quote-consent"><input name="consent" value="accepted" type="checkbox" required /><span>{ui.consent} <a href={lp('/privacy-policy/')}>{ui.policy}</a>.</span></label>
          <button class="button button--mint" type="submit">{ui.send}</button>
          <p data-form-status hidden role="status"></p>
        </form>
      </div>

      <div class="rc__nav">
        <button type="button" class="button button--outline" data-cc-prev>{ui.back}</button>
        <button type="button" class="button button--mint" data-cc-next>{ui.next}</button>
      </div>
      <p class="rc__disclaimer">{ui.disclaimer}</p>
    </div>
  </div>
</section>

<script>
  import { canopyPrice, type CanopySystem, type FixingId, type GlassId, type GutterId } from '../../data/canopy-pricing';
  type Sys = { id: string; name: string; title: string; note: string; support: string; a: number; b: number; c: number; minW: number; maxW: number; minD: number; maxD: number; glass: Record<string, number>; coating: number; fixing: { unit: 'm' | 'holder'; masonry: number; wood: number; insulation: number }; holders: number; wallJoint?: number; gutter?: { slim: number; large: number }; extra?: [string, number] };

  const root = document.querySelector<HTMLElement>('[data-cc]');
  if (root) {
    const D = JSON.parse(root.querySelector('[data-cc-data]')!.textContent || '{}');
    const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const form = $<HTMLFormElement>('[data-cc-form]');
    const systems = D.systems as Sys[];
    const T = D.t;
    const state = { step: 0, sys: systems[1], glass: 'clear', fixing: 'masonry', gutter: 'none' };
    const LAST = 6;
    const uah = (n: number) => `${(Math.round(n / 10) * 10).toLocaleString(T.numLocale)} ${T.uah}`;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const radio = (name: string, value: string, label: string, checked: boolean, extra = '') =>
      `<label><input type="radio" name="${name}" value="${value}"${checked ? ' checked' : ''} /><span>${extra}${esc(label)}</span></label>`;
    const checked = (name: string) => (form.elements.namedItem(name) as HTMLInputElement).checked;

    $('[data-cc-systems]').innerHTML = systems.map((s) =>
      `<label class="rc__sys"><input type="radio" name="system" value="${s.id}"${s === state.sys ? ' checked' : ''} /><span><img src="${D.img}/gp-${s.id}-192.webp" alt="" width="120" height="120" loading="lazy" /><b>${esc(s.title)}</b><small>${s.name} · ${esc(s.note)}</small></span></label>`).join('');
    $('[data-cc-glass]').innerHTML = Object.entries(D.glass).map(([k, v]: [string, any]) => radio('glass', k, v.label, k === 'clear', `<i style="background:${v.tint}"></i>`)).join('');
    $('[data-cc-fixing]').innerHTML = Object.entries(D.fixing).map(([k, v]: [string, any]) => radio('fixing', k, v as string, k === 'masonry')).join('');

    const renderSystemOptions = () => {
      const s = state.sys;
      const g = s.gutter;
      $('[data-cc-gutter-wrap]').hidden = !g;
      if (!g) state.gutter = 'none';
      $('[data-cc-gutter]').innerHTML = g ? [radio('gutter', 'none', T.noGutter, state.gutter === 'none'), radio('gutter', 'slim', T.slimGutter, state.gutter === 'slim'), radio('gutter', 'large', T.largeGutter, state.gutter === 'large')].join('') : '';
      $('[data-cc-extra-wrap]').hidden = !s.extra;
      $('[data-cc-extra]').textContent = s.extra ? s.extra[0] : '';
      if (!s.extra) (form.elements.namedItem('extra') as HTMLInputElement).checked = false;
      $('[data-cc-wall]').hidden = !s.wallJoint;
      if (!s.wallJoint) (form.elements.namedItem('wallJoint') as HTMLInputElement).checked = false;
      $('[data-cc-options-note]').textContent = s.support === 'frame' ? T.noteFrame : s.support === 'arch' ? T.noteArch : T.noteGutter;
    };

    const num = (name: string) => Number((form.elements.namedItem(name) as HTMLInputElement).value) || 0;
    const dims = () => {
      const s = state.sys;
      const W = Math.max(s.minW, Math.min(s.maxW, num('W') * 10));
      const Dp = Math.max(s.minD, Math.min(s.maxD, num('D') * 10));
      return { W, D: Dp };
    };

    const price = () => {
      const s = state.sys;
      // Same formula as the indexed price blocks: canopyPrice() in src/data/canopy-pricing.ts.
      const p = canopyPrice({ system: s as unknown as CanopySystem, widthMm: num('W') * 10, depthMm: num('D') * 10, glass: state.glass as GlassId, coating: checked('coating'), fixing: state.fixing as FixingId, wallJoint: checked('wallJoint'), gutter: state.gutter as GutterId, extra: checked('extra'), install: (form.querySelector<HTMLInputElement>('input[name="install"]:checked')?.value || 'yes') === 'yes' });
      const { widthMm: W, depthMm: Dp, areaM2: A } = p;
      const lines: [string, number][] = [[`${s.title} (${s.name}), ${(W / 10).toFixed(0)}×${(Dp / 10).toFixed(0)} ${T.cm}`, p.partsUah.base]];
      if (state.glass !== 'clear') lines.push([`${T.glassLine}: ${D.glass[state.glass].label.toLowerCase()}, ${A.toFixed(2).replace('.', ',')} ${T.m2}`, p.partsUah.glass]);
      if (checked('coating')) lines.push([T.coating, p.partsUah.coating]);
      if (state.fixing !== 'none') lines.push([`${T.fixingLine}: ${D.fixing[state.fixing].toLowerCase()}`, p.partsUah.fixing]);
      if (checked('wallJoint') && s.wallJoint) lines.push([T.wallJoint, p.partsUah.wallJoint]);
      if (state.gutter !== 'none' && s.gutter) lines.push([state.gutter === 'slim' ? T.slimGutter : T.largeGutter, p.partsUah.gutter]);
      if (checked('extra') && s.extra) lines.push([s.extra[0], p.partsUah.extra]);
      const items = lines.filter(([, v]) => v > 0.5);
      if (p.installUah) items.push([T.installLine, p.installUah]);
      return { items, total: p.totalUah, W, D: Dp, A };
    };


    const draw = () => {
      const s = state.sys;
      const { W, D: Dp } = dims();
      const tint = D.glass[state.glass].tint;
      const frosted = state.glass.startsWith('satin');
      const steel = '#9aa3a8';
      let g = '';
      // ---- front view (0..540)
      const sc = Math.min(440 / Math.max(W, 1400), 300 / 2900);
      const cx = 270, ground = 410, doorW = 1000 * sc, doorH = 2100 * sc, cy = ground - 2350 * sc, cw = W * sc;
      g += `<rect x="20" y="40" width="500" height="${ground - 40}" fill="#efeee9"/><rect x="20" y="${ground}" width="500" height="20" fill="#d8d6cf"/>`;
      g += `<rect x="${cx - doorW / 2}" y="${ground - doorH}" width="${doorW}" height="${doorH}" fill="#5b6468"/><rect x="${cx - doorW / 2 + 6}" y="${ground - doorH + 6}" width="${doorW - 12}" height="${doorH * 0.55}" fill="#8fa6ad" fill-opacity=".5"/><circle cx="${cx + doorW / 2 - 12}" cy="${ground - doorH / 2}" r="3" fill="#ddd"/>`;
      g += `<rect x="${cx - cw / 2}" y="${cy - 6}" width="${cw}" height="10" fill="${tint}" stroke="#8fb0b8" stroke-width="1.2"/>`;
      if (frosted) g += `<rect x="${cx - cw / 2}" y="${cy - 6}" width="${cw}" height="10" fill="#fff" fill-opacity=".6"/>`;
      if (s.support === 'rods' || s.support === 'tube' || s.support === 'arch') for (const f of [0.15, 0.85]) g += `<line x1="${cx - cw / 2 + cw * f}" y1="${cy - 70}" x2="${cx - cw / 2 + cw * f}" y2="${cy - 4}" stroke="${steel}" stroke-width="3"/>`;
      if (s.support === 'swords' || s.support === 'brackets') for (const f of [0.1, 0.9]) g += `<rect x="${cx - cw / 2 + cw * f - 3}" y="${cy + 4}" width="6" height="26" fill="${steel}"/>`;
      if (s.support === 'console') g += `<rect x="${cx - cw / 2}" y="${cy - 10}" width="${cw}" height="5" fill="${steel}"/>`;
      if (s.support === 'frame' || s.support === 'tube') g += `<rect x="${cx - cw / 2}" y="${cy - 8}" width="${cw}" height="14" fill="none" stroke="#444" stroke-width="2.5"/>`;
      if (s.support === 'arch') g += `<path d="M${cx - cw / 2} ${cy} Q${cx} ${cy - 40} ${cx + cw / 2} ${cy}" fill="none" stroke="#8fb0b8" stroke-width="6"/>`;
      if (s.support === 'side') g += `<rect x="${cx + cw / 2 - 6}" y="${cy + 4}" width="6" height="${Math.min(1800 * sc, ground - cy - 10)}" fill="${tint}" stroke="#8fb0b8"/>`;
      g += `<g stroke="#347a66" stroke-width="1.4" fill="none"><path d="M${cx - cw / 2} ${ground + 44}h${cw}M${cx - cw / 2} ${ground + 36}v16M${cx + cw / 2} ${ground + 36}v16"/></g>`;
      g += `<text x="${cx}" y="${ground + 68}" text-anchor="middle" font-size="17" font-weight="700" fill="#1c211e">${T.widthWord} ${(W / 10).toFixed(0)} ${T.cm}</text>`;
      // ---- side view (560..790)
      const wx = 590, sc2 = Math.min(170 / Math.max(Dp, 1000), 1), sy = 170, dd = Dp * sc2, drop = dd * 0.09;
      g += `<rect x="560" y="40" width="${wx - 560}" height="${ground - 40}" fill="#e3e1da"/><line x1="${wx}" y1="40" x2="${wx}" y2="${ground}" stroke="#bdbab2" stroke-width="2"/><rect x="560" y="${ground}" width="230" height="20" fill="#d8d6cf"/>`;
      if (s.support === 'arch') g += `<path d="M${wx} ${sy} Q${wx + dd / 2} ${sy - 36} ${wx + dd} ${sy + drop}" fill="none" stroke="#8fb0b8" stroke-width="6"/>`;
      else g += `<line x1="${wx}" y1="${sy}" x2="${wx + dd}" y2="${sy + drop}" stroke="${frosted ? '#e9eeee' : '#9cc3cc'}" stroke-width="6" stroke-linecap="round"/>`;
      if (s.support === 'rods' || s.support === 'arch') g += `<line x1="${wx}" y1="${sy - 90}" x2="${wx + dd * 0.85}" y2="${sy + drop * 0.85 - 3}" stroke="${steel}" stroke-width="2.5"/><circle cx="${wx + dd * 0.85}" cy="${sy + drop * 0.85}" r="4" fill="${steel}"/>`;
      if (s.support === 'tube') g += `<line x1="${wx}" y1="${sy - 90}" x2="${wx + dd}" y2="${sy + drop - 6}" stroke="${steel}" stroke-width="2.5"/><line x1="${wx}" y1="${sy + 8}" x2="${wx + dd}" y2="${sy + drop + 8}" stroke="${steel}" stroke-width="4"/>`;
      if (s.support === 'swords') g += `<path d="M${wx} ${sy + 40} L${wx + dd * 0.9} ${sy + drop * 0.9 + 4}" stroke="${steel}" stroke-width="5" stroke-linecap="round"/>`;
      if (s.support === 'brackets') g += `<path d="M${wx} ${sy + 50} Q${wx + dd * 0.5} ${sy + 40} ${wx + dd * 0.85} ${sy + drop * 0.85 + 4}" stroke="${steel}" stroke-width="4" fill="none"/>`;
      if (s.support === 'console' || s.support === 'side') g += `<rect x="${wx}" y="${sy - 8}" width="14" height="18" fill="${steel}"/>`;
      if (s.support === 'frame') g += `<rect x="${wx}" y="${sy - 6}" width="${dd}" height="12" fill="none" stroke="#444" stroke-width="2.5" transform="rotate(5 ${wx} ${sy})"/>`;
      if (s.support === 'side') g += `<rect x="${wx + dd - 4}" y="${sy + drop}" width="${Math.max(10, dd * 0.9)}" height="4" fill="none"/><rect x="${wx}" y="${sy + 10}" width="${dd}" height="${Math.min(170, ground - sy - 20)}" fill="${tint}" fill-opacity=".55" stroke="#8fb0b8"/>`;
      if (state.gutter !== 'none' && s.gutter) g += `<path d="M${wx + dd - 2} ${sy + drop - 2} q0 12 10 12 q10 0 10 -12" fill="none" stroke="#6b7478" stroke-width="3"/>`;
      g += `<g stroke="#347a66" stroke-width="1.4" fill="none"><path d="M${wx} ${sy - 118}h${dd}M${wx} ${sy - 126}v16M${wx + dd} ${sy - 126}v16"/></g>`;
      g += `<text x="${wx + dd / 2}" y="${sy - 132}" text-anchor="middle" font-size="17" font-weight="700" fill="#1c211e">${T.depthWord} ${(Dp / 10).toFixed(0)} ${T.cm}</text>`;
      $('[data-cc-svg]').innerHTML = `<svg viewBox="0 0 800 490" role="img">${g}</svg>`;
      $<HTMLImageElement>('[data-cc-photo]').src = `${D.img}/gp-${s.id}-192.webp`;
      $('[data-cc-sysname]').textContent = `${s.title}`;
      $('[data-cc-sysnote]').textContent = `${s.name} · ${s.note}`;
    };

    const summaryRows = (p: ReturnType<typeof price>) => {
      const s = state.sys;
      const opts = [checked('coating') && T.coatingShort, checked('wallJoint') && T.wallJointShort, state.gutter !== 'none' && (state.gutter === 'slim' ? T.slimShort : T.largeShort), checked('extra') && s.extra?.[0].toLowerCase()].filter(Boolean).join(', ');
      return [
        [T.summary[0], `${s.title} (${s.name})`],
        [T.summary[1], `${(p.W / 10).toFixed(0)} × ${(p.D / 10).toFixed(0)} ${T.cm} (${p.A.toFixed(2).replace('.', ',')} ${T.m2})`],
        [T.summary[2], `${T.triplex}, ${D.glass[state.glass].label.toLowerCase()}`],
        [T.summary[3], D.fixing[state.fixing]],
        [T.summary[4], opts || T.noOptions],
        [T.summary[5], `${(form.querySelector<HTMLInputElement>('input[name="install"]:checked')?.value || 'yes') === 'yes' ? T.yes : T.no}, ${(form.elements.namedItem('city') as HTMLSelectElement).value}`]
      ];
    };

    const update = () => {
      const s = state.sys;
      const wIn = form.elements.namedItem('W') as HTMLInputElement, dIn = form.elements.namedItem('D') as HTMLInputElement;
      wIn.min = String(s.minW / 10); wIn.max = String(s.maxW / 10); dIn.min = String(s.minD / 10); dIn.max = String(s.maxD / 10);
      $('[data-cc-dim-note]').textContent = `${s.name}${T.dimNoteParts[0]}${s.minW / 10}–${s.maxW / 10}${T.dimNoteParts[1]}${s.minD / 10}–${s.maxD / 10}${T.dimNoteParts[2]}`;
      const p = price();
      $('[data-cc-total]').textContent = uah(p.total);
      $('[data-cc-breakdown]').innerHTML = p.items.map(([t, v]) => `<div><dt>${esc(t)}</dt><dd>${uah(v)}</dd></div>`).join('') + `<div class="rc__breakdown-total"><dt>${T.total}</dt><dd>${uah(p.total)}</dd></div>`;
      const rows = summaryRows(p);
      $('[data-cc-summary]').innerHTML = rows.map(([k, v]) => `<div><dt>${k}</dt><dd>${esc(String(v))}</dd></div>`).join('') + `<div><dt>${T.approx}</dt><dd><b>${uah(p.total)}</b></dd></div>`;
      $<HTMLInputElement>('[data-cc-config]').value = rows.map(([k, v]) => `${k}: ${v}`).join('; ') + `; ${T.approx}: ${uah(p.total)}`;
      draw();
    };

    // scroll = false for the initial render: the page must not jump to the panel on load.
    const go = (i: number, scroll = true) => {
      state.step = Math.max(0, Math.min(LAST, i));
      root.querySelectorAll<HTMLElement>('[data-cc-step]').forEach((el) => { el.hidden = Number(el.dataset.ccStep) !== state.step; });
      root.querySelectorAll<HTMLButtonElement>('[data-cc-goto]').forEach((b) => { const k = Number(b.dataset.ccGoto); b.classList.toggle('is-active', k === state.step); b.classList.toggle('is-done', k < state.step); });
      $<HTMLButtonElement>('[data-cc-prev]').disabled = state.step === 0;
      const next = $<HTMLButtonElement>('[data-cc-next]');
      next.hidden = state.step === LAST;
      next.textContent = state.step === LAST - 1 ? T.toRequest : T.next;
      update();
      if (scroll && window.innerWidth < 900) root.querySelector('.rc__panel')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    root.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'system') { state.sys = systems.find((s) => s.id === t.value)!; renderSystemOptions(); }
      if (t.name === 'glass') state.glass = t.value;
      if (t.name === 'fixing') state.fixing = t.value;
      if (t.name === 'gutter') state.gutter = t.value;
      update();
    });
    root.addEventListener('input', (e) => { if ((e.target as HTMLElement).matches('input[type="number"]')) update(); });
    root.querySelectorAll<HTMLButtonElement>('[data-cc-goto]').forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.ccGoto))));
    $('[data-cc-prev]').addEventListener('click', () => go(state.step - 1));
    $('[data-cc-next]').addEventListener('click', () => go(state.step + 1));
    const toggle = $<HTMLButtonElement>('[data-cc-toggle]');
    toggle.addEventListener('click', () => { const bd = $('[data-cc-breakdown]'); bd.hidden = !bd.hidden; toggle.setAttribute('aria-expanded', String(!bd.hidden)); });

    // Preselect a system from ?system=spada
    const pre = systems.find((s) => s.id === new URLSearchParams(location.search).get('system'));
    if (pre) { state.sys = pre; (root.querySelector(`input[name="system"][value="${pre.id}"]`) as HTMLInputElement).checked = true; }
    renderSystemOptions();
    go(0, false);
  }
</script>
