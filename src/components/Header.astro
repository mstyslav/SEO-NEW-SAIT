const localizedMenuData = Object.fromEntries(Object.entries(menuData).map(([key, data]) => [key, {
  ...data,
  eyebrow: tr(data.eyebrow), title: tr(data.title), text: tr(data.text), button: tr(data.button), href: hrefForLocale(data.href),
  popular: data.popular.map(([title, text, image, href]) => [tr(title), tr(text), image, hrefForLocale(href)])
}]));

---
<header class="site-header sg-header">
  <div class="container nav sg-nav">
    <a class="brand-logo" href={locale === 'ru' ? '/ru/' : '/uk/'} aria-label={`Space Glass — ${locale === 'ru' ? 'главная' : 'головна'}`}>
