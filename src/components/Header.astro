---
import translations from '../i18n/translations.json';
import i18nConfig from '../i18n/config.json';
import { hasLocalizedRoute, localeFromPath, localizedPath, normalizeLocale } from '../i18n/helpers';
import { getCatalogNavigation } from '../data/catalog-navigation';

const requestedLocale = Astro.props.locale ?? Astro.url.searchParams.get('lang') ?? localeFromPath(Astro.url.pathname);
const locale = normalizeLocale(requestedLocale);
const t = translations[locale] ?? translations.uk;
const localeInfo = i18nConfig.locales[locale] ?? i18nConfig.locales.uk;
const catalogNavigation = getCatalogNavigation(locale);
const currentPath = Astro.url.pathname;
const lp = (path: string) => localizedPath(path, locale);

const localeSwitchPath = (targetLocale: 'uk' | 'ru') => {
  if (targetLocale === 'ru' && !hasLocalizedRoute(currentPath, 'ru')) return '/ru/';
  return localizedPath(currentPath, targetLocale);
};
const nextLocale: 'uk' | 'ru' = locale === 'ru' ? 'uk' : 'ru';
const directLocaleHref = localeSwitchPath(nextLocale);
const directLocaleLabel = nextLocale === 'uk' ? 'Перейти українською' : 'Перейти російською';

const isUkrainian = locale === 'uk';
const baseLinks = [
  [t.services, '/poslugy/'],
  [t.solutions, '/rishennya/'],
  [t.projects, '/projects/'],
  [t.knowledge, '/knowledge/'],
  [t.about, '/about/'],
  [t.contacts, '/contacts/'],
];
const links = isUkrainian
  ? [baseLinks[1], baseLinks[0], ...baseLinks.slice(2)]
  : baseLinks;

---
<header class="site-header sg-header">
  <div class="container nav sg-nav">
    <a class="brand-logo" href={lp("/")} aria-label={t.brandLogoAria}><img
      src="/images/space-glass-logo-header.webp"
      srcset="/images/space-glass-logo-header-148.webp 148w, /images/space-glass-logo-header.webp 202w"
      sizes="(max-width: 700px) 74px, (max-width: 1100px) 89px, 101px"
      width="101" height="82" alt="Space Glass" decoding="async"
      style="width:101px;height:auto"
    /></a>
    <nav class="nav__links sg-nav-links" aria-label={t.mainNavAria}>
      <a class="nav-link nav-link--catalog" href={lp("/catalog/")}>{t.catalog}</a>
      {links.map(([label, href]) => <a class="nav-link" href={lp(href)}>{label}</a>)}
      <button class="nav-link sg-categories-trigger sg-categories-trigger--ua" type="button" aria-controls="sg-ua-catalog-menu" aria-expanded="false" aria-haspopup="true" aria-label={t.openCatalogMenuAria} data-ua-catalog-menu-button><span></span><span></span><span></span></button>
    </nav>
    <div class="nav__actions sg-nav-actions">
      <div class="language-switcher" data-language-switcher><a class="language-switcher__button language-switcher__button--direct" href={directLocaleHref} hreflang={nextLocale} lang={nextLocale} aria-label={directLocaleLabel} title={directLocaleLabel} data-language-button data-target-locale={nextLocale}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 12h17M12 3c2.4 2.5 3.6 5.5 3.6 9S14.4 18.5 12 21M12 3C9.6 5.5 8.4 8.5 8.4 12S9.6 18.5 12 21" fill="none" stroke="currentColor" stroke-width="1.3"/></svg><span>{localeInfo.short}</span></a></div>
      <a class:list={['nav-icon', 'nav-icon--search', 'nav-icon--search-ua-desktop']} href={lp("/catalog/")} aria-label={t.searchAria}>⌕</a>
      <a class="nav-icon nav-icon--phone" href="tel:+380734251400" aria-label={t.phoneAria}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.3 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1L6.6 10.8Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      <a class="button button--mint sg-header-cta" href={lp("/contacts/")}>{t.quote}</a>
      <button class="sg-mobile-toggle" type="button" aria-controls="sg-mobile-menu" aria-expanded="false" aria-label={t.menu} data-mobile-menu-button><span></span><span></span><span></span></button>
    </div>
  </div>
  <section class="sg-ua-catalog-menu" id="sg-ua-catalog-menu" aria-label={t.catalogCategoriesAria} data-ua-catalog-menu hidden>
    <div class="sg-ua-catalog-menu__grid">
      {catalogNavigation.map(category => <section class="sg-ua-catalog-menu__group"><h2><a href={lp(category.href)}>{category.name}</a></h2><ul>{category.services.map(service => <li><a href={lp(service.path)}>{service.shortName}</a></li>)}</ul></section>)}
    </div>
    <div class="sg-ua-catalog-menu__cities" aria-label={t.searchByCityLabel}>
      <span>⌖ {t.searchByCityLabel}</span>
      <a href={lp("/city/kyiv/")}>{t.cityKyiv}</a>
      <a href={lp("/city/odesa/")}>{t.cityOdesa}</a>
      <a href={lp("/city/lviv/")}>{t.cityLviv}</a>
      <a href={lp("/catalog/")}>{t.cityAllUkraine} <b aria-hidden="true">→</b></a>
    </div>
    <div class="sg-ua-catalog-menu__benefits" aria-label={t.catalogMenuBenefitsLabel}>
      <div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6M8 10h.01M16 10h.01" /></svg><p><b>{t.catalogMenuBenefitProductionTitle}</b><span>{t.catalogMenuBenefitProductionText}</span></p></div>
      <div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 7 3v5c0 4.6-2.8 8.5-7 10-4.2-1.5-7-5.4-7-10V6l7-3Zm-3 9 2 2 4-4" /></svg><p><b>{t.warrantyShort}</b><span>{t.catalogMenuBenefitWarrantyText}</span></p></div>
      <div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 16 4-4 3 3 6-7M15 8h2v2M4 20h16" /></svg><p><b>{t.catalogMenuBenefitInstallTitle}</b><span>{t.catalogMenuBenefitInstallText}</span></p></div>
      <div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v10H3zM14 10h3l4 4v2h-7zM6 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" /></svg><p><b>{t.catalogMenuBenefitDeliveryTitle}</b><span>{t.catalogMenuBenefitDeliveryText}</span></p></div>
    </div>
  </section>
  <div class="sg-mobile-menu" id="sg-mobile-menu" data-mobile-menu hidden><div class="sg-mobile-menu__panel"><div class="simple-catalog simple-catalog--mobile"><div class="simple-catalog__mobile-row"><a class="sg-mobile-menu__primary" href={lp("/catalog/")}>{t.catalog}</a><button class="simple-catalog__toggle" type="button" aria-label={t.expandCatalogMenu} aria-controls="sg-mobile-catalog-categories" aria-expanded="false" data-mobile-catalog-toggle data-expand-label={t.expandCatalogMenu} data-collapse-label={t.collapseCatalogMenu}><i aria-hidden="true"></i></button></div><div class="simple-catalog__menu" id="sg-mobile-catalog-categories" data-mobile-catalog-menu hidden>{catalogNavigation.map((category, index) => { const services = category.services.filter((service, serviceIndex, allServices) => allServices.findIndex(({ shortName, path }) => path === service.path && shortName === service.shortName) === serviceIndex); const servicesId = `sg-mobile-catalog-services-${index + 1}`; return <section><div class="simple-catalog__category-row"><a class="simple-catalog__category" href={lp(category.href)}>{category.name}</a><button class="simple-catalog__service-toggle" type="button" aria-label={`${t.expandSubcategoriesPrefix}: ${category.name}`} aria-controls={servicesId} aria-expanded="false" data-mobile-category-toggle data-category-name={category.name} data-expand-prefix={t.expandSubcategoriesPrefix} data-collapse-prefix={t.collapseSubcategoriesPrefix}><i aria-hidden="true"></i></button></div><div class="simple-catalog__services" id={servicesId} data-mobile-category-menu hidden>{services.map((service) => <a href={lp(service.path)}>{service.shortName}</a>)}</div></section>})}</div></div>{links.map(([label, href]) => <a href={lp(href)}>{label}</a>)}<a href="tel:+380734251400">+38 (073) 425 14 00</a><a class="button button--mint" href={lp("/contacts/")}>{t.quote}</a></div></div>
</header>
<style>
  .sg-categories-trigger{display:inline-flex;flex-direction:column;justify-content:center;gap:4px;width:32px;height:32px;padding:6px;border:0;background:transparent;cursor:pointer}
  .sg-categories-trigger span{display:block;width:20px;height:1.5px;background:currentColor;border-radius:2px}
.nav-icon--phone svg{width:20px;height:20px;display:block}
  .simple-catalog{position:relative}.simple-catalog__menu{position:absolute;top:calc(100% - 4px);left:-18px;z-index:1000;display:grid;min-width:270px;padding:12px;background:#fff;border:1px solid #dce5e1;box-shadow:0 16px 35px rgba(0,0,0,.14)}.simple-catalog__menu a{padding:9px 12px;color:#111513;font-size:14px}.simple-catalog__menu a:hover,.simple-catalog__menu a:focus-visible{background:#edf8f2;color:#176f58}.simple-catalog--mobile{color:#fff}.simple-catalog--mobile .simple-catalog__menu{position:static;min-width:0;padding:4px 0;background:transparent;border:0;box-shadow:none}.simple-catalog--mobile .simple-catalog__menu a{padding-left:18px;color:#dce5e1}
</style>
<style is:inline>
  .simple-catalog summary{display:inline-flex;align-items:center;gap:6px;min-height:48px;color:#fff;cursor:pointer;list-style:none}.simple-catalog summary::-webkit-details-marker{display:none}.simple-catalog--mobile summary{min-height:44px}
  @media(max-width:1120px){.sg-header .sg-mobile-menu:not([hidden]){display:block!important}}
  .sg-header [data-mobile-catalog-menu][hidden]{display:none!important}
  .sg-header [data-mobile-category-menu][hidden]{display:none!important}
  .sg-header .simple-catalog__mobile-row{display:grid;grid-template-columns:minmax(0,1fr) 48px;align-items:center;border-bottom:1px solid #1d231f}
  .sg-header .simple-catalog__mobile-row>a{border-bottom:0!important}
  .sg-header .simple-catalog__toggle{display:grid;width:48px;height:48px;padding:0;border:0;background:transparent;place-items:center;color:#fff;cursor:pointer}
  .sg-header .simple-catalog__toggle i{width:0;height:0;border-top:6px solid currentColor;border-right:5px solid transparent;border-left:5px solid transparent;transition:transform .18s ease}
  .sg-header .simple-catalog__toggle[aria-expanded="true"] i{transform:rotate(180deg)}
  .sg-header .simple-catalog__toggle:focus-visible{outline:2px solid var(--mint);outline-offset:-4px}
  .sg-header .simple-catalog--mobile .simple-catalog__menu{position:static;min-width:0;max-height:min(56vh,560px);overflow-y:auto;padding:6px 0 10px;background:transparent;border:0;box-shadow:none}
  .sg-header .simple-catalog--mobile .simple-catalog__menu section{padding:0;border-bottom:1px solid rgba(220,229,225,.12)}
  .sg-header .simple-catalog__category-row{display:grid;grid-template-columns:minmax(0,1fr) 44px;align-items:center}
  .sg-header .simple-catalog__category-row>a{border-bottom:0!important}
  .sg-header .simple-catalog__service-toggle{display:grid;width:44px;height:44px;padding:0;border:0;background:transparent;place-items:center;color:#dce5e1;cursor:pointer}
  .sg-header .simple-catalog__service-toggle i{width:0;height:0;border-top:5px solid currentColor;border-right:4px solid transparent;border-left:4px solid transparent;transition:transform .18s ease}
  .sg-header .simple-catalog__service-toggle[aria-expanded="true"] i{transform:rotate(180deg)}
  .sg-header .simple-catalog__service-toggle:focus-visible{outline:2px solid var(--mint);outline-offset:-4px}
  .sg-header .simple-catalog--mobile .simple-catalog__menu a{min-height:40px;padding:7px 10px 7px 18px;border-bottom:0;color:#dce5e1}
  .sg-header .simple-catalog--mobile .simple-catalog__category{color:#fff!important;font-weight:750}
  .sg-header .simple-catalog__services{display:grid;padding-left:12px}
  .sg-header .simple-catalog--mobile .simple-catalog__services a{min-height:36px;color:#aeb9b4;font-size:12px}
  .simple-catalog--mobile .simple-catalog__menu a{
    -webkit-tap-highlight-color:transparent;
    border-bottom:0!important;
  }
  .simple-catalog--mobile .simple-catalog__menu a:hover,
  .simple-catalog--mobile .simple-catalog__menu a:focus,
  .simple-catalog--mobile .simple-catalog__menu a:focus-visible,
  .simple-catalog--mobile .simple-catalog__menu a:active{
    background:transparent!important;
    background-color:transparent!important;
    color:#dce5e1!important;
    box-shadow:none!important;
    outline:none!important;
  }
  /* The generic nav underline and color hover target all .nav-link elements.
     The UA menu button intentionally keeps that shell neutral and animates only its three lines. */
  .sg-header .sg-nav-links .sg-categories-trigger--ua,
  .sg-header .sg-nav-links .sg-categories-trigger--ua:hover,
  .sg-header .sg-nav-links .sg-categories-trigger--ua:focus,
  .sg-header .sg-nav-links .sg-categories-trigger--ua:focus-visible,
  .sg-header .sg-nav-links .sg-categories-trigger--ua:active,
  .sg-header .sg-nav-links .sg-categories-trigger--ua.is-open,
  .sg-header .sg-nav-links .sg-categories-trigger--ua[aria-expanded="true"]{
    color:#fff!important;
    background:transparent!important;
    border-color:transparent!important;
    box-shadow:none!important;
    opacity:1!important;
    transform:none!important;
  }
  .sg-header .sg-nav-links .sg-categories-trigger--ua::before,
  .sg-header .sg-nav-links .sg-categories-trigger--ua::after{
    display:none!important;
    content:none!important;
    background:transparent!important;
    border-color:transparent!important;
    box-shadow:none!important;
    transform:none!important;
  }
  .sg-header .sg-nav-links .sg-categories-trigger--ua span{
    background:#fff!important;
    transform:none!important;
    transition:background-color .16s ease!important;
  }
  .sg-header .sg-nav-links .sg-categories-trigger--ua:hover span{background:var(--mint)!important}
  @media (max-width:1120px){
    .sg-header .sg-nav-links .sg-categories-trigger--ua{display:none!important}
  }
  @media (min-width:1121px){
    .sg-header .sg-nav-actions .nav-icon--search-ua-desktop{display:none!important}
    .sg-header .sg-nav-links .sg-categories-trigger--ua{display:inline-flex!important}
    .sg-header .sg-nav-links .sg-categories-trigger--ua:focus-visible{outline:none!important}
    .sg-ua-catalog-menu{
      position:absolute;
      z-index:1200;
      top:100%;
      left:50%;
      width:min(1240px,calc(100vw - 40px));
      max-height:min(610px,calc(100vh - 112px));
      overflow:auto;
      padding:22px 26px 18px;
      border:1px solid rgba(127,215,189,.72);
      border-radius:0 0 18px 18px;
      background:#070908;
      box-shadow:0 20px 48px rgba(0,0,0,.3);
      transform:translateX(-50%);
    }
    .sg-ua-catalog-menu[hidden]{display:none!important}
    .sg-ua-catalog-menu__grid{
      display:grid;
      grid-template-columns:repeat(5,minmax(0,1fr));
      gap:13px 0;
    }
    .sg-ua-catalog-menu__group{
      min-width:0;
      padding:0 16px 0 17px;
      border-left:1px solid rgba(202,225,216,.15);
    }
    .sg-ua-catalog-menu__group:nth-child(5n + 1){padding-left:0;border-left:0}
    .sg-ua-catalog-menu__group:nth-child(n + 6){padding-top:12px;border-top:1px solid rgba(127,215,189,.28)}
    .sg-ua-catalog-menu__group h2{
      margin:0!important;
      padding-bottom:8px;
      border-bottom:1px solid rgba(127,215,189,.58);
      font-size:14px!important;
      line-height:1.22!important;
      font-weight:650!important;
      letter-spacing:0!important;
    }
    .sg-ua-catalog-menu__group h2 a{color:#fff;text-decoration:none}
    .sg-ua-catalog-menu__group h2 a:hover,
    .sg-ua-catalog-menu__group h2 a:focus-visible{color:var(--mint)}
    .sg-ua-catalog-menu__group ul{display:grid;gap:2px;margin:7px 0 0;padding:0;list-style:none}
    .sg-ua-catalog-menu__group li{font-size:12px;line-height:1.4}
    .sg-ua-catalog-menu__group li a{color:#c1c9c5;text-decoration:none}
    .sg-ua-catalog-menu__group li a:hover,
    .sg-ua-catalog-menu__group li a:focus-visible{color:var(--mint);text-decoration:underline;text-decoration-color:var(--mint);text-underline-offset:2px}
    .sg-ua-catalog-menu__cities{
      display:grid;
      grid-template-columns:220px repeat(4,minmax(0,1fr));
      width:100%;
      align-items:stretch;
      gap:0;
      margin-top:16px;
      padding-top:0;
      border-top:1px solid rgba(127,215,189,.42);
      border-bottom:1px solid rgba(202,225,216,.15);
      color:#c1c9c5;
      font-size:12px;
      line-height:1.35;
      box-sizing:border-box;
    }
    .sg-ua-catalog-menu__cities>span{
      display:flex;
      align-items:center;
      min-height:58px;
      padding-right:18px;
      color:var(--mint);
      font-size:11px;
      font-weight:700;
      letter-spacing:.05em;
      text-transform:uppercase;
      white-space:nowrap;
      box-sizing:border-box;
    }
    .sg-ua-catalog-menu__cities>a{
      display:flex;
      align-items:center;
      justify-content:center;
      min-width:0;
      min-height:58px;
      padding:0 12px;
      border-left:1px solid rgba(202,225,216,.15);
      color:#e8efec;
      font-weight:600;
      text-align:center;
      text-decoration:none;
      box-sizing:border-box;
    }
    .sg-ua-catalog-menu__cities>a:hover,
    .sg-ua-catalog-menu__cities>a:focus-visible{
      color:var(--mint);
      background:rgba(127,215,189,.06);
    }
    .sg-ua-catalog-menu__cities b{font-weight:500}
    .sg-ua-catalog-menu__benefits{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      margin-top:13px;
      padding-top:13px;
      border-top:1px solid rgba(202,225,216,.15);
    }
    .sg-ua-catalog-menu__benefits>div{display:flex;min-width:0;align-items:center;gap:9px;padding:0 14px;border-left:1px solid rgba(202,225,216,.15)}
    .sg-ua-catalog-menu__benefits>div:first-child{padding-left:0;border-left:0}
    .sg-ua-catalog-menu__benefits svg{width:19px;height:19px;flex:0 0 19px;fill:none;stroke:var(--mint);stroke-width:1.45;stroke-linecap:round;stroke-linejoin:round}
    .sg-ua-catalog-menu__benefits p{display:grid;gap:2px;margin:0;line-height:1.25}
    .sg-ua-catalog-menu__benefits b{color:#fff;font-size:12px;font-weight:650}
    .sg-ua-catalog-menu__benefits span{color:#aeb9b4;font-size:11px}
  }
</style>
<script>
  const mobileButtons=[...document.querySelectorAll('[data-mobile-menu-button]')];
  const mobileMenu=document.querySelector('[data-mobile-menu]');
  const mobileCatalogToggle=document.querySelector('[data-mobile-catalog-toggle]');
  const mobileCatalogMenu=document.querySelector('[data-mobile-catalog-menu]');
  const mobileCategoryToggles=[...document.querySelectorAll('[data-mobile-category-toggle]')];

  const setMobileCategory=(button,open)=>{
    const menuId=button.getAttribute('aria-controls');
    const menu=menuId?document.getElementById(menuId):null;
    if(!menu) return;
    menu.hidden=!open;
    button.setAttribute('aria-expanded',String(open));
    const categoryName=button.dataset.categoryName ?? '';
    const prefix=open?button.dataset.collapsePrefix:button.dataset.expandPrefix;
    button.setAttribute('aria-label',`${prefix}: ${categoryName}`);
  };

  const closeMobileCategories=(except)=>{
    mobileCategoryToggles.forEach((button)=>{if(button!==except)setMobileCategory(button,false);});
  };

  const setMobileCatalog=(open)=>{
    if(!mobileCatalogToggle || !mobileCatalogMenu) return;
    if(!open) closeMobileCategories();
    mobileCatalogMenu.hidden=!open;
    mobileCatalogToggle.setAttribute('aria-expanded',String(open));
    mobileCatalogToggle.setAttribute('aria-label',open?mobileCatalogToggle.dataset.collapseLabel:mobileCatalogToggle.dataset.expandLabel);
  };

  const closeMobileMenu=()=>{
    if(mobileMenu) mobileMenu.hidden=true;
    setMobileCatalog(false);
    mobileButtons.forEach((button)=>{button.classList.remove('is-open');button.setAttribute('aria-expanded','false');});
  };

  mobileButtons.forEach((button)=>button.addEventListener('click',()=>{
    const isOpen=button.getAttribute('aria-expanded')!=='true';
    setMobileCatalog(false);
    mobileButtons.forEach((item)=>{item.setAttribute('aria-expanded',String(isOpen));item.classList.toggle('is-open',isOpen);});
    if(mobileMenu) mobileMenu.hidden=!isOpen;
  }));

  mobileCatalogToggle?.addEventListener('click',()=>setMobileCatalog(mobileCatalogToggle.getAttribute('aria-expanded')!=='true'));
  mobileCategoryToggles.forEach((button)=>button.addEventListener('click',()=>{
    const open=button.getAttribute('aria-expanded')!=='true';
    closeMobileCategories(button);
    setMobileCategory(button,open);
  }));

  const syncMobileMenu=()=>{
    if(!mobileButtons.some((button)=>getComputedStyle(button).display!=='none')){
      closeMobileMenu();
    }
  };

  window.addEventListener('resize',syncMobileMenu);
  window.addEventListener('orientationchange',syncMobileMenu);
  const uaCatalogMenuButton=document.querySelector('[data-ua-catalog-menu-button]');
  const uaCatalogMenu=document.querySelector('[data-ua-catalog-menu]');
  if(uaCatalogMenuButton && uaCatalogMenu && uaCatalogMenuButton.dataset.menuBound!=='true'){
    uaCatalogMenuButton.dataset.menuBound='true';
    const setUaCatalogMenu=(open)=>{
      uaCatalogMenu.hidden=!open;
      uaCatalogMenuButton.classList.toggle('is-open',open);
      uaCatalogMenuButton.setAttribute('aria-expanded',String(open));
    };
    uaCatalogMenuButton.addEventListener('click',(event)=>{
      event.preventDefault();
      event.stopPropagation();
      setUaCatalogMenu(uaCatalogMenu.hidden);
    });
    uaCatalogMenu.querySelectorAll('a').forEach((link)=>link.addEventListener('click',()=>setUaCatalogMenu(false)));
    document.addEventListener('click',(event)=>{if(!uaCatalogMenu.hidden && !uaCatalogMenu.contains(event.target) && !uaCatalogMenuButton.contains(event.target)) setUaCatalogMenu(false);});
    document.addEventListener('keydown',(event)=>{if(event.key==='Escape') setUaCatalogMenu(false);});
  }
</script>
<script>
  const languageButton=document.querySelector('[data-language-button]');
  languageButton?.addEventListener('click',()=>{
    localStorage.setItem('spaceGlassLocale',languageButton.dataset.targetLocale||'uk');
  });
</script>
<style>
/* Social icons — match existing header controls */
.sg-header-social {
  width: 46px !important;
  height: 46px !important;
  min-width: 46px !important;
  padding: 0 !important;
}

.sg-header-social svg {
  width: 21px !important;
  height: 21px !important;
  display: block;
}
</style>


<style>
/* ===== HEADER LOGO — optimized WebP asset, stable width, height:auto ===== */

.sg-header .brand-logo{
  display:flex !important;
  align-items:center !important;
  flex-shrink:0 !important;
