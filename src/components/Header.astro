    </a>

    <button class="sg-mobile-toggle" type="button" aria-controls="sg-mobile-menu" aria-expanded="false" data-mobile-menu-button>
      <span></span><span></span><span></span>
      <b>{locale === 'ru' ? 'Меню' : 'Меню'}</b>
    </button>

    <nav class="nav__links sg-nav-links" aria-label={tr("Головна навігація")}>
