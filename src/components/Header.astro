  '/projects/',
  '/quote/',
  '/services/',
  '/oplata-dostavka/',
  '/catalog/piddon/',
  '/sklyani-perehorodky/ofisni/',
]);
const hrefForLocale = (path: string) => {
  if (path === '#') return '#';
  if (/^(?:https?:|tel:|mailto:|#)/.test(path)) return path;
  const base = path.replace(/^\/(?:uk|ru)(?=\/|$)/, '') || '/';
  if (locale === 'ru' && !russianRoutes.has(base)) return '/ru/';
  return localizedPath(base, locale);
};

