---
<header class="site-header sg-header">
  <div class="container nav sg-nav">
    <a class="brand-logo" href={lp("/")} aria-label="Space Glass — головна">
      <img src="/images/space-glass-brand-logo.jpg" width="220" height="178" alt="Space Glass" />
    </a>

    <nav class="nav__links sg-nav-links" aria-label="Головна навігація">
      <div class="mega-trigger mega-trigger--catalog">
        <a class="nav-link nav-link--catalog" href={lp("/catalog/")}>Каталог <span class="catalog-arrow">⌄</span></a>

        <div class="catalog-mega catalog-mega--dynamic" data-catalog-mega>
          <div class="catalog-mega__main">
            {menuGroups.map(section => (
              <section class="catalog-mega__column">
                <h3>{section.icon} {section.section}</h3>
                {section.groups.map(group => (
                  <div class="catalog-mega__group" data-menu-key={group.key}>
                    <a class="catalog-mega__group-title" href={group.href}>{group.title}</a>
                    {group.items.map(item => <a href={group.href}>{item}</a>)}
                  </div>
                ))}
              </section>
            ))}

            <section class="catalog-mega__column catalog-mega__architecture">
              <h3>◇ Архітектурні системи</h3>
              <div class="catalog-mega__architecture-list">
                {architectureItems.map(([key,label,href]) => (
                  <a href={href} data-menu-key={key}><span>{label}</span><b>›</b></a>
                ))}
              </div>

              <div class="catalog-mega__popular" data-popular-list>
                {menuData.partitions.popular.map(([title,text,image,href]) => (
                  <a href={href}>
                    <img src={image} width="84" height="66" alt="" loading="lazy" />
                    <span><b>{title}</b><small>{text}</small></span>
                  </a>
                ))}
              </div>
            </section>

            <aside class="catalog-mega__promo" data-promo>
              <img src={menuData.partitions.image} width="560" height="700" alt="Скляні перегородки Space Glass" data-promo-image />
              <div class="catalog-mega__promo-overlay"></div>
              <div class="catalog-mega__promo-copy">
                <p data-promo-eyebrow>{menuData.partitions.eyebrow}</p>
                <h2 data-promo-title>{menuData.partitions.title}</h2>
                <span data-promo-text>{menuData.partitions.text}</span>
                <a class="button button--mint" href={menuData.partitions.href} data-promo-button>{menuData.partitions.button} →</a>
              </div>
            </aside>
          </div>

          <div class="catalog-mega__cities">
            <strong>⌖ Пошук за містами</strong>
            <a href="/city/kyiv/">Київ</a>
            <a href="/city/lviv/">Львів</a>
            <a href="/city/odesa/">Одеса</a>
            <a href="#">Дніпро</a>
            <a href="#">Харків</a>
            <a href="#">Вінниця</a>
            <a href="#">Івано-Франківськ</a>
            <a href={lp("/catalog/")}>Вся Україна →</a>
          </div>

          <div class="catalog-mega__benefits">
            <div><span>⚙</span><b>Власне виробництво</b><small>Сучасне обладнання</small></div>
            <div><span>◇</span><b>{t.warrantyShort ?? 'Гарантія 2 роки'}</b><small>На конструкції та монтаж</small></div>
            <div><span>♙</span><b>Професійний монтаж</b><small>Досвідчені бригади</small></div>
            <div><img src="/images/icons/delivery-truck.png" alt="" width="42" height="30" /><b>Доставка по Україні</b><small>Надійно та в строк</small></div>
          </div>
        </div>
      </div>

      {links.map(([label, href]) => <a class="nav-link" href={lp(href)}>{label}</a>)}
    </nav>

    <div class="nav__actions sg-nav-actions">
      <a class="nav-icon" href={lp("/catalog/")} aria-label="Пошук">⌕</a>
      <a class="nav-icon nav-icon--cart" href={lp("/cart/")} aria-label="Кошик">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 4h2l2.2 10.2a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 2-1.6L21 8H7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="10" cy="20" r="1.4" fill="currentColor"/>
          <circle cx="18" cy="20" r="1.4" fill="currentColor"/>
        </svg>
        <small data-project-header-count>0</small>
      </a>

      <div class="language-switcher" data-language-switcher>
        <button class="language-switcher__button" type="button" aria-haspopup="true" aria-expanded="false" data-language-button>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/>
            <path d="M3.5 12h17M12 3c2.4 2.5 3.6 5.5 3.6 9S14.4 18.5 12 21M12 3C9.6 5.5 8.4 8.5 8.4 12S9.6 18.5 12 21" fill="none" stroke="currentColor" stroke-width="1.3"/>
          </svg>
          <span>{localeInfo.short}</span>
          <i>⌄</i>
        </button>
        <div class="language-switcher__menu" data-language-menu>
          {Object.entries(i18nConfig.locales).filter(([code]) => code === 'uk' || code === 'ru').map(([code, item]) => (
            <a class:list={['language-switcher__option', code === locale && 'is-active']} href={localeSwitchPath(code as 'uk' | 'ru')} hreflang={code} lang={code} data-locale={code}>
              <b>{item.short}</b>
              <span>{item.label}</span>
              {code === locale && <i>✓</i>}
            </a>
          ))}
        </div>
      </div>
      <a class="button button--mint sg-header-cta" href={lp("/contacts/")}>{t.quote}</a>
    </div>

    <button class="sg-mobile-toggle" type="button" aria-controls="sg-mobile-menu" aria-expanded="false" data-mobile-menu-button>
      <span></span><span></span><span></span>
      <b>Menu</b>
    </button>
  </div>
  <div class="sg-mobile-menu" id="sg-mobile-menu" data-mobile-menu hidden>
    <div class="sg-mobile-menu__panel">
      <a class="sg-mobile-menu__primary" href={lp("/catalog/")}>Каталог</a>
      {links.map(([label, href]) => <a href={lp(href)}>{label}</a>)}
      <a href={lp("/cart/")}>Кошик</a>
      {Object.entries(i18nConfig.locales).filter(([code]) => code === 'uk' || code === 'ru').map(([code, item]) => (
        <a href={localeSwitchPath(code as 'uk' | 'ru')} hreflang={code} lang={code}>{item.label}</a>
      ))}
      <a href="tel:+380734251400">+38 (073) 425 14 00</a>
