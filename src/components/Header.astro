<script>
  const mobileButton = document.querySelector('[data-mobile-menu-button]');
  const mobileMenu = document.querySelector('[data-mobile-menu]');
  mobileButton?.addEventListener('click', () => {
    const isOpen = mobileButton.getAttribute('aria-expanded') !== 'true';
    mobileButton.setAttribute('aria-expanded', String(isOpen));
    mobileButton.classList.toggle('is-open', isOpen);
    if (mobileMenu) mobileMenu.hidden = !isOpen;
  });

  const updateProjectHeaderCount = () => {
    let count = 0;
    try {
      const project = JSON.parse(localStorage.getItem('spaceGlassProject') || '{"items":[]}');
      count = project.items.reduce((sum, item) => sum + Number(item.quantity || 1), 0);
    } catch {}
    document.querySelectorAll('[data-project-header-count]').forEach(el => el.textContent = count);
  };

  const updateCompareHeaderCount = () => {
    let count = 0;
    try {
      const compare = JSON.parse(localStorage.getItem('spaceGlassCompare') || '{"items":[]}');
      count = Array.isArray(compare.items) ? compare.items.length : 0;
    } catch {}
    document.querySelectorAll('[data-compare-header-count]').forEach(el => el.textContent = count);
  };

  updateProjectHeaderCount();
  updateCompareHeaderCount();
  window.addEventListener('storage', () => {
    updateProjectHeaderCount();
    updateCompareHeaderCount();
  });
  window.addEventListener('focus', updateProjectHeaderCount);
  window.addEventListener('space-glass-project-updated', updateProjectHeaderCount);
  window.addEventListener('space-glass-compare-updated', updateCompareHeaderCount);
  setInterval(updateProjectHeaderCount, 1500);
</script>

<script define:vars={{ menuData }}>
  const mega = document.querySelector('[data-catalog-mega]');

  if (mega) {
    const image = mega.querySelector('[data-promo-image]');
    const eyebrow = mega.querySelector('[data-promo-eyebrow]');
    const title = mega.querySelector('[data-promo-title]');
    const text = mega.querySelector('[data-promo-text]');
    const button = mega.querySelector('[data-promo-button]');
    const popularList = mega.querySelector('[data-popular-list]');
    let currentKey = 'partitions';

    const renderPopular = (items) => {
      popularList.innerHTML = items.map(([itemTitle,itemText,itemImage,itemHref]) => `
        <a href="${itemHref}">
          <img src="${itemImage}" width="84" height="66" alt="" loading="lazy" />
          <span><b>${itemTitle}</b><small>${itemText}</small></span>
        </a>
      `).join('');
    };

    const updateMenu = (key) => {
      if (!menuData[key] || key === currentKey) return;
      currentKey = key;
      const data = menuData[key];

      image?.classList.add('is-changing');
      setTimeout(() => {
        if (image) {
          image.src = data.image;
          image.alt = data.title;
        }
        eyebrow.textContent = data.eyebrow;
        title.textContent = data.title;
        text.textContent = data.text;
        button.textContent = `${data.button} →`;
        button.href = data.href;
        renderPopular(data.popular);
        requestAnimationFrame(() => image?.classList.remove('is-changing'));
      }, 120);
    };

    mega.querySelectorAll('[data-menu-key]').forEach((item) => {
      item.addEventListener('mouseenter', () => {
        mega.querySelectorAll('[data-menu-key]').forEach(el => el.classList.remove('is-active'));
        item.classList.add('is-active');
        updateMenu(item.dataset.menuKey);
      });
      item.addEventListener('focusin', () => updateMenu(item.dataset.menuKey));
    });
  }
</script>


<script>
  const languageSwitcher = document.querySelector('[data-language-switcher]');
  const languageButton = languageSwitcher?.querySelector('[data-language-button]');
  const languageMenu = languageSwitcher?.querySelector('[data-language-menu]');

  languageButton?.addEventListener('click', (event) => {
    event.stopPropagation();
    const isOpen = languageSwitcher.classList.toggle('is-open');
    languageButton.setAttribute('aria-expanded', String(isOpen));
  });

  document.addEventListener('click', (event) => {
    if (!languageSwitcher?.contains(event.target)) {
      languageSwitcher?.classList.remove('is-open');
      languageButton?.setAttribute('aria-expanded', 'false');
    }
  });

  languageSwitcher?.querySelectorAll('[data-locale]').forEach((link) => {
    link.addEventListener('click', () => {
      localStorage.setItem('spaceGlassLocale', link.dataset.locale);
    });
  });

  if (!localStorage.getItem('spaceGlassLocale')) {
    const browserLocale = (navigator.language || '').toLowerCase();
    const detected = browserLocale.startsWith('ru') ? 'ru' : 'uk';

    localStorage.setItem('spaceGlassLocale', detected);
  }
</script>
