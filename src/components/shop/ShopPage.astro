---
// Common shell of the shop pages (UA/RU): layout, header, breadcrumbs, footer. Catalog pages are indexable (TASK 113); other shop pages stay noindex.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import '../../styles/category-pages.css';
import '../../styles/profile-systems.css';
import '../../styles/led-mirrors.css';

// `indexable`: the shop catalog pages and product pages are indexed (TASK 113); every other shop page stays noindex.
const { locale = 'uk', title, description, crumbs, image, indexable = false } = Astro.props;
---
<BaseLayout title={title} description={description} locale={locale} alternateLocales={['uk', 'ru']} schemaType="CollectionPage" image={image} robots={indexable ? undefined : 'noindex,follow'}>
<div class="sg-page-shell">
  <Header locale={locale} />
  <main id="main">
    <section class="category-section">
      <Breadcrumbs items={crumbs} />
      <slot />
    </section>
  </main>
  <Footer hideBenefits />
</div>
</BaseLayout>

