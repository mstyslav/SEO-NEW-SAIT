---
import ShopPage from './ShopPage.astro';
import pub from '../../data/led-mirrors/public.json';
import { CATEGORIES, SHOP_STR, shopPath } from '../../lib/shop.mjs';
import { STR } from '../../lib/led-mirror-i18n.mjs';

const { locale = 'uk' } = Astro.props;
const S = SHOP_STR[locale as 'uk' | 'ru'];
const T = STR[locale as 'uk' | 'ru'];
const crumbs = [{ label: S.home, href: locale === 'ru' ? '/ru/' : '/' }, { label: S.shop }];
---
<ShopPage locale={locale} title={S.shopTitle} description={S.shopDesc} crumbs={crumbs}>
  <div class="category-heading"><div><p class="eyebrow">{S.shop}</p><h1>{S.h1}</h1></div><p>{S.lead}</p></div>
  <div class="lm-shop-grid">
    {CATEGORIES.map((c) => (
      <a class={`lm-shop-card${c.active ? '' : ' lm-shop-card--soon'}`} href={shopPath(locale, c.path)}>
        <img src={c.image} alt={c.imageAlt[locale as 'uk' | 'ru']} width="900" height="675" loading="lazy" decoding="async" />
        <span class="lm-shop-card__body">
          <h2>{S[c.key as 'mirrors' | 'showers' | 'partitions']}</h2>
          {c.active
            ? <p>{S.mirrorsLead} {S.models48(pub.models.length)}.</p>
            : <span class="lm-shop-card__tag">{S.inPrep}</span>}
          {c.active && <span class="button button--mint">{S.viewModels}</span>}
        </span>
      </a>
    ))}
  </div>
</ShopPage>
