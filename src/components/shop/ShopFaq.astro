---
// Shop FAQ = the main site's FAQBlock (same HTML, faq-block.css and accordion), exactly the given items: visibleCount = expandTo = items.length
// means no extra "show all" button and no padding questions. No FAQPage JSON-LD (FAQBlock emits none; Google limits FAQ rich results).
import FAQBlock from '../FAQBlock.astro';
import { faqTitle } from '../../lib/shop-faq.mjs';
const { locale = 'uk', items, id = 'faq' } = Astro.props;
---
<div class="sf-faqwrap" data-shop-faq data-count={items.length} id={id}>
  <FAQBlock eyebrow="FAQ" title={faqTitle(locale)} items={items} visibleCount={items.length} expandTo={items.length} variant="compact" locale={locale} />
</div>
