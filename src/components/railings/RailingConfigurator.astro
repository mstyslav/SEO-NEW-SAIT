---
/**
 * Step-by-step glass railing configurator (/ogorozhi-configurator/): system → shape →
 * dimensions → colour → glass → handrail → installation → request. Live SVG drawing,
 * instant price with a breakdown; the request goes through the global
 * `[data-lead-form]` handler with the full configuration in hidden fields.
 * Prices: railingPrice() in src/data/railing-pricing.ts (EUR tariffs × working rate from
 * src/pricing/currency.ts + installation); customers see UAH only.
 */
import { EUR, SYSTEMS } from '../../data/railing-pricing';
import { RAILINGS_IMG } from '../../data/railing-catalog';
import { EUR_RU, SYSTEMS_RU } from '../../data/ru/railing-pricing.ru';
import { localizedPath, type Locale } from '../../i18n/helpers';
import '../../styles/configurator-rc.css';

interface Props { locale?: Locale }
const locale: Locale = Astro.props.locale ?? 'uk';
const isRu = locale === 'ru';
const lp = (path: string) => localizedPath(path, locale);
const systems = isRu ? SYSTEMS_RU : SYSTEMS;

// Static UI texts (server) and the strings the client script builds (passed in the JSON data as `t`).
const ui = {
  uk: {
    steps: ['Система', 'Форма', 'Розміри', 'Колір', 'Скло', 'Поручень', 'Монтаж', 'Заявка'], stepsLabel: 'Кроки конфігуратора',
    hint: 'Схема показує сторону A в масштабі. Фото — приклад системи.', estimate: 'Орієнтовна вартість', breakdown: 'Склад ціни',
    chooseSystem: 'Оберіть систему огорожі', chooseShape: 'Оберіть форму огорожі', straight: 'Пряма (I)', corner: 'Кутова (L)', uShape: 'П-подібна (U)',
    dimensions: 'Вкажіть розміри', side: 'Сторона', cm: 'см', height: 'Висота огорожі, см', colourTitle: 'Колір профілю та фурнітури', glass: 'Скло',
    thickness: 'Товщина', glassColour: 'Колір скла', satin: 'Матування', coating: 'Покриття від бруду та води', handrail: 'Поручень', install: 'Монтаж',
    installYes: 'Монтаж Space Glass', installYesNote: 'Замір, доставка, встановлення', installNo: 'Без монтажу', installNoNote: 'Тільки виготовлення',
    city: 'Місто', cities: ['Київ', 'Одеса', 'Львів'], otherCity: 'Інше місто', otherValue: 'Інше', yourConfig: 'Ваша конфігурація', product: 'Скляні огорожі — конфігуратор',
    name: 'Ім’я', namePh: 'Ваше ім’я', phone: 'Телефон', comment: 'Коментар', commentPh: 'Основа (бетон, дерево), поверх, побажання',
    consent: 'Погоджуюсь із', policy: 'політикою конфіденційності', send: 'Надіслати конфігурацію', back: '← Назад', next: 'Далі →',
    disclaimer: 'Ціна орієнтовна: остаточну вартість, товщину скла й кріплення визначаємо після заміру.'
  },
  ru: {
    steps: ['Система', 'Форма', 'Размеры', 'Цвет', 'Стекло', 'Поручень', 'Монтаж', 'Заявка'], stepsLabel: 'Шаги конфигуратора',
    hint: 'Схема показывает сторону A в масштабе. Фото — пример системы.', estimate: 'Ориентировочная стоимость', breakdown: 'Состав цены',
    chooseSystem: 'Выберите систему ограждения', chooseShape: 'Выберите форму ограждения', straight: 'Прямая (I)', corner: 'Угловая (L)', uShape: 'П-образная (U)',
    dimensions: 'Укажите размеры', side: 'Сторона', cm: 'см', height: 'Высота ограждения, см', colourTitle: 'Цвет профиля и фурнитуры', glass: 'Стекло',
    thickness: 'Толщина', glassColour: 'Цвет стекла', satin: 'Матировка', coating: 'Покрытие от грязи и воды', handrail: 'Поручень', install: 'Монтаж',
    installYes: 'Монтаж Space Glass', installYesNote: 'Замер, доставка, установка', installNo: 'Без монтажа', installNoNote: 'Только изготовление',
    city: 'Город', cities: ['Киев', 'Одесса', 'Львов'], otherCity: 'Другой город', otherValue: 'Другой', yourConfig: 'Ваша конфигурация', product: 'Стеклянные ограждения — конфигуратор',
    name: 'Имя', namePh: 'Ваше имя', phone: 'Телефон', comment: 'Комментарий', commentPh: 'Основание (бетон, дерево), этаж, пожелания',
    consent: 'Соглашаюсь с', policy: 'политикой конфиденциальности', send: 'Отправить конфигурацию', back: '← Назад', next: 'Далее →',
    disclaimer: 'Цена ориентировочная: окончательную стоимость, толщину стекла и крепления определяем после замера.'
  }
}[locale];
const t = {
  uk: {
    numLocale: 'uk-UA', uah: 'грн', handrailIncluded: 'Поручень входить у систему', handrailIncludedNote: 'У системах на стійках поручень уже входить у комплект.',
    handrailNote: 'Поручень захищає верхню кромку скла й дає опору — рекомендуємо для сходів і громадських місць.',
    system: 'Система', m: 'м', shape: 'Форма', corners: 'кутів', glass: 'Скло', coating: 'Покриття від бруду', colour: 'Колір',
    discount: 'Знижка за довжину', installLine: 'Замір, доставка й монтаж',
    summary: ['Система', 'Форма', 'Розміри', 'Колір', 'Скло', 'Поручень', 'Монтаж'], shapes: { I: 'пряма', L: 'кутова (L)', U: 'П-подібна (U)' },
    cm: 'см', heightWord: 'висота', coatingShort: 'покриття від бруду', inSystem: 'входить у систему', yes: 'так', no: 'ні',
    total: 'Разом', approx: 'Орієнтовно', toRequest: 'До заявки →', next: 'Далі →',
    frenchNote: 'Французький балкон встановлюється в один проріз — лише пряма форма.', cornersNote: 'Кути з’єднуємо під 90°; нестандартні кути й ухили враховуємо після заміру.',
    dimNoteParts: [': висота скла до ', ' см, ширина однієї панелі до ', ' см — довгі сторони ділимо на панелі автоматично.']
  },
  ru: {
    numLocale: 'ru-UA', uah: 'грн', handrailIncluded: 'Поручень входит в систему', handrailIncludedNote: 'В системах на стойках поручень уже входит в комплект.',
    handrailNote: 'Поручень защищает верхнюю кромку стекла и даёт опору — рекомендуем для лестниц и общественных мест.',
    system: 'Система', m: 'м', shape: 'Форма', corners: 'углов', glass: 'Стекло', coating: 'Покрытие от грязи', colour: 'Цвет',
    discount: 'Скидка за длину', installLine: 'Замер, доставка и монтаж',
    summary: ['Система', 'Форма', 'Размеры', 'Цвет', 'Стекло', 'Поручень', 'Монтаж'], shapes: { I: 'прямая', L: 'угловая (L)', U: 'П-образная (U)' },
    cm: 'см', heightWord: 'высота', coatingShort: 'покрытие от грязи', inSystem: 'входит в систему', yes: 'да', no: 'нет',
    total: 'Итого', approx: 'Ориентировочно', toRequest: 'К заявке →', next: 'Далее →',
    frenchNote: 'Французский балкон устанавливается в один проём — только прямая форма.', cornersNote: 'Углы соединяем под 90°; нестандартные углы и уклоны учитываем после замера.',
    dimNoteParts: [': высота стекла до ', ' см, ширина одной панели до ', ' см — длинные стороны делим на панели автоматически.']
  }
}[locale];
const data = { systems, eur: isRu ? EUR_RU : EUR, img: RAILINGS_IMG, t };
const steps = ui.steps;
const page = lp('/ogorozhi-configurator/');
---
<section class="rc" data-rc>
  <script type="application/json" data-rc-data set:html={JSON.stringify(data)} />
  <ol class="rc__steps" aria-label={ui.stepsLabel}>
    {steps.map((label, i) => <li><button type="button" data-rc-goto={i}><span>{i + 1}</span>{label}</button></li>)}
  </ol>

  <div class="rc__layout">
    <div class="rc__visual">
      <div class="rc__canvas" data-rc-svg aria-hidden="true"></div>
      <div class="rc__visual-meta">
        <img data-rc-photo alt="" width="96" height="96" />
        <div><b data-rc-sysname></b><span data-rc-sysnote></span></div>
      </div>
      <p class="rc__hint">{ui.hint}</p>
    </div>

    <div class="rc__panel">
      <div class="rc__price">
        <div><small>{ui.estimate}</small><strong data-rc-total>—</strong></div>
        <button type="button" class="rc__toggle" data-rc-toggle aria-expanded="false">{ui.breakdown}</button>
      </div>
      <dl class="rc__breakdown" data-rc-breakdown hidden></dl>

      <form class="rc__body" data-rc-form onsubmit="return false">
        <!-- 1 system -->
        <fieldset class="rc__step" data-rc-step="0">
          <legend>{ui.chooseSystem}</legend>
          <!-- Server-rendered (same markup the script re-renders) so the panel has its final height before JS runs — no layout shift. -->
          <div class="rc__systems" data-rc-systems>{systems.map((s, i) => <label class="rc__sys"><input type="radio" name="system" value={s.id} checked={i === 0} /><span><img src={`${RAILINGS_IMG}/${s.image}-192.webp`} alt="" width="120" height="120" loading="lazy" /><b>{s.name}</b><small>{s.note}</small></span></label>)}</div>
        </fieldset>
        <!-- 2 shape -->
        <fieldset class="rc__step" data-rc-step="1" hidden>
          <legend>{ui.chooseShape}</legend>
          <div class="rc__options rc__options--shapes">
            <label><input type="radio" name="shape" value="I" checked /><span><svg viewBox="0 0 60 40"><path d="M8 20h44"/></svg>{ui.straight}</span></label>
            <label><input type="radio" name="shape" value="L" /><span><svg viewBox="0 0 60 40"><path d="M10 6v28h40"/></svg>{ui.corner}</span></label>
            <label><input type="radio" name="shape" value="U" /><span><svg viewBox="0 0 60 40"><path d="M10 6v28h40V6"/></svg>{ui.uShape}</span></label>
          </div>
          <p class="rc__note" data-rc-shape-note></p>
        </fieldset>
        <!-- 3 dimensions -->
        <fieldset class="rc__step" data-rc-step="2" hidden>
          <legend>{ui.dimensions}</legend>
          <div class="rc__fields">
            <label data-side="A">{ui.side} A, {ui.cm}<input type="number" name="A" min="30" max="3000" step="1" value="400" inputmode="numeric" /></label>
            <label data-side="B">{ui.side} B, {ui.cm}<input type="number" name="B" min="30" max="3000" step="1" value="200" inputmode="numeric" /></label>
            <label data-side="C">{ui.side} C, {ui.cm}<input type="number" name="C" min="30" max="3000" step="1" value="200" inputmode="numeric" /></label>
            <label>{ui.height}<input type="number" name="H" min="60" max="130" step="1" value="100" inputmode="numeric" /></label>
          </div>
          <p class="rc__note" data-rc-dim-note></p>
        </fieldset>
        <!-- 4 colour -->
        <fieldset class="rc__step" data-rc-step="3" hidden>
          <legend>{ui.colourTitle}</legend>
          <div class="rc__options rc__options--swatches" data-rc-colours></div>
        </fieldset>
        <!-- 5 glass -->
        <fieldset class="rc__step" data-rc-step="4" hidden>
          <legend>{ui.glass}</legend>
          <p class="rc__label">{ui.thickness}</p>
          <div class="rc__options" data-rc-thickness></div>
          <p class="rc__label">{ui.glassColour}</p>
          <div class="rc__options rc__options--swatches" data-rc-glass></div>
          <p class="rc__label">{ui.satin}</p>
          <div class="rc__options" data-rc-satin></div>
          <label class="rc__check"><input type="checkbox" name="coating" /> {ui.coating}</label>
        </fieldset>
        <!-- 6 handrail -->
        <fieldset class="rc__step" data-rc-step="5" hidden>
          <legend>{ui.handrail}</legend>
          <div class="rc__options" data-rc-handrail></div>
          <p class="rc__note" data-rc-handrail-note></p>
        </fieldset>
        <!-- 7 installation -->
        <fieldset class="rc__step" data-rc-step="6" hidden>
          <legend>{ui.install}</legend>
          <div class="rc__options">
            <label><input type="radio" name="install" value="yes" checked /><span>{ui.installYes}<small>{ui.installYesNote}</small></span></label>
            <label><input type="radio" name="install" value="no" /><span>{ui.installNo}<small>{ui.installNoNote}</small></span></label>
          </div>
          <label class="rc__select">{ui.city}
            <select name="city">
              {ui.cities.map((city) => <option>{city}</option>)}<option value={ui.otherValue}>{ui.otherCity}</option>
            </select>
          </label>
        </fieldset>
      </form>

      <!-- 8 request -->
      <div class="rc__step" data-rc-step="7" hidden>
        <h2 class="rc__legend">{ui.yourConfig}</h2>
        <dl class="rc__summary" data-rc-summary></dl>
        <form class="quote-form contacts-v15-form rc__request" data-lead-form data-success-url="/thank-you/">
          <input name="locale" type="hidden" value={locale} />
          <input name="page" type="hidden" value={page} />
          <input name="product" type="hidden" value={ui.product} />
          <input name="configuration" type="hidden" data-rc-config />
          <div class="contacts-form-grid">
            <label>{ui.name}<input name="name" type="text" autocomplete="name" placeholder={ui.namePh} required /></label>
            <label>{ui.phone}<input name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="+38" required /></label>
          </div>
          <label>{ui.comment}<textarea name="comment" rows="3" placeholder={ui.commentPh} data-rc-comment></textarea></label>
          <label class="quote-consent"><input name="consent" value="accepted" type="checkbox" required /><span>{ui.consent} <a href={lp('/privacy-policy/')}>{ui.policy}</a>.</span></label>
          <button class="button button--mint" type="submit">{ui.send}</button>
          <p data-form-status hidden role="status"></p>
        </form>
      </div>

      <div class="rc__nav">
        <button type="button" class="button button--outline" data-rc-prev>{ui.back}</button>
        <button type="button" class="button button--mint" data-rc-next>{ui.next}</button>
      </div>
      <p class="rc__disclaimer">{ui.disclaimer}</p>
    </div>
  </div>
</section>

<script>
  import { railingPrice, type RailingSystem, type GlassColourId, type SatinId, type ColourId, type HandrailId } from '../../data/railing-pricing';
  type Sys = { id: string; name: string; type: 'profile' | 'points' | 'posts' | 'french'; note: string; image: string; referenceEur: number; maxHeight: number; maxPanel: number; glass: { id: string; label: string; heavy: boolean }[]; handrailIncluded?: boolean; shapes: string[] };

  const root = document.querySelector<HTMLElement>('[data-rc]');
  if (root) {
    const D = JSON.parse(root.querySelector('[data-rc-data]')!.textContent || '{}');
    const E = D.eur;
    const T = D.t;
    const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const form = $<HTMLFormElement>('[data-rc-form]');
    const state = { step: 0, sys: D.systems[0] as Sys, glass: 'clear', satin: 'none', colour: 'steel', handrail: 'none', thickness: 'g17' };
    const uah = (n: number) => `${(Math.round(n / 10) * 10).toLocaleString(T.numLocale)} ${T.uah}`;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

    // ---- option builders
    const radio = (name: string, value: string, label: string, checked: boolean, extra = '') =>
      `<label><input type="radio" name="${name}" value="${value}"${checked ? ' checked' : ''} /><span>${extra}${esc(label)}</span></label>`;
    $('[data-rc-systems]').innerHTML = (D.systems as Sys[]).map((s, i) =>
      `<label class="rc__sys"><input type="radio" name="system" value="${s.id}"${i === 0 ? ' checked' : ''} /><span><img src="${D.img}/${s.image}-192.webp" alt="" width="120" height="120" loading="lazy" /><b>${s.name}</b><small>${esc(s.note)}</small></span></label>`).join('');
    $('[data-rc-colours]').innerHTML = Object.entries(E.colour).map(([k, v]: [string, any]) => radio('colour', k, v.label, k === 'steel', `<i style="background:${v.swatch}"></i>`)).join('');
    $('[data-rc-glass]').innerHTML = Object.entries(E.glass).map(([k, v]: [string, any]) => radio('glass', k, v.label, k === 'clear', `<i style="background:${v.tint}"></i>`)).join('');
    $('[data-rc-satin]').innerHTML = Object.entries(E.satin).map(([k, v]: [string, any]) => radio('satin', k, v.label, k === 'none')).join('');
    const renderThickness = () => {
      const opts = state.sys.glass;
      if (!opts.some((g) => g.id === state.thickness)) state.thickness = opts[0].id;
      $('[data-rc-thickness]').innerHTML = opts.map((g) => radio('thickness', g.id, g.label, g.id === state.thickness)).join('');
    };
    const renderHandrail = () => {
      const incl = !!state.sys.handrailIncluded;
      const entries = Object.entries(E.handrail).filter(([k]) => !incl || k === 'none');
      if (incl) state.handrail = 'none';
      $('[data-rc-handrail]').innerHTML = entries.map(([k, v]: [string, any]) => radio('handrail', k, incl ? T.handrailIncluded : v.label, k === state.handrail)).join('');
      $('[data-rc-handrail-note]').textContent = incl ? T.handrailIncludedNote : T.handrailNote;
    };

    const num = (name: string) => Number((form.elements.namedItem(name) as HTMLInputElement).value) || 0;
    const shape = () => (form.querySelector<HTMLInputElement>('input[name="shape"]:checked')?.value || 'I') as 'I' | 'L' | 'U';
    const sides = () => {
      const s = shape();
      const list: [string, number][] = [['A', num('A')]];
      if (s !== 'I') list.push(['B', num('B')]);
      if (s === 'U') list.push(['C', num('C')]);
      return list.map(([k, v]) => [k, Math.max(30, Math.min(3000, v))] as [string, number]);
    };

    // ---- price
    const price = () => {
      const s = state.sys;
      const sh = shape();
      const L = sides().reduce((a, [, v]) => a + v, 0) / 100;
      const install = (form.querySelector<HTMLInputElement>('input[name="install"]:checked')?.value || 'yes') === 'yes';
      const coating = (form.elements.namedItem('coating') as HTMLInputElement).checked;
      // Same formula as the indexed price blocks: railingPrice() in src/data/railing-pricing.ts.
      const p = railingPrice({ system: s as RailingSystem, shape: sh, lengthM: L, heightCm: num('H'), thickness: state.thickness, glass: state.glass as GlassColourId, satin: state.satin as SatinId, coating, colour: state.colour as ColourId, handrail: state.handrail as HandrailId, install }, E);
      const col = E.colour[state.colour];
      const lines: [string, number][] = [
        [`${T.system} ${s.name}, ${L.toFixed(2).replace('.', ',')} ${T.m}`, p.partsUah.system],
        [`${T.shape} ${sh}${p.corners ? `, ${T.corners}: ${p.corners}` : ''}`, p.partsUah.shape],
        [`${T.glass} ${E.glass[state.glass].label.toLowerCase()}, ${p.areaM2.toFixed(2).replace('.', ',')} ${T.m}²`, p.partsUah.glass],
        [E.satin[state.satin].label, p.partsUah.satin],
        [T.coating, p.partsUah.coating],
        [`${T.colour}: ${col.label}`, p.partsUah.colour],
        [E.handrail[state.handrail].label, p.partsUah.handrail]
      ];
      const items = lines.filter(([, v]) => v > 0.5);
      if (p.factor < 1) items.push([`${T.discount} ${Math.round((1 - p.factor) * 100)}%`, 0]);
      if (install) items.push([T.installLine, p.installUah]);
      return { items, total: p.totalUah, L, H: p.heightM };
    };

    // ---- drawing
    const draw = () => {
      const s = state.sys;
      const [[, aCm]] = sides();
      const Lmm = aCm * 10, Hmm = Math.min(num('H') * 10, s.maxHeight);
      const W = 800, Hh = 470, x0 = 70, floor = 360;
      const sc = Math.min(600 / Lmm, 250 / Hmm);
      const w = Lmm * sc, h = Hmm * sc;
      const tint = E.glass[state.glass].tint;
      const colour = state.colour === 'ral' ? '#7a6f9b' : E.colour[state.colour].swatch;
      const posts = s.type === 'posts';
      const spacing = posts ? 1200 : s.maxPanel;
      const n = Math.max(1, Math.ceil(Lmm / spacing));
      const pw = w / n;
      let g = '';
      // floor slab
      g += `<rect x="${x0 - 30}" y="${floor}" width="${w + 60}" height="34" fill="#e6e6e2"/><line x1="${x0 - 30}" y1="${floor}" x2="${x0 + w + 30}" y2="${floor}" stroke="#c9c9c4" stroke-width="2"/>`;
      const profH = s.type === 'profile' ? Math.max(8, 124 * sc) : 0;
      const gTop = floor - h, gBot = s.type === 'points' ? floor + 20 : posts ? floor - 40 * sc : floor - (s.type === 'profile' ? profH * 0.2 : 0);
      for (let i = 0; i < n; i++) {
        const px = x0 + i * pw + (posts ? 14 : 1.5), pww = pw - (posts ? 28 : 3);
        g += `<rect x="${px}" y="${gTop}" width="${pww}" height="${gBot - gTop}" fill="${tint}" fill-opacity=".7" stroke="#9fb7bd" stroke-width="1.2"/>`;
        if (state.satin === 'full') g += `<rect x="${px}" y="${gTop}" width="${pww}" height="${gBot - gTop}" fill="#fff" fill-opacity=".72"/>`;
        if (state.satin === 'partial') g += `<rect x="${px}" y="${gTop + (gBot - gTop) * 0.35}" width="${pww}" height="${(gBot - gTop) * 0.3}" fill="#fff" fill-opacity=".75"/>`;
        g += `<line x1="${px + pww * 0.18}" y1="${gBot - (gBot - gTop) * 0.2}" x2="${px + pww * 0.34}" y2="${gTop + (gBot - gTop) * 0.2}" stroke="#fff" stroke-opacity=".8" stroke-width="3"/>`;
        if (s.type === 'points') for (const fx of [0.2, 0.8]) g += `<circle cx="${px + pww * fx}" cy="${floor + 12}" r="7" fill="${colour}" stroke="#777" stroke-width="1"/>`;
        if (posts) for (const cx of [px + 4, px + pww - 4]) for (const cy of [gTop + 30, gBot - 30]) g += `<rect x="${cx - 7}" y="${cy - 5}" width="14" height="10" rx="2" fill="${colour}" stroke="#777"/>`;
      }
      if (s.type === 'profile') g += `<rect x="${x0 - 2}" y="${floor - profH}" width="${w + 4}" height="${profH}" fill="${colour}" stroke="#777" stroke-width="1"/>`;
      if (posts) {
        for (let i = 0; i <= n; i++) { const px = x0 + i * pw; g += `<rect x="${px - 5}" y="${gTop - 18}" width="10" height="${floor - gTop + 18}" rx="${s.id === 'gardo' ? 5 : 1}" fill="${colour}" stroke="#777"/>`; }
        g += `<rect x="${x0 - 10}" y="${gTop - 26}" width="${w + 20}" height="12" rx="${s.id === 'gardo' ? 6 : 1}" fill="${colour}" stroke="#777"/>`;
      }
      if (s.type === 'french') {
        g += `<rect x="${x0 - 14}" y="${gTop - 40}" width="12" height="${floor - gTop + 40}" fill="#d9d9d4"/><rect x="${x0 + w + 2}" y="${gTop - 40}" width="12" height="${floor - gTop + 40}" fill="#d9d9d4"/>`;
        if (s.id === 'lineo') g += `<rect x="${x0 - 4}" y="${gTop}" width="6" height="${h}" fill="${colour}"/><rect x="${x0 + w - 2}" y="${gTop}" width="6" height="${h}" fill="${colour}"/>`;
        else for (const cx of [x0 + 4, x0 + w - 4]) for (const cy of [gTop + 20, floor - 20]) g += `<circle cx="${cx}" cy="${cy}" r="6" fill="${colour}" stroke="#777"/>`;
      }
      const hr = state.handrail;
      if (hr === 'round') g += `<rect x="${x0 - 8}" y="${gTop - 14}" width="${w + 16}" height="12" rx="6" fill="${colour}" stroke="#777"/>`;
      if (hr === 'square') g += `<rect x="${x0 - 8}" y="${gTop - 14}" width="${w + 16}" height="12" rx="1" fill="${colour}" stroke="#777"/>`;
      if (hr === 'u') g += `<rect x="${x0 - 2}" y="${gTop - 5}" width="${w + 4}" height="8" rx="2" fill="${colour}" stroke="#777"/>`;
      // dimensions
      g += `<g stroke="#347a66" stroke-width="1.4" fill="none"><path d="M${x0} ${floor + 58}h${w}M${x0} ${floor + 50}v16M${x0 + w} ${floor + 50}v16"/><path d="M${x0 + w + 44} ${gTop}v${h}M${x0 + w + 36} ${gTop}h16M${x0 + w + 36} ${floor}h16"/></g>`;
      g += `<text x="${x0 + w / 2}" y="${floor + 82}" text-anchor="middle" font-size="18" font-weight="700" fill="#1c211e">A = ${(aCm / 100).toFixed(2).replace('.', ',')} м</text>`;
      g += `<text x="${x0 + w + 56}" y="${gTop + h / 2}" font-size="18" font-weight="700" fill="#1c211e">H = ${(Hmm / 1000).toFixed(2).replace('.', ',')} м</text>`;
      // plan
      const sh = shape();
      const plan = sh === 'I' ? 'M660 60h110' : sh === 'L' ? 'M660 26v60h110' : 'M660 26v60h110V26';
      g += `<g><rect x="640" y="14" width="150" height="96" rx="12" fill="#f4f8f6"/><path d="${plan}" stroke="#176f58" stroke-width="5" fill="none" stroke-linecap="round"/>`;
      g += sh === 'I' ? `<text x="715" y="50" text-anchor="middle" font-size="14" fill="#176f58">A</text>` : sh === 'L' ? `<text x="648" y="60" font-size="14" fill="#176f58">B</text><text x="715" y="104" text-anchor="middle" font-size="14" fill="#176f58">A</text>` : `<text x="648" y="60" font-size="14" fill="#176f58">B</text><text x="715" y="104" text-anchor="middle" font-size="14" fill="#176f58">A</text><text x="776" y="60" font-size="14" fill="#176f58">C</text>`;
      g += `</g>`;
      $('[data-rc-svg]').innerHTML = `<svg viewBox="0 0 ${W} ${Hh}" role="img">${g}</svg>`;
      const photo = $<HTMLImageElement>('[data-rc-photo]');
      photo.src = `${D.img}/${s.image}-192.webp`;
      $('[data-rc-sysname]').textContent = s.name;
      $('[data-rc-sysnote]').textContent = s.note;
    };

    const summaryRows = () => {
      const s = state.sys;
      return [
        [T.summary[0], `${s.name} — ${s.note}`],
        [T.summary[1], T.shapes[shape()]],
        [T.summary[2], `${sides().map(([k, v]) => `${k} ${v} ${T.cm}`).join(', ')}, ${T.heightWord} ${Math.min(num('H'), s.maxHeight / 10)} ${T.cm}`],
        [T.summary[3], E.colour[state.colour].label],
        [T.summary[4], `${s.glass.find((g) => g.id === state.thickness)?.label}, ${E.glass[state.glass].label.toLowerCase()}, ${E.satin[state.satin].label.toLowerCase()}${(form.elements.namedItem('coating') as HTMLInputElement).checked ? `, ${T.coatingShort}` : ''}`],
        [T.summary[5], s.handrailIncluded ? T.inSystem : E.handrail[state.handrail].label],
        [T.summary[6], `${(form.querySelector<HTMLInputElement>('input[name="install"]:checked')?.value || 'yes') === 'yes' ? T.yes : T.no}, ${(form.elements.namedItem('city') as HTMLSelectElement).value}`]
      ];
    };

    const update = () => {
      const s = state.sys;
      // limits per system
      const hIn = form.elements.namedItem('H') as HTMLInputElement;
      hIn.max = String(s.maxHeight / 10);
      $('[data-rc-dim-note]').textContent = `${s.name}${T.dimNoteParts[0]}${s.maxHeight / 10}${T.dimNoteParts[1]}${s.maxPanel / 10}${T.dimNoteParts[2]}`;
      root.querySelectorAll<HTMLInputElement>('input[name="shape"]').forEach((inp) => { inp.disabled = !s.shapes.includes(inp.value); if (inp.disabled && inp.checked) (root.querySelector('input[name="shape"][value="I"]') as HTMLInputElement).checked = true; });
      $('[data-rc-shape-note]').textContent = s.type === 'french' ? T.frenchNote : T.cornersNote;
      const sh = shape();
      root.querySelectorAll<HTMLElement>('[data-side]').forEach((el) => { el.hidden = (el.dataset.side === 'B' && sh === 'I') || (el.dataset.side === 'C' && sh !== 'U'); });
      const p = price();
      $('[data-rc-total]').textContent = uah(p.total);
      $('[data-rc-breakdown]').innerHTML = p.items.map(([t, v]) => `<div><dt>${esc(t)}</dt><dd>${v ? uah(v) : '✓'}</dd></div>`).join('') + `<div class="rc__breakdown-total"><dt>${T.total}</dt><dd>${uah(p.total)}</dd></div>`;
      const rows = summaryRows();
      $('[data-rc-summary]').innerHTML = rows.map(([k, v]) => `<div><dt>${k}</dt><dd>${esc(String(v))}</dd></div>`).join('') + `<div><dt>${T.approx}</dt><dd><b>${uah(p.total)}</b></dd></div>`;
      $<HTMLInputElement>('[data-rc-config]').value = rows.map(([k, v]) => `${k}: ${v}`).join('; ') + `; ${T.approx}: ${uah(p.total)}`;
      draw();
    };

    // scroll = false for the initial render: the page must not jump to the panel on load.
    const go = (i: number, scroll = true) => {
      state.step = Math.max(0, Math.min(7, i));
      root.querySelectorAll<HTMLElement>('[data-rc-step]').forEach((el) => { el.hidden = Number(el.dataset.rcStep) !== state.step; });
      root.querySelectorAll<HTMLButtonElement>('[data-rc-goto]').forEach((b) => { const k = Number(b.dataset.rcGoto); b.classList.toggle('is-active', k === state.step); b.classList.toggle('is-done', k < state.step); });
      $<HTMLButtonElement>('[data-rc-prev]').disabled = state.step === 0;
      const next = $<HTMLButtonElement>('[data-rc-next]');
      next.hidden = state.step === 7;
      next.textContent = state.step === 6 ? T.toRequest : T.next;
      update();
      if (scroll && window.innerWidth < 900) root.querySelector('.rc__panel')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    root.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'system') { state.sys = (D.systems as Sys[]).find((s) => s.id === t.value)!; renderThickness(); renderHandrail(); }
      if (t.name === 'glass') state.glass = t.value;
      if (t.name === 'satin') state.satin = t.value;
      if (t.name === 'colour') state.colour = t.value;
      if (t.name === 'handrail') state.handrail = t.value;
      if (t.name === 'thickness') state.thickness = t.value;
      update();
    });
    root.addEventListener('input', (e) => { if ((e.target as HTMLElement).matches('input[type="number"]')) update(); });
    root.querySelectorAll<HTMLButtonElement>('[data-rc-goto]').forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.rcGoto))));
    $('[data-rc-prev]').addEventListener('click', () => go(state.step - 1));
    $('[data-rc-next]').addEventListener('click', () => go(state.step + 1));
    const toggle = $<HTMLButtonElement>('[data-rc-toggle]');
    toggle.addEventListener('click', () => { const bd = $('[data-rc-breakdown]'); bd.hidden = !bd.hidden; toggle.setAttribute('aria-expanded', String(!bd.hidden)); });

    // Preselect a system from ?system=delgado
    const pre = new URLSearchParams(location.search).get('system');
    const preSys = (D.systems as Sys[]).find((s) => s.id === pre);
    if (preSys) { state.sys = preSys; (root.querySelector(`input[name="system"][value="${preSys.id}"]`) as HTMLInputElement).checked = true; }
    renderThickness();
    renderHandrail();
    go(0, false);
  }
</script>
