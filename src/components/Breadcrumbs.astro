---
interface Item { label: string; href?: string }
interface Props { items: Item[] }
const { items } = Astro.props;
const schema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem', position: index + 1, name: item.label,
    ...(item.href ? { item: new URL(item.href, Astro.site ?? Astro.url.origin).href } : {})
  }))
};
---
<nav class="seo-breadcrumbs" aria-label="Навігаційний ланцюжок">
  <ol>
    {items.map((item, index) => <li>{item.href && index < items.length - 1 ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</li>)}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
