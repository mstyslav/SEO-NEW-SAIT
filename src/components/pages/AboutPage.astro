---
// Shared template for /about/ in both locales — src/pages/about.astro (uk)
// and src/pages/ru/about/index.astro (ru) are thin wrappers that just pass
// `locale` here. DOM/CSS is identical between locales; only src/content/i18n/pages/about.ts differs.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { localizedPath, type Locale } from '../../i18n/helpers';
import { aboutContent } from '../../content/i18n/pages/about';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = aboutContent[locale];
const lp = (path: string) => localizedPath(path, locale);

const clients = [
  ['CHOICE', '/images/partners/choice.svg'],
  ['GAGARINN PLAZA', '/images/partners/gagarinn-plaza.svg'],
  ['MARISTELLA', '/images/partners/maristella.svg'],
  ['NOFILTERS', '/images/partners/nofilters.svg'],
  ['ZDRAVO', '/images/partners/zdravo.svg'],
  ['CHERRY TWINS ODESSA', '/images/partners/cherry-twins.svg']
];

const systems = [
  ['SCHÜCO', '/images/brands/schueco-300.webp'],
  ['ALUPROF', '/images/brands/aluprof-300.webp'],
  ['REYNAERS', '/images/brands/reynaers-300.webp'],
  ['AGC', '/images/brands/agc-300.webp'],
  ['DORMA', '/images/brands/dorma-300.webp'],
  ['SIEGENIA', '/images/brands/siegenia-300.webp'],
  ['GU', '/images/brands/gu-300.webp'],
  ['BTS', '/images/brands/bts-300.webp']
];
---
<BaseLayout title={t.meta.title} description={t.meta.description} locale={locale} schemaType="AboutPage">
  <div class="sg-page-shell">
    <Header locale={locale} />
    <main id="main" class="about-premium">
      <section class="sg-hero about-main-hero">
  <div class="sg-hero__copy">
    <p class="eyebrow">{t.hero.eyebrow}</p>

    <h1>
      <span>{t.hero.h1[0]}</span>
      <span>{t.hero.h1[1]}</span>
      <span>{t.hero.h1[2]}</span>
    </h1>
    <p class="about-main-hero__subtitle">{t.hero.subtitle}</p>
  </div>

  <div class="sg-hero__image">
    <picture>
      <source
        media="(max-width: 760px)"
        srcset="/images/about/about-hero-mobile.webp"
      />
      <img
        src="/images/about/about-hero-desktop.webp"
        alt={t.hero.imageAlt}
        width="1280"
        height="640"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>
</section>

<section class="about-v12-facts" aria-label={t.statsAriaLabel}>
  <article class="about-stat"><svg class="about-stat__icon" viewBox="0 0 32 32" aria-hidden="true"><path d="M5 28V9l8-5v24M13 28V5l8 4v19M21 28V13l6 3v12M8 13h2m-2 5h2m6-7h2m-2 5h2m-2 5h2m6-2h2" /></svg><div><b>{t.stats[0][0]}</b><span>{t.stats[0][1]}</span></div></article>
  <article class="about-stat"><svg class="about-stat__icon" viewBox="0 0 32 32" aria-hidden="true"><path d="m16 3 11 6v14l-11 6-11-6V9l11-6Zm0 0v12m11-6-11 6L5 9m11 6v14" /></svg><div><b>{t.stats[1][0]}</b><span>{t.stats[1][1]}</span></div></article>
  <article class="about-stat"><svg class="about-stat__icon" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3 26 7v8c0 6-4.2 11-10 14C10.2 26 6 21 6 15V7l10-4Zm-4 13 3 3 6-7" /></svg><div><b>{t.stats[2][0]}</b><span>{t.stats[2][1]}</span></div></article>
  <article class="about-stat"><svg class="about-stat__icon" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 29s9-8.1 9-16A9 9 0 1 0 7 13c0 7.9 9 16 9 16Zm0-12a4 4 0 1 1 0-8 4 4 0 0 1 0 8Z" /></svg><div><b>{t.stats[3][0]}</b><span>{t.stats[3][1]}</span></div></article>
</section>

      <section class="about-directions section-pad" aria-labelledby="about-directions-title">
        <div class="about-directions__intro">
          <p class="eyebrow">{t.directions.eyebrow}</p>
          <h2 id="about-directions-title">{t.directions.title}</h2>
          <p>{t.directions.intro}</p>
        </div>
        <nav aria-label={t.directions.navAriaLabel}>
          <ul class="about-directions__list">
            {t.directions.items.map((item) => <li><a href={lp(item.href)}><span>{item.label}</span><svg class="about-directions__arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" /></svg></a></li>)}
          </ul>
        </nav>
      </section>

      <section class="story section-pad">
        <div class="story__intro">
          <div><p class="eyebrow">{t.story.eyebrow}</p><h2>{t.story.title}</h2></div>
          <div class="story__copy">
            <p>{t.story.paragraphs[0]}</p>
            <p>{t.story.paragraphs[1]}</p>
          </div>
        </div>
        <div class="timeline" aria-label={t.story.timelineAriaLabel}>
          {t.timeline.map(({ year, text, image }) => <article><span class="timeline__dot"></span><b>{year}</b><p>{text}</p><div class="timeline__image" aria-hidden="true"><img src={image} width="400" height="225" alt="" loading="lazy" decoding="async" /></div></article>)}
        </div>
      </section>

      <section class="values section-pad">
        <div class="values__head"><p class="eyebrow">{t.values.eyebrow}</p><h2>{t.values.title}</h2></div>
        <div class="values__grid">
          {t.values.items.map(([title,text],i) => <article><span>0{i+1}</span><h3>{title}</h3><p>{text}</p></article>)}
        </div>
      </section>

      <section class="team section-pad">
        <div class="section-head"><div><p class="eyebrow">{t.team.eyebrow}</p><h2>{t.team.title}</h2></div><p>{t.team.intro}</p></div>
        <div class="team-grid">
          {t.team.members.map(({ name, role, img }) => <article class="team-card"><div class="team-photo"><img src={img} alt={`${name} — ${role}`} loading="lazy" decoding="async" /></div><div class="team-caption"><h3>{name}</h3><p>{role}</p></div></article>)}
        </div>
        <a class="outline-link" href="#career">{t.team.careerLinkLabel}</a>
      </section>

      <section class="trust section-pad about-partners-final">
      <div class="about-partners-final__intro">
        <div>
          <p class="eyebrow">{t.trust.eyebrow}</p>
          <h2 set:html={t.trust.titleHtml} />
        </div>
      </div>

      <a href={lp('/projects/')} class="about-partners-final__link">
        {t.trust.linkLabel} <span>→</span>
      </a>

      <div class="about-partners-final__logos">
        <div><img src="/images/partners/clients/cooperationslider1.png.png" alt="Choice" width="180" height="81" loading="lazy" /></div>
        <div><img src="/images/partners/clients/cooperationslider2.png.png" alt="Ofecor" width="180" height="81" loading="lazy" /></div>
        <div><img src="/images/partners/clients/cooperationslider3.png.png" alt="Nofilters" width="180" height="81" loading="lazy" /></div>
        <div><img src="/images/partners/clients/cooperationslider4.png.png" alt="Gagarinn Plaza" width="180" height="81" loading="lazy" /></div>

        <div><img src="/images/partners/clients/cooperationslider5.png.png" alt="Maristella" width="180" height="81" loading="lazy" /></div>
        <div><img src="/images/partners/clients/cherry_twins_odessa_logo.png.png" alt="Cherry Twins Odessa" width="176" height="146" loading="lazy" /></div>
        <div><img src="/images/partners/clients/kselen_logo-1.png.png" alt="Kselena" width="192" height="91" loading="lazy" /></div>
        <div><img src="/images/partners/clients/notfilters_logo.png.png" alt="Nofilters" width="402" height="109" loading="lazy" /></div>
      </div>
    </section>

      <section class="systems section-pad">
        <div class="section-head section-head--compact"><div><p class="eyebrow">{t.systems.eyebrow}</p><h2>{t.systems.title}</h2></div><a href={lp('/catalog/')}>{t.systems.linkLabel}</a></div>
        <div class="logo-strip logo-strip--systems">
          {systems.map(([name,img]) => <div class="logo-item logo-item--system"><img src={img} alt={name} loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='block'" /><span>{name}</span></div>)}
        </div>
      </section>

      <section class="final-cta" id="contact"><div><p class="eyebrow">{t.finalCta.eyebrow}</p><h2>{t.finalCta.title}</h2><p>{t.finalCta.text}</p></div><a href={`${lp('/')}#quote`}>{t.finalCta.buttonLabel}</a></section>

      <section id="career" class="career section-pad">
        <div class="career__copy"><p class="eyebrow">{t.career.eyebrow}</p><h2>{t.career.title}</h2><p>{t.career.text}</p></div>
        <form class="career__form"><input type="text" aria-label={t.career.nameLabel} placeholder={t.career.namePlaceholder} /><input type="tel" aria-label={t.career.phoneLabel} placeholder={t.career.phonePlaceholder} /><select aria-label={t.career.jobAriaLabel}><option>{t.career.jobPlaceholder}</option>{t.career.jobOptions.map((option) => <option>{option}</option>)}</select><button type="button">{t.career.submitLabel}</button></form>
      </section>
    </main>
    <Footer locale={locale} />
  </div>
</BaseLayout>

<style>
  .about-premium{--mint:#72cdb1;--green:#176f58;--green-deep:#0e5947;--ink:#111513;--muted:#5e6864;--line:#dce5e1;--soft:#f5f9f7;background:#fff;color:var(--ink)}
  .about-premium *{box-sizing:border-box}.section-pad{padding:84px 5.2%}.eyebrow{margin:0 0 12px;text-transform:uppercase;letter-spacing:.2em;font-size:12px;font-weight:900;color:#2a8369}.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:50px;margin-bottom:34px}.section-head h2,.story h2,.values h2,.career h2,.final-cta h2{margin:0;font-size:clamp(34px,3.2vw,56px);line-height:1.02;letter-spacing:-.045em}.section-head>p{max-width:520px;margin:0;color:var(--muted);font-size:17px;line-height:1.55}.section-head--compact{align-items:center}.section-head a,.outline-link{color:#176f58;text-decoration:none;font-weight:800;font-size:13px}.outline-link{display:block;width:max-content;margin:24px auto 0;border:1px solid #8bc9b6;padding:11px 18px}
  .hero{position:relative;min-height:690px;overflow:hidden;background:#fff}.hero__media{position:absolute;inset:0;background-image:url('/images/about/about-hero.png'),url('/images/about/history/2016.jpg');background-size:cover;background-position:72% 50%;transform:scale(1.002)}.hero__veil{position:absolute;inset:0;background:linear-gradient(104deg,#fff 0 31%,rgba(255,255,255,.97) 33%,rgba(255,255,255,.75) 41%,rgba(255,255,255,.08) 58%,rgba(255,255,255,0) 72%);clip-path:polygon(0 0,58% 0,39% 100%,0 100%)}.hero:after{content:"";position:absolute;left:35.2%;top:-8%;width:3px;height:118%;background:rgba(255,255,255,.86);transform:rotate(24deg);transform-origin:center;box-shadow:-110px 0 0 rgba(114,205,177,.7)}.hero__copy{position:relative;z-index:2;padding:88px 5.2% 210px;width:min(570px,48%)}.hero__copy h1{font-size:clamp(76px,7.6vw,124px);line-height:.78;letter-spacing:-.065em;margin:14px 0 26px}.hero__line{display:block;width:42px;height:2px;background:var(--green);margin-bottom:24px}.hero__subtitle{font-size:21px;line-height:1.35;margin:0}.facts{position:absolute;z-index:3;left:4.8%;right:4.8%;bottom:0;background:rgba(255,255,255,.96);backdrop-filter:blur(12px);display:grid;grid-template-columns:repeat(4,1fr);box-shadow:0 12px 35px rgba(20,40,32,.08)}.facts article{min-height:118px;display:flex;align-items:center;gap:22px;padding:22px 32px;border-right:1px solid var(--line)}.facts article:last-child{border-right:0}.facts strong{display:block;font-size:clamp(28px,2.6vw,44px);line-height:1;color:#2c8a6d;letter-spacing:-.04em}.facts p{margin:7px 0 0;font-size:13px;line-height:1.35}.fact-icon{width:44px;height:44px;flex:0 0 44px;position:relative;color:#2c8a6d}.fact-icon--building{border:2px solid currentColor;border-top:0;margin-top:7px}.fact-icon--building:before,.fact-icon--building:after{content:"";position:absolute;bottom:0;border:2px solid currentColor;border-bottom:0}.fact-icon--building:before{width:13px;height:31px;left:4px}.fact-icon--building:after{width:14px;height:39px;right:4px}.fact-icon--glass{border:2px solid currentColor}.fact-icon--glass:before,.fact-icon--glass:after{content:"";position:absolute;background:currentColor}.fact-icon--glass:before{left:50%;top:0;bottom:0;width:1px}.fact-icon--glass:after{top:50%;left:0;right:0;height:1px}.fact-icon--sun{border:2px solid currentColor;border-radius:50%;transform:scale(.52)}.fact-icon--sun:before{content:"";position:absolute;inset:-18px;border:2px dashed currentColor;border-radius:50%}.fact-icon--pin{border:2px solid currentColor;border-radius:50% 50% 50% 0;transform:rotate(-45deg) scale(.7)}.fact-icon--pin:after{content:"";position:absolute;width:9px;height:9px;border:2px solid currentColor;border-radius:50%;left:50%;top:50%;transform:translate(-50%,-50%)}
  .story{border-bottom:1px solid var(--line)}.story__intro{display:grid;grid-template-columns:.75fr 1.25fr;gap:8%;align-items:start}.story__copy{color:#404a46;font-size:17px;line-height:1.66}.story__copy p:first-child{margin-top:0}.timeline{display:grid;grid-template-columns:repeat(7,1fr);margin-top:56px;border-top:2px solid #9ccdbd}.timeline article{position:relative;padding:22px 20px 0 0;min-width:0}.timeline__dot{position:absolute;width:10px;height:10px;background:#fff;border:3px solid #257d63;border-radius:50%;top:-6px;left:0}.timeline b{font-size:20px}.timeline p{font-size:12px;line-height:1.42;color:#46514d;min-height:50px}.timeline__image{height:92px;margin-top:14px;overflow:hidden;border:1px solid #e1e8e5}.timeline__image img{display:block;width:100%;height:100%;object-fit:cover;object-position:center}
  .values{background:var(--soft);border-bottom:1px solid var(--line)}.values__head{max-width:760px;margin-bottom:42px}.values__grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.values__grid article{padding:30px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:#fff}.values__grid article>span{display:block;color:#2d8268;font-size:12px;font-weight:900;margin-bottom:28px}.values__grid h3{font-size:20px;margin:0 0 10px}.values__grid p{margin:0;color:var(--muted);line-height:1.5}
  .team{border-bottom:1px solid var(--line)}.team-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:12px}.team-card{background:#fff}.team-photo{aspect-ratio:4/5;overflow:hidden;border:1px solid #e0e7e4}.team-photo img{display:block;width:100%;height:100%;object-fit:cover;object-position:50% 34%}.team-caption{text-align:center;padding:10px 4px 8px}.team-caption h3{font-size:15px;margin:0 0 4px}.team-caption p{font-size:11px;line-height:1.35;margin:0;color:#63706b}
  .trust{border-bottom:1px solid var(--line)}.logo-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:0}.logo-item{min-height:116px;display:flex;align-items:center;justify-content:center;padding:24px;border-bottom:1px solid #edf1ef}.logo-item img{display:block;max-width:170px;max-height:52px;width:auto;height:auto;filter:grayscale(1);opacity:.74;transition:filter .2s,opacity .2s}.logo-item:hover img{filter:none;opacity:1}.logo-item span{display:none;font-size:16px;font-weight:800;color:#77807c;text-align:center;letter-spacing:.035em}.logo-item--system img{max-width:150px;max-height:46px}
  .career{display:grid;grid-template-columns:.8fr 1.2fr;gap:72px;align-items:end;background:linear-gradient(105deg,#f3faf7,#fff);border-bottom:1px solid var(--line)}.career__copy>p:not(.eyebrow){color:var(--muted);font-size:17px;line-height:1.55}.career__form{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:24px}.career__form input,.career__form select,.career__form button{height:52px;border-radius:4px}.career__form input,.career__form select{border:1px solid #ccd9d4;background:#fff;padding:0 14px}.career__form button{border:0;background:var(--green-deep);color:#fff;font-weight:800;font-size:16px}
  .systems{border-bottom:1px solid var(--line)}.final-cta{display:grid;grid-template-columns:1.5fr .5fr;gap:60px;align-items:center;padding:68px 5.2%;background:linear-gradient(90deg,#f5faf8,#fff)}.final-cta p:not(.eyebrow){max-width:760px;color:var(--muted);font-size:17px;line-height:1.55}.final-cta a{justify-self:end;background:var(--green-deep);color:#fff;text-decoration:none;font-weight:800;padding:17px 26px;border-radius:4px}
  @media(max-width:1180px){.hero{min-height:760px}.hero__copy{width:58%}.facts{grid-template-columns:1fr 1fr}.facts article:nth-child(2){border-right:0}.facts article:nth-child(-n+2){border-bottom:1px solid var(--line)}.story__intro{grid-template-columns:1fr}.timeline{grid-template-columns:repeat(4,1fr);border-top:0;gap:24px}.timeline article{border-top:2px solid #9ccdbd}.timeline__dot{top:-6px}.values__grid{grid-template-columns:1fr 1fr}.team-grid{grid-template-columns:repeat(4,1fr)}.logo-strip{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:760px){.section-pad{padding:58px 22px}.hero{min-height:760px}.hero__media{background-position:68% 50%}.hero__veil{background:linear-gradient(180deg,rgba(255,255,255,.98) 0 38%,rgba(255,255,255,.56) 56%,rgba(255,255,255,0) 74%);clip-path:none}.hero:after{display:none}.hero__copy{padding:54px 22px 0;width:100%}.hero__copy h1{font-size:68px}.hero__subtitle{font-size:18px}.facts{left:16px;right:16px;grid-template-columns:1fr 1fr}.facts article{min-height:98px;padding:16px;gap:12px}.fact-icon{width:34px;height:34px;flex-basis:34px}.facts strong{font-size:25px}.facts p{font-size:11px}.section-head{display:block}.section-head>p{margin-top:14px}.timeline{grid-template-columns:1fr 1fr}.values__grid{grid-template-columns:1fr}.team-grid{grid-template-columns:repeat(2,1fr)}.logo-strip{grid-template-columns:repeat(2,1fr)}.career{grid-template-columns:1fr}.career__form{grid-template-columns:1fr}.final-cta{grid-template-columns:1fr;padding:54px 22px}.final-cta a{justify-self:start}}
</style>

<style>
/* About content hierarchy: statistics and internal directions. */
.about-premium .about-v12-facts {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  padding: 0 5.2%;
  background: #fff;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.about-stat {
  display: flex;
  min-width: 0;
  gap: 14px;
  align-items: flex-start;
  padding: 28px 24px;
  border-right: 1px solid var(--line);
}

.about-stat:last-child { border-right: 0; }
.about-stat > div { min-width: 0; padding: 0; border: 0; }
.about-stat__icon { width: 32px; height: 32px; flex: 0 0 32px; color: var(--green); fill: none; stroke: currentColor; stroke-width: 1.45; stroke-linecap: round; stroke-linejoin: round; }
.about-stat b { display: block; color: var(--green-deep); font-family: Arial, Helvetica, sans-serif; font-size: clamp(1.55rem, 2.2vw, 2.25rem); font-weight: 700; line-height: 1; letter-spacing: -.045em; }
.about-stat span { display: block; margin-top: 8px; color: var(--ink); font-family: Arial, Helvetica, sans-serif; font-size: 13px; font-weight: 600; line-height: 1.4; }
.about-stat small { display: block; margin-top: 6px; color: var(--muted); font-family: Arial, Helvetica, sans-serif; font-size: 11px; font-weight: 400; line-height: 1.45; }

.about-directions { border-bottom: 1px solid var(--line); }
.about-directions__intro { display: grid; grid-template-columns: minmax(0, .9fr) minmax(420px, 1.1fr); gap: 48px; align-items: end; margin-bottom: 30px; }
.about-directions h2 { max-width: 760px; margin: 0; font-size: clamp(34px, 3.2vw, 56px); line-height: 1.02; letter-spacing: -.045em; }
.about-directions__intro > p:last-child { max-width: 500px; margin: 0; color: var(--muted); font-size: 17px; line-height: 1.55; }
.about-directions__list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; margin: 0; padding: 0; list-style: none; }
.about-directions__list li { min-width: 0; border-bottom: 1px solid color-mix(in srgb, var(--line) 72%, transparent); }
.about-directions__list li:nth-child(-n + 4) { border-bottom-color: transparent; }
.about-directions__list li:not(:nth-child(4n)) { border-right: 1px solid color-mix(in srgb, var(--line) 72%, transparent); }
.about-directions__list a { display: flex; min-height: 88px; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 22px; color: var(--ink); font-size: 14px; font-weight: 700; line-height: 1.4; text-decoration: none; }
.about-directions__arrow { width: 18px; height: 18px; flex: 0 0 18px; color: var(--green-deep); fill: none; stroke: currentColor; stroke-width: 1.35; stroke-linecap: round; stroke-linejoin: round; }
.about-directions__list a:focus-visible { outline: 2px solid var(--mint); outline-offset: -2px; }
@media (hover:hover) { .about-directions__list a:hover { background: color-mix(in srgb, var(--soft) 55%, transparent); color: var(--green-deep); } }

@media (max-width: 1000px) {
  .about-premium .about-v12-facts { padding: 0 24px; }
  .about-stat { padding: 22px 18px; }
  .about-directions__intro { grid-template-columns: 1fr; gap: 16px; }
  .about-directions__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .about-directions__list li:nth-child(-n + 4) { border-bottom-color: color-mix(in srgb, var(--line) 72%, transparent); }
  .about-directions__list li:nth-child(-n + 2) { border-bottom-color: transparent; }
  .about-directions__list li:not(:nth-child(4n)) { border-right: 0; }
  .about-directions__list li:not(:nth-child(2n)) { border-right: 1px solid color-mix(in srgb, var(--line) 72%, transparent); }
}

@media (max-width: 640px) {
  .about-premium .about-v12-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); padding: 0; }
