---
<style is:global>
  /* Header: no underline hover. Mega-menu items use a soft highlight instead. */
  .sg-header .nav__links a::after,
  .sg-header nav a:not(.button)::after,
  .sg-header [role="navigation"] a:not(.button)::after{display:none!important;content:none!important}

  .sg-header .nav-link{transition:color .16s ease,background-color .16s ease}
  .sg-header .nav-link:hover,.sg-header .nav-link:focus-visible{color:#7fd7bd}

  .sg-header .catalog-mega__group>a,
  .sg-header .catalog-mega__architecture-list>a,
  .sg-header .catalog-mega__cities>a{border-radius:6px;transition:color .16s ease,background-color .16s ease}
  .sg-header .catalog-mega__group>a:hover,
  .sg-header .catalog-mega__group>a:focus-visible,
  .sg-header .catalog-mega__architecture-list>a:hover,
  .sg-header .catalog-mega__architecture-list>a:focus-visible,
  .sg-header .catalog-mega__cities>a:hover,
  .sg-header .catalog-mega__cities>a:focus-visible{color:#7fd7bd!important;background:rgba(127,215,189,.08)}

  /* Requested desktop action order: search → compare → wishlist → cart → phone → language. */
  .sg-nav-actions>a[aria-label="Пошук"]{order:1}
  .sg-nav-actions>.nav-icon--compare{order:2}
  .sg-nav-actions>.sg-wishlist-header{order:3}
  .sg-nav-actions>.nav-icon--cart{order:4}
  .sg-nav-actions>a[aria-label="Зателефонувати"]{order:5}
  .sg-nav-actions>.language-switcher{order:6}
  .sg-nav-actions>.sg-header-cta{order:7}

  /* Keep all category pictograms in the same fine-line Space Glass language. */
  .sg-home-category-grid .sg-category-card__icon{width:46px!important;height:46px!important;color:#1f6a58!important;margin-bottom:24px!important}
  .sg-home-category-grid .sg-category-card__icon svg{width:46px!important;height:46px!important;display:block;fill:none!important;stroke:currentColor!important;stroke-width:1.45!important;stroke-linecap:round!important;stroke-linejoin:round!important}
</style>

<script is:inline>
(() => {
  const header = document.querySelector('.sg-header');
  if (!header) return;

  /* Make every visible header item go to a real page instead of a dead or mismatched route. */
  const topRouteByText = new Map([
    ['Каталог','/catalog/'],
    ['Послуги','/uk/poslugy/'],
    ['Готові рішення','/uk/rishennya/'],
    ['Проєкти','/projects/'],
    ['Проекти','/projects/'],
    ['База знань','/knowledge/'],
    ['Про нас','/about/'],
    ['Контакти','/contacts/']
  ]);

  header.querySelectorAll('.sg-nav-links > a.nav-link, .mega-trigger--catalog > a.nav-link').forEach((link) => {
    const label = (link.textContent || '').replace('⌄','').trim();
    const route = topRouteByText.get(label);
    if (route) link.setAttribute('href', route);
  });

  const groupRoutes = {
    showers:'/dushovi-kabiny/',
    mirrors:'/dzerkala/',
    doors:'/sklyani-dveri/',
    railings:'/sklyani-ohorozhi/',
    partitions:'/sklyani-perehorodky/',
    facades:'/arkhitekturni-systemy/',
    aluminium:'/alyuminiievi-konstruktsii/',
    pvc:'/catalog/',
    frameless:'/arkhitekturni-systemy/',
    loft:'/sklyani-perehorodky/',
    hardware:'/catalog/',
    profiles:'/arkhitekturni-systemy/',
    glass:'/knowledge/'
  };

  header.querySelectorAll('[data-menu-key]').forEach((node) => {
    const route = groupRoutes[node.dataset.menuKey];
    if (!route) return;
    if (node.matches('a')) node.setAttribute('href', route);
    node.querySelectorAll?.('a').forEach((link) => link.setAttribute('href', route));
  });

  header.querySelectorAll('a[href="#"]').forEach((link) => link.setAttribute('href','/contacts/'));

  /* Add stable hooks and enforce requested action order even if the markup changes later. */
  const actions = header.querySelector('.sg-nav-actions');
  if (actions) {
    const search = actions.querySelector('a[aria-label="Пошук"]');
    const compare = actions.querySelector('.nav-icon--compare');
    const wishlist = actions.querySelector('.sg-wishlist-header');
    const cart = actions.querySelector('.nav-icon--cart');
    const phone = actions.querySelector('a[aria-label="Зателефонувати"]');
    const language = actions.querySelector('.language-switcher');
    const quote = actions.querySelector('.sg-header-cta');
    [search,compare,wishlist,cart,phone,language,quote].forEach((item) => item && actions.appendChild(item));
  }

  /* Replace all nine homepage category pictograms with consistent custom SVGs. */
  const icons = {
    'Душові кабіни':'<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M12 41V17c0-7 5-11 12-11h8v35"/><path d="M21 13h11M25 18v5m-6-2 2 4m10-4-2 4"/></svg>',
    'Скляні перегородки':'<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M7 8h34v32H7zM18 8v32M30 8v32"/><path d="M7 25h34"/></svg>',
    'Скляні двері':'<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M9 42V6h30v36M15 42V11h18v31"/><circle cx="29" cy="26" r="1"/></svg>',
    'Скляні огорожі':'<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M7 39h11V29h10V19h13"/><path d="M9 33 39 9M15 31V22m10 1v-9m9 1V7"/></svg>',
    'Дзеркала':'<svg viewBox="0 0 48 48" aria-hidden="true"><ellipse cx="24" cy="24" rx="14" ry="18"/><ellipse cx="24" cy="24" rx="10" ry="14"/><path d="m18 23 7-9m-5 16 9-12"/></svg>',
    'Скляні фасади':'<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M6 41V9h36v32M18 9v32M30 9v32M6 24h36"/><path d="M10 5h28"/></svg>',
    'Алюмінієві конструкції':'<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M6 40V8h36v32H6zM24 8v32M6 24h36"/><path d="M27 14h9v8h-9zM12 28h9v7h-9z"/></svg>',
    'Металопластикові конструкції':'<svg viewBox="0 0 48 48" aria-hidden="true"><rect x="7" y="8" width="34" height="32" rx="1"/><path d="M24 8v32M7 24h34"/><path d="m29 15 6 5-6 5"/></svg>',
    'Безрамне скління':'<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M7 40 13 8h22l6 32"/><path d="M13 8v32m11-32v32m11-32v32"/><path d="M7 40h34"/></svg>'
  };

  const patchCategoryIcons = () => {
    document.querySelectorAll('.sg-home-category-grid .sg-category-card').forEach((card) => {
      const title = card.querySelector('h2')?.textContent?.trim();
      const icon = card.querySelector('.sg-category-card__icon');
      if (title && icon && icons[title]) icon.innerHTML = icons[title];
    });
  };
  patchCategoryIcons();
  requestAnimationFrame(patchCategoryIcons);
})();
</script>
