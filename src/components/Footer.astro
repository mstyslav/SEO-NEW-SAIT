---
import { localeFromPath, localizedPath, normalizeLocale } from '../i18n/helpers';

const locale = normalizeLocale(Astro.props.locale ?? Astro.url.searchParams.get('lang') ?? localeFromPath(Astro.url.pathname));
const isRu = locale === 'ru';
const russianRoutes = new Set(['/', '/about/', '/catalog/', '/contacts/', '/projects/', '/services/']);
const lp = (path: string) => localizedPath(path, locale);
const fp = (path: string) => {
  if (path.startsWith('#')) return path;
  if (locale === 'ru' && !russianRoutes.has(path.split('#')[0])) return '/ru/';
  return lp(path);
};

const solutions = [
  [isRu ? 'Стеклянные перегородки' : 'Скляні перегородки','/sklyani-perehorodky/'],
  [isRu ? 'Душевые кабины' : 'Душові кабіни','/dushovi-kabiny/'],
  [isRu ? 'Стеклянные двери' : 'Скляні двері','/sklyani-dveri/'],
  [isRu ? 'Стеклянные ограждения' : 'Скляні огорожі','/sklyani-ohorozhi/'],
  [isRu ? 'Зеркала и стекло' : 'Дзеркала та скло','/dzerkala/'],
  [isRu ? 'Стеклянные фасады' : 'Скляні фасади','/arkhitekturni-systemy/'],
  [isRu ? 'Стеклянные полы' : 'Підлоги зі скла','/catalog/'],
  [isRu ? 'Фурнитура и аксессуары' : 'Фурнітура та аксесуари','/catalog/']
];

const products = [
  [isRu ? 'Душевые кабины' : 'Душові кабіни','/dushovi-kabiny/'],
  [isRu ? 'Стеклянные перегородки' : 'Скляні перегородки','/sklyani-perehorodky/'],
  [isRu ? 'Стеклянные двери' : 'Скляні двері','/sklyani-dveri/'],
  [isRu ? 'Стеклянные ограждения' : 'Скляні огорожі','/sklyani-ohorozhi/'],
  [isRu ? 'Зеркала и стекло' : 'Дзеркала та скло','/dzerkala/'],
  [isRu ? 'Стеклянные полы' : 'Підлоги зі скла','/catalog/'],
  [isRu ? 'Фурнитура и аксессуары' : 'Фурнітура та аксесуари','/catalog/'],
  [isRu ? 'Комплектующие' : 'Комплектуючі','/catalog/']
];

const services = [
  [isRu ? 'Изготовление' : 'Виготовлення','/services/vyhotovlennya/'],
  [isRu ? 'Доставка' : 'Доставка','/services/dostavka/'],
  [isRu ? 'Монтаж' : 'Монтаж','/services/montazh/'],
  [isRu ? 'Замер и проектирование' : 'Замір та проєктування','/services/proektuvannya/'],
  [isRu ? 'Гарантия и сервис' : 'Гарантія та сервіс','/services/servis/'],
  [isRu ? 'Послегарантийное обслуживание' : 'Післягарантійне обслуговування','/services/servis/']
];

const company = [
  [isRu ? 'О нас' : 'Про нас','/about/'],
  [isRu ? 'Наше производство' : 'Наше виробництво','/about/'],
  [isRu ? 'Материалы' : 'Матеріали','/knowledge/'],
  [isRu ? 'Технологии' : 'Технології','/knowledge/'],
  [isRu ? 'Вакансии' : 'Вакансії','/about/#career'],
  [isRu ? 'Партнёры' : 'Партнери','/about/'],
  [isRu ? 'Отзывы' : 'Відгуки','/projects/'],
  [isRu ? 'Контакты' : 'Контакти','/contacts/']
];

const cities = [
  [isRu ? 'Стеклянные конструкции Киев' : 'Скляні конструкції Київ','/city/kyiv/'],
  [isRu ? 'Стеклянные конструкции Львов' : 'Скляні конструкції Львів','/city/lviv/'],
  [isRu ? 'Стеклянные конструкции Одесса' : 'Скляні конструкції Одеса','/city/odesa/'],
  [isRu ? 'Стеклянные конструкции Днепр' : 'Скляні конструкції Дніпро','#'],
  [isRu ? 'Стеклянные конструкции Харьков' : 'Скляні конструкції Харків','#'],
  [isRu ? 'Стеклянные конструкции Ивано-Франковск' : 'Скляні конструкції Івано-Франківськ','#'],
  [isRu ? 'Стеклянные конструкции Винница' : 'Скляні конструкції Вінниця','#'],
  [isRu ? 'Все города' : 'Всі міста','/catalog/']
];

const productStrip = [
  [isRu ? 'Душевые кабины' : 'Душові кабіни','/dushovi-kabiny/','shower'],
  [isRu ? 'Стеклянные перегородки' : 'Скляні перегородки','/sklyani-perehorodky/','partition'],
  [isRu ? 'Стеклянные двери' : 'Скляні двері','/sklyani-dveri/','door'],
  [isRu ? 'Стеклянные ограждения' : 'Скляні огорожі','/sklyani-ohorozhi/','railing'],
  [isRu ? 'Зеркала и стекло' : 'Дзеркала та скло','/dzerkala/','mirror'],
  [isRu ? 'Стеклянные полы' : 'Скляні підлоги','/catalog/','floor'],
  [isRu ? 'Стеклянные фасады' : 'Скляні фасади','/arkhitekturni-systemy/','facade'],
  [isRu ? 'Фурнитура и аксессуары' : 'Фурнітура та аксесуари','/catalog/','hardware']
];
---
<footer class="site-footer footer-refined">
  <div class="footer-refined__benefits">
    <div class="footer-refined__benefit">
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <path d="M24 4 39 10v12c0 9.5-6.2 17.5-15 22-8.8-4.5-15-12.5-15-22V10l15-6Z"/>
        <path d="m17 23 5 5 10-11"/>
      </svg>
      <div><b>{isRu ? 'Собственное производство' : 'Власне виробництво'}</b><small>{isRu ? 'Полный контроль качества' : 'Повний контроль якості'}</small></div>
    </div>

    <div class="footer-refined__benefit">
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <circle cx="24" cy="18" r="10"/>
        <path d="m18 30-3 14 9-5 9 5-3-14"/>
        <path d="m19 18 3 3 7-7"/>
      </svg>
      <div><b>{isRu ? 'Гарантия 2 года' : 'Гарантія 2 роки'}</b><small>{isRu ? 'На все конструкции' : 'На всі конструкції'}</small></div>
    </div>

    <div class="footer-refined__benefit">
      <svg viewBox="0 0 56 48" aria-hidden="true">
        <path d="M3 12h30v22H3z"/>
        <path d="M33 20h11l8 9v5H33z"/>
        <circle cx="14" cy="38" r="4"/>
        <circle cx="43" cy="38" r="4"/>
      </svg>
      <div><b>{isRu ? 'Доставка по Украине и Европе' : 'Доставка по Україні та Європі'}</b><small>{isRu ? 'Быстро и надёжно' : 'Швидко та надійно'}</small></div>
    </div>

    <div class="footer-refined__benefit">
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <circle cx="24" cy="14" r="8"/>
        <path d="M11 42c1-10 7-16 13-16s12 6 13 16"/>
      </svg>
      <div><b>{isRu ? 'Индивидуальные решения' : 'Індивідуальні рішення'}</b><small>{isRu ? 'Под ваш проект' : 'Під ваш проєкт'}</small></div>
    </div>

    <a class="footer-refined__quote" href={fp("/contacts/")}>
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <path d="m5 24 37-17-12 34-8-13-17-4Z"/>
        <path d="m22 28 20-21"/>
      </svg>
      <div><b>{isRu ? 'Получить расчёт' : 'Отримати розрахунок'}</b><small>{isRu ? 'Отправьте проект или фото' : 'Надішліть проєкт або фото'}</small></div>
    </a>
  </div>

  <div class="footer-refined__main">
    <div class="footer-refined__brand">
      <a href={fp("/")} class="footer-refined__logo">
        <img src="/images/space-glass-brand-logo.jpg" width="220" height="178" alt="Space Glass" />
      </a>
      <p>{isRu ? 'Стеклянные конструкции премиум-класса для дома, бизнеса и архитектурных проектов.' : 'Скляні конструкції преміум-класу для дому, бізнесу та архітектурних проєктів.'}</p>
      <div class="footer-refined__socials">

<a href="https://www.instagram.com/spaceglass_od/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="5"></rect>
    <circle cx="12" cy="12" r="4"></circle>
    <circle cx="17.5" cy="6.5" r="1"></circle>
  </svg>
</a>
<a href="https://t.me/spaceglass" target="_blank" rel="noopener noreferrer" aria-label="Telegram">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M21 4 3.8 10.6c-.8.3-.8 1.4 0 1.7l4.3 1.4 1.6 5c.2.7 1.1.9 1.6.4l2.4-2.5 4.1 3c.6.4 1.4.1 1.6-.6L22 5.2c.2-.8-.3-1.4-1-1.2Z"></path>
    <path d="m8.1 13.7 9.8-6.2-7.6 8.1"></path>
  </svg>
</a>
<a href="https://www.tiktok.com/@spaceglass_od" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M14 3v10.2a4.4 4.4 0 1 1-3.8-4.4"></path>
    <path d="M14 3c.6 2.6 2.2 4.2 4.8 4.8"></path>
  </svg>
</a>
<a href="https://www.facebook.com/spaceglass.od" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M14 8h3V4.5c-.6-.1-1.8-.2-3.2-.2-3.1 0-5.2 1.9-5.2 5.4V13H5v4h3.6v7H13v-7h3.6l.6-4H13v-3c0-1.2.3-2 1-2Z"></path>
  </svg>
</a>
<a href="https://www.youtube.com/@spaceglass5552" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M21 8.2a3 3 0 0 0-2.1-2.1C17 5.6 12 5.6 12 5.6s-5 0-6.9.5A3 3 0 0 0 3 8.2 31 31 0 0 0 2.6 12 31 31 0 0 0 3 15.8a3 3 0 0 0 2.1 2.1c1.9.5 6.9.5 6.9.5s5 0 6.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .4-3.8 31 31 0 0 0-.4-3.8Z"></path>
    <path d="m10 9 5 3-5 3V9Z"></path>
  </svg>
</a>

      </div>
    </div>

    <div class="footer-refined__col">
      <strong>{isRu ? 'Решения' : 'Рішення'}</strong>
      {solutions.map(([label,href]) => <a href={fp(href)}>{label}</a>)}
    </div>

    <div class="footer-refined__col">
      <strong>{isRu ? 'Товары' : 'Товари'}</strong>
      {products.map(([label,href]) => <a href={fp(href)}>{label}</a>)}
    </div>

    <div class="footer-refined__col">
      <strong>{isRu ? 'Услуги' : 'Послуги'}</strong>
      {services.map(([label,href]) => <a href={fp(href)}>{label}</a>)}
    </div>

    <div class="footer-refined__col">
      <strong>{isRu ? 'Компания' : 'Компанія'}</strong>
      {company.map(([label,href]) => <a href={fp(href)}>{label}</a>)}
    </div>

    <div class="footer-refined__col">
      <strong>{isRu ? 'Города' : 'Міста'}</strong>
      {cities.map(([label,href]) => <a href={fp(href)}>{label}</a>)}
    </div>

    <div class="footer-refined__contacts">
      <strong>{isRu ? 'Контакты' : 'Контакти'}</strong>
      <a href="tel:+380734251400">☎ <span>+38 (073) 425 14 00</span></a>
      <a href="mailto:info@space-glass.com.ua">✉ <span>info@space-glass.com.ua</span></a>
      <span>⌖ <b>{isRu ? 'Киев · Львов · Одесса' : 'Київ · Львів · Одеса'}</b></span>
      <span>◷ <b>{isRu ? 'Пн–Пт: 09:00–19:00' : 'Пн–Пт: 09:00–19:00'}</b></span>
      <a class="footer-refined__call" href={fp("/contacts/")}>☎ <span>{isRu ? 'Заказать звонок' : 'Замовити дзвінок'}</span></a>
    </div>
  </div>

  <div class="footer-refined__products">
    <h3>{isRu ? 'Наша продукция' : 'Наша продукція'}</h3>
    <div class="footer-refined__product-grid">
      {productStrip.map(([label,href,type]) => (
        <a href={fp(href)}>
          <span class={`footer-refined__icon footer-refined__icon--${type}`}>
            {type === 'shower' && <svg viewBox="0 0 72 72"><path d="M16 10h40v52H16z"/><path d="M22 16h28v40H22z"/><path d="M36 16v40"/><path d="M36 22h9"/><circle cx="46" cy="23" r="1.8"/></svg>}
            {type === 'partition' && <svg viewBox="0 0 72 72"><path d="M12 12h48v48H12z"/><path d="M28 12v48M44 12v48M12 28h48M12 44h48"/></svg>}
            {type === 'door' && <svg viewBox="0 0 72 72"><path d="M18 12h36v48H18z"/><path d="M36 12v48"/><circle cx="31" cy="36" r="1.8"/><circle cx="41" cy="36" r="1.8"/></svg>}
            {type === 'railing' && <svg viewBox="0 0 72 72"><path d="M12 58h48"/><path d="M18 58V40l10-8v26"/><path d="M28 32l10-8v34"/><path d="M38 24l10-8v42"/><path d="M16 37 48 12"/></svg>}
            {type === 'mirror' && <svg viewBox="0 0 72 72"><path d="M36 9 57 36 36 63 15 36 36 9Z"/><path d="M36 9v54"/></svg>}
            {type === 'floor' && <svg viewBox="0 0 72 72"><path d="m36 12 22 12-22 12-22-12 22-12Z"/><path d="m14 34 22 12 22-12"/><path d="m14 44 22 12 22-12"/></svg>}
            {type === 'facade' && <svg viewBox="0 0 72 72"><path d="M12 58V18l14-6v46"/><path d="M26 58V10l20 8v40"/><path d="M46 58V24l14 5v29"/><path d="M12 58h48"/><path d="M18 22v5M18 33v5M18 44v5M34 20v5M34 32v5M34 44v5M52 32v5M52 44v5"/></svg>}
            {type === 'hardware' && <svg viewBox="0 0 72 72"><path d="M19 14h12v44H19zM41 14h12v44H41z"/><circle cx="25" cy="26" r="3"/><circle cx="47" cy="26" r="3"/><path d="M25 36h22"/><path d="M25 36v11M47 36v11"/></svg>}
          </span>
          <b>{label}</b>
        </a>
      ))}
    </div>
  </div>

  <div class="footer-refined__bottom">
    <span>© 2026 Space Glass. {isRu ? 'Все права защищены.' : 'Усі права захищені.'}</span>
    <div>
      <a href={fp("/privacy-policy/")}>{isRu ? 'Политика конфиденциальности' : 'Політика конфіденційності'}</a>
      <a href={fp("/terms/")}>{isRu ? 'Условия использования' : 'Умови використання'}</a>
      <a href={fp("/cookies-policy/")}>Cookies</a>
      <a href={isRu ? '/ru/' : '/sitemap.xml'}>{isRu ? 'Карта сайта' : 'Карта сайту'}</a>
    </div>
    <span>{isRu ? 'Разработка сайта — Space Glass' : 'Розробка сайту — Space Glass'}</span>
  </div>
</footer>
