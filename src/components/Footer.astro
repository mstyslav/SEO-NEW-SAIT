  ['Всі міста','/catalog/']
];

const productStrip = [
  ['Душові кабіни','/dushovi-kabiny/','shower'],
  ['Скляні перегородки','/sklyani-perehorodky/','partition'],
  ['Скляні двері','/sklyani-dveri/','door'],
  ['Скляні огорожі','/sklyani-ohorozhi/','railing'],
  ['Дзеркала та скло','/dzerkala/','mirror'],
  ['Скляні підлоги','/catalog/','floor'],
  ['Скляні фасади','/arkhitekturni-systemy/','facade'],
  ['Фурнітура та аксесуари','/catalog/','hardware']
];

import { localeFromPath, localizedPath, normalizeLocale } from '../i18n/helpers';

const locale = normalizeLocale(Astro.props.locale ?? Astro.url.searchParams.get('lang') ?? localeFromPath(Astro.url.pathname));
const localizedRoutes = new Set(['/', '/about/', '/cart/', '/catalog/', '/catalog/piddon/', '/compare/', '/contacts/', '/oplata-dostavka/', '/projects/', '/quote/', '/services/']);
const russianRoutes = new Set(['/', '/about/', '/catalog/', '/contacts/', '/knowledge/', '/oplata-dostavka/', '/projects/', '/services/']);
const routeKey = (path: string) => path.split(/[?#]/, 1)[0] || '/';
const lp = (path: string) => locale === 'uk' || (locale === 'ru' ? russianRoutes : localizedRoutes).has(routeKey(path))
  ? localizedPath(path, locale)
  : localizedPath('/', locale);

const copy = {
  uk: { production:'Власне виробництво', quality:'Повний контроль якості', warranty:'Гарантія 2 роки', all:'На всі конструкції', delivery:'Доставка по Україні та Європі', fast:'Швидко та надійно', custom:'Індивідуальні рішення', project:'Під ваш проєкт', estimate:'Отримати розрахунок', send:'Надішліть проєкт або фото', intro:'Скляні конструкції преміум-класу для дому, бізнесу та архітектурних проєктів.', solutions:'Рішення', products:'Товари', services:'Послуги', company:'Компанія', cities:'Міста', contacts:'Контакти', call:'Замовити дзвінок', locations:'Київ · Львів · Одеса', hours:'Пн–Пт: 09:00–19:00', ourProducts:'Наша продукція', rights:'Усі права захищені.', privacy:'Політика конфіденційності', terms:'Умови використання', cookies:'Cookies', sitemap:'Карта сайту', development:'Розробка сайту — Space Glass' },
  ru: { production:'Собственное производство', quality:'Полный контроль качества', warranty:'Гарантия 2 года', all:'На все конструкции', delivery:'Доставка по Украине и Европе', fast:'Быстро и надёжно', custom:'Индивидуальные решения', project:'Под ваш проект', estimate:'Получить расчёт', send:'Отправьте проект или фото', intro:'Стеклянные конструкции премиум-класса для дома, бизнеса и архитектурных проектов.', solutions:'Решения', products:'Товары', services:'Услуги', company:'Компания', cities:'Города', contacts:'Контакты', call:'Заказать звонок', locations:'Киев · Львов · Одесса', hours:'Пн–Пт: 09:00–19:00', ourProducts:'Наша продукция', rights:'Все права защищены.', privacy:'Политика конфиденциальности', terms:'Условия использования', cookies:'Cookies', sitemap:'Карта сайта', development:'Разработка сайта — Space Glass' },
  en: { production:'In-house production', quality:'Complete quality control', warranty:'2-year warranty', all:'On all structures', delivery:'Delivery across Ukraine and Europe', fast:'Fast and reliable', custom:'Custom solutions', project:'Tailored to your project', estimate:'Get an estimate', send:'Send a project or photo', intro:'Premium glass structures for homes, businesses and architectural projects.', solutions:'Solutions', products:'Products', services:'Services', company:'Company', cities:'Cities', contacts:'Contacts', call:'Request a call', locations:'Kyiv · Lviv · Odesa', hours:'Mon–Fri: 09:00–19:00', ourProducts:'Our products', rights:'All rights reserved.', privacy:'Privacy policy', terms:'Terms of use', cookies:'Cookies', sitemap:'Sitemap', development:'Website by Space Glass' },
  de: { production:'Eigene Produktion', quality:'Vollständige Qualitätskontrolle', warranty:'2 Jahre Garantie', all:'Auf alle Konstruktionen', delivery:'Lieferung in der Ukraine und Europa', fast:'Schnell und zuverlässig', custom:'Individuelle Lösungen', project:'Für Ihr Projekt', estimate:'Angebot erhalten', send:'Projekt oder Foto senden', intro:'Premium-Glaskonstruktionen für Zuhause, Unternehmen und Architekturprojekte.', solutions:'Lösungen', products:'Produkte', services:'Leistungen', company:'Unternehmen', cities:'Städte', contacts:'Kontakt', call:'Rückruf anfordern', locations:'Kyjiw · Lwiw · Odesa', hours:'Mo–Fr: 09:00–19:00', ourProducts:'Unsere Produkte', rights:'Alle Rechte vorbehalten.', privacy:'Datenschutzerklärung', terms:'Nutzungsbedingungen', cookies:'Cookies', sitemap:'Sitemap', development:'Website von Space Glass' }
}[locale];
const linkNames = {
  ru: { catalog:'Каталог', partitions:'Стеклянные перегородки', showers:'Душевые кабины', doors:'Стеклянные двери', railings:'Стеклянные ограждения', mirrors:'Зеркала и стекло', facades:'Стеклянные фасады', service:'Услуги', about:'О компании', knowledge:'Материалы и технологии', projects:'Проекты', contacts:'Контакты', city:'Стеклянные конструкции' },
  en: { catalog:'Catalog', partitions:'Glass partitions', showers:'Shower enclosures', doors:'Glass doors', railings:'Glass railings', mirrors:'Mirrors and glass', facades:'Glass façades', service:'Services', about:'About us', knowledge:'Materials and technology', projects:'Projects', contacts:'Contacts', city:'Glass structures' },
  de: { catalog:'Katalog', partitions:'Glastrennwände', showers:'Duschkabinen', doors:'Glastüren', railings:'Glasgeländer', mirrors:'Spiegel und Glas', facades:'Glasfassaden', service:'Leistungen', about:'Über uns', knowledge:'Materialien und Technik', projects:'Projekte', contacts:'Kontakt', city:'Glaskonstruktionen' }
} as const;
const russianFooterLabels: Record<string, string> = {
  'Скляні перегородки': 'Стеклянные перегородки',
  'Душові кабіни': 'Душевые кабины',
  'Скляні двері': 'Стеклянные двери',
  'Скляні огорожі': 'Стеклянные ограждения',
  'Дзеркала та скло': 'Зеркала и стекло',
  'Скляні фасади': 'Стеклянные фасады',
  'Підлоги зі скла': 'Стеклянные полы',
  'Скляні підлоги': 'Стеклянные полы',
  'Фурнітура та аксесуари': 'Фурнитура и аксессуары',
  'Комплектуючі': 'Комплектующие',
  'Виготовлення': 'Изготовление',
  'Доставка': 'Доставка',
  'Монтаж': 'Монтаж',
  'Замір та проєктування': 'Замер и проектирование',
  'Гарантія та сервіс': 'Гарантия и сервис',
  'Післягарантійне обслуговування': 'Послегарантийное обслуживание',
  'Про нас': 'О компании',
  'Наше виробництво': 'Наше производство',
  'Матеріали': 'Материалы',
  'Технології': 'Технологии',
  'Вакансії': 'Вакансии',
  'Партнери': 'Партнёры',
  'Відгуки': 'Отзывы',
  'Контакти': 'Контакты',
  'Скляні конструкції Київ': 'Стеклянные конструкции — Киев',
  'Скляні конструкції Львів': 'Стеклянные конструкции — Львов',
  'Скляні конструкції Одеса': 'Стеклянные конструкции — Одесса',
  'Скляні конструкції Дніпро': 'Стеклянные конструкции — Днепр',
  'Скляні конструкції Харків': 'Стеклянные конструкции — Харьков',
  'Скляні конструкції Івано-Франківськ': 'Стеклянные конструкции — Ивано-Франковск',
  'Скляні конструкції Вінниця': 'Стеклянные конструкции — Винница',
  'Всі міста': 'Все города'
};
const footerLabel = (label: string, href: string) => {
  if (locale === 'uk') return label;
  if (locale === 'ru') return russianFooterLabels[label] ?? label;
  const names = linkNames[locale];
  if (href.startsWith('/sklyani-perehorodky')) return names.partitions;
  if (href.startsWith('/dushovi-kabiny')) return names.showers;
  if (href.startsWith('/sklyani-dveri')) return names.doors;
  if (href.startsWith('/sklyani-ohorozhi')) return names.railings;
  if (href.startsWith('/dzerkala')) return names.mirrors;
  if (href.startsWith('/arkhitekturni-systemy')) return names.facades;
  if (href.startsWith('/services')) return names.service;
  if (href.startsWith('/about')) return names.about;
  if (href.startsWith('/knowledge')) return names.knowledge;
  if (href.startsWith('/projects')) return names.projects;
  if (href.startsWith('/contacts')) return names.contacts;
  if (href.startsWith('/city/')) return `${names.city} — ${label.split(' ').at(-1)}`;
  return names.catalog;
};
