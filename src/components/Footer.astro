];

import { localeFromPath, localizedPath, normalizeLocale } from '../i18n/helpers';

const locale = normalizeLocale(Astro.props.locale ?? Astro.url.searchParams.get('lang') ?? localeFromPath(Astro.url.pathname));
const russianRoutes = new Set(['/','/about/','/catalog/','/catalog/piddon/','/contacts/','/projects/','/services/','/oplata-dostavka/','/sklyani-perehorodky/ofisni/']);
const link = (path: string) => {
  if (path === '#' || /^(?:https?:|tel:|mailto:)/.test(path)) return path;
  const [pathname, hash = ''] = path.split('#');
  if (locale === 'ru' && !russianRoutes.has(pathname)) return '/ru/';
  return `${localizedPath(pathname, locale)}${hash ? `#${hash}` : ''}`;
};
const ru: Record<string,string> = {
  'Скляні перегородки':'Стеклянные перегородки','Душові кабіни':'Душевые кабины','Скляні двері':'Стеклянные двери','Скляні огорожі':'Стеклянные ограждения','Дзеркала та скло':'Зеркала и стекло','Скляні фасади':'Стеклянные фасады','Підлоги зі скла':'Стеклянные полы','Фурнітура та аксесуари':'Фурнитура и аксессуары','Комплектуючі':'Комплектующие','Скляні підлоги':'Стеклянные полы',
  'Виготовлення':'Изготовление','Доставка':'Доставка','Монтаж':'Монтаж','Замір та проєктування':'Замер и проектирование','Гарантія та сервіс':'Гарантия и сервис','Післягарантійне обслуговування':'Послегарантийное обслуживание',
  'Про нас':'О нас','Наше виробництво':'Наше производство','Матеріали':'Материалы','Технології':'Технологии','Вакансії':'Вакансии','Партнери':'Партнёры','Відгуки':'Отзывы','Контакти':'Контакты',
  'Скляні конструкції Київ':'Стеклянные конструкции Киев','Скляні конструкції Львів':'Стеклянные конструкции Львов','Скляні конструкції Одеса':'Стеклянные конструкции Одесса','Скляні конструкції Дніпро':'Стеклянные конструкции Днепр','Скляні конструкції Харків':'Стеклянные конструкции Харьков','Скляні конструкції Івано-Франківськ':'Стеклянные конструкции Ивано-Франковск','Скляні конструкції Вінниця':'Стеклянные конструкции Винница','Всі міста':'Все города',
};
const tr = (value: string) => locale === 'ru' ? (ru[value] ?? value) : value;
const localized = (items: string[][]) => items.map(([label, href, type]) => [tr(label), link(href), type]);
const solutions = localized(solutionsRaw), products = localized(productsRaw), services = localized(servicesRaw), company = localized(companyRaw), cities = localized(citiesRaw), productStrip = localized(productStripRaw);
const ui = locale === 'ru' ? {
  production:'Собственное производство', quality:'Полный контроль качества', warranty:'Гарантия 2 года', all:'На все конструкции', delivery:'Доставка по Украине и Европе', fast:'Быстро и надёжно', individual:'Индивидуальные решения', project:'Под ваш проект', quote:'Получить расчёт', send:'Отправьте проект или фото', description:'Стеклянные конструкции премиум-класса для дома, бизнеса и архитектурных проектов.', solutions:'Решения', products:'Товары', services:'Услуги', company:'Компания', cities:'Города', contacts:'Контакты', locations:'Киев · Львов · Одесса', hours:'Пн–Пт: 09:00–19:00', call:'Заказать звонок', ourProducts:'Наша продукция', rights:'Все права защищены.', privacy:'Политика конфиденциальности', terms:'Условия использования', sitemap:'Карта сайта', development:'Разработка сайта — Space Glass'
} : {
  production:'Власне виробництво', quality:'Повний контроль якості', warranty:'Гарантія 2 роки', all:'На всі конструкції', delivery:'Доставка по Україні та Європі', fast:'Швидко та надійно', individual:'Індивідуальні рішення', project:'Під ваш проєкт', quote:'Отримати розрахунок', send:'Надішліть проєкт або фото', description:'Скляні конструкції преміум-класу для дому, бізнесу та архітектурних проєктів.', solutions:'Рішення', products:'Товари', services:'Послуги', company:'Компанія', cities:'Міста', contacts:'Контакти', locations:'Київ · Львів · Одеса', hours:'Пн–Пт: 09:00–19:00', call:'Замовити дзвінок', ourProducts:'Наша продукція', rights:'Усі права захищені.', privacy:'Політика конфіденційності', terms:'Умови використання', sitemap:'Карта сайту', development:'Розробка сайту — Space Glass'
};
