---
// Single shared template for every /X-configurator/ page in both locales.
// The 6 uk pages (src/pages/*-configurator.astro) and their /ru/ counterparts
// are thin wrappers that just pass `config`, `productKey` and `locale` here —
// see src/pages/bezramne-configurator.astro for the pattern to copy when
// adding a new configurator page.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DynamicConfigurator from './DynamicConfigurator.astro';
import tariffs from '../../pricing/tariffs.json';
import labelsAll from '../../i18n/configurator-labels.json';
import uiAll from '../../i18n/configurator-ui.json';
// <title> / meta description only (H1 and on-page text keep the shared labels): each calculator
// targets "калькулятор / ціна онлайн", the product hubs keep "на замовлення".
import seoAll from '../../i18n/configurator-seo.json';
import type { Locale } from '../../i18n/helpers';

interface Props {
  locale: Locale;
  config: Record<string, any>;
  productKey: string;
}

const { locale, config, productKey } = Astro.props;
const labels = labelsAll[locale];
const ui = uiAll[locale];
const title = labels[productKey];
const tariff = tariffs.categories[config.category];
const seo = (seoAll as Record<string, Record<string, { title: string; description: string }>>)[locale]?.[productKey];
// No generic fallback: a calculator without its own SEO entry must fail the build, not ship a shared title/description.
if (!seo) throw new Error(`configurator-seo.json: missing ${locale} entry for productKey "${productKey}"`);
---
<BaseLayout
  title={seo.title}
  description={seo.description}
  locale={locale}
>
  <Header locale={locale} />
  <main id="main">
    <section class="config-demo-hero">
      <div class="container">
        <p class="eyebrow">Space Glass Configurator</p>
        <h1>{title}</h1>
        <p>{ui.configureText}</p>
      </div>
    </section>
    <section class="section config-body">
      <div class="container">
        <DynamicConfigurator
          config={config}
          tariff={tariff}
          currency={tariffs.currency}
          productName={title}
          locale={locale}
        />
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</BaseLayout>
<style>
  /* body is the dark #202020 page frame; the configurator's cards, headings and hints are
     designed for a light surface, so the section needs its own white background. */
  .config-body{background:#fff}
  /* global.css forces .eyebrow to dark green (!important) — unreadable on the dark hero. */
  .config-demo-hero .eyebrow{color:#97d9b4!important}
</style>
