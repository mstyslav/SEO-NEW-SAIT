---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
const {
  title,
  description,
  updated = '30 серпня 2026',
  locale = 'uk'
} = Astro.props;

const legalLabel =
  locale === 'ru'
    ? 'Юридическая информация'
    : 'Юридична інформація';

const updatedLabel =
  locale === 'ru'
    ? 'Последнее обновление'
    : 'Останнє оновлення';
---
<BaseLayout title={`${title} | Space Glass`} description={description}>
  <Header />
  <main id="main" class="legal-page">
    <header class="legal-page__hero">
      <div class="container">
        <p class="eyebrow">{legalLabel}</p>
        <h1>{title}</h1>
        <p>{updatedLabel}: {updated}</p>
      </div>
    </header>
    <article class="container legal-page__content"><slot /></article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .legal-page {
    background: #fff;
    color: #17211d;
    color-scheme: light;
  }
  .legal-page__hero {
    padding: 72px 0 42px;
    background: #f5f8f7;
    border-bottom: 1px solid #dce5e2;
  }
  .legal-page__hero .eyebrow {
    color: #064b32 !important;
  }
  .legal-page__hero h1 {
    margin: 10px 0 16px;
    color: #111814 !important;
    font-size: clamp(2.15rem, 4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
  }
  .legal-page__hero p:not(.eyebrow) {
    color: #4f5a55 !important;
  }
  .legal-page__content {
    max-width: 960px;
    padding-top: 48px;
    padding-bottom: 88px;
    color: #26332d !important;
  }
  .legal-page__content :global(h2) {
    margin: 42px 0 14px;
    color: #111814 !important;
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .legal-page__content :global(p),
  .legal-page__content :global(li) {
    color: #33413a !important;
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .legal-page__content :global(a) {
    color: #087347 !important;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 640px) {
    .legal-page__hero { padding: 48px 0 30px; }
    .legal-page__content { padding-top: 28px; padding-bottom: 60px; }
  }
</style>

<style>
  /* LEGAL PAGE — COMPACT TYPOGRAPHY FINAL */

  .legal-page__hero {
    padding: 52px 0 34px;
  }

  .legal-page__hero h1 {
    font-size: clamp(2rem, 3.2vw, 2.625rem) !important;
    line-height: 1.08 !important;
    letter-spacing: -0.025em !important;
    margin: 8px 0 12px !important;
  }

  .legal-page__content :global(h2) {
    font-size: 1.4375rem !important;
    line-height: 1.28 !important;
    margin: 36px 0 12px !important;
    letter-spacing: -0.015em !important;
  }

  .legal-page__content :global(p),
  .legal-page__content :global(li) {
    font-size: 1rem !important;
    line-height: 1.7 !important;
  }

  @media (max-width: 640px) {
    .legal-page__hero {
      padding: 38px 0 26px !important;
    }

    .legal-page__hero h1 {
      font-size: 2rem !important;
      line-height: 1.08 !important;
      margin: 8px 0 12px !important;
    }

    .legal-page__content {
      padding-top: 28px !important;
      padding-bottom: 56px !important;
    }

    .legal-page__content :global(h2) {
      font-size: 1.375rem !important;
      line-height: 1.25 !important;
      margin: 32px 0 10px !important;
    }

    .legal-page__content :global(p),
    .legal-page__content :global(li) {
      font-size: 1rem !important;
      line-height: 1.68 !important;
    }
  }
</style>
