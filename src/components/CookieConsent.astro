---
<aside class="cookie-consent" data-cookie-consent hidden role="dialog" aria-modal="false" aria-label={t.aria}>
  <div class="cookie-consent__text">
    <strong>{t.title}</strong>
    <p>{t.text} <a href={t.policy}>{t.more}</a> · <button type="button" class="cookie-consent__more" data-cookie-more aria-expanded="false">{t.settings}</button></p>
    <div class="cookie-consent__opts" data-cookie-opts hidden>
      <label class="cookie-consent__opt"><input type="checkbox" data-cc-analytics /><span><b>{t.analyticsTitle}</b> {t.analyticsText}</span></label>
      <label class="cookie-consent__opt"><input type="checkbox" data-cc-ads /><span><b>{t.adsTitle}</b> {t.adsText}</span></label>
    </div>
  </div>
  <div class="cookie-consent__actions">
    <button type="button" class="button button--outline" data-cookie-reject>{t.reject}</button>
    <button type="button" class="button button--outline" data-cookie-save hidden>{t.save}</button>
    <button type="button" class="button button--mint" data-cookie-accept>{t.accept}</button>
  </div>
</aside>
<script is:inline>
  (() => {
    const box = document.querySelector('[data-cookie-consent]');
    if (!box) return;
    const AN = 'sg-cookie-consent', AD = 'sg-ad-consent';
    const read = (k) => { try { return localStorage.getItem(k); } catch { return null; } };
    const write = (k, v) => { try { localStorage.setItem(k, v); } catch {} };
    const cbAn = box.querySelector('[data-cc-analytics]'), cbAd = box.querySelector('[data-cc-ads]');
    // The checkboxes always show the CURRENT decision; nothing is pre-ticked for a visitor who has not decided yet.
    const opts = box.querySelector('[data-cookie-opts]'), moreBtn = box.querySelector('[data-cookie-more]'), saveBtn = box.querySelector('[data-cookie-save]');
    // The compact view (text + «Лише необхідні» / «Прийняти») is what a new visitor sees; «Налаштувати» (and the footer button, for a
    // visitor who already decided) expands the two independent choices with «Зберегти вибір».
    const expand = (on) => {
      if (opts) opts.hidden = !on;
      if (saveBtn) saveBtn.hidden = !on;
      if (moreBtn) moreBtn.setAttribute('aria-expanded', on ? 'true' : 'false');
    };
    const open = (expanded) => {
      if (cbAn) cbAn.checked = read(AN) === 'all';
      if (cbAd) cbAd.checked = read(AD) === 'granted';
      expand(!!expanded);
      box.hidden = false;
    };
    // First visit, or a returning visitor who decided before the advertising choice existed: ask (again).
    const known = (v, a, b) => v === a || v === b;
    if (!known(read(AN), 'all', 'necessary') || !known(read(AD), 'granted', 'denied')) open(false);
    // The two choices are applied independently: analytics is handled as before, advertising never needs analytics.
    const apply = (analytics, ads) => {
      const a = window.sgAnalytics;
      const wasRunning = !!(a && a.wasLoaded());
      write(AN, analytics ? 'all' : 'necessary');
      write(AD, ads ? 'granted' : 'denied');
      // forms.js (lead attribution and advertising click ids) listens to these events and starts or clears its stored data at once.
      try { window.dispatchEvent(new CustomEvent('sg-consent-change', { detail: { choice: analytics ? 'all' : 'necessary' } })); } catch {}
      try { window.dispatchEvent(new CustomEvent('sg-ad-consent-change', { detail: { granted: ads } })); } catch {}
      box.hidden = true;
      if (a && typeof a.setAds === 'function') a.setAds(ads); // Consent Mode v2 update when the Google tag is already running; clears ad cookies on withdrawal
      if (analytics) { if (a) a.load(); return; }
      if (a) { a.disable(); a.clearCookies(); }
      // The running Google tag cannot be unloaded: reload once. The page then starts without it (consent is no longer 'all'),
      // so this cannot loop. Without the tag having run there is nothing to reload.
      if (wasRunning) location.reload();
    };
    document.addEventListener('click', (e) => {
      const opener = e.target instanceof Element ? e.target.closest('[data-cookie-settings]') : null;
      if (!opener) return;
      open(true);      // a visitor who comes back to change or withdraw a decision sees the current choices at once
      box.setAttribute('tabindex', '-1');
      box.focus({ preventScroll: true });
    });
    moreBtn?.addEventListener('click', () => expand(!!opts && opts.hidden));
    box.querySelector('[data-cookie-accept]')?.addEventListener('click', () => apply(true, true));
    box.querySelector('[data-cookie-reject]')?.addEventListener('click', () => apply(false, false));
    box.querySelector('[data-cookie-save]')?.addEventListener('click', () => apply(!!(cbAn && cbAn.checked), !!(cbAd && cbAd.checked)));
  })();
</script>
<style>
  .cookie-consent{position:fixed;left:16px;right:16px;bottom:16px;z-index:4000;max-height:calc(100vh - 32px);overflow:auto;display:flex;align-items:center;justify-content:space-between;gap:18px;max-width:960px;margin:0 auto;padding:16px 18px;border:1px solid #d7e5df;border-radius:16px;background:#fff;color:#16201b;box-shadow:0 18px 50px rgba(0,0,0,.18);font-size:14px;line-height:1.45}
  .cookie-consent[hidden]{display:none}
  .cookie-consent strong{display:block;margin-bottom:2px;font-size:15px}
  .cookie-consent p{margin:0;color:#56625c}
  .cookie-consent a{color:#176b55}
  .cookie-consent__more{display:inline;padding:0;border:0;background:none;color:#176b55;font:inherit;text-decoration:underline;cursor:pointer}
  .cookie-consent__opts{display:grid;gap:8px;margin-top:10px}
  .cookie-consent__opts[hidden],.cookie-consent__actions [hidden]{display:none}
  .cookie-consent__opt{display:flex;gap:10px;align-items:flex-start;color:#2c3a33;cursor:pointer}
  .cookie-consent__opt input{flex:0 0 18px;width:18px;height:18px;margin:2px 0 0;accent-color:#176b55}
  .cookie-consent__opt b{font-weight:600}
  .cookie-consent__actions{display:flex;flex:0 0 auto;flex-wrap:wrap;gap:10px;justify-content:flex-end}
  .cookie-consent__actions .button{min-height:42px;padding:0 16px;white-space:nowrap}
  @media(max-width:700px){.cookie-consent{left:10px;right:10px;bottom:10px;flex-direction:column;align-items:stretch;gap:12px;padding:14px}.cookie-consent__actions .button{flex:1}}
</style>
