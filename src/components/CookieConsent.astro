---
// Cookie banner. GA4 is loaded by BaseLayout only after consent ('all'); the footer button [data-cookie-settings] reopens this banner.
// The choice is stored in localStorage 'sg-cookie-consent' ('all' | 'necessary');

import type { Locale } from '../i18n/helpers';
import { intlHref } from '../i18n/intl-routes';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = {
  uk: {
    aria: 'Налаштування cookies',
    title: 'Ваші налаштування приватності',
    text: 'Ми використовуємо необхідні cookies та, лише за вашою згодою, аналітику для покращення сайту.',
    more: 'Докладніше',
    policy: '/cookies-policy/',
    reject: 'Лише необхідні',
    accept: 'Прийняти'
  },
  ru: {
    aria: 'Настройки cookies',
    title: 'Ваши настройки приватности',
    text: 'Мы используем необходимые cookies и, только с вашего согласия, аналитику для улучшения сайта.',
    more: 'Подробнее',
    policy: '/ru/cookies-policy/',
    reject: 'Только необходимые',
    accept: 'Принять'
  },
  en: {
    aria: 'Cookie settings',
    title: 'Your privacy settings',
    text: 'We use necessary cookies and, only with your consent, analytics to improve the website.',
    more: 'Learn more',
    policy: intlHref('cookies', 'en'),
    reject: 'Necessary only',
    accept: 'Accept'
  },
  de: {
    aria: 'Cookie-Einstellungen',
    title: 'Ihre Datenschutzeinstellungen',
    text: 'Wir verwenden notwendige Cookies und – nur mit Ihrer Einwilligung – Analyse-Tools, um die Website zu verbessern.',
    more: 'Mehr erfahren',
    policy: intlHref('cookies', 'de'),
    reject: 'Nur notwendige',
    accept: 'Akzeptieren'
  },
  es: {
    aria: 'Configuración de cookies',
    title: 'Su configuración de privacidad',
    text: 'Usamos cookies necesarias y, solo con su consentimiento, analítica para mejorar el sitio web.',
    more: 'Más información',
    policy: intlHref('cookies', 'es'),
    reject: 'Solo necesarias',
    accept: 'Aceptar'
  }
}[locale];
---
<aside class="cookie-consent" data-cookie-consent hidden aria-label={t.aria}>
  <div class="cookie-consent__text"><strong>{t.title}</strong><p>{t.text} <a href={t.policy}>{t.more}</a></p></div>
  <div class="cookie-consent__actions"><button type="button" class="button button--outline" data-cookie-reject>{t.reject}</button><button type="button" class="button button--mint" data-cookie-accept>{t.accept}</button></div>
</aside>
<script is:inline>
  (() => {
    const box = document.querySelector('[data-cookie-consent]');
    if (!box) return;
    let saved = null;
    try { saved = localStorage.getItem('sg-cookie-consent'); } catch {}
    if (saved !== 'all' && saved !== 'necessary') box.hidden = false;
    const apply = (choice) => {
      const a = window.sgAnalytics;
      const wasRunning = !!(a && a.wasLoaded());
      try { localStorage.setItem('sg-cookie-consent', choice); } catch {}
      // Tells public/js/forms.js (lead attribution) so it can start or clear the session attribution at once.
      try { window.dispatchEvent(new CustomEvent('sg-consent-change', { detail: { choice } })); } catch {}
      box.hidden = true;
      if (choice === 'all') { if (a) a.load(); return; }
      if (a) { a.disable(); a.clearCookies(); }
      // The running Google tag cannot be unloaded: reload once. The page then starts without it (consent is no longer 'all'),
      // so this cannot loop. Without the tag having run there is nothing to reload.
      if (wasRunning) location.reload();
    };
    document.addEventListener('click', (e) => {
      const opener = e.target instanceof Element ? e.target.closest('[data-cookie-settings]') : null;
      if (!opener) return;
      box.hidden = false;
      box.setAttribute('tabindex', '-1');
      box.focus({ preventScroll: true });
    });
    box.querySelector('[data-cookie-accept]')?.addEventListener('click', () => apply('all'));
    box.querySelector('[data-cookie-reject]')?.addEventListener('click', () => apply('necessary'));
  })();
</script>
<style>
  .cookie-consent{position:fixed;left:16px;right:16px;bottom:16px;z-index:4000;display:flex;align-items:center;justify-content:space-between;gap:18px;max-width:960px;margin:0 auto;padding:16px 18px;border:1px solid #d7e5df;border-radius:16px;background:#fff;color:#16201b;box-shadow:0 18px 50px rgba(0,0,0,.18);font-size:14px;line-height:1.45}
  .cookie-consent[hidden]{display:none}
  .cookie-consent strong{display:block;margin-bottom:2px;font-size:15px}
  .cookie-consent p{margin:0;color:#56625c}
  .cookie-consent a{color:#176b55}
  .cookie-consent__actions{display:flex;flex:0 0 auto;gap:10px}
  .cookie-consent__actions .button{min-height:42px;padding:0 16px;white-space:nowrap}
  @media(max-width:700px){.cookie-consent{left:10px;right:10px;bottom:10px;flex-direction:column;align-items:stretch;gap:12px;padding:14px}.cookie-consent__actions .button{flex:1}}
</style>
