---
// Cookie banner with TWO independent choices (neither is pre-ticked, neither depends on the other):
//   - analytics:   localStorage 'sg-cookie-consent' = 'all' | 'necessary'   (GA4 is loaded by BaseLayout only after 'all')
//   - advertising: localStorage 'sg-ad-consent'     = 'granted' | 'denied'   (Google Ads click ids; Consent Mode ad_storage /
//                  ad_user_data / ad_personalization). Until 'granted' no advertising identifier is stored (public/js/forms.js).
// «Прийняти все» / «Відхилити все» / «Зберегти вибір» are equally prominent. The footer button [data-cookie-settings] reopens the
// banner with the current choice, so a decision can be changed or withdrawn at any time. The banner is shown again when the
// advertising choice is missing (visitors who decided before this purpose existed).

import type { Locale } from '../i18n/helpers';
import { intlHref } from '../i18n/intl-routes';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = {
  uk: {
    aria: 'Налаштування cookies',
    title: 'Ваші налаштування приватності',
    text: 'Ми використовуємо необхідні cookies та, лише за вашою згодою, аналітику й рекламні cookies. Згоди незалежні, їх можна обрати окремо.',
    more: 'Докладніше',
    policy: '/cookies-policy/',
    analyticsTitle: 'Аналітичні cookies',
    analyticsText: 'допомагають зрозуміти, як використовується сайт (Google Analytics).',
    adsTitle: 'Рекламні cookies',
    adsText: 'зберігають ідентифікатор рекламного кліку Google Ads, щоб оцінити ефективність реклами та передати оплачене замовлення в Google Ads. Без цієї згоди ідентифікатори не зберігаються.',
    reject: 'Лише необхідні',
    save: 'Зберегти вибір',
    settings: 'Налаштувати',
    accept: 'Прийняти'
  },
  ru: {
    aria: 'Настройки cookies',
    title: 'Ваши настройки приватности',
    text: 'Мы используем необходимые cookies и, только с вашего согласия, аналитику и рекламные cookies. Согласия независимы, их можно выбрать отдельно.',
    more: 'Подробнее',
    policy: '/ru/cookies-policy/',
    analyticsTitle: 'Аналитические cookies',
    analyticsText: 'помогают понять, как используется сайт (Google Analytics).',
    adsTitle: 'Рекламные cookies',
    adsText: 'сохраняют идентификатор рекламного клика Google Ads, чтобы оценить эффективность рекламы и передать оплаченный заказ в Google Ads. Без этого согласия идентификаторы не сохраняются.',
    reject: 'Только необходимые',
    save: 'Сохранить выбор',
    settings: 'Настроить',
    accept: 'Принять'
  },
  en: {
    aria: 'Cookie settings',
    title: 'Your privacy settings',
    text: 'We use necessary cookies and, only with your consent, analytics and advertising cookies. The consents are independent: you can choose them separately.',
    more: 'Learn more',
    policy: intlHref('cookies', 'en'),
    analyticsTitle: 'Analytics cookies',
    analyticsText: 'help us understand how the website is used (Google Analytics).',
    adsTitle: 'Advertising cookies',
    adsText: 'store the Google Ads click identifier so that we can measure advertising and report a paid order to Google Ads. Without this consent no identifier is stored.',
    reject: 'Necessary only',
    save: 'Save my choice',
    settings: 'Customize',
    accept: 'Accept'
  },
  de: {
    aria: 'Cookie-Einstellungen',
    title: 'Ihre Datenschutzeinstellungen',
    text: 'Wir verwenden notwendige Cookies und – nur mit Ihrer Einwilligung – Analyse- und Werbe-Cookies. Die Einwilligungen sind unabhängig und können getrennt gewählt werden.',
    more: 'Mehr erfahren',
    policy: intlHref('cookies', 'de'),
    analyticsTitle: 'Analyse-Cookies',
    analyticsText: 'helfen uns zu verstehen, wie die Website genutzt wird (Google Analytics).',
    adsTitle: 'Werbe-Cookies',
    adsText: 'speichern die Google-Ads-Klick-ID, damit wir Werbung messen und eine bezahlte Bestellung an Google Ads melden können. Ohne diese Einwilligung wird keine Kennung gespeichert.',
    reject: 'Nur notwendige',
    save: 'Auswahl speichern',
    settings: 'Anpassen',
    accept: 'Akzeptieren'
  },
  es: {
    aria: 'Configuración de cookies',
    title: 'Su configuración de privacidad',
    text: 'Usamos cookies necesarias y, solo con su consentimiento, cookies de analítica y de publicidad. Los consentimientos son independientes: puede elegirlos por separado.',
    more: 'Política de cookies',
    policy: intlHref('cookies', 'es'),
    analyticsTitle: 'Cookies de analítica',
    analyticsText: 'nos ayudan a entender cómo se usa el sitio web (Google Analytics).',
    adsTitle: 'Cookies de publicidad',
    adsText: 'guardan el identificador de clic de Google Ads para medir la publicidad e informar de un pedido pagado a Google Ads. Sin este consentimiento no se guarda ningún identificador.',
    reject: 'Solo necesarias',
    save: 'Guardar mi elección',
    settings: 'Personalizar',
    accept: 'Aceptar'
  }
