---
/**
 * Shared template for the 6 solution pages /rishennya/dlya-{...}/.
 * Same visual system as the catalog sections and the /rishennya/ hub:
 * homepage hero geometry, photo tiles to exact subpages, icon cards, projects,
 * proof strip, timeline, city cards, FAQ, other solutions and the inline form.
 * Page files keep their own texts and pass them in; per-page extras
 * (tiles, projects, SEO copy) live in src/data/solution-pages.ts.
 */
import { getCityHub } from '../../data/city-hubs';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import TrustBar from '../TrustBar.astro';
import FAQBlock from '../FAQBlock.astro';
import ProjectCard from '../projects/ProjectCard.astro';
import ProfileRequestForm from '../profile/ProfileRequestForm.astro';
import type { JsonLdObject } from '../../seo/schema';
import { solutionExtras, type SolutionExtra } from '../../data/solution-pages';
import { solutionExtrasRu } from '../../data/ru/solution-pages.ru';
import { hasLocalizedRoute, localizedPath, type Locale } from '../../i18n/helpers';
import '../../styles/category-pages.css';
import '../../styles/shower-master.css';
import '../../styles/profile-systems.css';
import '../../styles/rishennya-lower.css';
import '../../styles/projects-common.css';

interface Point { title: string; text: string; link?: { label: string; href: string } }
interface Props {
  path: string;
  title: string;
  description: string;
  h1: string;
  heroLead: string;
  heroImage: { base: string; width: number; height: number; alt: string };
  scenarios: Point[];
  choosePoints: Point[];
  materials: Point[];
  safetyPoints: Point[];
  priceFactors: string[];
  processSteps: { title: string; text: string }[];
  experienceStats: { value: string; label: string }[];
  faq: [string, string][];
  breadcrumbItems: { label: string; href: string }[];
  structuredData: JsonLdObject[];
  formExample: string;
  /** Landing pages outside /rishennya/ (e.g. /pryvatnyj-sektor/) pass their own extras. */
  extra?: SolutionExtra;
  eyebrow?: string;
  /** RU landing pages pass 'ru' (texts in props, template UI below); default 'uk'. */
  locale?: Locale;
}

const p = Astro.props;
const locale = p.locale ?? 'uk';
const isRu = locale === 'ru';
const lp = (href: string) => localizedPath(href, locale);
const hasRu = hasLocalizedRoute(p.path, 'ru');
const tx = {
  uk: {
    solution: 'Рішення', products: 'Що можна зробити', request: 'Отримати розрахунок', measure: 'Замір і проєкт', measureNote: 'креслення під фактичні розміри',
    production: 'Власне виробництво', productionNote: 'скло, профіль і фурнітура', similar: 'схожих об’єктів', similarNote: 'реалізовані проєкти нижче', cities: 'Київ · Одеса · Львів', citiesNote: 'замір, монтаж і сервіс',
    productsEyebrow: 'Продукти', weDo: 'Що ми робимо', productsNote: 'Кожна плитка веде на сторінку з моделями, характеристиками та цінами.',
    tasks: 'Задачі об’єкта', scenarios: 'Реальні сценарії', scenariosNote: 'Ситуації, з якими до нас звертаються найчастіше.',
    choiceEyebrow: 'Вибір рішення', choice: 'Як обрати рішення', choiceNote: 'Формат конструкції залежить від приміщення, навантаження й потрібної приватності.',
    materialsEyebrow: 'Матеріали й безпека', materials: 'Скло, профіль і безпека', materialsNote: 'З чого виготовляємо конструкції і чому вони безпечні.',
    priceEyebrow: 'Вартість', price: 'Від чого залежить ціна', priceNote: 'Фіксованої ціни немає — кожен проєкт рахуємо під об’єкт. Орієнтовні ціни готових моделей — на сторінках продуктів.',
    portfolio: 'Портфоліо', objects: 'Реалізовані об’єкти', allProjects: 'Усі проєкти', proofLabel: 'Досвід Space Glass', threeCities: '3 міста', about: 'Про Space Glass →',
    process: 'Процес', howWeWork: 'Як ми працюємо', geo: 'Географія', geoIn: 'у Києві, Одесі та Львові',
    geoText: (forWhom: string) => `Виїжджаємо на замір, виготовляємо та монтуємо конструкції ${forWhom} у трьох містах і областях; для інших міст України умови погоджуємо окремо.`,
    projectsOnSite: 'проєктів на сайті', glass: 'Скло', faqTitle: 'FAQ: скляні конструкції', faqIntro: 'Відповіді на питання, які найчастіше ставлять перед замовленням.',
    othersEyebrow: 'Інші рішення', businessLabel: 'Для бізнесу', businessNote: 'Готелі · Ресторани · Офіси · Магазини', others: 'Рішення для інших об’єктів', allSolutions: 'Усі рішення', formProduct: 'Рішення', formTitle: 'Розрахуємо рішення',
    formText: 'Надішліть фото, приблизні розміри або креслення — підберемо конструкції й підготуємо попередній розрахунок.', formLabel: 'Що цікавить',
    cityNames: { kyiv: 'Київ', odesa: 'Одеса', lviv: 'Львів' }
  },
  ru: {
    solution: 'Решение', products: 'Что можно сделать', request: 'Получить расчёт', measure: 'Замер и проект', measureNote: 'чертёж под фактические размеры',
    production: 'Собственное производство', productionNote: 'стекло, профиль и фурнитура', similar: 'похожих объектов', similarNote: 'реализованные проекты ниже', cities: 'Киев · Одесса · Львов', citiesNote: 'замер, монтаж и сервис',
    productsEyebrow: 'Продукты', weDo: 'Что мы делаем', productsNote: 'Каждая плитка ведёт на страницу с моделями, характеристиками и ценами.',
    tasks: 'Задачи объекта', scenarios: 'Реальные сценарии', scenariosNote: 'Ситуации, с которыми к нам обращаются чаще всего.',
    choiceEyebrow: 'Выбор решения', choice: 'Как выбрать решение', choiceNote: 'Формат конструкции зависит от помещения, нагрузки и нужной приватности.',
    materialsEyebrow: 'Материалы и безопасность', materials: 'Стекло, профиль и безопасность', materialsNote: 'Из чего изготавливаем конструкции и почему они безопасны.',
    priceEyebrow: 'Стоимость', price: 'От чего зависит цена', priceNote: 'Фиксированной цены нет — каждый проект считаем под объект. Ориентировочные цены готовых моделей — на страницах продуктов.',
    portfolio: 'Портфолио', objects: 'Реализованные объекты', allProjects: 'Все проекты', proofLabel: 'Опыт Space Glass', threeCities: '3 города', about: 'О Space Glass →',
    process: 'Процесс', howWeWork: 'Как мы работаем', geo: 'География', geoIn: 'в Киеве, Одессе и Львове',
    geoText: (forWhom: string) => `Выезжаем на замер, изготавливаем и монтируем конструкции ${forWhom} в трёх городах и областях; для других городов Украины условия согласовываем отдельно.`,
    projectsOnSite: 'проектов на сайте', glass: 'Стекло', faqTitle: 'FAQ: стеклянные конструкции', faqIntro: 'Ответы на вопросы, которые чаще всего задают перед заказом.',
    othersEyebrow: 'Другие решения', businessLabel: 'Для бизнеса', businessNote: 'Отели · Рестораны · Офисы · Магазины', others: 'Решения для других объектов', allSolutions: 'Все решения', formProduct: 'Решение', formTitle: 'Рассчитаем решение',
    formText: 'Пришлите фото, примерные размеры или чертёж — подберём конструкции и подготовим предварительный расчёт.', formLabel: 'Что интересует',
    cityNames: { kyiv: 'Киев', odesa: 'Одесса', lviv: 'Львов' }
  }
}[locale];
const extra = p.extra ?? (isRu ? solutionExtrasRu : solutionExtras)[p.path];
if (!extra) throw new Error(`No solution extras for ${p.path}`);

const hero = (suffix: string) => `/images/solutions-new/${p.heroImage.base}${suffix}.webp`;
const heroSrcset = `${hero('-640')} 640w, ${hero('-800')} 800w, ${hero('')} ${p.heroImage.width}w`;
const heroSizes = '(max-width: 900px) 100vw, 50vw';

const allProjects = (await getCollection('projects', ({ data }) => data.status === 'published' && data.locale === 'uk')).map(({ data }) => data);
const projects = extra.projectSlugs
  .map((slug) => allProjects.find((project) => project.slug === slug))
  .filter((project): project is NonNullable<typeof project> => Boolean(project));

const icon = (d: string) => `<svg viewBox="0 0 28 28" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const scenarioIcons = [
  icon('<path d="M4 24h20M6 24V11l8-6 8 6v13"/><path d="M11 24v-7h6v7"/>'),
  icon('<rect x="5" y="4" width="18" height="20"/><path d="M14 4v20M5 14h18"/>'),
  icon('<path d="M3 14s4-7 11-7 11 7 11 7-4 7-11 7S3 14 3 14z"/><circle cx="14" cy="14" r="3"/>'),
  icon('<path d="M4 24h20M6 24V5h16v19"/><path d="M14 5v19M17 14h2"/>')
];

const CITIES = [
  { href: lp('/city/kyiv/'), name: tx.cityNames.kyiv, key: 'Київ', cover: getCityHub('kyiv').hero.image },
  { href: lp('/city/odesa/'), name: tx.cityNames.odesa, key: 'Одеса', cover: getCityHub('odesa').hero.image },
  { href: lp('/city/lviv/'), name: tx.cityNames.lviv, key: 'Львів', cover: getCityHub('lviv').hero.image }
];
const cities = CITIES.map((city) => ({ ...city, count: allProjects.filter((project) => project.city === city.key).length }));

const otherSolutions = Object.entries(isRu ? solutionExtrasRu : solutionExtras)
  .filter(([path]) => path !== p.path)
  .map(([path, item]) => ({ path: lp(path), label: item.navLabel, image: item.image, note: item.tiles.slice(0, 3).map((tile) => tile.label).join(' · ') }))
  // Commercial object types live on the /dlya-biznesu/ hub, not on /rishennya/dlya-*/ pages.
  .concat({ path: lp('/dlya-biznesu/'), label: tx.businessLabel, image: '/images/solutions-new/solution-hotel-640.webp', note: tx.businessNote });
---
<BaseLayout
  title={p.title}
  description={p.description}
  locale={locale}
  alternateLocales={hasRu ? ['uk', 'ru'] : ['uk']}
  schemaType="Service"
  structuredData={p.structuredData}
  image={hero('')}
  heroPreloadSrc={hero('-800')}
  heroPreloadSrcset={heroSrcset}
  heroPreloadSizes={heroSizes}
>
<div class="sg-page-shell">
  <Header />
  <main id="main">
    <section class="category-hero category-hero--photo profile-hero">
      <div class="category-hero__copy">
        <Breadcrumbs items={p.breadcrumbItems.map((item, index) => index === p.breadcrumbItems.length - 1 ? { label: item.label } : item)} />
        <p class="eyebrow">{p.eyebrow ?? `${tx.solution} · ${extra.navLabel}`}</p>
        <h1>{p.h1}</h1>
        <p class="lead">{p.heroLead}</p>
        <div class="hero__actions">
          <a class="button button--mint" href="#products">{tx.products}</a>
          <a class="button button--outline" href="#request">{tx.request}</a>
        </div>
      </div>
      <figure class="category-hero__figure">
        <div class="category-hero__frame">
          <img src={hero('-800')} srcset={heroSrcset} sizes={heroSizes} alt={p.heroImage.alt} width={p.heroImage.width} height={p.heroImage.height} decoding="async" fetchpriority="high" />
        </div>
      </figure>
    </section>

    <TrustBar locale={locale} />

    <section class="category-section category-section--mint">
      <div class="category-heading"><div><p class="eyebrow">Space Glass {extra.forWhom}</p><h2>{extra.seoHeading}</h2></div></div>
      <div class="category-intro-grid">
        <div class="category-prose">{extra.seo.map((paragraph) => <p>{paragraph}</p>)}</div>
        <ul class="category-intro__spec">
          <li><b>{tx.measure}</b><span>{tx.measureNote}</span></li>
          <li><b>{tx.production}</b><span>{tx.productionNote}</span></li>
          <li><b>{projects.length}+ {tx.similar}</b><span>{tx.similarNote}</span></li>
          <li><b>{tx.cities}</b><span>{tx.citiesNote}</span></li>
        </ul>
      </div>
    </section>

    <section id="products" class="category-section">
      <div class="category-heading"><div><p class="eyebrow">{tx.productsEyebrow}</p><h2>{tx.weDo} {extra.forWhom}</h2></div><p>{tx.productsNote}</p></div>
      <div class="rh-tiles">
        {extra.tiles.map((tile) => (
          <a class="rh-tile" href={lp(tile.href)}>
            <img src={tile.image} alt="" width="480" height="480" loading="lazy" decoding="async" />
            <span class="rh-tile__arrow" aria-hidden="true">→</span>
            <span class="rh-tile__body"><b>{tile.label}</b><span>{tile.note}</span></span>
          </a>
        ))}
      </div>
    </section>

    <section class="category-section category-section--mint">
      <div class="category-heading"><div><p class="eyebrow">{tx.tasks}</p><h2>{tx.scenarios}</h2></div><p>{tx.scenariosNote}</p></div>
      <div class="rh-choose">
        {p.scenarios.map((item, index) => <article><span class="rh-choose__icon" set:html={scenarioIcons[index % scenarioIcons.length]} /><h3>{item.title}</h3><p>{item.text}</p></article>)}
      </div>
    </section>

    <section class="category-section">
      <div class="category-heading"><div><p class="eyebrow">{tx.choiceEyebrow}</p><h2>{tx.choice}</h2></div><p>{tx.choiceNote}</p></div>
      <div class="material-grid material-grid--parts">
        {p.choosePoints.map((item) => <article><b>{item.title}</b><p>{item.text}</p>{item.link && <a class="category-arrow-link" href={lp(item.link.href)}>{item.link.label} →</a>}</article>)}
      </div>
    </section>

    <section class="category-section category-section--mint">
      <div class="category-heading"><div><p class="eyebrow">{tx.materialsEyebrow}</p><h2>{tx.materials}</h2></div><p>{tx.materialsNote}</p></div>
      <div class="material-grid material-grid--parts">
        {[...p.materials, ...p.safetyPoints].map((item) => <article><b>{item.title}</b><p>{item.text}</p>{item.link && <a class="category-arrow-link" href={lp(item.link.href)}>{item.link.label} →</a>}</article>)}
      </div>
    </section>

    <section class="category-section">
      <div class="category-heading"><div><p class="eyebrow">{tx.priceEyebrow}</p><h2>{tx.price}</h2></div><p>{tx.priceNote}</p></div>
      <div class="category-steps">
        {p.priceFactors.map((factor, index) => <div class="category-steps__item"><span>{String(index + 1).padStart(2, '0')}</span><b>{factor.charAt(0).toUpperCase() + factor.slice(1)}</b></div>)}
      </div>
    </section>

    {projects.length > 0 && (
      <section class="category-section category-section--mint">
        <div class="category-heading category-heading--projects">
          <div class="category-heading--projects__title"><p class="eyebrow">{tx.portfolio}</p><h2>{tx.objects}</h2></div>
          <div class="category-heading--projects__aside"><a class="category-arrow-link" href={lp('/project/')}>{tx.allProjects} <span aria-hidden="true">→</span></a></div>
        </div>
        <div class="projects-index-v2__grid category-projects-grid">
          {projects.map((project) => <ProjectCard project={project} locale={locale} href={lp(`/project/${project.slug}/`)} />)}
        </div>
      </section>
    )}

    <section class="category-section">
      <div class="rh-proof" aria-label={tx.proofLabel}>
        {p.experienceStats.map((stat) => <div><strong>{stat.value}</strong><span>{stat.label.split(' ').slice(0, 4).join(' ')}</span></div>)}
        <div><strong>{tx.threeCities}</strong><span>{tx.cities}</span></div>
        <a class="rh-proof__link" href={lp('/about/')}>{tx.about}</a>
      </div>
    </section>

    <section class="category-section rishennya-process">
      <div class="category-heading"><div><p class="eyebrow">{tx.process}</p><h2>{tx.howWeWork}</h2></div></div>
      <ol class={`rh-timeline${p.processSteps.length > 4 ? ' rh-timeline--6' : ''}`}>
        {p.processSteps.map((step, index) => <li><span class="rh-timeline__num">{String(index + 1).padStart(2, '0')}</span><b>{step.title}</b><p>{step.text}</p></li>)}
      </ol>
    </section>

    <section class="category-section">
      <div class="category-heading"><div><p class="eyebrow">{tx.geo}</p><h2>{p.h1} {tx.geoIn}</h2></div><p>{tx.geoText(extra.forWhom)}</p></div>
      <div class="rh-cities">
        {cities.map((city) => (
          <a class="rh-city" href={city.href}>
            <img src={city.cover.src} srcset={city.cover.srcset} sizes="(max-width: 900px) 100vw, 33vw" alt="" width={city.cover.width} height={city.cover.height} loading="lazy" decoding="async" />
            <span class="rh-city__body"><strong>{city.name}</strong>{city.count > 0 && <span>{city.count} {tx.projectsOnSite}</span>}<b>{tx.glass} {extra.forWhom} — {city.name} →</b></span>
          </a>
        ))}
      </div>
    </section>

    <section class="category-section category-section--faq">
      <FAQBlock
        title={`${tx.faqTitle} ${extra.forWhom}`}
        intro={tx.faqIntro}
        items={p.faq}
        visibleCount={6}
        expandTo={p.faq.length}
        locale={locale}
      />
    </section>

    <section class="category-section category-section--mint">
      <div class="category-heading"><div><p class="eyebrow">{tx.othersEyebrow}</p><h2>{tx.others}</h2></div><p><a class="category-arrow-link" href={lp('/rishennya/')}>{tx.allSolutions} <span aria-hidden="true">→</span></a></p></div>
      <div class={`rh-tiles ${otherSolutions.length === 2 ? 'rh-tiles--2' : 'rh-tiles--5'}`}>
        {otherSolutions.map((item) => (
          <a class="rh-tile" href={item.path}>
            <img src={item.image} alt="" width="640" height="500" loading="lazy" decoding="async" />
            <span class="rh-tile__arrow" aria-hidden="true">→</span>
            <span class="rh-tile__body"><b>{item.label}</b><span>{item.note}</span></span>
          </a>
        ))}
      </div>
    </section>

    <ProfileRequestForm
      page={lp(p.path)}
      product={`${tx.formProduct} ${extra.forWhom}`}
      title={`${tx.formTitle} ${extra.forWhom}`}
      text={tx.formText}
      options={extra.tiles.map((tile) => tile.label)}
      optionsLabel={tx.formLabel}
      commentPlaceholder={p.formExample}
      locale={locale}
    />
  </main>
  <Footer />
</div>
</BaseLayout>
