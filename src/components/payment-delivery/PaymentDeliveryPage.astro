---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { breadcrumbSchema, faqSchema, type JsonLdObject } from '../../seo/schema';
import { localizedPath, type Locale } from '../../i18n/helpers';

type LinkItem = { label: string; href: string };
type Copy = {
  locale: Locale; title: string; description: string; eyebrow: string; h1: string; lead: string; ctaPrimary: string; ctaSecondary: string;
  sections: Record<string,string>; quickFacts: string[]; payment: string[]; prepayment: string[]; delivery: string[]; nova: string[]; courier: string[]; pickup: string[]; tracking: string; trackingButton: string; manufacturingIntro: string; manufacturingDepends: string[]; deliveryTime: string; warningTitle: string; warning: string[]; faq: {question:string; answer:string}[]; relatedTitle: string; ctaTitle: string; ctaText: string; links: LinkItem[]; home: string; serviceName: string;
};
const copies: Record<Locale, Copy> = {
  uk: {
    locale:'uk', title:'Оплата та доставка скляних конструкцій | Space Glass', description:'Оплата та доставка душових кабін, перегородок, дзеркал, фасадів та інших скляних конструкцій. Терміни виготовлення, способи доставки, передоплата, Нова Пошта, самовивіз.', eyebrow:'Оплата й логістика', h1:'Оплата та доставка скляних конструкцій', lead:'Оплата та доставка скляних конструкцій у Space Glass здійснюється з урахуванням індивідуальних параметрів кожного замовлення, типу виробу та регіону доставки.', ctaPrimary:'Отримати консультацію', ctaSecondary:'Перейти до FAQ',
    sections:{quick:'Коротко для клієнта та AI', payment:'Способи оплати', prepayment:'Передоплата та остаточний розрахунок', delivery:'Способи доставки', nova:'Нова Пошта', courier:'Кур’єрська доставка до об’єкта', pickup:'Самовивіз', tracking:'Відстеження відправлення', manufacturing:'Терміни виготовлення', deliveryTime:'Терміни доставки', warning:'Важливо при отриманні', faq:'Часті запитання', related:'Корисні посилання'},
    quickFacts:['Оплата: безготівково за реквізитами або готівкою.','Доставка: по Україні, Нова Пошта, кур’єром до об’єкта або самовивіз.','Виготовлення: 15–30 робочих днів після узгодження та передоплати.','Передоплата: зазвичай 50–80%.','Доставка по Україні: у середньому 1–5 робочих днів.'],
    payment:['Безготівковий переказ на рахунок за реквізитами Space Glass.','Працюємо з фізичними та юридичними особами.','Готівкова оплата можлива в офісі або спеціалісту під час погодженого виїзду.'],
    prepayment:['Для запуску індивідуального виробу у виробництво зазвичай потрібна передоплата 50–80%.','Остаточний розрахунок здійснюється перед відвантаженням, перед доставкою або після монтажу — залежно від погоджених умов замовлення.'],
    delivery:['Доставляємо скляні конструкції по всій Україні.','Вартість залежить від габаритів, ваги, типу упаковки та регіону доставки.','Тарифні ціни перевізників не фіксуються на сторінці: під час розрахунку ми орієнтуємося на актуальні умови перевізника.'],
    nova:['Відправлення Новою Поштою доступне у відділення або кур’єром за тарифами перевізника.','Для крихких конструкцій погоджуємо пакування, габарити й формат доставки до відправлення.'], courier:['Кур’єрська доставка до об’єкта погоджується індивідуально з урахуванням міста, габаритів і можливості безпечного розвантаження.'], pickup:['Самовивіз можливий тільки за попереднім погодженням менеджера. Адресу та час видачі повідомляємо індивідуально, без публікації неперевірених адрес.'], tracking:'Після відправлення клієнт отримує ТТН для контролю статусу посилки на сайті перевізника.', trackingButton:'Відстежити відправлення Нової Пошти', manufacturingIntro:'Стандартний строк виготовлення — 15–30 робочих днів після підтвердження замовлення, технічного погодження та внесення передоплати.', manufacturingDepends:['типу та товщини скла;','складності конструкції;','обраної фурнітури;','спеціальної обробки;','поточного виробничого навантаження.'], deliveryTime:'Доставка по Україні в середньому займає 1–5 робочих днів після відвантаження, залежно від регіону та графіка перевізника.', warningTitle:'Огляньте замовлення до підпису', warning:['Перевірте упаковку та виріб у присутності кур’єра або представника відділення.','Зафіксуйте видимі пошкодження фото або відео.','Складіть акт або внесіть зауваження в документи доставки.','Не підписуйте документи без зауважень, якщо бачите пошкодження.','Претензії щодо видимих транспортних пошкоджень, не зафіксованих при отриманні, можуть бути відхилені перевізником.'],
    faq:[['Яка передоплата?','Зазвичай передоплата становить 50–80% після узгодження параметрів, креслень і вартості замовлення.'],['Які способи оплати доступні?','Доступний безготівковий переказ на рахунок для фізичних і юридичних осіб, а також готівкова оплата в офісі або спеціалісту під час погодженого виїзду.'],['Чи працюєте ви по всій Україні?','Так, організовуємо доставку скляних конструкцій по Україні з урахуванням габаритів, ваги, пакування та регіону.'],['Скільки триває доставка?','У середньому доставка по Україні займає 1–5 робочих днів після відвантаження.'],['Скільки виготовляються скляні конструкції?','Орієнтовний строк виготовлення — 15–30 робочих днів після підтвердження замовлення, технічного погодження та передоплати.'],['Як відстежити посилку?','Після відправлення ми передаємо клієнту ТТН, яку можна перевірити на сайті Нової Пошти.'],['Чи можна забрати замовлення самостійно?','Так, самовивіз можливий за попереднім погодженням менеджера щодо місця та часу видачі.'],['Що робити при пошкодженні скла?','Огляньте виріб у присутності кур’єра, зробіть фото або відео, складіть акт чи внесіть зауваження в документи доставки.'],['Коли здійснюється остаточний розрахунок?','Остаточний розрахунок виконується перед відвантаженням, доставкою або після монтажу за погодженими умовами.'],['Від чого залежить вартість доставки?','Вартість залежить від габаритів, ваги, упаковки, регіону доставки та тарифів перевізника.']].map(([question,answer])=>({question,answer})),
    relatedTitle:'Пов’язані розділи', ctaTitle:'Потрібен точний розрахунок доставки?', ctaText:'Надішліть розміри, фото або креслення — підкажемо терміни виготовлення, передоплату та оптимальний спосіб доставки.', home:'Головна', serviceName:'Оплата та доставка', links:[]
  },
  ru: null, en: null, de: null
} as any;
function tr(base: Copy, locale: Locale, data: Partial<Copy>): Copy { return { ...base, ...data, locale, sections:{...base.sections,...data.sections}, links:[] } as Copy; }
copies.ru = tr(copies.uk,'ru',{title:'Оплата и доставка стеклянных конструкций | Space Glass',description:'Оплата и доставка душевых кабин, перегородок, зеркал, фасадов и других стеклянных конструкций. Сроки изготовления, способы доставки, предоплата, Новая Почта, самовывоз.',eyebrow:'Оплата и логистика',h1:'Оплата и доставка стеклянных конструкций',lead:'Оплата и доставка стеклянных конструкций в Space Glass выполняются с учетом индивидуальных параметров каждого заказа, типа изделия и региона доставки.',ctaPrimary:'Получить консультацию',ctaSecondary:'Перейти к FAQ',home:'Главная',serviceName:'Оплата и доставка'});
copies.en = tr(copies.uk,'en',{title:'Payment and Delivery of Glass Structures | Space Glass',description:'Payment and delivery for shower cabins, partitions, mirrors, facades and other glass structures. Production lead times, delivery options, prepayment, Nova Poshta and pickup.',eyebrow:'Payment and logistics',h1:'Payment and delivery of glass structures',lead:'Payment and delivery at Space Glass are planned around each order’s custom dimensions, product type and delivery region.',ctaPrimary:'Request a consultation',ctaSecondary:'Go to FAQ',home:'Home',serviceName:'Payment and delivery'});
copies.de = tr(copies.uk,'de',{title:'Zahlung und Lieferung von Glaskonstruktionen | Space Glass',description:'Zahlung und Lieferung für Duschkabinen, Trennwände, Spiegel, Fassaden und andere Glaskonstruktionen. Fertigungszeiten, Lieferoptionen, Anzahlung, Nova Poshta und Abholung.',eyebrow:'Zahlung und Logistik',h1:'Zahlung und Lieferung von Glaskonstruktionen',lead:'Zahlung und Lieferung bei Space Glass werden anhand der individuellen Bestellparameter, des Produkttyps und der Lieferregion geplant.',ctaPrimary:'Beratung anfragen',ctaSecondary:'Zum FAQ',home:'Startseite',serviceName:'Zahlung und Lieferung'});

const localizedOverrides: Partial<Record<Locale, Partial<Copy>>> = {
  ru: {
    sections:{quick:'Кратко для клиента и AI', payment:'Способы оплаты', prepayment:'Предоплата и окончательный расчет', delivery:'Способы доставки', nova:'Новая Почта', courier:'Курьерская доставка на объект', pickup:'Самовывоз', tracking:'Отслеживание отправления', manufacturing:'Сроки изготовления', deliveryTime:'Сроки доставки', warning:'Важно при получении', faq:'Частые вопросы', related:'Полезные ссылки'},
    quickFacts:['Оплата: безналично по реквизитам или наличными.','Доставка: по Украине, Новая Почта, курьером на объект или самовывоз.','Изготовление: 15–30 рабочих дней после согласования и предоплаты.','Предоплата: обычно 50–80%.','Доставка по Украине: в среднем 1–5 рабочих дней.'],
    payment:['Безналичный перевод на счет по реквизитам Space Glass.','Работаем с физическими и юридическими лицами.','Наличная оплата возможна в офисе или специалисту во время согласованного выезда.'],
    prepayment:['Для запуска индивидуального изделия в производство обычно требуется предоплата 50–80%.','Окончательный расчет выполняется перед отгрузкой, доставкой или после монтажа — согласно согласованным условиям заказа.'],
    delivery:['Доставляем стеклянные конструкции по всей Украине.','Стоимость зависит от габаритов, веса, типа упаковки и региона доставки.','Тарифы перевозчиков не фиксируются на странице: при расчете используем актуальные условия перевозчика.'],
    nova:['Отправка Новой Почтой доступна в отделение или курьером по тарифам перевозчика.','Для хрупких конструкций заранее согласовываем упаковку, габариты и формат доставки.'], courier:['Курьерская доставка на объект согласовывается индивидуально с учетом города, габаритов и безопасной разгрузки.'], pickup:['Самовывоз возможен только по предварительному согласованию с менеджером. Адрес и время выдачи сообщаем индивидуально.'], tracking:'После отправки клиент получает ТТН для проверки статуса на сайте перевозчика.', trackingButton:'Отследить отправление Новой Почты', manufacturingIntro:'Стандартный срок изготовления — 15–30 рабочих дней после подтверждения заказа, технического согласования и внесения предоплаты.', manufacturingDepends:['типа и толщины стекла;','сложности конструкции;','выбранной фурнитуры;','специальной обработки;','текущей загрузки производства.'], deliveryTime:'Доставка по Украине в среднем занимает 1–5 рабочих дней после отгрузки.', warningTitle:'Осмотрите заказ до подписи', warning:['Проверьте упаковку и изделие в присутствии курьера или представителя отделения.','Зафиксируйте видимые повреждения на фото или видео.','Составьте акт или внесите замечания в документы доставки.','Не подписывайте документы без замечаний, если есть повреждения.','Претензии по видимым транспортным повреждениям, не зафиксированным при получении, могут быть отклонены перевозчиком.'], relatedTitle:'Связанные разделы', ctaTitle:'Нужен точный расчет доставки?', ctaText:'Отправьте размеры, фото или чертежи — подскажем сроки изготовления, предоплату и оптимальный способ доставки.'
  },
  en: {
    sections:{quick:'Quick facts for customers and AI', payment:'Payment methods', prepayment:'Prepayment and final settlement', delivery:'Delivery methods', nova:'Nova Poshta', courier:'Courier delivery to the site', pickup:'Pickup', tracking:'Shipment tracking', manufacturing:'Manufacturing lead time', deliveryTime:'Delivery time', warning:'Important receiving instructions', faq:'FAQ', related:'Related links'},
    quickFacts:['Payment: bank transfer by invoice details or cash.','Delivery: across Ukraine by Nova Poshta, courier to site or pickup.','Manufacturing: 15–30 business days after approval and prepayment.','Prepayment: usually 50–80%.','Delivery in Ukraine: 1–5 business days on average.'],
    payment:['Cashless bank transfer to the Space Glass account.','Available for individuals and legal entities.','Cash payment is possible at the office or to a specialist during an agreed visit.'], prepayment:['A 50–80% prepayment is usually required to start custom production.','The final settlement is made before dispatch, before delivery or after installation according to agreed terms.'], delivery:['We deliver glass structures throughout Ukraine.','The cost depends on dimensions, weight, packaging and delivery region.','Carrier tariff prices are not hardcoded on this page; calculations use current carrier terms.'], nova:['Nova Poshta delivery is available to a branch or by courier according to carrier tariffs.','For fragile structures we approve packaging, dimensions and delivery format before dispatch.'], courier:['Courier delivery to the site is agreed individually based on city, dimensions and safe unloading conditions.'], pickup:['Pickup is available only by prior agreement with a manager. The address and pickup time are shared individually.'], tracking:'After dispatch, the client receives a TTN tracking number for checking shipment status.', trackingButton:'Track Nova Poshta shipment', manufacturingIntro:'Standard manufacturing time is 15–30 business days after order confirmation, technical approval and prepayment.', manufacturingDepends:['glass type and thickness;','construction complexity;','selected hardware;','special processing;','current production workload.'], deliveryTime:'Delivery across Ukraine takes 1–5 business days on average after dispatch.', warningTitle:'Inspect the order before signing', warning:['Inspect the packaging and product in the presence of the courier or branch representative.','Record visible damage with photos or video.','Create an act or add remarks to delivery documents.','Do not sign documents without remarks when damage exists.','Claims for visible transport damage not recorded at receipt may be rejected by the carrier.'], relatedTitle:'Related sections', ctaTitle:'Need an exact delivery estimate?', ctaText:'Send dimensions, photos or drawings — we will advise lead time, prepayment and the best delivery method.'
  },
  de: {
    sections:{quick:'Kurzinfos für Kunden und KI', payment:'Zahlungsarten', prepayment:'Anzahlung und Restzahlung', delivery:'Liefermethoden', nova:'Nova Poshta', courier:'Kurierlieferung zum Objekt', pickup:'Abholung', tracking:'Sendungsverfolgung', manufacturing:'Fertigungszeit', deliveryTime:'Lieferzeit', warning:'Wichtig bei Erhalt', faq:'FAQ', related:'Verwandte Links'},
    quickFacts:['Zahlung: per Überweisung nach Zahlungsdaten oder bar.','Lieferung: in der Ukraine per Nova Poshta, Kurier zum Objekt oder Abholung.','Fertigung: 15–30 Werktage nach Freigabe und Anzahlung.','Anzahlung: in der Regel 50–80%.','Lieferung in der Ukraine: durchschnittlich 1–5 Werktage.'],
    payment:['Banküberweisung auf das Konto von Space Glass.','Für Privatpersonen und juristische Personen möglich.','Barzahlung ist im Büro oder an einen Spezialisten während eines vereinbarten Termins möglich.'], prepayment:['Für den Start der individuellen Fertigung ist in der Regel eine Anzahlung von 50–80% erforderlich.','Die Restzahlung erfolgt vor Versand, vor Lieferung oder nach Montage gemäß vereinbarten Bedingungen.'], delivery:['Wir liefern Glaskonstruktionen in die gesamte Ukraine.','Die Kosten hängen von Abmessungen, Gewicht, Verpackung und Lieferregion ab.','Tarife der Versanddienstleister werden nicht fest auf der Seite hinterlegt; wir verwenden aktuelle Bedingungen.'], nova:['Nova-Poshta-Versand ist an eine Filiale oder per Kurier nach Tarifen des Dienstleisters möglich.','Für empfindliche Konstruktionen stimmen wir Verpackung, Maße und Lieferformat vor Versand ab.'], courier:['Kurierlieferung zum Objekt wird individuell nach Stadt, Abmessungen und sicherer Entladung abgestimmt.'], pickup:['Abholung ist nur nach vorheriger Abstimmung mit einem Manager möglich. Adresse und Zeit werden individuell mitgeteilt.'], tracking:'Nach Versand erhält der Kunde eine TTN zur Prüfung des Sendungsstatus.', trackingButton:'Nova-Poshta-Sendung verfolgen', manufacturingIntro:'Die Standard-Fertigungszeit beträgt 15–30 Werktage nach Bestellbestätigung, technischer Freigabe und Anzahlung.', manufacturingDepends:['Glasart und Glasstärke;','Komplexität der Konstruktion;','gewählte Beschläge;','Sonderbearbeitung;','aktuelle Produktionsauslastung.'], deliveryTime:'Die Lieferung in der Ukraine dauert nach Versand durchschnittlich 1–5 Werktage.', warningTitle:'Bestellung vor Unterschrift prüfen', warning:['Prüfen Sie Verpackung und Produkt im Beisein des Kuriers oder Filialmitarbeiters.','Dokumentieren Sie sichtbare Schäden per Foto oder Video.','Erstellen Sie ein Protokoll oder vermerken Sie Hinweise in den Lieferdokumenten.','Unterschreiben Sie bei Schäden nicht ohne Vorbehalt.','Ansprüche wegen sichtbarer Transportschäden, die bei Erhalt nicht dokumentiert wurden, können vom Dienstleister abgelehnt werden.'], relatedTitle:'Verwandte Bereiche', ctaTitle:'Benötigen Sie eine genaue Lieferkalkulation?', ctaText:'Senden Sie Maße, Fotos oder Zeichnungen — wir empfehlen Fertigungszeit, Anzahlung und passende Lieferung.'
  }
};
for (const locale of ['ru','en','de'] as Locale[]) Object.assign(copies[locale], localizedOverrides[locale]);

const copy = copies[Astro.props.locale as Locale];
const lp = (path: string) => localizedPath(path, copy.locale);
copy.links = [
  ['Каталог','/catalog/'],['Душові кабіни','/dushovi-kabiny/'],['Скляні перегородки','/sklyani-perehorodky/'],['Скляні двері','/sklyani-dveri/'],['Скляні огорожі','/sklyani-ohorozhi/'],['Дзеркала','/dzerkala/'],['Безрамне скління','/bezramne-configurator/'],['Перголи','/alyuminiievi-konstruktsii/'],['Проєкти','/projects/'],['Конфігуратор','/quote/'],['Гарантія','/services/servis/'],['Публічна оферта','/terms/'],['Політика конфіденційності','/privacy-policy/'],['Контакти','/contacts/']
].map(([label,href])=>({label,href: lp(href)}));
const origin = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origin).href;
const structuredData: JsonLdObject[] = [
  breadcrumbSchema([{label:copy.home,href:new URL(lp('/'),origin).href},{label:copy.serviceName,href:canonical}]),
  faqSchema(copy.faq)!,
  {'@type':'Service','@id':`${canonical}#service`,name:copy.serviceName,serviceType:'Payment and delivery for custom glass structures',provider:{'@id':`${new URL('/',origin).href}#organization`},areaServed:{'@type':'Country',name:'Ukraine'},url:canonical,description:copy.description}
];
---
<BaseLayout title={copy.title} description={copy.description} locale={copy.locale} structuredData={structuredData}>
  <div class="sg-page-shell"><Header/><main id="main" class="pay-delivery">
    <section class="inner-hero pay-delivery__hero"><div class="inner-hero__copy"><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.h1}</h1><p class="lead">{copy.lead}</p><div class="pay-delivery__actions"><a class="button button--mint" href={lp("/contacts/")}>{copy.ctaPrimary}</a><a class="button button--outline" href="#faq">{copy.ctaSecondary}</a></div></div><div class="inner-hero__visual"><span>15–30</span><small>working days</small></div></section>
    <section class="inner-section"><h2>{copy.sections.quick}</h2><div class="pay-delivery__facts">{copy.quickFacts.map((item)=><article>{item}</article>)}</div></section>
    {[['payment',copy.payment],['prepayment',copy.prepayment],['delivery',copy.delivery],['nova',copy.nova],['courier',copy.courier],['pickup',copy.pickup]].map(([key,items])=><section class="inner-section pay-delivery__text"><h2>{copy.sections[key]}</h2><ul>{items.map((item)=><li>{item}</li>)}</ul></section>)}
    <section class="inner-section pay-delivery__text"><h2>{copy.sections.tracking}</h2><p>{copy.tracking}</p><a class="button button--mint" href="https://novaposhta.ua/tracking" target="_blank" rel="noopener noreferrer nofollow">{copy.trackingButton}</a></section>
    <section class="inner-section pay-delivery__text"><h2>{copy.sections.manufacturing}</h2><p>{copy.manufacturingIntro}</p><ul>{copy.manufacturingDepends.map((item)=><li>{item}</li>)}</ul></section>
    <section class="inner-section pay-delivery__text"><h2>{copy.sections.deliveryTime}</h2><p>{copy.deliveryTime}</p></section>
    <section class="inner-section pay-delivery__warning"><h2>{copy.warningTitle}</h2><ul>{copy.warning.map((item)=><li>{item}</li>)}</ul></section>
    <section id="faq" class="inner-section pay-delivery__faq"><h2>{copy.sections.faq}</h2>{copy.faq.map((item)=><details open><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>
    <section class="inner-section"><h2>{copy.relatedTitle}</h2><div class="pay-delivery__links">{copy.links.map((link)=><a href={link.href}>{link.label}</a>)}</div></section>
    <section class="inner-cta"><div><p class="eyebrow">Space Glass</p><h2>{copy.ctaTitle}</h2><p>{copy.ctaText}</p></div><a class="button button--white" href={lp("/contacts/")}>{copy.ctaPrimary}</a></section>
  </main><Footer/></div>
</BaseLayout>
