---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import RelatedServices from './RelatedServices.astro';
import RelatedCities from './RelatedCities.astro';
import RelatedArticles from './RelatedArticles.astro';
import RelatedProjects from './RelatedProjects.astro';
import CTA from './CTA.astro';
import FAQ from './FAQ.astro';
import { commercialPages, pathFor, ui } from '../../data/seo-pages';
import { absoluteUrl, breadcrumbSchema, faqSchema, type JsonLdObject } from '../../seo/schema';
import type { Locale } from '../../i18n/helpers';
const { page, locale } = Astro.props;

const safeLocale: Locale =
  locale === 'ru'
    ? locale
    : 'uk';

const labels = ui(safeLocale);

const services = commercialPages(safeLocale).filter((p) => p.slug !== page.slug);

const cities = ['kyiv', 'lviv', 'odesa'].map((city) => ({
  title: ({
    uk: { kyiv: 'Київ', lviv: 'Львів', odesa: 'Одеса' },
    ru: { kyiv: 'Киев', lviv: 'Львов', odesa: 'Одесса' },
    en: { kyiv: 'Kyiv', lviv: 'Lviv', odesa: 'Odesa' },
    de: { kyiv: 'Kyjiw', lviv: 'Lwiw', odesa: 'Odesa' }
  } as const)[safeLocale][city as 'kyiv' | 'lviv' | 'odesa'],
  href: pathFor(safeLocale, `mista/${city}`)
}));

const articles = [
  {
    title: {
      uk: 'Як обрати безпечне скло',
      ru: 'Как выбрать безопасное стекло',
      en: 'How to choose safety glass',
      de: 'Sicherheitsglas richtig wählen'
    }[safeLocale],
    href: pathFor(safeLocale, 'baza-znan/yak-obraty-sklo')
  }
];

const projects = [
  {
    title: {
      uk: 'Loft-перегородка в Києві',
      ru: 'Loft-перегородка в Киеве',
      en: 'Loft partition in Kyiv',
      de: 'Loft-Trennwand in Kyjiw'
    }[safeLocale],
    href: pathFor(safeLocale, 'projects/loft-kyiv')
  }
];
const crumbHome = pathFor(safeLocale, '').replace('//', '/');
const breadcrumbParent = page.kind === 'city'
  ? { label: safeLocale === 'ru' ? 'Города' : 'Міста', href: pathFor(safeLocale, 'mista') }
  : page.kind === 'article'
    ? { label: safeLocale === 'ru' ? 'База знаний' : 'База знань', href: pathFor(safeLocale, 'baza-znan') }
    : page.kind === 'project'
      ? { label: safeLocale === 'ru' ? 'Проекты' : 'Проєкти', href: pathFor(safeLocale, 'projects') }
      : null;
const breadcrumbItems = breadcrumbParent
  ? [{ label: labels.home, href: crumbHome }, breadcrumbParent, { label: page.h1 }]
  : [];
const origin = Astro.site ?? Astro.url.origin;
const pageUrl = absoluteUrl(pathFor(safeLocale, page.slug), origin);
const schemaTypeByKind = { hub: 'CollectionPage', service: 'Service', city: 'Service', article: 'Article', project: 'CreativeWork' } as const;
const pageStructuredData: JsonLdObject = {
  '@type': schemaTypeByKind[page.kind],
  '@id': `${pageUrl}#primary`,
  url: pageUrl,
  name: page.h1,
  headline: page.h1,
  description: page.description,
  inLanguage: safeLocale,
  provider: { '@id': `${absoluteUrl('/', origin)}#organization` },
  mainEntityOfPage: { '@id': `${pageUrl}#webpage` }
};
const faqStructuredData = faqSchema(page.faq.map(([question, answer]) => ({ question, answer })));
const structuredData = [
  pageStructuredData,
  ...(breadcrumbItems.length ? [breadcrumbSchema(breadcrumbItems.map((item) => ({ label: item.label, href: absoluteUrl(item.href ?? pathFor(safeLocale, page.slug), origin) })))] : []),
  faqStructuredData
].filter(Boolean) as JsonLdObject[];
import "../../styles/seo-editorial.css";
---
<BaseLayout title={page.title} description={page.description} locale={locale} schemaType={schemaTypeByKind[page.kind]} structuredData={structuredData}>
 <div class="sg-page-shell"><Header /><main id="main" class="seo-page">
  {breadcrumbItems.length > 0 && <div class="seo-page__wrap"><Breadcrumbs items={breadcrumbItems} schema={false} /></div>}
  <section class="seo-hero"><div><p class="eyebrow">{page.eyebrow}</p><h1>{page.h1}</h1><p class="lead">{page.intro}</p><a class="button button--mint" href="#seo-request">{labels.ctaButton}</a></div><div class="seo-hero__mark" aria-hidden="true"><span>SPACE</span><b>GLASS</b></div></section>
  <div class="seo-page__wrap">
   {page.sections.length > 1 && <nav class="seo-jump" aria-label="On this page">{page.sections.map((section,index)=><a href={`#section-${index+1}`}>{section.title}</a>)}</nav>}
   <div class="seo-sections">{page.sections.map((section,index)=><section id={`section-${index+1}`}><span>{String(index+1).padStart(2,'0')}</span><div><h2>{section.title}</h2><p>{section.text}</p></div></section>)}</div>
   <RelatedServices labels={{eyebrow:labels.seeAlso,title:labels.relatedServices}} links={services} />
   <RelatedCities labels={{eyebrow:labels.seeAlso,title:labels.relatedCities}} links={cities} />
   <RelatedArticles labels={{eyebrow:labels.seeAlso,title:labels.relatedArticles}} links={articles} />
   <RelatedProjects labels={{eyebrow:labels.seeAlso,title:labels.relatedProjects}} links={projects} />
   {page.faq.length > 0 && <FAQ title={`${labels.faq}: ${page.eyebrow}`} intro={labels.faqIntro} items={page.faq} />}
  </div>
  <div id="seo-request"><CTA title={labels.ctaTitle} text={labels.ctaText} button={labels.ctaButton} href={pathFor(safeLocale,'quote')} /></div>
 </main><Footer /></div>
</BaseLayout>
