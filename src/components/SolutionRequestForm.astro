---
interface Props {
  solutionTitle: string;
  example?: string;
}

const {
  solutionTitle,
  example = 'Скляна конструкція за індивідуальними розмірами',
} = Astro.props;
---

<section class="solution-request-form" id="solution-request" aria-labelledby="solution-request-title">
  <div class="solution-request-form__intro">
    <p class="eyebrow">Заявка на розрахунок</p>
    <h2 id="solution-request-title">Покажіть нам ваш простір</h2>
    <p>Залиште контакти й коротко опишіть потрібну конструкцію. Менеджер уточнить деталі та підготує попередню оцінку.</p>
    <p class="solution-request-form__example"><b>Наприклад:</b> {example}</p>
  </div>

  <form class="quote-form contacts-v15-form solution-request-form__form" data-lead-form data-success-url="/thank-you/">
    <input name="product" type="hidden" value={solutionTitle} />
    <div class="contacts-form-grid">
      <label>Ім’я<input name="name" type="text" autocomplete="name" placeholder="Ваше ім’я" required /></label>
      <label>Телефон<input name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="+38" required /></label>
    </div>
    <label>Місто<input name="city" autocomplete="address-level2" type="text" placeholder="Київ, Львів, Одеса..." /></label>
    <label>Що потрібно<textarea name="comment" rows="5" placeholder={example}></textarea></label>
    <label class="quote-consent"><input name="consent" value="accepted" type="checkbox" required /><span>Погоджуюсь із <a href="/privacy-policy/">політикою конфіденційності</a>.</span></label>
    <button class="button button--mint" type="submit">Надіслати запит</button>
    <p data-form-status hidden role="status"></p>
  </form>
</section>

<style>
  /* Shared request form for solution pages */
  .solution-request-form{
    display:grid;
    grid-template-columns:minmax(0,.8fr) minmax(420px,1.2fr);
    gap:clamp(32px,6vw,84px);
    align-items:center;
    padding:clamp(56px,8vw,104px) 58px;
    background:#fff;
    border-top:1px solid var(--line);
  }
  .solution-request-form__intro{max-width:620px}
  .solution-request-form__intro>p:not(.eyebrow){color:var(--muted)}
  .solution-request-form__example{margin-top:26px;padding-top:22px;border-top:1px solid var(--green-line)}
  .solution-request-form__form{width:100%;max-width:760px;justify-self:end}
  .solution-request-form__form .quote-consent{display:flex;grid-template-columns:none;align-items:flex-start;gap:10px}
  .solution-request-form__form .quote-consent input{width:22px;min-width:22px;height:22px;margin:0}
  @media (max-width: 900px) {
    .solution-request-form{grid-template-columns:1fr;padding-inline:38px}
    .solution-request-form__form{max-width:none;justify-self:stretch}
  }
  @media (max-width: 640px) {
    .solution-request-form{padding:54px 22px;gap:30px}
    .solution-request-form__form{padding:24px 18px}
    .solution-request-form__form .button{width:100%;justify-content:center}
  }
</style>
