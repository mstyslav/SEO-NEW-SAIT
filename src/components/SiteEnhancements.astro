---
---
<style is:global>
  :root{--sg-brand-mint:#7fd7bd;--sg-brand-deep:#0e4f3d}
  .catalog-mega a::after{display:none!important}
  .catalog-mega a{transition:color .16s ease,background .16s ease}
  .catalog-mega a:hover,.catalog-mega a:focus-visible{color:var(--sg-brand-mint)}
  .catalog-mega__group:hover,.catalog-mega__group.is-active{background:rgba(127,215,189,.06)}
  .sg-wishlist-header{width:44px;height:44px;border:1px solid rgba(255,255,255,.22);border-radius:50%;display:inline-grid;place-items:center;color:#fff;text-decoration:none;position:relative;flex:0 0 44px;background:transparent;transition:border-color .18s ease,background .18s ease}
  .sg-wishlist-header:hover{border-color:var(--sg-brand-mint);background:rgba(127,215,189,.08)}.sg-wishlist-header svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8}.sg-wishlist-count{position:absolute;right:-2px;top:-5px;min-width:18px;height:18px;padding:0 5px;border-radius:999px;background:var(--sg-brand-mint);color:#09251e;font:700 10px/18px Arial,sans-serif;text-align:center}
  .sg-home-category-grid{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:12px!important}.sg-home-category-grid .sg-category-card{min-height:260px;padding:24px 22px!important;display:flex!important;flex-direction:column!important;align-items:flex-start!important}.sg-home-category-grid .sg-category-card__icon{width:44px;height:44px;display:grid;place-items:center;margin-bottom:24px;color:#205f50}.sg-home-category-grid .sg-category-card__icon svg{width:42px;height:42px;stroke:currentColor;fill:none;stroke-width:1.5}.sg-home-category-grid .sg-category-card h2{font-size:clamp(22px,2.1vw,31px)!important;line-height:1.02!important;letter-spacing:-.035em!important;margin:0 0 18px!important}.sg-home-category-grid .sg-category-card p{font-size:14px!important;line-height:1.45!important;margin:auto 0 16px!important;max-width:34ch}
  [data-wishlist-product].is-active{border-color:var(--sg-brand-mint)!important;background:#effaf6!important;color:#0d5e48!important}
  @media(max-width:900px){.sg-home-category-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}}@media(max-width:620px){.sg-home-category-grid{grid-template-columns:1fr!important}.sg-home-category-grid .sg-category-card{min-height:210px}}
  /* "Скло для бізнесу" reuses the existing tablet breakpoint (<=900px): hidden on desktop, shown as the last card on tablet/mobile. */
  @media(min-width:901px){.sg-home-category-grid .sg-category-card--tablet-mobile-only{display:none!important}}
</style>
<script is:inline>
(() => {
  const wishlistKey = 'sg-wishlist';
  const readWishlist = () => { try { const data=JSON.parse(localStorage.getItem(wishlistKey) || '[]'); return Array.isArray(data)?data:[]; } catch { return []; } };
  const updateWishlistCount = () => {
    const count = readWishlist().length;
    document.querySelectorAll('[data-wishlist-count]').forEach((el) => { el.textContent = String(count); el.hidden = count === 0; });
  };

  const header = document.querySelector('header');
  let heart = header?.querySelector('.sg-wishlist-header');
  if (header && !heart) {
    heart = document.createElement('a');
    heart.className = 'sg-wishlist-header'; heart.href = '/wishlist/'; heart.setAttribute('aria-label','Обране'); heart.title = 'Обране';
    heart.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"/></svg><span class="sg-wishlist-count" data-wishlist-count hidden>0</span>';
  }
  const actions = header?.querySelector('.sg-nav-actions');
  if (actions) {
    const quote = actions.querySelector('.sg-header-cta');
    const search = actions.querySelector('[aria-label="Пошук"]');
    const compare = actions.querySelector('[aria-label="Порівняння"]');
    const cart = actions.querySelector('[aria-label="Кошик"]');
    const phone = actions.querySelector('[aria-label="Зателефонувати"]');
    const language = actions.querySelector('.language-switcher');
    [search,compare,heart,cart,phone,language].forEach((node) => { if(node) actions.insertBefore(node,quote); });
  }

  const bindWishlistButtons = () => {
    document.querySelectorAll('[data-wishlist-product]').forEach((button) => {
      if (button.dataset.wishlistBound === '1') return;
      button.dataset.wishlistBound = '1';
      const product = {
        id: button.dataset.productId,
        title: button.dataset.productTitle,
        href: button.dataset.productHref,
        image: button.dataset.productImage,
        price: button.dataset.productPrice
      };
      const render = () => {
        const active = readWishlist().some((item) => (item.id || item) === product.id || item.href === product.href);
        button.classList.toggle('is-active',active);
        button.setAttribute('aria-pressed',String(active));
        const icon = button.querySelector('[data-wishlist-icon]');
        const text = button.querySelector('[data-wishlist-text]');
        if(icon) icon.textContent = active ? '♥' : '♡';
        if(text) text.textContent = active ? 'В обраному' : 'В обране';
      };
      button.addEventListener('click',(event)=>{
        event.preventDefault(); event.stopPropagation();
        let list = readWishlist();
        const exists = list.some((item) => (item.id || item) === product.id || item.href === product.href);
        list = exists ? list.filter((item) => (item.id || item) !== product.id && item.href !== product.href) : [...list,product];
        localStorage.setItem(wishlistKey,JSON.stringify(list));
        render(); updateWishlistCount(); dispatchEvent(new Event('sg-wishlist-change'));
      });
      render();
    });
  };

  const basePath = location.pathname.replace(/^\/(uk|ru|en|de)(?=\/|$)/,'') || '/';
  if (basePath === '/') {
    const grid = document.querySelector('.sg-categories__grid');
    const allLink = document.querySelector('.sg-categories .sg-all-link');
    if (grid) {
      grid.classList.add('sg-home-category-grid');
      const icon = (type) => ({
        shower:'<svg viewBox="0 0 48 48"><path d="M12 41V18c0-7 5-11 12-11h7v34"/><path d="M21 13h10M25 18v5m-6-2 2 4m10-4-2 4"/></svg>',mirror:'<svg viewBox="0 0 48 48"><ellipse cx="24" cy="24" rx="14" ry="18"/><ellipse cx="24" cy="24" rx="10" ry="14"/><path d="m18 23 7-9m-5 16 9-12"/></svg>',door:'<svg viewBox="0 0 48 48"><path d="M10 42V6h27v36M16 42V11h15v31"/><circle cx="27" cy="26" r="1"/></svg>',rail:'<svg viewBox="0 0 48 48"><path d="M8 38h10V28h10V18h12"/><path d="M9 33 38 10M15 31V22m9 1v-9m9 1V7"/></svg>',partition:'<svg viewBox="0 0 48 48"><path d="M8 8h32v32H8zM24 8v32M8 24h32"/></svg>',facade:'<svg viewBox="0 0 48 48"><path d="M7 41V9h34v32M18 9v32M30 9v32M7 22h34"/></svg>',aluminium:'<svg viewBox="0 0 48 48"><path d="M7 39 20 9h8l13 30M12 30h24M24 9v30"/></svg>',pvc:'<svg viewBox="0 0 48 48"><rect x="8" y="9" width="32" height="30"/><path d="M24 9v30M8 24h32"/><path d="m29 16 5 5-5 5"/></svg>',frameless:'<svg viewBox="0 0 48 48"><path d="M6 38 14 9h20l8 29"/><path d="M14 9v29m20-29v29"/></svg>','business-glass':'<svg viewBox="0 0 48 48"><path d="M6 44V20l6-10h24l6 10v24"/><path d="M6 44h36M14 44V28h8v16M28 44V28h8v16"/></svg>'}[type] || '◇');
      const items = [
        ['Душові кабіни','Walk-in, двері, кабіни в нішу, шторки та душові піддони','/dushovi-kabiny/','shower'],['Скляні перегородки','Loft, офісні, міжкімнатні, мобільні та безрамні системи','/sklyani-perehorodky/','partition'],['Скляні двері','Розпашні, розсувні, маятникові та двері в профілі','/sklyani-dveri/','door'],['Скляні огорожі','Сходи, балкони, тераси, безрамні та стійкові рішення','/sklyani-ohorozhi/','rail'],['Дзеркала','LED, у ванну, в рамі, панно та індивідуальні розміри','/dzerkala/','mirror'],['Скляні фасади','Вітринне, структурне та стійково-ригельне скління','/arkhitekturni-systemy/','facade'],['Безрамне скління','Тераси, балкони, альтанки та панорамні розсувні системи','/poslugy/bezramne-sklinnya/','frameless'],['Алюмінієві конструкції','Вікна, двері, розсувні та фасадні системи, зимові сади','/alyuminiievi-konstruktsii/','aluminium'],['Металопластикові конструкції','Вікна, двері, балконні та розсувні системи','/metaloplastykovi-konstruktsii/','pvc'],['Скло для бізнесу','Скляні рішення для магазинів, офісів, ресторанів та комерційних просторів.','/poslugy/sklo-dlia-biznesu/','business-glass',true]
      ];
      grid.innerHTML = items.map(([title,text,href,type,tabletMobileOnly]) => `<a class="sg-category-card${tabletMobileOnly ? ' sg-category-card--tablet-mobile-only' : ''}" href="${href}"><span class="sg-category-card__icon">${icon(type)}</span><h2>${title}</h2><p>${text}</p><b>→</b></a>`).join('');
    }
    if (allLink) { allLink.href = '/poslugy/'; allLink.textContent = 'Переглянути всі напрямки та послуги →'; }
  }

  if (basePath === '/catalog/dushova-perehorodka-walk-in-black/') {
    const mainImg = document.querySelector('.main-photo img'); const lightbox = document.getElementById('product-lightbox'); const lightboxImg = lightbox?.querySelector('img');
    document.querySelectorAll('.thumbs button[data-src]').forEach((thumb) => thumb.addEventListener('click', (event) => {
      event.stopPropagation(); document.querySelectorAll('.thumbs button').forEach((el) => el.classList.remove('active')); thumb.classList.add('active');
      if (mainImg) { mainImg.src = thumb.dataset.src; mainImg.alt = thumb.dataset.alt || ''; }
    }));
    document.querySelector('[data-gallery-open]')?.addEventListener('click', () => { if (lightbox && lightboxImg && mainImg) { lightboxImg.src = mainImg.src; lightboxImg.alt = mainImg.alt; lightbox.showModal(); } });
    lightbox?.querySelector('button')?.addEventListener('click', () => lightbox.close());
    lightbox?.addEventListener('click',(event)=>{if(event.target===lightbox) lightbox.close();});

    document.getElementById('cfg-calc')?.addEventListener('click', () => {
      const val = (id) => document.getElementById(id)?.value;
      const width = Number(val('cfg-width') || 900); const height = Number(val('cfg-height') || 2000); let price = 12900 * (width / 900) * (height / 2000);
      if (val('cfg-thickness') === '10') price *= 1.13;
      if (val('cfg-glass') === 'satin') price *= 1.10;
      if (val('cfg-glass') === 'gray') price *= 1.12;
      if (val('cfg-glass') === 'bronze') price *= 1.12;
      if (val('cfg-hardware') === 'chrome') price *= 1.04;
      if (val('cfg-hardware') === 'brushed') price *= 1.06;
      if (val('cfg-hardware') === 'gold') price *= 1.10;
      if (val('cfg-hardware') === 'custom') price *= 1.12;
      if (val('cfg-tray') === 'stone') price += 8900; if (val('cfg-tray') === 'acrylic') price += 4200; if (val('cfg-install') === 'yes') price += 2500;
      const rounded = Math.round(price / 100) * 100; const result = document.getElementById('cfg-result'); if (result) result.textContent = `від ${rounded.toLocaleString('uk-UA')} ₴`;
    });
  }

  bindWishlistButtons(); updateWishlistCount();
  addEventListener('storage',()=>{updateWishlistCount();bindWishlistButtons();});
  addEventListener('sg-wishlist-change',()=>{updateWishlistCount();bindWishlistButtons();});
})();
</script>
