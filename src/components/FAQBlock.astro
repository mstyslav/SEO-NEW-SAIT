---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  items: [string, string][];
  visibleCount?: number;
  variant?: 'default' | 'compact';
  locale?: import('../i18n/helpers').Locale;
}
const {
  eyebrow = 'FAQ',
  title,
  intro = '',
  items,
  visibleCount = 6,
  variant = 'compact',
  locale: localeProp
} = Astro.props;

import { localeFromPath, normalizeLocale } from '../i18n/helpers';
import { expandFaq } from '../data/expand-faq';
const locale = normalizeLocale(localeProp ?? localeFromPath(Astro.url.pathname));
const labels = {
  uk: { all: 'Показати всі питання', less: 'Показати менше' },
  ru: { all: 'Показать все вопросы', less: 'Показать меньше' },
  en: { all: 'Show all questions', less: 'Show less' },
  de: { all: 'Alle Fragen anzeigen', less: 'Weniger anzeigen' }
}[locale];

const id = `faq-${Math.random().toString(36).slice(2, 9)}`;
const expandedItems = expandFaq(items, title, locale, 20);
---
<section class={`faq-block faq-block--${variant}`} data-faq-block id={id}>
  <div class="faq-block__head">
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    {intro && <p>{intro}</p>}
  </div>

  <div class="faq-block__grid">
    {expandedItems.map(([q,a],i) => (
      <details class:list={['faq-item', i >= visibleCount && 'faq-item--extra']} data-faq-extra={i >= visibleCount ? 'true' : undefined}>
        <summary>
          <span>{q}</span>
          <i aria-hidden="true"></i>
        </summary>
        <div class="faq-item__answer"><p>{a}</p></div>
      </details>
    ))}
  </div>

  {expandedItems.length > visibleCount && (
    <div class="faq-block__actions">
      <button class="button button--mint faq-toggle" type="button" aria-expanded="false">
        {labels.all}
      </button>
    </div>
  )}
</section>

<script define:vars={{ labels }}>
  document.querySelectorAll('[data-faq-block]').forEach((block) => {
    const toggle = block.querySelector('.faq-toggle');
    if (!toggle) return;

    toggle.addEventListener('click', () => {
      const expanded = block.classList.toggle('is-expanded');
      toggle.setAttribute('aria-expanded', String(expanded));
      toggle.textContent = expanded ? labels.less : labels.all;
    });
  });
</script>
