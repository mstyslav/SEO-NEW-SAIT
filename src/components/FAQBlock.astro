---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  items: [string, string][];
  visibleCount?: number;
  variant?: 'default' | 'compact';
}
const {
  eyebrow = 'FAQ',
  title,
  intro = '',
  items,
  visibleCount = 6,
  variant = 'compact'
} = Astro.props;

const id = `faq-${Math.random().toString(36).slice(2, 9)}`;
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: items.map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) };
---
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<section class={`faq-block faq-block--${variant}`} data-faq-block id={id}>
  <div class="faq-block__head">
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    {intro && <p>{intro}</p>}
  </div>

  <div class="faq-block__grid">
    {items.map(([q,a],i) => (
      <details class:list={['faq-item', i >= visibleCount && 'faq-item--extra']} data-faq-extra={i >= visibleCount ? 'true' : undefined}>
        <summary>
          <span>{q}</span>
          <i aria-hidden="true"></i>
        </summary>
        <div class="faq-item__answer"><p>{a}</p></div>
      </details>
    ))}
  </div>

  {items.length > visibleCount && (
    <div class="faq-block__actions">
      <button class="button button--mint faq-toggle" type="button" aria-expanded="false">
        Показати всі питання
      </button>
    </div>
  )}
</section>

<script>
  document.querySelectorAll('[data-faq-block]').forEach((block) => {
    const toggle = block.querySelector('.faq-toggle');
    if (!toggle) return;

    toggle.addEventListener('click', () => {
      const expanded = block.classList.toggle('is-expanded');
      toggle.setAttribute('aria-expanded', String(expanded));
      toggle.textContent = expanded ? 'Показати менше' : 'Показати всі питання';
    });
  });
</script>
