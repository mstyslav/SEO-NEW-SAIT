---
// EN/DE/ES contact page — same sections and styles as src/pages/contacts.astro: request form with
// file upload, the three Space Glass offices (real addresses, Google Maps), what to send, B2B, FAQ.
// The office addresses are given in Latin script; maps are opened with the original UA address.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import FAQBlock from '../FAQBlock.astro';
import '../../styles/contacts-final.css';
import { faqSchema, type JsonLdObject } from '../../seo/schema';
import { intlHref, type IntlLocale } from '../../i18n/intl-routes';
import { contactsCopy } from '../../content/i18n/intl/pages';

interface Props { locale: IntlLocale }
const { locale } = Astro.props;
const copy = contactsCopy[locale];
const phone = '+380 73 425 14 00';
const officeQueries: Record<string, string> = { odesa: 'Одеса, вул. Глиняна, 5', kyiv: 'Київ, вул. Лауреатська, 8', lviv: 'Львів, вул. Кульпарківська, 144' };
const socials = [['Instagram','https://www.instagram.com/spaceglass_od/'],['Telegram','https://t.me/spaceglass'],['TikTok','https://www.tiktok.com/@spaceglass'],['Facebook','https://www.facebook.com/spaceglasscomua'],['YouTube','https://www.youtube.com/@spaceglass_od']];
const structuredData = [faqSchema(copy.faq.map(([question, answer]) => ({ question, answer })))].filter(Boolean) as JsonLdObject[];
---
<BaseLayout title={copy.title} description={copy.description} locale={locale} schemaType="ContactPage" structuredData={structuredData}><div class="sg-page-shell contacts-page"><Header locale={locale} /><main id="main">
<section class="contacts-hero"><div class="contacts-hero__copy"><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.heading}</h1><p class="lead">{copy.intro}</p><div class="contacts-quick-links" aria-label={copy.quickLinksAria}><a href="tel:+380734251400">{phone}</a><a href="mailto:info@space-glass.com.ua">info@space-glass.com.ua</a><a href="https://t.me/spaceglass" target="_blank" rel="noopener noreferrer">Telegram</a></div></div><form id="contact-form" class="quote-form contacts-form" data-lead-form><input type="hidden" name="locale" value={locale} /><div class="contacts-form-grid"><label class="contacts-form__field contacts-form__field--name">{copy.name}<input name="name" type="text" autocomplete="name" placeholder={copy.namePlaceholder} required /></label><label class="contacts-form__field contacts-form__field--phone">{copy.phone}<input name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="+38" required /></label><label class="contacts-form__field contacts-form__field--city">{copy.city}<input name="city" autocomplete="address-level2" type="text" placeholder={copy.cityPlaceholder} /></label><label class="contacts-form__field contacts-form__field--need">{copy.need}<textarea name="comment" rows="5" placeholder={copy.needPlaceholder}></textarea></label></div><label class="contacts-file-field"><span>{copy.file}</span><span class="contacts-file-control"><span class="contacts-file-button">{copy.chooseFile}</span><span class="contacts-file-name" data-file-name data-empty-label={copy.noFile}>{copy.noFile}</span></span><input class="contacts-file-input" name="attachment" type="file" accept=".jpg,.jpeg,.png,.webp,.pdf,.dwg" data-file-input /></label><div class="contacts-form__footer"><label class="quote-consent"><input name="consent" value="accepted" type="checkbox" required /><span>{copy.consent} <a href={intlHref('privacy', locale)}>{copy.privacy}</a>{copy.consentAfter ?? ''}.</span></label><button class="button button--mint" type="submit">{copy.submit}</button></div><p data-form-status hidden role="status"></p></form></section>
<section class="contacts-section contacts-calculation"><div class="contacts-section__inner"><div class="contacts-section-head"><p class="eyebrow">{copy.calcEyebrow}</p><h2>{copy.calcTitle}</h2></div><div class="contacts-editorial-list">{copy.calculationItems.map(([title,text], index) => <article class="contacts-editorial-item"><span class="contacts-editorial-item__number">{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
<section id="offices" class="contacts-section contacts-offices"><div class="contacts-section__inner"><div class="contacts-section-head"><p class="eyebrow">{copy.offices}</p><h2>{copy.chooseCity}</h2></div><div class="contacts-tabs" data-contact-tabs><div class="contacts-tabs__buttons" role="tablist" aria-label={copy.offices}>{copy.officeList.map((office,index) => <button class:list={['contacts-tab-button',index===0&&'is-active']} type="button" role="tab" id={`office-tab-${office.id}`} aria-controls={`office-panel-${office.id}`} aria-selected={index===0?'true':'false'} tabindex={index===0?'0':'-1'} data-office-button={office.id}>{office.city}</button>)}</div><div class="contacts-tabs__shell">{copy.officeList.map((office,index) => <div class:list={['contacts-office-panel',index===0&&'is-active']} id={`office-panel-${office.id}`} role="tabpanel" aria-labelledby={`office-tab-${office.id}`} hidden={index!==0} data-office-panel={office.id}><div class="contacts-office-info"><p class="eyebrow">{office.city}</p><h3>{office.address}</h3><div class="contacts-office-info__rows"><div><span>{copy.phone}</span><a href="tel:+380734251400">{phone}</a></div><div><span>Email</span><a href="mailto:info@space-glass.com.ua">info@space-glass.com.ua</a></div><div><span>{copy.schedule}</span><b>{copy.hours}</b></div></div><div class="contacts-office-actions"><a class="button button--mint" target="_blank" rel="noopener noreferrer" href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(officeQueries[office.id])}`}>{copy.route}</a><a class="button button--outline" target="_blank" rel="noopener noreferrer" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(officeQueries[office.id])}`}>{copy.map}</a></div><div class="contacts-social-mini" aria-label={copy.socialAria}>{socials.map(([label,href]) => <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label}>{label==='Instagram'&&<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>}{label==='Telegram'&&<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 4 3.8 10.6c-.8.3-.8 1.4 0 1.7l4.3 1.4 1.6 5c.2.7 1.1.9 1.6.4l2.4-2.5 4.1 3c.6.4 1.4.1 1.6-.6L22 5.2c.2-.8-.3-1.4-1-1.2Z"/><path d="m8.1 13.7 9.8-6.2-7.6 8.1"/></svg>}{label==='TikTok'&&<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3v10.2a4.4 4.4 0 1 1-3.8-4.4"/><path d="M14 3c.6 2.6 2.2 4.2 4.8 4.8"/></svg>}{label==='Facebook'&&<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4.5c-.6-.1-1.8-.2-3.2-.2-3.1 0-5.2 1.9-5.2 5.4V13H5v4h3.6v7H13v-7h3.6l.6-4H13v-3c0-1.2.3-2 1-2Z"/></svg>}{label==='YouTube'&&<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 8.2a3 3 0 0 0-2.1-2.1C17 5.6 12 5.6 12 5.6s-5 0-6.9.5A3 3 0 0 0 3 8.2 31 31 0 0 0 2.6 12 31 31 0 0 0 3 15.8a3 3 0 0 0 2.1 2.1c1.9.5 6.9.5 6.9.5s5 0 6.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .4-3.8 31 31 0 0 0-.4-3.8Z"/><path d="m10 15.5 5-3.5-5-3.5Z"/></svg>}</a>)}</div></div><div class="contacts-office-map"><iframe data-map-frame data-src={`https://www.google.com/maps?q=${encodeURIComponent(officeQueries[office.id])}&output=embed`} title={`${copy.mapTitle} — ${office.city}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div></div>)}</div></div></div></section>
<section class="contacts-section contacts-geography contacts-geography--intl"><div class="contacts-section__inner"><div class="contacts-geography__copy"><div class="contacts-section-head"><p class="eyebrow">{copy.geoEyebrow}</p><h2>{copy.geoTitle}</h2>{copy.geoText.map((text) => <p>{text}</p>)}</div>{locale !== 'de' && <div class="contacts-city-list" aria-label={copy.geoCitiesAria}>{copy.officeList.map((office) => <span>{office.city}</span>)}</div>}</div></div></section>
<section class="contacts-b2b"><div class="contacts-b2b__inner"><div><p class="eyebrow">{copy.b2bEyebrow}</p><h2>{copy.b2bTitle}</h2><p>{copy.b2bText}</p><p class="contacts-b2b__line">{copy.b2bLine}</p></div><a class="button button--mint" href="#contact-form">{copy.b2bCta}</a></div></section>
<section class="contacts-section contacts-faq"><div class="contacts-section__inner"><FAQBlock eyebrow="FAQ" title={copy.faqTitle} intro={copy.faqIntro} items={copy.faq} visibleCount={6} expandTo={copy.faq.length} locale={locale} /></div></section>
</main><Footer locale={locale} /></div></BaseLayout>
<style>
  .contacts-geography--intl .contacts-section__inner{display:block}
  .contacts-geography--intl .contacts-geography__copy{max-width:880px}
  .contacts-geography--intl .contacts-section-head p{max-width:760px}
</style>
<script>
document.querySelectorAll('[data-file-input]').forEach((input) => {
  const field = input.closest('.contacts-file-field');
  const name = field?.querySelector('[data-file-name]');
  const update = () => {
    if (!name) return;
    name.textContent = input.files?.[0]?.name || name.dataset.emptyLabel || '';
    name.classList.toggle('has-file', Boolean(input.files?.length));
  };
  input.addEventListener('change', update);
  input.form?.addEventListener('reset', () => setTimeout(update));
});

const loadOfficeMap = (panel) => {
  const frame = panel?.querySelector('[data-map-frame]');
  if (!frame || frame.getAttribute('src')) return;
  const src = frame.getAttribute('data-src');
  if (src) frame.setAttribute('src', src);
};

document.querySelectorAll('[data-contact-tabs]').forEach((tabs) => {
  const buttons = tabs.querySelectorAll('[data-office-button]');
  const panels = tabs.querySelectorAll('[data-office-panel]');
  buttons.forEach((button) => button.addEventListener('click', () => {
    const office = button.getAttribute('data-office-button');
    buttons.forEach((item) => {
      const active = item === button;
      item.classList.toggle('is-active', active);
      item.setAttribute('aria-selected', String(active));
      item.setAttribute('tabindex', active ? '0' : '-1');
    });
    panels.forEach((panel) => {
      const active = panel.getAttribute('data-office-panel') === office;
      panel.classList.toggle('is-active', active);
      panel.hidden = !active;
      if (active) loadOfficeMap(panel);
    });
  }));
  const activateVisibleMap = () => loadOfficeMap(tabs.querySelector('[data-office-panel].is-active'));
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      activateVisibleMap();
      observer.disconnect();
    }, { rootMargin: '300px 0px' });
    observer.observe(tabs);
  } else {
    activateVisibleMap();
  }
});
</script>
