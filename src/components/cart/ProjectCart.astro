    /* Unified cart (LED mirrors + configurators) */
    .project-cart-item__config{white-space:pre-line}
    .project-cart-item__unit{display:block;font-size:.8rem;font-weight:400;opacity:.7}
    .project-cart-item__link{font-size:.85rem}
    .project-cart-notice{margin:0 0 12px;padding:10px 12px;border-radius:8px;background:#fff7e0;font-size:.9rem}
    .project-cart-form{display:grid;gap:12px;margin-top:16px}
    .project-cart-form label{display:grid;gap:4px;font-size:.9rem}
    .project-cart-form input,.project-cart-form textarea{width:100%;min-height:44px;padding:8px 12px;border:1px solid #cfd8dc;border-radius:8px;font:inherit}
    .project-cart-form [data-cart-error]{color:#b3261e;margin:0;font-size:.9rem}
    .project-cart-form .hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
    .project-cart-form button[disabled]{opacity:.6;cursor:wait}
    .project-cart-done{padding:32px;border-radius:12px;background:#eef6f5}
