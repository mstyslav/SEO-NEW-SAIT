---
// Preview page for the prepared block (noindex). Removed once the block is wired into the LED page.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import LedCatalogBlock from './LedCatalogBlock.astro';
import '../../styles/category-pages.css';
const { locale = 'uk' } = Astro.props;
---
<BaseLayout title="Preview: блок «Обрати LED-дзеркало»" description="Попередній перегляд блоку переходу до каталогу LED-дзеркал." locale={locale} robots="noindex,nofollow">
<div class="sg-page-shell">
  <Header locale={locale} />
  <main id="main">
    <section class="category-section"><Breadcrumbs items={[{ label: locale === 'ru' ? 'Главная' : 'Головна', href: locale === 'ru' ? '/ru/' : '/' }, { label: locale === 'ru' ? 'Зеркала' : 'Дзеркала', href: locale === 'ru' ? '/ru/dzerkala/' : '/dzerkala/' }, { label: 'LED-' + (locale === 'ru' ? 'зеркала' : 'дзеркала') + ' (preview блоку)' }]} />
      <p style="opacity:.7">Preview-only: так блок виглядатиме на сторінці /dzerkala/led-dzerkala/ після 11.11.2026. Сторінка не публікується.</p></section>
    <LedCatalogBlock locale={locale} />
  </main>
  <Footer />
</div>
</BaseLayout>
