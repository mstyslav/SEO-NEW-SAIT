{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seo-new-sait",
  "compatibility_date": "2026-08-13",
  // Lead delivery (Telegram / e-mail / Kommo) for every site form — see worker/index.ts.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the API goes through the Worker; all pages stay plain static assets.
    "run_worker_first": ["/api/*"],
    // Unknown URLs answer 404 with the nearest 404.html as the body (/ru/404.html under /ru/, else /404.html)
    // instead of an empty response.
    "not_found_handling": "404-page"
  },
  // Anti-spam: at most 3 form submissions per visitor IP per minute.
  "ratelimits": [{ "name": "LEAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
  "observability": { "enabled": true },
  // Production is served only on space-glass.com.ua (Worker Route). The *.workers.dev
  // test domain and preview URLs are switched off so they can never duplicate it in Google.
  "workers_dev": false,
  "preview_urls": false
}
