{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seo-new-sait",
  "compatibility_date": "2026-08-13",
  // Lead delivery (Telegram / e-mail / Kommo) for every site form — see worker/index.ts.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the API goes through the Worker; all pages stay plain static assets.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
