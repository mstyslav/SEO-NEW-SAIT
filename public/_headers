# Cloudflare Workers Static Assets response headers (https://developers.cloudflare.com/workers/static-assets/headers/).
# Default for everything else stays Cloudflare's "public, max-age=0, must-revalidate" (HTML is always fresh).

# Astro build output: file names carry a content hash, so they never change in place.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images, documents and icons keep their names when unchanged; a week in the browser cache,
# then revalidated (a replaced file with the same name is picked up within 7 days at most).
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/docs/*
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon-192.png
  Cache-Control: public, max-age=604800
/apple-touch-icon*
  Cache-Control: public, max-age=604800

# Unhashed site scripts: short browser cache so a deploy reaches visitors within the hour.
/js/*
  Cache-Control: public, max-age=3600, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
